	if counts.has("CIPHER WARD"):
		var strength := clampf(float(counts["CIPHER WARD"]) / 4.0, 0.0, 1.8)
		stats["data_security"] = clampf(float(stats.get("data_security", 1.0)) + 0.22 * strength, 0.25, 3.6)
