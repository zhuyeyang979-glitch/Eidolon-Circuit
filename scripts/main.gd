func _handle_global_ui_mouse_input(event: InputEvent) -> bool:
	if event is InputEventMouseMotion:
		if game_state == STATE_EDITOR and editor_sort_menu_open:
			var sort_mouse := (event as InputEventMouseMotion).position
			var sort_rect := _editor_sort_menu_global_rect().grow(8.0)
			if sort_rect.size.x <= 0.0 or not sort_rect.has_point(sort_mouse):
				editor_sort_menu_open = false
				_update_editor_ui()
		if game_state == STATE_MENU:
			var hover_index := _menu_button_index_at_position((event as InputEventMouseMotion).position)
			if hover_index >= 0 and hover_index != menu_index:
				_hover_menu_item(hover_index)
		elif game_state == STATE_SAVED_UNITS:
			_update_saved_units_hover((event as InputEventMouseMotion).position)
		return false
	if not (event is InputEventMouseButton):
		return false
	var mouse_event := event as InputEventMouseButton
	if not mouse_event.pressed:
		return false
	if page_options_layer != null and page_options_layer.visible:
		if mouse_event.button_index == MOUSE_BUTTON_LEFT:
			var options_button = _find_button_at_recursive(page_options_layer, mouse_event.position)
			if options_button == null:
				_hide_page_options()
				return true
			return _trigger_button_mouse_fallback(options_button)
		if mouse_event.button_index == MOUSE_BUTTON_RIGHT:
			_hide_page_options()
			return true
	if mouse_event.button_index == MOUSE_BUTTON_RIGHT:
		return _handle_global_ui_right_click(mouse_event.position)
	if mouse_event.button_index != MOUSE_BUTTON_LEFT:
		return false
	if format_select_layer != null and format_select_layer.visible:
		var format_button = _find_button_at_recursive(format_select_layer, mouse_event.position)
		if format_button == null:
			return true
		return _trigger_button_mouse_fallback(format_button)
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("button.hit_test")
	var button = _top_visible_button_at(mouse_event.position)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("button.hit_test")
	if button == null:
		return false
	if game_state == STATE_MENU:
		var click_index := menu_buttons.find(button)
		if click_index >= 0:
			_hover_menu_item(click_index)
	return _trigger_button_mouse_fallback(button)


func _editor_sort_menu_global_rect() -> Rect2:
	var merged := Rect2()
	var has_rect := false
	var controls: Array = []
	if editor_sort_panel != null:
		controls.append(editor_sort_panel)
	if editor_action_buttons.has("sort_key"):
		controls.append(editor_action_buttons["sort_key"])
	if editor_action_buttons.has("sort_dir"):
		controls.append(editor_action_buttons["sort_dir"])
	for button in editor_sort_option_buttons:
		controls.append(button)
	for control in controls:
		if control is Control:
			var ui_control := control as Control
			if ui_control.visible:
				var rect := ui_control.get_global_rect()
				if not has_rect:
					merged = rect
					has_rect = true
				else:
					merged = merged.merge(rect)
	return merged if has_rect else Rect2(Vector2.ZERO, Vector2.ZERO)


func _handle_editor_catalog_manual_drag(event: InputEvent) -> bool:
	if game_state != STATE_EDITOR or editor_layer == null or not editor_layer.visible:
		_clear_editor_catalog_manual_drag()
		return false
	if editor_panel_mode != "parts":
		_clear_editor_catalog_manual_drag()
		return false
	if event is InputEventMouseMotion:
		if not editor_drag_catalog_active:
			return false
		var motion := event as InputEventMouseMotion
		editor_drag_catalog_last = motion.position
		if motion.position.distance_to(editor_drag_catalog_start) > 7.0:
			var just_started := not editor_drag_catalog_started
			editor_drag_catalog_started = true
			if just_started:
				_show_editor_drag_ghost(editor_drag_catalog_slot, editor_drag_catalog_index, motion.position)
				_refresh_editor_visual_views()
			else:
				_update_editor_drag_ghost_position(motion.position)
			if editor_board_hint_label != null:
				editor_board_hint_label.text = "拖到自由画布内释放即可放置零件。" if _ui_is_zh() else "Release inside the free canvas to place the part."
		return editor_drag_catalog_started
	if not (event is InputEventMouseButton):
		return false
	var mouse_event := event as InputEventMouseButton
	if mouse_event.button_index != MOUSE_BUTTON_LEFT:
		return false
	if mouse_event.pressed:
		var catalog_index := _catalog_button_index_at_position(mouse_event.position)
		if catalog_index < 0:
			_clear_editor_catalog_manual_drag()
			return false
		var entry := _editor_catalog_entry_for_button(catalog_index)
		if entry.is_empty():
			_clear_editor_catalog_manual_drag()
			return false
		editor_drag_catalog_active = true
		editor_drag_catalog_started = false
		editor_drag_catalog_slot = String(entry.get("slot", BUILD_SLOTS[editor_slot_index]))
		editor_drag_catalog_index = int(entry.get("index", -1))
		editor_drag_catalog_start = mouse_event.position
		editor_drag_catalog_last = mouse_event.position
		return false
	if not editor_drag_catalog_active:
		return false
	editor_drag_catalog_last = mouse_event.position
	var was_dragging := editor_drag_catalog_started or mouse_event.position.distance_to(editor_drag_catalog_start) > 7.0
	if not was_dragging:
		_clear_editor_catalog_manual_drag()
		return false
	var dropped := _try_drop_catalog_drag_at_position(mouse_event.position)
	if not dropped and editor_board_hint_label != null:
		editor_board_hint_label.text = "零件需要释放在自由画布内部。" if _ui_is_zh() else "Release the part inside the free canvas."
		_play_sfx_wave("alarm", 170.0, 0.06, -18.0)
	_clear_editor_catalog_manual_drag()
	return true


func _catalog_button_index_at_position(mouse_position: Vector2) -> int:
	for i in range(editor_catalog_buttons.size() - 1, -1, -1):
		var button = editor_catalog_buttons[i]
		if button is Button:
			var catalog_button := button as Button
			if catalog_button.visible and not catalog_button.disabled and catalog_button.get_global_rect().has_point(mouse_position):
				return i
	return -1


func _editor_catalog_entry_for_button(component_index: int) -> Dictionary:
	var role_key: String = ROLE_ORDER[editor_role_index]
	var slot_key: String = BUILD_SLOTS[editor_slot_index]
	var entries := _editor_catalog_entries(role_key, slot_key)
	var page_size := maxi(1, editor_catalog_buttons.size())
	var actual_entry_index := editor_catalog_page * page_size + component_index
	if actual_entry_index < 0 or actual_entry_index >= entries.size():
		return {}
	var raw_entry = entries[actual_entry_index]
	return Dictionary(raw_entry) if raw_entry is Dictionary else {}


func _try_drop_catalog_drag_at_position(mouse_position: Vector2) -> bool:
	if assembly_board_view == null or not assembly_board_view.visible:
		return false
	if editor_drag_catalog_slot == "" or editor_drag_catalog_index < 0:
		return false
	var board_rect := assembly_board_view.get_global_rect()
	if not board_rect.has_point(mouse_position):
		return false
	_drop_catalog_part_on_board(editor_drag_catalog_slot, editor_drag_catalog_index, mouse_position - board_rect.position)
	return true


func _catalog_drag_display_part(slot_key: String, part_index: int) -> Dictionary:
