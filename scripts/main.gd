		_editor_vector_signature(editor_selection_box_current),
		str(snappedf(editor_board_zoom, 0.001)),
		_editor_vector_signature(editor_board_view_offset),
		editor_board_tool,
		str(editor_pose_root_node),
		_editor_int_array_signature(editor_pose_downstream_nodes),
		_editor_int_array_signature(editor_material_warning_nodes),
		str(editor_open_torso_node_index),
		str(editor_dragging_node_index),
		str(editor_pending_orientation_node_index),
		str(snappedf(editor_snap_timer, 0.01)),
		str(editor_assembly_template_collapsed),
		_editor_pending_binding_signature(),
