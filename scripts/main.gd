func _is_valid_combat_position(pos: Vector2) -> bool:
	return absf(pos.x) < 1.0e10 and absf(pos.y) < 1.0e10


func _spawn_blind_zone(owner_id: int, ring_value: float, lane_value: float, radius_units: float, duration: float, strength: float) -> void:
	if effects_root == null:
		return
	var zone := BlindZoneEffect.new()
	zone.setup(owner_id, ring_value, lane_value, radius_units, duration, strength)
	var screen := _screen_from_ring(ring_value, lane_value)
	zone.position = screen["position"]
	zone.visible = bool(screen["visible"])
	effects_root.add_child(zone)
	blind_zones.append(zone)
	_play_hit_sfx("laser", "blind", false, 2)


func _update_blind_zones(delta: float) -> void:
	for zone in blind_zones.duplicate():
		if zone == null or not is_instance_valid(zone):
			blind_zones.erase(zone)
			continue
		var screen := _screen_from_ring(float(zone.ring_pos), float(zone.lane))
		zone.tick_zone(delta, screen["position"], bool(screen["visible"]))
		if not zone.is_alive():
			blind_zones.erase(zone)


func _unit_blind_strength(unit) -> float:
	if not _is_live_unit(unit):
		return 0.0
	var strongest := 0.0
	for zone in blind_zones:
		if zone == null or not is_instance_valid(zone) or not zone.is_alive():
			continue
		if int(zone.owner_id) == int(unit.owner_id):
			continue
		var distance := absf(_ring_delta(unit.ring_pos, float(zone.ring_pos)))
		var lane_distance := absf(unit.lane - float(zone.lane))
		var radius_units := float(zone.radius_units)
		if distance <= radius_units and lane_distance <= radius_units * 0.72:
			var falloff := 1.0 - clampf((distance + lane_distance * 0.8) / maxf(0.01, radius_units * 1.6), 0.0, 1.0)
			strongest = maxf(strongest, float(zone.strength) * falloff)
	return strongest


func _blind_escape_vector(unit) -> Vector2:
	var escape := Vector2.ZERO
	for zone in blind_zones:
		if zone == null or not is_instance_valid(zone) or not zone.is_alive() or int(zone.owner_id) == int(unit.owner_id):
			continue
		var delta_ring: float = _ring_delta(float(zone.ring_pos), unit.ring_pos)
		var delta_lane: float = unit.lane - float(zone.lane)
		var distance: float = absf(delta_ring) + absf(delta_lane) * 0.8
		if distance <= float(zone.radius_units) * 1.15:
			escape += Vector2(signf(delta_ring), clampf(delta_lane * 2.0, -1.0, 1.0)) * float(zone.strength)
	return escape.limit_length(1.0)


func _end_battle(winner_id: int, reason: String = "victory") -> void:
	game_over = true
	var message := "P%d 获胜。可复盘、调整配置、再战或返回主菜单。" % winner_id if _ui_is_zh() else "P%d wins. Review, adjust, rematch, or return to main menu." % winner_id
	_show_battle_message(message, 999.0)
	_show_post_battle_review(winner_id, reason)


func _resolve_timeout() -> void:
	if game_over:
		return
	var winner := 1
	if int(victory_points[2]) > int(victory_points[1]):
		winner = 2
	elif int(victory_points[1]) == int(victory_points[2]):
		var score_1 := _remaining_health_score(1)
		var score_2 := _remaining_health_score(2)
		winner = 2 if score_2 > score_1 else 1
	_end_battle(winner, "timeout")


func _remaining_health_score(player_id: int) -> float:
	var score := 0.0
	if _is_live_unit(active_units[player_id]["hero"]):
		score += active_units[player_id]["hero"].health_ratio() * 3.0
	if _is_live_unit(active_units[player_id]["barrier"]):
		score += active_units[player_id]["barrier"].health_ratio()
	for unit in active_units[player_id]["puppet"]:
		if _is_live_unit(unit):
			score += unit.health_ratio() * 0.5
	return score


func _detach_unit(unit) -> void:
	all_units.erase(unit)
	_detach_unit_reference(unit)


