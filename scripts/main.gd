	if ringed:
		var ring := Line2D.new()
		ring.name = "OrbitalRing"
		ring.width = 4.0
		ring.default_color = Color(rim_color.r, rim_color.g, rim_color.b, 0.26)
		ring.rotation = -0.32
		ring.points = _space_ellipse(Vector2.ZERO, radius * 1.72, radius * 0.34, 84)
		planet.add_child(ring)
	var body := Polygon2D.new()
	body.name = "PlanetBody"
	body.polygon = _space_circle(Vector2.ZERO, radius, 64)
	body.color = body_color
	planet.add_child(body)
	var shadow := Polygon2D.new()
	shadow.name = "Terminator"
	shadow.position = Vector2(radius * 0.24, radius * -0.06)
	shadow.polygon = _space_circle(Vector2.ZERO, radius * 0.92, 56)
	shadow.color = Color(0.0, 0.0, 0.02, 0.24)
