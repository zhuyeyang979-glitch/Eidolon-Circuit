func _apply_resource_siphon(barrier, player_id: int, delta: float) -> void:
	var enemy_id := 2 if player_id == 1 else 1
	var base_intent := _battle_field_runtime_service().field_effect_intent({"kind": "resource_siphon", "stats": barrier.stats, "delta": delta, "enemy_resource": float(runtime_resource[enemy_id])})
	var radius := float(base_intent.get("radius", 0.72))
	_update_field_aura_visual(barrier, String(base_intent.get("aura_kind", "siphon")), radius, float(base_intent.get("aura_strength", 1.0)), delta)
	for target in _enemy_units(player_id):
		if not _is_live_unit(target) or not _unit_is_mech_physics_subject(target) or not _unit_in_barrier_aura(barrier, target, radius, "siphon"):
			continue
		var intent := _battle_field_runtime_service().field_effect_intent({"kind": "resource_siphon", "stats": barrier.stats, "delta": delta, "enemy_resource": float(runtime_resource[enemy_id])})
		var amount := float(intent.get("amount", 0.0))
		if amount <= 0.0:
			continue
		runtime_resource[enemy_id] = float(runtime_resource[enemy_id]) - amount
		runtime_resource[player_id] = float(runtime_resource[player_id]) + amount
		if randf() < delta * float(intent.get("vfx_rate", 2.0)):
			_spawn_hit_effect(target, 1, "laser", false, "field")


func _apply_hack_field(barrier, player_id: int, delta: float) -> void:
	var required := maxf(0.5, float(barrier.stats.get("hack_seconds", 4.6)))
	var hack_power := maxf(0.1, float(barrier.stats.get("hack_power", 1.0)))
	var base_intent := _battle_field_runtime_service().field_effect_intent({"kind": "hack", "stats": barrier.stats, "delta": delta, "required": required})
	var radius := float(base_intent.get("radius", 0.68))
	_update_field_aura_visual(barrier, String(base_intent.get("aura_kind", "hack")), radius, float(base_intent.get("aura_strength", required)), delta)
	for target in _enemy_units(player_id):
		if not _is_live_unit(target) or not _unit_is_mech_physics_subject(target) or not _unit_in_barrier_aura(barrier, target, radius, "hack"):
			continue
		var key := "hack_time_p%d_%d" % [player_id, int(barrier.get_instance_id())]
		var target_required := _security_adjusted_seconds(required, target, hack_power, 0.5)
		var intent := _battle_field_runtime_service().field_effect_intent({"kind": "hack", "stats": barrier.stats, "delta": delta, "required": target_required, "progress": float(target.get_meta(key, 0.0))})
		target.set_meta(key, float(intent.get("progress", 0.0)))
		target.set_meta("hack_warning_timer", float(intent.get("warning_timer", 0.45)))
		if randf() < delta * float(intent.get("vfx_rate", 1.6)):
			_spawn_hit_effect(target, 1, "laser", false, "field")
		if bool(intent.get("complete", false)):
			_defect_unit_to_owner(target, player_id, "HACK FIELD")


func _try_trigger_trap_fields(player_id: int, link_filter: String = "", input_vector: Vector2 = Vector2.ZERO, command_already_matched: bool = false) -> bool:
	for trap in _friendly_units(player_id):
		if not _is_live_unit(trap) or not bool(trap.stats.get("is_trap_field", false)):
			continue
		var trap_link := String(trap.stats.get("trap_link", ""))
		var targets := _trap_targets(trap, player_id)
		var command := String(trap.stats.get("trap_command", "236"))
		var jammed := float(trap.get_meta("jammed_timer", 0.0)) > 0.0
		var cooldown := float(trap.get_meta("trap_cooldown_timer", 0.0))
		var link_matches := link_filter == "" or link_filter == "all" or trap_link == link_filter
		var command_matched := command_already_matched
		if not jammed and cooldown <= 0.0 and link_matches and not targets.is_empty() and not command_matched:
			command_matched = _command_matches(player_id, command, "trap_field")
		var intent := _battle_field_runtime_service().trap_trigger_intent({
			"jammed": jammed,
			"cooldown": cooldown,
			"link_matches": link_matches,
			"targets_count": targets.size(),
			"command_matched": command_matched,
		})
		if not bool(intent.get("trigger", false)):
			continue
		_fire_trap_field(trap, player_id, targets, input_vector)
		return true
	return false


func _trap_targets(trap, player_id: int) -> Array:
	var targets: Array = []
	var radius := maxf(0.1, float(trap.stats.get("trap_radius", 0.7)))
	for unit in _field_targets_for(player_id, String(trap.stats.get("trap_affects", "enemy"))):
		if unit == trap or not _is_live_unit(unit) or not _unit_is_mech_physics_subject(unit):
			continue
		if _unit_in_barrier_aura(trap, unit, radius, "trap"):
			targets.append(unit)
	return targets


func _fire_trap_field(trap, player_id: int, targets: Array, input_vector: Vector2 = Vector2.ZERO) -> void:
	var launch_direction := _trap_launch_direction(trap, player_id, input_vector)
	var target_deltas: Array = []
	for target in targets:
		target_deltas.append(_mobius_delta_vec_between(trap, target, 1.2) if _is_live_unit(target) else Vector2.ZERO)
	var intent := _battle_field_runtime_service().trap_fire_intents({
		"stats": trap.stats,
		"targets_count": targets.size(),
		"target_deltas": target_deltas,
		"launch_direction": launch_direction,
	})
	var effect := String(intent.get("effect", trap.stats.get("trap_effect", "acid_rain")))
	trap.set_meta("trap_cooldown_timer", float(intent.get("cooldown", maxf(0.4, float(trap.stats.get("trap_cooldown", 5.0))))))
	_update_field_aura_visual(trap, "trap", float(intent.get("radius", maxf(0.1, float(trap.stats.get("trap_radius", 0.7))))), 2.0, 0.0)
	for raw_target_intent in Array(intent.get("target_intents", [])):
		if not (raw_target_intent is Dictionary):
			continue
		var target_index := int(Dictionary(raw_target_intent).get("target_index", -1))
		if target_index < 0 or target_index >= targets.size():
			continue
		var target = targets[target_index]
		if not _is_live_unit(target):
			continue
		for raw_action in Array(Dictionary(raw_target_intent).get("actions", [])):
			if not (raw_action is Dictionary):
				continue
			var action: Dictionary = raw_action
			match String(action.get("action", "")):
				"damage":
					_apply_trap_damage(trap, target, player_id, String(action.get("damage_type", "chemical")), int(action.get("damage", 0)), String(action.get("style", "field")))
				"heat":
					_add_unit_heat_event(target, float(action.get("amount", 0.0)), Array(action.get("tags", ["external"])), String(action.get("reason", "trap")))
				"velocity":
					target.velocity += action.get("delta", Vector2.ZERO)
				"slow":
					target.set_meta("slow_timer", maxf(float(target.get_meta("slow_timer", 0.0)), float(action.get("timer", 0.0))))
					target.set_meta("slow_mult", float(action.get("mult", 1.0)))
				"vfx":
					_spawn_hit_effect(target, 1, String(action.get("damage_type", "blunt")), false, String(action.get("style", "web")))
				"displace":
					var launch_offset: Vector2 = action.get("offset", Vector2.ZERO)
					_apply_unit_displacement(target, launch_offset, launch_offset.length())
	_show_battle_message("%s TRAP %s" % [trap.unit_name, effect.to_upper()], 0.8)
	_play_sfx_wave("alarm", 260.0, 0.12, -11.0)


func _trap_launch_direction(trap, player_id: int, input_vector: Vector2) -> Vector2:
	if input_vector.length() > 0.18:
		return input_vector.normalized()
	var text := _command_text(player_id)
	for i in range(text.length() - 1, -1, -1):
		match text.substr(i, 1):
			"6":
				return Vector2.RIGHT
			"4":
				return Vector2.LEFT
			"8":
				return Vector2.UP
			"2":
				return Vector2.DOWN
	return Vector2.RIGHT if int(trap.facing) >= 0 else Vector2.LEFT


func _apply_trap_damage(trap, target, player_id: int, damage_type: String, damage: int, projectile_style: String) -> void:
	if damage <= 0 or not _is_live_unit(target):
		if projectile_style != "":
			_spawn_hit_effect(target, 1, damage_type, false, projectile_style)
		return
	var event: Dictionary = {"damage_type": damage_type, "projectile": projectile_style in ["beam", "spray", "bullet"]}
	var final_damage: int = maxi(1, int(roundf(float(damage) * _vulnerability_multiplier(target, event))))
	final_damage = _projectile_material_adjusted_damage(target, event, final_damage)
	var blocked := final_damage <= 0 or bool(event.get("contact_gate_blocked", false))
	_spawn_hit_effect(target, _counter_tier_for_hit(target, damage_type), damage_type, blocked, projectile_style)
	if blocked:
		return
	_apply_hitstop(damage_type, 1, final_damage)
	var killed: bool = target.take_hit(final_damage, "active", player_id, damage_type, "field")
	if killed:
		_handle_unit_killed(target, player_id)


func _field_targets_for(player_id: int, affects: String) -> Array:
	match affects:
		"ally":
			return _friendly_units(player_id)
		"enemy":
			return _enemy_units(player_id)
	return all_units


func _update_field_aura_visual(barrier, field_kind: String, radius: float, strength: float, delta: float) -> void:
	if effects_root == null or not is_instance_valid(barrier):
		return
	if _barrier_has_map_tiles(barrier):
		var field_tag := _barrier_field_tag_from_kind(field_kind)
		var has_tagged_tiles := _barrier_has_tile_effect_tag(barrier, field_tag)
		var tile_index := 0
		for raw_tile in Array(barrier.stats.get("barrier_map_tiles", [])):
			if not (raw_tile is Dictionary):
				continue
			var tile: Dictionary = raw_tile
			if not _barrier_tile_matches_field(tile, field_tag, has_tagged_tiles):
				continue
			var tile_pos := _barrier_tile_world_position(barrier, tile, true)
			var tile_radius := maxf(radius, float(tile.get("field_radius", 0.0)))
			_update_field_aura_visual_at(barrier, "%s_%d" % [field_kind, tile_index], field_kind, tile_radius, strength, tile_pos, delta)
			tile_index += 1
		return
	_update_field_aura_visual_at(barrier, field_kind, field_kind, radius, strength, Vector2(barrier.ring_pos, barrier.lane), delta)


func _update_field_aura_visual_at(barrier, aura_key_suffix: String, field_kind: String, radius: float, strength: float, world_position: Vector2, delta: float) -> void:
	var key := "field_aura_%s" % field_kind
	if aura_key_suffix != field_kind:
		key = "field_aura_%s" % aura_key_suffix
	var aura = null
	if barrier.has_meta(key):
		aura = barrier.get_meta(key)
	if aura == null or not is_instance_valid(aura):
		aura = FieldAuraEffect.new()
		aura.setup(int(barrier.owner_id), field_kind, radius, strength)
		effects_root.add_child(aura)
		barrier.set_meta(key, aura)
	else:
		aura.setup(int(barrier.owner_id), field_kind, radius, strength)
	var screen := _screen_from_ring(world_position.x, world_position.y)
	aura.update_screen(screen["position"], bool(screen["visible"]) and _is_live_unit(barrier), delta)


func _apply_hatchery(barrier, player_id: int, delta: float) -> void:
	var limit := int(barrier.stats.get("hatch_limit", 0))
	var group: Array = active_units[player_id]["puppet"]
	var hatchlings := 0
	for unit in group:
		if _is_live_unit(unit) and String(unit.get_meta("hatched_from", "")) == str(barrier.get_instance_id()):
			hatchlings += 1
	var intent := _battle_field_runtime_service().hatchery_intent({
		"limit": limit,
		"hatchlings": hatchlings,
		"interval": float(barrier.stats.get("hatch_interval", 6.0)),
		"timer": float(barrier.get_meta("hatch_timer", float(barrier.stats.get("hatch_interval", 6.0)))),
		"delta": delta,
	})
	if String(intent.get("action", "")) != "spawn":
		if intent.has("timer"):
			barrier.set_meta("hatch_timer", float(intent.get("timer", 0.0)))
		return
	barrier.set_meta("hatch_timer", float(intent.get("timer", float(barrier.stats.get("hatch_interval", 6.0)))))
	var stats := _hatchling_stats(barrier, player_id)
	var unit = _create_unit(player_id, "puppet", stats, "P%d HATCHLING %d" % [player_id, hatchlings + 1], wrapf(barrier.ring_pos + 0.16 * float(barrier.facing), 0.0, RING_LENGTH), clampf(barrier.lane + sin(float(hatchlings)) * 0.18, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT))
	unit.set_meta("hatched_from", str(barrier.get_instance_id()))
	group.append(unit)
	active_units[player_id]["puppet"] = group
	_show_battle_message("P%d hatchery spawned %s" % [player_id, String(stats.get("name", "HATCHLING"))], 0.75)


func _hatchling_stats(barrier, player_id: int) -> Dictionary:
	return _battle_field_runtime_service().hatchling_stats_intent({
		"stats": barrier.stats,
		"primary_color": _team_primary_color(player_id),
		"accent_color": _team_accent_color(player_id),
	})


func _apply_barrier_field_damage(barrier, target, player_id: int, damage_type: String, damage: int, interval: float, delta: float) -> void:
	if not _is_live_unit(target):
		return
	var key := "field_tick_%d" % int(target.get_instance_id())
	var timer := maxf(0.0, float(barrier.get_meta(key, 0.0)) - delta)
	if timer > 0.0:
		barrier.set_meta(key, timer)
		return
	barrier.set_meta(key, interval)
	var event: Dictionary = {"damage_type": damage_type, "projectile": false}
	var final_damage: int = maxi(1, int(roundf(float(damage) * _vulnerability_multiplier(target, event))))
	final_damage = _projectile_material_adjusted_damage(target, event, final_damage)
	var blocked := final_damage <= 0 or bool(event.get("contact_gate_blocked", false))
	_spawn_hit_effect(target, 1, damage_type, blocked, "field")
	if blocked:
		return
	var killed: bool = target.take_hit(final_damage, "normal", player_id, damage_type, "field")
	if killed:
		_handle_unit_killed(target, player_id)


func _unit_in_barrier_aura(barrier, unit, aura_range: float, field_tag: String = "") -> bool:
	if not _is_live_unit(unit):
		return false
	if _barrier_has_map_tiles(barrier):
		var unit_radius := float(unit.stats.get("radius", 0.2))
		var has_tagged_tiles := _barrier_has_tile_effect_tag(barrier, field_tag)
		for raw_tile in Array(barrier.stats.get("barrier_map_tiles", [])):
			if not (raw_tile is Dictionary):
				continue
			var tile: Dictionary = raw_tile
			if not _barrier_tile_matches_field(tile, field_tag, has_tagged_tiles):
				continue
			var tile_pos := _barrier_tile_world_position(barrier, tile, true)
			var tile_extent := maxf(float(tile.get("radius", 0.08)), float(tile.get("length", 0.2)) * 0.5)
			var range_x := aura_range + tile_extent + unit_radius
			var range_y := aura_range * 0.72 + tile_extent * 0.5 + unit_radius
			var tile_delta := _mobius_delta_points(tile_pos.x, tile_pos.y, unit.ring_pos, unit.lane)
			if absf(tile_delta.x) <= range_x and absf(tile_delta.y) <= range_y:
				return true
		return false
	var delta := _mobius_delta_vec_between(barrier, unit)
	return absf(delta.x) <= aura_range + float(unit.stats.get("radius", 0.2)) and absf(delta.y) <= aura_range * 0.72 + float(unit.stats.get("radius", 0.2))


func _friendly_units(player_id: int) -> Array:
	if battle_awareness_service != null:
		var data := _battle_awareness_active_unit_data()
		return _battle_awareness_units_for_ids(
			battle_awareness_service.friendly_ids(player_id, Array(data.get("snapshots", []))),
			Dictionary(data.get("refs", {}))
		)
	var units: Array = []
	var hero = active_units[player_id]["hero"]
	if _is_live_unit(hero):
		units.append(hero)
	var barrier = active_units[player_id]["barrier"]
	if _is_live_unit(barrier):
		units.append(barrier)
	for unit in active_units[player_id]["puppet"]:
		if _is_live_unit(unit):
			units.append(unit)
	for unit in active_star_soul_units:
		if _is_live_unit(unit) and int(unit.owner_id) == player_id:
			units.append(unit)
	return units


func _resolve_unit_body_spacing(delta: float) -> void:
	var initial_plan := _battle_runtime_facade().contact_pass_plan({
		"delta": delta,
		"live_subject_count": 0,
		"has_runtime_subject": false,
		"gpu_available": false,
	})
	if not bool(initial_plan.get("should_process", false)):
		return
	if bool(initial_plan.get("reset_counters", false)):
		runtime_contact_pairs_seen = {}
		gpu_collision_pair_dispatch_count = 0
		gpu_collision_candidate_count = 0
		gpu_collision_contact_count = 0
		gpu_collision_skipped_runtime_pairs = 0
		gpu_collision_readback_bytes = 0
	if bool(initial_plan.get("cleanup_suppression", false)):
		_cleanup_active_melee_contact_suppression()
	var live_subjects: Array = []
	var has_runtime_subject := false
	for unit in all_units:
		if _is_live_unit(unit) and _unit_is_mech_physics_subject(unit):
			live_subjects.append(unit)
			if _unit_uses_direct_runtime_topology(unit):
				has_runtime_subject = true
	var plan := _battle_runtime_facade().contact_pass_plan({
		"delta": delta,
		"live_subject_count": live_subjects.size(),
		"has_runtime_subject": has_runtime_subject,
		"gpu_available": _gpu_collision_available() if has_runtime_subject else false,
	})
	if bool(plan.get("gpu_runtime_contact", false)):
		_gpu_collision_and_response_step(live_subjects, delta)
	elif bool(plan.get("warn_gpu_unavailable", false)):
		gpu_collision_skipped_runtime_pairs += 1
		_warn_gpu_collision_unavailable()
	if bool(plan.get("cpu_pair_spacing", false)):
		for i in range(live_subjects.size()):
			var a = live_subjects[i]
			if not _is_live_unit(a):
				continue
			for j in range(i + 1, live_subjects.size()):
				var b = live_subjects[j]
				if not _is_live_unit(b):
					continue
				_separate_unit_pair(a, b, delta)
	for unit in live_subjects:
		if _is_live_unit(unit):
			_separate_unit_from_terrain(unit, delta)
	if bool(plan.get("cleanup_active_pairs", false)):
		for key in runtime_contact_pairs_active.keys():
			if not runtime_contact_pairs_seen.has(key):
				runtime_contact_pairs_active.erase(key)


func _separate_unit_pair(a, b, delta: float) -> void:
	var offset := _mobius_delta_vec_between(a, b)
	var distance := offset.length()
	var exact_runtime_pair := _unit_uses_direct_runtime_topology(a) or _unit_uses_direct_runtime_topology(b)
	if exact_runtime_pair:
		return
	if not exact_runtime_pair and not (_barrier_has_map_tiles(a) or _barrier_has_map_tiles(b)):
		var a_radius := _unit_contact_radius(a)
		var b_radius := _unit_contact_radius(b)
		var min_distance := a_radius + b_radius + UNIT_BODY_SPACING_PADDING
		if distance < min_distance:
			var direction := offset / distance if distance > 0.001 else Vector2(float(1 if int(a.owner_id) <= int(b.owner_id) else -1), 0.0)
			var penetration := min_distance - distance
			var mass_a := _unit_effective_mass(a)
			var mass_b := _unit_effective_mass(b)
			var total_mass := mass_a + mass_b
			var a_share := clampf(mass_b / total_mass, 0.12, 0.88)
			var b_share := clampf(mass_a / total_mass, 0.12, 0.88)
			var thruster_a := _unit_thruster_power(a)
			var thruster_b := _unit_thruster_power(b)
			var a_anchor := clampf(thruster_a / (thruster_a + mass_b * 0.28 + 8.0), 0.0, 0.58)
			var b_anchor := clampf(thruster_b / (thruster_b + mass_a * 0.28 + 8.0), 0.0, 0.58)
			var correction := penetration * clampf(0.62 + delta * 6.0, 0.62, 0.94)
			var a_move := correction * a_share * (1.0 - a_anchor * 0.42)
			var b_move := correction * b_share * (1.0 - b_anchor * 0.42)
			_apply_unit_displacement(a, -direction, a_move)
			_apply_unit_displacement(b, direction, b_move)
			a.velocity -= direction * a_move * 1.35
			b.velocity += direction * b_move * 1.35
			if a.has_method("apply_physics_impulse"):
				a.apply_physics_impulse(-direction, a_move * 0.82, -1, 0.0)
			if b.has_method("apply_physics_impulse"):
				b.apply_physics_impulse(direction, b_move * 0.82, -1, 0.0)
	_separate_unit_part_pair(a, b, delta)


func _separate_unit_part_pair(a, b, delta: float) -> void:
	if a == b:
		return
	var a_colliders := _unit_part_colliders(a)
	var b_colliders := _unit_part_colliders(b)
	if a_colliders.is_empty() or b_colliders.is_empty():
		return
	var exact_runtime_pair := _unit_uses_direct_runtime_topology(a) or _unit_uses_direct_runtime_topology(b)
	if exact_runtime_pair:
		a_colliders = _runtime_contact_sorted_colliders(a_colliders)
		b_colliders = _runtime_contact_sorted_colliders(b_colliders)
	var contact_padding := 0.0 if exact_runtime_pair else UNIT_PART_SPACING_PADDING
	var patch_origin := _combat_patch_origin_for_unit(a)
	var origin_x: float = patch_origin.x
	var origin_lane: float = patch_origin.y
	var mass_a := _unit_effective_mass(a)
	var mass_b := _unit_effective_mass(b)
	var total_mass := mass_a + mass_b
	var a_share := clampf(mass_b / total_mass, 0.12, 0.88)
	var b_share := clampf(mass_a / total_mass, 0.12, 0.88)
	var max_checks := 0
	var deferred_runtime_responses: Array = []
	var shifted_a_colliders: Array = []
	for raw_a in a_colliders:
		if not (raw_a is Dictionary):
			continue
		var raw_collider_a: Dictionary = raw_a
		shifted_a_colliders.append({"raw": raw_collider_a, "shifted": _shift_collider_to_origin(raw_collider_a, origin_x, origin_lane)})
	var shifted_b_colliders: Array = []
	for raw_b in b_colliders:
		if not (raw_b is Dictionary):
			continue
		var raw_collider_b: Dictionary = raw_b
		shifted_b_colliders.append({"raw": raw_collider_b, "shifted": _shift_collider_to_origin(raw_collider_b, origin_x, origin_lane)})
	for entry_a in shifted_a_colliders:
		var raw_collider_a: Dictionary = Dictionary(entry_a.get("raw", {}))
		var collider_a: Dictionary = Dictionary(entry_a.get("shifted", {}))
		for entry_b in shifted_b_colliders:
			collision_pair_loop_count += 1
			var raw_collider_b: Dictionary = Dictionary(entry_b.get("raw", {}))
			var collider_b: Dictionary = Dictionary(entry_b.get("shifted", {}))
			var broadphase_gap := _collider_broadphase_gap(collider_a, collider_b)
			var broadphase_margin := contact_padding + (RUNTIME_CONTACT_REQUIRED_OVERLAP if exact_runtime_pair else 0.0) + 0.02
			if broadphase_gap > broadphase_margin:
				collision_broadphase_skip_count += 1
				continue
			collision_polygon_precise_check_count += 1
			var gap := _collider_gap(collider_a, collider_b) - contact_padding
			if exact_runtime_pair:
				if gap > -RUNTIME_CONTACT_REQUIRED_OVERLAP:
					continue
			elif gap >= 0.0:
				continue
			var direction := _collider_center(collider_b) - _collider_center(collider_a)
			if direction.length() <= 0.001:
				direction = _mobius_delta_vec_between(a, b)
			if direction.length() <= 0.001:
				direction = Vector2(float(1 if int(a.owner_id) <= int(b.owner_id) else -1), 0.0)
			direction = direction.normalized()
			if int(a.owner_id) != int(b.owner_id):
				if exact_runtime_pair:
					_resolve_runtime_contact_pair_once(a, raw_collider_a, collider_a, b, raw_collider_b, collider_b, direction, -gap, deferred_runtime_responses)
				else:
					_resolve_passive_contact_pair(a, raw_collider_a, collider_a, b, raw_collider_b, collider_b, direction, -gap, delta)
				if not _is_live_unit(a) or not _is_live_unit(b):
					_flush_runtime_contact_velocity_responses(deferred_runtime_responses)
					return
			var penetration := minf(-gap, 0.22)
			var correction := penetration * clampf(0.44 + delta * 8.0, 0.44, 0.86)
			if exact_runtime_pair:
				correction = penetration * clampf(0.58 + delta * 5.0, 0.58, 0.92)
			var a_move := correction * a_share
			var b_move := correction * b_share
			if _unit_is_anchored_barrier(a) and _unit_is_anchored_barrier(b):
				a_move = 0.0
				b_move = 0.0
			elif _unit_is_anchored_barrier(a):
				b_move = correction
				a_move = 0.0
			elif _unit_is_anchored_barrier(b):
				a_move = correction
				b_move = 0.0
			_apply_unit_displacement(a, -direction, a_move)
			_apply_unit_displacement(b, direction, b_move)
			if not exact_runtime_pair:
				a.velocity -= direction * a_move * 2.0
				b.velocity += direction * b_move * 2.0
				if a.has_method("apply_physics_impulse"):
					a.apply_physics_impulse(-direction, a_move * 1.65, int(collider_a.get("part_index", -1)), 0.0)
				if b.has_method("apply_physics_impulse"):
					b.apply_physics_impulse(direction, b_move * 1.65, int(collider_b.get("part_index", -1)), 0.0)
			max_checks += 1
			if max_checks >= 10:
				_flush_runtime_contact_velocity_responses(deferred_runtime_responses)
				return
	_flush_runtime_contact_velocity_responses(deferred_runtime_responses)


func _terrain_collision_candidates_for_runtime() -> Array:
	return _battle_terrain_service().combined_collision_candidates(_battle_terrain_runtime_snapshot(), [])


func _separate_unit_from_terrain(unit, delta: float) -> void:
	if not _is_live_unit(unit) or _unit_is_anchored_barrier(unit):
		return
	var terrain_candidates := _terrain_collision_candidates_for_runtime()
	if terrain_candidates.is_empty():
		return
	var unit_colliders := _unit_part_colliders(unit)
	if unit_colliders.is_empty():
		return
	var patch_origin := _combat_patch_origin_for_unit(unit)
	var origin_x: float = patch_origin.x
	var origin_lane: float = patch_origin.y
	var resolved_count := 0
	for raw_unit_collider in unit_colliders:
		if not (raw_unit_collider is Dictionary):
			continue
		patch_origin = _combat_patch_origin_for_unit(unit)
		origin_x = patch_origin.x
		origin_lane = patch_origin.y
		var unit_raw: Dictionary = raw_unit_collider
		var unit_collider := _shift_collider_to_origin(unit_raw, origin_x, origin_lane)
		for raw_candidate in terrain_candidates:
			if not (raw_candidate is Dictionary):
				continue
			var terrain_candidate: Dictionary = raw_candidate
			var terrain_collider := _shift_collider_to_origin(Dictionary(terrain_candidate.get("collider", {})), origin_x, origin_lane)
			if terrain_collider.is_empty():
				continue
			var broadphase_gap := _collider_broadphase_gap(unit_collider, terrain_collider)
			if broadphase_gap > 0.02:
				collision_broadphase_skip_count += 1
				continue
			collision_polygon_precise_check_count += 1
			var gap := _collider_gap(unit_collider, terrain_collider)
			if gap >= 0.0:
				continue
			var direction := _collider_center(unit_collider) - _collider_center(terrain_collider)
			if direction.length() <= 0.001:
				direction = Vector2(float(1 if int(unit.owner_id) <= 1 else -1), 0.0)
			direction = direction.normalized()
			var penetration := minf(-gap, 0.35)
			var correction := penetration * clampf(0.52 + delta * 8.0, 0.52, 0.9)
			_apply_unit_displacement(unit, direction, correction)
			unit.velocity += direction * maxf(0.08, correction * 1.8)
			if unit.has_method("apply_physics_impulse"):
				unit.apply_physics_impulse(direction, correction * 1.2, int(unit_raw.get("part_index", -1)), 0.0)
			unit.set_meta("terrain_collision_feature_id", String(terrain_candidate.get("feature_id", "")))
			unit.set_meta("terrain_collision_kind", String(terrain_candidate.get("terrain_kind", "")))
			unit.set_meta("terrain_collision_source", String(terrain_candidate.get("source", "terrain")))
			unit.set_meta("terrain_collision_blocker_name", String(terrain_candidate.get("blocker_name", terrain_candidate.get("feature_id", "TERRAIN"))))
			patch_origin = _combat_patch_origin_for_unit(unit)
			origin_x = patch_origin.x
			origin_lane = patch_origin.y
			unit_collider = _shift_collider_to_origin(unit_raw, origin_x, origin_lane)
			resolved_count += 1
			if resolved_count >= 6:
				return


func _gpu_collision_and_response_step(live_subjects: Array, delta: float) -> void:
	if delta <= 0.0 or live_subjects.size() < 2:
		return
	var gpu_colliders: Array = []
	var entries: Array = []
	var unit_key := 1
	for unit in live_subjects:
		if not _is_live_unit(unit):
			continue
		var colliders := _unit_part_colliders(unit)
		if colliders.is_empty():
			continue
		if _unit_uses_direct_runtime_topology(unit):
			colliders = _runtime_contact_sorted_colliders(colliders)
		_append_gpu_collision_unit_colliders(unit, colliders, 0.0, unit_key, entries, gpu_colliders)
		unit_key += 1
	if gpu_colliders.size() < 2:
		return
	gpu_collision_pair_dispatch_count += 1
	var records := gpu_collision_pipeline.compute_contact_responses_deferred(gpu_colliders, RUNTIME_CONTACT_REQUIRED_OVERLAP, delta)
	gpu_collision_candidate_count += int(gpu_collision_pipeline.last_candidate_count)
	gpu_collision_contact_count += records.size()
	gpu_collision_readback_bytes += int(gpu_collision_pipeline.last_readback_bytes)
	if records.is_empty():
		return
	for raw_record in records:
		if not (raw_record is Dictionary):
			continue
		var record: Dictionary = raw_record
		var index_a := int(record.get("index_a", -1))
		var index_b := int(record.get("index_b", -1))
		if index_a < 0 or index_b < 0 or index_a >= entries.size() or index_b >= entries.size():
			continue
		var entry_a: Dictionary = Dictionary(entries[index_a])
		var entry_b: Dictionary = Dictionary(entries[index_b])
		var unit_a = entry_a.get("unit", null)
		var unit_b = entry_b.get("unit", null)
		if unit_a == unit_b or unit_a == null or unit_b == null:
			continue
		if not is_instance_valid(unit_a) or not is_instance_valid(unit_b):
			continue
		if not _is_live_unit(unit_a) or not _is_live_unit(unit_b):
			continue
		var raw_collider_a: Dictionary = Dictionary(entry_a.get("raw", {}))
		var raw_collider_b: Dictionary = Dictionary(entry_b.get("raw", {}))
		var collider_a: Dictionary = Dictionary(entry_a.get("shifted", {}))
		var collider_b: Dictionary = Dictionary(entry_b.get("shifted", {}))
		_resolve_runtime_gpu_contact_once(unit_a, raw_collider_a, collider_a, unit_b, raw_collider_b, collider_b, record)


func _resolve_runtime_gpu_contact_once(a, raw_collider_a: Dictionary, collider_a: Dictionary, b, raw_collider_b: Dictionary, collider_b: Dictionary, response: Dictionary) -> void:
	var normal: Vector2 = response.get("normal", Vector2.ZERO)
	if normal.length() <= 0.001 or not _is_live_unit(a) or not _is_live_unit(b):
		return
	normal = normal.normalized()
	var penetration := maxf(0.0, float(response.get("penetration", 0.0)))
	var key := _runtime_contact_pair_key(a, raw_collider_a, b, raw_collider_b)
	var source_a := _runtime_contact_source_for_collider(raw_collider_a)
	var source_b := _runtime_contact_source_for_collider(raw_collider_b)
	var intent := _runtime_contact_service().gpu_contact_intent({
		"normal": normal,
		"penetration": penetration,
		"position_delta_a": response.get("position_delta_a", Vector2.ZERO),
		"position_delta_b": response.get("position_delta_b", Vector2.ZERO),
		"pair_active": runtime_contact_pairs_active.has(key),
		"recovery_a": bool(response.get("recovery_a", false)),
		"recovery_b": bool(response.get("recovery_b", false)),
		"raw_contact_momentum": response.get("raw_contact_momentum", response.get("usable_contact_momentum", 0.0)),
		"usable_contact_momentum": response.get("usable_contact_momentum", 0.0),
		"relative_normal_velocity": response.get("relative_normal_velocity", 0.0),
		"vfx_strength": response.get("vfx_strength", 0.0),
		"vfx_kind": response.get("vfx_kind", 0),
		"source_a": source_a,
		"source_b": source_b,
		"owner_a_id": int(a.owner_id),
		"owner_b_id": int(b.owner_id),
		"suppressed_a": _active_melee_contact_damage_suppressed(a, raw_collider_a, b, raw_collider_b),
		"suppressed_b": _active_melee_contact_damage_suppressed(b, raw_collider_b, a, raw_collider_a),
		"velocity_delta_a": response.get("velocity_delta_a", Vector2.ZERO),
		"velocity_delta_b": response.get("velocity_delta_b", Vector2.ZERO),
		"constants": _runtime_contact_constants(),
	})
	if not bool(intent.get("mark_seen", false)):
		return
	runtime_contact_pairs_seen[key] = true
	var position_delta_a: Vector2 = intent.get("position_delta_a", Vector2.ZERO)
	var position_delta_b: Vector2 = intent.get("position_delta_b", Vector2.ZERO)
	_apply_gpu_position_delta(a, position_delta_a)
	_apply_gpu_position_delta(b, position_delta_b)
	if not bool(intent.get("should_process", false)):
		return
	runtime_contact_pairs_active[key] = true
	if bool(intent.get("recovery_a", false)):
		_force_runtime_collision_recovery_from_gpu(a, raw_collider_a)
	if bool(intent.get("recovery_b", false)):
		_force_runtime_collision_recovery_from_gpu(b, raw_collider_b)
	var contact_momentum := maxf(0.0, float(intent.get("contact_momentum", 0.0)))
	var hit_position: Vector2 = response.get("contact_point", _collider_hit_position(collider_a, collider_b))
	_emit_gpu_contact_vfx_descriptor(hit_position, normal, maxf(0.0, float(intent.get("vfx_strength", 0.0))), int(intent.get("vfx_kind", 0)))
	if bool(intent.get("damage_a", false)):
		_apply_runtime_contact_damage(a, raw_collider_a, b, raw_collider_b, normal, contact_momentum, hit_position, source_a)
	if _is_live_unit(a) and _is_live_unit(b):
		if bool(intent.get("damage_b", false)):
			_apply_runtime_contact_damage(b, raw_collider_b, a, raw_collider_a, -normal, contact_momentum, hit_position, source_b)
	if _is_live_unit(a) and _is_live_unit(b):
		if bool(intent.get("apply_velocity_delta", false)):
			_apply_runtime_contact_velocity_delta(a, b, intent.get("velocity_delta_a", Vector2.ZERO), intent.get("velocity_delta_b", Vector2.ZERO))


func _emit_gpu_contact_vfx_descriptor(hit_position: Vector2, normal: Vector2, strength: float, kind: int) -> void:
	if strength <= 0.0 or battle_contact_vfx_pool == null or not is_instance_valid(battle_contact_vfx_pool):
		return
	if not _consume_battle_vfx_budget("contact_particle"):
		return
	if not _is_valid_combat_position(hit_position):
		return
	var screen := _screen_from_ring(wrapf(hit_position.x, 0.0, RING_LENGTH), clampf(hit_position.y, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT))
	if not bool(screen.get("visible", true)):
		return
	battle_contact_vfx_pool.emit_gpu_contact(screen["position"], normal, strength, kind)


func _apply_gpu_position_delta(unit, delta_vec: Vector2) -> void:
	if unit == null or not is_instance_valid(unit) or delta_vec.length() <= 0.00001:
		return
	_apply_unit_displacement(unit, delta_vec.normalized(), delta_vec.length())


func _apply_runtime_contact_velocity_delta(a, b, delta_a: Vector2, delta_b: Vector2) -> void:
	if a != null and is_instance_valid(a) and _is_live_unit(a) and not _unit_is_anchored_barrier(a):
		a.velocity += delta_a
		_request_runtime_collision_brake(a)
	if b != null and is_instance_valid(b) and _is_live_unit(b) and not _unit_is_anchored_barrier(b):
		b.velocity += delta_b
		_request_runtime_collision_brake(b)


func _force_runtime_collision_recovery_from_gpu(unit, collider: Dictionary) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	var node_index := int(collider.get("node_index", collider.get("part_index", -1)))
	if node_index < 0:
		return
	if unit.has_method("force_runtime_recovery_from_gpu"):
		unit.force_runtime_recovery_from_gpu(node_index)
	elif unit.has_method("force_runtime_recovery_from_collision"):
		unit.force_runtime_recovery_from_collision(node_index)


func _append_gpu_collision_unit_colliders(unit, colliders: Array, origin_x: float, unit_key: int, entries: Array, gpu_colliders: Array, origin_lane: float = 1.0e20, query_event: Dictionary = {}) -> void:
	for raw in colliders:
		if not (raw is Dictionary):
			continue
		var raw_collider: Dictionary = raw
		var shifted := _shift_collider_to_origin(raw_collider, origin_x, origin_lane)
		if bool(query_event.get("projectile", false)):
			shifted = _target_collider_for_projectile_query(unit, shifted, query_event)
		shifted["gpu_unit_key"] = unit_key
		shifted["gpu_team_key"] = int(unit.owner_id) if unit != null and is_instance_valid(unit) else 0
		shifted["gpu_mass"] = maxf(1.0, _unit_effective_mass(unit)) if unit != null and is_instance_valid(unit) else maxf(1.0, float(raw_collider.get("mass", 1.0)))
		shifted["gpu_path_stiffness"] = _runtime_contact_path_stiffness(unit, raw_collider) if unit != null and is_instance_valid(unit) else maxf(1.0, float(raw_collider.get("path_stiffness_momentum", raw_collider.get("stiffness_momentum", 1.0))))
		shifted["gpu_recovery_capable"] = _gpu_collision_recovery_capable(unit, raw_collider)
		shifted["gpu_action_phase"] = _gpu_collision_action_phase(unit, raw_collider)
		shifted["gpu_anchored"] = _unit_is_anchored_barrier(unit) if unit != null and is_instance_valid(unit) else false
		shifted["unit_velocity"] = unit.velocity if unit != null and is_instance_valid(unit) else Vector2.ZERO
		entries.append({
			"unit": unit,
			"raw": raw_collider,
			"query": shifted.duplicate(true),
			"shifted": shifted,
		})
		gpu_colliders.append(shifted)


func _gpu_collision_recovery_capable(unit, collider: Dictionary) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	var node_index := int(collider.get("node_index", collider.get("part_index", -1)))
	if node_index < 0:
		return false
	var actions = unit.get("runtime_module_actions")
	if not (actions is Array):
		return false
	return _runtime_contact_service().runtime_recovery_capable(Array(actions), node_index)


