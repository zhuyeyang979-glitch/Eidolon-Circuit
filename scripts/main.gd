			"joint_engine_demand": _joint_engine_demand_for_part(part, slot_key) if slot_key in ["limb_muscle", "muscle"] and not _component_is_torso(part) else 0.0,
			"momentum_min": _limb_momentum_min_for_part(part, slot_key) if slot_key in ["limb_muscle", "muscle"] and not _component_is_torso(part) else 0.0,
			"momentum_max": _limb_momentum_max_for_part(part, slot_key) if slot_key in ["limb_muscle", "muscle"] and not _component_is_torso(part) else 0.0,
			"allocated_limb_momentum": _default_limb_allocated_momentum_for_part(part, slot_key) if slot_key in ["limb_muscle", "muscle"] and not _component_is_torso(part) else 0.0,
			"joint_speed_cap": _limb_joint_speed_cap_for_part(part, slot_key) if slot_key in ["limb_muscle", "muscle"] and not _component_is_torso(part) else 0.0,
			"limb_idle_heat_coeff": _limb_drive_heat_coeff_for_part(part, slot_key) if slot_key in ["limb_muscle", "muscle"] and not _component_is_torso(part) else 0.0,
			"joint_angle_range": float(part.get("joint_angle_range", float(_embedded_joint_profile_for_part(part, slot_key).get("angle", 0.0)))) if slot_key in ["limb_muscle", "muscle"] and not _component_is_torso(part) else 0.0,
			"joint_extension_m": float(part.get("joint_extension_m", float(_embedded_joint_profile_for_part(part, slot_key).get("extension", 0.0)))) if slot_key in ["limb_muscle", "muscle"] and not _component_is_torso(part) else 0.0,
		}
		if _topology_node_is_torso(role_key, node, unit_bp):
			var torso_part := part
			# PartArt.torso_hull_local_points() is the shared source for the
			# visible torso hull and its runtime collider.
			var length := maxf(0.08, float(torso_part.get("length", 0.32)))
			var radius := maxf(0.018, float(torso_part.get("radius", 0.09)))
			var center := (_topology_node_position(node) - origin) * TOPOLOGY_BOARD_PHYSICAL_UNITS
			var side_axis := Vector2(-axis.y, axis.x)
			var front_width := radius * 1.2
			var rear_width := radius * 2.4
			var polygon_local: Array = []
			for raw_point in AssemblyBoardRenderer.torso_hull_polygon(center, axis, torso_part, length, front_width, rear_width):
				polygon_local.append(raw_point)
			segment["part_kind"] = "torso"
			segment["shape"] = "polygon"
			segment["a_local"] = center - axis * length * 0.5
			segment["b_local"] = center + axis * length * 0.5
			segment["polygon_local"] = polygon_local
			segment["radius"] = radius
			segments.append(segment)
			continue
		if slot_key == "joint":
			continue
		var part_kind := "terminal" if _part_counts_as_terminal_weapon(part, slot_key) else "limb_muscle"
		var effective_part := _part_with_effective_terminal_geometry(part, slot_key)
		var start_pos := _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, i, "root_joint", -1)
		var end_pos := start_pos
		if part_kind == "terminal":
			var length_terminal := maxf(0.0, float(effective_part.get("length", 0.0)))
			end_pos = start_pos + axis * (length_terminal / TOPOLOGY_BOARD_PHYSICAL_UNITS)
			segment["terminal_socket_local"] = (start_pos - origin) * TOPOLOGY_BOARD_PHYSICAL_UNITS
			segment["terminal_tip_local"] = (end_pos - origin) * TOPOLOGY_BOARD_PHYSICAL_UNITS
		else:
			end_pos = _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, i, "distal", -1)
			if end_pos.distance_to(start_pos) <= 0.0001:
				var length_limb := maxf(0.0, float(effective_part.get("length", part.get("length", 0.0))))
				end_pos = start_pos + axis * (length_limb / TOPOLOGY_BOARD_PHYSICAL_UNITS)
		segment["part_kind"] = part_kind
		segment["a_local"] = (start_pos - origin) * TOPOLOGY_BOARD_PHYSICAL_UNITS
		segment["b_local"] = (end_pos - origin) * TOPOLOGY_BOARD_PHYSICAL_UNITS
		segment["radius"] = maxf(0.006, float(effective_part.get("radius", part.get("radius", 0.025))))
		segments.append(segment)
	return segments


func _runtime_module_bindings_for_blueprint(role_key: String, unit_bp: Dictionary) -> Array:
	var result: Array = []
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	for raw_binding in Array(unit_bp.get("module_bindings", [])):
		if not (raw_binding is Dictionary):
			continue
		var binding: Dictionary = Dictionary(raw_binding).duplicate(true)
		var payload_index := int(binding.get("software_slot_index", -1))
		if payload_index < 0 or payload_index >= payloads.size() or not (payloads[payload_index] is Dictionary):
			continue
		var payload: Dictionary = payloads[payload_index]
		if String(payload.get("kind", "")) != "module":
			continue
		var module_index := int(binding.get("module_index", payload.get("module", -1)))
		if module_index < 0:
			continue
		var module_part := _selected_component(role_key, "module", module_index)
		var invalid_reason := _module_binding_invalid_reason(unit_bp, payload_index, payload, module_part, binding)
		if invalid_reason != "":
			binding["runtime_valid"] = false
			binding["binding_valid_note"] = invalid_reason
			result.append(binding)
			continue
		binding["runtime_valid"] = true
		binding["binding_valid_note"] = "OK"
		binding["module_index"] = module_index
		binding["module_part"] = module_part.duplicate(true)
		binding["module_action_profile"] = String(module_part.get("module_action_profile", ""))
		binding["command_window_profile"] = String(module_part.get("command_window_profile", binding.get("command_window_profile", "")))
		binding["attack_key"] = clampi(int(binding.get("attack_key", 1)), 1, ATTACK_GROUP_COUNT)
		result.append(binding)
	return result


func _bound_joint_budget_for_stats(stats: Dictionary) -> Dictionary:
	var nodes: Array = Array(stats.get("runtime_topology_nodes", []))
	var segments: Array = Array(stats.get("runtime_topology_segments", []))
	var segment_by_node := {}
	for raw_segment in segments:
		if raw_segment is Dictionary:
			var segment: Dictionary = raw_segment
			segment_by_node[int(segment.get("node_index", -9999))] = segment
	var counted := {}
	var allocation := 0.0
	var output := 0.0
	var heat_load := 0.0
	var count := 0
	var total_mass := 0.0
	var max_span := 0.0
	var invalid_count := 0
	var invalid_notes: Array = []
	for raw_binding in Array(stats.get("runtime_module_bindings", [])):
		if not (raw_binding is Dictionary):
			continue
		var binding: Dictionary = raw_binding
		if not bool(binding.get("runtime_valid", true)):
			continue
		var module_part: Dictionary = binding.get("module_part", {}) if binding.get("module_part", {}) is Dictionary else {}
		for raw_node in Array(binding.get("target_nodes", [])):
			var node_index := int(raw_node)
			if counted.has(node_index):
				continue
			if not segment_by_node.has(node_index):
				continue
			var segment: Dictionary = segment_by_node[node_index]
			if String(segment.get("part_kind", "")) == "torso":
				continue
			var drive_kind := String(segment.get("joint_drive_kind", "rigid"))
			if drive_kind == "rigid" or drive_kind == "port":
				continue
			var joint_output := maxf(0.0, float(segment.get("joint_output_momentum_base", 0.0)))
			var min_momentum := maxf(0.0, float(segment.get("momentum_min", 0.0)))
			var max_momentum := maxf(0.0, float(segment.get("momentum_max", 0.0)))
			var allocated := maxf(0.0, float(segment.get("allocated_limb_momentum", 0.0)))
			var heat_coeff := _limb_drive_heat_coeff_for_segment(segment, module_part)
			var by_node = binding.get("joint_drive_allocation_by_node", binding.get("allocated_limb_momentum_by_node", {}))
			var node_key := str(node_index)
			if by_node is Dictionary and Dictionary(by_node).has(node_key):
				allocated = maxf(0.0, float(Dictionary(by_node).get(node_key, 0.0)))
			elif by_node is Dictionary and Dictionary(by_node).has(node_index):
				allocated = maxf(0.0, float(Dictionary(by_node).get(node_index, 0.0)))
			elif binding.has("joint_drive_allocation_total"):
				var target_count_drive := maxi(1, Array(binding.get("target_nodes", [])).size())
				allocated = maxf(0.0, float(binding["joint_drive_allocation_total"]) / float(target_count_drive))
			elif binding.has("joint_drive_demand"):
				var target_count_demand := maxi(1, Array(binding.get("target_nodes", [])).size())
				allocated = maxf(0.0, float(binding["joint_drive_demand"]) / float(target_count_demand))
			elif binding.has("allocated_limb_momentum"):
				var target_count := maxi(1, Array(binding.get("target_nodes", [])).size())
				allocated = maxf(0.0, float(binding["allocated_limb_momentum"]) / float(target_count))
			elif binding.has("allocated_momentum"):
				var target_count_alt := maxi(1, Array(binding.get("target_nodes", [])).size())
				allocated = maxf(0.0, float(binding["allocated_momentum"]) / float(target_count_alt))
			if joint_output <= 0.0 and node_index >= 0 and node_index < nodes.size() and nodes[node_index] is Dictionary:
				var node: Dictionary = nodes[node_index]
				var slot_key := _topology_node_slot(node)
				var part_index := int(node.get("part_index", node.get(slot_key, 0)))
				var part := _selected_component(String(stats.get("role", "hero")), slot_key, part_index)
				joint_output = _joint_output_momentum_base_for_part(part, slot_key, module_part)
				min_momentum = _limb_momentum_min_for_part(part, slot_key)
				max_momentum = _limb_momentum_max_for_part(part, slot_key)
				heat_coeff = _limb_drive_heat_coeff_for_part(part, slot_key, module_part)
				if allocated <= 0.0:
					allocated = _default_limb_allocated_momentum_for_part(part, slot_key, module_part)
			if allocated <= 0.0:
				allocated = joint_output
			if allocated <= 0.0 and joint_output <= 0.0:
				continue
			counted[node_index] = true
			count += 1
			allocation += allocated
			output += joint_output
			heat_load += maxf(0.0, allocated) * heat_coeff
			if min_momentum > 0.0 and allocated + 0.001 < min_momentum:
				invalid_count += 1
				invalid_notes.append("node %d allocation %.0f < min %.0f" % [node_index, allocated, min_momentum])
			if max_momentum > 0.0 and allocated - 0.001 > max_momentum:
				invalid_count += 1
				invalid_notes.append("node %d allocation %.0f > max %.0f" % [node_index, allocated, max_momentum])
			total_mass += maxf(0.0, float(segment.get("mass", 0.0)))
			var a: Vector2 = segment.get("a_local", Vector2.ZERO) if segment.get("a_local", Vector2.ZERO) is Vector2 else Vector2.ZERO
			var b: Vector2 = segment.get("b_local", a) if segment.get("b_local", a) is Vector2 else a
			max_span = maxf(max_span, a.distance_to(b))
	var estimated_speed := allocation / maxf(1.0, total_mass) if count > 0 else 0.0
	var estimated_duration := max_span / maxf(0.001, estimated_speed) if estimated_speed > 0.0 and max_span > 0.0 else 0.0
	return {"allocation": allocation, "demand": allocation, "output": output, "heat_load": heat_load, "count": count, "estimated_speed": estimated_speed, "estimated_duration": estimated_duration, "invalid_count": invalid_count, "invalid_note": "; ".join(invalid_notes)}


func _apply_engine_momentum_budget(stats: Dictionary, role_key: String) -> void:
	var bound := _bound_joint_budget_for_stats(stats)
	var thruster_allocation := maxf(0.0, float(stats.get("thruster_drive_demand", 0.0)))
	if thruster_allocation <= 0.0:
		thruster_allocation = maxf(0.0, float(stats.get("thruster_allocated_momentum", 0.0)))
	var thruster_boost_brake_allocation := maxf(0.0, float(stats.get("thruster_boost_extra_demand", stats.get("thruster_boost_brake_allocated_momentum", 0.0))))
	var limb_allocation := maxf(0.0, float(bound.get("allocation", bound.get("demand", 0.0))))
	if limb_allocation <= 0.0:
		limb_allocation = maxf(0.0, float(stats.get("joint_drive_allocation_total", 0.0)))
	var required := thruster_allocation + thruster_boost_brake_allocation + limb_allocation
	var engine_budget := maxf(0.0, float(stats.get("drive_output_total", stats.get("engine_momentum_output", stats.get("engine_momentum_budget", 0.0)))))
	var ratio := engine_budget / maxf(1.0, required)
	var chain_ratio := clampf(ratio, 0.0, 1.0)
	var boost_extra_demand := thruster_boost_brake_allocation
	var boost_peak_demand := maxf(0.0, float(stats.get("thruster_boost_peak_demand", thruster_allocation + boost_extra_demand)))
	var limb_heat_load := maxf(0.0, float(bound.get("heat_load", 0.0)))
	if int(bound.get("count", 0)) <= 0 and limb_heat_load <= 0.0:
		limb_heat_load = maxf(0.0, float(stats.get("bound_limb_idle_heat", 0.0)))
	if boost_peak_demand <= 0.0:
		boost_peak_demand = thruster_allocation + boost_extra_demand
	var boost_chain_ratio := chain_ratio
	stats["engine_momentum_output"] = engine_budget
	stats["engine_momentum_budget"] = engine_budget
	stats["thruster_drive_demand"] = thruster_allocation
	stats["thruster_allocated_momentum"] = thruster_allocation
	stats["thruster_boost_extra_demand"] = boost_extra_demand
	stats["thruster_boost_brake_allocated_momentum"] = boost_extra_demand
	stats["thruster_boost_peak_demand"] = boost_peak_demand
	stats["engine_drive_chain_ratio"] = chain_ratio
	stats["engine_boost_chain_ratio"] = boost_chain_ratio
	stats["thruster_effective_drive_demand"] = thruster_allocation * chain_ratio
	stats["thruster_effective_boost_peak_demand"] = boost_peak_demand * boost_chain_ratio
	stats["bound_limb_allocated_momentum"] = limb_allocation
	stats["bound_joint_count"] = int(bound.get("count", 0))
	stats["bound_joint_output_momentum"] = maxf(0.0, float(bound.get("output", 0.0)))
	stats["estimated_joint_motion_speed"] = maxf(0.0, float(bound.get("estimated_speed", 0.0)))
	stats["estimated_module_duration"] = maxf(0.0, float(bound.get("estimated_duration", 0.0)))
	stats["engine_momentum_required"] = required
	stats["engine_momentum_margin"] = engine_budget - required
	stats["engine_momentum_ratio"] = ratio
	stats["bound_limb_idle_heat"] = limb_heat_load
	stats["drive_output_total"] = engine_budget
	stats["drive_demand_total"] = required
	stats["joint_drive_allocation_total"] = limb_allocation
	if role_key == "barrier":
		stats["engine_momentum_note"] = "BARRIER STATIC: no drive budget required."
	elif int(bound.get("invalid_count", 0)) > 0:
		stats["engine_momentum_note"] = "INVALID: bound limb drive demand outside limb range (%s)." % String(bound.get("invalid_note", "range error"))
	elif required <= 0.0:
		stats["engine_momentum_note"] = "BUDGET OK: no thruster or bound limb drive demand."
	elif engine_budget <= 0.0:
		stats["engine_momentum_note"] = "INVALID: no engine output for thrusters or bound limbs."
	elif engine_budget < required:
		stats["engine_momentum_note"] = "INVALID: engine output %.0f < thruster drive %.0f + boost/brake %.0f + bound limbs %.0f." % [engine_budget, thruster_allocation, boost_extra_demand, limb_allocation]
	else:
		stats["engine_momentum_note"] = "BUDGET OK: engine output %.0f covers thruster drive %.0f + boost/brake %.0f + bound limbs %.0f%s." % [engine_budget, thruster_allocation, boost_extra_demand, limb_allocation, " with reserve" if ratio >= 1.18 else ""]
	if drive_system_service != null:
		drive_system_service.apply_drive_contract(stats, role_key)


func _apply_drive_budget(stats: Dictionary, role_key: String) -> void:
	_apply_engine_momentum_budget(stats, role_key)


func _topology_chain_rotation_radius_units(entries: Array) -> float:
	if entries.is_empty():
		return 0.0
	var radius := 0.0
	for i in range(entries.size()):
		if not (entries[i] is Dictionary):
			continue
		var entry: Dictionary = entries[i]
		var kind := String(entry.get("part_kind", ""))
		if kind in ["limb_muscle", "terminal"]:
			radius += maxf(0.0, float(entry.get("length", 0.0)))
	return radius


func _topology_joint_max_rotation_radius_units(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, joint_index: int) -> float:
	if joint_index < 0 or joint_index >= nodes.size():
		return 0.0
	var node: Dictionary = nodes[joint_index]
	if not _topology_node_is_component(node) or _topology_node_slot(node) == "joint":
		return 0.0
	var max_radius := 0.0
	var entries := _topology_downstream_chain_entries(role_key, unit_bp, joint_index, joint_index)
	max_radius = maxf(max_radius, _topology_chain_rotation_radius_units(entries))
	return max_radius


func _apply_stiffness_segment_summary(stats: Dictionary) -> void:
	var torso_units: Array = stats.get("torso_stiffness_segments", [])
	var torso_threshold := float(stats.get("torso_break_threshold", 0.0))
	if torso_threshold <= 0.0:
		var torso_family := String(stats.get("torso_material_family", "metal"))
		torso_threshold = _stiffness_segment_threshold_from_material(torso_family, float(stats.get("torso_defense_coefficient", CONTACT_DEFENSE_TORSO_COEFF)))
	stats["torso_break_threshold"] = clampf(torso_threshold, CONTACT_UNIT_THRESHOLD_MIN, CONTACT_UNIT_THRESHOLD_MAX)
	if float(stats.get("torso_stiffness_segment_hp", 0.0)) <= 0.0:
		stats["torso_stiffness_segment_hp"] = maxf(CONTACT_UNIT_HP_MIN, float(stats.get("health", 30)) * 0.32)
	var invalid_units: Array = []
	if bool(stats.get("torso_material_mixed", false)) and torso_units.size() <= 1:
		invalid_units.append("TORSO")
	stats["stiffness_segment_valid"] = true
	stats["stiffness_note"] = ""
	stats["stiffness_note"] = "刚度模型 %.0f 基准 / runtime %d 段" % [PART_STIFFNESS_BASE_MOMENTUM, Array(stats.get("runtime_topology_segments", [])).size()] if _ui_is_zh() else "STIFFNESS %.0f BASE / %d runtime segments" % [PART_STIFFNESS_BASE_MOMENTUM, Array(stats.get("runtime_topology_segments", [])).size()]

func _team_summary(player_id: int) -> Dictionary:
	var total_cost := 0
	var total_units := 0
	var lines: Array = []
	var long_45 := 0
	var long_35 := 0
	var long_25 := 0
	var invalid_length := false
	if not blueprints.has(player_id):
		blueprints[player_id] = _blank_player_roster()
	for role_key in ROLE_ORDER:
		var roster: Array = Array(blueprints[player_id].get(role_key, []))
		if roster.is_empty():
			invalid_length = true
		total_units += roster.size()
		for i in range(roster.size()):
			var stats := _compute_unit_stats(player_id, role_key, i)
			var unit_bp: Dictionary = _blueprint_for(player_id, role_key, i)
			var unit_length: float = float(stats["length"])
			total_cost += int(stats["cost"])
			if _role_uses_body_board(role_key) and not _module_material_rule_valid(unit_bp):
				invalid_length = true
			var topology_note := _topology_rule_note(unit_bp, role_key, stats)
			if topology_note.begins_with("INVALID"):
				invalid_length = true
			var slot_payload_blocks: bool = role_key != "barrier" and String(stats.get("slot_payload_note", "")).begins_with("INVALID")
			var momentum_blocks: bool = String(stats.get("joint_momentum_note", "")).begins_with("INVALID")
			var sweep_blocks: bool = String(stats.get("joint_slot_note", "")).begins_with("INVALID") or String(stats.get("swept_collision_note", "")).begins_with("INVALID")
			var power_blocks: bool = role_key != "barrier" and String(stats.get("drive_note", "")).begins_with("INVALID")
			var thermal_blocks: bool = role_key != "barrier" and String(stats.get("thermal_note", "")).begins_with("INVALID")
			if slot_payload_blocks or momentum_blocks or sweep_blocks or power_blocks or thermal_blocks or String(stats.get("stiffness_note", "")).begins_with("INVALID"):
				invalid_length = true
			if unit_length > 4.5:
				invalid_length = true
			elif role_key == "barrier":
				pass
			elif unit_length > 3.5:
				long_45 += 1
			elif unit_length > 2.5:
				long_35 += 1
			elif unit_length > 2.0:
				long_25 += 1
			lines.append("%s:%s cost %d / deploy %d / len %.2f / rad %.2f / SEC %.2f / %s" % [_role_name(role_key), stats["name"], int(stats["cost"]), int(stats["deploy_cost"]), unit_length, float(stats.get("radius", 0.2)), float(stats.get("data_security", 1.0)), _manufacturer_rule_note(stats)])
	var sortie_order := _team_sortie_order(player_id)
	var starter_entry := _starter_sortie_entry(player_id)
	var initial_deploy_cost := 0
	var initial_valid := false
	if _valid_roster_entry(player_id, starter_entry):
		var initial_key := String(starter_entry.get("role", initial_role.get(player_id, "hero")))
		var initial_stats := _compute_unit_stats(player_id, initial_key, int(starter_entry.get("index", 0)))
		initial_deploy_cost = int(initial_stats.get("deploy_cost", initial_stats.get("cost", 9999)))
		initial_valid = initial_deploy_cost <= INITIAL_ENTRY_COST_CAP
	var length_valid := not invalid_length and long_45 <= 1 and long_35 <= 2 and long_25 <= 3
	var budget_valid := total_cost <= START_BUDGET
	var roster_cap := _current_roster_cap()
	var sortie_cap := _current_sortie_cap()
	var roster_valid := total_units == roster_cap
	var sortie_valid := sortie_order.size() == sortie_cap and _sortie_has_required_roles(sortie_order)
	var sortie_counts := _sortie_role_counts(sortie_order)
	return {
		"cost": total_cost,
		"units": total_units,
		"sortie_count": sortie_order.size(),
		"length": 0.0,
		"length_valid": length_valid,
		"initial_valid": initial_valid,
		"budget_valid": budget_valid,
		"roster_valid": roster_valid,
		"sortie_valid": sortie_valid,
		"valid": roster_valid and length_valid and budget_valid,
		"lines": lines,
		"length_note": "%s   UNITS %d/%d   SORTIE %d/%d H/P/B %d/%d/%d   MECH >3.5:%d/1 >2.5:%d/2 >2.0:%d/3   INIT D%d/%d   BUDGET %s" % [_match_format_name(), total_units, roster_cap, sortie_order.size(), sortie_cap, int(sortie_counts.get("hero", 0)), int(sortie_counts.get("puppet", 0)), int(sortie_counts.get("barrier", 0)), long_45, long_35, long_25, initial_deploy_cost, INITIAL_ENTRY_COST_CAP, "OK" if budget_valid else "WARN"],
	}


func _module_material_rule_valid(unit_bp: Dictionary) -> bool:
	return not _module_material_rule_note(unit_bp).begins_with("INVALID")


func _format_unit_stats(stats: Dictionary) -> String:
	if _ui_is_zh():
		return _format_unit_stats_zh(stats)
	var resist: Dictionary = stats["resistances"]
	var tiers: Dictionary = stats.get("counter_tiers", {})
	var heat_line := "HERO HEAT POOL %.0f  %s" % [float(stats.get("heat_capacity", 0.0)), String(stats.get("soul_heat_note", ""))] if String(stats.get("role", "")) == "hero" else "NO HEAT SLOT: puppets and barriers do not track heat"
