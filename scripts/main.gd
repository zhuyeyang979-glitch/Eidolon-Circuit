func _apply_local_hitstop(attacker, target, duration: float) -> void:
	if duration <= 0.0:
		return
	for unit in [attacker, target]:
		if unit != null and is_instance_valid(unit):
			unit.set_meta("local_hitstop_timer", maxf(float(unit.get_meta("local_hitstop_timer", 0.0)), duration))


func _unit_local_hitstop_delta(unit, delta: float) -> float:
	if unit == null or not is_instance_valid(unit):
		return delta
	var remaining := maxf(0.0, float(unit.get_meta("local_hitstop_timer", 0.0)))
	if remaining <= 0.0:
		return delta
	unit.set_meta("local_hitstop_timer", maxf(0.0, remaining - delta))
	unit.velocity *= 0.18
	return 0.0


func _apply_hitstop(damage_type: String, counter_tier: int, damage: int) -> void:
	var type_bonus := 0.0
	match damage_type:
		"blunt":
			type_bonus = 0.035
		"tear":
			type_bonus = 0.02
		"pierce":
			type_bonus = 0.012
		"chemical":
			type_bonus = 0.006
		"laser":
			type_bonus = 0.004
		"bullet":
			type_bonus = 0.008
	var stop := clampf(0.018 + float(counter_tier) * 0.012 + float(damage) / 520.0 + type_bonus, 0.018, 0.13)
	hitstop_timer = maxf(hitstop_timer, stop)


func _apply_projectile_reflection(attacker, event: Dictionary) -> void:
	if not event.has("direction"):
		return
	var damage_type := String(event.get("damage_type", "bullet"))
	var owner := int(attacker.owner_id)
	var best = null
	var best_score := 999.0
	for reflector in _friendly_units(owner):
		if reflector == attacker or not _is_live_unit(reflector) or not bool(reflector.stats.get("reflect_projectiles", false)):
			continue
		var reflect_types: Array = reflector.stats.get("reflect_types", [])
		if not reflect_types.is_empty() and not reflect_types.has(damage_type):
			continue
		var delta_vec := _mobius_delta_vec_between(attacker, reflector, 1.25)
		var distance := delta_vec.length()
		if distance <= 0.01 or distance > float(event.get("range", 1.0)) + float(reflector.stats.get("radius", 0.2)):
			continue
		var direction: Vector2 = event["direction"]
		var angle_score := 1.0 - direction.normalized().dot(delta_vec.normalized())
		var lane_score := absf(reflector.lane - attacker.lane) * 0.35
		var score := angle_score + lane_score + distance * 0.08
		if score < best_score:
			best_score = score
			best = reflector
	if best == null:
		return
	var direction: Vector2 = event["direction"]
	var normal := Vector2(0.0, -1.0 if best.lane < attacker.lane else 1.0)
	if absf(best.lane - attacker.lane) < 0.08:
		normal = Vector2(-float(attacker.facing), 0.0)
	var reflected := direction.bounce(normal).normalized()
	if reflected.length() <= 0.01:
		reflected = Vector2(float(attacker.facing), randf_range(-0.45, 0.45)).normalized()
	event["direction"] = reflected
	var existing_momentum := _event_momentum_magnitude(event, float(event.get("momentum", 0.0)))
	if existing_momentum > 0.0:
		_set_event_momentum_vector(event, reflected * existing_momentum, existing_momentum)
	event["range"] = float(event.get("range", 1.0)) + float(best.stats.get("reflect_bonus_range", 0.35))
	event["lane_range"] = float(event.get("lane_range", 0.2)) + float(best.stats.get("reflect_power", 0.25)) * 0.18
	event["reflections"] = int(event.get("reflections", 0)) + 1
	_update_field_aura_visual(best, "repulsion", maxf(0.24, float(best.stats.get("radius", 0.16)) * 2.4), 1.5, 0.0)
	_spawn_hit_effect(best, 1, damage_type, false, String(event.get("projectile_style", "beam")))
	_show_battle_message("%s RICOCHET %s" % [best.unit_name, damage_type.to_upper()], 0.45)


func _target_projectile_shield_reflects(target, event: Dictionary) -> bool:
	if not _is_live_unit(target):
		return false
	if float(target.get_meta("projectile_shield_timer", 0.0)) <= 0.0:
		return false
	var damage_type := String(event.get("damage_type", "bullet"))
	var reflect_types: Array = target.get_meta("projectile_shield_types", target.stats.get("reflect_types", []))
	return reflect_types.is_empty() or reflect_types.has(damage_type)


func _reflect_projectile_from_target_shield(target, attacker, event: Dictionary) -> void:
	if not _is_live_unit(target):
		return
	var damage_type := String(event.get("damage_type", "bullet"))
	var power := maxf(0.1, float(target.get_meta("projectile_shield_power", target.stats.get("reflect_power", 0.55))))
	var event_copy := event.duplicate(true)
	event_copy["owner_id"] = int(target.owner_id)
	event_copy["source_name"] = "%s shield" % target.unit_name
	event_copy["range"] = float(event.get("range", 1.0)) + float(target.get_meta("projectile_shield_bonus_range", target.stats.get("reflect_bonus_range", 0.4)))
	event_copy["lane_range"] = float(event.get("lane_range", 0.2)) + power * 0.16
	event_copy["damage"] = maxi(1, int(roundf(float(event.get("damage", 1)) * (0.58 + power * 0.34))))
	var reflected_dir := Vector2(float(target.facing), randf_range(-0.38, 0.38)).normalized()
	if attacker != null and is_instance_valid(attacker):
		var delta_vec := _mobius_delta_vec_between(target, attacker, 1.25)
		if delta_vec.length() > 0.01:
			reflected_dir = delta_vec.normalized()
	event_copy["direction"] = reflected_dir
	var reflected_momentum := _projectile_momentum_for_event(event_copy)
	if reflected_momentum > 0.0:
		_set_event_momentum_vector(event_copy, reflected_dir * reflected_momentum, reflected_momentum)
	_spawn_hit_effect(target, 2, damage_type, false, String(event.get("projectile_style", "shield")))
	_update_field_aura_visual(target, "repulsion", maxf(0.28, float(target.stats.get("radius", 0.2)) * 2.4), 2.0, 0.0)
	_show_battle_message("%s AEGIS REFLECT %s" % [target.unit_name, damage_type.to_upper()], 0.55)
	for reflected_target in _enemy_units(int(target.owner_id)):
		if reflected_target == attacker or reflected_target == target or not _is_live_unit(reflected_target):
			continue
		var reflected_delta := _mobius_delta_vec_between(target, reflected_target, 1.25)
		var distance := absf(reflected_delta.x)
		var lane_distance := absf(reflected_delta.y)
		var target_radius := float(reflected_target.stats.get("radius", 0.2))
		if distance > float(event_copy["range"]) + target_radius or lane_distance > float(event_copy["lane_range"]) + target_radius * 0.6:
			continue
		var target_vector := reflected_delta
		if target_vector.length() > 0.01 and reflected_dir.dot(target_vector.normalized()) < 0.24:
			continue
		var final_damage := maxi(1, int(roundf(float(event_copy["damage"]) * _vulnerability_multiplier(reflected_target, event_copy))))
		final_damage = _projectile_material_adjusted_damage(reflected_target, event_copy, final_damage)
		var blocked := final_damage <= 0 or bool(event_copy.get("contact_gate_blocked", false))
		_spawn_hit_effect(reflected_target, _counter_tier_for_hit(reflected_target, damage_type), damage_type, blocked, String(event_copy.get("projectile_style", "shield")))
		if blocked:
			break
		_apply_hitstop(damage_type, 1, final_damage)
		if reflected_target.take_hit(final_damage, "armor", int(target.owner_id), damage_type, "projectile"):
			_handle_unit_killed(reflected_target, int(target.owner_id))
		break


func _apply_explosion_damage(attacker, primary_target, event: Dictionary) -> Array:
	var killed_units: Array = []
	if attacker == null or not is_instance_valid(attacker):
		return killed_units
	var owner := int(attacker.owner_id)
	var radius := maxf(0.08, float(event.get("explosion_radius", 0.0)))
	var damage := int(event.get("explosion_damage", 0))
	if damage <= 0:
		return killed_units
	var damage_type := String(event.get("explosion_damage_type", event.get("damage_type", "blunt")))
	var center_ring: float = attacker.ring_pos
	var center_lane: float = attacker.lane
	if primary_target != null and is_instance_valid(primary_target):
		center_ring = primary_target.ring_pos
		center_lane = primary_target.lane
	_spawn_hit_effect(primary_target if primary_target != null and is_instance_valid(primary_target) else attacker, 2, damage_type, false, String(event.get("explosion_style", "blast")))
	for target in _enemy_units(owner):
		if not _is_live_unit(target) or target == primary_target:
			continue
		var blast_delta := _mobius_delta_points(center_ring, center_lane, target.ring_pos, target.lane)
		var distance := absf(blast_delta.x)
		var lane_distance := absf(blast_delta.y)
		var target_radius := float(target.stats.get("radius", 0.2))
		if distance > radius + target_radius or lane_distance > radius * 0.72 + target_radius * 0.6:
			continue
		var falloff := clampf(1.0 - (distance + lane_distance * 0.7) / maxf(0.1, radius * 1.6), 0.35, 1.0)
		var event_copy := event.duplicate(true)
		event_copy["damage_type"] = damage_type
		event_copy["projectile"] = false
		var blast_direction := blast_delta
		if blast_direction.length() <= 0.001:
			blast_direction = _event_direction_vector(attacker, target, event, Vector2.RIGHT)
		var blast_momentum := _projectile_momentum_for_event(event) * falloff
		_set_event_momentum_vector(event_copy, blast_direction.normalized() * blast_momentum, blast_momentum)
		event_copy["hit_position_combat"] = Vector2(target.ring_pos, target.lane)
		var final_damage := maxi(1, int(roundf(float(damage) * falloff * _vulnerability_multiplier(target, event_copy))))
		final_damage = _projectile_material_adjusted_damage(target, event_copy, final_damage)
		var blocked := final_damage <= 0 or bool(event_copy.get("contact_gate_blocked", false))
		if not blocked:
			final_damage = _apply_combo_hit_scaling(attacker, target, event_copy, final_damage)
			if final_damage < 0:
				continue
		_spawn_hit_effect(target, _counter_tier_for_hit(target, damage_type), damage_type, blocked, String(event.get("explosion_style", "blast")))
		var stagger_event := event.duplicate(true)
		stagger_event["projectile"] = true
		stagger_event["projectile_behavior"] = "explosive"
		stagger_event["projectile_style"] = String(event.get("explosion_style", "explosive"))
		_set_event_momentum_vector(stagger_event, blast_direction.normalized() * blast_momentum, blast_momentum)
		stagger_event["target_part_index"] = int(event_copy.get("target_part_index", -1))
		_apply_projectile_momentum_stagger(attacker, target, stagger_event, falloff)
		if blocked:
			continue
		_apply_hitstop(damage_type, 1, final_damage)
		if target.take_hit(final_damage, String(event.get("state", "normal")), owner, damage_type, "field"):
			killed_units.append(target)
	return killed_units


func _apply_takeover_status(attacker, target, event: Dictionary) -> void:
	if not bool(event.get("takeover_on_hit", false)):
		return
	if not _unit_is_mech_physics_subject(target) or int(attacker.owner_id) == int(target.owner_id):
		return
	var owner := int(attacker.owner_id)
	var base_required := maxf(0.75, float(event.get("takeover_seconds", attacker.stats.get("takeover_seconds", 4.0))))
	var takeover_power := maxf(0.12, float(event.get("takeover_power", attacker.stats.get("takeover_power", 1.0))))
	var required := _security_adjusted_seconds(base_required, target, takeover_power, 0.75)
	var dps := maxf(0.0, float(event.get("takeover_damage_rate", attacker.stats.get("takeover_damage_rate", 4.0))))
	target.set_meta("takeover_owner", owner)
	target.set_meta("takeover_required", required)
	target.set_meta("takeover_dps", dps)
	target.set_meta("takeover_damage_type", String(event.get("takeover_damage_type", attacker.stats.get("takeover_damage_type", "laser"))))
	target.set_meta("takeover_timer", maxf(float(target.get_meta("takeover_timer", 0.0)), 0.12))
	target.set_meta("takeover_warning_timer", 0.55)
	_show_battle_message("NTR LINK %.1fs / SEC %.2f: %s" % [required, _data_security_value(target), target.unit_name], 0.55)


func _chemical_dot_applies(event: Dictionary) -> bool:
	if not _is_chemical_projectile_event(event):
		return false
	return float(event.get("chemical_dot_mult", CHEMICAL_DOT_DEFAULT_MULT)) > 0.0 and float(event.get("chemical_dot_duration", CHEMICAL_DOT_DEFAULT_DURATION)) > 0.0


func _apply_chemical_dot_status(attacker, target, event: Dictionary, total_damage: int) -> void:
	if not _is_live_unit(target) or total_damage <= 0:
		return
	var duration := clampf(float(event.get("chemical_dot_duration", CHEMICAL_DOT_DEFAULT_DURATION)), 0.6, 6.0)
	var dps := float(total_damage) / duration
	var no_stack := bool(event.get("chemical_dot_no_stack", false))
	target.set_meta("chemical_dot_owner", int(attacker.owner_id))
	target.set_meta("chemical_dot_timer", maxf(float(target.get_meta("chemical_dot_timer", 0.0)), duration))
	if no_stack:
		target.set_meta("chemical_dot_dps", maxf(float(target.get_meta("chemical_dot_dps", 0.0)), dps))
	else:
		target.set_meta("chemical_dot_dps", float(target.get_meta("chemical_dot_dps", 0.0)) + dps)
	target.set_meta("chemical_dot_bank", float(target.get_meta("chemical_dot_bank", 0.0)))
	target.set_meta("chemical_dot_fx_timer", 0.05)
	_show_battle_message("%s CORRODING %.1fs" % [target.unit_name, duration], 0.45)


func _update_chemical_dot_status(unit, delta: float) -> void:
	if not unit.has_meta("chemical_dot_timer"):
		return
	var timer := maxf(0.0, float(unit.get_meta("chemical_dot_timer", 0.0)) - delta)
	unit.set_meta("chemical_dot_timer", timer)
	if timer <= 0.0:
		unit.set_meta("chemical_dot_dps", 0.0)
		unit.set_meta("chemical_dot_bank", 0.0)
		return
	var owner := int(unit.get_meta("chemical_dot_owner", int(unit.owner_id)))
	var dps := maxf(0.0, float(unit.get_meta("chemical_dot_dps", 0.0)))
	if dps <= 0.0:
		return
	var bank := float(unit.get_meta("chemical_dot_bank", 0.0)) + dps * delta
	if bank < 1.0:
		unit.set_meta("chemical_dot_bank", bank)
		return
	var damage := int(floorf(bank))
	unit.set_meta("chemical_dot_bank", bank - float(damage))
	var fx_timer := maxf(0.0, float(unit.get_meta("chemical_dot_fx_timer", 0.0)) - delta)
	if fx_timer <= 0.0:
		_spawn_hit_effect(unit, 1, "chemical", false, "spray")
		unit.set_meta("chemical_dot_fx_timer", 0.24)
	else:
		unit.set_meta("chemical_dot_fx_timer", fx_timer)
	if unit.take_hit(damage, "active", owner, "chemical", "projectile"):
		_handle_unit_killed(unit, owner)


func _update_takeover_status(unit, delta: float) -> void:
	if not unit.has_meta("takeover_owner"):
		return
	var owner := int(unit.get_meta("takeover_owner", int(unit.owner_id)))
	if owner == int(unit.owner_id):
		unit.set_meta("takeover_timer", 0.0)
		return
	var required := maxf(0.75, float(unit.get_meta("takeover_required", 4.0)))
	var progress := maxf(0.0, float(unit.get_meta("takeover_timer", 0.0))) + delta
	unit.set_meta("takeover_timer", progress)
	unit.set_meta("takeover_warning_timer", maxf(float(unit.get_meta("takeover_warning_timer", 0.0)), 0.12))
	var dps := float(unit.get_meta("takeover_dps", 0.0))
	if dps > 0.0:
		var bank := float(unit.get_meta("takeover_damage_bank", 0.0)) + dps * delta
		if bank >= 1.0:
			var damage := int(floor(bank))
			unit.set_meta("takeover_damage_bank", bank - float(damage))
			var damage_type := String(unit.get_meta("takeover_damage_type", "laser"))
			var event := {"damage_type": damage_type, "projectile": damage_type in PROJECTILE_DAMAGE_TYPES}
			var final_damage := _projectile_material_adjusted_damage(unit, event, damage)
			var blocked := final_damage <= 0 or bool(event.get("contact_gate_blocked", false))
			_spawn_hit_effect(unit, 1, damage_type, blocked, "hack")
			if not blocked and unit.take_hit(final_damage, "active", owner, damage_type, "field"):
				_handle_unit_killed(unit, owner)
				return
		else:
			unit.set_meta("takeover_damage_bank", bank)
	if progress >= required:
		_defect_unit_to_owner(unit, owner, "NEURAL TAKEOVER", false)


func _update_unit_status_meta(unit, delta: float) -> void:
	for key in ["morph_timer", "trap_cooldown_timer", "hack_warning_timer", "jam_warning_timer", "jammed_timer", "part_fail_flash", "slow_timer", "field_damage_boost_timer", "vuln_timer", "served_ball_timer", "active_cool_lock", "takeover_warning_timer", "lease_warn_timer", "annuity_tick", "projectile_shield_timer", "support_armor_timer", "speed_lane_timer", "shield_flash_timer", "rear_heat_flash_timer"]:
		if unit.has_meta(key):
			unit.set_meta(key, maxf(0.0, float(unit.get_meta(key, 0.0)) - delta))
	if float(unit.get_meta("support_armor_timer", 0.0)) <= 0.0 and float(unit.get_meta("support_armor_hp", 0.0)) > 0.0:
		unit.set_meta("support_armor_hp", 0.0)
	if unit.has_meta("disabled_parts"):
		var disabled: Dictionary = unit.get_meta("disabled_parts", {})
		for part_key in disabled.keys():
			var next_time := maxf(0.0, float(disabled[part_key]) - delta)
			if next_time <= 0.0:
				disabled.erase(part_key)
			else:
				disabled[part_key] = next_time
		unit.set_meta("disabled_parts", disabled)
	if float(unit.get_meta("slow_timer", 0.0)) > 0.0:
		unit.velocity *= clampf(float(unit.get_meta("slow_mult", 0.82)), 0.25, 1.0)
	if float(unit.get_meta("jammed_timer", 0.0)) > 0.0:
		unit.velocity = unit.velocity.move_toward(Vector2.ZERO, 2.4 * delta)
	_update_chemical_dot_status(unit, delta)
	_update_takeover_status(unit, delta)


func _defect_unit_to_owner(unit, new_owner: int, reason: String, full_restore: bool = true) -> bool:
	if unit == null or not is_instance_valid(unit) or not [1, 2].has(new_owner):
		return false
	var old_owner := int(unit.owner_id)
	if old_owner == new_owner and _is_live_unit(unit):
		return false
	_detach_unit_reference(unit)
	unit.owner_id = new_owner
	var role_key := String(unit.role)
	if role_key == "barrier":
		role_key = "puppet"
	if role_key == "hero" and _is_live_unit(active_units[new_owner]["hero"]):
		role_key = "puppet"
	unit.role = role_key
	unit.active = true
	unit.visible = true
	unit.health = unit.max_health if full_restore else maxi(1, int(roundf(float(unit.max_health) * 0.48)))
	unit.heat = 0.0
	unit.overheated = false
	unit.velocity = Vector2.ZERO
	unit.stats["primary_color"] = _team_primary_color(new_owner)
	unit.stats["accent_color"] = _team_accent_color(new_owner)
	unit.primary_color = unit.stats["primary_color"]
	unit.accent_color = unit.stats["accent_color"]
	for meta_key in ["takeover_owner", "takeover_timer", "takeover_required", "takeover_dps", "takeover_damage_bank", "chemical_dot_owner", "chemical_dot_timer", "chemical_dot_dps", "chemical_dot_bank", "chemical_dot_fx_timer", "jammed_timer", "hack_warning_timer", "disabled_parts", "vuln_timer"]:
		if unit.has_meta(meta_key):
			unit.remove_meta(meta_key)
	if not all_units.has(unit):
		all_units.append(unit)
	_assign_unit_role(unit, role_key)
	if unit.has_method("_apply_topology_visuals"):
		unit._apply_topology_visuals()
	if unit.has_method("_refresh_visuals"):
		unit._refresh_visuals()
	_spawn_hit_effect(unit, 2, "laser", false, "hack")
	_show_battle_message("%s: P%d -> P%d %s" % [reason, old_owner, new_owner, unit.unit_name], 1.0)
	return true


func _unit_role_is_mech(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	return String(unit.role) in ["hero", "puppet"]


func _unit_uses_heat(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	return String(unit.role) == "hero"


func _unit_is_mech_physics_subject(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	if bool(unit.get_meta("detached_barrier_piece", false)):
		return true
	if _barrier_has_map_tiles(unit):
		return true
	return _unit_role_is_mech(unit)


func _counter_tier_for_hit(target, damage_type: String) -> int:
	if target == null or not is_instance_valid(target):
		return 0
	if damage_type in PROJECTILE_DAMAGE_TYPES:
		return 0
	var counters: Dictionary = target.stats.get("counter_tiers", {})
	return clampi(int(counters.get(damage_type, 0)), 0, 3)


func _apply_module_hit_effect(attacker, target, event: Dictionary) -> void:
	var module_effect := String(event.get("module_effect", ""))
	var projectile_style := String(event.get("projectile_style", ""))
	var has_web := projectile_style == "web" or float(event.get("web_strength", 0.0)) > 0.0
	var has_blind := projectile_style == "blind" or float(event.get("blind_radius", 0.0)) > 0.0
	if module_effect == "" and not has_web and not has_blind:
		return
	var pull_direction := _event_direction_vector(attacker, target, event, Vector2(float(attacker.facing), 0.0))
	var attacker_mass := maxf(1.0, float(attacker.stats.get("mass", 1.0)))
	var target_mass := maxf(1.0, float(target.stats.get("mass", 1.0)))
	if module_effect in ["capture", "tether", "entangle"]:
		var pull_power := float(event.get("pull_power", 0.16))
		var attacker_pull := clampf(target_mass / (attacker_mass + target_mass), 0.15, 0.85)
		var target_pull := clampf(attacker_mass / (attacker_mass + target_mass), 0.15, 0.85)
		_apply_unit_displacement(attacker, pull_direction, pull_power * attacker_pull)
		_apply_unit_displacement(target, -pull_direction, pull_power * target_pull)
		target.velocity = target.velocity.move_toward(Vector2.ZERO, 2.5 * pull_power)
	elif module_effect == "chain_recall":
		_apply_unit_displacement(attacker, pull_direction, 0.06)
	elif module_effect == "barrier_break" and String(target.role) == "barrier":
		_add_unit_heat(target, 16.0)
	elif module_effect in ["boomerang_recall", "group_throw"]:
		target.velocity += pull_direction * 0.27
		attacker.set_meta("receiver_flash", 0.32)
	elif module_effect == "guided_eject":
		target.velocity += pull_direction * 0.36
	if has_web:
		_apply_web_tether_effect(attacker, target, event, pull_direction, attacker_mass, target_mass)
	if has_blind:
		_spawn_blind_zone(int(attacker.owner_id), target.ring_pos, target.lane, float(event.get("blind_radius", 0.62)), float(event.get("blind_duration", 2.4)), float(event.get("blind_strength", 0.55)))


func _apply_web_tether_effect(attacker, target, event: Dictionary, pull_direction: Vector2, attacker_mass: float, target_mass: float) -> void:
	var strength := maxf(0.01, float(event.get("web_strength", attacker.stats.get("web_strength", 0.18))))
	var break_force := maxf(0.08, float(event.get("web_break_force", attacker.stats.get("web_break_force", 0.56))))
	var distance := absf(_ring_delta(attacker.ring_pos, target.ring_pos))
	var lane_distance := absf(attacker.lane - target.lane)
	var mass_stress := absf(attacker_mass - target_mass) / maxf(1.0, attacker_mass + target_mass)
	var tension := strength * (0.72 + distance * 0.55 + lane_distance * 0.36 + mass_stress * 0.42)
	if tension > break_force:
		_spawn_hit_effect(target, 1, "blunt", false, "web_snap")
		_show_battle_message("WEB LINE SNAP", 0.45)
		return
	var mode := String(event.get("web_pull_mode", attacker.stats.get("web_pull_mode", "target_to_self")))
	var pull_scale := strength * 0.72
	if not _unit_is_mech_physics_subject(target):
		_apply_unit_displacement(attacker, pull_direction, pull_scale)
		attacker.velocity += pull_direction * strength * 0.66
		_show_battle_message("WEB ANCHOR: barrier topology holds", 0.5)
	elif mode == "self_to_anchor" or (mode == "" and String(target.role) == "barrier"):
		_apply_unit_displacement(attacker, pull_direction, pull_scale)
		attacker.velocity += pull_direction * strength * 0.66
	elif mode == "mass_duel":
		var attacker_pull := clampf(target_mass / (attacker_mass + target_mass), 0.1, 0.9)
		var target_pull := clampf(attacker_mass / (attacker_mass + target_mass), 0.1, 0.9)
		_apply_unit_displacement(attacker, pull_direction, pull_scale * attacker_pull)
		_apply_unit_displacement(target, -pull_direction, pull_scale * target_pull)
	else:
		_apply_unit_displacement(target, -pull_direction, pull_scale)
		target.velocity = target.velocity.move_toward(Vector2.ZERO, 3.0 * strength)


func _web_targets_for(attacker, event: Dictionary) -> Array:
	if not _is_live_unit(attacker):
		return []
	var filter := String(event.get("web_target_filter", "all")).to_lower()
	var candidates := _field_targets_for(int(attacker.owner_id), filter)
	var result: Array = []
	for target in candidates:
		if not _is_live_unit(target) or target == attacker:
			continue
		result.append(target)
	return result


func _first_web_tether_impact(attacker, event: Dictionary) -> Dictionary:
	if not _is_live_unit(attacker):
		return {}
	var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(attacker)
	direction = direction.normalized()
	var best: Dictionary = {}
	var best_distance := 999999.0
	for target in _web_targets_for(attacker, event):
		var hit := _attack_part_hit(attacker, target, event)
		if hit.is_empty():
			continue
		var hit_position: Vector2 = hit.get("position", Vector2(target.ring_pos, target.lane))
		var projection := _projectile_projection_from(attacker, hit_position, direction)
		if projection < -0.001:
			continue
		if projection < best_distance:
			best_distance = projection
			best = {
				"target": target,
				"hit": hit,
				"position": hit_position,
				"distance": best_distance,
			}
	return best


func _web_boundary_anchor_for_event(attacker, event: Dictionary) -> Dictionary:
	if not _is_live_unit(attacker) or not bool(event.get("web_anchor_swing", true)):
		return {}
	var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	if direction.length() <= 0.01:
		return {}
	direction = direction.normalized()
	if absf(direction.y) <= 0.01:
		return {}
	var start := Vector2(attacker.ring_pos, attacker.lane)
	var boundary_y := BATTLE_HALF_HEIGHT if direction.y > 0.0 else -BATTLE_HALF_HEIGHT
	var t := (boundary_y - start.y) / direction.y
	if t <= 0.0:
		return {}
	var max_range := maxf(0.1, float(event.get("range", event.get("projectile_range", STANDARD_WEB_TETHER_RANGE_M))))
	if t > max_range:
		return {}
	var anchor := Vector2(wrapf(start.x + direction.x * t, 0.0, RING_LENGTH), boundary_y)
	return {"position": anchor, "distance": t, "boundary": "top" if boundary_y > 0.0 else "bottom"}


func _web_trace_event(base_event: Dictionary, impact_position: Vector2) -> Dictionary:
	var event := base_event.duplicate(true)
	event["projectile_impact_position"] = impact_position
	event["projectile_style"] = "web"
	event["projectile_behavior"] = "web_tether"
	event["travel_path"] = "tether"
	event["damage_type"] = "blunt"
	event["non_damage"] = true
	event["projectile_trace_spawned"] = true
	return event


func _start_web_tether(attacker, target, event: Dictionary, hit_position: Vector2) -> void:
	if not _is_live_unit(attacker) or not _is_live_unit(target):
		return
	active_web_tethers.append({
		"attacker": attacker,
		"target": target,
		"timer": maxf(0.1, float(event.get("web_duration", STANDARD_WEB_TETHER_DURATION))),
		"strength": maxf(0.01, float(event.get("web_strength", STANDARD_WEB_TETHER_STRENGTH))),
		"break_force": maxf(0.08, float(event.get("web_break_force", STANDARD_WEB_TETHER_BREAK_FORCE))),
		"mode": String(event.get("web_pull_mode", "mass_duel")),
	})
	_spawn_projectile_trace(attacker, _web_trace_event(event, hit_position))
	_spawn_hit_effect(target, 1, "blunt", false, "web_snap", hit_position)
	_show_battle_message("WEB TETHER" if not _ui_is_zh() else "蛛丝牵引", 0.45)


func _start_web_boundary_swing(attacker, event: Dictionary, anchor: Vector2) -> void:
	if not _is_live_unit(attacker):
		return
	active_web_swings.append({
		"attacker": attacker,
		"anchor": anchor,
		"timer": maxf(0.1, float(event.get("web_duration", STANDARD_WEB_TETHER_DURATION))),
		"strength": maxf(0.01, float(event.get("web_strength", STANDARD_WEB_TETHER_STRENGTH))),
		"break_force": maxf(0.08, float(event.get("web_break_force", STANDARD_WEB_TETHER_BREAK_FORCE))),
		"uses_melee_collision": bool(event.get("web_swing_uses_melee_collision", true)),
	})
	_spawn_projectile_trace(attacker, _web_trace_event(event, anchor))
	_show_battle_message("WEB SWING" if not _ui_is_zh() else "蛛丝摆荡", 0.45)


func _fire_runtime_web_tether(attacker, event: Dictionary) -> bool:
	if not _is_live_unit(attacker):
		return false
	event["projectile"] = true
	event["projectile_only"] = true
	event["projectile_behavior"] = "web_tether"
	event["projectile_style"] = "web"
	event["travel_path"] = "tether"
	event["projectile_damage_type"] = "blunt"
	event["damage_type"] = "blunt"
	event["non_damage"] = true
	if not bool(event.get("ammo_consumed", false)) and not _consume_ammo_for_event(attacker, event):
		return false
	event["ammo_consumed"] = true
	var hit := _first_web_tether_impact(attacker, event)
	if not hit.is_empty():
		var target = hit.get("target", null)
		if _is_live_unit(target):
			_start_web_tether(attacker, target, event, hit.get("position", Vector2(target.ring_pos, target.lane)))
			return true
	var anchor := _web_boundary_anchor_for_event(attacker, event)
	if not anchor.is_empty():
		_start_web_boundary_swing(attacker, event, anchor.get("position", Vector2(attacker.ring_pos, attacker.lane)))
		return true
	var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(attacker)
	var miss_position := Vector2(wrapf(attacker.ring_pos + direction.normalized().x * float(event.get("range", STANDARD_WEB_TETHER_RANGE_M)), 0.0, RING_LENGTH), clampf(attacker.lane + direction.normalized().y * float(event.get("range", STANDARD_WEB_TETHER_RANGE_M)), -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT))
	_spawn_projectile_trace(attacker, _web_trace_event(event, miss_position))
	_show_battle_message("WEB MISS" if not _ui_is_zh() else "蛛丝落空", 0.35)
	return true


func _update_web_tethers(delta: float) -> void:
	for index in range(active_web_tethers.size() - 1, -1, -1):
		var tether: Dictionary = active_web_tethers[index]
		var attacker = tether.get("attacker", null)
		var target = tether.get("target", null)
		if not _is_live_unit(attacker) or not _is_live_unit(target):
			active_web_tethers.remove_at(index)
			continue
		var timer := float(tether.get("timer", 0.0)) - delta
		if timer <= 0.0:
			active_web_tethers.remove_at(index)
			continue
		var delta_vec := Vector2(_ring_delta(attacker.ring_pos, target.ring_pos), target.lane - attacker.lane)
		if delta_vec.length() <= 0.01:
			tether["timer"] = timer
			active_web_tethers[index] = tether
			continue
		var strength := maxf(0.01, float(tether.get("strength", STANDARD_WEB_TETHER_STRENGTH)))
		var break_force := maxf(0.08, float(tether.get("break_force", STANDARD_WEB_TETHER_BREAK_FORCE)))
		var attacker_mass := maxf(1.0, float(attacker.stats.get("mass", 1.0)))
		var target_mass := maxf(1.0, float(target.stats.get("mass", 1.0)))
		var tension := strength * (0.72 + delta_vec.length() * 0.55 + absf(attacker_mass - target_mass) / maxf(1.0, attacker_mass + target_mass) * 0.42)
		if tension > break_force:
			_spawn_hit_effect(target, 1, "blunt", false, "web_snap", Vector2(target.ring_pos, target.lane))
			active_web_tethers.remove_at(index)
			continue
		var direction := delta_vec.normalized()
		var mode := String(tether.get("mode", "mass_duel"))
		var accel := strength * STANDARD_WEB_TETHER_ACCEL_MULT
		if mode == "self_to_anchor":
			attacker.velocity += direction * accel * delta
		elif mode == "target_to_self":
			target.velocity -= direction * accel * delta
		else:
			var attacker_share := clampf(target_mass / (attacker_mass + target_mass), 0.1, 0.9)
			var target_share := clampf(attacker_mass / (attacker_mass + target_mass), 0.1, 0.9)
			attacker.velocity += direction * accel * attacker_share * delta
			target.velocity -= direction * accel * target_share * delta
		tether["timer"] = timer
		active_web_tethers[index] = tether


func _update_web_swings(delta: float) -> void:
	for index in range(active_web_swings.size() - 1, -1, -1):
		var swing: Dictionary = active_web_swings[index]
		var attacker = swing.get("attacker", null)
		if not _is_live_unit(attacker):
			active_web_swings.remove_at(index)
			continue
		var timer := float(swing.get("timer", 0.0)) - delta
		if timer <= 0.0:
			active_web_swings.remove_at(index)
			continue
		var anchor: Vector2 = swing.get("anchor", Vector2(attacker.ring_pos, attacker.lane))
		var to_anchor := Vector2(_ring_delta(attacker.ring_pos, anchor.x), anchor.y - attacker.lane)
		if to_anchor.length() <= 0.03:
			active_web_swings.remove_at(index)
			continue
		var strength := maxf(0.01, float(swing.get("strength", STANDARD_WEB_TETHER_STRENGTH)))
		var break_force := maxf(0.08, float(swing.get("break_force", STANDARD_WEB_TETHER_BREAK_FORCE)))
		var tension: float = strength * (0.72 + to_anchor.length() * 0.62 + attacker.velocity.length() * 0.1)
		if tension > break_force:
			_spawn_hit_effect(attacker, 1, "blunt", false, "web_snap", Vector2(attacker.ring_pos, attacker.lane))
			active_web_swings.remove_at(index)
			continue
		var radial: Vector2 = to_anchor.normalized()
		var tangent := Vector2(-radial.y, radial.x)
		if tangent.dot(_unit_forward_vector(attacker)) < 0.0:
			tangent = -tangent
		var accel: float = strength * STANDARD_WEB_SWING_ACCEL_MULT
		attacker.velocity += (radial * accel + tangent * accel * 0.42) * delta
		swing["timer"] = timer
		active_web_swings[index] = swing


func _spawn_projectile_trace(attacker, event: Dictionary) -> void:
	if effects_root == null or attacker == null or not is_instance_valid(attacker):
		return
	if not _consume_battle_vfx_budget("projectile_trace"):
		return
	var segment := _projected_projectile_screen_segment(attacker, event, 92.0)
	if segment.is_empty():
		return
	var trace := ProjectileTraceEffect.new()
	trace.setup(
		segment.get("start", attacker.position),
		segment.get("end", attacker.position),
		String(event.get("damage_type", "bullet")),
		String(event.get("projectile_style", _projectile_style_for_damage(String(event.get("damage_type", "bullet"))))),
		String(event.get("travel_path", "straight")),
		combat_vfx_texture,
		float(event.get("projectile_speed_mult", BULLET_HELL_DEFAULT_SPEED_MULT))
	)
	effects_root.add_child(trace)
	_play_projectile_launch_sfx(event)


func _spawn_hit_effect(target, counter_tier: int, damage_type: String, nullified: bool, projectile_style: String = "", hit_position_combat: Vector2 = Vector2(1.0e20, 1.0e20)) -> void:
	if effects_root == null or target == null or not is_instance_valid(target) or not target.visible:
		return
	if counter_tier <= 0 and not nullified and projectile_style == "":
		return
	if not bool(_runtime_quality_value("hit_vfx", true)):
		return
	if not _consume_battle_vfx_budget("hit_effect"):
		return
	var effect := HitEffect.new()
	if _is_valid_combat_position(hit_position_combat):
		var screen := _project_combat_coord_to_screen(hit_position_combat)
		effect.position = screen["position"]
		effect.visible = bool(screen["visible"])
	else:
		effect.position = target.position
	effect.setup(counter_tier, damage_type, nullified, projectile_style, combat_vfx_texture, _hit_effect_nullified_label(projectile_style))
	effects_root.add_child(effect)
	_play_hit_sfx(damage_type, projectile_style, nullified, counter_tier)


func _spawn_projectile_hit_vfx_on_target(hit_record: Dictionary) -> void:
	var target = hit_record.get("target", null)
	if target == null or not is_instance_valid(target):
		return
	var contact_point := _unit_combat_coord(target)
	if hit_record.get("contact_point", Vector2(1.0e20, 1.0e20)) is Vector2:
		contact_point = hit_record.get("contact_point", contact_point)
	elif hit_record.get("position", Vector2(1.0e20, 1.0e20)) is Vector2:
		contact_point = hit_record.get("position", contact_point)
	_spawn_hit_effect(
		target,
		int(hit_record.get("counter_tier", _counter_tier_for_hit(target, String(hit_record.get("damage_type", "bullet"))))),
		String(hit_record.get("damage_type", "bullet")),
		bool(hit_record.get("nullified", false)),
		String(hit_record.get("projectile_style", "")),
		contact_point
	)


func _hit_effect_nullified_label(projectile_style: String = "") -> String:
	var style := projectile_style.to_lower()
	if style == "threshold":
		return "未破阈值" if _ui_is_zh() else "THRESHOLD"
	if style == "shield":
