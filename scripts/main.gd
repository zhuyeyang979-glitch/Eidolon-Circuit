		stardust_config["twist_wave_amplitude"] = MOBIUS_TWIST_WAVE_AMPLITUDE * 1.85
		stardust_config["depth_strength"] = MOBIUS_DEPTH_STRENGTH * 1.18
		stardust_config["stardust_alpha_max"] = 0.08
		stardust_config["stardust_source_alpha"] = 0.030
		stardust_config["stardust_source_width_px"] = 3.0
		stardust_config["stardust_particle_budget"] = 96
		mobius_stardust_band_view.set_world(stardust_config, mobius_rotation_state, _mobius_camera_coord())


func _battle_mode_title() -> String:
	if battle_mode == MODE_AI:
		match ai_battle_seat:
			2:
				return "%s / %s" % [_ui_term("ai_battle"), _ui_term("p2_right")]
			3:
				return "%s / %s %s" % [_ui_term("ai_battle"), _ui_term("p3_spectator"), _spectator_view_label()]
		return "%s / %s" % [_ui_term("ai_battle"), _ui_term("p1_left")]
	if _ui_is_zh():
		if battle_mode == MODE_TRAINING:
			return "%s / %s" % [_ui_term("training"), _battle_seat_label(ai_battle_seat)]
		if battle_mode == MODE_PVP:
			return "%s / %s" % [_ui_term("pvp"), _battle_seat_label(ai_battle_seat)]
	if battle_mode == MODE_TRAINING:
		return "%s / %s" % [_ui_term("training"), _battle_seat_label(ai_battle_seat)]
	if battle_mode == MODE_PVP:
		return "%s / %s" % [_ui_term("pvp"), _battle_seat_label(ai_battle_seat)]
	return battle_mode.to_upper()


func _update_camera_center() -> void:
	for player_id in [1, 2]:
		var target_center := _camera_focus_for_player(player_id)
		var target_lane := _camera_lane_focus_for_player(player_id)
		if battle_mode in [MODE_TRAINING, MODE_AI, MODE_PVP] and ai_battle_seat in [1, 2]:
			player_camera_centers[player_id] = target_center if mobius_enabled else wrapf(target_center, 0.0, RING_LENGTH)
			player_camera_lanes[player_id] = _clamp_camera_lane_center(target_lane)
		else:
			var current := _camera_center_for_player(player_id)
			var horizontal_delta := target_center - current if mobius_enabled else _ring_delta(current, target_center)
			var next_center := current + horizontal_delta * BATTLE_CAMERA_FOLLOW
			player_camera_centers[player_id] = next_center if mobius_enabled else wrapf(next_center, 0.0, RING_LENGTH)
			var current_lane := _camera_lane_for_player(player_id)
			player_camera_lanes[player_id] = _clamp_camera_lane_center(lerpf(current_lane, target_lane, BATTLE_CAMERA_FOLLOW))
	if battle_mode in [MODE_AI, MODE_TRAINING, MODE_PVP] and ai_battle_seat == 2:
		camera_center = _camera_center_for_player(2)
		camera_lane_center = _camera_lane_for_player(2)
	elif battle_mode in [MODE_AI, MODE_TRAINING, MODE_PVP] and ai_battle_seat == 3:
		match spectator_view_mode:
			SPECTATOR_VIEW_P1:
				spectator_camera_center = _camera_center_for_player(1)
				spectator_camera_lane = _camera_lane_for_player(1)
			SPECTATOR_VIEW_P2:
				spectator_camera_center = _camera_center_for_player(2)
				spectator_camera_lane = _camera_lane_for_player(2)
			SPECTATOR_VIEW_MID:
				var spectator_target := _spectator_camera_focus()
				if mobius_enabled:
					var current_s := MobiusWorld.nearest_lifted_s(spectator_target, fposmod(spectator_camera_center, RING_LENGTH), RING_LENGTH)
					spectator_camera_center = current_s + (spectator_target - current_s) * BATTLE_CAMERA_FOLLOW
				else:
					spectator_camera_center = wrapf(spectator_camera_center + _ring_delta(spectator_camera_center, spectator_target) * BATTLE_CAMERA_FOLLOW, 0.0, RING_LENGTH)
				spectator_camera_lane = _clamp_camera_lane_center(lerpf(spectator_camera_lane, _spectator_lane_focus(), BATTLE_CAMERA_FOLLOW))
		camera_center = spectator_camera_center
		camera_lane_center = _clamp_camera_lane_center(spectator_camera_lane)
	else:
		camera_center = _camera_center_for_player(1)
		camera_lane_center = _clamp_camera_lane_center(_camera_lane_for_player(1))
	if mobius_enabled:
		camera_mobius_s = camera_center
		camera_center = fposmod(camera_mobius_s, RING_LENGTH)
	else:
		_sync_camera_mobius_from_compat()


func _camera_center_for_player(player_id: int) -> float:
	return float(player_camera_centers.get(player_id, camera_center))


func _camera_lane_for_player(player_id: int) -> float:
	return _clamp_camera_lane_center(float(player_camera_lanes.get(player_id, camera_lane_center)))


func _camera_focus_for_player(player_id: int) -> float:
	var hero = active_units[player_id]["hero"]
	if _is_live_unit(hero):
		return _unit_combat_coord(hero).x
	for unit in _friendly_units(player_id):
		if _is_live_unit(unit):
			return _unit_combat_coord(unit).x
	var enemy_id := 2 if player_id == 1 else 1
	var enemy_hero = active_units[enemy_id]["hero"]
	if _is_live_unit(enemy_hero):
		return _unit_combat_coord(enemy_hero).x
	return _camera_center_for_player(player_id)


func _camera_lane_focus_for_player(player_id: int) -> float:
	var hero = active_units[player_id]["hero"]
	if _is_live_unit(hero):
		return clampf(_unit_combat_coord(hero).y, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	for unit in _friendly_units(player_id):
		if _is_live_unit(unit):
			return clampf(_unit_combat_coord(unit).y, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	var enemy_id := 2 if player_id == 1 else 1
	var enemy_hero = active_units[enemy_id]["hero"]
	if _is_live_unit(enemy_hero):
		return clampf(_unit_combat_coord(enemy_hero).y, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	return _camera_lane_for_player(player_id)


func _spectator_camera_focus() -> float:
	var left = active_units[1]["hero"]
	var right = active_units[2]["hero"]
	if not _is_live_unit(left):
		left = _first_live_unit_any_role(1)
	if not _is_live_unit(right):
		right = _first_live_unit_any_role(2)
	if _is_live_unit(left) and _is_live_unit(right):
		if mobius_enabled:
			var delta := _mobius_delta_vec_between(left, right)
			return _unit_combat_coord(left).x + delta.x * 0.5
		return wrapf(left.ring_pos + _ring_delta(left.ring_pos, right.ring_pos) * 0.5, 0.0, RING_LENGTH)
	if _is_live_unit(left):
		return _unit_combat_coord(left).x
	if _is_live_unit(right):
		return _unit_combat_coord(right).x
	return spectator_camera_center


func _spectator_lane_focus() -> float:
	var left = active_units[1]["hero"]
	var right = active_units[2]["hero"]
	if not _is_live_unit(left):
		left = _first_live_unit_any_role(1)
	if not _is_live_unit(right):
		right = _first_live_unit_any_role(2)
	if _is_live_unit(left) and _is_live_unit(right):
		if mobius_enabled:
			var delta := _mobius_delta_vec_between(left, right)
			return clampf(_unit_combat_coord(left).y + delta.y * 0.5, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
		return clampf((left.lane + right.lane) * 0.5, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	if _is_live_unit(left):
		return clampf(_unit_combat_coord(left).y, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	if _is_live_unit(right):
		return clampf(_unit_combat_coord(right).y, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	return 0.0


func _first_live_unit_any_role(player_id: int):
	var hero = active_units[player_id]["hero"]
	if _is_live_unit(hero):
		return hero
	var puppet = _first_live_puppet(player_id)
	if _is_live_unit(puppet):
		return puppet
	var barrier = active_units[player_id]["barrier"]
	if _is_live_unit(barrier):
		return barrier
	return null


func _screen_from_ring(ring_value: float, lane_value: float) -> Dictionary:
	if mobius_enabled:
		var coord := MobiusWorld.lift_ring_lane_near(camera_mobius_s, ring_value, lane_value, RING_LENGTH)
		return _mobius_project_coord(coord)
	var delta: float = _ring_delta(camera_center, ring_value)
	var lane_delta := lane_value - camera_lane_center
	var screen_scale := _battle_world_to_screen_scale()
	var half_width_units := ARENA_WIDTH / screen_scale * 0.5
	var half_height_units := VIEW_HEIGHT * 0.5
	var visible := absf(delta) <= half_width_units * 1.08 and absf(lane_delta) <= half_height_units * 1.08
	var x: float = (ARENA_LEFT + ARENA_RIGHT) * 0.5 + delta * screen_scale
	var y: float = (ARENA_TOP + ARENA_BOTTOM) * 0.5 + lane_delta * screen_scale
	return {"position": Vector2(x, y), "visible": visible}


func _battle_world_to_screen_scale() -> float:
	return ARENA_HEIGHT / VIEW_HEIGHT


func _world_point_visible_for_player(ring_value: float, lane_value: float, player_id: int, margin_mult: float = 1.0) -> bool:
	var center := _camera_center_for_player(player_id)
	var lane_center := _camera_lane_for_player(player_id)
	if mobius_enabled:
		var reference_s := MobiusWorld.nearest_lifted_s(camera_mobius_s, center, RING_LENGTH)
		var from_coord := Vector2(reference_s, lane_center)
		var to_coord := MobiusWorld.lift_ring_lane_near(reference_s, ring_value, lane_value, RING_LENGTH)
		var delta_vec := MobiusWorld.delta_vec(from_coord, to_coord, RING_LENGTH)
		var screen_scale_mobius := _battle_world_to_screen_scale()
		var half_width_mobius := ARENA_WIDTH / screen_scale_mobius * 0.5
		var half_height_mobius := VIEW_HEIGHT * 0.5
		return absf(delta_vec.x) <= half_width_mobius * margin_mult and absf(delta_vec.y) <= half_height_mobius * margin_mult
	var delta: float = _ring_delta(center, ring_value)
	var lane_delta := lane_value - lane_center
	var screen_scale := _battle_world_to_screen_scale()
	var half_width_units := ARENA_WIDTH / screen_scale * 0.5
	var half_height_units := VIEW_HEIGHT * 0.5
	return absf(delta) <= half_width_units * margin_mult and absf(lane_delta) <= half_height_units * margin_mult


func _space_debris_visible_to_any_player(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	var margin := 1.08 + BARRIER_DEBRIS_SCREEN_MARGIN
	return _world_point_visible_for_player(unit.ring_pos, unit.lane, 1, margin) or _world_point_visible_for_player(unit.ring_pos, unit.lane, 2, margin)


func _update_space_debris(unit, delta: float) -> bool:
	if unit == null or not is_instance_valid(unit) or not bool(unit.get_meta("space_debris", false)):
		return false
	unit.set_meta("space_debris_age", float(unit.get_meta("space_debris_age", 0.0)) + delta)
	if float(unit.get_meta("space_debris_age", 0.0)) < 0.6:
		return false
	if _space_debris_visible_to_any_player(unit):
		return false
	unit.retire()
	all_units.erase(unit)
	unit.queue_free()
	return true


func _spawn_for_selected_portal(player_id: int, role_key: String, stats: Dictionary) -> Dictionary:
	if role_key == "barrier":
		return {"ring": _camera_center_for_player(player_id), "lane": _camera_lane_for_player(player_id)}
	var portal: Dictionary = PORTALS[int(portal_index[player_id])]
	var lane_value: float = clampf(_camera_lane_for_player(player_id) + float(portal["lane"]) * 1.35, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	var delta_value: float = float(portal["delta"])
	if float(stats.get("radius", 0.2)) > 0.58 and absf(float(portal["lane"])) > 0.5:
		lane_value = _camera_lane_for_player(player_id)
		delta_value = -3.0 if delta_value < 0.0 else 3.0
	return {"ring": wrapf(_camera_center_for_player(player_id) + delta_value, 0.0, RING_LENGTH), "lane": lane_value}


func _enemy_units(player_id: int) -> Array:
	var enemies: Array = []
	var enemy_id := 2 if player_id == 1 else 1
	var hero = active_units[enemy_id]["hero"]
	if _is_live_unit(hero):
		enemies.append(hero)
	var barrier = active_units[enemy_id]["barrier"]
	if _is_live_unit(barrier):
		enemies.append(barrier)
	var group: Array = active_units[enemy_id]["puppet"]
	for unit in group:
		if _is_live_unit(unit):
			enemies.append(unit)
	return enemies


func _nearest_enemy(unit, player_id: int):
	var best = null
	var best_distance := 999.0
	for target in _enemy_units(player_id):
		var delta := _mobius_delta_vec_between(unit, target, 0.65)
		var distance: float = absf(delta.x) + absf(delta.y)
		if distance < best_distance:
			best_distance = distance
			best = target
	return best


func _source_guard_anchor_for(unit, target, player_id: int):
	var best = null
	var best_score := -99999.0
	for ally in _friendly_units(player_id):
		if not _is_live_unit(ally) or ally == unit:
			continue
		if String(ally.role) == "barrier":
			continue
		var distance_to_threat := 0.0
		if _is_live_unit(target):
			distance_to_threat = _source_target_distance(ally, target)
		var hp_ratio: float = float(ally.health_ratio()) if ally.has_method("health_ratio") else 1.0
		var score := -distance_to_threat * 8.0 + (1.0 - hp_ratio) * 46.0
		if String(ally.role) == "puppet":
			score += 18.0
		if String(ally.role) == "hero":
			score += 8.0
		if float(ally.get_meta("retreating_timer", 0.0)) > 0.0:
			score += 28.0
		if score > best_score:
			best_score = score
			best = ally
	return best


func _source_group_threat_score(unit, target, player_id: int) -> float:
	if not _is_live_unit(target):
		return 0.0
	var score := 0.0
	var anchor = _source_guard_anchor_for(unit, target, player_id)
	if _is_live_unit(anchor):
		var distance_to_anchor := _source_target_distance(anchor, target)
		score += maxf(0.0, 106.0 - distance_to_anchor * 92.0)
		var anchor_hp_ratio: float = float(anchor.health_ratio()) if anchor.has_method("health_ratio") else 1.0
		score += (1.0 - anchor_hp_ratio) * 42.0
		if String(anchor.role) == "puppet":
			score += 16.0
	if float(target.get_meta("projectile_signal", 0.0)) > 0.0:
		score += 34.0
	if String(target.role) == "hero":
		score += 8.0
	score += maxf(0.0, 42.0 - _source_target_distance(unit, target) * 36.0)
	return score


func _source_target_for_puppet(unit, player_id: int):
	var enemies := _enemy_units(player_id)
	if enemies.is_empty():
		return null
	var threat_range := float(unit.stats.get("source_threat_override_range", 0.0))
	if threat_range > 0.0 and String(unit.stats.get("source_close_response", "")) in ["kite", "retreat", "screen", "intercept"]:
		var close_threat = null
		var close_distance := 999.0
		for target in enemies:
			var distance := _source_target_distance(unit, target)
			if distance < close_distance:
				close_distance = distance
				close_threat = target
		if close_threat != null and close_distance <= threat_range:
			return close_threat
	var policy := String(unit.stats.get("source_target_policy", "nearest"))
	if policy == "" or policy == "nearest":
		return _nearest_enemy(unit, player_id)
	var best = null
	var best_score := -99999.0
	for target in enemies:
		var score := _source_target_score(unit, target, player_id, policy)
		if score > best_score:
			best_score = score
			best = target
	return best if best != null else _nearest_enemy(unit, player_id)


func _source_target_distance(unit, target) -> float:
	var delta := _mobius_delta_vec_between(unit, target, 0.65)
	return absf(delta.x) + absf(delta.y)


func _source_target_score(unit, target, player_id: int, policy: String) -> float:
	var distance: float = _source_target_distance(unit, target)
	var hp_ratio: float = float(target.health_ratio()) if target != null and target.has_method("health_ratio") else 1.0
	var score: float = -distance * 8.0 + (1.0 - hp_ratio) * 18.0
	var target_role := String(target.role)
	var sight_delta := _mobius_delta_vec_between(unit, target, 0.65)
	var sight_event := {"direction": sight_delta.normalized() if sight_delta.length() > 0.01 else _unit_forward_vector(unit), "range": maxf(0.1, sight_delta.length()), "lane_range": 0.08, "ai_line_of_sight": true}
	var sight_blocked := _map_line_occluded(unit, target, sight_event)
	if sight_blocked:
		score -= 30.0
	match policy:
		"heat_pressure_first":
			var heat_focus_ratio := clampf(float(unit.stats.get("source_heat_focus_ratio", 0.68)), 0.0, 1.0)
			var heat_ratio := _source_target_heat_ratio(target)
			score += 240.0 if target.overheated else 0.0
			score += heat_ratio * (150.0 if heat_ratio >= heat_focus_ratio else 36.0)
			score += 42.0 if target_role == "hero" else 0.0
			score += 16.0 if target_role == "puppet" else 0.0
			score += 12.0 if target_role == "barrier" and _source_target_is_support_barrier(target) else 0.0
			score += (1.0 - hp_ratio) * 16.0
			score -= distance * 1.4
			score -= 48.0 if sight_blocked else 0.0
		"hero_low_hp_ranged":
			score += 120.0 if target_role == "hero" else 0.0
			score += (1.0 - hp_ratio) * 54.0
			score += 12.0 if target_role == "puppet" else 0.0
			score -= 42.0 if target_role == "barrier" else 0.0
			score -= distance * 2.5
			score -= 72.0 if sight_blocked else 0.0
		"low_hp_first":
			score += (1.0 - hp_ratio) * 118.0
			score += 22.0 if target_role == "hero" else 0.0
			score += 10.0 if target_role == "puppet" else 0.0
			score -= distance * 1.7
		"protect_hero":
			var own_hero = active_units[player_id]["hero"]
			if _is_live_unit(own_hero):
				var hero_distance := absf(_ring_delta(own_hero.ring_pos, target.ring_pos)) + absf(own_hero.lane - target.lane) * 0.8
				score += maxf(0.0, 80.0 - hero_distance * 32.0)
			score += 36.0 if target_role == "hero" else 0.0
			score += 24.0 if float(target.get_meta("projectile_signal", 0.0)) > 0.0 else 0.0
		"protect_puppet_group":
			score += _source_group_threat_score(unit, target, player_id)
			score += 18.0 if float(target.get_meta("projectile_signal", 0.0)) > 0.0 else 0.0
			score += 10.0 if target_role == "puppet" else 0.0
			score -= 34.0 if target_role == "barrier" else 0.0
			score -= distance * 1.1
		"hero_siege":
			score += 180.0 if target_role == "hero" else 0.0
			score += 28.0 if target_role == "barrier" else 0.0
			score += (1.0 - hp_ratio) * 26.0
			score -= distance * 1.2
	return score


func _source_target_heat_ratio(target) -> float:
	if target == null or not is_instance_valid(target):
		return 0.0
	if target.has_method("heat_ratio"):
		return clampf(float(target.heat_ratio()), 0.0, 1.0)
	var heat_capacity := maxf(0.0, float(target.stats.get("heat_capacity", 0.0)))
	if heat_capacity <= 0.0:
		return 0.0
	return clampf(float(target.heat) / heat_capacity, 0.0, 1.0)


func _source_target_is_support_barrier(target) -> bool:
	if target == null or not is_instance_valid(target):
		return false
	var stats: Dictionary = target.stats if target.stats is Dictionary else {}
	return bool(stats.get("is_repair_station", false)) or bool(stats.get("is_coolant_field", false)) or float(stats.get("ally_cooling", 0.0)) > 0.0 or float(stats.get("coolant_boost", 0.0)) > 0.0


func _first_live_puppet(player_id: int):
	for unit in active_units[player_id]["puppet"]:
		if _is_live_unit(unit) and not _is_temporary_fracture_puppet(unit):
			return unit
	for unit in active_units[player_id]["puppet"]:
		if _is_live_unit(unit):
			return unit
	return null


func _role_status_text(player_id: int, role_key: String) -> String:
	if _role_pending(player_id, role_key):
		return "%s: %s %.1fs" % [_role_name(role_key), _ui_term("deploy"), float(pending_deploys[player_id][role_key])]
	if role_key == "puppet":
		return _unit_status_text(_first_live_puppet(player_id), _role_name(role_key))
	return _unit_status_text(active_units[player_id][role_key], _role_name(role_key))


func _unit_status_text(unit, fallback: String) -> String:
	if not _is_live_unit(unit):
		return "%s: %s" % [fallback, _ui_term("offline")]
	var state_text := _ui_term("blind") if _unit_blind_strength(unit) > 0.08 else (_ui_term("overheat") if unit.overheated else (_ui_term("stagger") if float(unit.get_meta("melee_stagger_timer", 0.0)) > 0.0 else _combat_state_name(String(unit.current_state))))
	var armor_text := " %s%.0f" % [_ui_term("support_armor"), float(unit.get_meta("support_armor_hp", 0.0))] if float(unit.get_meta("support_armor_timer", 0.0)) > 0.0 and float(unit.get_meta("support_armor_hp", 0.0)) > 0.0 else ""
	var electronic_armor_text := " %s%.0f/%.0f" % [_ui_term("electronic_armor"), float(unit.get_meta("electronic_armor_hp", 0.0)), float(unit.get_meta("electronic_armor_max", unit.stats.get("electronic_armor_max", 0.0)))] if float(unit.get_meta("electronic_armor_max", unit.stats.get("electronic_armor_max", 0.0))) > 0.0 else ""
	var heat_text := "  %s %d%%" % [_ui_term("heat"), int(roundf(unit.heat_ratio() * 100.0))] if _unit_uses_heat(unit) else ""
	var hp_label := "生命" if _ui_is_zh() else "HP"
	return "%s %s %d/%d%s%s%s  %s" % [
		fallback,
		hp_label,
		int(unit.health),
		int(unit.max_health),
		armor_text,
		electronic_armor_text,
		heat_text,
		state_text,
	]


func _unit_ammo_text(unit) -> String:
	var display := _unit_ammo_display_text(unit)
	return "" if display == "" else " %s" % display


func _unit_ammo_display_text(unit) -> String:
	if unit == null or not is_instance_valid(unit):
		return ""
	var caps: Dictionary = unit.stats.get("ammo_capacity", {})
	var has_ammo := false
	for ammo_type in AMMO_TYPES:
		if int(caps.get(ammo_type, 0)) > 0:
			has_ammo = true
			break
	if not has_ammo:
		return ""
	return "%s B%d/%d C%d/%d L%d/%d" % [
		_ui_term("ammo"),
		_current_ammo(unit, "bullet"),
		_ammo_capacity_for(unit, "bullet"),
		_current_ammo(unit, "chemical"),
		_ammo_capacity_for(unit, "chemical"),
		_current_ammo(unit, "laser"),
		_ammo_capacity_for(unit, "laser"),
	]


func _shield_bar_color(player_id: int) -> Color:
	var base := Color(0.36, 0.92, 1.0, 0.92) if player_id == 1 else Color(0.72, 0.42, 1.0, 0.92)
	return base.lerp(Color.WHITE, 0.18)


func _set_corner_bar(rect: ColorRect, player_id: int, max_width: float, ratio: float) -> void:
	if rect == null:
		return
	var fill_width := max_width * clampf(ratio, 0.0, 1.0)
	var base_x := 34.0 if player_id == 1 else 886.0
	rect.size.x = fill_width
	rect.position.x = base_x if player_id == 1 else base_x + max_width - fill_width


func _set_shield_corner_bar(rect: ColorRect, player_id: int, max_width: float, ratio: float) -> void:
	if rect == null:
		return
	var clamped := clampf(ratio, 0.0, 1.0)
	var fill_width := max_width * clamped
	if clamped > 0.001:
		fill_width = maxf(fill_width, 10.0)
	var base_x := 34.0 if player_id == 1 else 886.0
	rect.size.x = fill_width
	rect.position.x = base_x if player_id == 1 else base_x + max_width - fill_width


func _set_puppet_segment_bar(player_id: int, max_width: float) -> void:
	var backs: Array = puppet_health_segment_backs.get(player_id, [])
	var fills: Array = puppet_health_segments.get(player_id, [])
	var shield_fills: Array = puppet_shield_segments.get(player_id, [])
	for i in range(mini(backs.size(), fills.size())):
		var back: ColorRect = backs[i]
		var fill: ColorRect = fills[i]
		back.visible = false
		fill.visible = false
		if i < shield_fills.size():
			var shield_fill: ColorRect = shield_fills[i]
			shield_fill.visible = false
	var entries := _puppet_slot_health_entries(player_id)
	var segment_count := entries.size()
	if segment_count <= 0:
		return
	var gap := 4.0
	var segment_width := maxf(2.0, (max_width - gap * float(segment_count - 1)) / float(segment_count))
	var base_x := 34.0 if player_id == 1 else 886.0
	var puppet_role_index := maxi(0, ROLE_ORDER.find("puppet"))
	var base_y := 72.0 + float(puppet_role_index) * 23.0 + 15.0
	var primary := _team_primary_color(player_id)
	var accent := _team_accent_color(player_id)
	for i in range(mini(segment_count, mini(backs.size(), fills.size()))):
		var entry: Dictionary = entries[i]
		var ratio := clampf(float(entry.get("ratio", 0.0)), 0.0, 1.0)
		var shield_ratio := clampf(float(entry.get("shield_ratio", 0.0)), 0.0, 1.0)
		var temporary := bool(entry.get("temporary", false))
		var x := base_x + float(i) * (segment_width + gap)
		var back: ColorRect = backs[i]
		var fill: ColorRect = fills[i]
		back.position = Vector2(x, base_y)
		back.size = Vector2(segment_width, 10.0)
		back.color = Color(0.035, 0.046, 0.055, 0.9).lerp(primary, 0.16 if temporary else 0.08)
		back.visible = true
		if ratio <= 0.001:
			continue
		var fill_width := segment_width * ratio
		fill.position = Vector2(x if player_id == 1 else x + segment_width - fill_width, base_y)
		fill.size = Vector2(fill_width, 10.0)
		fill.color = primary.lerp(Color(0.92, 0.96, 1.0, 1.0), 0.48) if temporary else primary.lerp(accent, 0.18 + 0.12 * float(i % 2))
		fill.visible = true
		if i < shield_fills.size() and shield_ratio > 0.001:
			var shield_fill: ColorRect = shield_fills[i]
			var shield_width := maxf(segment_width * shield_ratio, minf(7.0, segment_width))
			shield_fill.position = Vector2(x if player_id == 1 else x + segment_width - shield_width, base_y)
			shield_fill.size = Vector2(shield_width, 5.0)
			shield_fill.color = _shield_bar_color(player_id).lerp(Color.WHITE, 0.18 if temporary else 0.0)
			shield_fill.visible = true


func _puppet_group_size(player_id: int) -> int:
	var group: Array = active_units[player_id]["puppet"]
	var group_size := 0
	for unit in group:
		if _is_live_unit(unit):
			group_size = maxi(group_size, int(unit.get_meta("puppet_group_size", 0)))
	if group_size <= 0:
		group_size = _live_unit_count(group)
	return clampi(group_size, 0, PUPPET_HP_SEGMENT_MAX)


func _puppet_slot_health_ratios(player_id: int) -> Array:
	var entries := _puppet_slot_health_entries(player_id)
	var ratios := []
	for entry in entries:
		ratios.append(float(Dictionary(entry).get("ratio", 0.0)))
	return ratios


func _puppet_slot_health_entries(player_id: int) -> Array:
	var group_size := _puppet_group_size(player_id)
	var entries := []
	for i in range(group_size):
		entries.append({"ratio": 0.0, "shield_ratio": 0.0, "temporary": false})
	if group_size <= 0:
		return entries
	for unit in active_units[player_id]["puppet"]:
		if not _is_live_unit(unit):
			continue
		var slot := clampi(int(unit.get_meta("puppet_group_slot", 0)), 0, group_size - 1)
		var entry: Dictionary = entries[slot]
		entry["ratio"] = maxf(float(entry.get("ratio", 0.0)), unit.health_ratio())
		entry["shield_ratio"] = maxf(float(entry.get("shield_ratio", 0.0)), _unit_shield_ratio(unit))
		entry["temporary"] = bool(entry.get("temporary", false)) or _is_temporary_fracture_puppet(unit)
		entries[slot] = entry
	return entries


func _role_health_ratio(player_id: int, role_key: String) -> float:
	if role_key == "puppet":
		return _puppet_average_ratio(player_id, true)
	var unit = active_units[player_id][role_key]
	return unit.health_ratio() if _is_live_unit(unit) else 0.0


func _role_shield_ratio(player_id: int, role_key: String) -> float:
	if role_key == "puppet":
		var best := 0.0
		for unit in active_units[player_id]["puppet"]:
			if _is_live_unit(unit):
				best = maxf(best, _unit_shield_ratio(unit))
		return best
	var unit = active_units[player_id][role_key]
	return _unit_shield_ratio(unit) if _is_live_unit(unit) else 0.0


func _unit_shield_hp(unit) -> float:
	if unit == null or not is_instance_valid(unit):
		return 0.0
	if unit.has_method("shield_value"):
		return float(unit.shield_value())
	return clampf(float(unit.get_meta("shield_hp", unit.get_meta("electronic_armor_hp", 0.0))), 0.0, _unit_shield_max(unit))


func _unit_shield_max(unit) -> float:
	if unit == null or not is_instance_valid(unit):
		return 0.0
	if unit.has_method("shield_max_value"):
		return float(unit.shield_max_value())
	return maxf(0.0, float(unit.get_meta("shield_max", unit.get_meta("electronic_armor_max", unit.stats.get("electronic_armor_max", 0.0)))))


func _unit_shield_ratio(unit) -> float:
	if unit == null or not is_instance_valid(unit):
		return 0.0
	if unit.has_method("shield_ratio"):
		return float(unit.shield_ratio())
	var shield_max := _unit_shield_max(unit)
	if shield_max <= 0.0:
		return 0.0
	var max_health := maxf(1.0, float(unit.max_health))
	var display_span := maxf(max_health, shield_max)
	return clampf(_unit_shield_hp(unit) / display_span, 0.0, 1.0)


func _role_heat_ratio(player_id: int, role_key: String) -> float:
	if role_key != "hero":
		return 0.0
	var unit = active_units[player_id][role_key]
	return unit.heat_ratio() if _is_live_unit(unit) and _unit_uses_heat(unit) else 0.0


func _puppet_average_ratio(player_id: int, health_mode: bool) -> float:
	var total := 0.0
	var count := 0
	for unit in active_units[player_id]["puppet"]:
		if _is_live_unit(unit):
			total += unit.health_ratio() if health_mode else unit.heat_ratio()
			count += 1
	if count <= 0:
		return 0.0
	return total / float(count)


func _role_bar_text(player_id: int, role_key: String) -> String:
	if _role_pending(player_id, role_key):
		return "%s %.1fs" % [_ui_term("deploy"), float(pending_deploys[player_id][role_key])]
	if role_key == "puppet":
		var entries := _puppet_slot_health_entries(player_id)
		if entries.is_empty():
			return _ui_term("offline")
		var pieces := PackedStringArray()
		for entry in entries:
			var ratio := float(Dictionary(entry).get("ratio", 0.0))
			var suffix := "*" if bool(Dictionary(entry).get("temporary", false)) else ""
			pieces.append("--" if ratio <= 0.001 else "%d%s" % [int(roundf(ratio * 100.0)), suffix])
		return "x%d %s%%" % [entries.size(), "/".join(pieces)]
	var unit = active_units[player_id][role_key]
	if not _is_live_unit(unit):
		return _ui_term("offline")
	var switch_tag := " %s" % _ui_term("shift") if String(unit.stats.get("role_switch", "")) != "" else ""
	var electronic_armor_tag := " %s%.0f" % [_ui_term("electronic_armor"), float(unit.get_meta("electronic_armor_hp", 0.0))] if float(unit.get_meta("electronic_armor_max", unit.stats.get("electronic_armor_max", 0.0))) > 0.0 else ""
	if role_key == "hero" and _unit_uses_heat(unit):
		return "%d/%d%s  %s %.0f%%%s" % [int(unit.health), int(unit.max_health), electronic_armor_tag, _ui_term("heat"), unit.heat_ratio() * 100.0, switch_tag]
	return "%d/%d%s%s" % [int(unit.health), int(unit.max_health), electronic_armor_tag, switch_tag]


func _rps_multiplier(attack_state: String, defend_state: String) -> float:
	if attack_state == defend_state:
		return 1.0
	if attack_state == "armor" and defend_state == "normal":
		return 1.7
	if attack_state == "normal" and defend_state == "active":
		return 1.7
	if attack_state == "active" and defend_state == "armor":
		return 1.7
	return 0.48


func _ring_delta(from_value: float, to_value: float) -> float:
	return fposmod(to_value - from_value + RING_LENGTH * 0.5, RING_LENGTH) - RING_LENGTH * 0.5


func _wrapped_index(value: int, size: int) -> int:
	if size <= 0:
		return 0
	var wrapped := value % size
	if wrapped < 0:
		wrapped += size
	return wrapped


func _is_live_unit(unit) -> bool:
	return unit != null and is_instance_valid(unit) and unit.active and unit.health > 0


func _is_temporary_fracture_puppet(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	return bool(unit.get_meta("temporary_fracture_puppet", false)) or bool(unit.stats.get("temporary_fracture_puppet", false))


func _live_unit_count(units: Array) -> int:
	var count := 0
	for unit in units:
		if _is_live_unit(unit):
			count += 1
	return count


func _live_primary_puppet_count(player_id: int) -> int:
	var count := 0
	for unit in active_units[player_id]["puppet"]:
		if _is_live_unit(unit) and not _is_temporary_fracture_puppet(unit):
			count += 1
	return count


func _live_temporary_fracture_puppets(player_id: int) -> Array:
	var fragments: Array = []
	for unit in active_units[player_id]["puppet"]:
		if _is_live_unit(unit) and _is_temporary_fracture_puppet(unit):
			fragments.append(unit)
	return fragments


func _live_units_for(player_id: int) -> int:
	var count := 0
	if _is_live_unit(active_units[player_id]["hero"]):
		count += 1
	if _is_live_unit(active_units[player_id]["barrier"]):
		count += 1
	count += _live_unit_count(active_units[player_id]["puppet"])
	return count


func _show_battle_message(message: String, duration: float) -> void:
	battle_message = message
	battle_message_timer = duration
	if battle_message_label != null:
		battle_message_label.text = message


func _illegal_summon_feedback(player_id: int, message: String) -> void:
	_show_battle_message(message, 0.75)
	_play_illegal_summon_sfx()


func _play_illegal_summon_sfx() -> void:
	_play_sfx_wave("alarm", 118.0, 0.18, -8.0)


func _register_inputs() -> void:
	_bind_key("menu_up", KEY_W)
	_bind_key("menu_up", KEY_UP)
	_bind_key("menu_down", KEY_S)
	_bind_key("menu_down", KEY_DOWN)
	_bind_key("menu_confirm", KEY_ENTER)
	_bind_key("menu_back", KEY_ESCAPE)
	_bind_key("copy_team", KEY_C)
	_bind_key("editor_next_role", KEY_Q)
	_bind_key("editor_next_unit", KEY_E)
	_bind_key("editor_add_unit", KEY_N)
	_bind_key("editor_delete_unit", KEY_DELETE)
	_bind_key("editor_set_initial", KEY_L)

	for device in [0, 1]:
		_bind_joy_button("menu_up", JOY_BUTTON_DPAD_UP, device)
		_bind_joy_button("menu_down", JOY_BUTTON_DPAD_DOWN, device)
		_bind_joy_button("menu_confirm", JOY_BUTTON_A, device)
		_bind_joy_button("menu_back", JOY_BUTTON_B, device)

	_bind_player_inputs("p1", 0, true)
	_bind_player_inputs("p2", 1, false)


func _bind_player_inputs(prefix: String, device: int, include_keyboard: bool) -> void:
	for base_action in ["left", "right", "up", "down", "face_left", "face_right", "portal"]:
		_clear_input_action("%s_%s" % [prefix, base_action])
	for attack_key_index in range(1, ATTACK_GROUP_COUNT + 1):
		_clear_input_action("%s_attack_%d" % [prefix, attack_key_index])
	if include_keyboard:
		_bind_key("%s_left" % prefix, KEY_A)
		_bind_key("%s_right" % prefix, KEY_D)
		_bind_key("%s_up" % prefix, KEY_W)
		_bind_key("%s_down" % prefix, KEY_S)
		_bind_key("%s_face_left" % prefix, KEY_Q)
		_bind_key("%s_face_right" % prefix, KEY_E)
		_bind_key("%s_portal" % prefix, KEY_TAB)
		for attack_key_index in range(1, ATTACK_GROUP_COUNT + 1):
			var action_name := "%s_attack_%d" % [prefix, attack_key_index]
			_clear_keyboard_events(action_name)
			_bind_key(action_name, _attack_keycode_for_index(attack_key_index))

	_bind_joy_button("%s_left" % prefix, JOY_BUTTON_DPAD_LEFT, device)
	_bind_joy_button("%s_right" % prefix, JOY_BUTTON_DPAD_RIGHT, device)
	_bind_joy_button("%s_up" % prefix, JOY_BUTTON_DPAD_UP, device)
	_bind_joy_button("%s_down" % prefix, JOY_BUTTON_DPAD_DOWN, device)
	_bind_joy_axis("%s_left" % prefix, JOY_AXIS_LEFT_X, -1.0, device)
	_bind_joy_axis("%s_right" % prefix, JOY_AXIS_LEFT_X, 1.0, device)
	_bind_joy_axis("%s_up" % prefix, JOY_AXIS_LEFT_Y, -1.0, device)
	_bind_joy_axis("%s_down" % prefix, JOY_AXIS_LEFT_Y, 1.0, device)
	_bind_joy_axis("%s_face_left" % prefix, JOY_AXIS_RIGHT_X, -1.0, device)
	_bind_joy_axis("%s_face_right" % prefix, JOY_AXIS_RIGHT_X, 1.0, device)
	_bind_joy_button("%s_attack_1" % prefix, JOY_BUTTON_A, device)
	_bind_joy_button("%s_attack_2" % prefix, JOY_BUTTON_X, device)
	_bind_joy_button("%s_attack_3" % prefix, JOY_BUTTON_Y, device)
	_bind_joy_button("%s_attack_4" % prefix, JOY_BUTTON_B, device)
	_bind_joy_button("%s_attack_5" % prefix, JOY_BUTTON_LEFT_SHOULDER, device)
	_bind_joy_button("%s_attack_6" % prefix, JOY_BUTTON_RIGHT_SHOULDER, device)
	_bind_joy_button("%s_portal" % prefix, JOY_BUTTON_BACK, device)
	for removed_action in ["%s_cool" % prefix, "%s_active" % prefix, "%s_armor" % prefix]:
		_clear_input_action(removed_action)


func _attack_keycode_for_index(key_index: int) -> int:
	match clampi(key_index, 1, ATTACK_GROUP_COUNT):
		1:
			return KEY_U
		2:
			return KEY_I
		3:
			return KEY_O
		4:
			return KEY_J
		5:
			return KEY_K
		6:
			return KEY_L
	return KEY_U


func _clear_input_action(action_name: String) -> void:
	if InputMap.has_action(action_name):
		InputMap.erase_action(action_name)


func _clear_keyboard_events(action_name: String) -> void:
	if not InputMap.has_action(action_name):
		return
	for existing_event in InputMap.action_get_events(action_name):
		if existing_event is InputEventKey:
			InputMap.action_erase_event(action_name, existing_event)


func _bind_key(action_name: String, keycode: int) -> void:
	if not InputMap.has_action(action_name):
		InputMap.add_action(action_name)
	var event := InputEventKey.new()
	event.physical_keycode = keycode
	for existing_event in InputMap.action_get_events(action_name):
		if existing_event is InputEventKey and existing_event.physical_keycode == keycode:
			return
	InputMap.action_add_event(action_name, event)


func _bind_joy_button(action_name: String, button_index: int, device: int) -> void:
	if not InputMap.has_action(action_name):
		InputMap.add_action(action_name)
	var event := InputEventJoypadButton.new()
	event.device = device
	event.button_index = button_index
	InputMap.action_add_event(action_name, event)


func _bind_joy_axis(action_name: String, axis_index: int, axis_value: float, device: int) -> void:
	if not InputMap.has_action(action_name):
		InputMap.add_action(action_name)
	var event := InputEventJoypadMotion.new()
	event.device = device
	event.axis = axis_index
	event.axis_value = axis_value
	InputMap.action_add_event(action_name, event)


func _enable_mouse_for_buttons(node: Node) -> void:
	if node is PartDragGhostView:
		var ghost := node as PartDragGhostView
		ghost.focus_mode = Control.FOCUS_NONE
		ghost.mouse_filter = Control.MOUSE_FILTER_IGNORE
		return
	if node is Button:
		var button := node as Button
		button.focus_mode = Control.FOCUS_NONE
		button.mouse_filter = Control.MOUSE_FILTER_STOP
	for child in node.get_children():
		_enable_mouse_for_buttons(child)


func _add_rect(rect_name: String, rect_position: Vector2, rect_size: Vector2, color: Color, parent: Node) -> Polygon2D:
	var rect := Polygon2D.new()
	rect.name = rect_name
	rect.position = rect_position
	rect.polygon = PackedVector2Array([Vector2.ZERO, Vector2(rect_size.x, 0.0), rect_size, Vector2(0.0, rect_size.y)])
	rect.color = color
	parent.add_child(rect)
	return rect


func _add_ui_rect(parent: Control, rect_name: String, rect_position: Vector2, rect_size: Vector2, color: Color) -> ColorRect:
	var rect := ColorRect.new()
	rect.name = rect_name
	rect.position = rect_position
	rect.size = rect_size
	rect.color = color
	rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(rect)
	return rect


func _add_layout_ui_rect(parent: Control, rect_name: String, token_rect: Rect2, color: Color) -> ColorRect:
	var screen_rect := UILayoutTokens.to_screen_rect(token_rect, _ui_viewport_size())
	return _add_ui_rect(parent, rect_name, screen_rect.position, screen_rect.size, color)


func _add_token_ui_rect(parent: Control, rect_name: String, token_id: String, color: Color) -> ColorRect:
	return _add_layout_ui_rect(parent, rect_name, UILayoutTokens.screen_region(token_id), color)


func _offset_rect(rect: Rect2, offset: Vector2) -> Rect2:
	return Rect2(rect.position + offset, rect.size)


func _ui_viewport_size() -> Vector2:
	var viewport := get_viewport()
	if viewport == null:
		return UILayoutTokens.DESIGN_SIZE
	var rect := viewport.get_visible_rect()
	if rect.size.x <= 0.0 or rect.size.y <= 0.0:
		return UILayoutTokens.DESIGN_SIZE
	return rect.size


func _apply_layout_rect(control: Control, token_rect: Rect2) -> void:
	var screen_rect := UILayoutTokens.to_screen_rect(token_rect, _ui_viewport_size())
	control.position = screen_rect.position
	control.size = screen_rect.size


func _apply_token_rect(control: Control, token_id: String) -> void:
	_apply_layout_rect(control, UILayoutTokens.screen_region(token_id))


func _make_layout_label(parent: Control, label_name: String, text: String, token_rect: Rect2, font_size: int, color: Color, alignment: HorizontalAlignment) -> Label:
	var screen_rect := UILayoutTokens.to_screen_rect(token_rect, _ui_viewport_size())
	return _make_label(parent, label_name, text, screen_rect.position, screen_rect.size, font_size, color, alignment)


func _make_token_label(parent: Control, label_name: String, text: String, token_id: String, font_size: int, color: Color, alignment: HorizontalAlignment) -> Label:
	return _make_layout_label(parent, label_name, text, UILayoutTokens.screen_region(token_id), font_size, color, alignment)


func _make_label(parent: Control, label_name: String, text: String, label_position: Vector2, label_size: Vector2, font_size: int, color: Color, alignment: HorizontalAlignment) -> Label:
	var label := Label.new()
	label.name = label_name
	label.text = text
	label.position = label_position
	label.size = label_size
	label.horizontal_alignment = alignment
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.add_theme_font_size_override("font_size", font_size)
	label.add_theme_color_override("font_color", color)
	label.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.76))
	label.add_theme_constant_override("outline_size", 4)
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(label)
	return label


