		editor_drag_ghost_view.visible = false


func _clear_editor_catalog_manual_drag() -> void:
	editor_drag_catalog_active = false
	editor_drag_catalog_started = false
	editor_drag_catalog_slot = ""
	editor_drag_catalog_index = -1
	editor_drag_catalog_start = Vector2.ZERO
	editor_drag_catalog_last = Vector2.ZERO
	_hide_editor_drag_ghost()
	_refresh_editor_visual_views()


func _handle_global_ui_right_click(mouse_position: Vector2) -> bool:
	if game_state != STATE_SCOUT:
		return false
	var button = _top_visible_button_at(mouse_position)
	var index := scout_player_buttons.find(button)
	if index < 0:
		return false
	var now := Time.get_ticks_msec()
	if now - ui_mouse_click_latch_msec < 120:
		return true
	ui_mouse_click_latch_msec = now
	var player_id := clampi(int(scout_sortie_player_id), 1, 2)
	var order := _all_roster_order(player_id)
	if index < 0 or index >= order.size():
		return false
	scout_hint_label.text = _set_sortie_starter_entry(player_id, order[index])
	_update_scout_ui()
	_play_sfx_wave("clack", 520.0, 0.035, -22.0)
	return true


func _top_visible_button_at(mouse_position: Vector2):
	var layers := [page_options_layer, format_select_layer, hud_layer, settings_layer, scout_layer, saved_units_layer, editor_layer, menu_layer]
	for layer in layers:
		if layer != null and layer.visible:
			var found = _find_button_at_recursive(layer, mouse_position)
			if found != null:
				return found
	return null


func _find_button_at_recursive(node: Node, mouse_position: Vector2):
	var children := node.get_children()
	for i in range(children.size() - 1, -1, -1):
		var found = _find_button_at_recursive(children[i], mouse_position)
		if found != null:
			return found
	if node is Button:
		var button := node as Button
		if button.is_visible_in_tree() and not button.disabled and button.get_global_rect().has_point(mouse_position):
			return button
	return null


func _trigger_button_mouse_fallback(button: Button) -> bool:
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("button.fallback_trigger")
	var now := Time.get_ticks_msec()
	if now - ui_mouse_click_latch_msec < 120:
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("button.fallback_trigger")
		return true
	ui_mouse_click_latch_msec = now
	button.emit_signal("pressed")
	_play_sfx_wave("clack", 620.0, 0.035, -22.0)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("button.fallback_trigger")
	return true


func _handle_main_menu_mouse_input(event: InputEvent) -> bool:
	if game_state != STATE_MENU or menu_layer == null or not menu_layer.visible:
		return false
	if event is InputEventMouseMotion:
		var hover_index := _menu_button_index_at_position((event as InputEventMouseMotion).position)
		if hover_index >= 0 and hover_index != menu_index:
			_hover_menu_item(hover_index)
		return false
	if event is InputEventMouseButton:
		var mouse_event := event as InputEventMouseButton
		if mouse_event.button_index != MOUSE_BUTTON_LEFT or not mouse_event.pressed:
			return false
		var click_index := _menu_button_index_at_position(mouse_event.position)
		if click_index < 0:
			return false
		_hover_menu_item(click_index)
		_activate_menu_item(click_index)
		return true
	return false


func _menu_button_index_at_position(mouse_position: Vector2) -> int:
	for i in range(menu_buttons.size()):
		var button: Button = menu_buttons[i]
		if button != null and button.visible and not button.disabled and button.get_global_rect().has_point(mouse_position):
			return i
	return -1


func _handle_menu_button_gui_input(event: InputEvent, index: int) -> void:
	if game_state != STATE_MENU:
		return
	if event is InputEventMouseMotion:
		_hover_menu_item(index)
	elif event is InputEventMouseButton:
		var mouse_event := event as InputEventMouseButton
		if mouse_event.button_index == MOUSE_BUTTON_LEFT and mouse_event.pressed:
			var now := Time.get_ticks_msec()
			if now - ui_mouse_click_latch_msec < 120:
				_mark_input_as_handled()
				return
			ui_mouse_click_latch_msec = now
			_hover_menu_item(index)
			_activate_menu_item(index)
			_mark_input_as_handled()


func _hover_menu_item(index: int) -> void:
	if menu_controller != null:
		menu_index = menu_controller.select_index(index)
	else:
		menu_index = clampi(index, 0, MENU_ITEMS.size() - 1)
	_update_menu_ui()


func _activate_menu_item(index: int) -> void:
	var action := menu_controller.main_menu_action(index) if menu_controller != null else {"action": "", "index": index}
	match String(action.get("action", "")):
		"training_config":
			_show_training_config(true)
		"saved_units":
			_show_saved_units_library()
		"unit_edit":
			_show_editor()
		"show_ai_seat_panel":
			menu_index = 3
			_update_menu_ui()
		"pvp":
			_start_battle(MODE_PVP)
		"settings":
			_show_settings()
		_:
			get_tree().quit()


func _handle_scout_input(delta: float) -> void:
	if Input.is_action_just_pressed("menu_back"):
		_show_menu()
		return
	if Input.is_action_just_pressed("menu_confirm"):
		_try_begin_battle_from_scout()
		return
	if Input.is_action_just_pressed("p1_up"):
		_select_scout_relative(-1)
	elif Input.is_action_just_pressed("p1_down"):
		_select_scout_relative(1)
	_update_scout_ui()


func _try_begin_battle_from_scout() -> void:
	if pending_battle_mode == MODE_TRAINING:
		if not training_seat_confirmed:
			scout_timer = maxf(scout_timer, 8.0)
			if scout_hint_label != null:
				scout_hint_label.text = "请先点击 P1、P2 或 P3 选择训练入场席位。" if _ui_is_zh() else "Choose P1, P2, or P3 before entering training."
			_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
			_update_scout_ui()
			return
		if not _configure_training_sides_for_seat():
			scout_timer = maxf(scout_timer, 8.0)
			scout_hint_label.text = "训练入场失败：%s" % _localized_system_text(training_import_error_note) if _ui_is_zh() else "Training entry failed: %s" % training_import_error_note
			_update_scout_ui()
			return
		_begin_battle(pending_battle_mode)
		return
	_normalize_initial_sortie_for_cost(1)
	_normalize_initial_sortie_for_cost(2)
	_ensure_sortie_loadout(1)
	_ensure_sortie_loadout(2)
	var players_to_check := [1, 2] if pending_battle_mode == MODE_AI and ai_battle_seat == 3 else [1, 2]
	for player_id in players_to_check:
		var summary := _repair_ai_battle_entry_if_needed(player_id, pending_battle_mode)
		if bool(summary.get("valid", false)):
			continue
		scout_timer = maxf(scout_timer, 8.0)
		scout_hint_label.text = "P%d 出战仍不合法：%s" % [player_id, _localized_system_text(String(summary.get("note", "check starter and topology")))] if _ui_is_zh() else "P%d battle entry is not legal yet: %s" % [player_id, String(summary.get("note", "check starter and topology"))]
		_update_scout_ui()
		return
	_begin_battle(pending_battle_mode)


func _handle_editor_input() -> void:
	if Input.is_action_just_pressed("menu_back"):
		_show_menu()
		return
	if Input.is_action_just_pressed("copy_team"):
		var source_player := _editor_player()
		var target_player := 2 if source_player == 1 else 1
		blueprints[target_player] = blueprints[source_player].duplicate(true)
		active_roster_indices[target_player] = active_roster_indices[source_player].duplicate(true)
		initial_role[target_player] = initial_role[source_player]
		sortie_loadouts[target_player] = []
		initial_sortie_slot[target_player] = 0
		summon_pair_bindings[target_player] = summon_pair_bindings[source_player].duplicate(true)
		ai_team_manual_lock[target_player] = true
		editor_summary_label.text = "已将 P%d 队伍编辑配置复制到 P%d/AI。" % [source_player, target_player] if _ui_is_zh() else "Copied P%d TeamEdit roster to P%d/AI loadout." % [source_player, target_player]
		return
	for attack_key in range(1, ATTACK_GROUP_COUNT + 1):
		if Input.is_action_just_pressed("p1_attack_%d" % attack_key):
			if _tryout_editor_bound_module(attack_key):
				return
	if Input.is_action_just_pressed("editor_next_unit"):
		var player_id := _editor_player()
		var role_key_for_next: String = ROLE_ORDER[editor_role_index]
		if Array(blueprints[player_id].get(role_key_for_next, [])).is_empty():
			_reset_editor_working_canvas(role_key_for_next)
			_update_editor_ui()
			return
		editor_unit_indices[role_key_for_next] = _wrapped_index(int(editor_unit_indices[role_key_for_next]) + 1, blueprints[player_id][role_key_for_next].size())
		active_roster_indices[player_id][role_key_for_next] = int(editor_unit_indices[role_key_for_next])
		_update_editor_ui()
		return
	if Input.is_action_just_pressed("editor_add_unit"):
		_add_roster_unit()
		return
	if Input.is_action_just_pressed("editor_delete_unit"):
		_delete_roster_unit()
		return
	if Input.is_action_just_pressed("editor_set_initial"):
		editor_summary_label.text = "TeamEdit 只编辑%s队伍；首发请在战斗前的出战选择界面决定。" % _match_format_name() if _ui_is_zh() else "TeamEdit only builds the %s roster; choose starter in the pre-battle sortie screen." % _match_format_name()
		return
	if Input.is_action_just_pressed("editor_next_role"):
		editor_role_index = _wrapped_index(editor_role_index + 1, ROLE_ORDER.size())
		_update_editor_ui()
	if Input.is_action_just_pressed("p1_up"):
		editor_slot_index = _wrapped_index(editor_slot_index - 1, BUILD_SLOTS.size())
		editor_part_group_mode = _part_group_for_slot(String(BUILD_SLOTS[editor_slot_index]))
		editor_catalog_page = 0
		_update_editor_ui()
	elif Input.is_action_just_pressed("p1_down"):
		editor_slot_index = _wrapped_index(editor_slot_index + 1, BUILD_SLOTS.size())
		editor_part_group_mode = _part_group_for_slot(String(BUILD_SLOTS[editor_slot_index]))
		editor_catalog_page = 0
		_update_editor_ui()
	if Input.is_action_just_pressed("p1_left"):
		_cycle_component(-1)
	elif Input.is_action_just_pressed("p1_right"):
		_cycle_component(1)


func _handle_settings_input() -> void:
	if settings_rebind_action != "":
		if Input.is_action_just_pressed("menu_back"):
			_cancel_battle_input_rebind()
		return
	if Input.is_action_just_pressed("menu_back"):
		if settings_category != "root":
			_show_settings_category("root")
		else:
			_show_menu()
		return
	if Input.is_action_just_pressed("menu_confirm"):
		_activate_settings_item(settings_index)
		return
	if Input.is_action_just_pressed("menu_up"):
		settings_index = _wrapped_index(settings_index - 1, max(1, settings_labels.size()))
		_update_settings_ui()
	elif Input.is_action_just_pressed("menu_down"):
		settings_index = _wrapped_index(settings_index + 1, max(1, settings_labels.size()))
		_update_settings_ui()
	elif Input.is_action_just_pressed("p1_left") or Input.is_action_just_pressed("p1_right"):
		_activate_settings_item(settings_index)


func _select_settings_item(index: int) -> void:
	settings_index = clampi(index, 0, max(0, settings_labels.size() - 1))
	_update_settings_ui()


func _activate_settings_item(index: int) -> void:
	settings_index = clampi(index, 0, max(0, settings_labels.size() - 1))
	if settings_index < 0 or settings_index >= settings_labels.size():
		return
	var button: Button = settings_labels[settings_index]
	if button.has_meta("video_action"):
		match String(button.get_meta("video_action", "")):
			"performance_profile":
				_cycle_performance_profile(1)
			"display_mode":
				_cycle_display_mode_setting(1)
			"window_size":
				_cycle_window_size_setting(1)
		return
	var spec_index := int(button.get_meta("spec_index", -1))
	if spec_index < 0 or spec_index >= battle_input_binding_specs.size():
		return
	var spec: Dictionary = battle_input_binding_specs[spec_index]
	if bool(spec.get("info", false)):
		return
	_begin_battle_input_rebind(String(spec.get("action", "")))
	_update_settings_ui()


func _battle_input_specs() -> Array:
	var specs: Array = []
	for prefix in ["p1", "p2"]:
		var player_label := "P1" if prefix == "p1" else "P2"
		specs.append({"info": true, "group_title_zh": "%s 方向 / Direction" % player_label, "group_title_en": "%s DIRECTION" % player_label})
		specs.append({"action": "%s_up" % prefix, "group": "%s_direction" % prefix, "zh": "%s 上" % player_label, "en": "%s Up" % player_label})
		specs.append({"action": "%s_down" % prefix, "group": "%s_direction" % prefix, "zh": "%s 下" % player_label, "en": "%s Down" % player_label})
		specs.append({"action": "%s_left" % prefix, "group": "%s_direction" % prefix, "zh": "%s 左" % player_label, "en": "%s Left" % player_label})
		specs.append({"action": "%s_right" % prefix, "group": "%s_direction" % prefix, "zh": "%s 右" % player_label, "en": "%s Right" % player_label})
		specs.append({"info": true, "group_title_zh": "%s Boost：方向键双击，斜向按住组合后双击任一键" % player_label, "group_title_en": "%s BOOST: double-tap direction; diagonals use held combo" % player_label})
		specs.append({"info": true, "group_title_zh": "%s 转向 / Turn" % player_label, "group_title_en": "%s TURN" % player_label})
		specs.append({"action": "%s_face_left" % prefix, "group": "%s_turn" % prefix, "zh": "%s 左转" % player_label, "en": "%s Turn Left" % player_label})
		specs.append({"action": "%s_face_right" % prefix, "group": "%s_turn" % prefix, "zh": "%s 右转" % player_label, "en": "%s Turn Right" % player_label})
		specs.append({"info": true, "group_title_zh": "%s 攻击 / Attack" % player_label, "group_title_en": "%s ATTACK" % player_label})
		for attack_index in range(1, ATTACK_GROUP_COUNT + 1):
			specs.append({
				"action": "%s_attack_%d" % [prefix, attack_index],
				"group": "%s_attack" % prefix,
				"zh": "%s 攻击%d" % [player_label, attack_index],
				"en": "%s Attack %d" % [player_label, attack_index],
			})
	return specs


func _battle_input_action_group(action_name: String) -> String:
	for raw_spec in battle_input_binding_specs:
		if raw_spec is Dictionary and String(raw_spec.get("action", "")) == action_name:
			return String(raw_spec.get("group", action_name))
	return action_name


func _event_to_binding_dict(event: InputEvent) -> Dictionary:
	if event is InputEventKey:
		var key_event := event as InputEventKey
		if not key_event.pressed or key_event.echo:
			return {}
		var keycode := key_event.physical_keycode if key_event.physical_keycode != 0 else key_event.keycode
		if keycode == 0:
			return {}
		return {"type": "key", "physical_keycode": keycode}
	if event is InputEventJoypadButton:
		var button_event := event as InputEventJoypadButton
		if not button_event.pressed:
			return {}
		return {"type": "joy_button", "device": button_event.device, "button_index": button_event.button_index}
	if event is InputEventJoypadMotion:
		var motion_event := event as InputEventJoypadMotion
		if absf(motion_event.axis_value) < 0.55:
			return {}
		return {"type": "joy_axis", "device": motion_event.device, "axis": motion_event.axis, "axis_value": 1.0 if motion_event.axis_value > 0.0 else -1.0}
	return {}


func _binding_dict_to_event(binding: Dictionary):
	var kind := String(binding.get("type", ""))
	if kind == "key":
		var event := InputEventKey.new()
		event.physical_keycode = int(binding.get("physical_keycode", binding.get("keycode", 0)))
		return event
	if kind == "joy_button":
		var event := InputEventJoypadButton.new()
		event.device = int(binding.get("device", 0))
		event.button_index = int(binding.get("button_index", JOY_BUTTON_A))
		return event
	if kind == "joy_axis":
		var event := InputEventJoypadMotion.new()
		event.device = int(binding.get("device", 0))
		event.axis = int(binding.get("axis", JOY_AXIS_LEFT_X))
		event.axis_value = float(binding.get("axis_value", 1.0))
		return event
	return null


func _binding_dict_key(binding: Dictionary) -> String:
	var kind := String(binding.get("type", ""))
	if kind == "key":
		return "key:%d" % int(binding.get("physical_keycode", binding.get("keycode", 0)))
	if kind == "joy_button":
		return "joy_button:%d:%d" % [int(binding.get("device", 0)), int(binding.get("button_index", 0))]
	if kind == "joy_axis":
		var axis_sign := 1 if float(binding.get("axis_value", 1.0)) >= 0.0 else -1
		return "joy_axis:%d:%d:%d" % [int(binding.get("device", 0)), int(binding.get("axis", 0)), axis_sign]
	return ""


func _event_binding_label(binding: Dictionary) -> String:
	var kind := String(binding.get("type", ""))
	if kind == "key":
		return OS.get_keycode_string(int(binding.get("physical_keycode", binding.get("keycode", 0))))
	if kind == "joy_button":
		return "Pad%d Btn%d" % [int(binding.get("device", 0)) + 1, int(binding.get("button_index", 0))]
	if kind == "joy_axis":
		var sign_label := "+" if float(binding.get("axis_value", 1.0)) > 0.0 else "-"
		return "Pad%d Axis%d%s" % [int(binding.get("device", 0)) + 1, int(binding.get("axis", 0)), sign_label]
	return "-"


func _action_binding_label(action_name: String) -> String:
	if not InputMap.has_action(action_name):
		return "-"
	var labels: Array = []
	for event in InputMap.action_get_events(action_name):
		var binding := _event_to_binding_dict_for_existing(event)
		if not binding.is_empty():
			labels.append(_event_binding_label(binding))
		if labels.size() >= 3:
			break
	return " / ".join(labels) if not labels.is_empty() else "-"


func _event_to_binding_dict_for_existing(event: InputEvent) -> Dictionary:
	if event is InputEventKey:
		var key_event := event as InputEventKey
		var keycode := key_event.physical_keycode if key_event.physical_keycode != 0 else key_event.keycode
		return {"type": "key", "physical_keycode": keycode}
	if event is InputEventJoypadButton:
		var button_event := event as InputEventJoypadButton
		return {"type": "joy_button", "device": button_event.device, "button_index": button_event.button_index}
	if event is InputEventJoypadMotion:
		var motion_event := event as InputEventJoypadMotion
		return {"type": "joy_axis", "device": motion_event.device, "axis": motion_event.axis, "axis_value": 1.0 if motion_event.axis_value > 0.0 else -1.0}
	return {}


func _save_battle_input_bindings() -> void:
	var payload := {"schema_version": 1, "bindings": {}}
	for raw_spec in battle_input_binding_specs:
		if not (raw_spec is Dictionary):
			continue
		var action_name := String(Dictionary(raw_spec).get("action", ""))
		if action_name == "" or not InputMap.has_action(action_name):
			continue
		var bindings: Array = []
		for event in InputMap.action_get_events(action_name):
			var binding := _event_to_binding_dict_for_existing(event)
			if not binding.is_empty():
				bindings.append(binding)
		payload["bindings"][action_name] = bindings
	var file := FileAccess.open(BATTLE_INPUT_BINDINGS_PATH, FileAccess.WRITE)
	if file != null:
		file.store_string(JSON.stringify(payload, "\t"))


func _load_battle_input_bindings() -> void:
	if not FileAccess.file_exists(BATTLE_INPUT_BINDINGS_PATH):
		return
	var parsed = JSON.parse_string(FileAccess.get_file_as_string(BATTLE_INPUT_BINDINGS_PATH))
	if not (parsed is Dictionary):
		return
	var bindings: Dictionary = parsed.get("bindings", {})
	for action_name in bindings.keys():
		if not InputMap.has_action(String(action_name)):
			InputMap.add_action(String(action_name))
		for event in InputMap.action_get_events(String(action_name)):
			InputMap.action_erase_event(String(action_name), event)
		for binding in Array(bindings[action_name]):
			if not (binding is Dictionary):
				continue
			var event: InputEvent = _binding_dict_to_event(binding)
			if event != null:
				InputMap.action_add_event(String(action_name), event)


func _reset_battle_input_bindings_to_default() -> void:
	if FileAccess.file_exists(BATTLE_INPUT_BINDINGS_PATH):
		DirAccess.remove_absolute(BATTLE_INPUT_BINDINGS_PATH)
	_bind_player_inputs("p1", 0, true)
	_bind_player_inputs("p2", 1, false)
	battle_input_binding_specs = _battle_input_specs()
	settings_rebind_action = ""
	_update_settings_ui()


func _begin_battle_input_rebind(action_name: String) -> void:
	if action_name == "":
		return
	settings_rebind_action = action_name
	if settings_rebind_status_label != null:
		settings_rebind_status_label.text = "按下键盘键或手柄输入..." if _ui_is_zh() else "Press a key or controller input..."
		settings_rebind_status_label.modulate = Color(1.0, 0.86, 0.28, 1.0)
	_update_settings_ui()


func _cancel_battle_input_rebind() -> void:
	settings_rebind_action = ""
	if settings_rebind_status_label != null:
		settings_rebind_status_label.text = "已取消" if _ui_is_zh() else "Canceled"
		settings_rebind_status_label.modulate = Color(0.9, 0.94, 1.0, 0.86)
	_update_settings_ui()


func _remove_binding_conflicts(action_name: String, binding: Dictionary) -> void:
	var target_group := _battle_input_action_group(action_name)
	var binding_key := _binding_dict_key(binding)
	if binding_key == "":
		return
	for raw_spec in battle_input_binding_specs:
		if not (raw_spec is Dictionary):
			continue
		var spec: Dictionary = raw_spec
		var other_action := String(spec.get("action", ""))
		if other_action == "" or other_action == action_name:
			continue
		if String(spec.get("group", "")) != target_group:
			continue
		if not InputMap.has_action(other_action):
			continue
		for event in InputMap.action_get_events(other_action):
			var existing := _event_to_binding_dict_for_existing(event)
			if _binding_dict_key(existing) == binding_key:
				InputMap.action_erase_event(other_action, event)


func _handle_battle_input_rebind_event(event: InputEvent) -> bool:
	if settings_rebind_action == "":
		return false
	if event is InputEventMouseButton:
		return false
	if event is InputEventKey:
		var key_event := event as InputEventKey
		var keycode := key_event.physical_keycode if key_event.physical_keycode != 0 else key_event.keycode
		if key_event.pressed and not key_event.echo and keycode == KEY_ESCAPE:
			_cancel_battle_input_rebind()
			return true
	var binding := _event_to_binding_dict(event)
	if binding.is_empty():
		return false
	if not InputMap.has_action(settings_rebind_action):
		InputMap.add_action(settings_rebind_action)
	_remove_binding_conflicts(settings_rebind_action, binding)
	for existing_event in InputMap.action_get_events(settings_rebind_action):
		InputMap.action_erase_event(settings_rebind_action, existing_event)
	var input_event: InputEvent = _binding_dict_to_event(binding)
	if input_event != null:
		InputMap.action_add_event(settings_rebind_action, input_event)
	_save_battle_input_bindings()
	if settings_rebind_status_label != null:
		settings_rebind_status_label.text = ("已绑定：%s" % _event_binding_label(binding)) if _ui_is_zh() else ("Bound: %s" % _event_binding_label(binding))
		settings_rebind_status_label.modulate = Color(0.45, 1.0, 0.62, 1.0)
	settings_rebind_action = ""
	_update_settings_ui()
	return true


func _cycle_component(direction: int) -> void:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var slot_key: String = BUILD_SLOTS[editor_slot_index]
	var catalog: Array = _catalog_for(role_key, slot_key)
	var unit_bp: Dictionary = _editor_current_blueprint()
	var current_archetype := String(unit_bp.get("archetype", "crab"))
	for archetype_key in editor_archetype_buttons.keys():
		var frame_button: Button = editor_archetype_buttons[archetype_key]
		frame_button.modulate = Color(0.32, 0.95, 1.0, 1.0) if archetype_key == current_archetype and _role_uses_body_board(role_key) else Color(0.86, 0.9, 0.94, 1.0)
		frame_button.disabled = not _role_uses_body_board(role_key)
	if _role_uses_body_board(role_key) and unit_bp.has("custom_topology") and _is_body_group_slot(slot_key):
		if _is_topology_part_slot(slot_key):
			var next_index := _wrapped_index(int(unit_bp.get(slot_key, 0)) + direction, catalog.size())
			_set_pending_canvas_part(unit_bp, slot_key, next_index)
			editor_board_hint_label.text = "已选择：%s。可直接拖卡片进画布，也可点击画布放置/替换。" % _pending_canvas_part_name(role_key)
			_play_sfx_wave("clack", 640.0, 0.04, -18.0)
			ai_team_manual_lock[player_id] = true
			_mark_editor_board_interaction_dirty("shop.pending_part", false)
			return
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		var nodes: Array = topology.get("nodes", [])
		if not nodes.is_empty():
			editor_topology_node_index = clampi(editor_topology_node_index, 0, nodes.size() - 1)
			var node: Dictionary = nodes[editor_topology_node_index]
			var next_node_index := _wrapped_index(int(node.get(slot_key, unit_bp.get(slot_key, 0))) + direction, catalog.size())
			node = _set_topology_node_slot(node, slot_key, next_node_index)
			nodes[editor_topology_node_index] = node
			topology["nodes"] = nodes
			unit_bp["custom_topology"] = topology
			_trigger_editor_snap("node", String(catalog[next_node_index].get("name", "")))
			ai_team_manual_lock[player_id] = true
			_update_editor_ui()
			return
	unit_bp[slot_key] = _wrapped_index(int(unit_bp.get(slot_key, 0)) + direction, catalog.size())
	ai_team_manual_lock[player_id] = true
	_update_editor_ui()


func _select_editor_body_part(part_key: String) -> void:
	editor_selected_body_part = part_key
	editor_snap_timer = 0.12
	editor_snap_part = part_key
	_update_editor_ui()


func _role_uses_body_board(role_key: String) -> bool:
	return role_key in ["hero", "puppet", "barrier"]


func _is_body_group_slot(slot_key: String) -> bool:
	return BODY_GROUP_SLOTS.has(slot_key)


func _is_topology_part_slot(slot_key: String) -> bool:
	return TOPOLOGY_PART_SLOTS.has(slot_key)


func _topology_node_is_component(node: Dictionary) -> bool:
	return node.has("slot") and _is_topology_part_slot(String(node.get("slot", "")))


func _topology_uses_component_nodes(nodes: Array) -> bool:
	for node in nodes:
		if node is Dictionary and _topology_node_is_component(node):
			return true
	return false


func _topology_node_slot(node: Dictionary) -> String:
	return String(node.get("slot", ""))


func _topology_slot_family(slot_key: String) -> String:
	if slot_key == "joint":
		return "legacy_joint"
	if slot_key == "limb_muscle" or slot_key == "muscle":
		return "muscle"
	return "other"


func _topology_node_part_index(node: Dictionary, unit_bp: Dictionary) -> int:
	var slot_key := _topology_node_slot(node)
	if slot_key == "":
		return 0
	return int(node.get("part_index", node.get(slot_key, unit_bp.get(slot_key, 0))))


func _topology_node_resolved_part_index(role_key: String, node: Dictionary, unit_bp: Dictionary) -> int:
	var slot_key := _topology_node_slot(node)
	if slot_key == "":
		return 0
	var saved_name := String(node.get("part_name", node.get("component_name", ""))).strip_edges()
	if saved_name != "":
		var resolved := _component_index_by_exact_name(role_key, slot_key, saved_name)
		if resolved >= 0:
			return resolved
	return _topology_node_part_index(node, unit_bp)


func _topology_node_part(role_key: String, node: Dictionary, unit_bp: Dictionary) -> Dictionary:
	var slot_key := _topology_node_slot(node)
	if not _is_topology_part_slot(slot_key):
		return {}
	var part := _selected_component(role_key, slot_key, _topology_node_resolved_part_index(role_key, node, unit_bp))
	for override_key in [
		"embedded_joint_kind",
		"embedded_joint_angle",
		"embedded_joint_extension",
		"embedded_joint_output_momentum",
		"embedded_joint_momentum_capacity",
		"terminal_weapon_kind",
	]:
		if node.has(override_key):
			part[override_key] = node[override_key]
	return part


func _topology_node_is_torso(role_key: String, node: Dictionary, unit_bp: Dictionary) -> bool:
	if not _topology_node_is_component(node):
		return false
	var slot_key := _topology_node_slot(node)
	if slot_key != "muscle":
		return false
	return _component_is_torso(_topology_node_part(role_key, node, unit_bp))


func _topology_torso_nodes(unit_bp: Dictionary) -> Array:
	var result: Array = []
	var role_key: String = String(unit_bp.get("role", ROLE_ORDER[editor_role_index]))
	if not unit_bp.has("custom_topology"):
		return result
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	for i in range(nodes.size()):
		if nodes[i] is Dictionary and _topology_node_is_torso(role_key, nodes[i], unit_bp):
			result.append(i)
	return result


func _first_torso_node_index(unit_bp: Dictionary) -> int:
	var torsos := _topology_torso_nodes(unit_bp)
	return int(torsos[0]) if not torsos.is_empty() else -1


func _active_torso_node_index_for_payload_install(unit_bp: Dictionary) -> int:
	var torsos := _topology_torso_nodes(unit_bp)
	if torsos.is_empty():
		return -1
	if torsos.has(editor_open_torso_node_index):
		return editor_open_torso_node_index
	var role_key: String = String(unit_bp.get("role", ROLE_ORDER[editor_role_index]))
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if editor_topology_node_index >= 0 and editor_topology_node_index < nodes.size() and _topology_node_is_torso(role_key, nodes[editor_topology_node_index], unit_bp):
		return editor_topology_node_index
	return int(torsos[0])


func _torso_payload_belongs_to_node(payload: Dictionary, torso_node_index: int, unit_bp: Dictionary) -> bool:
	if torso_node_index < 0:
		return false
	if payload.has("torso_node"):
		return int(payload.get("torso_node", -1)) == torso_node_index
	return torso_node_index == _first_torso_node_index(unit_bp)


func _payload_torso_node_index(payload: Dictionary, unit_bp: Dictionary) -> int:
	if payload.has("torso_node"):
		return int(payload.get("torso_node", -1))
	return _first_torso_node_index(unit_bp)


func _topology_owner_torso_node_for_node(role_key: String, unit_bp: Dictionary, node_index: int) -> int:
	if not unit_bp.has("custom_topology"):
		return -1
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", []))
	var edges: Array = Array(topology.get("edges", []))
	if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
		return -1
	if _topology_node_is_torso(role_key, nodes[node_index], unit_bp):
		return node_index
	var current := node_index
	var guard := 0
	while current >= 0 and current < nodes.size() and guard < 32:
		guard += 1
		var parent_info := _topology_parent_edge_info(role_key, unit_bp, nodes, edges, current)
		if parent_info.is_empty():
			break
		var parent_index := int(parent_info.get("parent", -1))
		if parent_index < 0 or parent_index >= nodes.size():
			break
		if _topology_node_is_torso(role_key, nodes[parent_index], unit_bp):
			return parent_index
		current = parent_index
	var component := _topology_connected_component_indices(edges, nodes.size(), [node_index])
	for raw_index in component:
		var index := int(raw_index)
		if index >= 0 and index < nodes.size() and nodes[index] is Dictionary and _topology_node_is_torso(role_key, nodes[index], unit_bp):
			return index
	return _first_torso_node_index(unit_bp)


func _module_binding_torso_node_index(role_key: String, unit_bp: Dictionary, binding: Dictionary) -> int:
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", []))
	var explicit_torso := int(binding.get("target_torso_node", -1))
	if explicit_torso >= 0 and explicit_torso < nodes.size() and nodes[explicit_torso] is Dictionary and _topology_node_is_torso(role_key, nodes[explicit_torso], unit_bp):
		return explicit_torso
	for raw_node in Array(binding.get("target_nodes", [])):
		var owner := _topology_owner_torso_node_for_node(role_key, unit_bp, int(raw_node))
		if owner >= 0:
			return owner
	return -1


func _torso_payload_slot_group(payload_kind: String) -> String:
	if payload_kind in ["special", "module"]:
		return "software"
	return "plugin"


func _payload_is_software(payload: Dictionary) -> bool:
	return _torso_payload_slot_group(String(payload.get("kind", ""))) == "software"


func _torso_size_rank_for_slots(part: Dictionary) -> int:
	return _size_tier_rank(_part_size_tier_label(part, "muscle"))


func _torso_baseline_slot_capacity(part: Dictionary, group_kind: String) -> int:
	var rank := _torso_size_rank_for_slots(part)
	if rank <= 1:
		return 3
	if rank == 2:
		return 4
	if rank == 3:
		return 5
	if rank == 4:
		return 6
	return 8 if group_kind == "plugin" else 7


func _torso_plugin_capacity_for_part(part: Dictionary) -> int:
	var cap := int(part.get("torso_slots", 0))
	if cap <= 0:
		cap = int(part.get("engine_slots", 0)) + int(part.get("cooling_slots", 0)) + int(part.get("booster_slots", 0)) + int(part.get("spare_weapon_slots", 0))
	cap = maxi(cap, _torso_baseline_slot_capacity(part, "plugin"))
	return clampi(cap + 1, 1, 12)


func _torso_software_capacity_for_part(part: Dictionary) -> int:
	var cap := int(part.get("module_slots", 0))
	cap = maxi(cap, _torso_baseline_slot_capacity(part, "software"))
	if _component_is_brain_torso(part):
		cap = maxi(cap, 8)
	return clampi(cap + 1, 1, 12)


func _payload_part_for_payload(role_key: String, payload: Dictionary) -> Dictionary:
	var payload_kind := String(payload.get("kind", ""))
	var saved_name := String(payload.get("part_name", payload.get("component_name", ""))).strip_edges()
	var saved_slot := ""
	match payload_kind:
		"special":
			saved_slot = "special"
			if saved_name != "":
				var special_index := _component_index_by_exact_name(role_key, saved_slot, saved_name)
				if special_index >= 0:
					return _selected_component(role_key, saved_slot, special_index)
			return _selected_component(role_key, "special", int(payload.get("special", 0)))
		"module":
			saved_slot = "module"
			if saved_name != "":
				var module_index := _component_index_by_exact_name(role_key, saved_slot, saved_name)
				if module_index >= 0:
					return _selected_component(role_key, saved_slot, module_index)
			return _selected_component(role_key, "module", int(payload.get("module", 0)))
		"engine":
			saved_slot = "engine"
			if saved_name != "":
				var engine_index := _component_index_by_exact_name(role_key, saved_slot, saved_name)
				if engine_index >= 0:
					return _selected_component(role_key, saved_slot, engine_index)
			return _selected_component(role_key, "engine", int(payload.get("engine", 0)))
		"booster":
			saved_slot = "booster"
			if saved_name != "":
				var booster_index := _component_index_by_exact_name(role_key, saved_slot, saved_name)
				if booster_index >= 0:
					return _selected_component(role_key, saved_slot, booster_index)
			return _selected_component(role_key, "booster", int(payload.get("booster", 0)))
		"cooling":
			saved_slot = "cooling"
			if saved_name != "":
				var cooling_index := _component_index_by_exact_name(role_key, saved_slot, saved_name)
				if cooling_index >= 0:
					return _selected_component(role_key, saved_slot, cooling_index)
			return _selected_component(role_key, "cooling", int(payload.get("cooling", 0)))
		"ammo":
			saved_slot = "muscle"
			var ammo_part := _selected_component(role_key, "muscle", int(payload.get("muscle", 0)))
			if saved_name != "":
				var ammo_index := _component_index_by_exact_name(role_key, saved_slot, saved_name)
				if ammo_index >= 0:
					ammo_part = _selected_component(role_key, saved_slot, ammo_index)
			return _ammo_payload_variant(ammo_part, payload.get("ammo_size_tier", "XS"))
		"electronic_armor", "escape_pod", "spare_weapon":
			saved_slot = "muscle"
			if saved_name != "":
				var muscle_index := _component_index_by_exact_name(role_key, saved_slot, saved_name)
				if muscle_index >= 0:
					return _selected_component(role_key, saved_slot, muscle_index)
			return _selected_component(role_key, "muscle", int(payload.get("muscle", 0)))
		_:
			saved_slot = String(payload.get("slot", "muscle"))
			if saved_name != "":
				var generic_index := _component_index_by_exact_name(role_key, saved_slot, saved_name)
				if generic_index >= 0:
					return _selected_component(role_key, saved_slot, generic_index)
			return _selected_component(role_key, saved_slot, int(payload.get("index", 0)))


func _payload_icon_style(payload_kind: String, part: Dictionary) -> Dictionary:
	var color := Color(0.28, 0.92, 1.0, 1.0)
	match payload_kind:
		"engine":
			color = Color(0.62, 0.48, 1.0, 1.0)
		"cooling":
			color = Color(0.28, 1.0, 0.72, 1.0)
		"booster":
			color = Color(1.0, 0.48, 0.18, 1.0)
		"ammo":
			var ammo_type := String(part.get("damage_type", part.get("projectile_damage_type", "bullet"))).to_lower()
			match ammo_type:
				"bullet":
					color = Color(1.0, 0.18, 0.12, 1.0)
				"chemical":
					color = Color(1.0, 0.88, 0.12, 1.0)
				"explosive":
					color = Color(1.0, 0.44, 0.12, 1.0)
				"web":
					color = Color(0.72, 0.62, 1.0, 1.0)
				_:
					color = Color(0.22, 0.82, 1.0, 1.0)
		"electronic_armor":
			color = Color(0.36, 0.96, 1.0, 1.0)
		"special":
			var special_kind := String(part.get("kind", "")).to_lower()
			color = Color(1.0, 0.86, 0.24, 1.0) if special_kind == "soul" else (Color(0.42, 1.0, 0.62, 1.0) if special_kind == "code" else Color(0.72, 0.42, 1.0, 1.0))
		"module":
			color = Color(0.92, 0.94, 0.9, 1.0)
		"escape_pod":
			color = Color(0.88, 0.88, 1.0, 1.0)
	return {"kind": payload_kind, "color": color}


func _payload_detail_line(payload_kind: String, part: Dictionary) -> String:
	match payload_kind:
		"engine":
			return ("动力 %.0f  质量 %.0f" if _ui_is_zh() else "PWR %.0f  M %.0f") % [_engine_momentum_output_for_part(part), float(part.get("mass", 0.0))]
		"cooling":
			return ("散热 %.0f  池 %.0f" if _ui_is_zh() else "COOL %.0f  CAP %.0f") % [_cooling_rate_for_part(part), _cooling_heat_capacity_for_part(part)]
		"booster":
			return ("需求 %.0f  质量 %.0f" if _ui_is_zh() else "REQ %.0f  M %.0f") % [_thruster_drive_demand_for_part(part), float(part.get("mass", 0.0))]
		"ammo":
			var caps: Dictionary = part.get("ammo_capacity", {})
			var total_ammo := 0
			for ammo_type in AMMO_TYPES:
				total_ammo += int(caps.get(ammo_type, 0))
			return ("弹药 %s 发%d 质量%.0f" if _ui_is_zh() else "AMMO %s x%d M%.0f") % [String(part.get("ammo_size_tier", part.get("slot_volume_tier", "XS"))), total_ammo, float(part.get("mass", 0.0))]
		"electronic_armor":
			return ("护盾 %.0f  回复 %.1f" if _ui_is_zh() else "SH %.0f  REG %.1f") % [float(part.get("shield_hp", part.get("electronic_armor_hp", 0.0))), float(part.get("shield_regen", part.get("electronic_armor_regen", 0.0)))]
		"special":
			return String(part.get("kind", "software")).to_upper()
		"module":
			return _trim_text(String(part.get("command", part.get("module_effect", "action"))), 22)
	return ("价 %d  质 %.0f" if _ui_is_zh() else "C %d  M %.0f") % [int(part.get("cost", 0)), float(part.get("mass", 0.0))]


func _module_binding_for_payload_index(unit_bp: Dictionary, payload_index: int) -> Dictionary:
	for raw_binding in Array(unit_bp.get("module_bindings", [])):
		if raw_binding is Dictionary and int(Dictionary(raw_binding).get("software_slot_index", -1)) == payload_index:
			return Dictionary(raw_binding)
	return {}


func _module_binding_target_label(role_key: String, unit_bp: Dictionary, binding: Dictionary) -> String:
	if String(binding.get("target_kind", "limb")) == "torso":
		return "躯干" if _ui_is_zh() else "TORSO"
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var names: Array = []
	for raw_index in Array(binding.get("target_nodes", [])):
		var node_index := int(raw_index)
		if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
			continue
		var node: Dictionary = nodes[node_index]
		names.append(_short_part_name(String(node.get("label", node.get("part_name", "N%d" % (node_index + 1))))))
		if names.size() >= 2:
			break
	if names.is_empty():
		return "失效目标" if _ui_is_zh() else "STALE TARGET"
	var joined := ""
	for i in range(names.size()):
		if i > 0:
			joined += "+"
		joined += String(names[i])
	return joined


func _module_binding_status_for_payload(unit_bp: Dictionary, payload_index: int, payload: Dictionary, part: Dictionary) -> Dictionary:
	if String(payload.get("kind", "")) != "module":
		return {"valid": true, "bound": false, "line": _payload_detail_line("module", part)}
	if not _module_requires_execution_binding(part):
		return {"valid": true, "bound": false, "line": _payload_detail_line("module", part)}
	var role_key: String = String(unit_bp.get("role", ROLE_ORDER[editor_role_index]))
	var binding := _module_binding_for_payload_index(unit_bp, payload_index)
	if binding.is_empty():
		return {
			"valid": false,
			"bound": false,
			"line": "未绑定：点重绑" if _ui_is_zh() else "UNBOUND: rebind",
			"reason": "missing binding",
		}
	var attack_key := clampi(int(binding.get("attack_key", 0)), 1, ATTACK_GROUP_COUNT)
	var target_label := _module_binding_target_label(role_key, unit_bp, binding)
	var invalid_reason := _module_binding_invalid_reason(unit_bp, payload_index, payload, part, binding)
	var ok := invalid_reason == ""
	var line := ("键 %d%s  %s" if _ui_is_zh() else "KEY %d%s  %s") % [attack_key, _attack_key_label(attack_key), target_label]
	if not ok:
		line = ("失效 %d%s：%s" if _ui_is_zh() else "STALE %d%s: %s") % [attack_key, _attack_key_label(attack_key), _trim_text(invalid_reason, 18)]
	return {
		"valid": ok,
		"bound": true,
		"line": line,
		"reason": invalid_reason,
	}


func _module_binding_invalid_reason(unit_bp: Dictionary, payload_index: int, payload: Dictionary, module_part: Dictionary, binding: Dictionary) -> String:
	if int(binding.get("software_slot_index", -1)) != payload_index:
		return "module slot mismatch"
	if int(binding.get("module_index", payload.get("module", -999))) != int(payload.get("module", -999)):
		return "module payload changed"
	if not unit_bp.has("custom_topology"):
		return "missing topology"
	var role_key: String = String(unit_bp.get("role", ROLE_ORDER[editor_role_index]))
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", []))
	var target_nodes: Array = Array(binding.get("target_nodes", []))
	if target_nodes.is_empty():
		return "missing target"
	var min_bound_nodes := int(module_part.get("min_bound_nodes", 0))
	if min_bound_nodes > 0 and target_nodes.size() < min_bound_nodes:
		return "needs at least %d bound limb segments" % min_bound_nodes
	for raw_index in target_nodes:
		var node_index := int(raw_index)
		if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
			return "target part removed"
	if String(binding.get("target_kind", "limb")) == "torso":
		return "" if String(module_part.get("module_target_kind", "")) == "torso" else "needs limb target"
	var root_index := int(target_nodes[0])
	if root_index < 0 or root_index >= nodes.size():
		return "target part removed"
	var test_unit: Dictionary = unit_bp.duplicate(true)
	var test_topology: Dictionary = topology.duplicate(true)
	var test_nodes: Array = nodes.duplicate(true)
	var module_index := int(payload.get("module", binding.get("module_index", 0)))
	var root_node: Dictionary = Dictionary(test_nodes[root_index]).duplicate(true)
	var modules: Array = Array(root_node.get("modules", []))
	if not modules.has(module_index):
		modules.append(module_index)
	root_node["modules"] = modules
	root_node["module"] = int(modules[0])
	root_node["attack_key"] = clampi(int(binding.get("attack_key", 1)), 1, ATTACK_GROUP_COUNT)
	test_nodes[root_index] = root_node
	test_topology["nodes"] = test_nodes
	test_unit["custom_topology"] = test_topology
	var attack_nodes := _component_topology_attack_nodes(role_key, test_unit, false)
	for attack_node in attack_nodes:
		if not (attack_node is Dictionary):
			continue
		var attack_dict: Dictionary = attack_node
		if int(attack_dict.get("source_embedded_joint_node", -999)) != root_index:
			continue
		if not _module_indices_for_topology_node(attack_dict, test_unit).has(module_index):
			continue
		return _module_execution_invalid_reason(module_part, attack_dict, role_key, test_unit)
	return "target does not execute"


func _make_torso_payload_for_part(payload_kind: String, slot_key: String, part_index: int, part: Dictionary) -> Dictionary:
	var payload := {"kind": payload_kind, "part_name": String(part.get("name", ""))}
	match payload_kind:
		"ammo":
			payload["muscle"] = part_index
			payload["ammo_size_tier"] = _volume_rank_label(float(editor_ammo_size_rank))
		"electronic_armor", "escape_pod":
			payload["muscle"] = part_index
		"special":
			payload["special"] = part_index
			payload["software_kind"] = String(part.get("kind", "software"))
		"module":
			payload["module"] = part_index
		"engine":
			payload["engine"] = part_index
		"booster":
			payload["booster"] = part_index
		"cooling":
			payload["cooling"] = part_index
		_:
			payload["slot"] = slot_key
			payload["index"] = part_index
	return payload


func _torso_plugin_payload_slot_assignment(unit_bp: Dictionary, torso_node_index: int, torso_part: Dictionary) -> Dictionary:
	var assignments := {}
	var occupied := {}
	var slot_sizes := _torso_internal_slot_size_ranks(torso_part)
	var role_key: String = String(unit_bp.get("role", ROLE_ORDER[editor_role_index]))
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	for i in range(payloads.size()):
		if not (payloads[i] is Dictionary):
			continue
		var payload: Dictionary = payloads[i]
		if not _torso_payload_belongs_to_node(payload, torso_node_index, unit_bp):
			continue
		var payload_kind := String(payload.get("kind", ""))
		if _torso_payload_slot_group(payload_kind) != "plugin":
			continue
		var part := _payload_part_for_payload(role_key, payload)
		var payload_rank := _volume_rank_from_value(_payload_slot_volume_rank(payload_kind, part, payload, _payload_slot_key_for_kind(payload_kind)), 1)
		var requested := int(payload.get("internal_slot_index", -1))
		var slot_index := _best_internal_slot_for_payload(slot_sizes, occupied, payload_rank, requested)
		assignments[i] = slot_index
		if slot_index >= 0:
			occupied[slot_index] = true
	return assignments


func _find_internal_slot_for_payload(unit_bp: Dictionary, torso_node_index: int, torso_part: Dictionary, payload_kind: String, part: Dictionary, payload: Dictionary, requested_slot: int = -1) -> int:
	var assignments := _torso_plugin_payload_slot_assignment(unit_bp, torso_node_index, torso_part)
	var occupied := {}
	for raw_slot in assignments.values():
		var slot_index := int(raw_slot)
		if slot_index >= 0:
			occupied[slot_index] = true
	var slot_sizes := _torso_internal_slot_size_ranks(torso_part)
	var payload_rank := _volume_rank_from_value(_payload_slot_volume_rank(payload_kind, part, payload, _payload_slot_key_for_kind(payload_kind)), 1)
	return _best_internal_slot_for_payload(slot_sizes, occupied, payload_rank, requested_slot)


func _torso_booster_payload_count(unit_bp: Dictionary, torso_node_index: int, ignored_payload_index: int = -1) -> int:
	var count := 0
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	for i in range(payloads.size()):
		if i == ignored_payload_index or not (payloads[i] is Dictionary):
			continue
		var payload: Dictionary = payloads[i]
		if String(payload.get("kind", "")) != "booster":
			continue
		if _torso_payload_belongs_to_node(payload, torso_node_index, unit_bp):
			count += 1
	return count


func _torso_detail_display_entries(unit_bp: Dictionary, torso_node_index: int, group_kind: String, capacity: int, torso_part: Dictionary) -> Array:
	var display: Array = []
	if group_kind == "plugin":
		var slot_sizes := _torso_internal_slot_size_ranks(torso_part)
		for i in range(capacity):
			var label := _volume_rank_label(float(slot_sizes[i])) if i < slot_sizes.size() else "-"
			display.append({"empty": true, "slot_size_label": label})
		var assignments := _torso_plugin_payload_slot_assignment(unit_bp, torso_node_index, torso_part)
		var occupied_entries := _torso_plugin_slot_summary(unit_bp, torso_node_index)
		for entry in occupied_entries:
			if not (entry is Dictionary):
				continue
			var shown: Dictionary = Dictionary(entry).duplicate(true)
			var payload_index := int(shown.get("payload_index", -1))
			var slot_index := int(assignments.get(payload_index, -1))
			if slot_index >= 0 and slot_index < display.size():
				shown["slot_size_label"] = _volume_rank_label(float(slot_sizes[slot_index]))
				display[slot_index] = shown
			else:
				shown["slot_size_label"] = "!"
				display.append(shown)
		return display
	var occupied := _torso_software_slot_summary(unit_bp, torso_node_index)
	for i in range(capacity):
		if i < occupied.size() and occupied[i] is Dictionary:
			display.append(Dictionary(occupied[i]).duplicate(true))
		else:
			display.append({"empty": true})
	for i in range(capacity, occupied.size()):
		if occupied[i] is Dictionary:
			display.append(Dictionary(occupied[i]).duplicate(true))
	return display


func _torso_internal_slot_status_for_unit(role_key: String, unit_bp: Dictionary) -> Dictionary:
	var status := {
		"invalid": "",
		"max_installed_rank": 0,
		"max_empty_rank": 0,
		"slot_count": 0,
	}
	if not unit_bp.has("custom_topology"):
		return status
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	for node_index in range(nodes.size()):
		if not _topology_node_is_torso(role_key, nodes[node_index], unit_bp):
			continue
		var torso_part := _topology_node_part(role_key, nodes[node_index], unit_bp)
		var slot_sizes := _torso_internal_slot_size_ranks(torso_part)
		status["slot_count"] = int(status.get("slot_count", 0)) + slot_sizes.size()
		var booster_count := _torso_booster_payload_count(unit_bp, node_index)
		if booster_count > 1 and String(status.get("invalid", "")) == "":
			status["invalid"] = "INVALID: torso has %d/1 boosters." % booster_count
		var assignments := _torso_plugin_payload_slot_assignment(unit_bp, node_index, torso_part)
		var occupied := {}
		for raw_payload_index in assignments.keys():
			var payload_index := int(raw_payload_index)
			var slot_index := int(assignments[raw_payload_index])
			var payloads: Array = Array(unit_bp.get("slot_payloads", []))
			if payload_index < 0 or payload_index >= payloads.size() or not (payloads[payload_index] is Dictionary):
				continue
			var payload: Dictionary = payloads[payload_index]
			var payload_kind := String(payload.get("kind", ""))
			var payload_part := _payload_part_for_payload(role_key, payload)
			var payload_rank := _volume_rank_from_value(_payload_slot_volume_rank(payload_kind, payload_part, payload, _payload_slot_key_for_kind(payload_kind)), 1)
			status["max_installed_rank"] = maxi(int(status.get("max_installed_rank", 0)), payload_rank)
			if slot_index < 0:
				status["invalid"] = "INVALID: internal plugin %s size %s has no compatible empty slot." % [String(payload_part.get("name", payload_kind)), _volume_rank_label(float(payload_rank))]
				continue
			occupied[slot_index] = true
			if payload_rank > int(slot_sizes[slot_index]):
				status["invalid"] = "INVALID: internal plugin %s size %s exceeds slot %s." % [String(payload_part.get("name", payload_kind)), _volume_rank_label(float(payload_rank)), _volume_rank_label(float(slot_sizes[slot_index]))]
		for i in range(slot_sizes.size()):
			if not bool(occupied.get(i, false)):
				status["max_empty_rank"] = maxi(int(status.get("max_empty_rank", 0)), int(slot_sizes[i]))
	return status


func _torso_payload_entries(unit_bp: Dictionary, torso_node_index: int, group_kind: String) -> Array:
	var entries: Array = []
	var role_key: String = String(unit_bp.get("role", ROLE_ORDER[editor_role_index]))
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	for i in range(payloads.size()):
		if not (payloads[i] is Dictionary):
			continue
		var payload: Dictionary = payloads[i]
		if not _torso_payload_belongs_to_node(payload, torso_node_index, unit_bp):
			continue
		var payload_kind := String(payload.get("kind", ""))
		if _torso_payload_slot_group(payload_kind) != group_kind:
			continue
		var part := _payload_part_for_payload(role_key, payload)
		var style := _payload_icon_style(payload_kind, part)
		var payload_rank := _payload_slot_volume_rank(payload_kind, part, payload, _payload_slot_key_for_kind(payload_kind))
		var line := _payload_detail_line(payload_kind, part)
		var binding_invalid := false
		var can_rebind := false
		var rebind_label := ""
		if payload_kind == "module" and _module_requires_execution_binding(part):
			var binding_status := _module_binding_status_for_payload(unit_bp, i, payload, part)
			line = String(binding_status.get("line", line))
			binding_invalid = not bool(binding_status.get("valid", true))
			can_rebind = true
			rebind_label = "重绑" if _ui_is_zh() else "BIND"
		entries.append({
			"payload_index": i,
			"kind": payload_kind,
			"name": _zh_part_name(String(part.get("name", payload_kind))) if _ui_is_zh() else String(part.get("name", payload_kind)),
			"line": line,
			"color": style.get("color", Color(0.28, 0.92, 1.0, 1.0)),
			"payload_size_label": _volume_rank_label(payload_rank),
			"can_rebind": can_rebind,
			"rebind_label": rebind_label,
			"binding_invalid": binding_invalid,
		})
	return entries


func _torso_plugin_slot_summary(unit_bp: Dictionary, torso_node_index: int) -> Array:
	return _torso_payload_entries(unit_bp, torso_node_index, "plugin")


func _torso_software_slot_summary(unit_bp: Dictionary, torso_node_index: int) -> Array:
	return _torso_payload_entries(unit_bp, torso_node_index, "software")


func _engine_allocation_sorted_binding_refs(unit_bp: Dictionary) -> Array:
	var refs: Array = []
	var bindings: Array = Array(unit_bp.get("module_bindings", []))
	for i in range(bindings.size()):
		if not (bindings[i] is Dictionary):
			continue
		var binding: Dictionary = bindings[i]
		refs.append({
			"index": i,
			"slot": int(binding.get("software_slot_index", 999999)),
			"binding": binding,
		})
	refs.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return int(a.get("slot", 999999)) < int(b.get("slot", 999999))
	)
	return refs


func _engine_allocation_segment_by_node(stats: Dictionary) -> Dictionary:
	var result := {}
	for raw_segment in Array(stats.get("runtime_topology_segments", [])):
		if not (raw_segment is Dictionary):
			continue
		var segment: Dictionary = raw_segment
		result[int(segment.get("node_index", -9999))] = segment
	return result


func _engine_allocation_pool_for_torso(unit_bp: Dictionary, torso_node_index: int) -> float:
	var role_key: String = String(unit_bp.get("role", ROLE_ORDER[editor_role_index]))
	var total := 0.0
	for raw_payload in Array(unit_bp.get("slot_payloads", [])):
		if not (raw_payload is Dictionary):
			continue
		var payload: Dictionary = raw_payload
		if String(payload.get("kind", "")) != "engine":
			continue
		if _payload_torso_node_index(payload, unit_bp) != torso_node_index:
			continue
		var part := _payload_part_for_payload(role_key, payload)
		total += _engine_momentum_output_for_part(part)
	return total


func _engine_allocation_limb_momentum_for_node(binding: Dictionary, node_index: int, segment: Dictionary) -> float:
	var by_node = binding.get("allocated_limb_momentum_by_node", {})
	if not (by_node is Dictionary) or Dictionary(by_node).is_empty():
		by_node = binding.get("joint_drive_allocation_by_node", {})
	var node_key := str(node_index)
	if by_node is Dictionary and Dictionary(by_node).has(node_key):
		return maxf(0.0, float(Dictionary(by_node).get(node_key, 0.0)))
	if by_node is Dictionary and Dictionary(by_node).has(node_index):
		return maxf(0.0, float(Dictionary(by_node).get(node_index, 0.0)))
	if binding.has("allocated_limb_momentum"):
		return maxf(0.0, float(binding.get("allocated_limb_momentum", 0.0)) / float(maxi(1, Array(binding.get("target_nodes", [])).size())))
	if binding.has("allocated_momentum"):
		return maxf(0.0, float(binding.get("allocated_momentum", 0.0)) / float(maxi(1, Array(binding.get("target_nodes", [])).size())))
	return maxf(0.0, float(segment.get("allocated_limb_momentum", segment.get("joint_output_momentum_base", 0.0))))


func _engine_allocation_default_limb_momentum(segment: Dictionary) -> float:
	var default_value := maxf(0.0, float(segment.get("allocated_limb_momentum", 0.0)))
	if default_value <= 0.0:
		default_value = maxf(0.0, float(segment.get("joint_output_momentum_base", 0.0)))
	return default_value


func _engine_allocation_binding_total(unit_bp: Dictionary, binding: Dictionary) -> float:
	var stats := _editor_current_stats()
	var segments_by_node := _engine_allocation_segment_by_node(stats)
	var by_node = binding.get("allocated_limb_momentum_by_node", {})
	if not (by_node is Dictionary) or Dictionary(by_node).is_empty():
		by_node = binding.get("joint_drive_allocation_by_node", {})
	var total := 0.0
	for raw_node in Array(binding.get("target_nodes", [])):
		var node_index := int(raw_node)
		var node_key := str(node_index)
		if by_node is Dictionary and Dictionary(by_node).has(node_key):
			total += maxf(0.0, float(Dictionary(by_node).get(node_key, 0.0)))
		elif by_node is Dictionary and Dictionary(by_node).has(node_index):
			total += maxf(0.0, float(Dictionary(by_node).get(node_index, 0.0)))
		elif segments_by_node.has(node_index):
			total += _engine_allocation_default_limb_momentum(Dictionary(segments_by_node[node_index]))
	return total


func _engine_allocation_limb_duration_estimate(segment: Dictionary, module_part: Dictionary, momentum: float) -> Dictionary:
	var context := _engine_allocation_limb_motion_context(segment, module_part)
	var motion_stats: Dictionary = Dictionary(context.get("motion_stats", {})).duplicate(true)
	motion_stats["output"] = maxf(0.0, momentum)
	motion_stats["allocated_limb_momentum"] = maxf(0.0, momentum)
	var angle_degrees := float(context.get("angle_degrees", 180.0))
	var extension_m := float(context.get("extension_m", 0.0))
	var fallback_duration := float(context.get("fallback_duration", 0.72))
	return MotionBudget.estimate_motion_budget(motion_stats, module_part, angle_degrees, extension_m, fallback_duration, "normal")


func _engine_allocation_limb_motion_context(segment: Dictionary, module_part: Dictionary) -> Dictionary:
	var a: Vector2 = segment.get("a_local", segment.get("a", Vector2.ZERO)) if segment.get("a_local", segment.get("a", Vector2.ZERO)) is Vector2 else Vector2.ZERO
	var b: Vector2 = segment.get("b_local", segment.get("b", a)) if segment.get("b_local", segment.get("b", a)) is Vector2 else a
	var chain_length := maxf(0.05, a.distance_to(b))
	return {
		"motion_stats": {
			"mass": maxf(0.45, float(segment.get("mass", 1.0))),
			"length": chain_length,
			"chain_length": chain_length,
			"joint_speed_cap": maxf(0.0, float(segment.get("joint_speed_cap", 0.0))),
		},
		"angle_degrees": float(module_part.get("swing_arc_degrees", segment.get("joint_angle_range", 180.0))),
		"extension_m": float(module_part.get("module_extension_m", module_part.get("required_extension_m", segment.get("joint_extension_m", 0.0)))),
		"fallback_duration": maxf(0.12, float(module_part.get("fallback_duration", module_part.get("duration", 0.72)))),
	}


func _engine_allocation_limb_duration_label(module_part: Dictionary, min_momentum: float, max_momentum: float, duration_estimate: float) -> String:
	var module_name := _short_part_name(_zh_part_name(String(module_part.get("name", "行动模块"))) if _ui_is_zh() else String(module_part.get("name", "ACTION")))
	var duration_text := "时长 --" if _ui_is_zh() else "DUR --"
	if duration_estimate > 0.0:
		duration_text = ("时长 %.2fs" if _ui_is_zh() else "DUR %.2fs") % duration_estimate
	return ("%s %.0f-%.0f  %s" if _ui_is_zh() else "%s %.0f-%.0f  %s") % [module_name, min_momentum, max_momentum, duration_text]


func _engine_allocation_entry_with_duration(entry: Dictionary, momentum: float) -> Dictionary:
	var updated := entry.duplicate(true)
	if String(updated.get("kind", "")) != "limb":
		return updated
	var module_part: Dictionary = updated.get("duration_module_part", {}) if updated.get("duration_module_part", {}) is Dictionary else {}
	var motion_stats: Dictionary = updated.get("duration_motion_stats", {}) if updated.get("duration_motion_stats", {}) is Dictionary else {}
	if module_part.is_empty() or motion_stats.is_empty():
		return updated
	motion_stats = motion_stats.duplicate(true)
	motion_stats["output"] = maxf(0.0, momentum)
	motion_stats["allocated_limb_momentum"] = maxf(0.0, momentum)
	var estimate := MotionBudget.estimate_motion_budget(
		motion_stats,
		module_part,
		float(updated.get("duration_angle_degrees", 180.0)),
		float(updated.get("duration_extension_m", 0.0)),
		float(updated.get("duration_fallback", 0.72)),
		"normal"
	)
	var duration := maxf(0.0, float(estimate.get("duration", 0.0)))
	updated["duration_estimate"] = duration
	updated["duration_budget"] = estimate
	updated["duration_label"] = _engine_allocation_limb_duration_label(module_part, float(updated.get("min_momentum", 0.0)), float(updated.get("max_momentum", 0.0)), duration)
	return updated


func _engine_allocation_heat_color_for_kind(kind: String) -> Color:
	match kind:
		"limb":
			return Color(1.0, 0.38, 0.12, 1.0)
		"booster_boost_brake":
			return Color(1.0, 0.62, 0.18, 1.0)
		"booster_drive":
			return Color(1.0, 0.48, 0.14, 1.0)
		_:
			return Color(1.0, 0.42, 0.14, 1.0)


func _engine_allocation_heat_label(heat_load: float, cooling_pool: float) -> String:
	if cooling_pool <= 0.0:
		return ("热 %.1f / 无热力池" if _ui_is_zh() else "Heat %.1f / no pool") % heat_load
	return ("热 %.1f / 池 %.0f%%" if _ui_is_zh() else "Heat %.1f / pool %.0f%%") % [heat_load, heat_load / maxf(1.0, cooling_pool) * 100.0]


func _engine_allocation_entry_with_heat(entry: Dictionary, momentum: float, cooling_pool: float) -> Dictionary:
	var updated := entry.duplicate(true)
	if bool(updated.get("heat_exempt", false)):
		updated["heat_coeff"] = 0.0
		updated["heat_load"] = 0.0
		updated["heat_ratio"] = 0.0
		if String(updated.get("heat_label", "")) == "":
			updated["heat_label"] = "峰值提示 / 不占常热" if _ui_is_zh() else "Peak hint / no idle heat"
		if not updated.has("heat_color"):
			updated["heat_color"] = _engine_allocation_heat_color_for_kind(String(updated.get("kind", "")))
		return updated
	var heat_coeff := maxf(0.0, float(updated.get("heat_coeff", 0.0)))
	var heat_load := maxf(0.0, momentum) * heat_coeff
	updated["heat_coeff"] = heat_coeff
	updated["heat_load"] = heat_load
	updated["heat_ratio"] = heat_load / maxf(1.0, cooling_pool) if cooling_pool > 0.0 else (1.6 if heat_load > 0.0 else 0.0)
	updated["heat_label"] = _engine_allocation_heat_label(heat_load, cooling_pool)
	if not updated.has("heat_color"):
		updated["heat_color"] = _engine_allocation_heat_color_for_kind(String(updated.get("kind", "")))
	return updated


func _engine_allocation_engine_heat_entry(engine_part: Dictionary, engine_heat_load: float, cooling_pool: float) -> Dictionary:
	var heat_load := maxf(0.0, engine_heat_load)
	var engine_label := _short_part_name(_zh_part_name(String(engine_part.get("name", "引擎"))) if _ui_is_zh() else String(engine_part.get("name", "ENGINE")))
	return {
		"id": "engine_heat",
		"kind": "engine_heat",
		"label": ("%s / 常态发热" if _ui_is_zh() else "%s / IDLE HEAT") % engine_label,
		"line": "不占动力分配" if _ui_is_zh() else "Not a power allocation",
		"ratio": heat_load / maxf(1.0, cooling_pool) if cooling_pool > 0.0 else (1.0 if heat_load > 0.0 else 0.0),
		"momentum": 0.0,
		"allocated_momentum": 0.0,
		"heat_load": heat_load,
		"heat_ratio": heat_load / maxf(1.0, cooling_pool) if cooling_pool > 0.0 else (1.6 if heat_load > 0.0 else 0.0),
		"heat_label": _engine_allocation_heat_label(heat_load, cooling_pool),
		"heat_color": Color(1.0, 0.34, 0.16, 1.0),
		"color": Color(1.0, 0.44, 0.22, 1.0),
		"readonly": true,
		"disabled": false,
		"heat_only": true,
	}


func _engine_allocation_recalculate_heat(entries: Array, cooling_pool: float, engine_heat_load: float) -> Dictionary:
	var next_entries: Array = []
	var allocation_heat := 0.0
	for raw_entry in entries:
		if not (raw_entry is Dictionary):
			next_entries.append(raw_entry)
			continue
		var entry: Dictionary = Dictionary(raw_entry).duplicate(true)
		if bool(entry.get("heat_only", false)):
			var static_heat := maxf(0.0, float(entry.get("heat_load", 0.0)))
			entry["heat_ratio"] = static_heat / maxf(1.0, cooling_pool) if cooling_pool > 0.0 else (1.6 if static_heat > 0.0 else 0.0)
			entry["heat_label"] = _engine_allocation_heat_label(static_heat, cooling_pool)
			next_entries.append(entry)
			continue
		entry = _engine_allocation_entry_with_heat(entry, maxf(0.0, float(entry.get("momentum", entry.get("allocated_momentum", 0.0)))), cooling_pool)
		allocation_heat += maxf(0.0, float(entry.get("heat_load", 0.0)))
		next_entries.append(entry)
	var heat_used := maxf(0.0, engine_heat_load) + allocation_heat
	var over_heat := heat_used > cooling_pool + 0.001 if cooling_pool > 0.0 else heat_used > 0.0
	for i in range(next_entries.size()):
		if next_entries[i] is Dictionary:
			var entry: Dictionary = Dictionary(next_entries[i]).duplicate(true)
			entry["heat_over_budget"] = over_heat
			next_entries[i] = entry
	return {
		"entries": next_entries,
		"allocation_heat_used": allocation_heat,
		"heat_used": heat_used,
		"heat_ratio": heat_used / maxf(1.0, cooling_pool) if cooling_pool > 0.0 else (1.6 if heat_used > 0.0 else 0.0),
		"thermal_margin": cooling_pool - heat_used,
	}


func _engine_allocation_engine_idle_heat_for_torso(unit_bp: Dictionary, torso_node_index: int) -> float:
	var role_key: String = String(unit_bp.get("role", ROLE_ORDER[editor_role_index]))
	var total := 0.0
	for raw_payload in Array(unit_bp.get("slot_payloads", [])):
		if not (raw_payload is Dictionary):
			continue
		var payload: Dictionary = raw_payload
		if String(payload.get("kind", "")) != "engine":
			continue
		if _payload_torso_node_index(payload, unit_bp) != torso_node_index:
			continue
		var engine_part := _payload_part_for_payload(role_key, payload)
		total += _engine_idle_heat_for_part(engine_part, _engine_momentum_output_for_part(engine_part))
	return total


func _engine_momentum_allocation_data(unit_bp: Dictionary, torso_node_index: int, engine_payload_index: int) -> Dictionary:
	if not unit_bp.has("custom_topology"):
		return {}
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	var role_key: String = String(unit_bp.get("role", ROLE_ORDER[editor_role_index]))
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", []))
	if torso_node_index < 0 or torso_node_index >= nodes.size() or not (nodes[torso_node_index] is Dictionary):
		return {}
	var has_engine_payload := false
	var engine_payload: Dictionary = {}
	if engine_payload_index >= 0:
		if engine_payload_index >= payloads.size() or not (payloads[engine_payload_index] is Dictionary):
			return {}
		engine_payload = payloads[engine_payload_index]
		if String(engine_payload.get("kind", "")) != "engine":
			return {}
		if _payload_torso_node_index(engine_payload, unit_bp) != torso_node_index:
			return {}
		has_engine_payload = true
	var stats := _editor_current_stats()
	var segments: Array = Array(stats.get("runtime_topology_segments", []))
	var segments_by_node := _engine_allocation_segment_by_node(stats)
	var pool := _engine_allocation_pool_for_torso(unit_bp, torso_node_index)
	var cooling_pool := _thermal_load_pool_for_stats(stats)
	var engine_heat_load := _engine_allocation_engine_idle_heat_for_torso(unit_bp, torso_node_index)
	var engine_part := _payload_part_for_payload(role_key, engine_payload) if has_engine_payload else {"name": "NO ENGINE"}
	var torso_part := _topology_node_part(role_key, nodes[torso_node_index], unit_bp)
	var entries: Array = []
	for i in range(payloads.size()):
		if not (payloads[i] is Dictionary):
			continue
		var payload: Dictionary = payloads[i]
		if String(payload.get("kind", "")) != "booster":
			continue
		if _payload_torso_node_index(payload, unit_bp) != torso_node_index:
			continue
		var booster_part := _payload_part_for_payload(role_key, payload)
		var drive_min := _thruster_drive_allocation_min_for_part(booster_part)
		var drive_max := _thruster_drive_allocation_max_for_part(booster_part)
		var drive_momentum := _thruster_drive_allocated_for_payload(payload, booster_part)
		var drive_ratio := drive_momentum / maxf(1.0, pool) if pool > 0.0 else 0.0
		var boost_min := _thruster_boost_brake_allocation_min_for_part(booster_part)
		var boost_max := _thruster_boost_brake_allocation_max_for_part(booster_part)
		var boost_momentum := _thruster_boost_brake_allocated_for_payload(payload, booster_part)
		var boost_ratio := boost_momentum / maxf(1.0, pool) if pool > 0.0 else 0.0
		var boost_peak := drive_momentum + boost_momentum
		var boost_peak_ratio := boost_peak / maxf(1.0, pool) if pool > 0.0 else 0.0
		var booster_heat_coeff := _thruster_idle_heat_coeff_for_part(booster_part)
		var booster_label := _short_part_name(_zh_part_name(String(booster_part.get("name", "推进"))) if _ui_is_zh() else String(booster_part.get("name", "BOOSTER")))
		entries.append({
			"id": "booster_drive:%d" % i,
			"kind": "booster_drive",
			"payload_index": i,
			"label": ("%s / 推进" if _ui_is_zh() else "%s / MOVE") % booster_label,
			"line": ("普通移动/转向 %.0f-%.0f" if _ui_is_zh() else "Move/turn %.0f-%.0f") % [drive_min, drive_max],
			"ratio": drive_ratio,
			"momentum": drive_momentum,
			"allocated_momentum": drive_momentum,
			"min_momentum": drive_min,
			"max_momentum": drive_max,
			"default_momentum": drive_min,
			"boost_extra_momentum": boost_momentum,
			"boost_peak_momentum": boost_peak,
			"boost_extra_ratio": boost_ratio,
			"boost_peak_ratio": boost_peak_ratio,
			"boost_dash_hint": true,
			"boost_label": ("Boost刹车 +%.0f / 峰值 %.0f" if _ui_is_zh() else "Boost-brake +%.0f / PEAK %.0f") % [boost_momentum, boost_peak],
			"heat_coeff": booster_heat_coeff,
			"heat_color": Color(1.0, 0.48, 0.14, 1.0),
			"readonly": drive_max <= drive_min,
			"disabled": pool <= 0.0,
			"color": Color(1.0, 0.52, 0.18, 1.0),
		})
		entries.append({
			"id": "booster_boost_brake:%d" % i,
			"kind": "booster_boost_brake",
			"payload_index": i,
			"label": ("%s / Boost刹车" if _ui_is_zh() else "%s / BOOST-BRAKE") % booster_label,
			"line": ("Boost/刹车增幅 %.0f-%.0f" if _ui_is_zh() else "Boost/brake %.0f-%.0f") % [boost_min, boost_max],
			"ratio": boost_ratio,
			"momentum": boost_momentum,
			"allocated_momentum": boost_momentum,
			"min_momentum": boost_min,
			"max_momentum": boost_max,
			"default_momentum": boost_min,
			"boost_peak_momentum": boost_peak,
			"boost_peak_ratio": boost_peak_ratio,
			"heat_coeff": 0.0,
			"heat_exempt": true,
			"heat_label": "峰值提示 / 不占常热" if _ui_is_zh() else "Peak hint / no idle heat",
			"heat_color": Color(1.0, 0.62, 0.18, 1.0),
			"readonly": boost_max <= boost_min,
			"disabled": pool <= 0.0 or boost_max <= 0.0,
			"color": Color(1.0, 0.72, 0.22, 1.0),
		})
	var allocation_groups: Array = []
	var counted_nodes := {}
	for ref in _engine_allocation_sorted_binding_refs(unit_bp):
		if not (ref is Dictionary):
			continue
		var binding_index := int(Dictionary(ref).get("index", -1))
		var binding: Dictionary = Dictionary(ref).get("binding", {})
		var software_slot := int(binding.get("software_slot_index", -1))
		if software_slot < 0 or software_slot >= payloads.size() or not (payloads[software_slot] is Dictionary):
			continue
		var module_payload: Dictionary = payloads[software_slot]
		if String(module_payload.get("kind", "")) != "module":
			continue
		if _payload_torso_node_index(module_payload, unit_bp) != torso_node_index:
			continue
		if _module_binding_torso_node_index(role_key, unit_bp, binding) != torso_node_index:
			continue
		var module_part := _payload_part_for_payload(role_key, module_payload)
		var binding_target_nodes: Array = Array(binding.get("target_nodes", []))
		var group_nodes: Array = []
		for raw_group_node in binding_target_nodes:
			var group_node := int(raw_group_node)
			if group_node >= 0 and segments_by_node.has(group_node):
				group_nodes.append(group_node)
		var group_id := "binding:%d:%s" % [binding_index, _editor_int_array_signature(group_nodes)]
		if not group_nodes.is_empty():
			allocation_groups.append({
				"id": group_id,
				"binding_index": binding_index,
				"target_nodes": group_nodes.duplicate(true),
				"root_index": int(binding.get("root_index", group_nodes[0])),
				"label": _short_part_name(_zh_part_name(String(module_part.get("name", "行动模块"))) if _ui_is_zh() else String(module_part.get("name", "ACTION"))),
			})
		for raw_node in Array(binding.get("target_nodes", [])):
			var node_index := int(raw_node)
			if counted_nodes.has(node_index):
				continue
			if not segments_by_node.has(node_index):
				continue
			var segment: Dictionary = segments_by_node[node_index]
			if String(segment.get("part_kind", "")) == "torso":
				continue
			var drive_kind := String(segment.get("joint_drive_kind", "rigid"))
			if drive_kind == "rigid" or drive_kind == "port":
				continue
			var momentum := _engine_allocation_limb_momentum_for_node(binding, node_index, segment)
			var default_momentum := _engine_allocation_default_limb_momentum(segment)
			var min_momentum := maxf(0.0, float(segment.get("momentum_min", 0.0)))
			var max_momentum := maxf(0.0, float(segment.get("momentum_max", 0.0)))
			if max_momentum <= 0.0:
				max_momentum = maxf(default_momentum, min_momentum)
			var anchor := Vector2.ZERO
			var a_value = segment.get("a_local", segment.get("a", Vector2.ZERO))
			var b_value = segment.get("b_local", segment.get("b", a_value))
			if a_value is Vector2 and b_value is Vector2:
				anchor = (a_value + b_value) * 0.5
			var duration_info := _engine_allocation_limb_duration_estimate(segment, module_part, momentum)
			var duration_estimate := maxf(0.0, float(duration_info.get("duration", 0.0)))
			var duration_context := _engine_allocation_limb_motion_context(segment, module_part)
			var limb_heat_coeff := _limb_drive_heat_coeff_for_segment(segment, module_part)
			counted_nodes[node_index] = true
			entries.append({
				"id": "limb:%d:%d" % [binding_index, node_index],
				"kind": "limb",
				"binding_index": binding_index,
				"node_index": node_index,
				"group_id": group_id,
				"target_nodes": group_nodes.duplicate(true),
				"label": _short_part_name(String(segment.get("name", "LIMB"))),
				"line": ("%s %.0f-%.0f" if _ui_is_zh() else "%s %.0f-%.0f") % [_short_part_name(String(module_part.get("name", "ACT"))), min_momentum, max_momentum],
				"ratio": momentum / maxf(1.0, pool) if pool > 0.0 else 0.0,
				"momentum": momentum,
				"min_momentum": min_momentum,
				"max_momentum": max_momentum,
				"default_momentum": default_momentum,
				"duration_estimate": duration_estimate,
				"duration_budget": duration_info,
				"duration_label": _engine_allocation_limb_duration_label(module_part, min_momentum, max_momentum, duration_estimate),
				"duration_module_part": module_part.duplicate(true),
				"duration_motion_stats": Dictionary(duration_context.get("motion_stats", {})).duplicate(true),
				"duration_angle_degrees": float(duration_context.get("angle_degrees", 180.0)),
				"duration_extension_m": float(duration_context.get("extension_m", 0.0)),
				"duration_fallback": float(duration_context.get("fallback_duration", 0.72)),
				"heat_coeff": limb_heat_coeff,
				"heat_color": Color(1.0, 0.38, 0.12, 1.0),
				"anchor_local": anchor,
				"disabled": pool <= 0.0,
				"color": Color(0.38, 0.9, 1.0, 1.0),
			})
	var used_ratio := 0.0
	for entry in entries:
		if entry is Dictionary:
			used_ratio += maxf(0.0, float(Dictionary(entry).get("ratio", 0.0)))
	for i in range(entries.size()):
		if entries[i] is Dictionary:
			var entry: Dictionary = entries[i]
			entry["over_budget"] = used_ratio > 1.0001
			entries[i] = entry
	var heat_summary := _engine_allocation_recalculate_heat(entries, cooling_pool, engine_heat_load)
	entries = Array(heat_summary.get("entries", entries))
	var display_entries := entries.duplicate(true)
	if engine_heat_load > 0.0:
		display_entries.insert(0, _engine_allocation_engine_heat_entry(engine_part, engine_heat_load, cooling_pool))
	var title := "动力预算" if _ui_is_zh() else "DRIVE BUDGET"
	var engine_label := _zh_part_name(String(engine_part.get("name", "引擎"))) if _ui_is_zh() else String(engine_part.get("name", "ENGINE"))
	if not has_engine_payload:
		engine_label = "未装引擎" if _ui_is_zh() else "NO ENGINE"
	var subtitle := ("%s / %s / 池 %.0f = 1.00" if _ui_is_zh() else "%s / %s / POOL %.0f = 1.00") % [
		engine_label,
		_zh_part_name(String(torso_part.get("name", "躯干"))) if _ui_is_zh() else String(torso_part.get("name", "TORSO")),
		pool,
	]
	return {
		"title": title,
		"subtitle": subtitle,
		"engine_name": String(engine_part.get("name", "ENGINE")),
		"torso_name": String(torso_part.get("name", "TORSO")),
		"engine_output": pool,
		"used_ratio": used_ratio,
		"cooling_pool": cooling_pool,
		"engine_heat_load": engine_heat_load,
		"allocation_heat_used": maxf(0.0, float(heat_summary.get("allocation_heat_used", 0.0))),
		"heat_used": maxf(0.0, float(heat_summary.get("heat_used", 0.0))),
		"heat_ratio": maxf(0.0, float(heat_summary.get("heat_ratio", 0.0))),
		"thermal_margin": float(heat_summary.get("thermal_margin", cooling_pool)),
		"entries": entries,
		"display_entries": display_entries,
		"segments": segments,
		"allocation_groups": allocation_groups,
		"torso_node": torso_node_index,
		"engine_payload_index": engine_payload_index,
		"has_engine": has_engine_payload,
	}


func _engine_allocation_entry_for_id(data: Dictionary, entry_id: String) -> Dictionary:
	for raw_entry in Array(data.get("entries", [])):
		if raw_entry is Dictionary and String(Dictionary(raw_entry).get("id", "")) == entry_id:
			return Dictionary(raw_entry)
	return {}


func _engine_allocation_clamped_ratio(data: Dictionary, entry_id: String, requested_ratio: float) -> float:
	var entry := _engine_allocation_entry_for_id(data, entry_id)
	if entry.is_empty():
		return 0.0
	var pool := maxf(0.0, float(data.get("engine_output", 0.0)))
	if pool > 0.0 and (entry.has("min_momentum") or entry.has("max_momentum")) and not bool(entry.get("readonly", false)):
		var momentum := _engine_allocation_clamped_momentum_from_entries(Array(data.get("entries", [])), entry_id, pool * requested_ratio, pool)
		return momentum / maxf(1.0, pool)
	var current := maxf(0.0, float(entry.get("ratio", 0.0)))
	var other := 0.0
	for raw_entry in Array(data.get("entries", [])):
		if raw_entry is Dictionary and String(Dictionary(raw_entry).get("id", "")) != entry_id:
			other += maxf(0.0, float(Dictionary(raw_entry).get("ratio", 0.0)))
	var max_allowed := maxf(0.0, 1.0 - other)
	var total := other + current
	var upper := max_allowed
	if total > 1.0001:
		upper = maxf(current, max_allowed)
	return clampf(requested_ratio, 0.0, upper)


func _engine_allocation_view_entry_for_id(entry_id: String) -> Dictionary:
	if engine_momentum_allocation_view == null or not engine_momentum_allocation_view.visible:
		return {}
	for raw_entry in Array(engine_momentum_allocation_view.entries):
		if raw_entry is Dictionary and String(Dictionary(raw_entry).get("id", "")) == entry_id:
			return Dictionary(raw_entry)
	return {}


func _show_power_allocation_entry_detail(entry_id: String) -> void:
	var entry := _engine_allocation_view_entry_for_id(entry_id)
	if entry.is_empty():
		return
	var unit_bp := _editor_current_blueprint()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var context := {
		"source": "power_entry",
		"entry_id": entry_id,
		"position": Vector2(748.0, 84.0),
		"allocated_momentum": float(entry.get("momentum", entry.get("allocated_momentum", -1.0))),
		"min_momentum": float(entry.get("min_momentum", 0.0)),
		"max_momentum": float(entry.get("max_momentum", 0.0)),
		"duration_label": String(entry.get("duration_label", "")),
	}
	match String(entry.get("kind", "")):
		"engine_heat":
			_show_payload_detail_from_index(unit_bp, role_key, editor_engine_allocation_payload_index, true, context)
		"booster_drive", "booster_boost_brake":
			_show_payload_detail_from_index(unit_bp, role_key, int(entry.get("payload_index", -1)), true, context)
		"limb":
			var module_part: Dictionary = Dictionary(entry.get("duration_module_part", {})).duplicate(true)
			var module_index := -1
			var binding_index := int(entry.get("binding_index", -1))
			var payloads: Array = Array(unit_bp.get("slot_payloads", []))
			var bindings: Array = Array(unit_bp.get("module_bindings", []))
			if binding_index >= 0 and binding_index < bindings.size() and bindings[binding_index] is Dictionary:
				var binding: Dictionary = bindings[binding_index]
				var software_slot := int(binding.get("software_slot_index", -1))
				if software_slot >= 0 and software_slot < payloads.size() and payloads[software_slot] is Dictionary:
					var payload: Dictionary = payloads[software_slot]
					module_index = int(payload.get("module", -1))
					if module_part.is_empty():
						module_part = _payload_part_for_payload(role_key, payload)
			if not module_part.is_empty():
				_show_editor_part_hover("module", max(0, module_index), module_part, true, context)
			else:
				_show_power_allocation_segment_detail(int(entry.get("node_index", -1)))
		_:
			if entry.has("node_index"):
				_show_power_allocation_segment_detail(int(entry.get("node_index", -1)))


func _show_payload_detail_from_index(unit_bp: Dictionary, role_key: String, payload_index: int, pinned: bool = true, context: Dictionary = {}) -> void:
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	if payload_index < 0 or payload_index >= payloads.size() or not (payloads[payload_index] is Dictionary):
		return
	var payload: Dictionary = payloads[payload_index]
	var payload_kind := String(payload.get("kind", ""))
	var slot_key := _payload_slot_key_for_kind(payload_kind)
	var part := _payload_part_for_payload(role_key, payload)
	if part.is_empty() or slot_key == "":
		return
	var part_index := int(payload.get(slot_key, payload.get("index", 0)))
	if payload_kind == "special":
		part_index = int(payload.get("special", part_index))
	elif payload_kind == "module":
		part_index = int(payload.get("module", part_index))
	elif payload_kind in ["engine", "booster", "cooling"]:
		part_index = int(payload.get(payload_kind, part_index))
	elif payload_kind in ["ammo", "electronic_armor", "escape_pod", "spare_weapon"]:
		part_index = int(payload.get("muscle", part_index))
	_show_editor_part_hover(slot_key, part_index, part, pinned, context)


func _show_power_allocation_segment_detail(node_index: int) -> void:
	_show_editor_topology_node_detail(node_index, "power_segment", {"position": Vector2(748.0, 84.0)})


func _show_editor_topology_node_detail(node_index: int, source: String = "board", extra_context: Dictionary = {}) -> void:
	var unit_bp := _editor_current_blueprint()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var topology: Dictionary = Dictionary(unit_bp.get("custom_topology", {}))
	var nodes: Array = Array(topology.get("nodes", []))
	if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
		return
	var node: Dictionary = nodes[node_index]
	if not _topology_node_is_component(node):
		return
	var slot_key := _topology_node_slot(node)
	var part_index := _topology_node_part_index(node, unit_bp)
	var part := _topology_node_part(role_key, node, unit_bp)
	var context := extra_context.duplicate(true)
	context["source"] = source
	context["node_index"] = node_index
	var module_names: Array = []
	for module_part in _module_parts_for_topology_node(role_key, node, unit_bp):
		if module_part is Dictionary:
			module_names.append(_short_part_name(_zh_part_name(String(Dictionary(module_part).get("name", ""))) if _ui_is_zh() else String(Dictionary(module_part).get("name", ""))))
	if not module_names.is_empty():
		var module_names_text := ", ".join(module_names)
		context["bound_action_note"] = ("该节点携带行动模块：%s。" if _ui_is_zh() else "This node carries action module(s): %s.") % module_names_text
	_show_editor_part_hover(slot_key, part_index, part, true, context)


func _engine_allocation_clamped_ratio_from_entries(entries: Array, entry_id: String, requested_ratio: float, pool: float = 0.0) -> float:
	var current := 0.0
	var other := 0.0
	var found := false
	var found_entry := {}
	for raw_entry in entries:
		if not (raw_entry is Dictionary):
			continue
		var entry: Dictionary = raw_entry
		if String(entry.get("id", "")) == entry_id:
			current = maxf(0.0, float(entry.get("ratio", 0.0)))
			found = true
			found_entry = entry
		else:
			other += maxf(0.0, float(entry.get("ratio", 0.0)))
	if not found:
		return 0.0
	if pool > 0.0 and found_entry is Dictionary and (Dictionary(found_entry).has("min_momentum") or Dictionary(found_entry).has("max_momentum")) and not bool(Dictionary(found_entry).get("readonly", false)):
		var momentum := _engine_allocation_clamped_momentum_from_entries(entries, entry_id, pool * requested_ratio, pool)
		return momentum / maxf(1.0, pool)
	var max_allowed := maxf(0.0, 1.0 - other)
	var total := other + current
	var upper := max_allowed
	if total > 1.0001:
		upper = maxf(current, max_allowed)
	return clampf(requested_ratio, 0.0, upper)


func _engine_allocation_clamped_momentum_from_entries(entries: Array, entry_id: String, requested_momentum: float, pool: float) -> float:
	if pool <= 0.0:
		return 0.0
	var entry := {}
	for raw_entry in entries:
		if not (raw_entry is Dictionary):
			continue
		var next_entry: Dictionary = raw_entry
		if String(next_entry.get("id", "")) == entry_id:
			entry = next_entry
	if entry.is_empty() or bool(entry.get("readonly", false)):
		return 0.0
	var min_momentum := maxf(0.0, float(entry.get("min_momentum", 0.0)))
	var max_momentum := maxf(min_momentum, float(entry.get("max_momentum", pool)))
	if max_momentum <= 0.0:
		max_momentum = pool
	return clampf(requested_momentum, min_momentum, max_momentum)


func _update_engine_allocation_view_entry(entry_id: String, ratio: float, momentum: float) -> void:
	if engine_momentum_allocation_view == null or not engine_momentum_allocation_view.visible:
		return
	var next_entries: Array = Array(engine_momentum_allocation_view.entries).duplicate(true)
	var used_ratio := 0.0
	for i in range(next_entries.size()):
		if not (next_entries[i] is Dictionary):
			continue
		var entry: Dictionary = Dictionary(next_entries[i]).duplicate(true)
		if String(entry.get("id", "")) == entry_id:
			entry["ratio"] = ratio
			entry["momentum"] = momentum
			entry["allocated_momentum"] = momentum
			entry = _engine_allocation_entry_with_duration(entry, momentum)
			entry = _engine_allocation_entry_with_heat(entry, momentum, engine_momentum_allocation_view.cooling_pool)
		next_entries[i] = entry
		if not bool(entry.get("heat_only", false)):
			used_ratio += maxf(0.0, float(entry.get("ratio", 0.0)))
	for i in range(next_entries.size()):
		if next_entries[i] is Dictionary:
			var entry: Dictionary = Dictionary(next_entries[i]).duplicate(true)
			entry["over_budget"] = used_ratio > 1.0001
			next_entries[i] = entry
	var heat_summary := _engine_allocation_recalculate_heat(next_entries, engine_momentum_allocation_view.cooling_pool, engine_momentum_allocation_view.engine_heat_load)
	engine_momentum_allocation_view.entries = Array(heat_summary.get("entries", next_entries))
	engine_momentum_allocation_view.used_ratio = used_ratio
	engine_momentum_allocation_view.allocation_heat_used = maxf(0.0, float(heat_summary.get("allocation_heat_used", 0.0)))
	engine_momentum_allocation_view.heat_used = maxf(0.0, float(heat_summary.get("heat_used", 0.0)))
	engine_momentum_allocation_view.heat_ratio = maxf(0.0, float(heat_summary.get("heat_ratio", 0.0)))
	engine_momentum_allocation_view.thermal_margin = float(heat_summary.get("thermal_margin", engine_momentum_allocation_view.cooling_pool - engine_momentum_allocation_view.heat_used))
	engine_momentum_allocation_view.last_allocation_signature = ""
	engine_momentum_allocation_view._sync_entry_value_edits()
	engine_momentum_allocation_view.queue_redraw()


func _write_engine_allocation_entry_momentum(unit_bp: Dictionary, entry: Dictionary, momentum: float) -> void:
	var entry_id := String(entry.get("id", ""))
	if entry_id.begins_with("booster_drive:") or entry_id.begins_with("booster_boost_brake:"):
		var pieces := entry_id.split(":")
		if pieces.size() < 2:
			return
		var payload_index := int(pieces[1])
		var payloads: Array = Array(unit_bp.get("slot_payloads", [])).duplicate(true)
		if payload_index < 0 or payload_index >= payloads.size() or not (payloads[payload_index] is Dictionary):
			return
		var payload: Dictionary = Dictionary(payloads[payload_index]).duplicate(true)
		if String(payload.get("kind", "")) != "booster":
			return
		var min_momentum := maxf(0.0, float(entry.get("min_momentum", 0.0)))
		var max_momentum := maxf(min_momentum, float(entry.get("max_momentum", min_momentum)))
		var safe_momentum := clampf(maxf(0.0, momentum), min_momentum, max_momentum)
		if entry_id.begins_with("booster_drive:"):
			payload["thruster_drive_allocated_momentum"] = safe_momentum
		else:
			payload["thruster_boost_brake_allocated_momentum"] = safe_momentum
		payloads[payload_index] = payload
		unit_bp["slot_payloads"] = payloads
		return
	if entry_id.begins_with("booster:"):
		return
	if entry_id.begins_with("limb:"):
		var pieces := entry_id.split(":")
		if pieces.size() < 3:
			return
		var binding_index := int(pieces[1])
		var node_index := int(pieces[2])
		var safe_momentum := maxf(0.0, momentum)
		if entry.has("min_momentum") or entry.has("max_momentum"):
			var min_momentum := maxf(0.0, float(entry.get("min_momentum", 0.0)))
			var max_momentum := maxf(min_momentum, float(entry.get("max_momentum", min_momentum)))
			safe_momentum = clampf(safe_momentum, min_momentum, max_momentum)
		var bindings: Array = Array(unit_bp.get("module_bindings", [])).duplicate(true)
		if binding_index < 0 or binding_index >= bindings.size() or not (bindings[binding_index] is Dictionary):
			return
		var binding: Dictionary = Dictionary(bindings[binding_index]).duplicate(true)
		var by_node := {}
		if binding.get("allocated_limb_momentum_by_node", {}) is Dictionary:
			by_node = Dictionary(binding.get("allocated_limb_momentum_by_node", {})).duplicate(true)
		if by_node.is_empty() and binding.get("joint_drive_allocation_by_node", {}) is Dictionary:
			by_node = Dictionary(binding.get("joint_drive_allocation_by_node", {})).duplicate(true)
		by_node[str(node_index)] = safe_momentum
		binding["allocated_limb_momentum_by_node"] = by_node
		binding["joint_drive_allocation_by_node"] = by_node.duplicate(true)
		binding["allocated_limb_momentum"] = _engine_allocation_binding_total(unit_bp, binding)
		binding["joint_drive_allocation_total"] = binding["allocated_limb_momentum"]
		binding["joint_drive_demand"] = binding["allocated_limb_momentum"]
		bindings[binding_index] = binding
		unit_bp["module_bindings"] = bindings


func _engine_payload_index_for_torso(unit_bp: Dictionary, torso_node_index: int) -> int:
	if torso_node_index < 0:
		return -1
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	for i in range(payloads.size()):
		if not (payloads[i] is Dictionary):
			continue
		var payload: Dictionary = payloads[i]
		if String(payload.get("kind", "")) != "engine":
			continue
		if _payload_torso_node_index(payload, unit_bp) != torso_node_index:
			continue
		return i
	return -1


func _set_engine_allocation_context_for_torso(unit_bp: Dictionary, torso_node_index: int, open_panel: bool = false, payload_override: int = -999999) -> bool:
	if torso_node_index < 0:
		return false
	var payload_index := payload_override
	if payload_index == -999999:
		payload_index = _engine_payload_index_for_torso(unit_bp, torso_node_index)
	elif payload_index >= 0:
		var payloads: Array = Array(unit_bp.get("slot_payloads", []))
		if payload_index >= payloads.size() or not (payloads[payload_index] is Dictionary):
			return false
		var payload: Dictionary = payloads[payload_index]
		if String(payload.get("kind", "")) != "engine":
			return false
		if _payload_torso_node_index(payload, unit_bp) != torso_node_index:
			return false
	editor_open_torso_node_index = torso_node_index
	editor_engine_allocation_torso_node_index = torso_node_index
	editor_engine_allocation_payload_index = payload_index
	editor_engine_allocation_undo_recorded = false
	var detail_was_open := engine_momentum_allocation_view != null and engine_momentum_allocation_view.visible and not editor_engine_allocation_panel_user_closed
	if open_panel:
		editor_engine_allocation_panel_user_closed = false
		_refresh_engine_momentum_allocation_view()
	else:
		if not detail_was_open:
			editor_engine_allocation_panel_user_closed = true
		_refresh_unit_editor_power_allocation_dock()
		_refresh_engine_allocation_dashboard_summary()
		if detail_was_open:
			_refresh_engine_momentum_allocation_view()
	return true


func _open_engine_momentum_allocation_for_payload(payload_index: int) -> void:
	var unit_bp: Dictionary = _editor_current_blueprint()
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	if payload_index < 0 or payload_index >= payloads.size() or not (payloads[payload_index] is Dictionary):
		return
	var payload: Dictionary = payloads[payload_index]
	if String(payload.get("kind", "")) != "engine":
		return
	var torso_node := _payload_torso_node_index(payload, unit_bp)
	if torso_node < 0:
		return
	_set_engine_allocation_context_for_torso(unit_bp, torso_node, true, payload_index)


func _close_engine_momentum_allocation_panel() -> void:
	editor_engine_allocation_payload_index = -1
	editor_engine_allocation_torso_node_index = -1
	editor_engine_allocation_undo_recorded = false
	editor_engine_allocation_panel_user_closed = true
	if engine_momentum_allocation_view != null:
		engine_momentum_allocation_view.visible = false


func _refresh_engine_momentum_allocation_view() -> void:
	if engine_momentum_allocation_view == null:
		return
	if editor_engine_allocation_panel_user_closed:
		engine_momentum_allocation_view.visible = false
		return
	if editor_engine_allocation_torso_node_index < 0 or editor_panel_mode != "parts":
		engine_momentum_allocation_view.visible = false
		return
	var unit_bp: Dictionary = _editor_current_blueprint()
	var data := _engine_momentum_allocation_data(unit_bp, editor_engine_allocation_torso_node_index, editor_engine_allocation_payload_index)
	if data.is_empty():
		_close_engine_momentum_allocation_panel()
