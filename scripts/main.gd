func _complete_pending_module_binding_with_selection(unit_bp: Dictionary, selected: Array) -> bool:
	if editor_pending_module_binding.is_empty():
		return false
	if not unit_bp.has("custom_topology"):
		editor_summary_label.text = "警报：行动模块需要先有画板拓扑。" if _ui_is_zh() else "ALARM: action module needs a board topology first."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	var role_key: String = ROLE_ORDER[editor_role_index]
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", [])).duplicate(true)
	var selection := _sanitize_module_binding_selection(unit_bp, selected)
	if selection.is_empty():
		editor_summary_label.text = "警报：请框选或点击行动模块要控制的部位。" if _ui_is_zh() else "ALARM: select the part controlled by this action module."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	var payload_index := int(editor_pending_module_binding.get("payload_index", -1))
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	if payload_index < 0 or payload_index >= payloads.size() or not (payloads[payload_index] is Dictionary):
		editor_summary_label.text = "警报：待绑定的行动模块已不存在。" if _ui_is_zh() else "ALARM: pending action module no longer exists."
		editor_pending_module_binding = {}
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	var payload: Dictionary = payloads[payload_index]
	var module_index := int(payload.get("module", editor_pending_module_binding.get("module_index", 0)))
	var module_part := _selected_component(role_key, "module", module_index)
	var attack_key := _next_available_attack_key_for_binding(unit_bp)
	var target_kind := "limb"
	var root_index := -1
	var torso_index := -1
	for raw_index in selection:
		var index := int(raw_index)
		if _topology_node_is_torso(role_key, nodes[index], unit_bp):
			torso_index = index
	if torso_index >= 0 and selection.size() == 1:
		target_kind = "torso"
		root_index = torso_index
	else:
		var module_profile := String(module_part.get("module_action_profile", ""))
		if module_profile == "two_link_forward_snap":
			root_index = _two_link_binding_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selection)
		elif _gun_activation_profiles().has(module_profile):
			root_index = _gun_activation_binding_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selection)
			target_kind = "gun_terminal"
		elif module_profile == "blunt_gauntlet_extend_swing":
			root_index = _gauntlet_binding_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selection, module_part)
			target_kind = "gauntlet_terminal"
		elif module_profile == SHIELD_GUARD_BASH_PROFILE:
			root_index = _blunt_terminal_binding_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selection, module_part, "shield")
			target_kind = "shield_terminal"
		elif module_profile == HAMMER_WINDUP_SLAM_PROFILE:
			root_index = _blunt_terminal_binding_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selection, module_part, "hammer")
			target_kind = "hammer_terminal"
		else:
			root_index = _pose_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selection)
		if root_index < 0:
			root_index = int(selection[0])
	if root_index < 0 or root_index >= nodes.size():
		editor_summary_label.text = "警报：无法识别绑定目标。" if _ui_is_zh() else "ALARM: cannot resolve binding target."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	if target_kind == "torso" and String(module_part.get("module_target_kind", "")) != "torso":
		editor_summary_label.text = "警报：该行动模块需要绑定肢体，不是躯干。" if _ui_is_zh() else "ALARM: this action module needs a limb target, not a torso."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	if target_kind in ["limb", "gun_terminal", "gauntlet_terminal", "shield_terminal", "hammer_terminal"] and (_topology_node_is_torso(role_key, nodes[root_index], unit_bp) or _topology_node_slot(nodes[root_index]) == "joint"):
		editor_summary_label.text = "警报：该行动模块需要绑定带内置关节的肌肉段。" if _ui_is_zh() else "ALARM: bind this module to a muscle segment with an embedded root joint."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	if target_kind == "gun_terminal" and not _topology_node_is_projectile_gun_terminal(role_key, unit_bp, nodes, root_index):
		editor_summary_label.text = "警报：枪械启动只能绑定枪械末端肌肉。" if _ui_is_zh() else "ALARM: Gun Activate can only bind a projectile gun terminal."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	if target_kind == "gun_terminal":
		var root_part := _topology_node_part(role_key, nodes[root_index], unit_bp)
		var profile := String(module_part.get("module_action_profile", ""))
		var root_gun_kind := String(root_part.get("gun_kind", _gun_kind_for_data(root_part)))
		var root_ammo_kind := String(root_part.get("ammo_kind", _ammo_kind_for_data(root_part)))
		if _gun_activation_profiles().has(profile) and not _gun_activation_profile_supports_kind(profile, root_gun_kind, root_ammo_kind):
			editor_summary_label.text = "警报：该枪械行动模块不支持所选枪械。" if _ui_is_zh() else "ALARM: this gun module does not support the selected gun."
			_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
			return true
	if target_kind == "gauntlet_terminal" and not _topology_node_is_blunt_hybrid_gauntlet(role_key, unit_bp, nodes, root_index, module_part):
		editor_summary_label.text = "警报：拳套伸摆只能绑定带旋转+伸缩混合关节的钝击拳套。" if _ui_is_zh() else "ALARM: Gauntlet Extend-Swing needs a blunt gauntlet terminal with a hybrid rotate+extend joint."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	if target_kind == "shield_terminal" and not _topology_node_is_blunt_terminal_family(role_key, unit_bp, nodes, root_index, module_part, "shield"):
		editor_summary_label.text = "警报：盾牌架撞只能绑定带内置球形关节的钝击盾牌。" if _ui_is_zh() else "ALARM: Shield Guard-Bash needs a blunt shield terminal with an embedded ball joint."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	if target_kind == "hammer_terminal" and not _topology_node_is_blunt_terminal_family(role_key, unit_bp, nodes, root_index, module_part, "hammer"):
		editor_summary_label.text = "警报：大锤蓄砸只能绑定带内置球形关节的钝击大锤。" if _ui_is_zh() else "ALARM: Hammer Windup-Slam needs a blunt hammer terminal with an embedded ball joint."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	var target_nodes := [root_index] if target_kind in ["gun_terminal", "gauntlet_terminal", "shield_terminal", "hammer_terminal"] else (_topology_downstream_node_indices(role_key, unit_bp, nodes, topology.get("edges", []), root_index) if target_kind == "limb" else [root_index])
	if selection.size() > 1 and target_kind == "limb" and String(module_part.get("module_action_profile", "")) != "two_link_forward_snap":
		target_nodes = selection
	if torso_index < 0 and not target_nodes.is_empty():
		torso_index = _topology_owner_torso_node_for_node(role_key, unit_bp, int(target_nodes[0]))
	var drive_by_node := _module_binding_drive_allocation_for_nodes(role_key, unit_bp, nodes, target_nodes, module_part)
	var joint_drive_total := _module_binding_drive_total(drive_by_node)
	var joint_output_total := _module_binding_joint_output_for_nodes(role_key, unit_bp, nodes, target_nodes, module_part)
	var min_bound_nodes := int(module_part.get("min_bound_nodes", 0))
	if min_bound_nodes > 0 and target_nodes.size() < min_bound_nodes:
		editor_summary_label.text = "警报：该行动模块至少需要绑定 %d 段肢体。" % min_bound_nodes if _ui_is_zh() else "ALARM: this action module needs at least %d limb segments." % min_bound_nodes
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	var test_unit: Dictionary = unit_bp.duplicate(true)
	var test_topology: Dictionary = topology.duplicate(true)
	var test_nodes: Array = nodes.duplicate(true)
	if target_kind in ["limb", "gun_terminal", "gauntlet_terminal", "shield_terminal", "hammer_terminal"]:
		var root_node: Dictionary = Dictionary(test_nodes[root_index]).duplicate(true)
		var modules: Array = Array(root_node.get("modules", []))
		if not modules.has(module_index):
			modules.append(module_index)
		root_node["modules"] = modules
		root_node["module"] = int(modules[0])
		root_node["attack_key"] = attack_key
		test_nodes[root_index] = root_node
	test_topology["nodes"] = test_nodes
	test_unit["custom_topology"] = test_topology
	var invalid_reason := ""
	if target_kind in ["limb", "gun_terminal", "gauntlet_terminal", "shield_terminal", "hammer_terminal"]:
		var attack_nodes := _component_topology_attack_nodes(role_key, test_unit, false)
		var matched := false
		for attack_node in attack_nodes:
			if not (attack_node is Dictionary):
				continue
			var attack_dict: Dictionary = attack_node
			if int(attack_dict.get("source_embedded_joint_node", -999)) == root_index and _module_indices_for_topology_node(attack_dict, test_unit).has(module_index):
				matched = true
				invalid_reason = _module_execution_invalid_reason(module_part, attack_dict, role_key, test_unit)
				break
		if not matched:
			invalid_reason = "selected part does not produce an executable attack group."
	if invalid_reason != "":
		editor_summary_label.text = "警报：绑定非法：%s" % invalid_reason if _ui_is_zh() else "ALARM: illegal binding: %s" % invalid_reason
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	var target_label := "躯干" if target_kind == "torso" and _ui_is_zh() else ("TORSO" if target_kind == "torso" else "")
	if target_label == "":
		var root_node: Dictionary = Dictionary(nodes[root_index])
		target_label = _short_part_name(String(root_node.get("label", root_node.get("part_name", "LIMB"))))
	editor_pending_module_binding["target_selected"] = true
	editor_pending_module_binding["target_kind"] = target_kind
	editor_pending_module_binding["target_nodes"] = target_nodes
	editor_pending_module_binding["target_torso_node"] = torso_index
	editor_pending_module_binding["root_index"] = root_index
	editor_pending_module_binding["target_label"] = target_label
	editor_pending_module_binding["joint_drive_allocation_by_node"] = drive_by_node
	editor_pending_module_binding["allocated_limb_momentum_by_node"] = drive_by_node.duplicate(true)
	editor_pending_module_binding["allocated_limb_momentum"] = joint_drive_total
	editor_pending_module_binding["joint_drive_allocation_total"] = joint_drive_total
	editor_pending_module_binding["joint_drive_demand"] = joint_drive_total
	editor_pending_module_binding["joint_output_momentum"] = joint_output_total
	editor_pending_module_binding["attack_key"] = 0
	editor_selected_topology_nodes = target_nodes
	editor_topology_node_index = root_index
	editor_summary_label.text = "目标已选择：%s。现在请选择攻击键：1U / 2I / 3O / 4J / 5K / 6L。" % target_label if _ui_is_zh() else "Target selected: %s. Now choose attack key: 1U / 2I / 3O / 4J / 5K / 6L." % target_label
	_trigger_editor_snap("module_target", target_label)
	_refresh_editor_visual_views()
	_update_editor_ui()
	return true


func _torso_detail_module_binding_candidates(unit_bp: Dictionary, payload_index: int, module_part: Dictionary) -> Array:
	var candidates: Array = []
	if not unit_bp.has("custom_topology"):
		return candidates
	var role_key: String = ROLE_ORDER[editor_role_index]
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", []))
	var seen := {}
	for i in range(nodes.size()):
		if not (nodes[i] is Dictionary):
			continue
		var candidate := _torso_detail_binding_candidate_for_node(unit_bp, payload_index, module_part, i)
		if candidate.is_empty():
			continue
		var key := String(candidate.get("target_kind", "")) + ":" + str(candidate.get("root_index", i))
		if bool(candidate.get("valid", false)) and seen.has(key):
			continue
		if bool(candidate.get("valid", false)):
			seen[key] = true
		candidates.append(candidate)
	candidates.sort_custom(func(a, b):
		var candidate_a: Dictionary = a if a is Dictionary else {}
		var candidate_b: Dictionary = b if b is Dictionary else {}
		var valid_a := bool(candidate_a.get("valid", false))
		var valid_b := bool(candidate_b.get("valid", false))
		if valid_a != valid_b:
			return valid_a
		var root_a := int(candidate_a.get("root_index", 999999))
		var root_b := int(candidate_b.get("root_index", 999999))
		if root_a != root_b:
			return root_a < root_b
		return String(candidate_a.get("label", "")) < String(candidate_b.get("label", ""))
	)
	return candidates


func _module_binding_target_nodes_for_candidate(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, root_index: int, target_kind: String, module_part: Dictionary) -> Array:
	if root_index < 0 or root_index >= nodes.size():
		return []
	match target_kind:
		"torso", "gun_terminal", "gauntlet_terminal", "shield_terminal", "hammer_terminal":
			return [root_index]
		_:
			if String(module_part.get("module_action_profile", "")) == "two_link_forward_snap":
				return _two_link_chain_node_indices(role_key, unit_bp, root_index)
			return _topology_downstream_node_indices(role_key, unit_bp, nodes, edges, root_index)


func _module_binding_drive_allocation_for_nodes(role_key: String, unit_bp: Dictionary, nodes: Array, target_nodes: Array, module_part: Dictionary) -> Dictionary:
	var by_node := {}
	for raw_node in target_nodes:
		var node_index := int(raw_node)
		if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
			continue
		var node: Dictionary = nodes[node_index]
		var slot_key := _topology_node_slot(node)
		if not (slot_key in ["limb_muscle", "muscle"]):
			continue
		if _topology_node_is_torso(role_key, node, unit_bp):
			continue
		var part := _topology_node_part(role_key, node, unit_bp)
		var allocation := _default_limb_allocated_momentum_for_part(part, slot_key, module_part)
		if allocation > 0.0:
			by_node[str(node_index)] = allocation
	return by_node


func _module_binding_drive_total(by_node: Dictionary) -> float:
	var total := 0.0
	for raw_key in by_node.keys():
		total += maxf(0.0, float(by_node[raw_key]))
	return total


func _module_binding_joint_output_for_nodes(role_key: String, unit_bp: Dictionary, nodes: Array, target_nodes: Array, module_part: Dictionary) -> float:
	var total := 0.0
	for raw_node in target_nodes:
		var node_index := int(raw_node)
		if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
			continue
		var node: Dictionary = nodes[node_index]
		var slot_key := _topology_node_slot(node)
		if not (slot_key in ["limb_muscle", "muscle"]):
			continue
		if _topology_node_is_torso(role_key, node, unit_bp):
			continue
		var part := _topology_node_part(role_key, node, unit_bp)
		total += _joint_output_momentum_base_for_part(part, slot_key, module_part)
	return total


func _torso_detail_binding_candidate_for_node(unit_bp: Dictionary, _payload_index: int, module_part: Dictionary, node_index: int) -> Dictionary:
	var role_key: String = ROLE_ORDER[editor_role_index]
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", []))
	var edges: Array = Array(topology.get("edges", []))
	if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
		return {}
	var node: Dictionary = Dictionary(nodes[node_index])
	var selection := [node_index]
	var module_profile := String(module_part.get("module_action_profile", ""))
	var target_kind := "limb"
	var root_index := -1
	var note := "OK"
	var valid := false
	if _topology_node_is_torso(role_key, node, unit_bp):
		root_index = node_index
		target_kind = "torso"
		valid = String(module_part.get("module_target_kind", "")) == "torso"
		note = "可绑定躯干" if valid and _ui_is_zh() else ("TORSO OK" if valid else ("该模块需要肢体" if _ui_is_zh() else "Needs limb"))
	elif not (_topology_node_slot(node) in ["limb_muscle", "muscle"]):
		root_index = node_index
		valid = false
		note = "不是可发肌肉" if _ui_is_zh() else "Not a driven muscle"
	else:
		if module_profile == "two_link_forward_snap":
			root_index = _two_link_binding_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selection)
			valid = root_index >= 0
			note = "双段链 OK" if valid and _ui_is_zh() else ("TWO-LINK OK" if valid else ("需要两段旋转肢体" if _ui_is_zh() else "Needs two rotating links"))
		elif _gun_activation_profiles().has(module_profile):
			root_index = _gun_activation_binding_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selection)
			target_kind = "gun_terminal"
			valid = root_index >= 0
			if valid:
				var root_part := _topology_node_part(role_key, nodes[root_index], unit_bp)
				valid = _gun_activation_profile_supports_kind(module_profile, String(root_part.get("gun_kind", _gun_kind_for_data(root_part))), String(root_part.get("ammo_kind", _ammo_kind_for_data(root_part))))
			note = "枪械 OK" if valid and _ui_is_zh() else ("GUN OK" if valid else ("需要合法枪械末端" if _ui_is_zh() else "Needs valid gun terminal"))
		elif module_profile == "blunt_gauntlet_extend_swing":
			root_index = _gauntlet_binding_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selection, module_part)
			target_kind = "gauntlet_terminal"
			valid = root_index >= 0
			note = "拳套 OK" if valid and _ui_is_zh() else ("GAUNTLET OK" if valid else ("需要伸旋拳套" if _ui_is_zh() else "Needs hybrid gauntlet"))
		elif module_profile == SHIELD_GUARD_BASH_PROFILE:
			root_index = _blunt_terminal_binding_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selection, module_part, "shield")
			target_kind = "shield_terminal"
			valid = root_index >= 0
			note = "盾牌 OK" if valid and _ui_is_zh() else ("SHIELD OK" if valid else ("需要盾牌末端" if _ui_is_zh() else "Needs shield terminal"))
		elif module_profile == HAMMER_WINDUP_SLAM_PROFILE:
			root_index = _blunt_terminal_binding_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selection, module_part, "hammer")
			target_kind = "hammer_terminal"
			valid = root_index >= 0
			note = "锤类 OK" if valid and _ui_is_zh() else ("HAMMER OK" if valid else ("需要锤类末端" if _ui_is_zh() else "Needs hammer terminal"))
		else:
			root_index = _pose_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selection)
			valid = root_index >= 0 and not _topology_node_is_torso(role_key, nodes[root_index], unit_bp)
			note = "肢体 OK" if valid and _ui_is_zh() else ("LIMB OK" if valid else ("需要带内置关节的肢体" if _ui_is_zh() else "Needs embedded-joint limb"))
	if root_index < 0:
		root_index = node_index
	var root_node: Dictionary = Dictionary(nodes[root_index]) if root_index >= 0 and root_index < nodes.size() and nodes[root_index] is Dictionary else node
	var label := "%d %s" % [root_index + 1, _short_part_name(String(root_node.get("label", root_node.get("part_name", "PART"))))]
	var target_nodes := _module_binding_target_nodes_for_candidate(role_key, unit_bp, nodes, edges, root_index, target_kind, module_part) if valid else []
	var drive_by_node := _module_binding_drive_allocation_for_nodes(role_key, unit_bp, nodes, target_nodes, module_part)
	var required_drive := _module_binding_drive_total(drive_by_node)
	var node_labels: Array = []
	for raw_target in target_nodes:
		var target_index := int(raw_target)
		if target_index >= 0 and target_index < nodes.size() and nodes[target_index] is Dictionary:
			var target_node: Dictionary = nodes[target_index]
			node_labels.append("%d" % (target_index + 1))
	var candidate := {
		"valid": valid,
		"label": label,
		"note": note,
		"reason": note,
		"selection": [root_index] if valid else selection,
		"root_index": root_index,
		"target_kind": target_kind,
		"target_nodes": target_nodes,
		"target_torso_node": _topology_owner_torso_node_for_node(role_key, unit_bp, root_index) if root_index >= 0 else -1,
		"nodes_label": "+".join(node_labels),
		"drive_by_node": drive_by_node,
		"required_drive": required_drive,
	}
	candidate["candidate_id"] = _binding_candidate_id(candidate)
	return candidate


func _select_torso_detail_binding_candidate(candidate_index: int) -> void:
	if editor_pending_module_binding.is_empty():
		return
	_clear_editor_hover_card()
	var unit_bp: Dictionary = _editor_current_blueprint()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var payload_index := int(editor_pending_module_binding.get("payload_index", -1))
	var module_part := _selected_component(role_key, "module", int(editor_pending_module_binding.get("module_index", 0)))
	var candidates := _torso_detail_module_binding_candidates(unit_bp, payload_index, module_part)
	if candidate_index < 0 or candidate_index >= candidates.size():
		return
	var candidate: Dictionary = candidates[candidate_index]
	if not bool(candidate.get("valid", false)):
		if editor_summary_label != null:
			editor_summary_label.text = ("绑定目标非法：%s" if _ui_is_zh() else "Illegal binding target: %s") % String(candidate.get("note", ""))
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return
	_complete_pending_module_binding_with_selection(unit_bp, Array(candidate.get("selection", [])))
	_refresh_torso_detail_view()


func _select_torso_detail_binding_key(key_value: int) -> void:
	_clear_editor_hover_card()
	_set_pending_module_attack_key(key_value)
	_refresh_torso_detail_view()


func _cancel_torso_detail_binding() -> void:
	_cancel_editor_module_binding(true)
	_refresh_torso_detail_view()


func _finalize_pending_module_binding_after_key(unit_bp: Dictionary) -> bool:
	if editor_pending_module_binding.is_empty():
		return false
	if not bool(editor_pending_module_binding.get("target_selected", false)):
		return false
	if not unit_bp.has("custom_topology"):
		editor_summary_label.text = "警报：行动模块需要先有画板拓扑。" if _ui_is_zh() else "ALARM: action module needs a board topology first."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	var role_key: String = ROLE_ORDER[editor_role_index]
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", [])).duplicate(true)
	var payload_index := int(editor_pending_module_binding.get("payload_index", -1))
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	if payload_index < 0 or payload_index >= payloads.size() or not (payloads[payload_index] is Dictionary):
		editor_summary_label.text = "警报：待绑定的行动模块已不存在。" if _ui_is_zh() else "ALARM: pending action module no longer exists."
		editor_pending_module_binding = {}
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	var payload: Dictionary = payloads[payload_index]
	var module_index := int(payload.get("module", editor_pending_module_binding.get("module_index", 0)))
	var module_part := _selected_component(role_key, "module", module_index)
	var attack_key := clampi(int(editor_pending_module_binding.get("attack_key", 1)), 1, ATTACK_GROUP_COUNT)
	var target_kind := String(editor_pending_module_binding.get("target_kind", "limb"))
	var root_index := int(editor_pending_module_binding.get("root_index", -1))
	var torso_index := int(editor_pending_module_binding.get("target_torso_node", -1))
	var target_nodes: Array = Array(editor_pending_module_binding.get("target_nodes", []))
	var drive_by_node: Dictionary = editor_pending_module_binding.get("joint_drive_allocation_by_node", {}) if editor_pending_module_binding.get("joint_drive_allocation_by_node", {}) is Dictionary else {}
	if drive_by_node.is_empty() and editor_pending_module_binding.get("allocated_limb_momentum_by_node", {}) is Dictionary:
		drive_by_node = Dictionary(editor_pending_module_binding.get("allocated_limb_momentum_by_node", {})).duplicate(true)
	if drive_by_node.is_empty():
		drive_by_node = _module_binding_drive_allocation_for_nodes(role_key, unit_bp, nodes, target_nodes, module_part)
	var joint_drive_total := _module_binding_drive_total(drive_by_node)
	var joint_output_total := _module_binding_joint_output_for_nodes(role_key, unit_bp, nodes, target_nodes, module_part)
	if root_index < 0 or root_index >= nodes.size() or target_nodes.is_empty():
		editor_summary_label.text = "警报：行动模块目标已失效，请重新选择绑定部位。" if _ui_is_zh() else "ALARM: module target is stale; select the target part again."
		editor_pending_module_binding["target_selected"] = false
		_refresh_editor_module_binding_buttons()
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	_record_editor_undo_state("绑定行动模块" if _ui_is_zh() else "bind action module")
	if target_kind in ["limb", "gun_terminal", "gauntlet_terminal", "shield_terminal", "hammer_terminal"]:
		var node: Dictionary = Dictionary(nodes[root_index]).duplicate(true)
		var node_modules: Array = Array(node.get("modules", []))
		if not node_modules.has(module_index):
			node_modules.append(module_index)
		node["modules"] = node_modules
		node["module"] = int(node_modules[0])
		node["attack_key"] = attack_key
		nodes[root_index] = node
		topology["nodes"] = nodes
		unit_bp["custom_topology"] = topology
	var bindings: Array = Array(unit_bp.get("module_bindings", [])).duplicate(true)
	var kept: Array = []
	for raw_binding in bindings:
		if raw_binding is Dictionary and int(Dictionary(raw_binding).get("software_slot_index", -1)) == payload_index:
			continue
		kept.append(raw_binding)
	kept.append({
		"software_slot_index": payload_index,
		"module_index": module_index,
		"attack_key": attack_key,
		"target_kind": target_kind,
		"root_index": root_index,
		"target_nodes": target_nodes,
		"target_torso_node": torso_index,
		"joint_drive_allocation_by_node": drive_by_node,
		"allocated_limb_momentum_by_node": drive_by_node.duplicate(true),
		"allocated_limb_momentum": joint_drive_total,
		"joint_drive_allocation_total": joint_drive_total,
		"joint_drive_demand": joint_drive_total,
		"joint_output_momentum": joint_output_total,
		"command_window_profile": String(module_part.get("command_window_profile", "")),
		"binding_valid_note": "OK",
	})
	unit_bp["module_bindings"] = kept
	editor_pending_module_binding = {}
	editor_bound_module_tryout = {}
	editor_selected_topology_nodes = []
	editor_topology_node_index = root_index
	_set_engine_allocation_context_for_torso(unit_bp, torso_index, false)
	editor_summary_label.text = "行动模块绑定完成：%d%s -> %s。" % [attack_key, _attack_key_label(attack_key), _short_part_name(String(module_part.get("name", "MODULE")))] if _ui_is_zh() else "Action module bound: %d%s -> %s." % [attack_key, _attack_key_label(attack_key), _short_part_name(String(module_part.get("name", "MODULE")))]
	_trigger_editor_snap("module", String(module_part.get("name", "MODULE")))
	_update_editor_ui()
	_refresh_editor_visual_views()
	_refresh_unit_editor_power_allocation_dock()
	if engine_momentum_allocation_view != null and engine_momentum_allocation_view.visible:
		_refresh_engine_momentum_allocation_view()
	return true


func _tryout_editor_bound_module(attack_key: int) -> bool:
	if game_state != STATE_EDITOR:
		return false
	var role_key: String = ROLE_ORDER[editor_role_index]
	if not _role_uses_body_board(role_key):
		return false
	var unit_bp: Dictionary = _editor_current_blueprint()
	if unit_bp.is_empty() or not unit_bp.has("custom_topology"):
		return false
	var runtime_bindings := _runtime_module_bindings_for_blueprint(role_key, unit_bp)
	var matched: Dictionary = {}
	for raw_binding in runtime_bindings:
		if not (raw_binding is Dictionary):
			continue
		var binding: Dictionary = raw_binding
		if int(binding.get("attack_key", 0)) != attack_key:
			continue
		matched = binding
		break
	if matched.is_empty():
		if editor_board_hint_label != null:
			editor_board_hint_label.text = ("攻击键 %d 还没有绑定行动模块。" if _ui_is_zh() else "Attack key %d has no bound action module.") % attack_key
		return false
	if not bool(matched.get("runtime_valid", true)):
		if editor_summary_label != null:
			editor_summary_label.text = ("试用失败：%s" if _ui_is_zh() else "Tryout failed: %s") % String(matched.get("binding_valid_note", "invalid binding"))
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return true
	var module_part: Dictionary = matched.get("module_part", {}) if matched.get("module_part", {}) is Dictionary else {}
	var profile := String(matched.get("module_action_profile", module_part.get("module_action_profile", "")))
	var preview_kind := "projectile" if _gun_activation_profiles().has(profile) else "melee"
	var target_nodes: Array = Array(matched.get("target_nodes", []))
	var range_m := float(module_part.get("range", 0.52))
	var travel_path := "melee"
	if preview_kind == "projectile" and not target_nodes.is_empty():
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		var nodes: Array = Array(topology.get("nodes", []))
		var root_index := int(target_nodes[target_nodes.size() - 1])
		if root_index >= 0 and root_index < nodes.size() and nodes[root_index] is Dictionary:
			var gun_part := _topology_node_part(role_key, nodes[root_index], unit_bp)
			range_m = float(gun_part.get("projectile_range", gun_part.get("range", module_part.get("module_range", 2.2))))
			travel_path = String(gun_part.get("travel_path", _gun_activation_spec(String(gun_part.get("gun_kind", _gun_kind_for_data(gun_part))), profile).get("travel_path", "straight")))
	else:
		range_m = maxf(range_m, float(module_part.get("module_extension_m", module_part.get("required_extension_m", 0.52))))
	editor_bound_module_tryout = {
		"attack_key": attack_key,
		"profile": profile,
		"preview_kind": preview_kind,
		"target_nodes": target_nodes.duplicate(true),
		"state": "normal",
		"range": range_m,
		"travel_path": travel_path,
		"duration": 0.72,
		"timer": 0.72,
		"joint_drive_allocation_total": float(matched.get("joint_drive_allocation_total", matched.get("joint_drive_demand", 0.0))),
	}
	var stats := _compute_unit_stats(_editor_player(), role_key, -1, unit_bp)
	var drive_scale := float(stats.get("action_drive_scale", 1.0))
	var drive_note := String(stats.get("drive_note", stats.get("engine_momentum_note", "")))
	if drive_scale < 0.999 and drive_note != "":
		editor_bound_module_tryout["drive_warning"] = drive_note
	if editor_summary_label != null:
		var module_name := _short_part_name(String(module_part.get("name", "MODULE")))
		if _ui_is_zh():
			editor_summary_label.text = "画板试用：%d%s %s（无伤害/不耗弹），行动驱动 %.2f。" % [attack_key, _attack_key_label(attack_key), module_name, drive_scale]
		else:
			editor_summary_label.text = "Board tryout: %d%s %s (no damage/ammo), action drive %.2f." % [attack_key, _attack_key_label(attack_key), module_name, drive_scale]
	if editor_board_hint_label != null:
		var preview_hint := "无伤害预览：进入训练才会结算伤害、热量与弹药。" if _ui_is_zh() else "Preview only: training resolves damage, heat, and ammo."
		editor_board_hint_label.text = String(editor_bound_module_tryout.get("drive_warning", preview_hint))
	_trigger_editor_snap("module_tryout", profile)
	_refresh_editor_visual_views()
	return true


func _clear_module_binding_for_payload_index(unit_bp: Dictionary, payload_index: int, shift_after_removed: bool = false) -> void:
	var removed_module_indices := {}
	var removed_attack_keys := {}
	for raw_binding in Array(unit_bp.get("module_bindings", [])):
		if raw_binding is Dictionary and int(Dictionary(raw_binding).get("software_slot_index", -1)) == payload_index:
			var removed_binding: Dictionary = Dictionary(raw_binding)
			removed_module_indices[int(removed_binding.get("module_index", -1))] = true
			var removed_key := int(removed_binding.get("attack_key", 0))
			if removed_key > 0:
				removed_attack_keys[clampi(removed_key, 1, ATTACK_GROUP_COUNT)] = true
	var kept: Array = []
	for raw_binding in Array(unit_bp.get("module_bindings", [])):
		if not (raw_binding is Dictionary):
			continue
		var binding: Dictionary = Dictionary(raw_binding).duplicate(true)
		var slot_index := int(binding.get("software_slot_index", -1))
		if slot_index == payload_index:
			continue
		if shift_after_removed and slot_index > payload_index:
			binding["software_slot_index"] = slot_index - 1
		kept.append(binding)
	unit_bp["module_bindings"] = kept
	if not editor_pending_module_binding.is_empty():
		var pending_payload := int(editor_pending_module_binding.get("payload_index", -1))
		if pending_payload == payload_index:
			editor_pending_module_binding = {}
		elif shift_after_removed and pending_payload > payload_index:
			editor_pending_module_binding["payload_index"] = pending_payload - 1
	if not editor_bound_module_tryout.is_empty() and removed_attack_keys.has(clampi(int(editor_bound_module_tryout.get("attack_key", 0)), 1, ATTACK_GROUP_COUNT)):
		editor_bound_module_tryout = {}
	if not unit_bp.has("custom_topology") or removed_module_indices.is_empty():
		return
	var still_bound_modules := {}
	for raw_binding in kept:
		if raw_binding is Dictionary:
			still_bound_modules[int(Dictionary(raw_binding).get("module_index", -1))] = true
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", [])).duplicate(true)
	for i in range(nodes.size()):
		if not (nodes[i] is Dictionary):
			continue
		var node: Dictionary = Dictionary(nodes[i]).duplicate(true)
		var modules: Array = Array(node.get("modules", []))
		var changed := false
		for raw_module_index in removed_module_indices.keys():
			var module_index := int(raw_module_index)
			if still_bound_modules.has(module_index):
				continue
			while modules.has(module_index):
				modules.erase(module_index)
				changed = true
		if changed:
			if modules.is_empty():
				node.erase("modules")
				node.erase("module")
				node.erase("attack_key")
			else:
				node["modules"] = modules
				node["module"] = int(modules[0])
			nodes[i] = node
	topology["nodes"] = nodes
	unit_bp["custom_topology"] = topology


func _remove_module_binding_for_payload(unit_bp: Dictionary, removed_payload: Dictionary, removed_index: int) -> void:
	if String(removed_payload.get("kind", "")) != "module":
		return
	_clear_module_binding_for_payload_index(unit_bp, removed_index, true)


func _rebind_torso_payload_at(payload_index: int) -> void:
	var unit_bp: Dictionary = _editor_current_blueprint()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	if payload_index < 0 or payload_index >= payloads.size() or not (payloads[payload_index] is Dictionary):
		return
	var payload: Dictionary = payloads[payload_index]
	if String(payload.get("kind", "")) != "module":
		editor_summary_label.text = "警报：只有行动模块需要重新绑定。" if _ui_is_zh() else "ALARM: only action modules can be rebound."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return
	var module_part := _payload_part_for_payload(role_key, payload)
	if not _module_requires_execution_binding(module_part):
		editor_summary_label.text = "该行动模块无需绑定部位。" if _ui_is_zh() else "This action module does not need a target binding."
		return
	_record_editor_undo_state("解绑并重新绑定行动模块" if _ui_is_zh() else "unbind and rebind action module")
	_clear_module_binding_for_payload_index(unit_bp, payload_index, false)
	_start_editor_module_binding_flow(payload_index, module_part)
	editor_summary_label.text = "已解绑：请在躯干详情页点选可绑定部位，然后选择 U/I/O/J/K/L。" if _ui_is_zh() else "Unbound: choose a bindable target in the torso detail page, then choose U/I/O/J/K/L."
	_update_editor_ui()


func _drop_catalog_part_on_torso_detail(slot_key: String, part_index: int, slot_kind: String, slot_index: int = -1) -> void:
	var role_key: String = ROLE_ORDER[editor_role_index]
	var catalog := _catalog_for(role_key, slot_key)
	if part_index < 0 or part_index >= catalog.size():
		return
	var part := _selected_component(role_key, slot_key, part_index)
	if not _part_installs_as_torso_payload(slot_key, part):
		editor_summary_label.text = "警报：该零件不是躯干详情页可安装插件。" if _ui_is_zh() else "ALARM: this part cannot be installed in the torso detail page."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return
	var payload_kind := _torso_payload_kind_for_part(part, slot_key)
	var expected_kind := _torso_payload_slot_group(payload_kind)
	if expected_kind != slot_kind:
		var expected_label := "软件槽" if expected_kind == "software" else "机内插件槽"
		editor_summary_label.text = "警报：请把该插件拖入%s。" % expected_label if _ui_is_zh() else "ALARM: drop this item into %s." % ("software slots" if expected_kind == "software" else "internal plugin slots")
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return
	_add_torso_payload_component(slot_key, part_index, part, slot_index if slot_kind == "plugin" else -1)


func _scroll_editor_catalog_page_from_card(direction: int) -> void:
	if game_state != STATE_EDITOR or editor_panel_mode == "load":
		return
	var page_size := maxi(1, editor_catalog_buttons.size())
	var role_key: String = ROLE_ORDER[editor_role_index]
	var slot_key := String(BUILD_SLOTS[editor_slot_index])
	var entries := _editor_catalog_entries(role_key, slot_key)
	var max_page := maxi(0, int(ceilf(float(entries.size()) / float(page_size))) - 1)
	var step := -1 if direction < 0 else 1
	var next_page := clampi(editor_catalog_page + step, 0, max_page)
	if next_page == editor_catalog_page:
		return
	editor_catalog_page = next_page
	mark_editor_dirty(EDITOR_DIRTY_CATALOG | EDITOR_DIRTY_ACTION_BUTTONS, "catalog.card_wheel_page")
	flush_editor_dirty(1200)


func _remove_torso_payload_at(payload_index: int) -> void:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	var payloads: Array = Array(unit_bp.get("slot_payloads", [])).duplicate(true)
	if payload_index < 0 or payload_index >= payloads.size():
		return
	if editor_engine_allocation_payload_index >= 0:
		_close_engine_momentum_allocation_panel()
	_record_editor_undo_state("删除躯干插件" if _ui_is_zh() else "remove torso plugin")
	var removed_payload: Dictionary = payloads[payload_index]
	var removed_part := _payload_part_for_payload(role_key, removed_payload)
	_remove_module_binding_for_payload(unit_bp, removed_payload, payload_index)
	payloads.remove_at(payload_index)
	unit_bp["slot_payloads"] = payloads
	editor_selected_torso_slot_index = -1
	editor_selected_torso_slot_kind = ""
	var removed_name := _zh_part_name(String(removed_part.get("name", removed_payload.get("kind", "")))) if _ui_is_zh() else String(removed_part.get("name", removed_payload.get("kind", "")))
	editor_summary_label.text = "已从躯干详情页拔出：%s。" % removed_name if _ui_is_zh() else "Removed from torso detail: %s." % removed_name
	_play_sfx_wave("clack", 520.0, 0.045, -18.0)
	ai_team_manual_lock[player_id] = true
	_update_editor_ui()
	_refresh_unit_editor_power_allocation_dock()
	if engine_momentum_allocation_view != null and engine_momentum_allocation_view.visible:
		_refresh_engine_momentum_allocation_view()
	_refresh_editor_visual_views()


func _close_editor_torso_detail() -> void:
	_close_engine_momentum_allocation_panel()
	if not editor_pending_module_binding.is_empty():
		var payload_index := int(editor_pending_module_binding.get("payload_index", -1))
		var payloads: Array = Array(_editor_current_blueprint().get("slot_payloads", []))
		if payload_index >= 0 and payload_index < payloads.size() and payloads[payload_index] is Dictionary:
			var payload_torso := int(Dictionary(payloads[payload_index]).get("torso_node", editor_open_torso_node_index))
			if payload_torso == editor_open_torso_node_index:
				_cancel_editor_module_binding(false)
	editor_open_torso_node_index = -1
	editor_selected_torso_slot_index = -1
	editor_selected_torso_slot_kind = ""
	_set_editor_torso_detail_binding_layout(false)
	if editor_torso_detail_view != null:
		editor_torso_detail_view.visible = false
	_clear_editor_hover_card()
	_refresh_editor_visual_views()


func _editor_action(action_key: String) -> void:
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("editor_action")
	if action_key.begins_with("bind_key_"):
		var pieces := action_key.split("_")
		var key_value := int(pieces[pieces.size() - 1]) if pieces.size() > 0 else 1
		if editor_pending_module_binding.is_empty():
			_tryout_editor_bound_module(key_value)
		else:
			_set_pending_module_attack_key(key_value)
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("editor_action")
		return
	if action_key.begins_with("panel_"):
		editor_panel_mode = action_key.substr(String("panel_").length())
		editor_template_menu_open = editor_panel_mode == "load"
		if editor_panel_mode != "parts":
			_close_engine_momentum_allocation_panel()
		if editor_panel_mode == "load":
			_clear_editor_hover_card()
			editor_load_page = 0
		_update_editor_ui()
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("editor_action")
		return
	match action_key:
		"edit_side":
			editor_player_id = 2 if _editor_player() == 1 else 1
			for role_key in ROLE_ORDER:
				var roster: Array = blueprints.get(editor_player_id, {}).get(role_key, [])
				editor_unit_indices[role_key] = clampi(int(active_roster_indices.get(editor_player_id, {}).get(role_key, 0)), 0, maxi(0, roster.size() - 1))
			if _editor_is_blank_work_canvas():
				_reset_editor_working_canvas(ROLE_ORDER[editor_role_index])
			editor_summary_label.text = "正在编辑 P%d 队伍编辑配置。" % editor_player_id if _ui_is_zh() else "Now editing P%d TeamEdit roster." % editor_player_id
			_update_editor_ui()
		"load_team":
			editor_load_mode = "team"
			editor_load_page = 0
			editor_template_menu_open = false
			_clear_editor_hover_card()
			_clear_editor_unit_hover_card()
			editor_summary_label.text = "队伍编成：这里展示当前草稿队伍槽；单位请先保存到单位库，再导入队伍槽。" if _ui_is_zh() else "Team compose: this shows the current draft roster; save units to the library before filling team slots."
			_update_editor_ui()
		"load_unit":
			editor_load_mode = "unit"
			editor_load_page = 0
			editor_template_menu_open = true
			_clear_editor_hover_card()
			_clear_editor_unit_hover_card()
			editor_summary_label.text = "单位库：点击单位载入当前临时画布；保存当前画布会生成单单位 JSON。" if _ui_is_zh() else "Unit library: click a unit to load this temporary canvas; saving writes a single-unit JSON."
			_update_editor_ui()
		"save_canvas":
			if hot_path_profiler != null:
				hot_path_profiler.scope_begin("bottom_button.action")
			_show_save_unit_name_dialog()
			if hot_path_profiler != null:
				hot_path_profiler.scope_end("bottom_button.action")
		"open_saved_units":
			if hot_path_profiler != null:
				hot_path_profiler.scope_begin("bottom_button.action")
			_show_saved_units_library(saved_unit_focus_path, "editor", true)
			if hot_path_profiler != null:
				hot_path_profiler.scope_end("bottom_button.action")
		"add_to_team":
			_append_editor_current_unit_to_team()
		"training_import":
			if hot_path_profiler != null:
				hot_path_profiler.scope_begin("bottom_button.action")
			_start_editor_canvas_training_test()
			if hot_path_profiler != null:
				hot_path_profiler.scope_end("bottom_button.action")
		"import_team":
			_import_editor_team()
		"export_team":
			_export_editor_team()
		"clear_team":
			_clear_editor_team()
		"toggle_match_format":
			editor_match_format = "light" if editor_match_format != "light" else "standard"
			sortie_loadouts[_editor_player()] = []
			summon_pair_bindings[_editor_player()] = _default_summon_pair_bindings()
			editor_summary_label.text = "对战规则已切换为：%s。队伍草稿不会自动补单位，出战前再选择对应数量。" % _match_format_name() if _ui_is_zh() else "Match format switched to: %s. Draft roster is not auto-filled; pick the sortie count before battle." % _match_format_name()
			_update_editor_ui()
		"prev_unit":
			editor_canvas_mode = "roster_unit"
			var player_id := _editor_player()
			var role_key_for_prev: String = ROLE_ORDER[editor_role_index]
			if Array(blueprints[player_id].get(role_key_for_prev, [])).is_empty():
				_reset_editor_working_canvas(role_key_for_prev)
				_update_editor_ui()
				if hot_path_profiler != null:
					hot_path_profiler.scope_end("editor_action")
				return
			editor_unit_indices[role_key_for_prev] = _wrapped_index(int(editor_unit_indices[role_key_for_prev]) - 1, blueprints[player_id][role_key_for_prev].size())
			active_roster_indices[player_id][role_key_for_prev] = int(editor_unit_indices[role_key_for_prev])
			_update_editor_ui()
		"next_unit":
			editor_canvas_mode = "roster_unit"
			var player_id := _editor_player()
			var role_key_for_next: String = ROLE_ORDER[editor_role_index]
			if Array(blueprints[player_id].get(role_key_for_next, [])).is_empty():
				_reset_editor_working_canvas(role_key_for_next)
				_update_editor_ui()
				if hot_path_profiler != null:
					hot_path_profiler.scope_end("editor_action")
				return
			editor_unit_indices[role_key_for_next] = _wrapped_index(int(editor_unit_indices[role_key_for_next]) + 1, blueprints[player_id][role_key_for_next].size())
			active_roster_indices[player_id][role_key_for_next] = int(editor_unit_indices[role_key_for_next])
			_update_editor_ui()
		"duplicate":
			_add_roster_unit()
		"delete":
			_delete_roster_unit()
		"initial":
			editor_summary_label.text = "TeamEdit 只编辑%s队伍；本场出战和首发请在战斗前的出战选择界面决定。" % _match_format_name() if _ui_is_zh() else "TeamEdit only builds the %s roster; choose the sortie and starter in the pre-battle sortie screen." % _match_format_name()
		"copy_ai":
			var source_player := _editor_player()
			var target_player := 2 if source_player == 1 else 1
			blueprints[target_player] = blueprints[source_player].duplicate(true)
			active_roster_indices[target_player] = active_roster_indices[source_player].duplicate(true)
			initial_role[target_player] = initial_role[source_player]
			sortie_loadouts[target_player] = []
			initial_sortie_slot[target_player] = 0
			summon_pair_bindings[target_player] = summon_pair_bindings[source_player].duplicate(true)
			ai_team_manual_lock[target_player] = true
			editor_summary_label.text = "已将 P%d 队伍编辑配置复制到 P%d/AI。" % [source_player, target_player] if _ui_is_zh() else "Copied P%d TeamEdit roster to P%d/AI loadout." % [source_player, target_player]
		"sortie_toggle":
			editor_summary_label.text = "出战选择已移到赛前界面：先完成%s队伍，再进入战斗前选择本场单位。" % _match_format_name() if _ui_is_zh() else "Sortie selection moved to the pre-battle screen: build the %s roster here, then choose match units before battle." % _match_format_name()
		"sortie_up":
			editor_summary_label.text = "出战顺序请在赛前出战选择界面调整。" if _ui_is_zh() else "Adjust sortie order in the pre-battle sortie screen."
		"sortie_down":
			editor_summary_label.text = "出战顺序请在赛前出战选择界面调整。" if _ui_is_zh() else "Adjust sortie order in the pre-battle sortie screen."
		"bind_prev":
			editor_summary_label.text = "召唤组合键绑定跟随本场出战槽，请在赛前选择后调整。" if _ui_is_zh() else "Summon-pair bindings belong to this match's sortie slots; adjust after choosing them pre-battle."
		"bind_next":
			editor_summary_label.text = "召唤组合键绑定跟随本场出战槽，请在赛前选择后调整。" if _ui_is_zh() else "Summon-pair bindings belong to this match's sortie slots; adjust after choosing them pre-battle."
		"bind_clear":
			editor_summary_label.text = "召唤组合键绑定跟随本场出战槽，请在赛前选择后调整。" if _ui_is_zh() else "Summon-pair bindings belong to this match's sortie slots; adjust after choosing them pre-battle."
		"prev_catalog":
			if editor_panel_mode == "load":
				editor_load_page = max(0, editor_load_page - 1)
				_update_editor_ui()
			else:
				editor_catalog_page = max(0, editor_catalog_page - 1)
				mark_editor_dirty(EDITOR_DIRTY_CATALOG | EDITOR_DIRTY_ACTION_BUTTONS, "catalog.prev_page")
				flush_editor_dirty(1200)
		"next_catalog":
			if editor_panel_mode == "load":
				editor_load_page += 1
				_update_editor_ui()
			else:
				editor_catalog_page += 1
				mark_editor_dirty(EDITOR_DIRTY_CATALOG | EDITOR_DIRTY_ACTION_BUTTONS, "catalog.next_page")
				flush_editor_dirty(1200)
		"toggle_templates":
			editor_template_menu_open = not editor_template_menu_open
			_update_editor_ui()
		"blank_canvas":
			editor_template_menu_open = false
			_start_blank_topology()
		"board_tool_layout":
			_set_editor_board_tool("layout")
		"board_tool_pose":
			_set_editor_board_tool("pose")
		"undo_canvas":
			_restore_editor_undo_state()
		"delete_selected_part":
			_delete_selected_canvas_part()
		"clear_canvas":
			_clear_editor_canvas()
		"add_node":
			_add_topology_node()
		"link_node":
			_link_topology_node()
		"set_handedness_left":
			if editor_pending_orientation_node_index >= 0:
				_set_topology_node_visual_handedness(editor_pending_orientation_node_index, "left", false)
		"set_handedness_right":
			if editor_pending_orientation_node_index >= 0:
				_set_topology_node_visual_handedness(editor_pending_orientation_node_index, "right", false)
		"flip_handedness":
			_flip_selected_topology_node_visual_handedness()
		"board_zoom_out":
			_set_editor_board_zoom(editor_board_zoom / EDITOR_BOARD_ZOOM_STEP)
		"board_zoom_in":
			_set_editor_board_zoom(editor_board_zoom * EDITOR_BOARD_ZOOM_STEP)
		"board_zoom_reset":
			_reset_editor_board_zoom()
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("editor_action")


func _start_blank_topology() -> void:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	_reset_editor_working_canvas(role_key)
	var unit_bp: Dictionary = _editor_current_blueprint()
	unit_bp.erase("groups")
	unit_bp["archetype"] = "custom"
	unit_bp["blank_canvas"] = true
	unit_bp.erase("slot_payloads")
	unit_bp["custom_topology"] = _blank_free_canvas_topology()
	editor_topology_node_index = 0
	editor_selected_barrier_cell = -1
	editor_selected_topology_nodes = []
	editor_pending_orientation_node_index = -1
	editor_dragging_node_index = -1
	editor_dragging_selected_nodes = false
	editor_dragging_whole_unit = false
	editor_drag_whole_original_positions = []
	editor_group_drag_original_positions = []
	editor_selecting_topology_box = false
	_cancel_editor_pose_drag(false)
	editor_selected_body_part = BODY_PART_ORDER[0]
	_trigger_editor_snap("blank", "blank topology board")
	editor_board_hint_label.text = "空白单位画布：当前造价为 0；保存后进入单位库，队伍编成时再放入 10 槽或 5 槽队伍。" if _ui_is_zh() else "Blank unit canvas: current cost is 0; save it to the unit library, then compose a 10-slot or 5-slot team later."
	ai_team_manual_lock[player_id] = true
	_update_editor_ui()


func _clear_editor_canvas() -> void:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	_record_editor_undo_state("全部删除" if _ui_is_zh() else "clear all")
	unit_bp["blank_canvas"] = true
	unit_bp.erase("slot_payloads")
	if role_key == "barrier":
		unit_bp["barrier_tiles"] = []
	if _role_uses_body_board(role_key):
		unit_bp.erase("groups")
		unit_bp["archetype"] = "custom"
		unit_bp["custom_topology"] = _blank_free_canvas_topology()
	_cancel_editor_pose_drag(false)
	editor_topology_node_index = 0
	editor_selected_barrier_cell = -1
	editor_selected_topology_nodes = []
	editor_pending_orientation_node_index = -1
	editor_dragging_node_index = -1
	editor_dragging_selected_nodes = false
	editor_dragging_whole_unit = false
	editor_drag_whole_original_positions = []
	editor_group_drag_original_positions = []
	editor_selecting_topology_box = false
	editor_pending_place_slot = ""
	editor_pending_place_index = -1
	editor_pending_orientation_node_index = -1
	editor_board_hint_label.text = "画布已全部删除，当前单位造价为 0；未保存前不属于任何队伍。" if _ui_is_zh() else "Canvas cleared; current unit cost is 0. It belongs to no team until saved."
	ai_team_manual_lock[player_id] = true
	_update_editor_ui()


func _delete_selected_canvas_part() -> void:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	if role_key == "barrier":
		var tiles: Array = Array(unit_bp.get("barrier_tiles", [])).duplicate(true)
		var selected_cell := editor_selected_barrier_cell
		if selected_cell < 0 and not tiles.is_empty() and tiles[tiles.size() - 1] is Dictionary:
			selected_cell = int(Dictionary(tiles[tiles.size() - 1]).get("index", -1))
		if selected_cell < 0:
			if editor_board_hint_label != null:
				editor_board_hint_label.text = "警报：先在结界画布中点选一个格子，再删除。" if _ui_is_zh() else "ALARM: select a barrier cell before deleting."
			_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
			return
		var removed := false
		_record_editor_undo_state("删除选中结界格" if _ui_is_zh() else "delete selected barrier tile")
		for i in range(tiles.size() - 1, -1, -1):
			var tile: Dictionary = tiles[i]
			if int(tile.get("index", -1)) == selected_cell:
				tiles.remove_at(i)
				removed = true
				break
		if not removed:
			if editor_board_hint_label != null:
				editor_board_hint_label.text = "警报：选中的结界格没有可删除零件。" if _ui_is_zh() else "ALARM: selected barrier cell is empty."
			_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
			return
		unit_bp["barrier_tiles"] = tiles
		unit_bp["blank_canvas"] = tiles.is_empty()
		editor_selected_barrier_cell = -1
		_trigger_editor_snap("barrier", "deleted tile")
		ai_team_manual_lock[player_id] = true
		_update_editor_ui()
		return
	if not _role_uses_body_board(role_key):
		if editor_board_hint_label != null:
			editor_board_hint_label.text = "警报：当前页面没有可删除的机体画布零件。" if _ui_is_zh() else "ALARM: this page has no body-board part to delete."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return
	_ensure_custom_topology(unit_bp)
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", [])).duplicate(true)
	if nodes.is_empty():
		if editor_board_hint_label != null:
			editor_board_hint_label.text = "空白画布：没有可删除的构件。" if _ui_is_zh() else "Blank canvas: no component to delete."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return
	var removed_index := clampi(editor_topology_node_index, 0, nodes.size() - 1)
	var removed_node: Dictionary = nodes[removed_index]
	var removed_name := String(removed_node.get("label", "NODE %d" % (removed_index + 1)))
	_record_editor_undo_state("删除选中构件" if _ui_is_zh() else "delete selected component")
	nodes.remove_at(removed_index)
	var old_edges: Array = Array(topology.get("edges", []))
	var edges: Array = []
	for raw_edge in old_edges:
		var a := _topology_edge_node_a(raw_edge)
		var b := _topology_edge_node_b(raw_edge)
		if a == removed_index or b == removed_index:
			continue
		if a > removed_index:
			a -= 1
		if b > removed_index:
			b -= 1
		if a >= 0 and b >= 0 and a < nodes.size() and b < nodes.size() and a != b:
			if raw_edge is Dictionary:
				var shifted_edge: Dictionary = Dictionary(raw_edge).duplicate(true)
				if int(shifted_edge.get("a_node", shifted_edge.get("a", -1))) > removed_index:
					shifted_edge["a_node"] = a
				elif int(shifted_edge.get("a_node", shifted_edge.get("a", -1))) < removed_index:
					shifted_edge["a_node"] = int(shifted_edge.get("a_node", shifted_edge.get("a", -1)))
				if int(shifted_edge.get("b_node", shifted_edge.get("b", -1))) > removed_index:
					shifted_edge["b_node"] = b
				elif int(shifted_edge.get("b_node", shifted_edge.get("b", -1))) < removed_index:
					shifted_edge["b_node"] = int(shifted_edge.get("b_node", shifted_edge.get("b", -1)))
				shifted_edge.erase("a")
				shifted_edge.erase("b")
				edges.append(shifted_edge)
			else:
				edges.append([a, b])
	for i in range(nodes.size()):
		if nodes[i] is Dictionary:
			var node: Dictionary = Dictionary(nodes[i]).duplicate(true)
			node["id"] = i
			nodes[i] = node
	topology["nodes"] = nodes
	topology["edges"] = edges
	unit_bp["custom_topology"] = topology
	unit_bp["blank_canvas"] = nodes.is_empty()
	editor_topology_node_index = clampi(removed_index, 0, maxi(0, nodes.size() - 1))
	editor_selected_topology_nodes = []
	if editor_open_torso_node_index == removed_index or nodes.is_empty():
		editor_open_torso_node_index = -1
	elif editor_open_torso_node_index > removed_index:
		editor_open_torso_node_index -= 1
	editor_hovered_torso_node_index = -1
	editor_dragging_node_index = -1
	editor_dragging_selected_nodes = false
	editor_group_drag_original_positions = []
	editor_selecting_topology_box = false
	editor_pending_place_slot = ""
	editor_pending_place_index = -1
	editor_pending_orientation_node_index = -1
	if editor_board_hint_label != null:
		editor_board_hint_label.text = "已删除：%s。" % removed_name if _ui_is_zh() else "Deleted: %s." % removed_name
	_play_sfx_wave("clack", 520.0, 0.045, -18.0)
	ai_team_manual_lock[player_id] = true
	_update_editor_ui()


func _add_topology_node() -> void:
	var index_hint := _node_position_for_index(_custom_node_count_for_current_unit())
	if _add_topology_node_at(_topology_position_to_board_local(index_hint)) >= 0:
		flush_editor_dirty(2400)


func _custom_node_count_for_current_unit() -> int:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("drop.ensure_topology")
	_ensure_custom_topology(unit_bp)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("drop.ensure_topology")
	var topology: Dictionary = unit_bp["custom_topology"]
	var nodes: Array = topology.get("nodes", [])
	return nodes.size()


func _node_position_for_index(index: int) -> Vector2:
	var angle := -PI * 0.5 + TAU * float(index) / 12.0
	var radius := 0.28 + 0.08 * float(index % 3)
	return _clamp_topology_position(Vector2(0.5 + cos(angle) * radius, 0.5 + sin(angle) * radius))


func _add_topology_node_at(local_position: Vector2) -> int:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	_ensure_custom_topology(unit_bp)
	var topology: Dictionary = unit_bp["custom_topology"]
	var nodes: Array = topology.get("nodes", [])
	if nodes.size() >= TOPOLOGY_MAX_COMPONENT_NODES:
		editor_board_hint_label.text = "警报：当前自由画布最多支持 %d 个构件节点。" % TOPOLOGY_MAX_COMPONENT_NODES if _ui_is_zh() else "ALARM: free canvas supports %d component nodes in this build." % TOPOLOGY_MAX_COMPONENT_NODES
		return -1
	if not _has_pending_canvas_part():
		editor_board_hint_label.text = "警报：先从零件库拖入或点选一个有体积的肌肉构件。" if _ui_is_zh() else "ALARM: drag or choose a physical muscle component from Parts first."
		_play_sfx_wave("alarm", 170.0, 0.1, -14.0)
		return -1
	var previous_blank := bool(unit_bp.get("blank_canvas", false))
	var previous_pending_slot := editor_pending_place_slot
	var previous_pending_index := editor_pending_place_index
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("drop.purchase_commit")
	var purchase_restore := _commit_pending_canvas_part_purchase(unit_bp, previous_pending_slot, previous_pending_index)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("drop.purchase_commit")
	unit_bp["blank_canvas"] = false
	var index := nodes.size()
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("drop.make_node")
	var new_node := _make_topology_node(unit_bp, index, _board_position_to_topology(local_position), editor_pending_place_slot, editor_pending_place_index)
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("drop.append_node")
	nodes.append(new_node)
	editor_last_added_topology_node_index = index
	editor_last_added_topology_node_snapshot = new_node.duplicate(false)
	topology["nodes"] = nodes
	unit_bp["custom_topology"] = topology
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("drop.append_node")
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("drop.make_node")
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("drop.undo.light")
	_push_editor_undo_command({
		"command_type": "remove_node",
		"label": "放置构件" if _ui_is_zh() else "place part",
		"node_index": index,
		"slot_key": previous_pending_slot,
		"part_index": previous_pending_index,
		"previous_blank_canvas": previous_blank,
		"previous_purchased_had_slot": bool(purchase_restore.get("had_slot", false)),
		"previous_purchased_list": Array(purchase_restore.get("previous_list", [])).duplicate(true),
		"previous_pending_slot": "",
		"previous_pending_index": -1,
		"previous_topology_node_index": editor_topology_node_index,
		"previous_selected_topology_nodes": editor_selected_topology_nodes.duplicate(),
	})
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("drop.undo.light")
	editor_topology_node_index = index
	editor_selected_body_part = BODY_PART_ORDER[index % BODY_PART_ORDER.size()]
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("drop.snap_hint")
	var placed_name := String(new_node.get("part_name", ""))
	if placed_name == "":
		placed_name = String(new_node.get("label_short_name", "NODE"))
	editor_pending_place_slot = ""
	editor_pending_place_index = -1
	_trigger_editor_node_drop_snap(placed_name, true)
	_start_visual_handedness_choice_if_needed(unit_bp, index, new_node)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("drop.snap_hint")
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("drop.mark_dirty")
	ai_team_manual_lock[player_id] = true
	_mark_editor_board_model_dirty("board.add_node", false)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("drop.mark_dirty")
	return index


func _link_topology_node() -> void:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	_ensure_custom_topology(unit_bp)
	var topology: Dictionary = unit_bp["custom_topology"]
	var nodes: Array = topology.get("nodes", [])
	if nodes.size() < 2:
		editor_board_hint_label.text = "至少放置两个节点后才能连接。" if _ui_is_zh() else "Add at least two nodes before linking."
		return
	var current := clampi(editor_topology_node_index, 0, nodes.size() - 1)
	var previous := maxi(0, current - 1)
	if current == previous:
		previous = 1
	_link_topology_nodes(unit_bp, current, previous)


func _link_topology_nodes(unit_bp: Dictionary, current: int, previous: int) -> void:
	var topology: Dictionary = unit_bp["custom_topology"]
	var nodes: Array = topology.get("nodes", [])
	if current < 0 or previous < 0 or current >= nodes.size() or previous >= nodes.size() or current == previous:
		return
	var edges: Array = topology.get("edges", [])
	var exists := false
	for edge in edges:
		var a := _topology_edge_node_a(edge)
		var b := _topology_edge_node_b(edge)
		if (a == current and b == previous) or (a == previous and b == current):
			exists = true
			break
	if not exists:
		var socket_error := _topology_socket_edge_error(ROLE_ORDER[editor_role_index], unit_bp, nodes, edges, previous, current)
		if socket_error != "":
			var zh_text := "警报：接口已被占用，或不符合肌肉直连的一对一规则。"
			if socket_error.contains("hard rule"):
				zh_text = "警报：硬性规则，躯干端口/肌肉末端只能连接下游肌肉的根部关节。"
			elif socket_error.contains("terminal muscle"):
				zh_text = "警报：末端肌肉只能用柄端接口连接；刀尖、枪口、拳面等功能端不能拼接。"
			elif socket_error.contains("occupied"):
				zh_text = "警报：这个接口已经被占用；请右键解绑后再重新连接。"
			elif socket_error.contains("material mismatch"):
				_show_editor_material_link_warning([previous, current], socket_error)
				return
			editor_board_hint_label.text = zh_text if _ui_is_zh() else "ALARM: %s" % socket_error
			_play_sfx_wave("alarm", 170.0, 0.12, -13.0)
			return
	if not exists:
		var role_key: String = ROLE_ORDER[editor_role_index]
		var candidate := _topology_socket_candidate_for_pair(role_key, unit_bp, nodes, edges, current, previous, false, true)
		var source_is_current := true
		if candidate.is_empty():
			candidate = _topology_socket_candidate_for_pair(role_key, unit_bp, nodes, edges, previous, current, false, true)
			source_is_current = false
		if candidate.is_empty():
			editor_board_hint_label.text = "警报：没有可用的一对一接口可连接。" if _ui_is_zh() else "ALARM: no free one-to-one sockets are available."
			_play_sfx_wave("alarm", 170.0, 0.12, -13.0)
			return
		var source_socket: Dictionary = candidate.get("socket_a", {})
		var target_socket: Dictionary = candidate.get("socket_b", {})
		if source_is_current:
			if not _topology_append_socket_edge_if_free(role_key, unit_bp, nodes, edges, current, String(source_socket.get("id", "")), previous, String(target_socket.get("id", ""))):
				editor_board_hint_label.text = "警报：该关节槽已占用，请右键解绑后再连接。" if _ui_is_zh() else "ALARM: socket occupied; right-click unlink before reconnecting."
				_play_sfx_wave("alarm", 170.0, 0.12, -13.0)
				return
		else:
			if not _topology_append_socket_edge_if_free(role_key, unit_bp, nodes, edges, previous, String(source_socket.get("id", "")), current, String(target_socket.get("id", ""))):
				editor_board_hint_label.text = "警报：该关节槽已占用，请右键解绑后再连接。" if _ui_is_zh() else "ALARM: socket occupied; right-click unlink before reconnecting."
				_play_sfx_wave("alarm", 170.0, 0.12, -13.0)
				return
	topology["edges"] = edges
	var node: Dictionary = nodes[current]
	node["pos"] = _snap_position_to_fixed_connection(ROLE_ORDER[editor_role_index], unit_bp, nodes, edges, current, _topology_node_position(node))
	nodes[current] = node
	topology["nodes"] = nodes
	topology["edges"] = edges
	unit_bp["custom_topology"] = topology
	_trigger_editor_snap("link", "节点 %d 连接节点 %d" % [previous + 1, current + 1] if _ui_is_zh() else "node %d linked to node %d" % [previous + 1, current + 1])
	ai_team_manual_lock[_editor_player()] = true
	_update_editor_ui()


func _ensure_custom_topology(unit_bp: Dictionary) -> void:
	if unit_bp.has("custom_topology") and _topology_is_canonical_component_graph(Dictionary(unit_bp.get("custom_topology", {}))):
		unit_bp.erase("groups")
		return
	if unit_bp.has("custom_topology"):
		unit_bp["custom_topology"] = _legacy_topology_to_component_graph(ROLE_ORDER[editor_role_index], unit_bp)
	else:
		unit_bp["custom_topology"] = {
			"nodes": [],
			"edges": [],
		}
	unit_bp.erase("groups")
	unit_bp["archetype"] = "custom"


func _make_topology_node(unit_bp: Dictionary, index: int, pos: Vector2, slot_key: String = "", part_index: int = -1) -> Dictionary:
	var resolved_slot := slot_key if _is_topology_part_slot(slot_key) else "limb_muscle"
	var resolved_index := part_index if part_index >= 0 else int(unit_bp.get(resolved_slot, 0))
	var module_index := int(unit_bp.get("module", 0))
	var modules: Array = []
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("drop.component_template")
	var template := _placement_template_for_part(resolved_slot, resolved_index, true)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("drop.component_template")
	if not template.is_empty() and template.has("node_base"):
		var node := Dictionary(template.get("node_base", {})).duplicate(false)
		node["id"] = index
		node["label"] = _topology_component_label_from_short_name(resolved_slot, String(template.get("label_short_name", template.get("part_name", resolved_slot.to_upper()))), index)
		node["pos"] = pos
		node["slot"] = resolved_slot
		node["part_index"] = resolved_index
		if module_index >= 0 or not modules.is_empty():
			var module_list := modules.duplicate(true)
			if module_list.is_empty() and module_index >= 0:
				module_list.append(module_index)
			if not module_list.is_empty():
				node["module"] = module_index if module_index >= 0 else int(module_list[0])
				node["modules"] = module_list
		return node
	var part := _selected_component(ROLE_ORDER[editor_role_index], resolved_slot, resolved_index)
	var node := {
		"id": index,
		"label": _topology_component_label(resolved_slot, part, index),
		"pos": pos,
		"slot": resolved_slot,
		"part_index": resolved_index,
		"part_name": String(part.get("name", "")),
		"size_tier": PartArt.normalized_size_tier(part),
	}
	if resolved_slot == "muscle" and _component_is_torso(part):
		node["is_torso"] = true
		node["material_class"] = "torso"
	elif part.has("root_socket"):
		node["root_socket"] = String(part.get("root_socket", ""))
		if part.has("distal_socket"):
			node["distal_socket"] = String(part.get("distal_socket", ""))
	if resolved_slot == "muscle" and _part_counts_as_terminal_weapon(part, "muscle"):
		node["terminal_weapon"] = true
		node["terminal_weapon_kind"] = _terminal_weapon_kind_for_part(part, "muscle")
		node["projectile"] = _terminal_weapon_kind_for_part(part, "muscle") == "ranged" and bool(part.get("projectile", false))
		_apply_visual_handedness_defaults_to_node(node, part, "muscle")
	if module_index >= 0 or not modules.is_empty():
		var module_list := modules.duplicate(true)
		if module_list.is_empty() and module_index >= 0:
			module_list.append(module_index)
		if not module_list.is_empty():
			node["module"] = module_index if module_index >= 0 else int(module_list[0])
			node["modules"] = module_list
	if not template.is_empty():
		var component_node := Dictionary(template.get("component_node", {}))
		for key in component_node.keys():
			node[key] = component_node[key]
		node["slot"] = resolved_slot
		node["part_name"] = String(template.get("part_name", node.get("part_name", "")))
		node["size_tier"] = String(template.get("size_tier", node.get("size_tier", "")))
		node["component_length"] = float(template.get("component_length", 0.0))
		node["component_radius"] = maxf(0.012, float(template.get("component_radius", node.get("component_radius", 0.04))))
		node["component_mass"] = maxf(0.0, float(template.get("component_mass", node.get("component_mass", 0.0))))
		node["damage_type"] = String(template.get("damage_type", node.get("damage_type", "")))
		node["material_class"] = String(template.get("material_class", node.get("material_class", resolved_slot)))
		node["material_visual"] = String(template.get("material_visual", node.get("material_visual", "")))
		node["projectile_damage_type"] = String(template.get("projectile_damage_type", node.get("projectile_damage_type", "")))
		node["projectile_behavior"] = String(template.get("projectile_behavior", node.get("projectile_behavior", "")))
		node["range"] = float(template.get("range", node.get("range", 0.0)))
		node["archetype"] = String(template.get("archetype", node.get("archetype", "")))
		node["terminal_weapon"] = bool(template.get("terminal_weapon", node.get("terminal_weapon", false)))
		node["connection_ends"] = int(template.get("connection_ends", node.get("connection_ends", 2)))
		node["size_class"] = String(template.get("size_class", node.get("size_class", "")))
		node["shape"] = String(template.get("shape", node.get("shape", resolved_slot)))
		node["projectile"] = bool(template.get("projectile", node.get("projectile", false)))
		node["is_torso"] = bool(template.get("is_torso", node.get("is_torso", false)))
		_apply_visual_handedness_defaults_to_node(node, part, resolved_slot)
		if String(template.get("root_socket", "")) != "":
			node["root_socket"] = String(template.get("root_socket", ""))
		if String(template.get("distal_socket", "")) != "":
			node["distal_socket"] = String(template.get("distal_socket", ""))
	return node


func _archetype_layout(archetype_key: String) -> Array:
	match archetype_key:
		"octopus":
			return [
				{"label": "MANTLE LEFT", "source": "left_claw", "pos": Vector2(0.38, 0.46)},
				{"label": "MANTLE RIGHT", "source": "right_claw", "pos": Vector2(0.62, 0.46), "parent": 0},
				{"label": "TENTACLE A", "source": "front_left_leg", "pos": Vector2(0.24, 0.32), "parent": 0},
				{"label": "TENTACLE B", "source": "front_right_leg", "pos": Vector2(0.76, 0.32), "parent": 1},
