	button.text = "%s  =  %s%s" % [title, value, ("  ·  %s" % note) if note != "" else ""]
	settings_list_container.add_child(button)


func _settings_add_action_row(action_key: String, title: String, value: String, note: String = "") -> Button:
	var button := Button.new()
	button.name = "VideoSetting%s" % action_key.capitalize().replace("_", "")
	button.custom_minimum_size = Vector2(1028.0, 42.0)
	button.focus_mode = Control.FOCUS_NONE
	button.clip_text = true
	button.set_meta("video_action", action_key)
	button.text = "%s  =  %s%s" % [title, value, ("  ·  %s" % note) if note != "" else ""]
	button.mouse_entered.connect(_select_settings_item.bind(settings_labels.size()))
	button.pressed.connect(_activate_settings_item.bind(settings_labels.size()))
	settings_list_container.add_child(button)
	settings_labels.append(button)
	settings_video_buttons[action_key] = button
	return button


func _rebuild_settings_list() -> void:
	if settings_list_container == null:
		return
	for child in settings_list_container.get_children():
		settings_list_container.remove_child(child)
		child.free()
	settings_labels.clear()
	settings_video_buttons.clear()
	battle_input_buttons.clear()
	battle_input_binding_specs = _battle_input_specs()
	match settings_category:
		"input":
			for i in range(battle_input_binding_specs.size()):
				var spec: Dictionary = battle_input_binding_specs[i]
				if bool(spec.get("info", false)):
					_settings_add_info_row(String(spec.get("group_title_zh", "")) if _ui_is_zh() else String(spec.get("group_title_en", spec.get("group_title_zh", ""))))
					continue
				var setting_button := Button.new()
				setting_button.name = "Setting%d" % i
				setting_button.custom_minimum_size = Vector2(1028.0, 38.0)
				setting_button.focus_mode = Control.FOCUS_NONE
				setting_button.clip_text = true
				setting_button.set_meta("spec_index", i)
				setting_button.mouse_entered.connect(_select_settings_item.bind(settings_labels.size()))
				setting_button.pressed.connect(_begin_battle_input_rebind.bind(String(spec.get("action", ""))))
				settings_list_container.add_child(setting_button)
				battle_input_buttons[String(spec.get("action", ""))] = setting_button
				settings_labels.append(setting_button)
		"sound":
			_settings_add_info_row("声音" if _ui_is_zh() else "SOUND")
			_settings_add_static_row("主音量" if _ui_is_zh() else "Master", "80%", "之后接入滑条" if _ui_is_zh() else "slider pending")
			_settings_add_static_row("音乐" if _ui_is_zh() else "Music", "70%")
			_settings_add_static_row("音效" if _ui_is_zh() else "SFX", "85%")
			_settings_add_static_row("命中音" if _ui_is_zh() else "Hit SFX", "90%")
			_settings_add_static_row("UI 音" if _ui_is_zh() else "UI SFX", "80%")
		"video":
			_settings_add_info_row("画面" if _ui_is_zh() else "VIDEO")
			var spec := _performance_profile_spec(performance_profile)
			_settings_add_action_row("performance_profile", "性能档" if _ui_is_zh() else "Performance Profile", _performance_profile_label(performance_profile), "点击切换 4080S/兼容72档" if _ui_is_zh() else "click to cycle 4080S/Compat 72")
			_settings_add_action_row("display_mode", "显示模式" if _ui_is_zh() else "Display Mode", _display_mode_label(display_mode_setting), "窗口/无边框/全屏" if _ui_is_zh() else "window/borderless/full")
			_settings_add_action_row("window_size", "窗口大小" if _ui_is_zh() else "Window Size", _window_size_label(window_size_setting), "窗口模式生效" if _ui_is_zh() else "used in window mode")
			_settings_add_static_row("帧率上限" if _ui_is_zh() else "FPS Cap", str(int(spec.get("fps_cap", 120))))
			_settings_add_static_row("渲染比例" if _ui_is_zh() else "Render Scale", "%.0f%%" % (float(spec.get("render_scale", 1.0)) * 100.0))
			_settings_add_static_row("特效强度" if _ui_is_zh() else "VFX", "%.0f%%" % (float(spec.get("vfx_scale", 1.0)) * 100.0))
			_settings_add_static_row("画板预览" if _ui_is_zh() else "Board Preview", String(spec.get("board_preview_quality", "high")).to_upper())
			_settings_add_static_row("战斗 VFX 预算" if _ui_is_zh() else "Battle VFX Budget", "%d / frame" % int(spec.get("battle_vfx_budget", 260)))
			_settings_add_static_row("投射轨迹预算" if _ui_is_zh() else "Projectile Trace Budget", "%d / frame" % int(spec.get("projectile_trace_budget", 120)))
			_settings_add_static_row("GPU 碰撞" if _ui_is_zh() else "GPU Collision", String(spec.get("gpu_collision_mode", "auto")).to_upper(), gpu_collision_status_note)
		"language":
			_settings_add_info_row("系统语言" if _ui_is_zh() else "LANGUAGE")
			var zh_button := Button.new()
			zh_button.custom_minimum_size = Vector2(1028.0, 42.0)
			zh_button.focus_mode = Control.FOCUS_NONE
			zh_button.text = "中文  %s" % ("✓" if ui_language == UI_LANGUAGE_ZH else "")
			zh_button.pressed.connect(_set_ui_language.bind(UI_LANGUAGE_ZH))
			settings_list_container.add_child(zh_button)
			var en_button := Button.new()
			en_button.custom_minimum_size = Vector2(1028.0, 42.0)
