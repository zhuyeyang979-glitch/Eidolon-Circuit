			canvas.draw_arc(cb, 10.0 + snap_amount * 6.0, 0.0, TAU, 24, Color(1.0, 0.86, 0.18, 0.9), 2.0)
		for highlight_key in material_highlights.keys():
			var node_index := int(highlight_key)
			if node_index < 0 or node_index >= nodes.size():
