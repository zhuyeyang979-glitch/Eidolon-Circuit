		_set_control_text_if_changed(editor_board_hint_label, "侧挂刃朝向稍后可用“翻侧刃”调整。" if _ui_is_zh() else "Side-mounted blade can be adjusted later with FLIP SIDE.")
	_refresh_editor_orientation_buttons()
