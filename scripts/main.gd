func _update_settings_ui() -> void:
	_set_named_label(settings_layer, "SettingsTitle", _settings_category_label(settings_category))
	var category_controls := {}
	var category_state := {}
	for category_key in settings_category_buttons.keys():
		var category_button: Button = settings_category_buttons[category_key]
		category_controls[category_key] = category_button
		category_state[category_key] = _ui_text_state(
			_settings_category_label(String(category_key)),
			Color(0.35, 0.95, 1.0, 1.0) if String(category_key) == settings_category else Color(0.86, 0.9, 0.94, 1.0)
		)
	_apply_ui_state(category_controls, category_state)
	var input_controls := {}
	var input_state := {}
	for i in range(settings_labels.size()):
		var button: Button = settings_labels[i]
		if button.has_meta("video_action"):
			var selected_video := i == settings_index
			var action_note := "点击切换画面设置" if _ui_is_zh() else "Click to cycle video setting"
			match String(button.get_meta("video_action", "")):
				"performance_profile":
					action_note = "点击切换性能档" if _ui_is_zh() else "Click to cycle performance profile"
				"display_mode":
					action_note = "窗口 / 无边框全屏 / 全屏" if _ui_is_zh() else "Window / Borderless / Fullscreen"
				"window_size":
					action_note = "窗口尺寸；无边框全屏会使用当前显示器" if _ui_is_zh() else "Window size; borderless uses the current display"
			input_controls["video_%d" % i] = button
			input_state["video_%d" % i] = _ui_text_state(
				String(button.text),
				Color(0.35, 0.95, 1.0, 1.0) if selected_video else Color(0.86, 0.9, 0.94, 1.0),
				null,
				false,
				action_note
			)
			continue
		var spec_index := int(button.get_meta("spec_index", -1))
		var spec: Dictionary = battle_input_binding_specs[spec_index] if spec_index >= 0 and spec_index < battle_input_binding_specs.size() else {}
		var label := String(spec.get("zh", "")) if _ui_is_zh() else String(spec.get("en", spec.get("zh", "")))
		var action_name := String(spec.get("action", ""))
		var binding_text := _action_binding_label(action_name)
		var prefix := "> " if i == settings_index else "  "
		var next_text := ""
		var next_color := Color(0.86, 0.9, 0.94, 1.0)
		if settings_rebind_action == action_name:
			next_text = "%s%s  [%s]" % [prefix, label, "监听中..." if _ui_is_zh() else "LISTENING..."]
			next_color = Color(1.0, 0.86, 0.28, 1.0)
		else:
			next_text = "%s%s  =  %s" % [prefix, label, binding_text]
			next_color = Color(0.35, 0.95, 1.0, 1.0) if i == settings_index else Color(0.86, 0.9, 0.94, 1.0)
		input_controls["input_%d" % i] = button
		input_state["input_%d" % i] = _ui_text_state(next_text, next_color)
	_apply_ui_state(input_controls, input_state)
	if settings_rebind_status_label != null and settings_rebind_action == "":
		var status_text := ""
		if settings_category == "input":
			status_text = "点击一项后按键盘键或手柄输入来重绑定。Boost 默认由方向键双击触发。" if _ui_is_zh() else "Click an item, then press a keyboard or controller input. Boost is direction double-tap by default."
		elif settings_category == "video":
			status_text = _runtime_quality_summary()
		else:
			status_text = "设置页已分为声音、画面、系统语言和按键绑定；具体说明在滚动面板内。" if _ui_is_zh() else "Settings are split into sound, video, language, and input pages; details are in the scroll panel."
		_apply_ui_state({"status": settings_rebind_status_label}, {"status": _ui_text_state(status_text)})
	if settings_reset_button != null:
		_apply_ui_state({"reset": settings_reset_button}, {"reset": _ui_text_state(("恢复本页默认" if settings_category != "root" else "恢复全部默认") if _ui_is_zh() else ("RESET PAGE" if settings_category != "root" else "RESET ALL"))})


func _controlled_player_id_for_battle_gauge() -> int:
	if game_state != STATE_BATTLE:
		return 0
	if battle_mode == MODE_AI:
		return ai_battle_seat if [1, 2].has(ai_battle_seat) else 0
	if battle_mode == MODE_TRAINING:
		if ai_battle_seat == 2:
			return 2
		if ai_battle_seat == 3:
			return 0
		return 1
	if battle_mode == MODE_PVP:
		return 1
	return 1


func _controlled_unit_for_battle_gauge():
	var player_id := _controlled_player_id_for_battle_gauge()
	if player_id <= 0 or not active_units.has(player_id):
		return null
	var hero = active_units[player_id].get("hero", null)
	return hero if _is_live_unit(hero) else null


func _live_unit_ammo_summary(unit) -> Dictionary:
	var current := 0
	var capacity := 0
	if unit != null and is_instance_valid(unit):
		for ammo_type in AMMO_TYPES:
			current += _current_ammo(unit, ammo_type)
			capacity += _ammo_capacity_for(unit, ammo_type)
	return {"current": current, "capacity": capacity}


func _live_unit_ammo_breakdown(unit) -> Dictionary:
	var breakdown := {}
	if unit != null and is_instance_valid(unit):
		for ammo_type in AMMO_TYPES:
			var capacity := _ammo_capacity_for(unit, ammo_type)
			var current := _current_ammo(unit, ammo_type)
			if capacity > 0 or current > 0:
				breakdown[ammo_type] = {"current": current, "capacity": capacity}
	return breakdown


func _update_battle_instrument_gauge() -> void:
	if battle_instrument_gauge == null:
		return
	var unit = _controlled_unit_for_battle_gauge()
	if not _is_live_unit(unit):
		battle_instrument_gauge.visible = false
		return
	var speed: float = unit.velocity.length()
	var boost_speed := float(unit.stats.get("boost_speed", 0.0))
	var body_speed := float(unit.stats.get("move_speed", 0.0))
	var configured_limit := maxf(0.0, float(unit.stats.get("speedometer_max_speed", 0.0)))
	var fallback_limit := maxf(1.0, maxf(boost_speed * 2.0, body_speed * 3.0) * 1.5)
	var speed_max: float = maxf(speed, configured_limit if configured_limit > 0.001 else fallback_limit)
	var ammo := _live_unit_ammo_breakdown(unit)
	battle_instrument_gauge.visible = true
	battle_instrument_gauge.set_values(speed, speed_max, ammo, ui_language)


func _update_battle_ui() -> void:
	var now_msec := Time.get_ticks_msec()
	_update_arena_boundary_lines()
	if now_msec - battle_ui_last_minimap_msec >= 100:
		battle_ui_last_minimap_msec = now_msec
		_update_battle_minimap()
	var heavy_update := now_msec - battle_ui_last_heavy_msec >= 160
	if heavy_update:
		battle_ui_last_heavy_msec = now_msec
		var hud_controls := {}
		var hud_state := {}
		hud_controls["mode"] = battle_mode_label
		hud_state["mode"] = _ui_text_state(_battle_mode_title())
		var minutes := int(floorf(match_time_remaining / 60.0))
		var seconds := int(floorf(fmod(match_time_remaining, 60.0)))
		hud_controls["timer"] = match_timer_label
		hud_state["timer"] = _ui_text_state("%02d:%02d" % [minutes, seconds])
		for player_id in [1, 2]:
			hud_controls["p%d_resource" % player_id] = resource_labels[player_id]
			hud_state["p%d_resource" % player_id] = _ui_text_state("P%d %s %d" % [player_id, _ui_term("resource"), int(runtime_resource[player_id])])
			hud_controls["p%d_victory" % player_id] = victory_labels[player_id]
			hud_state["p%d_victory" % player_id] = _ui_text_state("%s %d/%d" % [_ui_term("victory_points"), int(victory_points[player_id]), WIN_POINTS])
			var portal: Dictionary = PORTALS[int(portal_index[player_id])]
			hud_controls["p%d_portal" % player_id] = portal_labels[player_id]
			hud_state["p%d_portal" % player_id] = _ui_text_state("%s %s  %s" % [_ui_term("portal"), String(portal["name"]), _sortie_discount_status(player_id, 3)])
			var statuses := [
				_role_status_text(player_id, "hero"),
				_role_status_text(player_id, "puppet"),
				_role_status_text(player_id, "barrier"),
			]
			for i in range(3):
				var role_key: String = ROLE_ORDER[i]
				var hp_ratio := _role_health_ratio(player_id, role_key)
				var shield_ratio := _role_shield_ratio(player_id, role_key)
				var heat_ratio := _role_heat_ratio(player_id, role_key) if heat_hud_enabled else 0.0
				if role_health_fills[player_id][role_key] != null:
					role_health_fills[player_id][role_key].color = _team_primary_color(player_id).lerp(_team_accent_color(player_id), 0.18)
				if role_shield_fills[player_id][role_key] != null:
					role_shield_fills[player_id][role_key].color = _shield_bar_color(player_id)
				if role_key == "puppet":
					_set_canvas_item_visible_if_changed(role_health_fills[player_id][role_key], false)
					_set_canvas_item_visible_if_changed(role_shield_fills[player_id][role_key], false)
					_set_puppet_segment_bar(player_id, 330.0)
				else:
					_set_corner_bar(role_health_fills[player_id][role_key], player_id, 330.0, hp_ratio)
					_set_shield_corner_bar(role_shield_fills[player_id][role_key], player_id, 330.0, shield_ratio)
					_set_canvas_item_visible_if_changed(role_shield_fills[player_id][role_key], shield_ratio > 0.001)
				_set_corner_bar(role_heat_fills[player_id][role_key], player_id, 330.0, heat_ratio)
				hud_controls["p%d_%s_bar" % [player_id, role_key]] = role_bar_labels[player_id][role_key]
				hud_state["p%d_%s_bar" % [player_id, role_key]] = _ui_text_state(_role_bar_text(player_id, role_key))
				hud_controls["p%d_status_%d" % [player_id, i]] = unit_status_labels[player_id][i]
				hud_state["p%d_status_%d" % [player_id, i]] = _ui_text_state(statuses[i])
			var hero = active_units[player_id]["hero"]
			if hero_ammo_labels.get(player_id, null) != null:
				var ammo_display := _unit_ammo_display_text(hero) if _is_live_unit(hero) else ""
				hud_controls["p%d_hero_ammo" % player_id] = hero_ammo_labels[player_id]
				hud_state["p%d_hero_ammo" % player_id] = _ui_text_state(ammo_display, Color(-1.0, -1.0, -1.0, -1.0), ammo_display != "")
		_apply_ui_state(hud_controls, hud_state)
	if now_msec - battle_ui_last_sortie_msec >= 5000:
		battle_ui_last_sortie_msec = now_msec
		_update_sortie_thumbnails()
	_apply_ui_state({"message": battle_message_label}, {"message": _ui_text_state(battle_message)})
	_update_battle_instrument_gauge()


func _update_sortie_thumbnails() -> void:
	for player_id in [1, 2]:
		if not sortie_thumbnail_views.has(player_id):
			continue
		var views: Array = sortie_thumbnail_views[player_id]
		var order := _team_sortie_order(player_id)
		for i in range(views.size()):
			var view: SortieThumbView = views[i]
			if i >= order.size():
				view.visible = false
				continue
			var entry: Dictionary = order[i]
			var role_key := String(entry.get("role", "hero"))
			var unit_index := int(entry.get("index", 0))
			var stats := _compute_unit_stats(player_id, role_key, unit_index)
			view.visible = true
			view.set_entry(player_id, i, entry, stats, _sortie_entry_status(player_id, entry), ui_language)


func _sortie_entry_status(player_id: int, entry: Dictionary) -> String:
	if not _valid_roster_entry(player_id, entry):
		return "empty"
	var role_key := String(entry.get("role", "hero"))
	var unit_index := int(entry.get("index", 0))
	if _role_pending(player_id, role_key) and int(active_roster_indices[player_id].get(role_key, -1)) == unit_index:
		return "pending"
	if _sortie_entry_is_live(player_id, role_key, unit_index):
		return "live"
	return "reserve"


func _sortie_entry_is_live(player_id: int, role_key: String, unit_index: int) -> bool:
	if role_key == "puppet":
		for unit in active_units[player_id]["puppet"]:
			if _is_live_unit(unit) and not _is_temporary_fracture_puppet(unit) and int(unit.stats.get("unit_index", -1)) == unit_index:
				return true
		return false
	var unit = active_units[player_id][role_key]
	return _is_live_unit(unit) and int(unit.stats.get("unit_index", -1)) == unit_index


func _flash_sortie_thumbnail(player_id: int, role_key: String, unit_index: int) -> void:
	if not sortie_thumbnail_views.has(player_id):
		return
	var order := _team_sortie_order(player_id)
	for i in range(mini(order.size(), Array(sortie_thumbnail_views[player_id]).size())):
		var entry: Dictionary = order[i]
		if String(entry.get("role", "")) == role_key and int(entry.get("index", -1)) == unit_index:
			var view: SortieThumbView = Array(sortie_thumbnail_views[player_id])[i]
			if view != null:
				view.trigger_flash()
			return


func _update_battle_minimap() -> void:
	if battle_minimap_view == null:
		return
	var unit_points: Array = []
	for unit in all_units:
		if not _is_live_unit(unit):
			continue
		if _barrier_has_map_tiles(unit):
			for raw_tile in Array(unit.stats.get("barrier_map_tiles", [])):
				if not (raw_tile is Dictionary):
					continue
				var tile: Dictionary = raw_tile
				var tile_pos := _barrier_tile_world_position(unit, tile, true)
				unit_points.append({
					"ring": float(tile_pos.x),
					"lane": float(tile_pos.y),
					"owner": int(unit.owner_id),
					"role": "space_debris" if bool(unit.get_meta("space_debris", false)) else "barrier_piece",
					"radius": maxf(0.12, float(tile.get("radius", 0.12)) + float(tile.get("length", 0.2)) * 0.16),
				})
			continue
		unit_points.append({
			"ring": float(unit.ring_pos),
			"lane": float(unit.lane),
			"owner": int(unit.owner_id),
			"role": String(unit.role),
			"radius": float(unit.stats.get("radius", 0.18)),
		})
	battle_minimap_view.set_world(unit_points, camera_center, camera_lane_center)


func _update_arena_boundary_lines() -> void:
	if arena_top_boundary_line != null:
		arena_top_boundary_line.visible = false
	if arena_bottom_boundary_line != null:
		arena_bottom_boundary_line.visible = false


func _update_single_world_boundary_line(line: Line2D, lane_value: float, base_color: Color) -> void:
	if line == null:
		return
	if mobius_enabled:
		var points := _mobius_boundary_points(lane_value)
		line.visible = points.size() >= 2
		if not line.visible:
			return
		var edge_distance := BATTLE_HALF_HEIGHT - absf(camera_lane_center)
		var proximity := 1.0 - clampf(edge_distance / maxf(0.001, MOBIUS_EDGE_FOG_WIDTH * 3.2), 0.0, 1.0)
		line.default_color = Color(base_color.r, base_color.g, base_color.b, 0.055 + proximity * 0.17)
		line.width = 24.0 + proximity * 22.0
		line.points = points
		return
	var screen_scale := ARENA_HEIGHT / VIEW_HEIGHT
	var y := (ARENA_TOP + ARENA_BOTTOM) * 0.5 + (lane_value - camera_lane_center) * screen_scale
	var margin := 54.0
	var visible := y >= ARENA_TOP - margin and y <= ARENA_BOTTOM + margin
	line.visible = visible
	if not visible:
		return
	var distance_to_view := minf(absf(y - ARENA_TOP), absf(y - ARENA_BOTTOM))
	var proximity := 1.0 - clampf(distance_to_view / 160.0, 0.0, 1.0)
	var alpha := 0.3 + proximity * 0.48
	line.default_color = Color(base_color.r, base_color.g, base_color.b, alpha)
	line.width = 10.0 + proximity * 10.0
	line.points = PackedVector2Array([Vector2(ARENA_LEFT, y), Vector2(ARENA_RIGHT, y)])


func _mobius_config() -> Dictionary:
	var screen_rect := Rect2(Vector2(ARENA_LEFT, ARENA_TOP), Vector2(ARENA_WIDTH, ARENA_HEIGHT))
	var config := MobiusWorld.default_config(RING_LENGTH, BATTLE_HALF_HEIGHT * 2.0, VIEW_WIDTH, VIEW_HEIGHT, screen_rect)
	config["enabled"] = mobius_enabled
	config["surface_segments"] = MOBIUS_SURFACE_SEGMENTS
	config["width_segments"] = MOBIUS_WIDTH_SEGMENTS
	config["near_scale"] = MOBIUS_NEAR_SCALE
	config["far_scale"] = MOBIUS_FAR_SCALE
	config["depth_strength"] = MOBIUS_DEPTH_STRENGTH
	config["parallax_strength"] = MOBIUS_PARALLAX_STRENGTH
	config["rotation_interval_min"] = MOBIUS_TWIST_INTERVAL_MIN
	config["rotation_interval_max"] = MOBIUS_TWIST_INTERVAL_MAX
	config["rotation_blend_seconds"] = MOBIUS_TWIST_BLEND_SECONDS
	config["twist_wave_speed"] = MOBIUS_TWIST_WAVE_SPEED
	config["twist_wave_amplitude"] = MOBIUS_TWIST_WAVE_AMPLITUDE
	config["twist_wave_scale"] = MOBIUS_TWIST_WAVE_SCALE
	config["boundary_fog_width"] = MOBIUS_BOUNDARY_FOG_WIDTH
	config["frame_rotation_strength"] = MOBIUS_FRAME_ROTATION_STRENGTH
	config["input_frame_strength"] = MOBIUS_INPUT_FRAME_STRENGTH
	config["fairness_radius"] = MOBIUS_FAIRNESS_RADIUS
	config["edge_fog_width"] = MOBIUS_EDGE_FOG_WIDTH
	config["surface_detail_density"] = MOBIUS_SURFACE_DETAIL_DENSITY
	config["near_alpha"] = MOBIUS_NEAR_ALPHA
	config["far_alpha"] = MOBIUS_FAR_ALPHA
	config["depth_contrast"] = MOBIUS_DEPTH_CONTRAST
	config["surface_lane_guides_enabled"] = false
	config["stardust_band_enabled"] = true
	config["stardust_alpha_max"] = 0.28
	config["stardust_width_min"] = 2.4
	config["stardust_width_max"] = 13.5
	config["stardust_source_width_px"] = 6.0
	config["stardust_source_alpha"] = 0.115
	config["stardust_particle_source_radius_px"] = 1.15
	config["stardust_particle_budget"] = 192
	config["screen_scale"] = _battle_world_to_screen_scale()
	config["local_rectangular_projection"] = true
	config["show_surface_boundary_guides"] = false
	return config


func _mobius_camera_coord() -> Vector2:
	return Vector2(camera_mobius_s, camera_lane_center)


func _camera_lane_center_limit() -> float:
	return maxf(0.0, BATTLE_HALF_HEIGHT - VIEW_HEIGHT * 0.5)


func _clamp_camera_lane_center(lane_value: float) -> float:
	var limit := _camera_lane_center_limit()
	return clampf(lane_value, -limit, limit)


func _mobius_project_coord(coord: Vector2) -> Dictionary:
	if not mobius_enabled:
		return {}
	return MobiusWorld.project_to_screen(coord, _mobius_camera_coord(), _mobius_config(), mobius_rotation_state)


func _project_combat_coord_to_screen(coord: Vector2) -> Dictionary:
	if mobius_enabled:
		return _mobius_project_coord(coord)
	return _screen_from_ring(coord.x, coord.y)


func _mobius_surface_input_for_unit(unit, input_vector: Vector2) -> Vector2:
	var readable_input := GameplayTransform.screen_input_to_gameplay_motion(input_vector)
	if not mobius_enabled or readable_input.length() <= 0.04:
		return readable_input
	var coord := _unit_mobius_coord(unit) if _is_live_unit(unit) else _mobius_camera_coord()
	var surface_input := MobiusWorld.screen_input_to_surface_motion(readable_input, coord, _mobius_camera_coord(), _mobius_config(), mobius_rotation_state)
	if surface_input.length() <= 0.001:
		return readable_input
	if absf(readable_input.y) >= absf(readable_input.x) and absf(readable_input.y) > 0.04:
		if absf(surface_input.y) <= 0.001 or signf(surface_input.y) != signf(readable_input.y):
			surface_input.y = readable_input.y
			surface_input = surface_input.normalized() * clampf(readable_input.length(), 0.0, 1.0)
	return surface_input


func _mobius_boundary_points(lane_value: float) -> PackedVector2Array:
	var points := PackedVector2Array()
	var config := _mobius_config()
	config["twist_visual_enabled"] = true
	var segment_count := 72
	var span := VIEW_WIDTH * 1.2
	for i in range(segment_count + 1):
		var t := float(i) / float(segment_count)
		var s := camera_mobius_s + lerpf(-span, span, t)
		var projection := MobiusWorld.project_to_screen(Vector2(s, lane_value), _mobius_camera_coord(), config, mobius_rotation_state)
		points.append(projection.get("position", Vector2.ZERO))
	return points


func _tick_mobius_visual_twist(delta: float) -> void:
	if not mobius_enabled:
		return
	mobius_rotation_state = MobiusWorld.advance_rotation_state(mobius_rotation_state, delta, _mobius_config())


func _tick_mobius_visual_rotation(delta: float) -> void:
	_tick_mobius_visual_twist(delta)


func _sync_camera_mobius_from_compat() -> void:
	camera_mobius_s = MobiusWorld.nearest_lifted_s(camera_mobius_s, camera_center, RING_LENGTH)
	camera_center = fposmod(camera_mobius_s, RING_LENGTH)


func _sync_unit_mobius_from_compat(unit) -> void:
	if unit != null and is_instance_valid(unit) and unit.has_method("sync_mobius_from_compat"):
		unit.sync_mobius_from_compat(RING_LENGTH)


func _unit_mobius_coord(unit) -> Vector2:
	if unit != null and is_instance_valid(unit) and unit.get("mobius_s") != null:
		return Vector2(float(unit.get("mobius_s")), float(unit.get("mobius_v")))
	return MobiusWorld.lift_ring_lane_near(camera_mobius_s, float(unit.ring_pos), float(unit.lane), RING_LENGTH) if unit != null and is_instance_valid(unit) else Vector2.ZERO


func _unit_combat_coord(unit) -> Vector2:
	if unit == null or not is_instance_valid(unit):
		return Vector2.ZERO
	if mobius_enabled:
		return _unit_mobius_coord(unit)
	return Vector2(float(unit.ring_pos), float(unit.lane))


func _combat_patch_origin_for_unit(unit) -> Vector2:
	if not _is_live_unit(unit):
		return Vector2.ZERO
	return _unit_combat_coord(unit)


func _mobius_local_patch_delta_from_coord(from_coord: Vector2, to_ring: float, to_lane: float, lane_scale: float = 1.0) -> Vector2:
	var to_coord := MobiusWorld.lift_ring_lane_near(from_coord.x, to_ring, to_lane, RING_LENGTH)
	var result := MobiusWorld.delta_vec(from_coord, to_coord, RING_LENGTH)
	result.y *= lane_scale
	return result


func _mobius_delta_vec_between(from_unit, to_unit, lane_scale: float = 1.0) -> Vector2:
	return GameplayTransform.unit_delta(from_unit, to_unit, RING_LENGTH, lane_scale)


func _mobius_delta_points(from_ring: float, from_lane: float, to_ring: float, to_lane: float, lane_scale: float = 1.0) -> Vector2:
	if not mobius_enabled:
		return GameplayTransform.point_delta(from_ring, from_lane, to_ring, to_lane, camera_mobius_s, RING_LENGTH, lane_scale)
	var from_coord := Vector2(from_ring, from_lane)
	if from_ring >= 0.0 and from_ring < RING_LENGTH:
		from_coord = MobiusWorld.lift_ring_lane_near(camera_mobius_s, from_ring, from_lane, RING_LENGTH)
	return _mobius_local_patch_delta_from_coord(from_coord, to_ring, to_lane, lane_scale)


func _mobius_delta_unit_to_point(unit, to_ring: float, to_lane: float, lane_scale: float = 1.0) -> Vector2:
	return GameplayTransform.unit_to_point_delta(unit, to_ring, to_lane, RING_LENGTH, lane_scale)


func _refresh_mobius_surface_view() -> void:
	if mobius_strip_surface_view == null:
		return
	var mobius_battle_visible := mobius_enabled and game_state == STATE_BATTLE
	mobius_strip_surface_view.visible = mobius_battle_visible
