func _ai_named_combo_unit(unit_name: String, role_key: String, special_name: String, torso_name: String, joint_name: String, limb_name: String, terminal_names: Array, module_names: Array, booster_name: String = "", engine_name: String = "", cooling_name: String = "", ai_profile: String = "direct") -> Dictionary:
	var special_fallback := 3 if role_key == "hero" else 0
	var torso_fallback := 85 if role_key == "hero" else 95
	var special_index := _component_index_by_name(role_key, "special", special_name, special_fallback)
	var torso_index := _component_index_by_name(role_key, "muscle", torso_name, torso_fallback)
	var joint_index := _component_index_by_name(role_key, "joint", joint_name, 16)
	var limb_index := _component_index_by_name(role_key, "limb_muscle", limb_name, 0)
	var booster_index := _component_index_by_name(role_key, "booster", booster_name, 0) if booster_name != "" else 0
	var engine_index := _component_index_by_name(role_key, "engine", engine_name, 5) if engine_name != "" else 5
	var cooling_index := _component_index_by_name(role_key, "cooling", cooling_name, 5) if cooling_name != "" else 5
	var primary_module_name := String(module_names[0]) if not module_names.is_empty() else "COMBO ROUTER: BALANCE STRING"
	var primary_module_index := _component_index_by_name(role_key, "module", primary_module_name, 5)
	var unit_bp := {
		"name": unit_name,
		"archetype": "custom",
		"special": special_index,
		"joint": joint_index,
		"limb_muscle": limb_index,
		"muscle": torso_index,
		"booster": booster_index,
		"engine": engine_index,
		"cooling": cooling_index,
		"module": primary_module_index,
		"ai_profile": ai_profile,
	}
	var nodes: Array = []
	var edges: Array = []
	var root_index := _append_component_root_node(nodes, "CORE", Vector2(0.5, 0.5), torso_index)
	var directions := [Vector2.RIGHT, Vector2.LEFT, Vector2.UP, Vector2.DOWN, Vector2(0.85, -0.65), Vector2(-0.85, -0.65)]
	var paired_key_by_module := {}
	var next_attack_key := 1
	var terminal_count := maxi(1, terminal_names.size())
	for i in range(terminal_count):
		var terminal_name := String(terminal_names[i]) if i < terminal_names.size() else "LIGHT RIFLE MUSCLE"
		var module_name := String(module_names[i % module_names.size()]) if not module_names.is_empty() else primary_module_name
		var terminal_index := _component_index_by_name(role_key, "muscle", terminal_name, int(unit_bp.get("muscle", torso_index)))
		var module_index := _component_index_by_name(role_key, "module", module_name, primary_module_index)
		var before := nodes.size()
		_append_component_limb_chain(
			role_key,
			unit_bp,
			nodes,
			edges,
			root_index,
			"STYLE %d" % (i + 1),
			Vector2(0.5, 0.5) + directions[i % directions.size()].normalized() * 0.28,
			joint_index,
			limb_index,
			terminal_index,
			[module_index]
		)
		var module_part := _selected_component(role_key, "module", module_index)
		if before >= 0 and before < nodes.size():
			var proximal_node: Dictionary = nodes[before]
			if bool(module_part.get("requires_joint_pair", false)):
				if not paired_key_by_module.has(module_index):
					paired_key_by_module[module_index] = clampi(next_attack_key, 1, ATTACK_GROUP_COUNT)
					next_attack_key += 1
				proximal_node["attack_key"] = int(paired_key_by_module[module_index])
			else:
				proximal_node["attack_key"] = clampi(next_attack_key, 1, ATTACK_GROUP_COUNT)
				next_attack_key += 1
			nodes[before] = proximal_node
	unit_bp["custom_topology"] = {"nodes": nodes, "edges": edges, "edge_snap_version": TOPOLOGY_SNAP_VERSION}
	_snap_all_topology_edges(role_key, unit_bp)
	return unit_bp


func _ai_style_barrier_unit(unit_name: String, special_name: String, tile_names: Array, module_name: String = "", engine_name: String = "", cooling_name: String = "") -> Dictionary:
	var special_index := _component_index_by_name("barrier", "special", special_name, 0)
	var module_index := _component_index_by_name("barrier", "module", module_name, 10) if module_name != "" else 10
	var engine_index := _component_index_by_name("barrier", "engine", engine_name, 0) if engine_name != "" else 0
	var cooling_index := _component_index_by_name("barrier", "cooling", cooling_name, 0) if cooling_name != "" else 0
	var tiles: Array = []
	var tile_slots := [2, 6, 8, 12, 16, 18, 22, 26, 28, 32, 36, 38, 42]
	for i in range(tile_names.size()):
		var tile_name := String(tile_names[i])
		var muscle_index := _component_index_by_exact_name("barrier", "muscle", tile_name)
		var joint_index := _component_index_by_exact_name("barrier", "joint", tile_name)
		var tile := {"index": tile_slots[i % tile_slots.size()]}
		if joint_index >= 0:
			tile["joint"] = joint_index
		else:
			tile["muscle"] = muscle_index if muscle_index >= 0 else 14
		tiles.append(tile)
	return {
		"name": unit_name,
		"special": special_index,
		"joint": 30,
		"muscle": 14,
		"booster": 0,
		"engine": engine_index,
		"cooling": cooling_index,
		"module": module_index,
		"barrier_tiles": tiles,
	}


func _ai_compact_barrier_unit(unit_name: String, special_name: String, tile_names: Array, module_name: String = "") -> Dictionary:
	var unit_bp := _ai_style_barrier_unit(unit_name, special_name, tile_names, module_name)
	unit_bp["generated_by_teamedit"] = true
	unit_bp["teamedit_pipeline_version"] = 2
	unit_bp["ai_shape_template"] = false
