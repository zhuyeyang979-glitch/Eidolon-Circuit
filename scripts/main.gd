		gun.erase(legacy_damage_key)
	gun["gun_projectile_damage_mult"] = _gun_projectile_damage_mult_max_for_data(gun)
	return gun


func _joint_default_fixed_output_momentum(source_joint: Dictionary, capacity: float) -> float:
	if bool(source_joint.get("fixed_corner_joint", false)) or String(source_joint.get("shape", "")).to_lower().contains("corner"):
		return 0.0
	if source_joint.has("fixed_output_momentum"):
		return maxf(0.0, float(source_joint["fixed_output_momentum"]))
	var range_value := maxf(0.0, float(source_joint.get("range", 0.0)))
	var raw_length := maxf(0.03, float(source_joint.get("length", source_joint.get("raw_length", 0.12))))
	var joint_power := _joint_output_power(source_joint)
	var mass_hint := maxf(0.6, float(source_joint.get("mass", 1.0)))
	var estimate := joint_power * 145.0 + range_value * 260.0 + raw_length * 95.0 + mass_hint * 3.5
	if capacity > 0.0:
		estimate = minf(estimate, capacity * 0.82)
	return clampf(estimate, 18.0, 7200.0)


func _software_joint_component(part: Dictionary) -> Dictionary:
	var software_joint := part.duplicate(true)
	var raw_length := float(software_joint.get("length", 0.0))
	var raw_radius := float(software_joint.get("radius", maxf(0.0, raw_length * 0.5)))
	software_joint["software_joint"] = true
	software_joint["joint_is_software"] = true
	software_joint["connection_ends"] = 2
	software_joint["raw_length"] = raw_length
	software_joint["raw_radius"] = raw_radius
	if not software_joint.has("momentum_capacity"):
		if software_joint.has("load_capacity"):
			software_joint["momentum_capacity"] = maxf(0.0, float(software_joint["load_capacity"]))
		else:
			software_joint["momentum_capacity"] = _part_stiffness(part, "joint")
	if not software_joint.has("fixed_output_momentum"):
		software_joint["fixed_output_momentum"] = _joint_default_fixed_output_momentum(part, float(software_joint.get("momentum_capacity", 0.0)))
	software_joint["hp"] = 0
	software_joint["length"] = 0.0
	software_joint["radius"] = 0.0
	software_joint["physical_volume"] = 0.0
	software_joint["collision_radius"] = 0.0
	return software_joint


func _selected_component(role_key: String, slot_key: String, index: int) -> Dictionary:
	var catalog: Array = _catalog_for(role_key, slot_key)
	var part: Dictionary = catalog[clampi(index, 0, catalog.size() - 1)]
	return _normalized_catalog_part(slot_key, part, "selected")


func _blueprint_for(player_id: int, role_key: String, unit_index: int) -> Dictionary:
	if not blueprints.has(player_id) or not blueprints[player_id].has(role_key):
		return _make_editor_blank_blueprint(role_key)
	var roster: Array = blueprints[player_id][role_key]
	if roster.is_empty():
		return _make_editor_blank_blueprint(role_key)
	var resolved_index := clampi(unit_index, 0, roster.size() - 1)
	var unit_bp: Dictionary = roster[resolved_index]
	if _role_uses_body_board(role_key):
		_normalize_unit_to_component_topology(role_key, unit_bp)
		roster[resolved_index] = unit_bp
	if _role_uses_body_board(role_key) and unit_bp.has("custom_topology"):
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		if int(topology.get("edge_snap_version", 0)) < TOPOLOGY_SNAP_VERSION:
			_snap_all_topology_edges(role_key, unit_bp)
			roster[resolved_index] = unit_bp
	return unit_bp


func _normalize_unit_to_component_topology(role_key: String, unit_bp: Dictionary) -> void:
	if not _role_uses_body_board(role_key):
		return
	if not unit_bp.has("custom_topology") and not unit_bp.has("groups"):
		unit_bp["archetype"] = "custom"
		unit_bp["blank_canvas"] = true
		unit_bp["custom_topology"] = _blank_free_canvas_topology()
		unit_bp.erase("groups")
		return
	if unit_bp.has("custom_topology") and _topology_is_canonical_component_graph(Dictionary(unit_bp.get("custom_topology", {}))):
		unit_bp.erase("groups")
		return
	if unit_bp.has("custom_topology"):
		unit_bp["custom_topology"] = {"nodes": [], "edges": [], "edge_snap_version": TOPOLOGY_SNAP_VERSION, "legacy_rejected": true}
		unit_bp.erase("groups")
		unit_bp["archetype"] = "custom"
		return
	if unit_bp.has("groups"):
		unit_bp["custom_topology"] = {"nodes": [], "edges": [], "edge_snap_version": TOPOLOGY_SNAP_VERSION, "legacy_rejected": true}
		unit_bp.erase("groups")


func _catalog_runtime_part(raw_part: Dictionary, slot_key: String) -> Dictionary:
	return _normalized_catalog_part(slot_key, raw_part, "runtime")


func _append_unique_catalog_parts(target: Array, source: Array, seen: Dictionary, slot_key: String) -> void:
	for raw_part in source:
		if not (raw_part is Dictionary):
			continue
		var part: Dictionary = raw_part
		var key := "%s|%s" % [String(part.get("name", "")), String(part.get("kind", part.get("material_class", "")))]
		if seen.has(key):
			continue
		seen[key] = true
		target.append(_catalog_runtime_part(part, slot_key))


func _catalog_for(role_key: String, slot_key: String) -> Array:
	var cache_key := "%s|%s" % [role_key, slot_key]
	if runtime_catalog_cache.has(cache_key):
		return Array(runtime_catalog_cache[cache_key])
	if slot_key == "special":
		var special_catalog: Array = []
		var seen := {}
		_append_unique_catalog_parts(special_catalog, SPECIAL_CATALOG.get(role_key, []), seen, slot_key)
		_append_unique_catalog_parts(special_catalog, STYLE_SPECIAL_CATALOG.get(role_key, []), seen, slot_key)
		for other_role in ROLE_ORDER:
			if String(other_role) == role_key:
				continue
			_append_unique_catalog_parts(special_catalog, SPECIAL_CATALOG.get(String(other_role), []), seen, slot_key)
			_append_unique_catalog_parts(special_catalog, STYLE_SPECIAL_CATALOG.get(String(other_role), []), seen, slot_key)
		runtime_catalog_cache[cache_key] = special_catalog
		return Array(special_catalog)
	var common_catalog: Array = []
	var seen_common := {}
	_append_unique_catalog_parts(common_catalog, COMMON_CATALOG.get(slot_key, []), seen_common, slot_key)
	_append_unique_catalog_parts(common_catalog, STYLE_COMMON_CATALOG.get(slot_key, []), seen_common, slot_key)
	runtime_catalog_cache[cache_key] = common_catalog
	return Array(common_catalog)


func _component_index_by_name(role_key: String, slot_key: String, component_name: String, fallback: int = 0) -> int:
	var exact := _component_index_by_exact_name(role_key, slot_key, component_name)
	if exact >= 0:
		return exact
	var catalog: Array = _catalog_for(role_key, slot_key)
	return clampi(fallback, 0, maxi(0, catalog.size() - 1))


func _component_index_by_exact_name(role_key: String, slot_key: String, component_name: String) -> int:
	var catalog: Array = _catalog_for(role_key, slot_key)
	for i in range(catalog.size()):
		var part: Dictionary = catalog[i]
		if String(part.get("name", "")) == component_name:
			return i
	return -1


func _manufacturer_counts_for_blueprint(role_key: String, unit_bp: Dictionary) -> Dictionary:
	var counts: Dictionary = {}
	var component_priced := _unit_uses_component_pricing(unit_bp)
	if not component_priced:
		for slot_key in BUILD_SLOTS:
			var index := int(unit_bp.get(slot_key, 0))
			var part := _selected_component(role_key, slot_key, index)
			_add_manufacturer_count(counts, _manufacturer_for_part(part, slot_key))
	if role_key == "barrier" and not component_priced:
		for ether_index in _barrier_extra_ether_indices(unit_bp):
			var ether_part := _selected_component(role_key, "special", int(ether_index))
			_add_manufacturer_count(counts, _manufacturer_for_part(ether_part, "special"))
	if unit_bp.has("custom_topology"):
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		for node in Array(topology.get("nodes", [])):
			if not (node is Dictionary):
				continue
			if _topology_node_is_component(node):
				var slot_key := _topology_node_slot(node)
				var part := _topology_node_part(role_key, node, unit_bp)
				_add_manufacturer_count(counts, _manufacturer_for_part(part, slot_key))
				continue
			for slot_key in TOPOLOGY_PART_SLOTS:
				var index := int(node.get(slot_key, unit_bp.get(slot_key, 0)))
				var part := _selected_component(role_key, slot_key, index)
				_add_manufacturer_count(counts, _manufacturer_for_part(part, slot_key))
			if not component_priced:
				var module_catalog: Array = _catalog_for(role_key, "module")
				for module_index in _module_indices_for_topology_node(node, unit_bp):
					var module_part: Dictionary = module_catalog[clampi(int(module_index), 0, module_catalog.size() - 1)]
					_add_manufacturer_count(counts, _manufacturer_for_part(module_part, "module"))
	if unit_bp.has("slot_payloads"):
		for raw_payload in Array(unit_bp.get("slot_payloads", [])):
			if not (raw_payload is Dictionary):
				continue
			var payload: Dictionary = raw_payload
			var payload_kind := String(payload.get("kind", ""))
			var payload_part := _payload_part_for_payload(role_key, payload)
			_add_manufacturer_count(counts, _manufacturer_for_part(payload_part, _payload_slot_key_for_kind(payload_kind)))
	if role_key == "barrier" and unit_bp.has("barrier_tiles"):
		for tile in Array(unit_bp.get("barrier_tiles", [])):
			if not (tile is Dictionary):
				continue
			var part := _selected_component(role_key, "muscle", int(tile.get("muscle", unit_bp.get("muscle", 0))))
			_add_manufacturer_count(counts, _manufacturer_for_part(part, "muscle"))
	return counts


func _add_manufacturer_count(counts: Dictionary, maker: String) -> void:
	if maker == "" or SOFTWARE_MANUFACTURERS.has(maker):
		return
	counts[maker] = int(counts.get(maker, 0)) + 1


func _dominant_hardware_maker(counts: Dictionary) -> String:
	if counts.is_empty():
		return "-"
	var makers := counts.keys()
	if makers.size() == 1:
		return String(makers[0])
	var best := ""
	var best_count := -1
	for maker in makers:
		var count := int(counts[maker])
		if count > best_count:
			best = String(maker)
			best_count = count
	return "MIXED:%s" % best


func _manufacturer_rule_note(stats: Dictionary) -> String:
	var maker := String(stats.get("manufacturer_locked", "-"))
	var discount := float(stats.get("manufacturer_discount", 0.0))
	var suffix := " DISCOUNT %.0f%%" % (discount * 100.0) if discount > 0.0 else ""
	if maker.begins_with("MIXED:"):
		return "MFR MIX WARN: %s leads%s" % [maker.substr(6), suffix]
	if maker == "-":
		return "MFR -"
	return "MFR %s LOCK%s" % [maker, suffix]


func _apply_manufacturer_synergy(stats: Dictionary, counts: Dictionary) -> void:
	var notes: Array = []
	if counts.has("RECOIL LATTICE"):
		var strength := clampf(float(counts["RECOIL LATTICE"]) / 5.0, 0.0, 1.4)
		stats["recoil"] = float(stats.get("recoil", 0.06)) * (1.0 - 0.08 * strength)
		stats["normal_lane_range"] = float(stats.get("normal_lane_range", 0.24)) + 0.025 * strength
		stats["projectile_range"] = float(stats.get("projectile_range", 0.0)) + 0.16 * strength
		notes.append("RECOIL -%.0f%%" % (8.0 * strength))
	if counts.has("RAZOR TEMPLE"):
		var strength := clampf(float(counts["RAZOR TEMPLE"]) / 5.0, 0.0, 1.4)
		stats["normal_damage"] = int(stats.get("normal_damage", 0)) + int(roundf(2.0 * strength))
		stats["active_damage"] = int(stats.get("active_damage", 0)) + int(roundf(4.0 * strength))
		stats["normal_cooldown"] = float(stats.get("normal_cooldown", 0.34)) * (1.0 - 0.035 * strength)
		notes.append("RAZOR DMG +%.0f" % (2.0 * strength))
	if counts.has("AFTERBURN UNION"):
		var strength := clampf(float(counts["AFTERBURN UNION"]) / 4.0, 0.0, 1.5)
		stats["move_efficiency_sum"] = float(stats.get("move_efficiency_sum", 0.0)) * (1.0 + 0.05 * strength)
		stats["boost_efficiency_sum"] = float(stats.get("boost_efficiency_sum", 0.0)) * (1.0 + 0.08 * strength)
		stats["brake_efficiency"] = maxf(float(stats.get("brake_efficiency", 1.0)), 1.0 + 0.04 * strength)
		stats["cooling"] = float(stats.get("cooling", 0.0)) + 2.5 * strength
		notes.append("BOOST +%.0f%%" % (8.0 * strength))
	if counts.has("CRUSTA DYNAMICS"):
		var strength := clampf(float(counts["CRUSTA DYNAMICS"]) / 4.0, 0.0, 1.5)
		stats["health"] = int(stats.get("health", 0)) + int(roundf(12.0 * strength))
		stats["radius"] = float(stats.get("radius", 0.08)) + 0.015 * strength
		var counters: Dictionary = stats.get("counter_tiers", {})
		counters["blunt"] = maxi(int(counters.get("blunt", 0)), 1)
		stats["counter_tiers"] = counters
		notes.append("SHELL HP +%.0f" % (12.0 * strength))
	if counts.has("GLACIER MONKS"):
		var strength := clampf(float(counts["GLACIER MONKS"]) / 3.0, 0.0, 1.5)
		stats["cooling"] = float(stats.get("cooling", 0.0)) + 8.0 * strength
		stats["manual_cooling"] = float(stats.get("manual_cooling", 48.0)) + 18.0 * strength
		notes.append("COOL +%.0f" % (8.0 * strength))
	if counts.has("NEURAL TETHER RESEARCH"):
		var strength := clampf(float(counts["NEURAL TETHER RESEARCH"]) / 4.0, 0.0, 1.5)
		stats["takeover_power"] = float(stats.get("takeover_power", 1.0)) + 0.12 * strength
		stats["web_strength"] = float(stats.get("web_strength", 0.0)) + 0.04 * strength
		notes.append("INTRUDE +%.0f%%" % (12.0 * strength))
	if counts.has("CIPHER WARD"):
		var strength := clampf(float(counts["CIPHER WARD"]) / 4.0, 0.0, 1.8)
		stats["data_security"] = clampf(float(stats.get("data_security", 1.0)) + 0.22 * strength, 0.25, 3.6)
		stats["cooling"] = float(stats.get("cooling", 0.0)) + 1.5 * strength
		notes.append("SEC +%.2f" % (0.22 * strength))
	if counts.has("REDLINE ARMS") and bool(stats.get("is_homing_launcher", false)):
		var strength := clampf(float(counts["REDLINE ARMS"]) / 5.0, 0.0, 1.3)
		stats["homing_accuracy"] = clampf(float(stats.get("homing_accuracy", 0.0)) + 0.05 * strength, 0.0, 0.96)
		stats["homing_interval"] = maxf(0.16, float(stats.get("homing_interval", 1.0)) * (1.0 - 0.04 * strength))
		notes.append("SEEKER TUNE")
	if counts.has("COINRUN DYNAMICS"):
		var strength := clampf(float(counts["COINRUN DYNAMICS"]) / 4.0, 0.0, 1.6)
		stats["cornering"] = float(stats.get("cornering", 1.0)) + 0.18 * strength
		stats["speed_lane_affinity"] = float(stats.get("speed_lane_affinity", 0.0)) + 0.06 * strength
		stats["speed"] = float(stats.get("speed", 0.0)) + 0.04 * strength
		if bool(stats.get("is_speed_lane", false)):
			stats["speed_lane_mult"] = float(stats.get("speed_lane_mult", 1.0)) + 0.08 * strength
			stats["speed_lane_pull"] = float(stats.get("speed_lane_pull", 0.0)) + 0.04 * strength
		if bool(stats.get("is_coin_generator", false)):
			stats["coin_interval"] = maxf(0.65, float(stats.get("coin_interval", 6.0)) * (1.0 - 0.04 * strength))
		notes.append("COIN ROUTE")
	if counts.has("LONGSIGHT AEGIS"):
		var strength := clampf(float(counts["LONGSIGHT AEGIS"]) / 4.0, 0.0, 1.4)
		stats["projectile_range"] = float(stats.get("projectile_range", 0.0)) + 0.22 * strength
		if bool(stats.get("projectile", false)):
			stats["normal_range"] = float(stats.get("normal_range", 0.36)) + 0.06 * strength
		if bool(stats.get("is_one_way_shield", false)):
			stats["shield_block_damage_mult"] = float(stats.get("shield_block_damage_mult", 1.0)) * (1.0 - 0.05 * strength)
			stats["shield_radius"] = float(stats.get("shield_radius", 0.0)) + 0.04 * strength
		notes.append("SNIPER SCREEN")
	if counts.has("COLOSSUS KENNEL"):
		var strength := clampf(float(counts["COLOSSUS KENNEL"]) / 4.0, 0.0, 1.5)
		stats["health"] = int(stats.get("health", 0)) + int(roundf(26.0 * strength))
		stats["normal_damage"] = int(stats.get("normal_damage", 0)) + int(roundf(5.0 * strength))
		stats["active_damage"] = int(stats.get("active_damage", 0)) + int(roundf(7.0 * strength))
		stats["acceleration"] = float(stats.get("acceleration", 1.0)) * (1.0 - 0.04 * strength)
		notes.append("MONSTER MELEE")
	if counts.has("HUMANOVA ATELIER"):
		var strength := clampf(float(counts["HUMANOVA ATELIER"]) / 4.0, 0.0, 1.5)
		stats["cornering"] = float(stats.get("cornering", 1.0)) + 0.16 * strength
		stats["normal_cooldown"] = float(stats.get("normal_cooldown", 0.34)) * (1.0 - 0.025 * strength)
		stats["module_sequence_limit"] = maxi(int(stats.get("module_sequence_limit", 1)), 2)
		notes.append("HUMANOID TECH")
	if counts.has("UMBRA REARWORKS"):
		var strength := clampf(float(counts["UMBRA REARWORKS"]) / 4.0, 0.0, 1.6)
		stats["cornering"] = float(stats.get("cornering", 1.0)) + 0.14 * strength
		stats["back_hit_heat_bonus"] = float(stats.get("back_hit_heat_bonus", 0.0)) + 5.0 * strength
		stats["back_hit_heat_mult"] = maxf(float(stats.get("back_hit_heat_mult", 1.0)), 1.0 + 0.08 * strength)
		notes.append("REAR HEAT +%.0f" % (5.0 * strength))
	stats["manufacturer_note"] = " / ".join(notes)


func _manufacturer_for_part(part: Dictionary, slot_key: String = "") -> String:
	var explicit := String(part.get("maker", ""))
	if explicit != "":
		return explicit
	var kind := String(part.get("kind", ""))
	var material_class := String(part.get("material_class", ""))
	var shape := String(part.get("shape", ""))
	var module_effect := String(part.get("module_effect", ""))
	if slot_key == "special" or kind in ["soul", "code", "ether"] or module_effect in ["morph", "combine"] or String(part.get("motion", "")) in ["identity_shift", "software"]:
		return "NULL SOFTWARE"
	if material_class in ["repair_station", "hatchery", "hatch_modifier"] or shape in ["hatchery", "acid_gland", "rifle_graft"]:
		return "HELIX CIVIC"
	if material_class in ["gravity_field", "coolant_field", "resource_siphon", "barrier_cache"] or bool(part.get("is_gravity_field", false)) or bool(part.get("is_coolant_field", false)) or bool(part.get("is_resource_siphon", false)):
		return "ORBITAL BRIDGE" if material_class != "resource_siphon" else "VANTA LOOM"
	if material_class == "reflector":
		return "ORBITAL BRIDGE"
	if material_class in ["speed_lane", "coin_generator"] or bool(part.get("is_speed_lane", false)) or bool(part.get("is_coin_generator", false)):
		return "COINRUN DYNAMICS"
	if material_class in ["one_way_shield", "shield_payload"] or bool(part.get("is_one_way_shield", false)) or bool(part.get("shield_payload", false)) or bool(part.get("electronic_armor", false)):
		return "LONGSIGHT AEGIS"
	if material_class in ["hack_field", "signal_jammer"] or bool(part.get("is_hack_field", false)) or bool(part.get("is_signal_jammer", false)):
		return "VANTA LOOM"
	if shape in ["web_gun", "light_sink"] or bool(part.get("web_strength", 0.0)) or bool(part.get("blind_radius", 0.0)):
		return "VANTA LOOM"
	if material_class in ["gun", "missile_launcher", "racket", "ball_puppet", "suicide_puppet"] or bool(part.get("projectile", false)):
		return "REDLINE ARMS"
	if slot_key == "joint" or material_class in ["weapon", "chain", "torso", "wood"]:
		return "MONOCHROME FORGE"
	return "MONOCHROME FORGE"


func _manufacturer_discount_from_counts(counts: Dictionary) -> float:
	var total_discount := 0.0
	for maker in counts.keys():
		var count := int(counts[maker])
		if count >= 3:
			var maker_info: Dictionary = MANUFACTURERS.get(String(maker), {})
			var step := float(maker_info.get("discount_step", 0.03))
			total_discount += minf(0.18, float(count - 2) * step)
	return clampf(total_discount, 0.0, 0.32)


