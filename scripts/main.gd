func _handle_scout_player_button_input(event: InputEvent, index: int) -> void:
	if not (event is InputEventMouseButton):
		return
	var mouse_event := event as InputEventMouseButton
	if not mouse_event.pressed or mouse_event.button_index != MOUSE_BUTTON_RIGHT:
		return
	var player_id := clampi(int(scout_sortie_player_id), 1, 2)
	var order := _all_roster_order(player_id)
	if index < 0 or index >= order.size():
		return
	scout_selected_entry = Dictionary(order[index]).duplicate(true)
	scout_selected_player_id = player_id
	scout_hint_label.text = _set_sortie_starter_entry(player_id, order[index])
	ai_team_manual_lock[player_id] = true
	_update_scout_ui()


func _select_scout_relative(delta_index: int) -> void:
	var player_id := clampi(int(scout_selected_player_id), 1, 2)
	var order := _all_roster_order(player_id)
	if order.is_empty():
		return
	var current := 0
	var current_ref := _entry_ref(scout_selected_entry)
	for i in range(order.size()):
		if _entry_ref(order[i]) == current_ref:
			current = i
			break
	_select_scout_entry(player_id, _wrapped_index(current + delta_index, order.size()))


