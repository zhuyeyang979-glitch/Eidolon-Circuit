func _confirm_save_unit_name_dialog(action_or_text: String = "stay", maybe_action: String = "") -> void:
	var action := maybe_action if maybe_action != "" else action_or_text
	var unit_name := editor_save_unit_name_edit.text if editor_save_unit_name_edit != null else ""
