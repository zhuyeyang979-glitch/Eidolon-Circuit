func _cooling_family_for_part(part: Dictionary) -> String:
	if part.has("cooling_family"):
		return String(part["cooling_family"])
	var profile := String(part.get("cooling_profile", "")).to_lower()
	var name := String(part.get("name", "")).to_upper()
	if profile.contains("starter") or name.contains("VENT SHEET"):
		return "compact"
	if profile.contains("duelist") or profile.contains("melee") or name.contains("NANO") or name.contains("COMBO"):
		return "melee_module"
	if profile.contains("laser") or profile.contains("chemical") or profile.contains("prism"):
		return "ranged_low_heat"
	if profile.contains("boost") or profile.contains("mobility") or profile.contains("sink") or name.contains("PHASE"):
		return "boost_sink"
	if profile.contains("heavy") or profile.contains("monster") or name.contains("GLACIER") or name.contains("COLOSSUS") or name.contains("LUNG"):
		return "titan_radiator"
	return "stable"


