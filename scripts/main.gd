func _cycle_editor_catalog_sort(direction: int) -> void:
	var available_keys := _current_editor_catalog_sort_keys()
	if available_keys.is_empty():
		available_keys = ["cost"]
	var current_index := available_keys.find(editor_catalog_sort_key)
	if current_index < 0:
		current_index = 0
	current_index = _wrapped_index(current_index + direction, available_keys.size())
	editor_catalog_sort_key = String(available_keys[current_index])
	editor_catalog_page = 0
	_invalidate_editor_catalog_cache()
	_update_editor_ui()


