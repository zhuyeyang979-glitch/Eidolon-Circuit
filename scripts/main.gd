func _menu_index_for_action(action_key: String) -> int:
	for i in range(MenuController.MAIN_MENU_SPECS.size()):
		var spec: Dictionary = MenuController.MAIN_MENU_SPECS[i]
		if String(spec.get("key", "")) == action_key:
