func _safe_save_stem(value: String, fallback: String) -> String:
	var source := value.strip_edges()
	if source == "":
		source = fallback
	var result := ""
	for i in range(source.length()):
		var ch := source.substr(i, 1)
		if ch.is_valid_identifier() or ch.is_valid_int() or ch in ["-", "_"]:
			result += ch
		elif ch == " ":
			result += "_"
	if result == "":
		result = fallback
	return result.substr(0, mini(result.length(), 42))


func _color_to_save_dict(color: Color) -> Dictionary:
	return {"r": color.r, "g": color.g, "b": color.b, "a": color.a}


func _color_from_save_value(value, fallback: Color) -> Color:
	if value is Dictionary:
		var dict: Dictionary = value
		return Color(float(dict.get("r", fallback.r)), float(dict.get("g", fallback.g)), float(dict.get("b", fallback.b)), float(dict.get("a", fallback.a)))
	return fallback


func _json_safe_value(value):
	if value is Vector2:
		var vector: Vector2 = value
		return {"__type": "Vector2", "x": vector.x, "y": vector.y}
	if value is Color:
		var color: Color = value
		return {"__type": "Color", "r": color.r, "g": color.g, "b": color.b, "a": color.a}
	if value is Array:
		var safe_array: Array = []
		for item in value:
			safe_array.append(_json_safe_value(item))
		return safe_array
	if value is Dictionary:
		var safe_dict := {}
		var dict: Dictionary = value
		for key in dict.keys():
			safe_dict[key] = _json_safe_value(dict[key])
		return safe_dict
	return value


func _json_restore_value(value):
	if value is Array:
		var restored_array: Array = []
		for item in value:
			restored_array.append(_json_restore_value(item))
		return restored_array
	if value is Dictionary:
		var dict: Dictionary = value
		if String(dict.get("__type", "")) == "Vector2":
			return Vector2(float(dict.get("x", 0.5)), float(dict.get("y", 0.5)))
		if String(dict.get("__type", "")) == "Color":
			return Color(float(dict.get("r", 1.0)), float(dict.get("g", 1.0)), float(dict.get("b", 1.0)), float(dict.get("a", 1.0)))
		var restored_dict := {}
		for key in dict.keys():
			restored_dict[key] = _json_restore_value(dict[key])
		return restored_dict
	return value


func _saved_unit_sanitize_strip_keys() -> Array:
	var keys: Array = []
	for key in _legacy_power_field_keys():
		if not keys.has(key):
			keys.append(key)
	if unit_blueprint_validator != null:
		for key in unit_blueprint_validator.legacy_pointer_keys():
			if not keys.has(key):
				keys.append(key)
	else:
		for key in ["attack_groups", "action_groups", "shell", "joint_a", "joint_b", "muscle_a", "muscle_b", "visual_pointer", "collider_pointer"]:
			if not keys.has(key):
				keys.append(key)
	return keys


func _sanitize_saved_unit_value(value):
	if value is Array:
		var sanitized_array: Array = []
		for item in Array(value):
			sanitized_array.append(_sanitize_saved_unit_value(item))
		return sanitized_array
	if value is Dictionary:
		var source: Dictionary = value
		var cleaned := source.duplicate(true)
		for key in _saved_unit_sanitize_strip_keys():
			cleaned.erase(key)
		if _saved_dict_looks_like_nonphysical_payload(cleaned):
			cleaned.erase("hp")
			cleaned.erase("max_hp")
			cleaned.erase("health")
		if _part_is_action_module(String(cleaned.get("slot_key", cleaned.get("kind", ""))), cleaned):
			for key in ACTION_MODULE_COMBAT_FIELD_KEYS:
				cleaned.erase(key)
		for key in cleaned.keys():
			cleaned[key] = _sanitize_saved_unit_value(cleaned[key])
		return cleaned
	return value


