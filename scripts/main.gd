func _ensure_ai_roster_roles(player_id: int) -> void:
	var roster_dict: Dictionary = blueprints.get(player_id, {})
	var missing_roles := []
	for role_key in ROLE_ORDER:
		if not roster_dict.has(role_key) or not (roster_dict[role_key] is Array) or Array(roster_dict[role_key]).is_empty():
			missing_roles.append(role_key)
	if missing_roles.is_empty():
		blueprints[player_id] = roster_dict
		return
	var smart := _smart_ai_roster(player_id)
	for role_key in missing_roles:
		roster_dict[role_key] = Array(smart[role_key]).duplicate(true)
	blueprints[player_id] = roster_dict


func _repair_ai_roster_topology(player_id: int) -> void:
	for role_key in ROLE_ORDER:
		if not _role_uses_body_board(role_key):
			continue
		var roster: Array = blueprints[player_id].get(role_key, [])
		for i in range(roster.size()):
			var unit_bp: Dictionary = Dictionary(roster[i]).duplicate(true)
			_normalize_unit_to_component_topology(role_key, unit_bp)
			_repair_ai_custom_topology(role_key, unit_bp)
			roster[i] = unit_bp
		blueprints[player_id][role_key] = roster


func _repair_ai_custom_topology(role_key: String, unit_bp: Dictionary) -> void:
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var used_modules := {}
	for i in range(nodes.size()):
		if not (nodes[i] is Dictionary):
			continue
		var node: Dictionary = nodes[i]
		if _topology_node_is_component(node):
			var slot_key := _topology_node_slot(node)
			if _is_topology_part_slot(slot_key):
				var catalog_size := _catalog_for(role_key, slot_key).size()
				node["part_index"] = clampi(_topology_node_part_index(node, unit_bp), 0, catalog_size - 1)
				node[slot_key] = int(node["part_index"])
			if node.has("modules"):
				var normalized_modules: Array = []
				for module_index in _module_indices_for_topology_node(node, unit_bp):
					normalized_modules.append(clampi(int(module_index), 0, COMMON_CATALOG["module"].size() - 1))
				node["modules"] = normalized_modules
				node["module"] = int(normalized_modules[0]) if not normalized_modules.is_empty() else int(unit_bp.get("module", 0))
			nodes[i] = node
			continue
		var muscle_index := clampi(int(node.get("muscle", unit_bp.get("muscle", 0))), 0, COMMON_CATALOG["muscle"].size() - 1)
		var limb_index := clampi(int(node.get("limb_muscle", unit_bp.get("limb_muscle", 0))), 0, COMMON_CATALOG["limb_muscle"].size() - 1)
		node["limb_muscle"] = limb_index
		node["muscle"] = muscle_index
		node["joint"] = _joint_index_for_parts(role_key, limb_index, muscle_index, int(node.get("joint", unit_bp.get("joint", 0))))
		var material_key := "%d/%d/%d" % [int(node["joint"]), limb_index, muscle_index]
		var primary_module := int(_module_indices_for_topology_node(node, unit_bp)[0])
		if used_modules.has(primary_module) and String(used_modules[primary_module]) != material_key:
			primary_module = _first_free_module_index(role_key, used_modules)
			node["module"] = primary_module
			node["modules"] = [primary_module]
		used_modules[primary_module] = material_key
		nodes[i] = node
	topology["nodes"] = nodes
	unit_bp["custom_topology"] = topology
	_snap_all_topology_edges(role_key, unit_bp)


func _joint_index_for_muscle(role_key: String, muscle_index: int, preferred_joint: int) -> int:
	var muscle_part := _selected_component(role_key, "muscle", muscle_index)
	return _joint_index_for_muscle_rank(_component_size_rank(muscle_part), preferred_joint)


func _joint_index_for_parts(role_key: String, limb_muscle_index: int, terminal_index: int, preferred_joint: int) -> int:
	var limb_part := _selected_component(role_key, "limb_muscle", limb_muscle_index)
	var terminal_part := _selected_component(role_key, "muscle", terminal_index)
	var required_rank := maxi(_component_size_rank(limb_part), _component_size_rank(terminal_part))
	return _joint_index_for_muscle_rank(required_rank, preferred_joint)


func _joint_index_for_muscle_rank(muscle_rank: int, preferred_joint: int) -> int:
	var joint_catalog: Array = COMMON_CATALOG["joint"]
	var preferred := clampi(preferred_joint, 0, joint_catalog.size() - 1)
	if _joint_supports_muscle_rank(joint_catalog[preferred], muscle_rank):
		return preferred
	var best_index := preferred
	var best_score := 999999.0
	for i in range(joint_catalog.size()):
		var joint_part: Dictionary = joint_catalog[i]
		if not _joint_supports_muscle_rank(joint_part, muscle_rank):
			continue
		var joint_rank := _component_size_rank(joint_part)
		var score := float(joint_part.get("cost", 0)) + absf(float(joint_rank - muscle_rank)) * 18.0
		if score < best_score:
			best_score = score
			best_index = i
	return best_index


func _joint_supports_muscle_rank(joint_part: Dictionary, muscle_rank: int) -> bool:
	return muscle_rank >= int(joint_part.get("min_muscle_rank", 0)) and muscle_rank <= int(joint_part.get("max_muscle_rank", 7))


func _first_free_module_index(role_key: String, used_modules: Dictionary) -> int:
	var module_catalog: Array = _catalog_for(role_key, "module")
	for i in range(module_catalog.size()):
		if not used_modules.has(i):
			return i
	return 0


func _ensure_ai_cheap_starter(player_id: int) -> void:
	for entry in _all_roster_order(player_id):
		if _starter_cost_valid(player_id, entry):
			return
	var side_tag := "Blue" if player_id == 1 else "Red"
	var roster: Array = blueprints[player_id].get("hero", [])
	var cheap_starter := _ai_starter_unit("%s Emergency" % side_tag)
	if _roster_unit_total(player_id) < _current_roster_cap():
		roster.insert(0, cheap_starter)
	else:
		roster[0] = cheap_starter
	blueprints[player_id]["hero"] = roster
	active_roster_indices[player_id]["hero"] = 0


func _build_ai_sortie_loadout(player_id: int) -> Array:
	var selected: Array = []
	var starter := _pick_ai_sortie_entry(player_id, "", selected, true)
	if starter.is_empty():
		_install_ai_reserve_unit(player_id, "hero", 0)
		starter = _pick_ai_sortie_entry(player_id, "", selected, true)
	if not starter.is_empty():
		selected.append(starter)
	for role_key in ["hero", "puppet", "barrier"]:
		var entry := _pick_ai_sortie_entry(player_id, role_key, selected, false)
		if entry.is_empty():
			_install_ai_reserve_unit(player_id, role_key, selected.size())
			entry = _pick_ai_sortie_entry(player_id, role_key, selected, false)
		if not entry.is_empty():
			selected.append(entry)
	while selected.size() < _current_sortie_cap():
		var next_entry := _pick_ai_sortie_entry(player_id, "", selected, false)
		if next_entry.is_empty():
			var fill_role: String = ["puppet", "barrier", "hero"][selected.size() % 3]
			_install_ai_reserve_unit(player_id, fill_role, selected.size())
			next_entry = _pick_ai_sortie_entry(player_id, "", selected, false)
			if next_entry.is_empty():
				break
		selected.append(next_entry)
	return selected


func _sortie_role_counts(loadout: Array) -> Dictionary:
	var counts := {"hero": 0, "puppet": 0, "barrier": 0}
	for entry in loadout:
		if not (entry is Dictionary):
			continue
		var role_key := String(Dictionary(entry).get("role", ""))
		if counts.has(role_key):
			counts[role_key] = int(counts[role_key]) + 1
	return counts


func _sortie_has_required_roles(loadout: Array) -> bool:
	var counts := _sortie_role_counts(loadout)
	for role_key in ROLE_ORDER:
		if int(counts.get(role_key, 0)) <= 0:
			return false
	return true


func _install_ai_reserve_unit(player_id: int, role_key: String, seed: int) -> Dictionary:
	if not ROLE_ORDER.has(role_key):
		role_key = "puppet"
	if not blueprints.has(player_id):
		blueprints[player_id] = {"hero": [], "puppet": [], "barrier": []}
	var roster_dict: Dictionary = blueprints[player_id]
	var roster: Array = Array(roster_dict.get(role_key, [])).duplicate(true)
	var candidate := _ai_reserve_unit_for_role(player_id, role_key, seed)
	var replace_index := -1
	for i in range(roster.size()):
		var entry := {"role": role_key, "index": i}
		if not _sortie_entry_is_battle_legal(player_id, entry, false):
			replace_index = i
			break
	if replace_index >= 0:
		roster[replace_index] = candidate
		roster_dict[role_key] = roster
		blueprints[player_id] = roster_dict
		ai_roster_stats_cache.clear()
		return {"role": role_key, "index": replace_index}
	if _roster_unit_total(player_id) < _current_roster_cap():
		roster.append(candidate)
		roster_dict[role_key] = roster
		blueprints[player_id] = roster_dict
		ai_roster_stats_cache.clear()
		return {"role": role_key, "index": roster.size() - 1}
	var invalid_any := _first_invalid_ai_roster_entry(player_id)
	if not invalid_any.is_empty():
		var remove_role := String(invalid_any.get("role", ""))
		var remove_index := int(invalid_any.get("index", -1))
		var remove_roster: Array = Array(roster_dict.get(remove_role, [])).duplicate(true)
		if remove_index >= 0 and remove_index < remove_roster.size():
			remove_roster.remove_at(remove_index)
			roster_dict[remove_role] = remove_roster
			blueprints[player_id] = roster_dict
			ai_roster_stats_cache.clear()
			_update_sortie_after_delete(player_id, remove_role, remove_index)
			roster = Array(blueprints[player_id].get(role_key, [])).duplicate(true)
			roster.append(candidate)
			blueprints[player_id][role_key] = roster
			ai_roster_stats_cache.clear()
			return {"role": role_key, "index": roster.size() - 1}
	if not roster.is_empty():
		replace_index = roster.size() - 1
		roster[replace_index] = candidate
		roster_dict[role_key] = roster
		blueprints[player_id] = roster_dict
		ai_roster_stats_cache.clear()
		return {"role": role_key, "index": replace_index}
	var removable := _ai_removable_roster_entry(player_id)
	if not removable.is_empty():
		var remove_role_key := String(removable.get("role", ""))
		var remove_unit_index := int(removable.get("index", -1))
		var source_roster: Array = Array(roster_dict.get(remove_role_key, [])).duplicate(true)
		if remove_unit_index >= 0 and remove_unit_index < source_roster.size():
			source_roster.remove_at(remove_unit_index)
			roster_dict[remove_role_key] = source_roster
			blueprints[player_id] = roster_dict
			ai_roster_stats_cache.clear()
			_update_sortie_after_delete(player_id, remove_role_key, remove_unit_index)
	roster = Array(roster_dict.get(role_key, [])).duplicate(true)
	roster.append(candidate)
	roster_dict[role_key] = roster
	blueprints[player_id] = roster_dict
	ai_roster_stats_cache.clear()
	return {"role": role_key, "index": roster.size() - 1}


func _first_invalid_ai_roster_entry(player_id: int) -> Dictionary:
	for entry in _all_roster_order(player_id):
		if not (entry is Dictionary):
			continue
		var candidate: Dictionary = Dictionary(entry)
		if not _sortie_entry_is_battle_legal(player_id, candidate, false):
			return candidate.duplicate(true)
	return {}


func _ai_reserve_unit_for_role(player_id: int, role_key: String, seed: int) -> Dictionary:
	var generated := _ai_teamedit_generated_roster_cached(player_id)
	var generated_role_roster: Array = Array(generated.get(role_key, []))
	if not generated_role_roster.is_empty():
		var candidate: Dictionary = Dictionary(generated_role_roster[seed % generated_role_roster.size()]).duplicate(true)
		candidate["name"] = "%s Reserve %d" % [String(candidate.get("name", "TeamEdit Unit")), seed + 1]
		return candidate
	var side_tag := "Blue" if player_id == 1 else "Red"
	var label := "%s Legal Reserve %d" % [side_tag, seed + 1]
	match role_key:
		"hero":
			var hero := _ai_starter_unit(side_tag)
			hero["name"] = "%s Hero Core" % label
			return hero
		"barrier":
			return _ai_barrier_unit("pin_wall", "%s Pin Maze" % label)
		_:
			return _ai_micro_puppet_unit("%s Guard Bit" % label, "guard_orbit")


func _pick_ai_sortie_entry(player_id: int, role_filter: String, selected: Array, require_starter: bool) -> Dictionary:
	var best: Dictionary = {}
	var best_score := -999999.0
	for entry in _all_roster_order(player_id):
		if not (entry is Dictionary):
			continue
		var candidate: Dictionary = Dictionary(entry).duplicate(true)
		if role_filter != "" and String(candidate.get("role", "")) != role_filter:
			continue
		if _entry_is_selected(candidate, selected):
			continue
		if require_starter and not _starter_cost_valid(player_id, candidate):
			continue
		if not _sortie_entry_is_battle_legal(player_id, candidate, require_starter):
			continue
		var score := _ai_sortie_score(player_id, candidate, require_starter)
		if score > best_score:
			best_score = score
			best = candidate
	return best


func _sortie_entry_is_battle_legal(player_id: int, entry: Dictionary, require_starter_cost: bool = false) -> bool:
	if not _valid_roster_entry(player_id, entry):
		return false
	if require_starter_cost and not _starter_cost_valid(player_id, entry):
		return false
	var role_key := String(entry.get("role", "hero"))
	var unit_index := int(entry.get("index", 0))
	var unit_bp := _blueprint_for(player_id, role_key, unit_index)
	var stats := _ai_cached_unit_stats(player_id, role_key, unit_index)
	if float(stats.get("length", 0.0)) > 4.5:
		return false
	if _role_uses_body_board(role_key) and not _module_material_rule_valid(unit_bp):
		return false
	var topology_note := _topology_rule_note(unit_bp, role_key, stats)
	if topology_note.begins_with("INVALID"):
		return false
	for note_key in ["joint_momentum_note", "slot_payload_note", "drive_note", "stiffness_note"]:
		if role_key == "barrier" and note_key in ["slot_payload_note", "drive_note"]:
			continue
		if String(stats.get(note_key, "")).begins_with("INVALID"):
			return false
	return true


func _entry_is_selected(entry: Dictionary, selected: Array) -> bool:
	var ref := _entry_ref(entry)
	for selected_entry in selected:
		if selected_entry is Dictionary and _entry_ref(selected_entry) == ref:
			return true
	return false


func _ai_sortie_score(player_id: int, entry: Dictionary, starter_score: bool) -> float:
	var role_key := String(entry.get("role", "hero"))
	var unit_index := int(entry.get("index", 0))
	var stats := _ai_cached_unit_stats(player_id, role_key, unit_index)
	var score := float(stats.get("health", 0)) * 0.12
	score += float(stats.get("normal_damage", 0)) * 3.6 + float(stats.get("active_damage", 0)) * 2.2 + float(stats.get("armor_damage", 0)) * 1.5
	score += float(stats.get("speed", 0.0)) * 34.0 + float(stats.get("data_security", 1.0)) * 14.0
	score -= float(stats.get("deploy_cost", stats.get("cost", 0))) * 0.1
	if role_key == "hero":
		score += 90.0
	elif role_key == "puppet":
		score += 64.0 + float(stats.get("group_count", 1)) * 8.0
	else:
		score += 54.0 + float(stats.get("aura_range", 0.0)) * 42.0 + float(stats.get("pulse_interval", 1.0)) * -8.0
	if starter_score:
		score += 260.0 - float(stats.get("cost", 999)) * 0.65
	return score


func _toggle_sortie_entry(player_id: int, entry: Dictionary) -> String:
	if not _valid_roster_entry(player_id, entry):
		return "无效队伍单位。" if _ui_is_zh() else "Invalid roster entry."
	var loadout := _ensure_sortie_loadout(player_id)
	var pos := _sortie_position_for_entry(player_id, entry)
	if pos >= 0:
		loadout.remove_at(pos)
		sortie_loadouts[player_id] = loadout
		initial_sortie_slot[player_id] = 0 if loadout.is_empty() else clampi(int(initial_sortie_slot.get(player_id, 0)), 0, loadout.size() - 1)
		_normalize_initial_sortie_for_cost(player_id)
		return "已从本场出战中移除 %s。" % _sortie_entry_label(player_id, entry) if _ui_is_zh() else "Removed %s from the match sortie." % _sortie_entry_label(player_id, entry)
	if loadout.size() >= _current_sortie_cap():
		return "出战已满：%s 当前最多带入 %d 个单位。" % [_match_format_name(), _current_sortie_cap()] if _ui_is_zh() else "SORTIE FULL: %s brings at most %d units." % [_match_format_name(), _current_sortie_cap()]
	loadout.append(Dictionary(entry).duplicate(true))
	sortie_loadouts[player_id] = loadout
	_normalize_initial_sortie_for_cost(player_id)
	return "已将 %s 加入出战槽 %d。" % [_sortie_entry_label(player_id, entry), loadout.size()] if _ui_is_zh() else "Added %s to sortie slot %d." % [_sortie_entry_label(player_id, entry), loadout.size()]


func _set_sortie_starter_entry(player_id: int, entry: Dictionary) -> String:
	if not _valid_roster_entry(player_id, entry):
		return "无效首发。" if _ui_is_zh() else "Invalid starter."
	if not _starter_cost_valid(player_id, entry):
		var stats := _compute_unit_stats(player_id, String(entry.get("role", "hero")), int(entry.get("index", 0)))
		return "首发非法：%s 入场价 %d，首发上限 %d。" % [_sortie_entry_label(player_id, entry), int(stats.get("deploy_cost", stats.get("cost", 0))), INITIAL_ENTRY_COST_CAP] if _ui_is_zh() else "INITIAL ILLEGAL: %s deploys for %d, starter cap is %d." % [_sortie_entry_label(player_id, entry), int(stats.get("deploy_cost", stats.get("cost", 0))), INITIAL_ENTRY_COST_CAP]
	var loadout := _ensure_sortie_loadout(player_id)
	var pos := _sortie_position_for_entry(player_id, entry)
	if pos < 0:
		if loadout.size() >= _current_sortie_cap():
			return "出战已满：先移除一个单位，再设为首发。" if _ui_is_zh() else "SORTIE FULL: remove another unit before making this starter."
		loadout.append(Dictionary(entry).duplicate(true))
		sortie_loadouts[player_id] = loadout
		pos = loadout.size() - 1
	initial_sortie_slot[player_id] = pos
	initial_role[player_id] = String(entry.get("role", "hero"))
	return "首发设为槽位 %d：%s。" % [pos + 1, _sortie_entry_label(player_id, entry)] if _ui_is_zh() else "Starter set to slot %d: %s." % [pos + 1, _sortie_entry_label(player_id, entry)]


func _team_battle_entry_summary(player_id: int) -> Dictionary:
	var loadout := _team_sortie_order(player_id)
	var invalid := false
	var notes: Array = []
	var roster_summary := _team_summary(player_id)
	var roster_total := _roster_unit_total(player_id)
	if roster_total != _current_roster_cap():
		invalid = true
		notes.append("roster %d/%d" % [roster_total, _current_roster_cap()])
	if not bool(roster_summary.get("length_valid", false)):
		invalid = true
		notes.append("roster topology/length")
	if not bool(roster_summary.get("budget_valid", true)):
		invalid = true
		notes.append("team cost %d/%d" % [int(roster_summary.get("cost", 0)), START_BUDGET])
	if loadout.is_empty():
		notes.append("no sortie unit selected")
		return {"valid": false, "note": "; ".join(notes)}
	if loadout.size() != _current_sortie_cap():
		invalid = true
		notes.append("sortie %d/%d" % [loadout.size(), _current_sortie_cap()])
	var role_counts := _sortie_role_counts(loadout)
	for required_role in ROLE_ORDER:
		if int(role_counts.get(required_role, 0)) <= 0:
			invalid = true
			notes.append("missing %s" % String(ROLE_NAMES_EN.get(required_role, required_role)))
	var starter := _starter_sortie_entry(player_id)
	var starter_valid := _starter_cost_valid(player_id, starter)
	if not starter_valid:
		var starter_stats := _compute_unit_stats(player_id, String(starter.get("role", "hero")), int(starter.get("index", 0))) if _valid_roster_entry(player_id, starter) else {}
		invalid = true
		notes.append("starter deploy %d/%d" % [int(starter_stats.get("deploy_cost", starter_stats.get("cost", 9999))), INITIAL_ENTRY_COST_CAP])
	for entry in loadout:
		if not _valid_roster_entry(player_id, entry):
			invalid = true
			notes.append("missing unit")
			continue
		var role_key := String(entry.get("role", "hero"))
		var unit_index := int(entry.get("index", 0))
		var unit_bp := _blueprint_for(player_id, role_key, unit_index)
		var stats := _compute_unit_stats(player_id, role_key, unit_index)
		var unit_label := "%s#%d" % [ROLE_NAMES.get(role_key, role_key.to_upper()), unit_index + 1]
		if float(stats.get("length", 0.0)) > 4.5:
			invalid = true
			notes.append("%s length" % unit_label)
		if _role_uses_body_board(role_key) and not _module_material_rule_valid(unit_bp):
			invalid = true
			notes.append("%s material group" % unit_label)
		var topology_note := _topology_rule_note(unit_bp, role_key, stats)
		if topology_note.begins_with("INVALID"):
			invalid = true
			notes.append("%s topology" % unit_label)
		for note_key in ["joint_momentum_note", "slot_payload_note", "drive_note", "stiffness_note"]:
			if role_key == "barrier" and note_key in ["slot_payload_note", "drive_note"]:
				continue
			if String(stats.get(note_key, "")).begins_with("INVALID"):
				invalid = true
				notes.append("%s %s" % [unit_label, note_key.replace("_note", "")])
				break
	return {
		"valid": not invalid,
		"note": "OK" if notes.is_empty() else "; ".join(notes),
		"sortie_count": loadout.size(),
		"starter_valid": starter_valid,
	}


func _set_active_index_from_sortie_entry(player_id: int, entry: Dictionary) -> void:
	if not _valid_roster_entry(player_id, entry):
		return
	var role_key := String(entry.get("role", "hero"))
	active_roster_indices[player_id][role_key] = int(entry.get("index", 0))
	initial_role[player_id] = role_key


func _sortie_entry_label(player_id: int, entry: Dictionary, include_cost: bool = false) -> String:
	var role_key := String(entry.get("role", "hero"))
	var unit_index := int(entry.get("index", 0))
	var label := "%s#%d" % [_role_name(role_key), unit_index + 1]
	if include_cost:
		var stats := _compute_unit_stats(player_id, role_key, unit_index)
		var base_cost := int(stats.get("deploy_cost", 0))
		var live_cost := _discounted_deploy_cost(player_id, role_key, unit_index, base_cost)
		label += " $%d" % live_cost
		if live_cost < base_cost:
			label += "<%d" % base_cost
	return label


func _sortie_line(player_id: int) -> String:
	var loadout := _team_sortie_order(player_id)
	var bindings := _ensure_summon_pair_bindings(player_id)
	var pieces: Array = []
	var starter := clampi(int(initial_sortie_slot.get(player_id, 0)), 0, maxi(0, loadout.size() - 1))
	for i in range(loadout.size()):
		var prefix := "*" if i == starter else ""
		var pair: Array = bindings[i] if i < bindings.size() else []
		pieces.append("%d%s[%s]:%s" % [i + 1, prefix, _pair_label(pair), _sortie_entry_label(player_id, loadout[i])])
	return ("出战 %d/%d %s" if _ui_is_zh() else "SORTIE %d/%d %s") % [loadout.size(), _current_sortie_cap(), "  ".join(pieces)]


func _editor_team_order_entries(player_id: int) -> Array:
	var entries: Array = []
	for entry in _all_roster_order(player_id):
		if not (entry is Dictionary):
			continue
		var reserve_entry := Dictionary(entry).duplicate(true)
		reserve_entry["in_sortie"] = false
		entries.append(reserve_entry)
	while entries.size() < _current_roster_cap():
		var empty_slot := entries.size()
		entries.append({
			"empty": true,
			"slot": empty_slot,
			"role": String(ROLE_ORDER[empty_slot % ROLE_ORDER.size()]),
			"index": -1,
			"in_sortie": false,
		})
	return entries


func _select_editor_entry(entry: Dictionary, update_ui: bool = true) -> void:
	var player_id := _editor_player()
	if not _valid_roster_entry(player_id, entry):
		return
	editor_canvas_mode = "roster_unit"
	var role_key := String(entry.get("role", "hero"))
	var unit_index := int(entry.get("index", 0))
	editor_role_index = ROLE_ORDER.find(role_key)
	if editor_role_index < 0:
		editor_role_index = 0
	editor_unit_indices[role_key] = unit_index
	active_roster_indices[player_id][role_key] = unit_index
	if update_ui:
		_update_editor_ui()


func _editor_load_entries() -> Array:
	var player_id := _editor_player()
	if editor_load_mode == "team":
		return _editor_team_order_entries(player_id)
	if editor_load_mode == "unit":
		return _unit_library_entries()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var roster: Array = blueprints.get(player_id, {}).get(role_key, [])
	var entries: Array = []
	for i in range(roster.size()):
		entries.append({"role": role_key, "index": i, "in_sortie": _sortie_position(player_id, role_key, i) >= 0})
	return entries


func _select_editor_load_card(card_index: int) -> void:
	var entries := _editor_load_entries()
	var actual_index := editor_load_page * maxi(1, editor_load_card_buttons.size()) + card_index
	if actual_index < 0 or actual_index >= entries.size():
		return
	var entry: Dictionary = entries[actual_index]
	if bool(entry.get("unit_library", false)):
		_load_unit_library_entry_to_canvas(entry)
		return
	if bool(entry.get("empty", false)):
		_reset_editor_working_canvas(String(entry.get("role", ROLE_ORDER[editor_role_index])))
		editor_summary_label.text = "已打开空队伍槽 %02d，可在空白画布组装后存入队伍。" % [actual_index + 1] if _ui_is_zh() else "Opened empty roster slot %02d. Build on the blank canvas, then save it into the roster." % [actual_index + 1]
		_update_editor_ui()
		return
	_select_editor_entry(entry)


func _hover_editor_load_card(card_index: int) -> void:
	var entries := _editor_load_entries()
	var actual_index := editor_load_page * maxi(1, editor_load_card_buttons.size()) + card_index
	if actual_index < 0 or actual_index >= entries.size():
		return
	var entry: Dictionary = entries[actual_index]
	if bool(entry.get("unit_library", false)):
		_show_editor_library_unit_hover(entry)
		return
	if bool(entry.get("empty", false)):
		_show_editor_empty_slot_hover(actual_index)
		return
	_show_editor_unit_hover(entry)


func _change_editor_roster_page(direction: int) -> void:
	var entries := _editor_team_order_entries(_editor_player())
	var page_size := maxi(1, editor_roster_slot_buttons.size())
	var max_page := maxi(0, int(ceilf(float(entries.size()) / float(page_size))) - 1)
	editor_roster_page = clampi(editor_roster_page + direction, 0, max_page)
	_update_editor_roster_overview()


func _editor_roster_entry_for_overview_slot(local_slot: int) -> Dictionary:
	var entries := _editor_team_order_entries(_editor_player())
	var page_size := maxi(1, editor_roster_slot_buttons.size())
	var actual_index := editor_roster_page * page_size + local_slot
	if actual_index < 0 or actual_index >= entries.size():
		return {}
	return Dictionary(entries[actual_index]).duplicate(true)


func _select_editor_roster_overview_slot(local_slot: int) -> void:
	var entry := _editor_roster_entry_for_overview_slot(local_slot)
	if entry.is_empty():
		return
	if bool(entry.get("empty", false)):
		_reset_editor_working_canvas(String(entry.get("role", ROLE_ORDER[editor_role_index])))
		editor_summary_label.text = "已选择空队伍槽 %02d。当前画布仍为 0 造价，保存后才写入%s队伍。" % [int(entry.get("slot", 0)) + 1, _match_format_name()] if _ui_is_zh() else "Selected empty roster slot %02d. The canvas stays zero-cost until you save it into the %s roster." % [int(entry.get("slot", 0)) + 1, _match_format_name()]
		_update_editor_ui()
		return
	_enter_editor_roster_entry(entry)


func _hover_editor_roster_overview_slot(local_slot: int) -> void:
	var entry := _editor_roster_entry_for_overview_slot(local_slot)
	if entry.is_empty():
		_clear_editor_unit_hover_card()
		return
	if bool(entry.get("empty", false)):
		_show_editor_empty_slot_hover(int(entry.get("slot", local_slot)))
		return
	_show_editor_unit_hover(entry)


func _update_editor_roster_overview() -> void:
	if editor_roster_slot_buttons.is_empty():
		return
	if editor_section_labels.has("roster_overview"):
		_set_canvas_item_visible_if_changed(editor_section_labels["roster_overview"], false)
	if editor_section_labels.has("roster_page"):
		_set_canvas_item_visible_if_changed(editor_section_labels["roster_page"], false)
	for i in range(editor_roster_slot_buttons.size()):
		_set_canvas_item_visible_if_changed(editor_roster_slot_buttons[i], false)
		_set_button_disabled_if_changed(editor_roster_slot_buttons[i], true)
		if i < editor_roster_slot_thumb_views.size():
			_set_canvas_item_visible_if_changed(editor_roster_slot_thumb_views[i], false)
	return
	var player_id := _editor_player()
	var entries := _editor_team_order_entries(player_id)
	var page_size := maxi(1, editor_roster_slot_buttons.size())
	var max_page := maxi(0, int(ceilf(float(entries.size()) / float(page_size))) - 1)
	editor_roster_page = clampi(editor_roster_page, 0, max_page)
	if editor_section_labels.has("roster_overview"):
		var label: Label = editor_section_labels["roster_overview"]
		label.text = ("队伍 %s" if _ui_is_zh() else "TEAM %s") % _match_format_short()
	if editor_section_labels.has("roster_page"):
		var page_label: Label = editor_section_labels["roster_page"]
		page_label.text = "%d/%d" % [editor_roster_page + 1, max_page + 1]
	for i in range(editor_roster_slot_buttons.size()):
		var actual_index := editor_roster_page * page_size + i
		var button: Button = editor_roster_slot_buttons[i]
		var thumb: SortieThumbView = editor_roster_slot_thumb_views[i] if i < editor_roster_slot_thumb_views.size() else null
		var visible_entry := actual_index < entries.size()
		button.visible = visible_entry
		button.disabled = not visible_entry
		if thumb != null:
			thumb.visible = visible_entry
		if not visible_entry:
			button.text = ""
			if thumb != null:
				thumb.set_entry(player_id, actual_index, {}, {}, "reserve", ui_language)
			continue
		var entry: Dictionary = entries[actual_index]
		if bool(entry.get("empty", false)):
			var empty_role := String(entry.get("role", ROLE_ORDER[actual_index % ROLE_ORDER.size()]))
			button.text = "%02d %s 空" % [actual_index + 1, _role_short(empty_role)] if _ui_is_zh() else "%02d %s -" % [actual_index + 1, _role_short(empty_role)]
			button.modulate = Color(0.58, 0.64, 0.68, 0.76)
			if thumb != null:
				var empty_stats := _compute_unit_stats(player_id, empty_role, -1, _make_editor_blank_blueprint(empty_role))
				thumb.set_entry(player_id, actual_index, entry, empty_stats, "reserve", ui_language)
			continue
		var role_key := String(entry.get("role", "hero"))
		var unit_index := int(entry.get("index", 0))
		var stats := _compute_unit_stats(player_id, role_key, unit_index)
		var selected: bool = not _editor_is_blank_work_canvas() and role_key == ROLE_ORDER[editor_role_index] and unit_index == int(editor_unit_indices.get(role_key, 0))
		var blank: bool = bool(stats.get("blank_canvas", false))
		var role_short: String = _role_short(role_key)
		button.text = "%02d %s %d%s" % [actual_index + 1, role_short, int(stats.get("cost", 0)), " 空" if _ui_is_zh() and blank else (" BLK" if blank else "")]
		button.modulate = Color(1.0, 0.86, 0.28, 1.0) if selected else Color(0.82, 0.9, 0.94, 0.92)
		if thumb != null:
			thumb.set_entry(player_id, actual_index, entry, stats, "pending" if selected else ("reserve" if blank else "live"), ui_language)


func _show_editor_empty_slot_hover(slot_index: int) -> void:
	if editor_unit_hover_view == null:
		return
	editor_unit_hover_view.position = Vector2(410.0, 118.0)
	editor_unit_hover_view.size = Vector2(466.0, 500.0)
	editor_unit_hover_view.visible = true
	editor_unit_hover_view.move_to_front()
	editor_unit_hover_view.clear("空队伍槽 %02d\n当前没有放入单位。\n请先在单位库保存或载入单个单位，再在队伍编成界面填入槽位。" % [slot_index + 1] if _ui_is_zh() else "Empty roster slot %02d\nNo unit assigned.\nSave or load a single unit in the unit library first, then fill this slot in Team Compose." % [slot_index + 1])


func _clear_editor_unit_hover_card() -> void:
	if editor_unit_hover_view != null:
		editor_unit_hover_view.visible = false


func _show_editor_unit_hover(entry: Dictionary) -> void:
	if editor_unit_hover_view == null:
		return
	if bool(entry.get("empty", false)):
		_show_editor_empty_slot_hover(int(entry.get("slot", 0)))
		return
	var player_id := _editor_player()
	if not _valid_roster_entry(player_id, entry):
		return
	var role_key := String(entry.get("role", "hero"))
	var unit_index := int(entry.get("index", 0))
	var stats := _compute_unit_stats(player_id, role_key, unit_index)
	var detail := _editor_unit_hover_detail(player_id, role_key, unit_index, stats)
	editor_unit_hover_view.position = Vector2(410.0, 118.0)
	editor_unit_hover_view.size = Vector2(466.0, 500.0)
	editor_unit_hover_view.visible = true
	editor_unit_hover_view.move_to_front()
	editor_unit_hover_view.set_unit(player_id, entry, stats, detail, ui_language)


func _editor_unit_hover_detail(player_id: int, role_key: String, unit_index: int, stats: Dictionary) -> String:
	var unit_bp := _blueprint_for(player_id, role_key, unit_index)
	var lines: Array = []
	if _ui_is_zh():
		lines.append("缩略预览：点击右侧卡片才会切换当前画布；悬停只查看。")
		lines.append("当前单位造价 %d / 入场 %d / 长度 %.2f / 质量 %.0f" % [int(stats.get("cost", 0)), int(stats.get("deploy_cost", 0)), float(stats.get("length", 0.0)), float(stats.get("mass", 0.0))])
		lines.append("拓扑：%s" % _localized_system_text(_topology_rule_note(unit_bp, role_key, stats)))
		if _role_uses_body_board(role_key):
			var topology: Dictionary = unit_bp.get("custom_topology", {})
			lines.append("画布节点 %d / 连接 %d" % [Array(topology.get("nodes", [])).size(), Array(topology.get("edges", [])).size()])
		else:
			lines.append("结界板块 %d" % Array(unit_bp.get("barrier_tiles", [])).size())
	else:
		lines.append("Thumbnail preview: click the right card to switch canvas; hover only inspects.")
		lines.append("Unit cost %d / deploy %d / length %.2f / mass %.0f" % [int(stats.get("cost", 0)), int(stats.get("deploy_cost", 0)), float(stats.get("length", 0.0)), float(stats.get("mass", 0.0))])
		lines.append("Topology: %s" % _topology_rule_note(unit_bp, role_key, stats))
		if _role_uses_body_board(role_key):
			var topology_en: Dictionary = unit_bp.get("custom_topology", {})
			lines.append("Canvas nodes %d / links %d" % [Array(topology_en.get("nodes", [])).size(), Array(topology_en.get("edges", [])).size()])
		else:
			lines.append("Barrier tiles %d" % Array(unit_bp.get("barrier_tiles", [])).size())
	for key in ["power_note", "slot_payload_note", "joint_momentum_note", "momentum_note", "stiffness_note"]:
		var note := String(stats.get(key, ""))
		if note != "":
			lines.append(_localized_system_text(note) if _ui_is_zh() else note)
	return "\n".join(lines)


func _handle_editor_load_card_input(event: InputEvent, card_index: int) -> void:
	if editor_load_mode != "team":
		return
	if event is InputEventMouseButton:
		var mouse_event := event as InputEventMouseButton
		if mouse_event.button_index != MOUSE_BUTTON_LEFT:
			return
		var actual_index := editor_load_page * maxi(1, editor_load_card_buttons.size()) + card_index
		if mouse_event.pressed:
			editor_load_drag_index = actual_index
		elif editor_load_drag_index >= 0:
			if editor_load_drag_index != actual_index:
				_reorder_editor_team_cards(editor_load_drag_index, actual_index)
			editor_load_drag_index = -1


func _reorder_editor_team_cards(from_index: int, to_index: int) -> void:
	if editor_summary_label != null:
		editor_summary_label.text = "TeamEdit 现在只管理%s构筑；本场出战顺序请在赛前出战选择界面重排。" % _match_format_name() if _ui_is_zh() else "TeamEdit now manages the %s build; reorder this match's sortie in the pre-battle sortie screen." % _match_format_name()


func _set_current_as_initial_sortie() -> void:
	editor_summary_label.text = "TeamEdit 只编辑%s队伍；首发请在战斗前出战选择界面决定。" % _match_format_name() if _ui_is_zh() else "TeamEdit only builds the %s roster; choose starter in the pre-battle sortie screen." % _match_format_name()
	return
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_index := int(editor_unit_indices[role_key])
	var pos := _sortie_position(player_id, role_key, unit_index)
	if pos < 0:
		var loadout := _ensure_sortie_loadout(player_id)
		if loadout.size() >= _current_sortie_cap():
			editor_summary_label.text = "出战已满：先移除或重排一个单位，再设为首发。" if _ui_is_zh() else "SORTIE FULL: remove or reorder another unit before setting this starter."
			return
		loadout.append({"role": role_key, "index": unit_index})
		sortie_loadouts[player_id] = loadout
		pos = loadout.size() - 1
	initial_sortie_slot[player_id] = pos
	initial_role[player_id] = role_key
	ai_team_manual_lock[player_id] = true
	editor_summary_label.text = "P%d 首发设为出战槽 %d：%s。" % [player_id, pos + 1, _sortie_entry_label(player_id, {"role": role_key, "index": unit_index})] if _ui_is_zh() else "P%d starter set to sortie slot %d: %s." % [player_id, pos + 1, _sortie_entry_label(player_id, {"role": role_key, "index": unit_index})]


func _toggle_current_sortie() -> void:
	editor_summary_label.text = "TeamEdit 只编辑%s队伍；本场出战请在战斗前选择。" % _match_format_name() if _ui_is_zh() else "TeamEdit only builds the %s roster; choose sortie units before the match." % _match_format_name()
	return
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_index := int(editor_unit_indices[role_key])
	var loadout := _ensure_sortie_loadout(player_id)
	var pos := _sortie_position(player_id, role_key, unit_index)
	if pos >= 0:
		if loadout.size() <= 1:
			editor_summary_label.text = "至少保留一个出战单位。" if _ui_is_zh() else "At least one sortie unit must remain selected."
			return
		loadout.remove_at(pos)
		sortie_loadouts[player_id] = loadout
		initial_sortie_slot[player_id] = clampi(int(initial_sortie_slot.get(player_id, 0)), 0, loadout.size() - 1)
		ai_team_manual_lock[player_id] = true
		editor_summary_label.text = "已从本场出战中移除 %s。" % _sortie_entry_label(player_id, {"role": role_key, "index": unit_index}) if _ui_is_zh() else "Removed %s from the match sortie." % _sortie_entry_label(player_id, {"role": role_key, "index": unit_index})
		return
	if loadout.size() >= _current_sortie_cap():
		editor_summary_label.text = "出战已满：%s 当前最多带入 %d 个单位。" % [_match_format_name(), _current_sortie_cap()] if _ui_is_zh() else "SORTIE FULL: %s brings at most %d units." % [_match_format_name(), _current_sortie_cap()]
		return
	loadout.append({"role": role_key, "index": unit_index})
	sortie_loadouts[player_id] = loadout
	ai_team_manual_lock[player_id] = true
	editor_summary_label.text = "已将 %s 加入出战槽 %d。" % [_sortie_entry_label(player_id, {"role": role_key, "index": unit_index}), loadout.size()] if _ui_is_zh() else "Added %s to sortie slot %d." % [_sortie_entry_label(player_id, {"role": role_key, "index": unit_index}), loadout.size()]


func _move_current_sortie(direction: int) -> void:
	editor_summary_label.text = "出战顺序请在战斗前出战选择界面调整。" if _ui_is_zh() else "Adjust sortie order in the pre-battle sortie screen."
	return
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_index := int(editor_unit_indices[role_key])
	var loadout := _ensure_sortie_loadout(player_id)
	var pos := _sortie_position(player_id, role_key, unit_index)
	if pos < 0:
		editor_summary_label.text = "先把该单位加入出战，再调整顺序。" if _ui_is_zh() else "Add this unit to SORTIE before reordering it."
		return
	var next_pos := clampi(pos + direction, 0, loadout.size() - 1)
	if next_pos == pos:
		return
	var temp = loadout[pos]
	loadout[pos] = loadout[next_pos]
	loadout[next_pos] = temp
	if int(initial_sortie_slot.get(player_id, 0)) == pos:
		initial_sortie_slot[player_id] = next_pos
	elif int(initial_sortie_slot.get(player_id, 0)) == next_pos:
		initial_sortie_slot[player_id] = pos
	sortie_loadouts[player_id] = loadout
	ai_team_manual_lock[player_id] = true


func _update_sortie_after_delete(player_id: int, role_key: String, deleted_index: int) -> void:
	var raw: Array = sortie_loadouts.get(player_id, [])
	var fixed: Array = []
	var seen := {}
	for item in raw:
		if not (item is Dictionary):
			continue
		var entry: Dictionary = Dictionary(item).duplicate(true)
		if String(entry.get("role", "")) == role_key:
			var idx := int(entry.get("index", -1))
			if idx == deleted_index:
				continue
			if idx > deleted_index:
				entry["index"] = idx - 1
		if not _valid_roster_entry(player_id, entry):
			continue
		var ref := _entry_ref(entry)
		if seen.has(ref):
			continue
		seen[ref] = true
		fixed.append(entry)
		if fixed.size() >= _current_sortie_cap():
			break
	sortie_loadouts[player_id] = fixed
	initial_sortie_slot[player_id] = 0 if fixed.is_empty() else clampi(int(initial_sortie_slot.get(player_id, 0)), 0, fixed.size() - 1)


func _navigation_current_page() -> String:
	if navigation_service != null and navigation_service.current_page() != "":
		return navigation_service.current_page()
	return game_state


func _navigation_return_target_for(target_state: String, explicit_return_target: String = "") -> String:
	if navigation_service != null:
		return navigation_service.return_target_for(target_state, explicit_return_target)
	if explicit_return_target != "":
		return explicit_return_target
	var current := _navigation_current_page()
	if current == STATE_LOADING:
		current = game_state
	match target_state:
		STATE_SETTINGS:
			if current != "" and current != STATE_SETTINGS and current != STATE_LOADING:
				return current
		STATE_SAVED_UNITS:
			return STATE_EDITOR if current == STATE_EDITOR else STATE_MENU
	return ""


func _begin_page_navigation(target_state: String, reason: String, return_target: String = "", payload: Dictionary = {}) -> void:
	if navigation_service == null:
		return
	navigation_service.begin_transition(target_state, reason, _navigation_return_target_for(target_state, return_target), payload)


func _commit_page_state(target_state: String, reason: String = "", payload: Dictionary = {}, return_target: String = "") -> void:
	var nav_reason := reason
	if nav_reason == "":
		nav_reason = "navigation:%s" % target_state
	if navigation_service != null:
		if return_target != "":
			navigation_service.begin_transition(target_state, nav_reason, return_target, payload)
		navigation_service.commit_transition(target_state, nav_reason, payload)
	game_state = target_state
	if game_state_store != null:
		game_state_store.set_app_mode(target_state, nav_reason)
	if dirty_graph != null:
		dirty_graph.mark(GameStateStore.DOMAIN_GLOBAL, 1, nav_reason)
	_hide_page_options()


func _show_battle_layer_without_reset(reason: String = "return_battle") -> void:
	_commit_page_state(STATE_BATTLE, reason, {"mode": battle_mode, "preserve_runtime": true})
	_set_visible_layer(hud_layer)
	_update_battle_ui()


func _navigate_page(route_action: Dictionary) -> void:
	match String(route_action.get("action", NavigationService.ACTION_NAVIGATE_MENU)):
		NavigationService.ACTION_CLOSE:
			return
		NavigationService.ACTION_SHOW_HELP:
			_show_context_help(String(route_action.get("context", "")))
		NavigationService.ACTION_SETTINGS_ROOT:
			_show_settings_category("root")
		NavigationService.ACTION_NAVIGATE_MENU:
			_show_menu()
		NavigationService.ACTION_NAVIGATE_SETTINGS:
			_show_settings()
		NavigationService.ACTION_NAVIGATE_RETURN_TARGET:
			_navigate_to_page_target(String(route_action.get("to_page", "")), String(route_action.get("reason", "page_options_back")))
		NavigationService.ACTION_NAVIGATE_EDITOR_PRESERVE:
			_show_editor_preserve_canvas()
		NavigationService.ACTION_NAVIGATE_SAVED_UNITS:
			_show_saved_units_library("", _navigation_return_target_for(STATE_SAVED_UNITS), false)
		NavigationService.ACTION_NAVIGATE_SCOUT:
			_show_scout(pending_battle_mode)
		NavigationService.ACTION_NAVIGATE_BATTLE_PRESERVE:
			_show_battle_layer_without_reset(String(route_action.get("reason", "return_battle")))
		_:
			_show_menu()


func _navigate_to_page_target(target_state: String, reason: String = "navigation_return") -> void:
	var action := navigation_service.resolve_target_navigation(target_state, reason) if navigation_service != null else NavigationService.route_action(NavigationService.ACTION_NAVIGATE_MENU, STATE_MENU, reason)
	_navigate_page(action)


func _show_menu(preloaded: bool = false) -> void:
	if not preloaded and _should_queue_loading_transition(STATE_MENU):
		queue_loading_transition(STATE_MENU, "menu", preload_menu_content(), Callable(self, "_show_menu").bind(true))
		return
	_restore_ai_side_roster_mapping()
	_commit_page_state(STATE_MENU, "menu")
	_clear_all_units()
	_hide_match_format_select()
	editor_board_zoom = 1.0
	editor_board_view_offset = Vector2.ZERO
	_refresh_editor_board_zoom_ui()
	_set_visible_layer(menu_layer)
	_update_menu_ui()


func _apply_ai_side_roster_mapping(mode: String) -> void:
	if ai_side_swap_active:
		return
	if mode != MODE_AI or ai_battle_seat != 2:
		return
	ai_side_swap_snapshot = {
		"blueprints": blueprints.duplicate(true),
		"active_roster_indices": active_roster_indices.duplicate(true),
		"initial_role": initial_role.duplicate(true),
		"initial_sortie_slot": initial_sortie_slot.duplicate(true),
		"sortie_loadouts": sortie_loadouts.duplicate(true),
		"summon_pair_bindings": summon_pair_bindings.duplicate(true),
		"team_color_indices": team_color_indices.duplicate(true),
		"team_custom_colors": team_custom_colors.duplicate(true),
	}
	var original_blueprints: Dictionary = ai_side_swap_snapshot["blueprints"]
	var original_active: Dictionary = ai_side_swap_snapshot["active_roster_indices"]
	var original_initial_role: Dictionary = ai_side_swap_snapshot["initial_role"]
	var original_initial_slot: Dictionary = ai_side_swap_snapshot["initial_sortie_slot"]
	var original_loadouts: Dictionary = ai_side_swap_snapshot["sortie_loadouts"]
	var original_bindings: Dictionary = ai_side_swap_snapshot["summon_pair_bindings"]
	var original_colors: Dictionary = ai_side_swap_snapshot["team_color_indices"]
	var original_custom_colors: Dictionary = ai_side_swap_snapshot["team_custom_colors"]
	blueprints[1] = original_blueprints[2].duplicate(true)
	blueprints[2] = original_blueprints[1].duplicate(true)
	active_roster_indices[1] = original_active[2].duplicate(true)
	active_roster_indices[2] = original_active[1].duplicate(true)
	initial_role[1] = original_initial_role[2]
	initial_role[2] = original_initial_role[1]
	initial_sortie_slot[1] = original_initial_slot[2]
	initial_sortie_slot[2] = original_initial_slot[1]
	sortie_loadouts[1] = original_loadouts[2].duplicate(true)
	sortie_loadouts[2] = original_loadouts[1].duplicate(true)
	summon_pair_bindings[1] = original_bindings[2].duplicate(true)
	summon_pair_bindings[2] = original_bindings[1].duplicate(true)
	team_color_indices[1] = int(original_colors.get(2, 1))
	team_color_indices[2] = int(original_colors.get(1, 0))
	team_custom_colors[1] = Dictionary(original_custom_colors.get(2, team_custom_colors[2])).duplicate(true)
	team_custom_colors[2] = Dictionary(original_custom_colors.get(1, team_custom_colors[1])).duplicate(true)
	ai_side_swap_active = true


func _restore_ai_side_roster_mapping() -> void:
	if not ai_side_swap_active or ai_side_swap_snapshot.is_empty():
		return
	blueprints = Dictionary(ai_side_swap_snapshot.get("blueprints", blueprints)).duplicate(true)
	active_roster_indices = Dictionary(ai_side_swap_snapshot.get("active_roster_indices", active_roster_indices)).duplicate(true)
	initial_role = Dictionary(ai_side_swap_snapshot.get("initial_role", initial_role)).duplicate(true)
	initial_sortie_slot = Dictionary(ai_side_swap_snapshot.get("initial_sortie_slot", initial_sortie_slot)).duplicate(true)
	sortie_loadouts = Dictionary(ai_side_swap_snapshot.get("sortie_loadouts", sortie_loadouts)).duplicate(true)
	summon_pair_bindings = Dictionary(ai_side_swap_snapshot.get("summon_pair_bindings", summon_pair_bindings)).duplicate(true)
	team_color_indices = Dictionary(ai_side_swap_snapshot.get("team_color_indices", team_color_indices)).duplicate(true)
	team_custom_colors = Dictionary(ai_side_swap_snapshot.get("team_custom_colors", team_custom_colors)).duplicate(true)
	ai_side_swap_active = false
	ai_side_swap_snapshot = {}


