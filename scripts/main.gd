func _stiffness_segment_group_for_hit(target, event: Dictionary) -> Dictionary:
	return {}


func _stiffness_segment_name_for_hit(target, event: Dictionary) -> String:
	var part_kind := String(event.get("target_part_kind", "core"))
	if part_kind == "torso":
		var torso_unit := _target_torso_stiffness_segment(target, int(event.get("target_torso_unit_index", -1)))
		if not torso_unit.is_empty():
			return String(torso_unit.get("name", "TORSO"))
		return "TORSO"
	if part_kind in ["core", "body", "barrier_tile"]:
		return "TORSO"
	var group := _stiffness_segment_group_for_hit(target, event)
	if group.is_empty():
		return "TORSO"
	if part_kind == "terminal":
		return "%s TERMINAL" % String(group.get("name", "LIMB"))
	return "%s LIMB" % String(group.get("name", "LIMB"))


func _target_projectile_material_resistance(target, event: Dictionary, damage_type: String) -> float:
	if target == null or not is_instance_valid(target):
		return 1.0
	var part_kind := String(event.get("target_part_kind", "core"))
	var group := _stiffness_segment_group_for_hit(target, event)
	var resistance_source: Dictionary = {}
	if not group.is_empty():
		match part_kind:
			"joint":
				resistance_source = group.get("joint_resist", {})
			"limb_muscle", "melee_sweep", "projectile_trace":
				resistance_source = group.get("limb_resist", {})
			"terminal":
				resistance_source = group.get("terminal_resist", {})
	if resistance_source.is_empty():
		if part_kind == "torso":
			var torso_unit := _target_torso_stiffness_segment(target, int(event.get("target_torso_unit_index", -1)))
			if not torso_unit.is_empty():
				resistance_source = torso_unit.get("resist", {})
		if resistance_source.is_empty():
			resistance_source = target.stats.get("torso_resist", target.stats.get("resistances", {}))
	return clampf(float(resistance_source.get(damage_type, 1.0)), PROJECTILE_PART_RESIST_MIN, PROJECTILE_PART_RESIST_MAX)


func _projectile_material_adjusted_damage(target, event: Dictionary, damage: int) -> int:
	# Temporary projectile-only material hook. Entity collision and melee never
	# use this path; they go through _apply_runtime_contact_damage().
	event["contact_gate_blocked"] = false
	if damage <= 0 or target == null or not is_instance_valid(target):
		return damage
	var damage_type := String(event.get("damage_type", "blunt"))
	var adjusted_damage := float(damage)
	var projectile_hit := bool(event.get("projectile", false)) or damage_type in PROJECTILE_DAMAGE_TYPES
	if projectile_hit:
		var resist_mult := _target_projectile_material_resistance(target, event, damage_type)
		event["projectile_material_resist"] = resist_mult
		adjusted_damage *= resist_mult
	event["damage_after_material_resist"] = adjusted_damage
	event["contact_gate_model"] = "projectile_material_only"
	return max(1, int(roundf(adjusted_damage)))


func _part_disabled(unit, attack_index: int) -> bool:
