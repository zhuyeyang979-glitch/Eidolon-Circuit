			filter_text = _part_filter_name(Dictionary(filter_options[i]))
		var filter_plan := UILifecycleService.editor_part_filter_button_presentation(
			i,
			filter_options,
			editor_part_group_mode,
			editor_part_filter_mode,
			parts_visible,
			filter_text
