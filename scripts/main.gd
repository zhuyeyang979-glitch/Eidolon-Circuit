func _barrier_extra_ether_indices(unit_bp: Dictionary) -> Array:
	var extra: Array = []
	var primary_index := int(unit_bp.get("special", 0))
	for raw_index in Array(unit_bp.get("ether_group", [])):
		var index := int(raw_index)
		if index == primary_index or extra.has(index):
			continue
		extra.append(index)
	return extra


func _merge_ether_stats(stats: Dictionary, ether_part: Dictionary) -> void:
	_unit_stats_service().apply_ether_payload_stats(stats, ether_part, {
		"default_momentum_threshold_coeff": BARRIER_DEFAULT_MOMENTUM_THRESHOLD_COEFF,
	})


func _unit_blueprint_is_blank_canvas(role_key: String, unit_bp: Dictionary) -> bool:
	if not bool(unit_bp.get("blank_canvas", false)):
		return false
	if role_key == "barrier":
		var topology_for_barrier: Dictionary = unit_bp.get("custom_topology", {})
		return Array(unit_bp.get("barrier_tiles", [])).is_empty() and Array(topology_for_barrier.get("nodes", [])).is_empty() and Array(unit_bp.get("slot_payloads", [])).is_empty()
	if not _role_uses_body_board(role_key):
		return false
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	return Array(topology.get("nodes", [])).is_empty() and Array(unit_bp.get("slot_payloads", [])).is_empty()


func _unit_uses_component_pricing(unit_bp: Dictionary) -> bool:
	if not unit_bp.has("custom_topology"):
		return false
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	return _topology_uses_component_nodes(Array(topology.get("nodes", [])))


func _engine_idle_heat_for_part(part: Dictionary, power: float, scale: float = 1.0) -> float:
	var output := power
	if output <= 0.0:
		output = _engine_momentum_output_for_part(part)
	var defaults := _engine_family_defaults(String(part.get("engine_family", "balanced")))
	var heat_coeff := maxf(0.0, float(part.get("engine_heat_coeff", defaults.get("engine_heat_coeff", 0.055))))
	return maxf(0.0, output * heat_coeff * scale)


