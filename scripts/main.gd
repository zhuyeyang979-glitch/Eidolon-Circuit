func _runtime_binding_for_attack_index(unit, attack_index: int) -> Dictionary:
	if not _unit_uses_direct_runtime_topology(unit):
		return {}
	var desired_key := clampi(attack_index + 1, 1, ATTACK_GROUP_COUNT)
	for raw_binding in Array(unit.stats.get("runtime_module_bindings", [])):
		if not (raw_binding is Dictionary):
			continue
		var binding: Dictionary = raw_binding
		if not bool(binding.get("runtime_valid", true)):
			continue
		if int(binding.get("attack_key", -1)) == desired_key:
			return binding.duplicate(true)
	return {}


