	if not _role_uses_body_board(role_key):
		return false
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	return Array(topology.get("nodes", [])).is_empty() and Array(unit_bp.get("slot_payloads", [])).is_empty()


