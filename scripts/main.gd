func _editor_vector_signature(value) -> String:
	if value is Vector2:
		var v: Vector2 = value
		return "%.4f,%.4f" % [snappedf(v.x, 0.0001), snappedf(v.y, 0.0001)]
	return str(value)


func _editor_int_array_signature(values: Array) -> String:
	if values.is_empty():
		return ""
	var normalized: Array = []
	for raw_value in values:
		normalized.append(int(raw_value))
	normalized.sort()
	var bits: Array = []
	for i in range(mini(normalized.size(), 64)):
		bits.append(str(int(normalized[i])))
	return ",".join(bits)


func _editor_payload_light_signature(payloads: Array) -> String:
	if payloads.is_empty():
		return "0"
	var bits: Array = [str(payloads.size())]
	for i in range(payloads.size()):
		if not (payloads[i] is Dictionary):
			bits.append("%d:_" % i)
			continue
		var payload: Dictionary = payloads[i]
		bits.append("%d:%d:%d:%d:%d:%s:%s" % [
			i,
			int(payload.get("torso_node", -1)),
			int(payload.get("slot", payload.get("slot_index", -1))),
			int(payload.get("module", payload.get("module_index", -1))),
			int(payload.get("part_index", -1)),
			String(payload.get("kind", "")),
			String(payload.get("attack_key", "")),
		])
	return "|".join(bits)


func _editor_topology_light_signature(topology: Dictionary) -> String:
	editor_board_light_signature_count += 1
	var nodes: Array = Array(topology.get("nodes", []))
	var edges: Array = Array(topology.get("edges", []))
	var bits: Array = ["n%d" % nodes.size(), "e%d" % edges.size()]
	for i in range(nodes.size()):
		if not (nodes[i] is Dictionary):
			bits.append("%d:_" % i)
			continue
		var node: Dictionary = nodes[i]
		bits.append("%d:%s:%s:%d:%s:%s:%s:%s:%s:%s:%s" % [
			i,
			String(node.get("slot", "")),
			String(node.get("label", "")),
			_topology_node_part_index(node, {}),
			_editor_vector_signature(node.get("pos", Vector2.ZERO)),
			_editor_vector_signature(node.get("axis", Vector2.RIGHT)),
			str(snappedf(float(node.get("rotation", 0.0)), 0.0001)),
			str(snappedf(float(node.get("local_angle", 0.0)), 0.0001)),
			str(snappedf(float(node.get("local_extension", 0.0)), 0.0001)),
			_topology_node_visual_handedness(node) if node.has("visual_mount_side") or node.has("visual_handedness") else "",
			_editor_int_array_signature(Array(node.get("modules", []))),
		])
	for i in range(edges.size()):
		var edge = edges[i]
		if edge is Dictionary:
			var dict: Dictionary = edge
			bits.append("E%d:%d:%d:%s:%s" % [
				i,
				int(dict.get("a_node", dict.get("a", -1))),
				int(dict.get("b_node", dict.get("b", -1))),
				String(dict.get("a_socket", "")),
				String(dict.get("b_socket", "")),
			])
		elif edge is Array and Array(edge).size() >= 2:
			bits.append("E%d:%d:%d" % [i, int(edge[0]), int(edge[1])])
	return "|".join(bits)


func _editor_board_snapshot_cache_key(role_key: String, unit_bp: Dictionary) -> String:
	if not _role_uses_body_board(role_key) or not unit_bp.has("custom_topology"):
		return ""
	if role_key == "barrier" and _barrier_uses_screen_board(unit_bp):
		return ""
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", []))
	var edges: Array = Array(topology.get("edges", []))
	var bits: Array = [
		role_key,
		ui_language,
		_editor_topology_light_signature(topology),
		_editor_payload_light_signature(Array(unit_bp.get("slot_payloads", []))),
		"%d:%d" % [nodes.size(), edges.size()],
	]
	return "|".join(bits)


