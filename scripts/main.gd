func _gun_family_for_part(part: Dictionary) -> String:
	var explicit := String(part.get("gun_kind", part.get("weapon_family", ""))).to_lower()
	if explicit != "":
		return explicit
	var material_class := String(part.get("material_class", "")).to_lower()
	if material_class == "web_gun":
		return "web"
	if material_class == "missile_launcher":
		return "missile_launcher"
	return _gun_kind_for_data(part)


func _gun_family_matches_filter(part: Dictionary, filter_key: String) -> bool:
	var gun_kind := _gun_family_for_part(part)
	match filter_key:
		"gun_sniper":
			return gun_kind == "sniper"
		"gun_rifle":
			return gun_kind == "rifle"
		"gun_laser_gun":
			return gun_kind == "laser_gun"
		"gun_sprayer":
			return gun_kind == "sprayer"
		"gun_grenade_launcher":
			return gun_kind == "grenade_launcher"
		"gun_missile_launcher":
			return gun_kind == "missile_launcher"
		"gun_web":
			return gun_kind in ["web", "web_gun", "web_tether"]
	return false


func _terminal_weapon_family_label(part: Dictionary, zh: bool) -> String:
	if _component_is_blade_weapon(part):
		match _blade_weapon_family_for_part(part):
			"scythe":
				return "镰刀" if zh else "Scythe"
			"katana":
				return "武士刀" if zh else "Katana"
			"greatsword":
				return "巨剑" if zh else "Greatsword"
		return "斩击" if zh else "Blade"
	if _component_is_blunt_weapon(part):
		match _blunt_weapon_family_for_part(part):
			"gauntlet":
				return "拳套" if zh else "Gauntlet"
			"shield":
				return "盾牌" if zh else "Shield"
			"hammer":
				return "锤" if zh else "Hammer"
		return "钝击" if zh else "Blunt"
	if _component_is_pierce_weapon(part):
		match _pierce_weapon_family_for_part(part):
			"lance":
				return "长枪" if zh else "Lance"
			"rapier":
				return "细剑" if zh else "Rapier"
			"drill":
				return "钻头" if zh else "Drill"
		return "戳刺" if zh else "Pierce"
	return "近战" if zh else "Melee"


func _gun_family_label(part: Dictionary, zh: bool) -> String:
	match _gun_family_for_part(part):
