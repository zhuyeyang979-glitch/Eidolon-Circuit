func _module_joint_fit_label(target_kind: String, zh: bool) -> String:
	var key := target_kind.to_lower()
	if key.find("hybrid") >= 0 or key.find("gauntlet") >= 0:
		return "旋转+伸缩混合" if zh else "hybrid joint"
	if key.find("telescopic") >= 0 or key.find("linear") >= 0 or key.find("pierce") >= 0:
		return "线性伸缩关节" if zh else "linear joint"
	if key.find("two_link") >= 0:
		return "双段旋转肢体" if zh else "two-link joint"
	if key.find("gun") >= 0:
		return "枪械安装末端" if zh else "gun mount"
	if key.find("ball") >= 0 or key.find("blade") >= 0 or key.find("shield") >= 0 or key.find("hammer") >= 0:
		return "球形旋转关节" if zh else "ball joint"
	if key.find("chain") >= 0:
		return "链式旋转关节" if zh else "chain joint"
	return "模块指定关节" if zh else "module joint"


func _module_joint_fit_icon(target_kind: String) -> String:
	var key := target_kind.to_lower()
	if key.find("hybrid") >= 0 or key.find("gauntlet") >= 0:
		return "joint_hybrid"
	if key.find("telescopic") >= 0 or key.find("linear") >= 0 or key.find("pierce") >= 0:
		return "joint_linear"
	if key.find("gun") >= 0:
		return "weapon_gun"
	return "joint_ball"


func _module_weapon_fit_label(part: Dictionary, profile: String, command_profile: String, target_kind: String, zh: bool) -> String:
	if _gun_activation_profiles().has(profile):
		match profile:
			"laser_beam_activate":
				return "激光枪" if zh else "laser gun"
			"missile_lock_activate":
				return "导弹架" if zh else "missile pod"
			"web_tether_activate":
				return "蛛丝枪" if zh else "web gun"
			"rifle_burst_activate":
				return "来复枪" if zh else "rifle"
			"gun_activate":
				return "全部枪械" if zh else "all firearms"
			_:
				return "标准枪械" if zh else "standard gun"
	var key := ("%s %s %s %s" % [profile, command_profile, target_kind, String(part.get("motion", ""))]).to_lower()
	if key.find("shield") >= 0:
		return "盾牌" if zh else "shield"
	if key.find("hammer") >= 0 or key.find("maul") >= 0:
		return "大锤" if zh else "hammer"
	if key.find("gauntlet") >= 0:
		return "拳套" if zh else "gauntlet"
	if key.find("blade") >= 0 or key.find("katana") >= 0 or key.find("scythe") >= 0 or key.find("greatsword") >= 0 or key.find("slash") >= 0:
		return "刃系武器" if zh else "blade"
	if key.find("pierce") >= 0 or key.find("lance") >= 0 or key.find("thrust") >= 0:
		return "突刺武器" if zh else "pierce"
	return _damage_name(String(part.get("damage_type", "blunt"))) if zh else String(part.get("damage_type", "melee")).capitalize()


func _module_weapon_fit_icon(part: Dictionary, profile: String, command_profile: String, target_kind: String) -> String:
	if _gun_activation_profiles().has(profile):
		return "weapon_gun"
	var key := ("%s %s %s %s" % [profile, command_profile, target_kind, String(part.get("motion", ""))]).to_lower()
	if key.find("shield") >= 0:
		return "weapon_shield"
	if key.find("hammer") >= 0 or key.find("maul") >= 0:
		return "weapon_hammer"
	if key.find("blade") >= 0 or key.find("katana") >= 0 or key.find("scythe") >= 0 or key.find("greatsword") >= 0 or key.find("slash") >= 0:
		return "weapon_blade"
	if key.find("pierce") >= 0 or key.find("lance") >= 0 or key.find("thrust") >= 0:
		return "range"
	return "weapon_blunt"


