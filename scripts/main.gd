func _team_accent_color(player_id: int) -> Color:
	var preset := _team_color_preset(player_id)
	var color_value: Variant = preset.get("accent", Color(1.0, 0.88, 0.24, 1.0))
	return color_value if color_value is Color else Color(1.0, 0.88, 0.24, 1.0)


func _team_color_name(player_id: int) -> String:
