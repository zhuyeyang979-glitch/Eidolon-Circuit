func _localized_component_summary(part: Dictionary, slot_key: String) -> String:
	var raw := String(part.get("summary", ""))
	if not _ui_is_zh():
		return _combat_model_text(raw.replace("236X", "front+X").replace("214X", "rear+X"))
	var name := _part_display_name(part)
	var maker := _zh_part_name(String(part.get("maker", "")))
	var tags: Array = []
	if maker != "":
		tags.append("厂商 %s" % maker)
	if bool(part.get("is_torso", false)):
		tags.append("核心/插槽")
	if slot_key == "joint":
		tags.append("关节构件")
	elif slot_key == "limb_muscle":
		tags.append("连接件")
	elif slot_key == "muscle" and bool(part.get("terminal_weapon", false)):
		tags.append("末端武器")
	elif bool(part.get("projectile", false)):
		tags.append("投射武器")
	elif slot_key in ["engine", "cooling", "booster"]:
		tags.append("软硬件")
	if bool(part.get("electronic_armor", false)) or bool(part.get("shield_payload", false)):
		tags.append("电子护盾")
	if bool(part.get("barrier_tile_component", false)) or bool(part.get("barrier_panel", false)):
		tags.append("功能模块")
	var headline := "%s：%s" % [_slot_name(slot_key), name]
	if not tags.is_empty():
		headline = "%s（%s）" % [headline, " / ".join(tags)]
	if raw == "":
		return headline
	return "%s\n%s" % [headline, _localized_system_text(raw)]


func _body_part_label(part_key: String, unit_bp: Dictionary = {}) -> String:
	var archetype := String(unit_bp.get("archetype", "crab"))
	if ARCHETYPE_PART_NAMES.has(archetype):
		var names: Dictionary = ARCHETYPE_PART_NAMES[archetype]
		return String(names.get(part_key, BODY_PART_NAMES.get(part_key, part_key.to_upper())))
	return String(BODY_PART_NAMES.get(part_key, part_key.to_upper()))


