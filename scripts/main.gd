func _merge_attitude_control_stats(stats: Dictionary, part: Dictionary, scale: float = 1.0) -> void:
	if not _component_is_torso(part):
		return
	var control := _torso_attitude_control_value(part)
	stats["attitude_control"] = maxf(float(stats.get("attitude_control", 0.85)), control * clampf(scale, 0.28, 1.0))
	var stability_core := _torso_melee_stability_core_value(part)
	stats["melee_stability_core"] = maxf(float(stats.get("melee_stability_core", 0.85)), stability_core * clampf(scale, 0.28, 1.0))


func _torso_attitude_control_value(part: Dictionary) -> float:
	if part.has("attitude_control"):
		return clampf(float(part["attitude_control"]), 0.25, 3.2)
	var name := String(part.get("name", "")).to_lower()
	var maker := String(part.get("maker", "")).to_upper()
	var shape := String(part.get("shape", "")).to_lower()
	var archetype := String(part.get("archetype", shape)).to_lower()
	var subpart := String(part.get("torso_subpart", "")).to_lower()
	var size_class := String(part.get("size_class", "")).to_lower()
	var key := "%s %s %s %s" % [name, shape, archetype, subpart]
	var control := 0.92
	if key.contains("head") or key.contains("brain") or key.contains("control"):
		control = 1.72
	if archetype == "humanoid" or key.contains("humanova") or key.contains("humanoid"):
		control += 0.34
	if maker == "HUMANOVA ATELIER":
		control += 0.22
	if maker == "CIPHER WARD":
		control += 0.18
	if maker == "RECOIL LATTICE":
		control += 0.16
	if archetype in ["hound", "bird", "octopus", "lizard"]:
		control += 0.12
	if archetype == "crab" or bool(part.get("carapace_style", false)):
		control += 0.28
	elif archetype in ["roach", "shrimp"]:
		control += 0.14
	if archetype in ["tank"]:
		control -= 0.04
	if archetype in ["bull", "dino"]:
		control -= 0.16
	if size_class in ["monster", "kaiju", "leviathan"] or key.contains("monster") or key.contains("leviathan"):
		control -= 0.32
	if key.contains("drone") or key.contains("bit"):
		control -= 0.1
	if part.has("data_security"):
		control += clampf(float(part["data_security"]) - 1.0, -0.35, 0.75) * 0.28
	return clampf(control, 0.35, 2.65)


func _torso_melee_stability_core_value(part: Dictionary) -> float:
	if part.has("melee_stability_core"):
		return clampf(float(part["melee_stability_core"]), 0.25, 3.6)
	var name := String(part.get("name", "")).to_lower()
	var maker := String(part.get("maker", "")).to_upper()
	var shape := String(part.get("shape", "")).to_lower()
	var archetype := String(part.get("archetype", shape)).to_lower()
	var subpart := String(part.get("torso_subpart", "")).to_lower()
	var size_class := String(part.get("size_class", "")).to_lower()
	var key := "%s %s %s %s" % [name, shape, archetype, subpart]
	var core := _torso_attitude_control_value(part)
	if key.contains("head") or key.contains("brain") or key.contains("control"):
		core += 0.38
	if bool(part.get("carapace_style", false)) or archetype in ["crab", "roach", "shrimp"]:
		core += 0.28
	if archetype in ["tank", "bull", "dino"]:
		core += 0.12
	if archetype in ["snake", "centipede"]:
		core -= 0.18
	if maker in ["HUMANOVA ATELIER", "CIPHER WARD"]:
		core += 0.14
	if size_class in ["monster", "kaiju", "leviathan"]:
		core -= 0.06
	return clampf(core, 0.32, 3.2)


func _apply_recoil_stabilization(stats: Dictionary) -> void:
	var mass := maxf(1.0, float(stats.get("mass", 1.0)))
	var radius := maxf(0.04, float(stats.get("radius", 0.08)))
	var control := clampf(float(stats.get("attitude_control", 0.85)), 0.25, 3.2)
	var melee_stability_core := clampf(float(stats.get("melee_stability_core", control)), 0.25, 3.6)
	var thruster_executor := sqrt(maxf(0.0, float(stats.get("boost_total_momentum", 0.0)) * 0.012 + float(stats.get("move_momentum", 0.0)) * 0.018))
	var engine_motion := clampf(float(stats.get("engine_momentum_output", stats.get("engine_momentum_budget", 0.0))) / maxf(1.0, float(stats.get("engine_momentum_required", 1.0))), 0.72, 1.22)
	var inertia_drag := 1.0 + sqrt(mass) * 0.052 + radius * 0.16
	var engine_recoil := clampf(float(stats.get("engine_recoil_stability", 1.0)), 0.72, 1.45)
	var stabilization := (control * (0.72 + thruster_executor * 0.24) * engine_motion * engine_recoil) / inertia_drag
	stabilization = clampf(stabilization, 0.24, 2.4)
	var stability_threshold := MELEE_STABILITY_THRESHOLD_FLOOR + sqrt(mass) * melee_stability_core * 9.2 + mass * 0.26 + radius * 8.4 + thruster_executor * 3.4
	stability_threshold *= clampf(0.86 + engine_motion * 0.24, 0.82, 1.22)
	stats["melee_stability_threshold"] = clampf(stability_threshold, MELEE_STABILITY_THRESHOLD_FLOOR, 520.0)
	var auto_cancel := clampf(0.08 + stabilization * 0.22 + thruster_executor * 0.035 + (engine_recoil - 1.0) * 0.08, 0.05, 0.82)
	stats["recoil_stabilization"] = stabilization
	stats["recoil_cancel"] = maxf(float(stats.get("recoil_cancel", 0.0)), auto_cancel)
	stats["knockback_resist"] = clampf(0.05 + stabilization * 0.18 + thruster_executor * 0.025, 0.04, 0.58)
	stats["recovery_response"] = clampf(0.55 + stabilization * 0.34 + control * 0.08, 0.48, 1.65)
	stats["attitude_control_note"] = "ATT %.2f  STAB %.2f  M-STAB %.0f  KB %.2f  REC %.2f" % [
		control,
		stabilization,
		float(stats["melee_stability_threshold"]),
		float(stats["knockback_resist"]),
		float(stats["recovery_response"]),
	]


func _merge_internal_payload_stats(stats: Dictionary, part: Dictionary, slot_key: String, payload: Dictionary = {}) -> void:
	if slot_key == "cooling":
		part = _cooling_with_v3_defaults(part)
	var merge_context: Dictionary = {}
	if slot_key == "cooling":
		merge_context["cooling_heat_capacity"] = _cooling_heat_capacity_for_part(part)
	var merge_intent: Dictionary = _unit_stats_service().apply_internal_payload_merge_plan(stats, part, slot_key, merge_context)
	if bool(merge_intent.get("apply_engine_stats", false)):
		_merge_engine_stats(stats, part)
	elif bool(merge_intent.get("apply_cooling_profile_stats", false)):
		_unit_stats_service().apply_internal_cooling_payload_stats(stats, part, {
			"cooling_rate": _cooling_rate_for_part(part),
			"cooling_dissipation": _cooling_dissipation_for_part(part),
		})
	elif bool(merge_intent.get("apply_thruster_drive_stats", false)):
		_merge_thruster_drive_stats(stats, part, payload)


func _thermal_load_pool_for_stats(stats: Dictionary) -> float:
	var pool := maxf(0.0, float(stats.get("cooling_heat_capacity", 0.0)))
	if pool <= 0.0:
		pool = maxf(0.0, float(stats.get("heat_capacity", 0.0)))
	if pool <= 0.0:
		pool = maxf(0.0, float(stats.get("thermal_load_pool", 0.0)))
	if pool <= 0.0:
		pool = maxf(0.0, float(stats.get("cooling_pool", 0.0)))
	if pool <= 0.0:
		pool = maxf(0.0, float(stats.get("cooling", 0.0)))
	return pool


func _thermal_runtime_cooling_rate_for_stats(stats: Dictionary) -> float:
	var rate := maxf(0.0, float(stats.get("cooling_rate", stats.get("cooling", 0.0))))
	rate = maxf(rate, float(stats.get("cooling", 0.0)))
	rate = maxf(rate, float(stats.get("heat_dissipation", 0.0)))
	rate = maxf(rate, float(stats.get("thermal_dissipation_rate", 0.0)))
	rate = maxf(rate, float(stats.get("runtime_cooling_rate", 0.0)))
	return rate


func _apply_engine_momentum_budget_with_runtime_modifiers(stats: Dictionary, role_key: String, include_attack_load: bool, apply_penalty: bool = false) -> void:
	_apply_engine_momentum_budget(stats, role_key)
	var required := maxf(0.0, float(stats.get("engine_momentum_required", 0.0)))
	var engine_power := maxf(0.0, float(stats.get("engine_momentum_output", stats.get("engine_momentum_budget", 0.0))))
	if role_key == "barrier" and engine_power <= 0.0:
		stats["power_ratio"] = 1.0
		stats["usable_power"] = 1.0
		stats["power_note"] = ""
		return
	var ratio := engine_power / maxf(1.0, required)
	stats["power_ratio"] = ratio
	stats["usable_power"] = maxf(1.0, engine_power)
	stats["power_note"] = ""
	var family_weight := float(stats.get("engine_family_primary_power", 0.0))
	if family_weight > 0.0:
		for key in ["engine_recoil_stability", "engine_boost_control", "engine_command_drive", "engine_supply_load"]:
			var weight := float(stats.get("%s_weight" % key, 0.0))
			if weight > 0.0:
				stats[key] = clampf(float(stats.get("%s_sum" % key, 0.0)) / weight, 0.45, 1.75)
	stats["recoil_stabilization"] = float(stats.get("recoil_stabilization", 0.65)) * clampf(float(stats.get("engine_recoil_stability", 1.0)), 0.72, 1.45)
	stats["recoil_cancel"] = maxf(float(stats.get("recoil_cancel", 0.0)), 0.24 * clampf(float(stats.get("engine_recoil_stability", 1.0)), 0.72, 1.45))
	stats["cornering"] = float(stats.get("cornering", 1.0)) * clampf(float(stats.get("engine_boost_control", 1.0)), 0.72, 1.32)
	stats["turn_acceleration"] = float(stats.get("turn_acceleration", 4.2)) * clampf(float(stats.get("engine_boost_control", 1.0)), 0.72, 1.32)
	stats["support_power_capacity"] = maxf(float(stats.get("support_power_capacity", 0.0)), engine_power * clampf(float(stats.get("engine_supply_load", 1.0)), 0.65, 1.55))
	if apply_penalty and ratio < 1.0:
		var penalty := clampf(sqrt(maxf(0.16, ratio)), 0.42, 1.0)
		stats["speed"] = float(stats.get("speed", 0.0)) * penalty
		stats["acceleration"] = float(stats.get("acceleration", 0.0)) * penalty


func _apply_thermal_budget(stats: Dictionary, role_key: String) -> void:
	var engine_idle := maxf(0.0, float(stats.get("engine_idle_heat", 0.0)))
	var booster_idle := maxf(0.0, float(stats.get("booster_idle_heat", 0.0)))
	var limb_idle := maxf(0.0, float(stats.get("bound_limb_idle_heat", 0.0)))
	var idle_load := engine_idle + booster_idle + limb_idle
	var cooling_rate := maxf(0.0, float(stats.get("cooling_rate", stats.get("cooling", 0.0))))
	cooling_rate = maxf(cooling_rate, float(stats.get("cooling", 0.0)))
	var capacity := _thermal_load_pool_for_stats(stats)
	var dissipation := _thermal_runtime_cooling_rate_for_stats(stats)
	stats["engine_idle_heat"] = engine_idle
	stats["booster_idle_heat"] = booster_idle
	stats["bound_limb_idle_heat"] = limb_idle
	stats["idle_heat_load"] = idle_load
	stats["cooling"] = cooling_rate
	stats["cooling_rate"] = cooling_rate
	stats["thermal_load_pool"] = capacity
	stats["cooling_pool"] = capacity
	stats["cooling_heat_capacity"] = capacity
	stats["thermal_pool"] = capacity
	stats["heat_capacity"] = capacity
	stats["heat_dissipation"] = dissipation
	stats["thermal_dissipation_rate"] = dissipation
	stats["runtime_cooling_rate"] = dissipation
	stats["thermal_margin"] = capacity - idle_load
	if idle_load <= 0.0 and capacity <= 0.0 and cooling_rate <= 0.0:
		stats["thermal_note"] = "THERMAL IDLE: no engine/thruster/bound limb heat load."
	elif capacity <= 0.0:
		stats["thermal_note"] = "INVALID: no radiator heat capacity. Install cooling software."
	elif capacity <= idle_load:
		stats["thermal_note"] = "INVALID: heat pool %.1f must exceed engine+thruster+bound limb idle heat %.1f." % [capacity, idle_load]
	else:
		stats["thermal_note"] = "THERMAL OK: heat pool %.1f > idle heat %.1f, cooling speed %.1f, runtime cooling %.1f." % [capacity, idle_load, cooling_rate, dissipation]


func _apply_turn_stats(stats: Dictionary, role_key: String) -> void:
	var mass := maxf(1.0, float(stats.get("mass", 1.0)))
	var radius := maxf(0.04, float(stats.get("radius", 0.12)))
	var turn_inertia := 1.0 + mass * 0.035 + radius * 0.72
	if role_key == "barrier":
		turn_inertia *= 1.35
	var allocated_momentum := maxf(0.0, float(stats.get("thruster_effective_drive_demand", 0.0)))
	var turn_efficiency := clampf(float(stats.get("turn_efficiency", 1.0)), 0.2, 3.0)
	var thruster_velocity := allocated_momentum * turn_efficiency / mass
	var turn_speed := clampf(thruster_velocity * MOMENTUM_TURN_SPEED_MULT, 0.0, 7.2)
	var turn_acceleration := clampf(thruster_velocity * MOMENTUM_TURN_ACCEL_MULT * MOMENTUM_TURN_MOMENTUM_MULT, 0.0, 40.8)
	var turn_damping := clampf(turn_acceleration * 0.58, 0.0, 6.6)
	stats["turn_inertia"] = turn_inertia
	stats["turn_speed"] = turn_speed
	stats["turn_command_rate"] = turn_speed
	stats["turn_acceleration"] = turn_acceleration
	stats["turn_damping"] = turn_damping


func _apply_momentum_stiffness(stats: Dictionary) -> void:
	var segments: Array = stats.get("runtime_topology_segments", [])
	if segments.is_empty():
		stats["max_possible_momentum"] = 0.0
		stats["weakest_group_stiffness"] = maxf(1.0, float(stats.get("stiffness", 0.0)))
		stats["momentum_overload_ratio"] = 1.0
		stats["momentum_note"] = "STIFF OK: no runtime limb path check"
		return
	var mass := maxf(1.0, float(stats.get("mass", 1.0)))
	var boost_speed := _estimated_boost_attack_speed(stats)
	var body_speed := maxf(float(stats.get("speed", 0.0)) * MOMENTUM_MOVE_SPEED_MULT, boost_speed)
	var max_momentum := 0.0
	var weakest_stiffness := 999999.0
	var worst_ratio := 1.0
	var worst_name := "LIMB"
	for raw_segment in segments:
		if not (raw_segment is Dictionary):
			continue
		var segment: Dictionary = raw_segment
		if String(segment.get("part_kind", "")) == "torso" or bool(segment.get("projectile", false)):
			continue
		var coeff := maxf(0.55, _terminal_momentum_multiplier(segment))
		var possible_speed := maxf(0.05, body_speed)
		var required_momentum := mass * possible_speed * sqrt(coeff)
		var group_stiffness := maxf(1.0, float(segment.get("stiffness", stats.get("stiffness", 1.0))))
		max_momentum = maxf(max_momentum, required_momentum)
		weakest_stiffness = minf(weakest_stiffness, group_stiffness)
		var ratio := required_momentum / group_stiffness
		if ratio > worst_ratio:
			worst_ratio = ratio
			worst_name = String(segment.get("name", "LIMB"))
	if weakest_stiffness >= 999998.0:
		weakest_stiffness = maxf(1.0, float(stats.get("stiffness", 0.0)))
	stats["max_possible_momentum"] = max_momentum
	stats["weakest_group_stiffness"] = weakest_stiffness
	stats["momentum_overload_ratio"] = maxf(1.0, worst_ratio)
	if worst_ratio > 0.82:
		stats["momentum_note"] = "STIFF WARN: %s %.0f / path stiffness %.0f, near overload." % [worst_name, max_momentum, weakest_stiffness]
	else:
		stats["momentum_note"] = "STIFF OK: max %.0f / weakest path stiffness %.0f" % [max_momentum, weakest_stiffness]


func _topology_side_node_indices(nodes: Array, edges: Array, start_index: int, blocked_joint_index: int) -> Array:
	var result: Array = []
	if start_index < 0 or start_index >= nodes.size() or start_index == blocked_joint_index:
		return result
	var visited := {}
	var queue: Array = [start_index]
	visited[start_index] = true
	while not queue.is_empty():
		var index := int(queue.pop_front())
		if index < 0 or index >= nodes.size() or index == blocked_joint_index:
			continue
		result.append(index)
		for neighbor_raw in _connected_topology_neighbors(edges, index, nodes.size()):
			var neighbor := int(neighbor_raw)
			if neighbor == blocked_joint_index or visited.has(neighbor):
				continue
			visited[neighbor] = true
			queue.append(neighbor)
	return result


func _topology_component_node_mass(role_key: String, unit_bp: Dictionary, node: Dictionary, part_scale: float) -> float:
	if not _topology_node_is_component(node):
		return 0.0
	var part := _topology_node_part(role_key, node, unit_bp)
	return maxf(0.0, float(part.get("mass", 0.0))) * part_scale


func _topology_side_mass(role_key: String, unit_bp: Dictionary, nodes: Array, node_indices: Array, stats: Dictionary, part_scale: float) -> Dictionary:
	var mass := 0.0
	var has_torso := false
	for node_index_raw in node_indices:
		var node_index := int(node_index_raw)
		if node_index < 0 or node_index >= nodes.size():
			continue
		var node: Dictionary = nodes[node_index]
		if not _topology_node_is_component(node):
			continue
		var part := _topology_node_part(role_key, node, unit_bp)
		mass += _topology_component_node_mass(role_key, unit_bp, node, part_scale)
		if _component_is_torso(part):
			has_torso = true
	if has_torso:
		mass += maxf(0.0, float(stats.get("slot_payload_mass", 0.0)))
	return {"mass": mass, "has_torso": has_torso}


func _topology_joint_actuation_speed_for_mass(role_key: String, unit_bp: Dictionary, nodes: Array, joint_index: int, stats: Dictionary, moved_mass: float) -> float:
	if joint_index < 0 or joint_index >= nodes.size():
		return 0.0
	var joint_node: Dictionary = nodes[joint_index]
	if not _topology_node_is_component(joint_node) or _topology_node_slot(joint_node) != "joint":
		return 0.0
	var joint_part := _topology_node_part(role_key, joint_node, unit_bp)
	var module_parts := _module_parts_for_topology_node(role_key, joint_node, unit_bp)
	if module_parts.is_empty():
		return 0.0
	var best_speed := 0.0
	var driven_mass := maxf(0.45, moved_mass)
	for module_part in module_parts:
		if not (module_part is Dictionary):
			continue
		var module_dict: Dictionary = module_part
		var motion := String(module_dict.get("motion", "")).to_lower()
		var motion_mult := 1.0
		if motion.contains("chain"):
			motion_mult = 1.18
		elif motion in ["pendulum", "swing_aim", "auto_swing", "pincer_clamp"]:
			motion_mult = 1.08
		elif motion.contains("thrust") or motion.contains("direct"):
			motion_mult = 1.12
		var output_momentum := _joint_fixed_output_momentum(joint_part, module_dict)
		if output_momentum <= 0.0:
			output_momentum = _joint_output_power(joint_part, module_dict) * 145.0
		var speed := output_momentum * motion_mult * _state_momentum_mult("active") / driven_mass
		best_speed = maxf(best_speed, clampf(speed, 0.0, 5.4))
	return best_speed


func _topology_side_internal_actuation_speed(role_key: String, unit_bp: Dictionary, nodes: Array, node_indices: Array, stats: Dictionary, side_mass: float) -> float:
	var best_speed := 0.0
	for node_index_raw in node_indices:
		var node_index := int(node_index_raw)
		if node_index < 0 or node_index >= nodes.size():
			continue
		var node: Dictionary = nodes[node_index]
		if _topology_node_is_component(node) and _topology_node_slot(node) == "joint":
			best_speed = maxf(best_speed, _topology_joint_actuation_speed_for_mass(role_key, unit_bp, nodes, node_index, stats, side_mass))
	return best_speed


func _apply_joint_momentum_capacity(stats: Dictionary, role_key: String, unit_bp: Dictionary) -> void:
	stats["worst_joint_momentum"] = 0.0
	stats["weakest_joint_momentum_capacity"] = 0.0
	stats["joint_momentum_overload_ratio"] = 1.0
	stats["joint_momentum_note"] = "EMBEDDED STIFF OK: no free-canvas embedded-joint check."
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	if nodes.is_empty() or edges.is_empty() or not _topology_uses_component_nodes(nodes):
		return
	var part_scale := 0.55
	var body_speed := maxf(float(stats.get("speed", 0.0)) * MOMENTUM_MOVE_SPEED_MULT, _estimated_boost_attack_speed(stats))
	var worst_ratio := 1.0
	var worst_momentum := 0.0
	var worst_capacity := 0.0
	var weakest_capacity := 999999.0
	var worst_label := "JOINT"
	var checked_sides := 0
	for joint_index in range(nodes.size()):
		var joint_node: Dictionary = nodes[joint_index]
		if not _topology_node_is_component(joint_node) or _topology_node_slot(joint_node) == "joint" or _topology_node_is_torso(role_key, joint_node, unit_bp):
			continue
		var joint_slot := _topology_node_slot(joint_node)
		var joint_part := _topology_node_part(role_key, joint_node, unit_bp)
		var profile := _embedded_joint_profile_for_part(joint_part, joint_slot)
		var capacity := float(profile.get("momentum_capacity", 0.0)) * part_scale
		if capacity <= 0.0:
			continue
		var parent_index := -1
		for edge in edges:
			if not _topology_edge_has_node(edge, joint_index):
				continue
			var socket_id := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, joint_index))
			if socket_id == "root_joint":
				parent_index = _topology_edge_other_node(edge, joint_index)
				break
		if parent_index < 0:
			continue
		weakest_capacity = minf(weakest_capacity, capacity)
		var side_indices := _topology_side_node_indices(nodes, edges, joint_index, parent_index)
		if side_indices.is_empty():
			continue
		var side_info := _topology_side_mass(role_key, unit_bp, nodes, side_indices, stats, part_scale)
		var side_mass := maxf(0.01, float(side_info.get("mass", 0.0)))
		var output_momentum := float(profile.get("output_momentum", 0.0))
		var joint_actuation := output_momentum / maxf(0.01, side_mass)
		var side_speed := maxf(0.0, body_speed + joint_actuation)
		var side_momentum := side_mass * side_speed
		checked_sides += 1
		worst_momentum = maxf(worst_momentum, side_momentum)
		var ratio := side_momentum / maxf(0.001, capacity)
		if ratio > worst_ratio:
			worst_ratio = ratio
			worst_label = "%s root_joint %d" % [_short_part_name(String(joint_part.get("name", "MUSCLE"))), checked_sides]
			worst_capacity = capacity
	if checked_sides <= 0:
		stats["joint_momentum_note"] = "EMBEDDED STIFF OK: no connected embedded-joint sides."
		return
	if weakest_capacity >= 999998.0:
		weakest_capacity = 0.0
	stats["worst_joint_momentum"] = worst_momentum
	stats["weakest_joint_momentum_capacity"] = weakest_capacity
	stats["joint_momentum_overload_ratio"] = maxf(1.0, worst_ratio)
	var note_capacity := worst_capacity if worst_capacity > 0.0 else weakest_capacity
	if worst_ratio > 1.08:
		stats["joint_momentum_note"] = "INVALID: %s side momentum %.0f exceeds embedded stiffness %.0f." % [worst_label, worst_momentum, note_capacity]
	elif worst_ratio > 0.82:
		stats["joint_momentum_note"] = "EMBEDDED STIFF WARN: side %.0f / stiffness %.0f, near overload." % [worst_momentum, note_capacity]
	else:
		stats["joint_momentum_note"] = "EMBEDDED STIFF OK: side %.0f / stiffness %.0f" % [worst_momentum, note_capacity]


func _angle_within_joint_slot_profile(local_angle: float, profile: Dictionary) -> bool:
	var center := float(profile.get("center_angle", 0.0))
	var half_width := float(profile.get("half_width", 0.0))
	if half_width <= 0.0:
		var min_angle := float(profile.get("min_angle", center))
		var max_angle := float(profile.get("max_angle", center))
		half_width = maxf(absf(wrapf(max_angle - center, -PI, PI)), absf(wrapf(center - min_angle, -PI, PI)))
	return absf(wrapf(local_angle - center, -PI, PI)) <= half_width + deg_to_rad(1.2)


func _topology_chain_length_and_radius(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, root_index: int) -> Dictionary:
	var length := 0.0
	var radius := 0.0
	var inner_length := 0.0
	for raw_index in _topology_downstream_node_indices(role_key, unit_bp, nodes, edges, root_index):
		var index := int(raw_index)
		if index < 0 or index >= nodes.size():
			continue
		var part := _topology_node_part(role_key, nodes[index], unit_bp)
		var part_length := maxf(0.0, float(part.get("length", 0.0)))
		length += part_length
		if index == root_index:
			inner_length = part_length
		radius = maxf(radius, maxf(0.008, float(part.get("radius", 0.02))))
	return {"length": length, "radius": radius, "inner_length": inner_length}


func _angle_intervals_overlap(center_a: float, half_a: float, center_b: float, half_b: float) -> bool:
	var delta := absf(wrapf(center_b - center_a, -PI, PI))
	return delta <= half_a + half_b


func _sweep_angle_contains(angle: float, center: float, half_width: float) -> bool:
	return absf(wrapf(angle - center, -PI, PI)) <= half_width + deg_to_rad(0.5)


func _sweep_candidate_angles(center: float, half_width: float, pivot: Vector2, other_pivot: Vector2) -> Array:
	var angles: Array = [center, wrapf(center - half_width, -PI, PI), wrapf(center + half_width, -PI, PI)]
	var to_other := other_pivot - pivot
	if to_other.length() > 0.001:
		var other_angle := to_other.angle()
		if _sweep_angle_contains(other_angle, center, half_width):
			angles.append(other_angle)
	return angles


func _sweep_ray_segments(limb: Dictionary, other_pivot: Vector2) -> Array:
	var pivot: Vector2 = limb.get("pivot", Vector2.ZERO) * TOPOLOGY_BOARD_PHYSICAL_UNITS
	var length := maxf(0.0, float(limb.get("length", 0.0)))
	var radius := maxf(0.012, float(limb.get("radius", 0.0)))
	if length <= 0.0:
		return []
	var center := float(limb.get("center", 0.0))
	var half_width := maxf(0.0, float(limb.get("half", 0.0)))
	var inner := minf(length * 0.72, maxf(0.10, radius * 2.2))
	if limb.has("inner_length"):
		inner = clampf(float(limb.get("inner_length", 0.0)), 0.0, length)
	if inner >= length - 0.001:
		return []
	var segments: Array = []
	for raw_angle in _sweep_candidate_angles(center, half_width, pivot, other_pivot):
		var angle := float(raw_angle)
		var dir := Vector2.RIGHT.rotated(angle)
		segments.append({
			"a": pivot + dir * inner,
			"b": pivot + dir * length,
		})
	return segments


func _sweep_sector_contains_point(limb: Dictionary, point: Vector2) -> bool:
	var pivot: Vector2 = limb.get("pivot", Vector2.ZERO) * TOPOLOGY_BOARD_PHYSICAL_UNITS
	var length := maxf(0.0, float(limb.get("length", 0.0)))
	var radius := maxf(0.012, float(limb.get("radius", 0.0)))
	var delta := point - pivot
	var distance := delta.length()
	var inner := maxf(0.10, radius * 2.0)
	if limb.has("inner_length"):
		inner = maxf(inner, clampf(float(limb.get("inner_length", 0.0)), 0.0, length))
	if distance < inner:
		return false
	if distance > length + radius:
		return false
	return _sweep_angle_contains(delta.angle(), float(limb.get("center", 0.0)), maxf(0.0, float(limb.get("half", 0.0))))


func _swept_root_limbs_likely_collide(limb_a: Dictionary, limb_b: Dictionary) -> bool:
	var pivot_a: Vector2 = limb_a.get("pivot", Vector2.ZERO) * TOPOLOGY_BOARD_PHYSICAL_UNITS
	var pivot_b: Vector2 = limb_b.get("pivot", Vector2.ZERO) * TOPOLOGY_BOARD_PHYSICAL_UNITS
	var pivot_gap: float = pivot_a.distance_to(pivot_b)
	var length_a := maxf(0.0, float(limb_a.get("length", 0.0)))
	var length_b := maxf(0.0, float(limb_b.get("length", 0.0)))
	var radius_a := maxf(0.012, float(limb_a.get("radius", 0.0)))
	var radius_b := maxf(0.012, float(limb_b.get("radius", 0.0)))
	if length_a <= 0.0 or length_b <= 0.0:
		return false
	var max_reach := length_a + length_b + radius_a + radius_b
	if pivot_gap > max_reach:
		return false
	var combined_radius := radius_a + radius_b + 0.018
	var segments_a := _sweep_ray_segments(limb_a, pivot_b)
	var segments_b := _sweep_ray_segments(limb_b, pivot_a)
	for raw_a in segments_a:
		var seg_a: Dictionary = raw_a
		for raw_b in segments_b:
			var seg_b: Dictionary = raw_b
			var a0: Vector2 = seg_a.get("a", Vector2.ZERO)
			var a1: Vector2 = seg_a.get("b", Vector2.ZERO)
			var b0: Vector2 = seg_b.get("a", Vector2.ZERO)
			var b1: Vector2 = seg_b.get("b", Vector2.ZERO)
			if _segment_segment_distance(a0, a1, b0, b1) <= combined_radius:
				return true
	for raw_a in segments_a:
		var seg_a: Dictionary = raw_a
		if _sweep_sector_contains_point(limb_b, seg_a.get("b", Vector2.ZERO)):
			return true
	for raw_b in segments_b:
		var seg_b: Dictionary = raw_b
		if _sweep_sector_contains_point(limb_a, seg_b.get("b", Vector2.ZERO)):
			return true
	return false


func _apply_joint_slot_motion_limits(stats: Dictionary, role_key: String, unit_bp: Dictionary) -> void:
	stats["joint_slot_profiles"] = []
	stats["joint_slot_count"] = 0
	stats["joint_slot_note"] = "SLOT OK: no torso joint-slot topology."
	stats["swept_collision_note"] = "SWEEP OK: no moving limb sweep."
	stats["swept_collision_count"] = 0
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	if nodes.is_empty() or edges.is_empty():
		return
	var profile_rows: Array = []
	var root_limbs: Array = []
	var invalid_notes: Array = []
	for torso_index in range(nodes.size()):
		if not (nodes[torso_index] is Dictionary) or not _topology_node_is_torso(role_key, nodes[torso_index], unit_bp):
			continue
		var torso_node: Dictionary = nodes[torso_index]
		var torso_part := _topology_node_part(role_key, torso_node, unit_bp)
		var profiles := _torso_joint_slot_profiles_for_part(torso_part)
		var torso_axis := _topology_node_axis(torso_node)
		for raw_profile in profiles:
			if not (raw_profile is Dictionary):
				continue
			var profile: Dictionary = raw_profile
			var port_index := int(profile.get("port_index", profile_rows.size()))
			var socket_id := "torso_port:%d" % port_index
			var row := profile.duplicate(true)
			row["torso_node"] = torso_index
			row["socket"] = socket_id
			row["world_center_angle"] = wrapf(torso_axis.angle() + float(profile.get("center_angle", 0.0)), -PI, PI)
			row["pivot"] = _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, torso_index, socket_id, -1)
			profile_rows.append(row)
			var child_index := -1
			for edge in edges:
				if not _topology_edge_has_node(edge, torso_index):
					continue
				var torso_socket := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, torso_index))
				if torso_socket != socket_id:
					continue
				var other := _topology_edge_other_node(edge, torso_index)
				if other >= 0 and other < nodes.size() and _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, other)) == "root_joint":
					child_index = other
					break
			if child_index < 0:
				continue
			var child_axis := _topology_endpoint_axis_for_node(child_index, nodes, edges)
			var local_angle := wrapf(child_axis.angle() - torso_axis.angle(), -PI, PI)
			if not _angle_within_joint_slot_profile(local_angle, profile):
				invalid_notes.append("port %d angle %.0f outside %.0f..%.0f" % [
					port_index + 1,
					rad_to_deg(local_angle),
					rad_to_deg(float(profile.get("min_angle", 0.0))),
					rad_to_deg(float(profile.get("max_angle", 0.0))),
				])
			var chain_info := _topology_chain_length_and_radius(role_key, unit_bp, nodes, edges, child_index)
			var chain_length := float(chain_info.get("length", 0.0))
			var chain_radius := float(chain_info.get("radius", 0.0))
			var inner_length := float(chain_info.get("inner_length", 0.0))
			if chain_length <= 0.0 or chain_length <= inner_length + 0.001:
				continue
			var pivot := _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, torso_index, socket_id, child_index)
			var center_angle := float(row.get("world_center_angle", 0.0))
			var half_width := float(profile.get("half_width", 0.0))
			root_limbs.append({
				"torso": torso_index,
				"port": port_index,
				"child": child_index,
				"pivot": pivot,
				"center": center_angle,
				"half": half_width,
				"length": chain_length,
				"inner_length": inner_length,
				"radius": chain_radius,
			})
	stats["joint_slot_profiles"] = profile_rows
	stats["joint_slot_count"] = profile_rows.size()
	if invalid_notes.is_empty():
		stats["joint_slot_note"] = "SLOT OK: %d torso joint slots with bounded arcs." % profile_rows.size()
	else:
		stats["joint_slot_note"] = "INVALID: joint slot angle out of range (%s)." % "; ".join(invalid_notes.slice(0, 3))
	var collision_notes: Array = []
	for i in range(root_limbs.size()):
		var limb_a: Dictionary = root_limbs[i]
		for j in range(i + 1, root_limbs.size()):
			var limb_b: Dictionary = root_limbs[j]
			if int(limb_a.get("torso", -1)) == int(limb_b.get("torso", -2)):
				continue
			if _swept_root_limbs_likely_collide(limb_a, limb_b):
				collision_notes.append("torso %d port %d vs torso %d port %d downstream sweeps intersect" % [
					int(limb_a.get("torso", 0)) + 1,
					int(limb_a.get("port", 0)) + 1,
					int(limb_b.get("torso", 0)) + 1,
					int(limb_b.get("port", 0)) + 1,
				])
	stats["swept_collision_count"] = collision_notes.size()
	if collision_notes.is_empty():
		stats["swept_collision_note"] = "SWEEP OK: same-torso limb overlaps ignored; no cross-torso limb sweep collision found."
	else:
		stats["swept_collision_note"] = "INVALID: possible downstream limb sweep collision (%s)." % "; ".join(collision_notes.slice(0, 4))


func _merge_electronic_armor_stats(stats: Dictionary, part: Dictionary, scale: float = 1.0) -> void:
	var shield_hp := float(part.get("shield_hp", part.get("electronic_armor_hp", 0.0)))
	var shield_regen := float(part.get("shield_regen", part.get("electronic_armor_regen", 0.0)))
	var shield_coverage := float(part.get("shield_coverage", part.get("electronic_armor_coverage", 0.0)))
	stats["electronic_armor_max"] = float(stats.get("electronic_armor_max", 0.0)) + shield_hp * scale
	stats["electronic_armor_regen"] = float(stats.get("electronic_armor_regen", 0.0)) + shield_regen * scale
	stats["electronic_armor_coverage"] = maxf(float(stats.get("electronic_armor_coverage", 0.0)), shield_coverage * sqrt(maxf(0.0, scale)))
	stats["shield_max"] = float(stats.get("electronic_armor_max", 0.0))
	stats["shield_regen"] = float(stats.get("electronic_armor_regen", 0.0))
	stats["shield_coverage"] = float(stats.get("electronic_armor_coverage", 0.0))


func _apply_electronic_armor_coverage(stats: Dictionary) -> void:
	var armor_max := float(stats.get("electronic_armor_max", 0.0))
	if armor_max <= 0.0:
		stats["electronic_armor_note"] = ""
		stats["shield_note"] = ""
		return
	var coverage := maxf(0.01, float(stats.get("electronic_armor_coverage", 0.0)))
	var required_size := maxf(float(stats.get("radius", 0.08)), float(stats.get("length", 0.14)) * 0.22)
	var coverage_mult := clampf(coverage / maxf(0.01, required_size), 0.18, 1.0)
	stats["electronic_armor_max"] = armor_max * coverage_mult
	stats["electronic_armor_regen"] = float(stats.get("electronic_armor_regen", 0.0)) * sqrt(coverage_mult)
	stats["shield_max"] = float(stats.get("electronic_armor_max", 0.0))
	stats["shield_regen"] = float(stats.get("electronic_armor_regen", 0.0))
	stats["shield_coverage"] = coverage
	stats["electronic_armor_note"] = "SHIELD %.0f  REGEN %.1f/s  COVER %.2f/%.2f" % [
		float(stats.get("electronic_armor_max", 0.0)),
		float(stats.get("electronic_armor_regen", 0.0)),
		coverage,
		required_size,
	]
	stats["shield_note"] = stats["electronic_armor_note"]


func _apply_torso_slot_payload_stats(stats: Dictionary, role_key: String, unit_bp: Dictionary) -> void:
	var payload_summary := {}
	var component_priced := _unit_uses_component_pricing(unit_bp)
	var torso_payload_context := _unit_stats_torso_payload_context()
	if not component_priced:
		for slot_key in ["engine", "cooling", "booster"]:
			var part := _selected_component(role_key, slot_key, int(unit_bp.get(slot_key, 0)))
			if int(part.get("cost", 0)) <= 0:
				continue
			_unit_stats_service().record_torso_payload_summary_entry(payload_summary, {
				"mass": float(part.get("mass", 0.0)),
				"volume_rank": _part_slot_volume_rank(part, slot_key),
			})
		for slot_key in BUILD_SLOTS:
			var part := _selected_component(role_key, slot_key, int(unit_bp.get(slot_key, 0)))
			if not bool(part.get("torso_slot_payload", false)) or slot_key in ["booster"]:
				continue
			_unit_stats_service().record_torso_payload_summary_entry(payload_summary, {
				"mass": float(part.get("mass", 0.0)),
				"volume_rank": _part_slot_volume_rank(part, slot_key),
				"ammo": bool(part.get("ammo_slot_payload", false)) or String(part.get("material_class", "")) == "ammo_payload",
			})
	if unit_bp.has("slot_payloads"):
		for payload in Array(unit_bp.get("slot_payloads", [])):
			if not (payload is Dictionary):
				continue
			var payload_data: Dictionary = payload
			var payload_kind := String(payload_data.get("kind", ""))
			var fallback_slot := _unit_stats_service().payload_slot_key_for_kind(payload_kind, String(payload_data.get("slot", "muscle")))
			var payload_part := _payload_part_for_payload(role_key, payload_data)
			var payload_plan := _unit_stats_service().torso_payload_processing_plan(payload_kind, payload_part, payload_data, fallback_slot, {
				"volume_rank": _payload_slot_volume_rank(payload_kind, payload_part, payload_data, fallback_slot),
			})
			var payload_intent := _unit_stats_service().apply_torso_payload_plan(stats, payload_summary, payload_plan, payload_part, {
				"role_key": role_key,
				"torso_payload_context": torso_payload_context,
			})
			var internal_slot_key := String(payload_intent.get("internal_slot_key", ""))
			if internal_slot_key != "":
				_merge_internal_payload_stats(stats, payload_part, internal_slot_key, payload_data)
			if bool(payload_intent.get("apply_ether", false)):
				_merge_ether_stats(stats, payload_part)
			elif bool(payload_intent.get("apply_soul_bonus", false)):
				_apply_soul_bonus(stats, unit_bp, payload_part)
	var escape_index := int(unit_bp.get("escape_pod", -1))
	if escape_index >= 0 and not component_priced:
		var pod_part := _selected_component(role_key, "muscle", escape_index)
		if bool(pod_part.get("has_escape_pod", false)):
			_unit_stats_service().record_torso_payload_summary_entry(payload_summary, {
				"mass": float(pod_part.get("mass", 0.0)),
				"volume_rank": _part_slot_volume_rank(pod_part, "muscle"),
			})
			_unit_stats_service().apply_torso_payload_direct_stats(stats, pod_part, "escape_pod", torso_payload_context)
	var internal_slot_status := _torso_internal_slot_status_for_unit(role_key, unit_bp)
	_unit_stats_service().apply_torso_payload_summary(stats, payload_summary, {
		"role_key": role_key,
		"internal_slot_status": internal_slot_status,
		"installed_rank_label": _volume_rank_label(float(internal_slot_status.get("max_installed_rank", 0))),
		"empty_rank_label": _volume_rank_label(float(internal_slot_status.get("max_empty_rank", 0))),
	})


func _part_load_capacity(part: Dictionary, slot_kind: String) -> float:
	return _part_momentum_capacity(part, slot_kind)


func _part_momentum_capacity(part: Dictionary, slot_kind: String) -> float:
	if slot_kind != "joint":
		return 0.0
	if part.has("momentum_capacity"):
		return maxf(0.0, float(part["momentum_capacity"]))
	if part.has("load_capacity"):
		return maxf(0.0, float(part["load_capacity"])) * MOMENTUM_STIFFNESS_UNIT
	return _part_stiffness(part, slot_kind)


func _part_stiffness_kind_multiplier(part: Dictionary, slot_kind: String) -> float:
	if bool(part.get("is_torso", false)) or bool(part.get("torso_slot_payload", false)):
		return 2.0
	if slot_kind == "barrier" or String(part.get("part_kind", "")).to_lower() == "barrier_tile":
		return 1.0
	if _part_counts_as_terminal_weapon(part, slot_kind):
		return 0.8 if _terminal_weapon_kind_for_part(part, slot_kind) == "ranged" else 2.0
	return 1.0


func _part_stiffness(part: Dictionary, slot_kind: String) -> float:
	if part.has("stiffness_momentum"):
		return maxf(0.0, float(part["stiffness_momentum"]))
	if slot_kind == "joint":
		if part.has("momentum_capacity"):
			return maxf(0.0, float(part["momentum_capacity"]))
		if part.has("load_capacity"):
			return maxf(0.0, float(part["load_capacity"])) * MOMENTUM_STIFFNESS_UNIT
	var value := PART_STIFFNESS_BASE_MOMENTUM
	value *= _part_stiffness_kind_multiplier(part, slot_kind)
	value *= _part_stiffness_size_multiplier(part)
	return maxf(1.0, value)


func _part_path_stiffness(part: Dictionary, slot_kind: String) -> float:
	var part_value := _part_stiffness(part, slot_kind)
	var size_mult := _part_stiffness_size_multiplier(part)
	var torso_value := PART_STIFFNESS_BASE_MOMENTUM * 2.0 * size_mult
	var limb_value := PART_STIFFNESS_BASE_MOMENTUM * size_mult
	if bool(part.get("is_torso", false)) or bool(part.get("torso_slot_payload", false)):
		return part_value
	if slot_kind == "barrier":
		return part_value
	if _part_counts_as_terminal_weapon(part, slot_kind):
		return maxf(1.0, minf(part_value, minf(limb_value, torso_value)))
	return maxf(1.0, minf(part_value, torso_value))


func _part_contact_shape_kind(part: Dictionary, slot_kind: String) -> String:
	if bool(part.get("is_torso", false)) or bool(part.get("torso_slot_payload", false)):
		return "rounded_torso"
	if slot_kind == "barrier" or String(part.get("part_kind", "")).to_lower() == "barrier_tile":
		return "rounded_panel"
	if _part_counts_as_terminal_weapon(part, slot_kind):
		return "rounded_terminal"
	return "rounded_limb"


func _part_damage_coeff(part: Dictionary, slot_kind: String) -> float:
	if part.has("damage_coeff"):
		return maxf(0.0, float(part.get("damage_coeff", 0.0)))
	if bool(part.get("is_torso", false)) or bool(part.get("torso_slot_payload", false)):
		return PART_DAMAGE_COEFF_TORSO
	if slot_kind == "barrier" or String(part.get("part_kind", "")).to_lower() == "barrier_tile":
		return PART_DAMAGE_COEFF_BARRIER
	if _part_counts_as_terminal_weapon(part, slot_kind):
		return PART_DAMAGE_COEFF_TERMINAL_RANGED if _terminal_weapon_kind_for_part(part, slot_kind) == "ranged" else PART_DAMAGE_COEFF_TERMINAL_MELEE
	return PART_DAMAGE_COEFF_LIMB


func _part_break_coeff(part: Dictionary, slot_kind: String) -> float:
	if part.has("break_coeff"):
		return maxf(0.0, float(part.get("break_coeff", 0.0)))
	if bool(part.get("is_torso", false)) or bool(part.get("torso_slot_payload", false)):
		return PART_BREAK_COEFF_TORSO
	if slot_kind == "barrier" or String(part.get("part_kind", "")).to_lower() == "barrier_tile":
		return PART_BREAK_COEFF_BARRIER
	if _part_counts_as_terminal_weapon(part, slot_kind):
		return PART_BREAK_COEFF_TERMINAL_RANGED if _terminal_weapon_kind_for_part(part, slot_kind) == "ranged" else PART_BREAK_COEFF_TERMINAL_MELEE
	return PART_BREAK_COEFF_LIMB


func _component_has_combat_volume(part: Dictionary, slot_kind: String) -> bool:
	if slot_kind in ["special", "code", "ether", "module", "engine", "cooling", "booster", "shield", "ammo", "joint"]:
		return false
	if bool(part.get("software", false)) or bool(part.get("torso_slot_payload", false)) and not bool(part.get("is_torso", false)):
		return false
	if bool(part.get("is_torso", false)) or _component_is_torso(part):
		return true
	if slot_kind in ["muscle", "limb_muscle", "barrier"]:
		return true
	return maxf(float(part.get("length", 0.0)), float(part.get("radius", 0.0))) > 0.0 and float(part.get("hp", 0.0)) > 0.0


func _combat_model_normalized_component(part: Dictionary, slot_kind: String) -> Dictionary:
	if part.is_empty() or not _component_has_combat_volume(part, slot_kind):
		return part
	var normalized := part.duplicate(true)
	if slot_kind == "limb_muscle":
		normalized["connection_ends"] = 2
		normalized["root_socket"] = "root_joint"
		normalized["distal_socket"] = "distal"
	elif slot_kind == "muscle":
		if _component_is_torso(normalized):
			normalized["is_torso"] = true
			if String(normalized.get("material_class", "")).strip_edges() == "":
				normalized["material_class"] = "torso"
		else:
			normalized["root_socket"] = "root_joint"
			var connection_ends := maxi(1, int(normalized.get("connection_ends", 1)))
			normalized["connection_ends"] = connection_ends
			var terminal_like := _part_counts_as_terminal_weapon(normalized, "muscle") or bool(normalized.get("projectile", false)) or connection_ends <= 1
			if terminal_like:
				normalized.erase("distal_socket")
			else:
				normalized["distal_socket"] = "distal"
	if _part_counts_as_terminal_weapon(normalized, slot_kind):
		normalized["terminal_weapon_kind"] = _terminal_weapon_kind_for_part(normalized, slot_kind)
		if _component_is_blade_weapon(normalized):
			normalized["weapon_family"] = _blade_weapon_family_for_part(normalized)
		elif _component_is_blunt_weapon(normalized):
			normalized["weapon_family"] = _blunt_weapon_family_for_part(normalized)
		elif _component_is_pierce_weapon(normalized):
			normalized["weapon_family"] = _pierce_weapon_family_for_part(normalized)
		if not normalized.has("embedded_joint_kind"):
			normalized["embedded_joint_kind"] = _embedded_joint_kind_for_part(normalized, slot_kind)
	normalized["stiffness_momentum"] = _part_stiffness(normalized, slot_kind)
	normalized["path_stiffness_momentum"] = _part_path_stiffness(normalized, slot_kind)
	normalized["damage_coeff"] = _part_damage_coeff(normalized, slot_kind)
	normalized["break_coeff"] = _part_break_coeff(normalized, slot_kind)
	normalized["contact_shape_kind"] = _part_contact_shape_kind(normalized, slot_kind)
	normalized["size_tier"] = _part_size_tier_label(normalized)
	return normalized


func _part_resistance_dict(part: Dictionary) -> Dictionary:
	if part.has("resist") and part["resist"] is Dictionary:
		return Dictionary(part["resist"]).duplicate(true)
	return {}


func _stiffness_segment_material_family_for_part(part: Dictionary, slot_kind: String) -> String:
	var name := String(part.get("name", "")).to_upper()
	var material_class := String(part.get("material_class", "")).to_lower()
	var shape := String(part.get("shape", "")).to_lower()
	var visual := String(part.get("torso_material", part.get("material_visual", ""))).to_lower()
	var joined := "%s %s %s %s" % [name.to_lower(), material_class, shape, visual]
	if joined.contains("ceramic") or joined.contains("stone"):
		return "ceramic"
	if joined.contains("wood") or joined.contains("timber") or joined.contains("stake"):
		return "wood"
	if joined.contains("fur") or joined.contains("padded") or joined.contains("sleeve") or joined.contains("leather") or joined.contains("hide") or joined.contains("pelt"):
		return "fur"
	if joined.contains("chain"):
		return "chain"
	if joined.contains("metal") or joined.contains("steel") or joined.contains("iron") or joined.contains("mono"):
		return "metal"
	if slot_kind in ["joint", "limb_muscle", "muscle"]:
		return "metal"
	return "generic"


func _stiffness_segment_material_strength(family: String) -> float:
	var material_key := family.to_lower()
	if material_key == "" or material_key == "mixed":
		material_key = "generic"
	return float(CONTACT_MATERIAL_STRENGTH.get(material_key, CONTACT_MATERIAL_STRENGTH.get("generic", 10.0)))


func _stiffness_segment_threshold_from_material(family: String, defense_coeff: float = 1.0) -> float:
	var value := _stiffness_segment_material_strength(family) * maxf(0.05, defense_coeff)
	return clampf(value, CONTACT_UNIT_THRESHOLD_MIN, CONTACT_UNIT_THRESHOLD_MAX)


func _stiffness_segment_hp_from_material_volume(family: String, volume_rank: float) -> float:
	var material_key := family.to_lower()
	if material_key == "" or material_key == "mixed":
		material_key = "generic"
	var rank := clampi(int(roundf(volume_rank)), 1, 5)
	var base_hp := float(CONTACT_MATERIAL_HP.get(material_key, CONTACT_MATERIAL_HP.get("generic", 22.0)))
	var mult := float(CONTACT_UNIT_VOLUME_HP_MULT[rank])
	return maxf(CONTACT_UNIT_HP_MIN, base_hp * mult)


func _ordinary_damage_component_hp(part: Dictionary, slot_kind: String) -> float:
	if slot_kind == "joint" or bool(part.get("software_joint", false)) or bool(part.get("joint_is_software", false)):
		return 0.0
	var family := _stiffness_segment_material_family_for_part(part, slot_kind)
	var volume_rank := _part_slot_volume_rank(part, slot_kind)
	return _stiffness_segment_hp_from_material_volume(family, volume_rank)


func _limb_stiffness_segment_hp(joint_part: Dictionary, limb_part: Dictionary) -> float:
	var joint_hp := _ordinary_damage_component_hp(joint_part, "joint")
	var limb_hp := _ordinary_damage_component_hp(limb_part, "limb_muscle")
	var values: Array = []
	if joint_hp > 0.0:
		values.append(joint_hp)
	if limb_hp > 0.0:
		values.append(limb_hp)
	if values.is_empty():
		return CONTACT_UNIT_HP_MIN
	var result := float(values[0])
	for value in values:
		result = minf(result, float(value))
	return maxf(CONTACT_UNIT_HP_MIN, result)


func _terminal_stiffness_segment_hp(part: Dictionary) -> float:
	if part.is_empty():
		return 0.0
	var catalog_hp := maxf(0.0, float(part.get("hp", 0.0)))
	if catalog_hp > 0.0:
		return catalog_hp
	var material_hp := _ordinary_damage_component_hp(part, "muscle")
	return material_hp * _terminal_weapon_defense_threshold_multiplier(part)


func _torso_stiffness_segment_defense_coefficient(part: Dictionary) -> float:
	var coeff := CONTACT_DEFENSE_TORSO_COEFF
	if part.has("stiffness_segment_defense_coeff"):
		coeff *= maxf(0.25, float(part["stiffness_segment_defense_coeff"]))
	return clampf(coeff, 0.5, 2.4)


func _limb_stiffness_segment_defense_coefficient(_joint_part: Dictionary, _limb_part: Dictionary) -> float:
	return CONTACT_DEFENSE_LIMB_COEFF


func _part_damage_threshold(part: Dictionary, slot_kind: String) -> float:
	var family := _stiffness_segment_material_family_for_part(part, slot_kind)
	var coeff := CONTACT_DEFENSE_LIMB_COEFF
	if _component_is_torso(part):
		coeff = _torso_stiffness_segment_defense_coefficient(part)
	elif _part_counts_as_terminal_weapon(part, slot_kind):
		coeff = _terminal_weapon_defense_threshold_multiplier(part)
	return _stiffness_segment_threshold_from_material(family, coeff)


func _terminal_weapon_defense_threshold_multiplier(part: Dictionary) -> float:
	if not _part_counts_as_terminal_weapon(part, "muscle"):
		return 1.0
	var material_class := String(part.get("material_class", "")).to_lower()
	var mult := CONTACT_DEFENSE_TERMINAL_RANGED_COEFF if material_class == "gun" or bool(part.get("projectile_only", false)) else CONTACT_DEFENSE_TERMINAL_MELEE_COEFF
	var damage_type := String(part.get("damage_type", "blunt"))
	if damage_type == "blunt":
		mult += 0.08
	elif damage_type == "pierce":
		mult += 0.04
	var name := String(part.get("name", "")).to_upper()
	var shape := String(part.get("shape", "")).to_lower()
	if name.contains("SHIELD") or name.contains("BUCKLER") or shape.contains("shield") or shape.contains("buckler"):
		mult += CONTACT_DEFENSE_SHIELD_BONUS
	return clampf(mult, 1.25, 2.25)


func _stiffness_segment_families_match(families: Array) -> bool:
	var first := ""
	for family_raw in families:
		var family := String(family_raw)
		if family == "" or family == "generic":
			continue
		if first == "":
			first = family
		elif first != family:
			return false
	return true


func _stiffness_segment_family_label(families: Array) -> String:
	var values: Array = []
	for family_raw in families:
		var family := String(family_raw)
		if family != "" and not values.has(family):
			values.append(family)
	return "/".join(values)


func _annotate_stiffness_segment_fields(group: Dictionary, joint_part: Dictionary, limb_part: Dictionary, muscle_part: Dictionary, terminal_included: bool) -> void:
	var joint_family := "software"
	var limb_family := _stiffness_segment_material_family_for_part(limb_part, "limb_muscle")
	var terminal_family := _stiffness_segment_material_family_for_part(muscle_part, "muscle") if terminal_included else ""
	var limb_families := [limb_family]
	group["joint_material_family"] = joint_family
	group["limb_material_family"] = limb_family
	group["terminal_material_family"] = terminal_family
	group["stiffness_segment_material_family"] = limb_family
	group["stiffness_segment_materials"] = limb_families
	var limb_material_valid := _stiffness_segment_families_match(limb_families)
	var limb_family_for_threshold := limb_family if limb_material_valid else "mixed"
	var limb_material_strength := _stiffness_segment_material_strength(limb_family_for_threshold)
	if not limb_material_valid:
		limb_material_strength = _stiffness_segment_material_strength(limb_family)
	var limb_coeff := _limb_stiffness_segment_defense_coefficient(joint_part, limb_part)
	var limb_threshold := clampf(limb_material_strength * limb_coeff, CONTACT_UNIT_THRESHOLD_MIN, CONTACT_UNIT_THRESHOLD_MAX)
	var joint_unit_hp := _ordinary_damage_component_hp(joint_part, "joint")
	var limb_component_hp := _ordinary_damage_component_hp(limb_part, "limb_muscle")
	var limb_unit_hp := _limb_stiffness_segment_hp(joint_part, limb_part)
	group["stiffness_segment_material_valid"] = limb_material_valid
	group["stiffness_segment_material_strength"] = limb_material_strength
	group["limb_defense_coefficient"] = limb_coeff
	group["joint_defense_threshold"] = limb_material_strength
	group["limb_defense_threshold"] = limb_material_strength
	group["limb_break_threshold"] = limb_threshold
	group["joint_stiffness_segment_hp"] = joint_unit_hp
	group["limb_muscle_stiffness_segment_hp"] = limb_component_hp
	group["limb_stiffness_segment_hp"] = limb_unit_hp
	group["stiffness_segment_hp"] = limb_unit_hp
	if terminal_included:
		var terminal_coeff := _terminal_weapon_defense_threshold_multiplier(muscle_part)
		var terminal_strength := _stiffness_segment_material_strength(terminal_family)
		group["terminal_material_strength"] = terminal_strength
		group["terminal_defense_coefficient"] = terminal_coeff
		group["terminal_defense_threshold"] = _stiffness_segment_threshold_from_material(terminal_family, terminal_coeff)
		group["terminal_stiffness_segment_hp"] = _terminal_stiffness_segment_hp(muscle_part)
	else:
		group["terminal_material_strength"] = 0.0
		group["terminal_defense_coefficient"] = 0.0
		group["terminal_defense_threshold"] = 0.0
		group["terminal_stiffness_segment_hp"] = 0.0
	group["terminal_stiffness_segment_independent"] = terminal_included
	group["joint_resist"] = _part_resistance_dict(joint_part)
	group["limb_resist"] = _part_resistance_dict(limb_part)
	group["terminal_resist"] = _part_resistance_dict(muscle_part) if terminal_included else {}


func _merge_resistance_dict_scaled(base: Dictionary, incoming: Dictionary, scale: float) -> Dictionary:
	var merged := base.duplicate(true)
	for damage_type in DAMAGE_TYPES:
		var old_value := float(merged.get(damage_type, 1.0))
		var part_value := float(incoming.get(damage_type, 1.0))
		merged[damage_type] = old_value * lerpf(1.0, part_value, clampf(scale, 0.0, 1.0))
	return merged


func _torso_segment_count_for_part(part: Dictionary) -> int:
	if part.has("torso_stiffness_segment_count"):
		return clampi(int(part["torso_stiffness_segment_count"]), 1, 16)
	var name := String(part.get("name", "")).to_lower()
	var shape := String(part.get("shape", "")).to_lower()
	var archetype := String(part.get("archetype", shape)).to_lower()
	var key := "%s %s %s" % [name, shape, archetype]
	if key.contains("snake") or key.contains("centipede") or key.contains("leviathan") or key.contains("vertebra") or key.contains("rail spine"):
		var by_ports := int(ceilf(maxf(2.0, float(part.get("connection_ends", 2))) * 0.5))
		var by_length := int(ceilf(maxf(0.2, float(part.get("length", 0.2))) * 2.4))
		return clampi(maxi(by_ports, by_length), 2, 12)
	return 1


func _topology_node_local_damage_offset(node: Dictionary) -> Vector2:
	if node.is_empty():
		return Vector2.ZERO
	var pos := _topology_node_position(node)
	return (pos - Vector2(0.5, 0.5)) * TOPOLOGY_BOARD_PHYSICAL_UNITS


func _torso_stiffness_segment_hp_from_part(part: Dictionary, segment_count: int) -> float:
	var hp := maxf(CONTACT_UNIT_HP_MIN, float(part.get("hp", CONTACT_UNIT_HP_MIN)))
	if segment_count > 1:
		return maxf(CONTACT_UNIT_HP_MIN * 1.55, hp / float(segment_count))
	return hp


func _append_torso_stiffness_segments(stats: Dictionary, part: Dictionary, slot_kind: String, threshold: float, family: String, scale: float, node: Dictionary = {}) -> void:
	var units: Array = Array(stats.get("torso_stiffness_segments", [])).duplicate(true)
	var segment_count := _torso_segment_count_for_part(part)
	var unit_hp := _torso_stiffness_segment_hp_from_part(part, segment_count)
	var base_length := maxf(0.08, float(part.get("length", 0.18)))
	var base_radius := maxf(0.025, float(part.get("radius", 0.06)))
	var has_node_offset := not node.is_empty()
	var node_offset := _topology_node_local_damage_offset(node)
	var resist := _part_resistance_dict(part)
	for segment_index in range(segment_count):
		var offset := node_offset
		if segment_count > 1:
			var t := 0.5 if segment_count <= 1 else float(segment_index) / float(segment_count - 1)
			offset += Vector2((t - 0.5) * maxf(0.18, base_length * 0.72), 0.0)
		units.append({
			"name": "%s%s" % [String(part.get("name", "TORSO")), " SEG %02d" % (segment_index + 1) if segment_count > 1 else ""],
			"slot_kind": slot_kind,
			"material_family": family,
			"threshold": threshold,
			"unit_hp": unit_hp,
			"catalog_hp": float(part.get("hp", 0.0)),
			"radius": base_radius * (0.72 if segment_count > 1 else 1.0),
			"length": maxf(0.06, base_length / maxf(1.0, float(segment_count)) * (1.35 if segment_count > 1 else 1.0)),
			"local_offset": offset,
			"has_topology_offset": has_node_offset,
			"resist": resist,
			"scale": scale,
		})
	stats["torso_stiffness_segments"] = units
	stats["torso_stiffness_segment_count"] = units.size()
	stats["torso_stiffness_segment_hp"] = maxf(float(stats.get("torso_stiffness_segment_hp", 0.0)), unit_hp)


func _append_torso_connector_stiffness_segment(stats: Dictionary, joint_part: Dictionary, node: Dictionary) -> void:
	return
	var family := _stiffness_segment_material_family_for_part(joint_part, "joint")
	var threshold := _stiffness_segment_threshold_from_material(family, CONTACT_DEFENSE_LIMB_COEFF)
	var unit_hp := _ordinary_damage_component_hp(joint_part, "joint")
	var units: Array = Array(stats.get("torso_stiffness_segments", [])).duplicate(true)
	units.append({
		"name": "%s TORSO LINK" % String(joint_part.get("name", "JOINT")),
		"slot_kind": "joint",
		"unit_kind": "torso_connector_joint",
		"material_family": family,
		"threshold": threshold,
		"unit_hp": unit_hp,
		"catalog_hp": float(joint_part.get("hp", 0.0)),
		"radius": maxf(0.035, float(joint_part.get("radius", 0.04)) * 1.42),
		"length": maxf(0.055, float(joint_part.get("length", 0.08))),
		"local_offset": _topology_node_local_damage_offset(node),
		"has_topology_offset": true,
		"resist": _part_resistance_dict(joint_part),
		"scale": 1.0,
	})
	stats["torso_stiffness_segments"] = units
	stats["torso_stiffness_segment_count"] = units.size()
	stats["torso_stiffness_segment_hp"] = maxf(float(stats.get("torso_stiffness_segment_hp", 0.0)), unit_hp)


func _append_custom_torso_connector_stiffness_segments(stats: Dictionary, role_key: String, unit_bp: Dictionary) -> void:
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	if nodes.is_empty() or not _topology_uses_component_nodes(nodes):
		return
	for i in range(nodes.size()):
		var node: Dictionary = nodes[i]
		if not _topology_node_is_component(node) or _topology_node_slot(node) != "joint":
			continue
		var torso_neighbors := 0
		for neighbor_index_raw in _connected_topology_neighbors(edges, i, nodes.size()):
			var neighbor_index := int(neighbor_index_raw)
			var neighbor: Dictionary = nodes[neighbor_index]
			if not _topology_node_is_component(neighbor):
				continue
			if _topology_slot_family(_topology_node_slot(neighbor)) != "muscle":
				continue
			var neighbor_part := _topology_node_part(role_key, neighbor, unit_bp)
			if _component_is_torso(neighbor_part):
				torso_neighbors += 1
		if torso_neighbors >= 2:
			_append_torso_connector_stiffness_segment(stats, _topology_node_part(role_key, node, unit_bp), node)


func _merge_torso_stiffness_segment_stats(stats: Dictionary, part: Dictionary, slot_kind: String, scale: float = 1.0, node: Dictionary = {}) -> void:
	if not _component_is_torso(part):
		return
	var family := _stiffness_segment_material_family_for_part(part, slot_kind)
	var old_family := String(stats.get("torso_material_family", ""))
	if old_family == "" or old_family == "generic":
		stats["torso_material_family"] = family
	elif family != "" and family != "generic" and old_family != family:
		stats["torso_material_mixed"] = true
	var torso_coeff := _torso_stiffness_segment_defense_coefficient(part)
	var torso_strength := _stiffness_segment_material_strength(family)
	var torso_threshold := _stiffness_segment_threshold_from_material(family, torso_coeff)
	stats["torso_material_strength"] = maxf(float(stats.get("torso_material_strength", 0.0)), torso_strength)
	stats["torso_defense_coefficient"] = maxf(float(stats.get("torso_defense_coefficient", 0.0)), torso_coeff)
	stats["torso_break_threshold"] = maxf(float(stats.get("torso_break_threshold", 0.0)), torso_threshold)
	stats["torso_resist"] = _merge_resistance_dict_scaled(Dictionary(stats.get("torso_resist", {})), _part_resistance_dict(part), scale)
	_append_torso_stiffness_segments(stats, part, slot_kind, torso_threshold, family, scale, node)


func _joint_output_power(joint_part: Dictionary, module_part: Dictionary = {}) -> float:
	if bool(joint_part.get("fixed_corner_joint", false)) or String(joint_part.get("shape", "")).to_lower().contains("corner"):
		return 0.0
	if joint_part.has("joint_power"):
		return maxf(0.0, float(joint_part["joint_power"]))
	var range_value := maxf(0.0, float(joint_part.get("range", 0.0)))
	var cancel_power := maxf(0.0, float(joint_part.get("cancel_power", 0.0)))
	var length := maxf(0.03, float(joint_part.get("length", 0.12)))
	var energy := maxf(0.0, float(joint_part.get("energy", 0.0)))
	var module_drive := maxf(0.0, float(module_part.get("joint_power_bonus", 0.0)))
	var shape := String(joint_part.get("shape", "")).to_lower()
	var motion := String(module_part.get("motion", "")).to_lower()
	var style_bonus := 0.0
	if shape.contains("telescopic") or shape.contains("linear") or motion.contains("thrust"):
		style_bonus += 0.32
	if shape.contains("180") or range_value >= 0.5:
		style_bonus += 0.24
	if motion.contains("chain"):
		style_bonus += 0.18
	var power := 0.72 + cancel_power * 1.45 + range_value * 1.25 + length * 0.22 + energy * 0.035 + module_drive + style_bonus
	power *= sqrt(maxf(0.45, float(joint_part.get("speed_mult", 1.0))))
	return clampf(power, 0.12, 14.0)


func _joint_fixed_output_momentum(joint_part: Dictionary, module_part: Dictionary = {}) -> float:
	if bool(joint_part.get("fixed_corner_joint", false)) or String(joint_part.get("shape", "")).to_lower().contains("corner"):
		return 0.0
	var base := 0.0
	if joint_part.has("fixed_output_momentum"):
		base = maxf(0.0, float(joint_part["fixed_output_momentum"]))
	else:
		base = _joint_default_fixed_output_momentum(joint_part, _part_momentum_capacity(joint_part, "joint"))
	var module_bonus := 1.0
	if not module_part.is_empty():
		module_bonus += maxf(0.0, float(module_part.get("joint_output_mult", 0.0)))
		module_bonus += maxf(0.0, float(module_part.get("joint_power_bonus", 0.0))) * 0.05
	return maxf(0.0, base * module_bonus)


func _embedded_joint_kind_for_part(part: Dictionary, slot_key: String) -> String:
	if part.has("embedded_joint_kind"):
		return String(part["embedded_joint_kind"])
	if bool(part.get("hybrid_embedded_joint", false)):
		return "hybrid"
	if slot_key == "limb_muscle":
		if String(part.get("shape", "")).to_lower().contains("telescopic"):
			return "linear"
		return "ball"
	if slot_key == "muscle":
		if _component_is_torso(part):
			return "port"
		var damage_type := String(part.get("damage_type", part.get("projectile_damage_type", ""))).to_lower()
		var material_class := String(part.get("material_class", "")).to_lower()
		if damage_type in ["pierce", "blunt"] and not bool(part.get("projectile", false)) and material_class != "gun":
			return "linear"
		return "ball"
	return "ball"


func _embedded_joint_profile_for_part(part: Dictionary, slot_key: String, module_part: Dictionary = {}) -> Dictionary:
	var kind := _embedded_joint_kind_for_part(part, slot_key)
	var capacity := _part_momentum_capacity(part, slot_key)
	if capacity <= 0.0:
		capacity = maxf(18.0, _part_stiffness(part, slot_key) * MOMENTUM_STIFFNESS_UNIT)
	var output := 0.0
	if part.has("embedded_joint_output_momentum"):
		output = maxf(0.0, float(part["embedded_joint_output_momentum"]))
	elif part.has("fixed_output_momentum"):
		output = maxf(0.0, float(part["fixed_output_momentum"]))
	else:
		var mass := maxf(0.5, float(part.get("mass", 1.0)))
		var length := maxf(0.06, float(part.get("length", 0.12)))
		var power_load := maxf(0.0, float(part.get("energy", part.get("power_load", 0.0))))
		var damage := maxf(float(part.get("normal_damage", 0.0)), float(part.get("projectile_damage", 0.0)))
		var speed_mult := maxf(0.25, float(part.get("speed_mult", 1.0)))
		output = (mass * 18.0 + length * 84.0 + power_load * 9.0 + damage * 5.5) * speed_mult
		if slot_key == "muscle" and _part_counts_as_terminal_weapon(part, "muscle"):
			output *= 1.18
	output = maxf(18.0 if kind != "port" else 0.0, output)
	var module_mult := 1.0
	if not module_part.is_empty():
		module_mult += maxf(0.0, float(module_part.get("joint_output_mult", 0.0)))
		module_mult += maxf(0.0, float(module_part.get("joint_power_bonus", 0.0))) * 0.05
	var angle := 0.0
	if part.has("embedded_joint_angle"):
		angle = float(part["embedded_joint_angle"])
	elif kind in ["ball", "hybrid"]:
		angle = float(module_part.get("swing_arc_degrees", part.get("joint_degrees", 180.0)))
	var extension := 0.0
	if part.has("embedded_joint_extension"):
		extension = float(part["embedded_joint_extension"])
	elif kind in ["linear", "hybrid"]:
		extension = maxf(float(module_part.get("module_extension_m", module_part.get("required_extension_m", 0.0))), maxf(0.35, float(part.get("length", 0.0)) * 1.8))
	return {
		"kind": kind,
		"angle": angle,
		"extension": extension,
		"output_momentum": output * module_mult,
		"momentum_capacity": maxf(capacity, output * module_mult * 1.12),
		"power": maxf(0.0, output * module_mult / 145.0),
	}


func _joint_drive_kind_for_part(part: Dictionary, slot_key: String) -> String:
	if part.has("joint_drive_kind"):
		return String(part["joint_drive_kind"])
	var embedded := _embedded_joint_kind_for_part(part, slot_key)
	match embedded:
		"linear":
			return "extension"
		"hybrid":
			return "hybrid"
		"port":
			return "rigid"
		_:
			return "rotation"


func _limb_family_for_part(part: Dictionary, slot_key: String) -> String:
	if part.has("limb_family"):
		return String(part["limb_family"])
	var length := maxf(0.0, float(part.get("length", 0.0)))
	var mass := maxf(0.0, float(part.get("mass", 0.0)))
	var drive_kind := _joint_drive_kind_for_part(part, slot_key)
	if drive_kind == "hybrid":
		return "hybrid_extend_swing"
	if drive_kind == "extension":
		return "telescopic"
	var material_class := String(part.get("material_class", "")).to_lower()
	var shape := String(part.get("shape", "")).to_lower()
	if material_class.contains("fur") or material_class.contains("tendon") or shape.contains("chain") or shape.contains("flex") or shape.contains("tendon"):
		return "flexible_chain"
	if mass >= 14.0 or _part_stiffness(part, slot_key) >= PART_STIFFNESS_BASE_MOMENTUM * 2.2:
		return "heavy_rigid"
	if length <= 0.52 and mass <= 6.0:
		return "short_fast"
	if length >= 0.72:
		return "long_reach"
	return "standard"


func _limb_motion_distance_for_part(part: Dictionary, slot_key: String, module_part: Dictionary = {}) -> float:
	var drive_kind := _joint_drive_kind_for_part(part, slot_key)
	var length := maxf(0.05, float(part.get("length", 0.2)))
	if drive_kind == "extension":
		return maxf(0.18, float(_embedded_joint_profile_for_part(part, slot_key, module_part).get("extension", length)))
	if drive_kind == "hybrid":
		var extension := maxf(0.0, float(_embedded_joint_profile_for_part(part, slot_key, module_part).get("extension", 0.0)))
		var angle := maxf(90.0, float(module_part.get("swing_arc_degrees", part.get("embedded_joint_angle", 150.0))))
		return maxf(0.18, extension + length * deg_to_rad(angle) * 0.72)
	var angle_degrees := maxf(90.0, float(module_part.get("swing_arc_degrees", part.get("embedded_joint_angle", 180.0))))
	return maxf(0.18, length * deg_to_rad(angle_degrees))


func _limb_motion_duration_band_for_part(part: Dictionary, slot_key: String) -> Dictionary:
	var family := _limb_family_for_part(part, slot_key)
	var fastest := 0.38
	var nominal := 0.72
	var slow := 1.35
	match family:
		"short_fast":
			fastest = 0.30
			nominal = 0.54
			slow = 1.05
		"standard":
			fastest = 0.40
			nominal = 0.74
			slow = 1.38
		"long_reach":
			fastest = 0.48
			nominal = 0.88
			slow = 1.62
		"flexible_chain":
			fastest = 0.46
			nominal = 0.92
			slow = 1.85
		"telescopic":
			fastest = 0.38
			nominal = 0.72
			slow = 1.32
		"hybrid_extend_swing":
			fastest = 0.52
			nominal = 0.96
			slow = 1.82
		"heavy_rigid":
			fastest = 0.62
			nominal = 1.08
			slow = 2.05
	var mass := maxf(0.0, float(part.get("mass", 0.0)))
	var rank := _component_size_rank(part)
	if rank >= 5 or mass >= 120.0:
		fastest = maxf(fastest, 1.10)
		nominal = maxf(nominal, 2.20)
		slow = maxf(slow, 4.60)
	elif rank >= 4 or mass >= 70.0:
		fastest = maxf(fastest, 0.82)
		nominal = maxf(nominal, 1.55)
		slow = maxf(slow, 3.00)
	return {"fastest": fastest, "nominal": nominal, "slow": slow}


func _limb_momentum_for_duration(part: Dictionary, slot_key: String, duration: float, module_part: Dictionary = {}) -> float:
	var safe_duration := maxf(0.12, duration)
	var mass := maxf(0.45, float(part.get("mass", 1.0)))
	var distance := _limb_motion_distance_for_part(part, slot_key, module_part)
	return maxf(0.0, mass * distance / safe_duration)


func _limb_nominal_momentum_for_part(part: Dictionary, slot_key: String, module_part: Dictionary = {}) -> float:
	var band := _limb_motion_duration_band_for_part(part, slot_key)
	return _limb_momentum_for_duration(part, slot_key, float(band.get("nominal", 0.72)), module_part)


func _limb_joint_speed_cap_for_part(part: Dictionary, slot_key: String) -> float:
	var band := _limb_motion_duration_band_for_part(part, slot_key)
	var distance := _limb_motion_distance_for_part(part, slot_key)
	return clampf(distance / maxf(0.12, float(band.get("fastest", 0.38))), 0.28, 12.0)


func _joint_output_momentum_base_for_part(part: Dictionary, slot_key: String, module_part: Dictionary = {}) -> float:
	var output := 0.0
	if part.has("joint_output_momentum_base"):
		output = maxf(0.0, float(part["joint_output_momentum_base"]))
	else:
		output = maxf(0.0, float(_embedded_joint_profile_for_part(part, slot_key, module_part).get("output_momentum", 0.0)))
	if slot_key in ["limb_muscle", "muscle"] and not _component_is_torso(part) and not bool(part.get("projectile", false)):
		var max_momentum := _limb_momentum_raw_max_for_part(part, slot_key)
		if max_momentum > 0.0:
			output = minf(output, max_momentum)
	return output


func _joint_engine_demand_for_part(part: Dictionary, slot_key: String, module_part: Dictionary = {}) -> float:
	if part.has("joint_engine_demand"):
		return maxf(0.0, float(part["joint_engine_demand"]))
	var drive_kind := _joint_drive_kind_for_part(part, slot_key)
	if drive_kind == "rigid":
		return 0.0
	var family := _limb_family_for_part(part, slot_key)
	var family_mult := 1.0
	match family:
		"short_fast":
			family_mult = 0.96
		"long_reach":
			family_mult = 1.08
		"heavy_rigid":
			family_mult = 1.12
		"telescopic":
			family_mult = 1.04
		"hybrid_extend_swing":
			family_mult = 1.16
		"flexible_chain":
			family_mult = 0.86
	var module_mult := clampf(float(module_part.get("engine_demand_mult", 1.0)), 0.35, 2.2)
	var gun_drive_mult := _gun_drive_demand_multiplier(part, slot_key)
	return maxf(0.0, _limb_nominal_momentum_for_part(part, slot_key, module_part) * family_mult * module_mult * gun_drive_mult)


func _gun_drive_demand_multiplier(part: Dictionary, slot_key: String) -> float:
	if not _component_is_gun_muscle(part, slot_key):
		return 1.0
	return 1.0


func _limb_drive_heat_coeff_for_part(part: Dictionary, slot_key: String, module_part: Dictionary = {}) -> float:
	if module_part.has("limb_idle_heat_coeff"):
		return maxf(0.0, float(module_part.get("limb_idle_heat_coeff", DEFAULT_LIMB_DRIVE_IDLE_HEAT_COEFF)))
	if module_part.has("drive_heat_coeff"):
		return maxf(0.0, float(module_part.get("drive_heat_coeff", DEFAULT_LIMB_DRIVE_IDLE_HEAT_COEFF)))
	if part.has("limb_idle_heat_coeff"):
		return maxf(0.0, float(part.get("limb_idle_heat_coeff", DEFAULT_LIMB_DRIVE_IDLE_HEAT_COEFF)))
	if part.has("drive_heat_coeff"):
		return maxf(0.0, float(part.get("drive_heat_coeff", DEFAULT_LIMB_DRIVE_IDLE_HEAT_COEFF)))
	return DEFAULT_LIMB_DRIVE_IDLE_HEAT_COEFF


func _limb_drive_heat_coeff_for_segment(segment: Dictionary, module_part: Dictionary = {}) -> float:
	if module_part.has("limb_idle_heat_coeff"):
		return maxf(0.0, float(module_part.get("limb_idle_heat_coeff", DEFAULT_LIMB_DRIVE_IDLE_HEAT_COEFF)))
	if module_part.has("drive_heat_coeff"):
		return maxf(0.0, float(module_part.get("drive_heat_coeff", DEFAULT_LIMB_DRIVE_IDLE_HEAT_COEFF)))
	if segment.has("limb_idle_heat_coeff"):
		return maxf(0.0, float(segment.get("limb_idle_heat_coeff", DEFAULT_LIMB_DRIVE_IDLE_HEAT_COEFF)))
	if segment.has("drive_heat_coeff"):
		return maxf(0.0, float(segment.get("drive_heat_coeff", DEFAULT_LIMB_DRIVE_IDLE_HEAT_COEFF)))
	return DEFAULT_LIMB_DRIVE_IDLE_HEAT_COEFF


func _limb_drive_idle_heat_for_allocation(part: Dictionary, slot_key: String, module_part: Dictionary, momentum: float, scale: float = 1.0) -> float:
	return maxf(0.0, maxf(0.0, momentum) * _limb_drive_heat_coeff_for_part(part, slot_key, module_part) * scale)


func _limb_drive_idle_heat_for_segment(segment: Dictionary, module_part: Dictionary, momentum: float, scale: float = 1.0) -> float:
	return maxf(0.0, maxf(0.0, momentum) * _limb_drive_heat_coeff_for_segment(segment, module_part) * scale)


func _limb_momentum_min_for_part(part: Dictionary, slot_key: String) -> float:
	if part.has("momentum_min"):
		return maxf(0.0, float(part["momentum_min"]))
	var drive_kind := _joint_drive_kind_for_part(part, slot_key)
	if drive_kind == "rigid":
		return 0.0
	var band := _limb_motion_duration_band_for_part(part, slot_key)
	return _limb_momentum_for_duration(part, slot_key, float(band.get("slow", 1.35)))


func _limb_momentum_raw_max_for_part(part: Dictionary, slot_key: String) -> float:
	if part.has("momentum_max"):
		return maxf(0.0, float(part["momentum_max"]))
	var drive_kind := _joint_drive_kind_for_part(part, slot_key)
	if drive_kind == "rigid":
		return 0.0
	var band := _limb_motion_duration_band_for_part(part, slot_key)
	var min_momentum := _limb_momentum_min_for_part(part, slot_key)
	var fastest_momentum := _limb_momentum_for_duration(part, slot_key, float(band.get("fastest", 0.38)))
	return maxf(fastest_momentum, min_momentum * 1.08)


func _limb_momentum_max_for_part(part: Dictionary, slot_key: String) -> float:
	var raw_maximum := _limb_momentum_raw_max_for_part(part, slot_key)
	return _data_rule_service().limb_max(raw_maximum)


func _default_limb_allocated_momentum_for_part(part: Dictionary, slot_key: String, module_part: Dictionary = {}) -> float:
	if part.has("allocated_limb_momentum"):
		return maxf(0.0, float(part["allocated_limb_momentum"]))
	if part.has("allocated_momentum"):
		return maxf(0.0, float(part["allocated_momentum"]))
	var drive_kind := _joint_drive_kind_for_part(part, slot_key)
	if drive_kind == "rigid":
		return 0.0
	var min_momentum := _limb_momentum_min_for_part(part, slot_key)
	var max_momentum := _limb_momentum_max_for_part(part, slot_key)
	var desired := _joint_engine_demand_for_part(part, slot_key, module_part)
	if desired <= 0.0:
		desired = (min_momentum + max_momentum) * 0.5
	return clampf(desired, min_momentum, max_momentum)


func _limb_drive_component_with_defaults(part: Dictionary, slot_key: String) -> Dictionary:
	if slot_key not in ["limb_muscle", "muscle"]:
		return part
	if _component_is_torso(part) or _part_is_ammo_payload(part) or bool(part.get("torso_slot_payload", false)):
		return part
	if not _component_has_combat_volume(part, slot_key):
		return part
	var adjusted := part.duplicate(true)
	if not adjusted.has("limb_family"):
		adjusted["limb_family"] = _limb_family_for_part(adjusted, slot_key)
	if not adjusted.has("joint_drive_kind"):
		adjusted["joint_drive_kind"] = _joint_drive_kind_for_part(adjusted, slot_key)
	if not adjusted.has("joint_output_momentum_base"):
		adjusted["joint_output_momentum_base"] = _joint_output_momentum_base_for_part(adjusted, slot_key)
	if not adjusted.has("joint_engine_demand"):
		adjusted["joint_engine_demand"] = _joint_engine_demand_for_part(adjusted, slot_key)
	if not adjusted.has("joint_speed_cap"):
		adjusted["joint_speed_cap"] = _limb_joint_speed_cap_for_part(adjusted, slot_key)
	if not adjusted.has("limb_idle_heat_coeff") and not adjusted.has("drive_heat_coeff"):
		adjusted["limb_idle_heat_coeff"] = _limb_drive_heat_coeff_for_part(adjusted, slot_key)
	var resolved_min_momentum := _limb_momentum_min_for_part(adjusted, slot_key)
	var resolved_raw_max_momentum := _limb_momentum_raw_max_for_part(adjusted, slot_key)
	var resolved_max_momentum := _data_rule_service().limb_max(resolved_raw_max_momentum)
	if not adjusted.has("momentum_min"):
		adjusted["momentum_min"] = resolved_min_momentum
	adjusted["momentum_max_raw"] = resolved_raw_max_momentum
	adjusted["momentum_max"] = resolved_max_momentum
	if not adjusted.has("allocated_limb_momentum"):
		var desired_momentum := _joint_engine_demand_for_part(adjusted, slot_key)
		if desired_momentum <= 0.0:
			desired_momentum = (float(adjusted.get("momentum_min", resolved_min_momentum)) + resolved_max_momentum) * 0.5
		adjusted["allocated_limb_momentum"] = clampf(desired_momentum, float(adjusted.get("momentum_min", resolved_min_momentum)), resolved_max_momentum)
	if not adjusted.has("joint_angle_range"):
		adjusted["joint_angle_range"] = float(_embedded_joint_profile_for_part(adjusted, slot_key).get("angle", 0.0))
	if not adjusted.has("joint_extension_m"):
		adjusted["joint_extension_m"] = float(_embedded_joint_profile_for_part(adjusted, slot_key).get("extension", 0.0))
	return adjusted


func _positive_min(values: Array, fallback: float) -> float:
	var result := maxf(0.0, fallback)
	for value in values:
		var numeric_value := float(value)
		if numeric_value <= 0.0:
			continue
		if result <= 0.0 or numeric_value < result:
			result = numeric_value
	return result


func _complete_attack_group_physics(group: Dictionary, stats: Dictionary) -> Dictionary:
	var completed := group.duplicate(true)
	var fallback_stiffness := maxf(1.0, float(stats.get("stiffness", stats.get("load_capacity", 1.0))) / maxf(1.0, float(ATTACK_GROUP_COUNT)))
	var joint_stiffness := maxf(0.0, float(completed.get("joint_stiffness", fallback_stiffness)))
	var limb_stiffness := maxf(0.0, float(completed.get("limb_stiffness", fallback_stiffness)))
	var terminal_stiffness := maxf(0.0, float(completed.get("terminal_stiffness", fallback_stiffness if bool(completed.get("terminal_weapon", true)) else 0.0)))
	completed["group_stiffness"] = _positive_min([joint_stiffness, limb_stiffness, terminal_stiffness], fallback_stiffness)
	var limb_family := String(completed.get("stiffness_segment_material_family", completed.get("joint_material_family", "metal")))
	var limb_coeff := float(completed.get("limb_defense_coefficient", CONTACT_DEFENSE_LIMB_COEFF))
	var limb_threshold := float(completed.get("limb_break_threshold", _stiffness_segment_threshold_from_material(limb_family, limb_coeff)))
	var terminal_threshold := 0.0
	if bool(completed.get("terminal_weapon", true)):
		var terminal_family := String(completed.get("terminal_material_family", limb_family))
		var terminal_coeff := float(completed.get("terminal_defense_coefficient", CONTACT_DEFENSE_TERMINAL_MELEE_COEFF))
		terminal_threshold = maxf(CONTACT_UNIT_THRESHOLD_MIN, float(completed.get("terminal_defense_threshold", _stiffness_segment_threshold_from_material(terminal_family, terminal_coeff))))
	completed["limb_break_threshold"] = clampf(limb_threshold, CONTACT_UNIT_THRESHOLD_MIN, CONTACT_UNIT_THRESHOLD_MAX)
	completed["terminal_damage_threshold"] = clampf(terminal_threshold, 0.0, CONTACT_UNIT_THRESHOLD_MAX)
	completed["stiffness_segment_threshold"] = completed["limb_break_threshold"]
	if not completed.has("limb_stiffness_segment_hp"):
		completed["limb_stiffness_segment_hp"] = _stiffness_segment_hp_from_material_volume(limb_family, 3.0)
	completed["limb_stiffness_segment_hp"] = maxf(CONTACT_UNIT_HP_MIN, float(completed.get("limb_stiffness_segment_hp", CONTACT_UNIT_HP_MIN)))
	if not completed.has("joint_stiffness_segment_hp"):
		completed["joint_stiffness_segment_hp"] = completed["limb_stiffness_segment_hp"]
	if not completed.has("limb_muscle_stiffness_segment_hp"):
		completed["limb_muscle_stiffness_segment_hp"] = completed["limb_stiffness_segment_hp"]
	if bool(completed.get("terminal_weapon", true)):
		if not completed.has("terminal_stiffness_segment_hp"):
			completed["terminal_stiffness_segment_hp"] = maxf(0.0, float(completed.get("terminal_hp", 0.0)))
	else:
		completed["terminal_stiffness_segment_hp"] = 0.0
	if not completed.has("stiffness_segment_material_valid"):
		completed["stiffness_segment_material_valid"] = true
	if not completed.has("joint_resist"):
		completed["joint_resist"] = {}
	if not completed.has("limb_resist"):
		completed["limb_resist"] = {}
	if not completed.has("terminal_resist"):
		completed["terminal_resist"] = {}
	if float(completed.get("joint_power", 0.0)) <= 0.0:
		var synthetic_power := 0.72 + float(completed.get("joint_range", 0.0)) * 1.2 + float(completed.get("range_mult", 1.0)) * 0.22 + float(stats.get("cancel_power", 0.0)) * 0.74
		if String(completed.get("motion", "")).contains("chain"):
			synthetic_power += 0.22
		completed["joint_power"] = clampf(synthetic_power, 0.12, 8.0)
	if float(completed.get("fixed_output_momentum", 0.0)) <= 0.0:
		completed["fixed_output_momentum"] = maxf(18.0, float(completed.get("joint_power", 0.0)) * 145.0)
	if not completed.has("terminal_momentum_mult"):
		completed["terminal_momentum_mult"] = _terminal_momentum_multiplier(completed)
	if bool(completed.get("projectile", false)) and float(completed.get("projectile_momentum", 0.0)) <= 0.0:
		var projectile_event := completed.duplicate(true)
		projectile_event["projectile"] = true
		if String(projectile_event.get("damage_type", "")) == "" and String(projectile_event.get("projectile_damage_type", "")) != "":
			projectile_event["damage_type"] = String(projectile_event.get("projectile_damage_type", "bullet"))
		completed["projectile_momentum"] = _projectile_momentum_for_event(projectile_event)
	if bool(completed.get("projectile", false)):
		var completed_projectile_event := completed.duplicate(true)
		completed_projectile_event["projectile"] = true
		if String(completed_projectile_event.get("damage_type", "")) == "" and String(completed_projectile_event.get("projectile_damage_type", "")) != "":
			completed_projectile_event["damage_type"] = String(completed_projectile_event.get("projectile_damage_type", "bullet"))
		if float(completed.get("projectile_collision_speed", 0.0)) <= 0.0:
			completed["projectile_collision_speed"] = _projectile_collision_speed_for_event(completed_projectile_event)
		if float(completed.get("projectile_mass", 0.0)) <= 0.0:
			completed["projectile_mass"] = _projectile_mass_for_event(completed_projectile_event, float(completed["projectile_collision_speed"]))
		completed.erase("recoil_transfer_mult")
		_sync_projectile_drive_momentum_fields(completed)
	completed["limb_end_mass"] = _group_limb_end_mass(completed, stats)
	if not completed.has("swing_speed_bonus"):
		completed["swing_speed_bonus"] = 0.0
	return completed


func _special_deploy_wait(part: Dictionary, role_key: String) -> float:
	var kind := String(part.get("kind", ""))
	var cost := float(part.get("cost", 0))
	match kind:
		"soul":
			return clampf(2.6 + cost / 82.0, 2.8, 6.8)
		"code":
			var group_count := float(part.get("group_count", 1))
			var sequence_limit := float(part.get("module_sequence_limit", 1))
			return clampf(1.5 + group_count * 0.38 + sequence_limit * 0.24 + cost / 140.0, 2.0, 6.4)
		"ether":
			var slots := float(part.get("material_slots", part.get("fixed", 1)))
			var space := float(part.get("space_size", 0.5))
			return clampf(1.4 + slots * 0.28 + space * 0.95 + cost / 165.0, 1.8, 6.8)
	return DEPLOY_WAIT_SECONDS


func _part_counts_as_terminal_weapon(part: Dictionary, slot_kind: String) -> bool:
	if slot_kind != "muscle":
		return false
	if bool(part.get("terminal_weapon", false)):
		return true
	if bool(part.get("limb_segment", false)):
		return false
	if bool(part.get("torso_slot_payload", false)) or bool(part.get("is_torso", false)):
		return false
	var material_class := String(part.get("material_class", ""))
	return material_class in ["weapon", "gun", "missile_launcher", "racket", "web_gun"] or bool(part.get("projectile", false)) or float(part.get("normal_damage", 0.0)) >= 8.0


func _part_is_ranged_terminal_weapon(part: Dictionary) -> bool:
	var explicit_kind := String(part.get("terminal_weapon_kind", "")).to_lower()
	if explicit_kind == "ranged":
		return true
	if explicit_kind == "melee":
		return false
	var material_class := String(part.get("material_class", "")).to_lower()
	var shape := String(part.get("shape", "")).to_lower()
	var name := String(part.get("name", "")).to_lower()
	return bool(part.get("projectile", false)) or material_class in ["gun", "missile_launcher", "web_gun"] or shape.contains("gun") or shape.contains("rifle") or shape.contains("cannon") or shape.contains("launcher") or name.contains("rifle") or name.contains("rail") or name.contains("laser") or name.contains("missile")


func _terminal_weapon_kind_for_part(part: Dictionary, slot_kind: String = "muscle") -> String:
	if not _part_counts_as_terminal_weapon(part, slot_kind):
		return ""
	var explicit_kind := String(part.get("terminal_weapon_kind", "")).to_lower()
	if explicit_kind in ["melee", "ranged"]:
		return explicit_kind
	return "ranged" if _part_is_ranged_terminal_weapon(part) else "melee"


func _terminal_geometry_length_multiplier(part: Dictionary, slot_kind: String = "muscle") -> float:
	if not _part_counts_as_terminal_weapon(part, slot_kind):
		return 1.0
	return TERMINAL_RANGED_GEOMETRY_MULTIPLIER if _part_is_ranged_terminal_weapon(part) else TERMINAL_MELEE_GEOMETRY_MULTIPLIER


func _terminal_geometry_radius_multiplier(part: Dictionary, slot_kind: String = "muscle") -> float:
	return TERMINAL_RADIUS_GEOMETRY_MULTIPLIER if _part_counts_as_terminal_weapon(part, slot_kind) else 1.0


func _effective_part_length_for_geometry(part: Dictionary, slot_kind: String = "muscle") -> float:
	return maxf(0.0, float(part.get("length", 0.0)) * _terminal_geometry_length_multiplier(part, slot_kind))


func _effective_part_radius_for_geometry(part: Dictionary, slot_kind: String = "muscle") -> float:
	return maxf(0.0, float(part.get("radius", 0.0)) * _terminal_geometry_radius_multiplier(part, slot_kind))


func _part_with_effective_terminal_geometry(part: Dictionary, slot_kind: String = "muscle") -> Dictionary:
	if not _part_counts_as_terminal_weapon(part, slot_kind):
		return part
	var adjusted := part.duplicate(true)
	adjusted["raw_length"] = float(part.get("length", 0.0))
	adjusted["raw_radius"] = float(part.get("radius", 0.0))
	adjusted["length"] = _effective_part_length_for_geometry(part, slot_kind)
	adjusted["radius"] = _effective_part_radius_for_geometry(part, slot_kind)
	adjusted["terminal_geometry_scaled"] = true
	adjusted["terminal_weapon_kind"] = _terminal_weapon_kind_for_part(part, slot_kind)
	return adjusted


func _normalize_visual_handedness(value) -> String:
	return "left" if String(value).to_lower() == "left" else "right"


func _normalize_mount_side(value) -> String:
	return _normalize_visual_handedness(value)


func _part_is_orthogonal_side_mount_candidate(part: Dictionary, slot_kind: String = "muscle") -> bool:
	if String(part.get("orientation_category", "")).to_lower() == "orthogonal_side_mount":
		return true
	if slot_kind != "muscle":
		return false
	if not _part_counts_as_terminal_weapon(part, slot_kind):
		return false
	if _terminal_weapon_kind_for_part(part, slot_kind) == "ranged":
		return false
	var name := String(part.get("name", part.get("component_name", ""))).to_upper()
	var shape := String(part.get("shape", part.get("source_shape", ""))).to_upper()
	var family := String(part.get("weapon_family", "")).to_lower()
	return family == "scythe" or name.contains("SCYTHE") or name.contains("CRESCENT") or name.contains("HOOK") or shape.contains("SCYTHE") or shape.contains("CRESCENT") or shape.contains("HOOK")


func _part_with_mount_orientation_defaults(part: Dictionary, slot_kind: String = "muscle") -> Dictionary:
	if not _part_is_orthogonal_side_mount_candidate(part, slot_kind):
		return part
	var adjusted := part.duplicate(true)
	adjusted["asymmetric_terminal"] = true
	adjusted["orientation_category"] = String(adjusted.get("orientation_category", "orthogonal_side_mount"))
	adjusted["orientation_basis"] = String(adjusted.get("orientation_basis", "parent_normal"))
	adjusted["mount_side_choices"] = Array(adjusted.get("mount_side_choices", adjusted.get("orientation_choices", ["left", "right"]))).duplicate(true)
	adjusted["orientation_choices"] = Array(adjusted.get("mount_side_choices", ["left", "right"])).duplicate(true)
	adjusted["default_mount_side"] = _normalize_mount_side(adjusted.get("default_mount_side", adjusted.get("default_visual_handedness", adjusted.get("visual_handedness", "right"))))
	adjusted["default_visual_handedness"] = String(adjusted.get("default_mount_side", "right"))
	return adjusted


func _part_supports_visual_handedness(part: Dictionary, slot_kind: String = "muscle") -> bool:
	if _part_is_orthogonal_side_mount_candidate(part, slot_kind):
		return true
	if bool(part.get("asymmetric_terminal", false)):
		return true
	if not _part_counts_as_terminal_weapon(part, slot_kind):
		return false
	if _terminal_weapon_kind_for_part(part, slot_kind) == "ranged":
		return false
	var display_part := _part_with_effective_terminal_geometry(part, slot_kind)
	var component_node := AssemblyBoardRenderer.part_to_component_node(slot_kind, display_part)
	return AssemblyBoardRenderer.terminal_shape_family(component_node) == "scythe"


func _default_visual_handedness_for_part(part: Dictionary) -> String:
	return _normalize_mount_side(part.get("default_mount_side", part.get("default_visual_handedness", part.get("visual_mount_side", part.get("visual_handedness", "right")))))


func _topology_node_visual_handedness(node: Dictionary) -> String:
	var explicit_mount_side := String(node.get("visual_mount_side", "")).strip_edges()
	var explicit_handedness := String(node.get("visual_handedness", "")).strip_edges()
	if explicit_mount_side != "":
		return _normalize_mount_side(explicit_mount_side)
	if explicit_handedness != "":
		return _normalize_mount_side(explicit_handedness)
	return _normalize_mount_side(node.get("visual_mount_side", node.get("default_mount_side", node.get("default_visual_handedness", "right"))))


func _apply_visual_handedness_defaults_to_node(target: Dictionary, part: Dictionary, slot_kind: String = "muscle") -> void:
	if not _part_supports_visual_handedness(part, slot_kind):
		return
	target["asymmetric_terminal"] = true
	target["orientation_category"] = String(part.get("orientation_category", "orthogonal_side_mount"))
	target["orientation_basis"] = String(part.get("orientation_basis", "parent_normal"))
	target["mount_side_choices"] = Array(part.get("mount_side_choices", part.get("orientation_choices", ["left", "right"]))).duplicate(true)
	target["orientation_choices"] = Array(target.get("mount_side_choices", ["left", "right"])).duplicate(true)
	target["default_mount_side"] = _default_visual_handedness_for_part(part)
	target["default_visual_handedness"] = _default_visual_handedness_for_part(part)
	if not target.has("visual_mount_side") or String(target.get("visual_mount_side", "")) == "":
		target["visual_mount_side"] = String(target.get("visual_handedness", target.get("default_mount_side", "right")))
	target["visual_mount_side"] = _topology_node_visual_handedness(target)
	target["visual_handedness"] = String(target.get("visual_mount_side", "right"))


func _topology_node_supports_visual_handedness(role_key: String, unit_bp: Dictionary, node: Dictionary) -> bool:
	if not _topology_node_is_component(node):
		return false
	var slot_key := _topology_node_slot(node)
	return _part_supports_visual_handedness(_topology_node_part(role_key, node, unit_bp), slot_key)


func _component_is_blade_weapon(part: Dictionary) -> bool:
	var name := String(part.get("name", "")).to_upper()
	var shape := String(part.get("shape", "")).to_lower()
	var damage_type := String(part.get("damage_type", ""))
	var material_class := String(part.get("material_class", "")).to_lower()
	var terminal_like := bool(part.get("terminal_weapon", false)) or int(part.get("connection_ends", 2)) <= 1 or material_class in ["weapon", "racket"]
	return damage_type == "tear" and (terminal_like or name.contains("SCYTHE") or name.contains("KATANA") or name.contains("GREATSWORD") or name.contains("GREAT SWORD") or name.contains("BUSTER") or name.contains("ODACHI") or name.contains("MACHETE") or name.contains("RAZOR") or name.contains("SABER") or name.contains("WING") or name.contains("TAIL") or shape.contains("scythe") or shape.contains("katana") or shape.contains("greatsword") or shape.contains("great_sword") or shape.contains("machete") or shape.contains("blade") or shape.contains("razor") or shape.contains("saber") or shape.contains("wing") or shape.contains("tail"))


func _blade_weapon_family_for_part(part: Dictionary) -> String:
	var explicit := String(part.get("weapon_family", "")).to_lower()
	if explicit in ["scythe", "katana", "greatsword"]:
		return explicit
	var name := String(part.get("name", "")).to_upper()
	var shape := String(part.get("shape", "")).to_lower()
	if name.contains("SCYTHE") or shape.contains("scythe") or shape.contains("crescent") or shape.contains("tail_scythe"):
		return "scythe"
	if name.contains("KATANA") or name.contains("WAKIZASHI") or name.contains("ODACHI") or name.contains("SABER") or shape.contains("katana") or shape.contains("saber"):
		return "katana"
	if name.contains("GREATSWORD") or name.contains("GREAT SWORD") or name.contains("BUSTER") or shape.contains("greatsword") or shape.contains("great_sword"):
		return "greatsword"
	return "blade" if _component_is_blade_weapon(part) else ""


