func _select_catalog_component(component_index: int) -> void:
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("install_part")
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var slot_key: String = BUILD_SLOTS[editor_slot_index]
	var entries := _editor_catalog_entries(role_key, slot_key)
	var actual_entry_index := editor_catalog_page * editor_catalog_buttons.size() + component_index
	if actual_entry_index < 0 or actual_entry_index >= entries.size():
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("install_part")
		return
	var unit_bp: Dictionary = _editor_current_blueprint()
	var entry: Dictionary = entries[actual_entry_index]
	var actual_index := int(entry.get("index", 0))
	slot_key = String(entry.get("slot", slot_key))
	var clicked_part: Dictionary = entry.get("part", _selected_component(role_key, slot_key, actual_index))
	if _part_installs_as_torso_payload(slot_key, clicked_part):
		_add_torso_payload_component(slot_key, actual_index, clicked_part)
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("install_part")
		return
	if _role_uses_body_board(role_key) and _is_body_group_slot(slot_key):
		_ensure_custom_topology(unit_bp)
		if _is_topology_part_slot(slot_key):
			_set_pending_canvas_part(unit_bp, slot_key, actual_index)
			_set_control_text_if_changed(editor_board_hint_label, "已选择：%s。可直接拖卡片进画布，也可点击画布放置/替换。" % _pending_canvas_part_name(role_key))
			_play_sfx_wave("clack", 640.0, 0.04, -18.0)
			ai_team_manual_lock[player_id] = true
			mark_editor_dirty(EDITOR_DIRTY_ACTION_BUTTONS, "catalog.pending_canvas_part")
			flush_editor_dirty(600)
			if hot_path_profiler != null:
				hot_path_profiler.scope_end("install_part")
			return
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		var nodes: Array = topology.get("nodes", [])
		if not nodes.is_empty():
			editor_topology_node_index = clampi(editor_topology_node_index, 0, nodes.size() - 1)
			var node: Dictionary = nodes[editor_topology_node_index]
			node = _set_topology_node_slot(node, slot_key, actual_index)
			nodes[editor_topology_node_index] = node
			topology["nodes"] = nodes
			unit_bp["custom_topology"] = topology
			unit_bp["blank_canvas"] = false
			_trigger_editor_snap("node", String(clicked_part.get("name", "")))
			ai_team_manual_lock[player_id] = true
	else:
		unit_bp[slot_key] = actual_index
		unit_bp["blank_canvas"] = false
		_trigger_editor_snap(slot_key, String(clicked_part.get("name", "")))
		ai_team_manual_lock[player_id] = true
	_update_editor_ui()
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("install_part")


func _torso_payload_kind_for_part(part: Dictionary, slot_key: String) -> String:
	if slot_key == "special":
		return "special"
	if slot_key == "module":
		return "module"
	if bool(part.get("ammo_slot_payload", false)) or String(part.get("material_class", "")) == "ammo_payload":
		return "ammo"
	if bool(part.get("electronic_armor", false)) or bool(part.get("shield_payload", false)) or String(part.get("material_class", "")) == "shield_payload":
		return "electronic_armor"
	if slot_key in ["engine", "booster", "cooling"]:
		return slot_key
	if bool(part.get("has_escape_pod", false)):
		return "escape_pod"
	return String(part.get("slot_payload_kind", "payload"))


func _part_installs_as_torso_payload(slot_key: String, part: Dictionary) -> bool:
	return bool(part.get("torso_slot_payload", false)) or slot_key in ["engine", "booster", "cooling", "special", "module"]


func _add_torso_payload_component(slot_key: String, part_index: int, part: Dictionary, requested_internal_slot_index: int = -1) -> void:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	var torso_node_index := _active_torso_node_index_for_payload_install(unit_bp)
	if _role_uses_body_board(role_key) and torso_node_index < 0:
		editor_summary_label.text = "警报：请先在画布中放入一个躯干/大脑连接件，再安装机内插件或软件。" if _ui_is_zh() else "ALARM: place a torso/brain connector on the board before installing internal plugins or software."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return
	var payload_kind := _torso_payload_kind_for_part(part, slot_key)
	var payload := _make_torso_payload_for_part(payload_kind, slot_key, part_index, part)
	var assigned_internal_slot := -1
	if torso_node_index >= 0:
		if payload_kind == "booster" and _torso_booster_payload_count(unit_bp, torso_node_index) >= 1:
			editor_summary_label.text = "警报：该躯体已有推进器。" if _ui_is_zh() else "ALARM: torso already has a booster."
			_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
			return
		var plugin_count := _torso_plugin_slot_summary(unit_bp, torso_node_index).size()
		var software_count := _torso_software_slot_summary(unit_bp, torso_node_index).size()
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		var nodes: Array = topology.get("nodes", [])
		var torso_part := _topology_node_part(role_key, nodes[torso_node_index], unit_bp) if torso_node_index < nodes.size() else {}
		var plugin_cap := _torso_plugin_capacity_for_part(torso_part)
		var software_cap := _torso_software_capacity_for_part(torso_part)
		if _torso_payload_slot_group(payload_kind) == "plugin" and plugin_count >= plugin_cap:
			editor_summary_label.text = "警报：该躯干机内插件槽已满 %d/%d。" % [plugin_count, plugin_cap] if _ui_is_zh() else "ALARM: this torso's internal plugin slots are full %d/%d." % [plugin_count, plugin_cap]
			_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
			return
		if _torso_payload_slot_group(payload_kind) == "software" and software_count >= software_cap:
			editor_summary_label.text = "警报：该躯干软件槽已满 %d/%d。" % [software_count, software_cap] if _ui_is_zh() else "ALARM: this torso's software slots are full %d/%d." % [software_count, software_cap]
			_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
			return
		if _torso_payload_slot_group(payload_kind) == "plugin":
			var payload_part_for_fit := _payload_part_for_payload(role_key, payload)
			var payload_rank := _volume_rank_from_value(_payload_slot_volume_rank(payload_kind, payload_part_for_fit, payload, slot_key), 1)
			assigned_internal_slot = _find_internal_slot_for_payload(unit_bp, torso_node_index, torso_part, payload_kind, payload_part_for_fit, payload, requested_internal_slot_index)
			if assigned_internal_slot < 0:
				var requested_text := ""
				if requested_internal_slot_index >= 0:
					var slot_sizes := _torso_internal_slot_size_ranks(torso_part)
					var slot_label := _volume_rank_label(float(slot_sizes[requested_internal_slot_index])) if requested_internal_slot_index < slot_sizes.size() else "-"
					requested_text = "，目标槽上限%s" % slot_label if _ui_is_zh() else ", target slot <=%s" % slot_label
				editor_summary_label.text = "警报：该插件尺寸%s无法装入当前机内槽%s。" % [_volume_rank_label(float(payload_rank)), requested_text] if _ui_is_zh() else "ALARM: plugin size %s cannot fit this torso's internal slots%s." % [_volume_rank_label(float(payload_rank)), requested_text]
				_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
				return
	_record_editor_undo_state("安装躯干插件" if _ui_is_zh() else "install torso payload")
	unit_bp["blank_canvas"] = false
	if torso_node_index >= 0:
		payload["torso_node"] = torso_node_index
	if assigned_internal_slot >= 0:
		payload["internal_slot_index"] = assigned_internal_slot
	var payloads: Array = Array(unit_bp.get("slot_payloads", [])).duplicate(true)
	payloads.append(payload)
	var payload_index := payloads.size() - 1
	unit_bp["slot_payloads"] = payloads
	_trigger_editor_snap(slot_key, String(part.get("name", payload_kind)))
	var label := "护盾插件" if payload_kind == "electronic_armor" else ("弹药包" if payload_kind == "ammo" else ("英魂/源代码/以太" if payload_kind == "special" else ("行动模块" if payload_kind == "module" else ("引擎插件" if payload_kind == "engine" else ("推进插件" if payload_kind == "booster" else ("散热插件" if payload_kind == "cooling" else ("逃生舱" if payload_kind == "escape_pod" else payload_kind)))))))
	var installed_part := _payload_part_for_payload(role_key, payload)
	var part_name := _zh_part_name(String(installed_part.get("name", ""))) if _ui_is_zh() else String(installed_part.get("name", ""))
	var slot_text := (" 槽%d" % (assigned_internal_slot + 1)) if assigned_internal_slot >= 0 and _ui_is_zh() else (" slot %d" % (assigned_internal_slot + 1) if assigned_internal_slot >= 0 else "")
	editor_open_torso_node_index = torso_node_index
	var started_module_binding := false
	if payload_kind == "module" and _module_requires_execution_binding(installed_part):
		_start_editor_module_binding_flow(payload_index, installed_part)
		started_module_binding = true
	else:
		editor_summary_label.text = "已购买并安装到躯干详情页%s：%s（%s）。" % [slot_text, part_name, label] if _ui_is_zh() else "Purchased and installed into torso detail%s: %s (%s)." % [slot_text, String(installed_part.get("name", "")), payload_kind]
	ai_team_manual_lock[player_id] = true
	_update_editor_ui()
	if started_module_binding:
		if editor_summary_label != null:
			editor_summary_label.text = "行动模块已安装：请在躯干详情页点选可绑定部位，然后选择 U/I/O/J/K/L。" if _ui_is_zh() else "Action module installed: choose a bindable target in the torso detail page, then choose U/I/O/J/K/L."
		if editor_board_hint_label != null:
			editor_board_hint_label.text = _pending_module_binding_hint()
		_refresh_editor_module_binding_buttons()


func _next_available_attack_key_for_binding(unit_bp: Dictionary) -> int:
	var used := {}
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	for raw_node in Array(topology.get("nodes", [])):
		if raw_node is Dictionary and Dictionary(raw_node).has("attack_key"):
			used[int(Dictionary(raw_node).get("attack_key", 0))] = true
	for key in range(1, ATTACK_GROUP_COUNT + 1):
		if not used.has(key):
			return key
	return 1


func _attack_key_label(key_value: int) -> String:
	var index := clampi(key_value, 1, ATTACK_GROUP_COUNT) - 1
	return String(ATTACK_KEY_LABELS[index])


func _start_editor_module_binding_flow(payload_index: int, module_part: Dictionary) -> void:
	var unit_bp: Dictionary = _editor_current_blueprint()
	_clear_editor_hover_card()
	_close_engine_momentum_allocation_panel()
	editor_pending_module_binding = {
		"payload_index": payload_index,
		"module_index": int(module_part.get("__catalog_index", -1)),
		"attack_key": 0,
		"target_selected": false,
	}
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	if payload_index >= 0 and payload_index < payloads.size() and payloads[payload_index] is Dictionary:
		editor_pending_module_binding["module_index"] = int(Dictionary(payloads[payload_index]).get("module", editor_pending_module_binding.get("module_index", 0)))
	editor_selected_topology_nodes = []
	editor_board_tool = "layout"
	if editor_summary_label != null:
		editor_summary_label.text = "行动模块已安装：请在躯干详情页点选可绑定部位，然后选择 U/I/O/J/K/L。" if _ui_is_zh() else "Action module installed: pick a bindable target in the torso detail page, then choose U/I/O/J/K/L."
	if editor_board_hint_label != null:
		editor_board_hint_label.text = _pending_module_binding_hint()
	_refresh_torso_detail_view()
	_refresh_editor_module_binding_buttons()
	_refresh_editor_visual_views()


func _cancel_editor_module_binding(show_message: bool = true) -> void:
	if editor_pending_module_binding.is_empty():
		return
	editor_pending_module_binding = {}
	if show_message and editor_board_hint_label != null:
		editor_board_hint_label.text = "已取消行动模块绑定。" if _ui_is_zh() else "Canceled action module binding."
	_refresh_editor_module_binding_buttons()
	_refresh_editor_visual_views()


func _pending_module_binding_hint() -> String:
	if editor_pending_module_binding.is_empty():
		return ""
	var role_key: String = ROLE_ORDER[editor_role_index]
	var module_part := _selected_component(role_key, "module", int(editor_pending_module_binding.get("module_index", 0)))
	var module_name := _zh_part_name(String(module_part.get("name", "行动模块"))) if _ui_is_zh() else String(module_part.get("name", "MODULE"))
	if not bool(editor_pending_module_binding.get("target_selected", false)):
		return ("绑定 %s：画板蓝绿部位可点击，红橙部位会显示原因；也可在躯干详情页点选。" if _ui_is_zh() else "Bind %s: click blue-green board targets; red-orange targets show why they fail. You can also pick in torso detail.") % module_name
	var key := int(editor_pending_module_binding.get("attack_key", 0))
	var target_label := String(editor_pending_module_binding.get("target_label", "TARGET"))
	var key_text := "未选择" if _ui_is_zh() else "none"
	if key > 0:
		key_text = "%d %s" % [key, _attack_key_label(key)]
	return ("绑定 %s：目标 %s；请选择攻击键（当前 %s）。" if _ui_is_zh() else "Bind %s: target %s; choose an attack key (current %s).") % [module_name, target_label, key_text]


func _pending_module_binding_candidate_for_node(unit_bp: Dictionary, node_index: int) -> Dictionary:
	if editor_pending_module_binding.is_empty():
		return {}
	var role_key: String = ROLE_ORDER[editor_role_index]
	var module_part := _selected_component(role_key, "module", int(editor_pending_module_binding.get("module_index", 0)))
	var payload_index := int(editor_pending_module_binding.get("payload_index", -1))
	var candidates := _torso_detail_module_binding_candidates(unit_bp, payload_index, module_part)
	var first_invalid := {}
	for raw_candidate in candidates:
		if not (raw_candidate is Dictionary):
			continue
		var candidate: Dictionary = raw_candidate
		var nodes: Array = Array(candidate.get("target_nodes", []))
		var selection: Array = Array(candidate.get("selection", []))
		var root_index := int(candidate.get("root_index", -1))
		var contains_node := root_index == node_index or nodes.has(node_index) or selection.has(node_index)
		if not contains_node:
			continue
		if bool(candidate.get("valid", false)):
			return candidate
		if first_invalid.is_empty():
			first_invalid = candidate
	if not first_invalid.is_empty():
		return first_invalid
	return _torso_detail_binding_candidate_for_node(unit_bp, payload_index, module_part, node_index)


func _pending_module_binding_candidate_for_point(unit_bp: Dictionary, local_pos: Vector2) -> Dictionary:
	if editor_pending_module_binding.is_empty() or not unit_bp.has("custom_topology"):
		return {}
	var role_key: String = ROLE_ORDER[editor_role_index]
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", []))
	var module_part := _selected_component(role_key, "module", int(editor_pending_module_binding.get("module_index", 0)))
	var payload_index := int(editor_pending_module_binding.get("payload_index", -1))
	var candidates := _torso_detail_module_binding_candidates(unit_bp, payload_index, module_part)
	var first_invalid := {}
	for raw_candidate in candidates:
		if not (raw_candidate is Dictionary):
			continue
		var candidate: Dictionary = raw_candidate
		var group_nodes: Array = Array(candidate.get("target_nodes", []))
		if group_nodes.is_empty():
			group_nodes = Array(candidate.get("selection", []))
		var root_index := int(candidate.get("root_index", -1))
		if root_index >= 0 and not group_nodes.has(root_index):
			group_nodes.append(root_index)
		var first := true
		var bounds := Rect2(Vector2.ZERO, Vector2.ZERO)
		for raw_node in group_nodes:
			var node_index := int(raw_node)
			if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
				continue
			var node: Dictionary = nodes[node_index]
			var point := _topology_position_to_board_local(_topology_node_position(node))
			var radius := _topology_node_pick_radius(role_key, unit_bp, node) + 28.0
			var node_rect := Rect2(point - Vector2(radius, radius), Vector2(radius * 2.0, radius * 2.0))
			bounds = node_rect if first else bounds.merge(node_rect)
			first = false
		if first:
			continue
		if not bounds.grow(8.0).has_point(local_pos):
			continue
		if bool(candidate.get("valid", false)):
			return candidate
		if first_invalid.is_empty():
			first_invalid = candidate
	if not first_invalid.is_empty():
		return first_invalid
	return {}


func _set_pending_module_attack_key(key_value: int) -> void:
	if editor_pending_module_binding.is_empty():
		if editor_board_hint_label != null:
			editor_board_hint_label.text = "没有待绑定的行动模块。" if _ui_is_zh() else "No pending action module binding."
		return
	if not bool(editor_pending_module_binding.get("target_selected", false)):
		if editor_board_hint_label != null:
			editor_board_hint_label.text = "请先在画板上选择行动模块要控制的部位。" if _ui_is_zh() else "Select the module target on the board first."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return
	editor_pending_module_binding["attack_key"] = clampi(key_value, 1, ATTACK_GROUP_COUNT)
	_finalize_pending_module_binding_after_key(_editor_current_blueprint())


func _sanitize_module_binding_selection(unit_bp: Dictionary, selected: Array) -> Array:
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var result: Array = []
	for raw_index in selected:
		var index := int(raw_index)
		if index >= 0 and index < nodes.size() and nodes[index] is Dictionary and not result.has(index):
			result.append(index)
	return result


func _topology_node_is_projectile_gun_terminal(role_key: String, unit_bp: Dictionary, nodes: Array, node_index: int) -> bool:
	if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
		return false
	var node: Dictionary = nodes[node_index]
	var slot_key := _topology_node_slot(node)
	if _topology_slot_family(slot_key) != "muscle":
		return false
	var part := _topology_node_part(role_key, node, unit_bp)
	return _terminal_weapon_kind_for_part(part, "muscle") == "ranged" and _component_is_gun_muscle(part, "muscle")


func _part_is_standard_blunt_gauntlet(part: Dictionary) -> bool:
	if part.is_empty():
		return false
	if bool(part.get("projectile", false)) or _terminal_weapon_kind_for_part(part, "muscle") == "ranged":
		return false
	if not _component_is_blunt_weapon(part):
		return false
	if bool(part.get("blunt_gauntlet", false)):
		return true
	var joined := "%s %s %s" % [String(part.get("name", "")), String(part.get("shape", "")), String(part.get("weapon_family", ""))]
	joined = joined.to_lower()
	return joined.contains("gauntlet") or joined.contains("glove") or joined.contains("fist")


func _part_is_blunt_shield_terminal(part: Dictionary) -> bool:
	if part.is_empty():
		return false
	if bool(part.get("projectile", false)) or _terminal_weapon_kind_for_part(part, "muscle") == "ranged":
		return false
	if not _component_is_blunt_weapon(part):
		return false
	var joined := "%s %s %s" % [String(part.get("name", "")), String(part.get("shape", "")), String(part.get("weapon_family", ""))]
	joined = joined.to_lower()
	return bool(part.get("blunt_shield", false)) or joined.contains("shield") or joined.contains("buckler")


func _part_is_blunt_hammer_terminal(part: Dictionary) -> bool:
	if part.is_empty():
		return false
	if bool(part.get("projectile", false)) or _terminal_weapon_kind_for_part(part, "muscle") == "ranged":
		return false
	if not _component_is_blunt_weapon(part):
		return false
	var joined := "%s %s %s" % [String(part.get("name", "")), String(part.get("shape", "")), String(part.get("weapon_family", ""))]
	joined = joined.to_lower()
	return bool(part.get("blunt_hammer", false)) or joined.contains("hammer") or joined.contains("maul") or joined.contains("mace")


func _topology_node_is_blunt_hybrid_gauntlet(role_key: String, unit_bp: Dictionary, nodes: Array, node_index: int, module_part: Dictionary = {}) -> bool:
	if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
		return false
	var node: Dictionary = nodes[node_index]
	if _topology_node_slot(node) != "muscle":
		return false
	var part := _topology_node_part(role_key, node, unit_bp)
	if not _part_is_standard_blunt_gauntlet(part):
		return false
	var profile := _embedded_joint_profile_for_part(part, "muscle", module_part)
	var required_degrees := int(module_part.get("required_joint_degrees", 90))
	var required_extension := float(module_part.get("required_extension_m", STANDARD_GAUNTLET_EXTENSION_M))
	if String(profile.get("kind", "")) != "hybrid":
		return false
	return float(profile.get("angle", 0.0)) >= float(required_degrees) and float(profile.get("extension", 0.0)) >= required_extension


func _topology_node_is_blunt_terminal_family(role_key: String, unit_bp: Dictionary, nodes: Array, node_index: int, module_part: Dictionary, family: String) -> bool:
	if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
		return false
	var node: Dictionary = nodes[node_index]
	if _topology_node_slot(node) != "muscle":
		return false
	var part := _topology_node_part(role_key, node, unit_bp)
	var valid_family := _part_is_blunt_shield_terminal(part) if family == "shield" else _part_is_blunt_hammer_terminal(part)
	if not valid_family:
		return false
	var profile := _embedded_joint_profile_for_part(part, "muscle", module_part)
	var required_degrees := int(module_part.get("required_joint_degrees", 90 if family == "shield" else 120))
	return String(profile.get("kind", "")) == "ball" and float(profile.get("angle", 0.0)) >= float(required_degrees)


func _gauntlet_binding_root_for_selection(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, selection: Array, module_part: Dictionary) -> int:
	for raw_index in selection:
		var index := int(raw_index)
		if _topology_node_is_blunt_hybrid_gauntlet(role_key, unit_bp, nodes, index, module_part):
			return index
	for raw_index in selection:
		var current := int(raw_index)
		var previous := -1
		var guard := 0
		while current >= 0 and current < nodes.size() and guard < 18:
			guard += 1
			if _topology_node_is_blunt_hybrid_gauntlet(role_key, unit_bp, nodes, current, module_part):
				return current
			var next_index := _next_topology_chain_node(role_key, unit_bp, nodes, edges, current, previous)
			previous = current
			current = next_index
	return -1


