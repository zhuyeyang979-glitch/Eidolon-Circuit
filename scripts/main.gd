func _rotate_direction_toward(current_direction: Vector2, target_direction: Vector2, max_angle_delta: float) -> Vector2:
	var current := current_direction.normalized() if current_direction.length() > 0.01 else Vector2.RIGHT
	var target := target_direction.normalized() if target_direction.length() > 0.01 else current
	var delta := wrapf(target.angle() - current.angle(), -PI, PI)
	var step := clampf(delta, -absf(max_angle_delta), absf(max_angle_delta))
	return current.rotated(step).normalized()


