func _saved_team_files() -> Array:
	_ensure_saved_teams_dir()
	_purge_legacy_saved_teams()
	var dir := DirAccess.open(SAVED_TEAMS_DIR)
	var files: Array = []
	if dir == null:
		return files
	dir.list_dir_begin()
	while true:
		var file_name := dir.get_next()
		if file_name == "":
			break
		if dir.current_is_dir():
			continue
		if file_name.to_lower().ends_with(".json"):
			files.append("%s/%s" % [SAVED_TEAMS_DIR, file_name])
	dir.list_dir_end()
	files.sort()
	return files


func _import_editor_team(path: String = "") -> bool:
	var import_path := path
	if import_path == "":
		var files := _saved_team_files()
		if files.is_empty():
			editor_summary_label.text = "没有可导入的保存队伍；请先导出一次。" if _ui_is_zh() else "No saved teams to import; export one first."
			return false
		import_path = String(files[files.size() - 1])
	if not FileAccess.file_exists(import_path):
		editor_summary_label.text = "导入失败：找不到队伍文件。" if _ui_is_zh() else "Import failed: team file not found."
		return false
	var parsed = JSON.parse_string(FileAccess.get_file_as_string(import_path))
	if not (parsed is Dictionary):
		editor_summary_label.text = "导入失败：队伍文件不是合法 JSON。" if _ui_is_zh() else "Import failed: team file is not valid JSON."
		return false
	var payload: Dictionary = parsed
	if not _is_current_saved_team_payload(payload):
		_remove_user_json_file(import_path)
		editor_summary_label.text = "导入失败：旧队伍动力链数据已删除，请用 TeamEdit 重新保存。" if _ui_is_zh() else "Import failed: old momentum-chain team data was deleted; rebuild it in TeamEdit."
		return false
	var slots: Array = Array(payload.get("slots", []))
	if not [5, ROSTER_UNIT_CAP].has(slots.size()):
		editor_summary_label.text = "导入失败：队伍文件必须包含 5 个或 10 个槽位。" if _ui_is_zh() else "Import failed: team file must contain exactly 5 or 10 slots."
		return false
	editor_match_format = "light" if slots.size() == 5 or String(payload.get("match_format", "")) == "light" else "standard"
	var imported := _blank_player_roster()
	for raw_slot in slots:
		if not (raw_slot is Dictionary):
			editor_summary_label.text = "导入失败：槽位数据损坏。" if _ui_is_zh() else "Import failed: damaged slot data."
			return false
		var slot: Dictionary = raw_slot
		if bool(slot.get("empty", false)):
			continue
		var role_key := String(slot.get("role", ""))
		if not ROLE_ORDER.has(role_key) or not (slot.get("blueprint", {}) is Dictionary):
			editor_summary_label.text = "导入失败：槽位单位类型或蓝图非法。" if _ui_is_zh() else "Import failed: slot role or blueprint is invalid."
			return false
		var unit_bp: Dictionary = Dictionary(_json_restore_value(slot.get("blueprint", {}))).duplicate(true)
		unit_bp["role"] = role_key
		if _role_uses_body_board(role_key):
			_normalize_unit_to_component_topology(role_key, unit_bp)
		imported[role_key].append(unit_bp)
	var player_id := _editor_player()
	blueprints[player_id] = imported
	active_roster_indices[player_id] = {"hero": 0, "puppet": 0, "barrier": 0}
	sortie_loadouts[player_id] = []
	initial_sortie_slot[player_id] = 0
	initial_role[player_id] = "hero"
	team_color_indices[player_id] = int(payload.get("team_color_index", team_color_indices.get(player_id, 0)))
	var saved_custom: Dictionary = Dictionary(payload.get("team_custom_color", {}))
	if not saved_custom.is_empty():
		team_custom_colors[player_id] = {
			"name": String(saved_custom.get("name", "自定义")),
			"name_en": String(saved_custom.get("name_en", "Custom")),
			"primary": _color_from_save_value(saved_custom.get("primary", {}), _team_primary_color(player_id)),
			"accent": _color_from_save_value(saved_custom.get("accent", {}), _team_accent_color(player_id)),
		}
	ai_team_manual_lock[player_id] = true
	_reset_editor_working_canvas(ROLE_ORDER[editor_role_index])
	editor_summary_label.text = "已导入 P%d 队伍：%s" % [player_id, import_path] if _ui_is_zh() else "Imported P%d team: %s" % [player_id, import_path]
	_update_editor_ui()
	return true


func _topology_node_from_parts(node_id: int, label: String, pos: Vector2, joint_index: int, muscle_index: int, module_index: int, modules: Array = [], limb_muscle_index: int = 0) -> Dictionary:
	var module_list := modules.duplicate(true)
	if module_list.is_empty():
		module_list.append(module_index)
	return {
		"id": node_id,
		"label": label,
		"pos": pos,
		"joint": joint_index,
		"limb_muscle": limb_muscle_index,
		"muscle": muscle_index,
		"module": module_index,
		"modules": module_list,
	}


func _topology_component_node(node_id: int, label: String, pos: Vector2, slot_key: String, part_index: int, module_index: int = -1, modules: Array = []) -> Dictionary:
	var part := _selected_component(ROLE_ORDER[editor_role_index], slot_key, part_index) if part_index >= 0 else {}
	var node := {
		"id": node_id,
		"label": label,
		"pos": pos,
		"slot": slot_key,
		"part_index": part_index,
		"part_name": String(part.get("name", "")),
		"size_tier": PartArt.normalized_size_tier(part) if not part.is_empty() else "",
	}
	if slot_key == "muscle" and _component_is_torso(part):
		node["is_torso"] = true
		node["material_class"] = "torso"
	elif part.has("root_socket"):
		node["root_socket"] = String(part.get("root_socket", ""))
		if part.has("distal_socket"):
			node["distal_socket"] = String(part.get("distal_socket", ""))
	if slot_key == "muscle" and _part_counts_as_terminal_weapon(part, "muscle"):
		node["terminal_weapon"] = true
		node["terminal_weapon_kind"] = _terminal_weapon_kind_for_part(part, "muscle")
		node["projectile"] = _terminal_weapon_kind_for_part(part, "muscle") == "ranged" and bool(part.get("projectile", false))
		_apply_visual_handedness_defaults_to_node(node, part, "muscle")
	if module_index >= 0 or not modules.is_empty():
		var module_list := modules.duplicate(true)
		if module_list.is_empty():
			module_list.append(module_index)
		node["module"] = module_index if module_index >= 0 else int(module_list[0])
		node["modules"] = module_list
	return node


func _topology_is_canonical_component_graph(topology: Dictionary) -> bool:
	var nodes: Array = topology.get("nodes", [])
	if nodes.is_empty():
		return true
	for node in nodes:
		if not (node is Dictionary):
			return false
		if not _topology_node_is_component(node):
			return false
		if _topology_node_slot(node) == "joint":
			return false
	return true


func _append_component_root_node(nodes: Array, label: String, pos: Vector2, torso_index: int) -> int:
	var node_index := nodes.size()
	nodes.append(_topology_component_node(node_index, label, pos, "muscle", torso_index))
	return node_index


func _component_chain_next_position(role_key: String, unit_bp: Dictionary, previous_node: Dictionary, next_node: Dictionary, direction: Vector2) -> Vector2:
	var axis := direction.normalized() if direction.length() > 0.001 else Vector2.RIGHT
	var distance_units := _topology_edge_fixed_distance_units(role_key, previous_node, next_node, unit_bp)
	return _topology_node_position(previous_node) + axis * (distance_units / maxf(0.001, TOPOLOGY_BOARD_PHYSICAL_UNITS))


func _append_directed_component_node(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, previous_index: int, label: String, slot_key: String, part_index: int, direction: Vector2, modules: Array = []) -> int:
	var node_index := nodes.size()
	var module_index := int(modules[0]) if not modules.is_empty() else -1
	var node := _topology_component_node(node_index, label, _topology_node_position(nodes[previous_index]), slot_key, part_index, module_index, modules)
	node["pos"] = _component_chain_next_position(role_key, unit_bp, nodes[previous_index], node, direction)
	nodes.append(node)
	var candidate := _topology_socket_candidate_for_pair(role_key, unit_bp, nodes, edges, node_index, previous_index, false, false)
	if not candidate.is_empty():
		var own_socket: Dictionary = candidate.get("socket_a", {})
		var target_socket: Dictionary = candidate.get("socket_b", {})
		var own_id := String(own_socket.get("id", ""))
		var target_id := String(target_socket.get("id", ""))
		if own_id != "" and target_id != "":
			var target_pos: Vector2 = target_socket.get("pos", _topology_node_position(nodes[previous_index]))
			if _topology_append_socket_edge_if_free(role_key, unit_bp, nodes, edges, node_index, own_id, previous_index, target_id):
				node = _topology_apply_socket_alignment(role_key, unit_bp, nodes, edges, node_index, own_id, target_pos, _topology_node_position(node))
				nodes[node_index] = node
	else:
		var own_id := "root_joint"
		var target_id := "distal"
		if _topology_node_is_torso(role_key, nodes[previous_index], unit_bp):
			var port_positions := _topology_torso_port_positions(role_key, nodes[previous_index], unit_bp)
			var occupied_ports := _torso_occupied_port_indices(role_key, unit_bp, nodes, edges, previous_index)
			var desired_dir := direction.normalized() if direction.length() > 0.001 else Vector2.RIGHT
			var best_port := -1
			var best_score := -999.0
			var torso_center := _topology_node_position(nodes[previous_index])
			for port_i in range(port_positions.size()):
				if occupied_ports.has(port_i):
					continue
				var port_dir: Vector2 = port_positions[port_i] - torso_center
				var score := desired_dir.dot(port_dir.normalized() if port_dir.length() > 0.001 else Vector2.RIGHT)
				if score > best_score:
					best_score = score
					best_port = port_i
			if best_port < 0 and port_positions.size() > 0:
				return node_index
			target_id = "torso_port:%d" % maxi(0, best_port)
		var target_pos := _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, previous_index, target_id, node_index)
		if _topology_append_socket_edge_if_free(role_key, unit_bp, nodes, edges, node_index, own_id, previous_index, target_id):
			node = _topology_apply_socket_alignment(role_key, unit_bp, nodes, edges, node_index, own_id, target_pos, _topology_node_position(node))
			nodes[node_index] = node
	return node_index


func _append_component_limb_chain(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, root_index: int, label: String, terminal_hint: Vector2, joint_index: int, limb_index: int, terminal_index: int, modules: Array, assembly: String = "", blade_count: int = 1) -> void:
	var root_pos: Vector2 = _topology_node_position(nodes[root_index])
	var direction := terminal_hint - root_pos
	if direction.length() <= 0.001:
		direction = _node_position_for_index(nodes.size()) - root_pos
	if direction.length() <= 0.001:
		direction = Vector2.RIGHT
	var base_label := label.strip_edges()
	var attack_key := _next_free_component_attack_key(nodes)
	var limb_modules := modules.duplicate(true)
	var limb := _append_directed_component_node(role_key, unit_bp, nodes, edges, root_index, "%s LINK" % base_label, "limb_muscle", limb_index, direction, limb_modules)
	var terminal := _append_directed_component_node(role_key, unit_bp, nodes, edges, limb, "%s TIP" % base_label, "muscle", terminal_index, direction)
	var limb_node: Dictionary = nodes[limb]
	limb_node["attack_key"] = attack_key
	limb_node["legacy_joint_index"] = joint_index
	if assembly != "":
		limb_node["assembly"] = assembly
	if blade_count > 1:
		limb_node["blade_count"] = blade_count
	nodes[limb] = limb_node
	var terminal_node: Dictionary = nodes[terminal]
	if assembly != "":
		terminal_node["assembly"] = assembly
	if blade_count > 1:
		terminal_node["blade_count"] = blade_count
	nodes[terminal] = terminal_node


func _next_free_component_attack_key(nodes: Array) -> int:
	var used := {}
	for node in nodes:
		if node is Dictionary and Dictionary(node).has("attack_key"):
			used[int(Dictionary(node)["attack_key"])] = true
	for i in range(1, ATTACK_GROUP_COUNT + 1):
		if not used.has(i):
			return i
	return ATTACK_GROUP_COUNT + 1


func _legacy_topology_to_component_graph(role_key: String, unit_bp: Dictionary) -> Dictionary:
	var legacy_topology: Dictionary = unit_bp.get("custom_topology", {})
	var legacy_nodes: Array = legacy_topology.get("nodes", [])
	var nodes: Array = []
	var edges: Array = []
	var root_index := _append_component_root_node(nodes, "CORE", Vector2(0.5, 0.5), int(unit_bp.get("muscle", 0)))
	if legacy_nodes.is_empty() and unit_bp.has("groups"):
		var preset := {"muscle": int(unit_bp.get("muscle", 0)), "limbs": Dictionary(unit_bp.get("groups", {})).duplicate(true)}
		return _template_topology_for_archetype(String(unit_bp.get("archetype", "custom")), preset, unit_bp, role_key)
	if not legacy_nodes.is_empty():
		if bool(unit_bp.get("generated_by_teamedit", false)) or bool(unit_bp.get("ai_shape_template", false)) or String(unit_bp.get("name", "")).contains("AI") or String(unit_bp.get("name", "")).contains("TE"):
			return _default_free_canvas_topology(role_key)
		return {"nodes": [], "edges": [], "edge_snap_version": TOPOLOGY_SNAP_VERSION, "legacy_rejected": true}
	return {"nodes": nodes, "edges": edges, "edge_snap_version": TOPOLOGY_SNAP_VERSION}


func _unit_ref(role_key: String, unit_index: int) -> String:
	return "%s:%d" % [role_key, unit_index]


func _entry_ref(entry: Dictionary) -> String:
	return _unit_ref(String(entry.get("role", "hero")), int(entry.get("index", 0)))


func _all_roster_order(player_id: int) -> Array:
	var order: Array = []
	if not blueprints.has(player_id):
		return order
	var max_units := 0
	for role_key in ROLE_ORDER:
		var roster: Array = blueprints[player_id].get(role_key, [])
		max_units = maxi(max_units, roster.size())
	for unit_index in range(max_units):
		for role_key in ROLE_ORDER:
			var roster: Array = blueprints[player_id].get(role_key, [])
			if unit_index < roster.size():
				order.append({"role": role_key, "index": unit_index})
	return order


func _default_sortie_loadout(player_id: int) -> Array:
	var order := _all_roster_order(player_id)
	var loadout: Array = []
	var limit := mini(order.size(), _current_sortie_cap())
	for i in range(limit):
		loadout.append(Dictionary(order[i]).duplicate(true))
	return loadout


func _default_summon_pair_bindings() -> Array:
	var bindings: Array = []
	var limit := mini(_current_sortie_cap(), DEFAULT_SUMMON_PAIR_SLOTS.size())
	for i in range(limit):
		bindings.append(Array(DEFAULT_SUMMON_PAIR_SLOTS[i]).duplicate(true))
	return bindings


func _ensure_summon_pair_bindings(player_id: int) -> Array:
	var raw: Array = summon_pair_bindings.get(player_id, [])
	var fixed: Array = []
	for i in range(_current_sortie_cap()):
		var pair: Array = []
		if i < raw.size() and raw[i] is Array:
			pair = Array(raw[i]).duplicate(true)
		elif i < DEFAULT_SUMMON_PAIR_SLOTS.size():
			pair = Array(DEFAULT_SUMMON_PAIR_SLOTS[i]).duplicate(true)
		if pair.size() >= 2:
			var a := clampi(int(pair[0]), 1, ATTACK_GROUP_COUNT)
			var b := clampi(int(pair[1]), 1, ATTACK_GROUP_COUNT)
			if a == b:
				pair = []
			else:
				pair = [mini(a, b), maxi(a, b)]
		else:
			pair = []
		fixed.append(pair)
	summon_pair_bindings[player_id] = fixed
	return fixed


func _pair_label(pair: Array) -> String:
	if pair.size() < 2:
		return "--"
	return "%d+%d" % [int(pair[0]), int(pair[1])]


func _pair_key(pair: Array) -> String:
	if pair.size() < 2:
		return ""
	return "%d:%d" % [int(pair[0]), int(pair[1])]


func _pair_used_by_other(bindings: Array, pair: Array, slot_index: int) -> bool:
	var key := _pair_key(pair)
	if key == "":
		return false
	for i in range(bindings.size()):
		if i == slot_index:
			continue
		if _pair_key(Array(bindings[i])) == key:
			return true
	return false


func _binding_slot_for_current_unit() -> int:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var pos := _sortie_position(player_id, role_key, int(editor_unit_indices[role_key]))
	if pos >= 0:
		editor_binding_slot_index = pos
	return clampi(editor_binding_slot_index, 0, _current_sortie_cap() - 1)


func _cycle_current_sortie_binding(direction: int) -> void:
	var player_id := _editor_player()
	var slot_index := _binding_slot_for_current_unit()
	var bindings := _ensure_summon_pair_bindings(player_id)
	var current_key := _pair_key(Array(bindings[slot_index]))
	var start := 0
	for i in range(DEFAULT_SUMMON_PAIR_SLOTS.size()):
		if _pair_key(Array(DEFAULT_SUMMON_PAIR_SLOTS[i])) == current_key:
			start = i
			break
	for offset in range(1, DEFAULT_SUMMON_PAIR_SLOTS.size() + 1):
		var candidate_index := _wrapped_index(start + direction * offset, DEFAULT_SUMMON_PAIR_SLOTS.size())
		var candidate := Array(DEFAULT_SUMMON_PAIR_SLOTS[candidate_index]).duplicate(true)
		if _pair_used_by_other(bindings, candidate, slot_index):
			continue
		bindings[slot_index] = candidate
		summon_pair_bindings[player_id] = bindings
		editor_summary_label.text = "出战槽 %d 的召唤组合键设为 %s。" % [slot_index + 1, _pair_label(candidate)] if _ui_is_zh() else "Sortie slot %d summon binding set to %s." % [slot_index + 1, _pair_label(candidate)]
		return
	editor_summary_label.text = "没有空余的攻击键组合绑定。" if _ui_is_zh() else "No free attack-pair binding remains."


func _clear_current_sortie_binding() -> void:
	var player_id := _editor_player()
	var slot_index := _binding_slot_for_current_unit()
	var bindings := _ensure_summon_pair_bindings(player_id)
	bindings[slot_index] = []
	summon_pair_bindings[player_id] = bindings
	editor_summary_label.text = "出战槽 %d 的召唤组合键已解除。" % [slot_index + 1] if _ui_is_zh() else "Sortie slot %d summon binding cleared." % [slot_index + 1]


func _valid_roster_entry(player_id: int, entry: Dictionary) -> bool:
	var role_key := String(entry.get("role", ""))
	if not ROLE_ORDER.has(role_key) or not blueprints.has(player_id):
		return false
	var roster: Array = blueprints[player_id].get(role_key, [])
	var unit_index := int(entry.get("index", -1))
	return unit_index >= 0 and unit_index < roster.size()


func _ensure_sortie_loadout(player_id: int) -> Array:
	var raw: Array = sortie_loadouts.get(player_id, [])
	var fixed: Array = []
	var seen := {}
	for item in raw:
		if not (item is Dictionary):
			continue
		var entry: Dictionary = Dictionary(item).duplicate(true)
		if not _valid_roster_entry(player_id, entry):
			continue
		var ref := _entry_ref(entry)
		if seen.has(ref):
			continue
		seen[ref] = true
		fixed.append(entry)
		if fixed.size() >= _current_sortie_cap():
			break
	sortie_loadouts[player_id] = fixed
	initial_sortie_slot[player_id] = 0 if fixed.is_empty() else clampi(int(initial_sortie_slot.get(player_id, 0)), 0, fixed.size() - 1)
	return fixed


func _sortie_position_for_entry(player_id: int, entry: Dictionary) -> int:
	if not _valid_roster_entry(player_id, entry):
		return -1
	return _sortie_position(player_id, String(entry.get("role", "")), int(entry.get("index", -1)))


func _sortie_position(player_id: int, role_key: String, unit_index: int) -> int:
	var loadout := _ensure_sortie_loadout(player_id)
	for i in range(loadout.size()):
		var entry: Dictionary = loadout[i]
		if String(entry.get("role", "")) == role_key and int(entry.get("index", -1)) == unit_index:
			return i
	return -1


func _roster_unit_total(player_id: int) -> int:
	if not blueprints.has(player_id):
		return 0
	var total := 0
	for role_key in ROLE_ORDER:
		var roster: Array = blueprints[player_id].get(role_key, [])
		total += roster.size()
	return total


func _current_roster_cap() -> int:
	return 5 if editor_match_format == "light" else ROSTER_UNIT_CAP


func _current_sortie_cap() -> int:
	return 3 if editor_match_format == "light" else SORTIE_UNIT_CAP


func _match_format_name() -> String:
	if editor_match_format == "light":
		return "轻型 5选3" if _ui_is_zh() else "LIGHT 5 PICK 3"
	return "标准 10选6" if _ui_is_zh() else "STANDARD 10 PICK 6"


func _match_format_short() -> String:
	if editor_match_format == "light":
		return "轻5/3" if _ui_is_zh() else "5/3"
	return "标准10/6" if _ui_is_zh() else "10/6"


func _role_short(role_key: String) -> String:
	var zh := {"hero": "英", "puppet": "傀", "barrier": "界"}
	var en := {"hero": "H", "puppet": "P", "barrier": "B"}
	return String((zh if _ui_is_zh() else en).get(role_key, role_key.substr(0, 1).to_upper()))


func _starter_sortie_entry(player_id: int) -> Dictionary:
	var loadout := _team_sortie_order(player_id)
	if not loadout.is_empty():
		return Dictionary(loadout[clampi(int(initial_sortie_slot.get(player_id, 0)), 0, loadout.size() - 1)]).duplicate(true)
	var role_key := String(initial_role.get(player_id, "hero"))
	return {"role": role_key, "index": int(active_roster_indices[player_id].get(role_key, 0))}


func _starter_cost_valid(player_id: int, entry: Dictionary) -> bool:
	if not _valid_roster_entry(player_id, entry):
		return false
	var stats := _ai_cached_unit_stats(player_id, String(entry.get("role", "hero")), int(entry.get("index", 0)))
	return int(stats.get("deploy_cost", stats.get("cost", 99999))) <= INITIAL_ENTRY_COST_CAP


func _ai_cached_unit_stats(player_id: int, role_key: String, unit_index: int) -> Dictionary:
	var key := "%d:%s:%d" % [player_id, role_key, unit_index]
	if ai_roster_stats_cache.has(key):
		return Dictionary(ai_roster_stats_cache[key])
	var stats := _compute_unit_stats(player_id, role_key, unit_index)
	ai_roster_stats_cache[key] = stats.duplicate(true)
	return stats


func _normalize_initial_sortie_for_cost(player_id: int) -> bool:
	var loadout := _ensure_sortie_loadout(player_id)
	if loadout.is_empty():
		return false
	var starter_index := clampi(int(initial_sortie_slot.get(player_id, 0)), 0, loadout.size() - 1)
	if _starter_cost_valid(player_id, loadout[starter_index]):
		initial_sortie_slot[player_id] = starter_index
		return true
	for i in range(loadout.size()):
		if _starter_cost_valid(player_id, loadout[i]):
			initial_sortie_slot[player_id] = i
			return true
	return false


func _prepare_ai_battle_rosters() -> void:
	for player_id in [1, 2]:
		var ai_controlled := _ai_battle_original_player_is_ai(player_id)
		var roster_empty := _roster_unit_total(player_id) <= 0
		var manual_locked := bool(ai_team_manual_lock.get(player_id, false))
		var auto_generate := (ai_controlled and not manual_locked) or (roster_empty and not manual_locked)
		if auto_generate:
			ai_team_template_choice[player_id] = "random"
		if ai_controlled or auto_generate:
			_legalize_ai_player_roster(player_id, auto_generate or roster_empty)


func _ai_battle_original_player_is_ai(player_id: int) -> bool:
	if ai_battle_seat == 3:
		return true
	return player_id == 2


func _repair_ai_battle_entry_if_needed(player_id: int, mode: String) -> Dictionary:
	var summary := _team_battle_entry_summary(player_id)
	if bool(summary.get("valid", false)):
		return summary
	if mode == MODE_AI:
		var should_repair := _ai_battle_original_player_is_ai(player_id)
		if should_repair:
			ai_team_template_choice[player_id] = "random" if not bool(ai_team_manual_lock.get(player_id, false)) else String(ai_team_template_choice.get(player_id, "teamedit_generated"))
			_legalize_ai_player_roster(player_id, true)
			summary = _team_battle_entry_summary(player_id)
	return summary


func _legalize_ai_player_roster(player_id: int, force_generate: bool = false) -> void:
	ai_roster_stats_cache.clear()
	if force_generate or not blueprints.has(player_id):
		blueprints[player_id] = _smart_ai_roster(player_id)
	_ensure_ai_roster_roles(player_id)
	_repair_ai_roster_topology(player_id)
	_ensure_ai_cheap_starter(player_id)
	_fit_ai_roster_to_rules(player_id)
	sortie_loadouts[player_id] = _build_ai_sortie_loadout(player_id)
	_normalize_initial_sortie_for_cost(player_id)
	_set_active_indices_from_loadout(player_id)
	var summary := _team_battle_entry_summary(player_id)
	if bool(summary.get("valid", false)):
		_ensure_summon_pair_bindings(player_id)
		ai_roster_stats_cache.clear()
		return
	blueprints[player_id] = _ai_teamedit_generated_roster_cached(player_id)
	ai_roster_stats_cache.clear()
	active_roster_indices[player_id] = {"hero": 0, "puppet": 0, "barrier": 0}
	initial_role[player_id] = "hero"
	_repair_ai_roster_topology(player_id)
	_ensure_ai_cheap_starter(player_id)
	_fit_ai_roster_to_rules(player_id)
	sortie_loadouts[player_id] = _build_ai_sortie_loadout(player_id)
	_normalize_initial_sortie_for_cost(player_id)
	_set_active_indices_from_loadout(player_id)
	_ensure_summon_pair_bindings(player_id)
	ai_roster_stats_cache.clear()


func _smart_ai_roster(player_id: int) -> Dictionary:
	ai_team_template_choice[player_id] = "teamedit_generated"
	return _ai_teamedit_generated_roster_cached(player_id)


func _ai_teamedit_generated_roster_cached(player_id: int) -> Dictionary:
	if ai_generated_roster_cache.has(player_id):
		return Dictionary(ai_generated_roster_cache[player_id]).duplicate(true)
	var roster := _ai_teamedit_generated_roster(player_id)
	ai_generated_roster_cache[player_id] = roster.duplicate(true)
	return roster.duplicate(true)


func _mark_teamedit_generated_roster(roster: Dictionary) -> Dictionary:
	for role_key in ROLE_ORDER:
		var role_roster: Array = Array(roster.get(role_key, [])).duplicate(true)
		for i in range(role_roster.size()):
			if not (role_roster[i] is Dictionary):
				continue
			var unit_bp: Dictionary = Dictionary(role_roster[i]).duplicate(true)
			unit_bp["generated_by_teamedit"] = true
			unit_bp["teamedit_pipeline_version"] = 2
			unit_bp["ai_shape_template"] = false
			unit_bp["archetype"] = "custom" if _role_uses_body_board(role_key) else "barrier_canvas"
			if _role_uses_body_board(role_key):
				if not unit_bp.has("custom_topology"):
					unit_bp["custom_topology"] = _default_free_canvas_topology(role_key)
				_snap_all_topology_edges(role_key, unit_bp)
			_ai_install_required_payloads(role_key, unit_bp)
			role_roster[i] = unit_bp
		roster[role_key] = role_roster
	return roster


func _ai_install_required_payloads(role_key: String, unit_bp: Dictionary) -> void:
	var payloads: Array = []
	var special_index := int(unit_bp.get("special", 0))
	payloads.append({"kind": "special", "special": special_index})
	if role_key != "barrier":
		payloads.append({"kind": "engine", "engine": clampi(int(unit_bp.get("engine", 0)), 0, maxi(0, _catalog_for(role_key, "engine").size() - 1))})
		payloads.append({"kind": "cooling", "cooling": clampi(int(unit_bp.get("cooling", 0)), 0, maxi(0, _catalog_for(role_key, "cooling").size() - 1))})
	unit_bp["slot_payloads"] = payloads


