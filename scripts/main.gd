func _saved_blueprint_has_current_topology(unit_bp: Dictionary) -> bool:
	return _saved_blueprint_current_topology_rejection_reason(unit_bp) == ""


func _saved_blueprint_current_topology_rejection_reason(unit_bp: Dictionary) -> String:
	if str(unit_bp.get("schema_version", "")) != SAVED_UNIT_SCHEMA_VERSION:
		return "blueprint schema is not %s" % SAVED_UNIT_SCHEMA_VERSION
	if String(unit_bp.get("role", "")) == "barrier" and _barrier_uses_screen_board(unit_bp):
		return ""
	if not unit_bp.has("custom_topology"):
		return "blueprint has no custom_topology"
	var topology: Dictionary = Dictionary(unit_bp.get("custom_topology", {}))
	var nodes: Array = Array(topology.get("nodes", []))
	var edges: Array = Array(topology.get("edges", []))
	if nodes.is_empty():
		return "topology has no nodes"
	if not _topology_is_canonical_component_graph(topology):
		return "topology is not a canonical component graph"
	for raw_edge in edges:
		if not (raw_edge is Dictionary):
			return "topology contains a non-dictionary edge"
		var edge: Dictionary = raw_edge
		if not (edge.has("a_socket") and edge.has("b_socket") and edge.has("a_node") and edge.has("b_node")):
			return "topology edge is missing socket fields"
	return ""


func _is_current_saved_unit_payload(payload: Dictionary) -> bool:
	return _saved_unit_payload_rejection_reason(payload) == ""


func _saved_payload_save_kind(payload: Dictionary) -> String:
	var save_kind := String(payload.get("save_kind", SAVE_KIND_SINGLE_UNIT))
	if save_kind == "":
		save_kind = SAVE_KIND_SINGLE_UNIT
	return save_kind


func _saved_unit_payload_rejection_reason(payload: Dictionary) -> String:
	if str(payload.get("schema_version", "")) != SAVED_UNIT_SCHEMA_VERSION:
		return "payload schema is not %s" % SAVED_UNIT_SCHEMA_VERSION
	var save_kind := _saved_payload_save_kind(payload)
	if save_kind == SAVE_KIND_PUPPET_GROUP:
		if String(payload.get("unit_role", "")) != "puppet":
			return "puppet group payload must use puppet role"
		var group_blueprints: Array = Array(payload.get("puppet_group_blueprints", []))
		if group_blueprints.is_empty():
			return "puppet group has no blueprints"
		for raw_bp in group_blueprints:
			if not (raw_bp is Dictionary):
				return "puppet group contains a non-dictionary blueprint"
			var member_bp: Dictionary = Dictionary(_json_restore_value(raw_bp)).duplicate(true)
			member_bp["role"] = "puppet"
			member_bp["schema_version"] = String(member_bp.get("schema_version", SAVED_UNIT_SCHEMA_VERSION))
			var member_reason := _saved_blueprint_current_topology_rejection_reason(member_bp)
			if member_reason != "":
				return "puppet group member rejected: %s" % member_reason
	elif save_kind == SAVE_KIND_SINGLE_UNIT:
		if not (payload.get("blueprint", {}) is Dictionary):
			return "payload has no blueprint"
		var unit_bp: Dictionary = Dictionary(_json_restore_value(payload.get("blueprint", {}))).duplicate(true)
		var topology_reason := _saved_blueprint_current_topology_rejection_reason(unit_bp)
		if topology_reason != "":
			return topology_reason
	else:
		return "unknown save_kind %s" % save_kind
	var legacy_path := _saved_payload_legacy_path(payload)
	if legacy_path != "":
		return "legacy drive/pointer field at %s" % legacy_path
	var combat_path := _saved_payload_nonphysical_combat_path(payload)
	if combat_path != "":
		return "legacy nonphysical combat field at %s" % combat_path
	return ""


func _is_current_saved_team_payload(payload: Dictionary) -> bool:
	if str(payload.get("schema_version", "")) != SAVED_TEAM_SCHEMA_VERSION:
		return false
	for raw_slot in Array(payload.get("slots", [])):
		if not (raw_slot is Dictionary):
			return false
		var slot: Dictionary = raw_slot
		if bool(slot.get("empty", false)):
			continue
		if not (slot.get("blueprint", {}) is Dictionary):
			return false
		var unit_bp: Dictionary = Dictionary(_json_restore_value(slot.get("blueprint", {}))).duplicate(true)
		if not _saved_blueprint_has_current_topology(unit_bp):
			return false
	if _saved_payload_has_legacy_power_fields(payload):
		return false
	if _saved_payload_has_legacy_nonphysical_combat_fields(payload):
		return false
	return true


func _purge_legacy_saved_units(force: bool = false) -> int:
	if saved_unit_legacy_purge_done and not force:
		return 0
	saved_unit_legacy_purge_done = true
	# Strict canonical rules retain rejected files so players can see and remove them explicitly.
	return 0


func _purge_legacy_saved_teams(force: bool = false) -> int:
	if saved_team_legacy_purge_done and not force:
		return 0
	saved_team_legacy_purge_done = true
	# Strict canonical rules retain rejected files; team UI may report them without auto-deleting.
	return 0


func _safe_save_stem(value: String, fallback: String) -> String:
	var source := value.strip_edges()
	if source == "":
		source = fallback
	var result := ""
	for i in range(source.length()):
		var ch := source.substr(i, 1)
		if ch.is_valid_identifier() or ch.is_valid_int() or ch in ["-", "_"]:
			result += ch
		elif ch == " ":
			result += "_"
	if result == "":
		result = fallback
	return result.substr(0, mini(result.length(), 42))


func _color_to_save_dict(color: Color) -> Dictionary:
	return {"r": color.r, "g": color.g, "b": color.b, "a": color.a}


func _color_from_save_value(value, fallback: Color) -> Color:
	if value is Dictionary:
		var dict: Dictionary = value
		return Color(float(dict.get("r", fallback.r)), float(dict.get("g", fallback.g)), float(dict.get("b", fallback.b)), float(dict.get("a", fallback.a)))
	return fallback


func _json_safe_value(value):
	if value is Vector2:
		var vector: Vector2 = value
		return {"__type": "Vector2", "x": vector.x, "y": vector.y}
	if value is Color:
		var color: Color = value
		return {"__type": "Color", "r": color.r, "g": color.g, "b": color.b, "a": color.a}
	if value is Array:
		var safe_array: Array = []
		for item in value:
			safe_array.append(_json_safe_value(item))
		return safe_array
	if value is Dictionary:
		var safe_dict := {}
		var dict: Dictionary = value
		for key in dict.keys():
			safe_dict[key] = _json_safe_value(dict[key])
		return safe_dict
	return value


func _json_restore_value(value):
	if value is Array:
		var restored_array: Array = []
		for item in value:
			restored_array.append(_json_restore_value(item))
		return restored_array
	if value is Dictionary:
		var dict: Dictionary = value
		if String(dict.get("__type", "")) == "Vector2":
			return Vector2(float(dict.get("x", 0.5)), float(dict.get("y", 0.5)))
		if String(dict.get("__type", "")) == "Color":
			return Color(float(dict.get("r", 1.0)), float(dict.get("g", 1.0)), float(dict.get("b", 1.0)), float(dict.get("a", 1.0)))
		var restored_dict := {}
		for key in dict.keys():
			restored_dict[key] = _json_restore_value(dict[key])
		return restored_dict
	return value


func _saved_unit_sanitize_strip_keys() -> Array:
	var keys: Array = []
	for key in _legacy_power_field_keys():
		if not keys.has(key):
			keys.append(key)
	for key in _unit_blueprint_validator().legacy_pointer_keys():
		if not keys.has(key):
			keys.append(key)
	return keys


func _sanitize_saved_unit_value(value):
	if value is Array:
		var sanitized_array: Array = []
		for item in Array(value):
			sanitized_array.append(_sanitize_saved_unit_value(item))
		return sanitized_array
	if value is Dictionary:
		var source: Dictionary = value
		var cleaned := source.duplicate(true)
		for key in _saved_unit_sanitize_strip_keys():
			cleaned.erase(key)
		if _saved_dict_looks_like_nonphysical_payload(cleaned):
			cleaned.erase("hp")
			cleaned.erase("max_hp")
			cleaned.erase("health")
		if _part_is_action_module(String(cleaned.get("slot_key", cleaned.get("kind", ""))), cleaned):
			for key in ACTION_MODULE_COMBAT_FIELD_KEYS:
				cleaned.erase(key)
		for key in cleaned.keys():
			cleaned[key] = _sanitize_saved_unit_value(cleaned[key])
		return cleaned
	return value


