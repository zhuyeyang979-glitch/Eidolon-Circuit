func _update_scout_ui() -> void:
	if scout_timer_label == null:
		return
	_layout_scout_roster_columns()
	if pending_battle_mode == MODE_TRAINING:
		_set_named_label(scout_layer, "ScoutTitle", "训练配置" if _ui_is_zh() else "TRAINING CONFIG")
		_set_named_label(scout_layer, "ScoutStartButton", "开始训练" if _ui_is_zh() else "START TRAINING")
		_set_named_label(scout_layer, "ScoutDetailTitle", "训练验证报告" if _ui_is_zh() else "TRAINING VALIDATION")
		scout_timer_label.text = "选择席位/靶机设置后开始" if _ui_is_zh() else "CHOOSE SEAT / DUMMY SETUP"
	else:
		_set_named_label(scout_layer, "ScoutTitle", "赛前侦查" if _ui_is_zh() else "MATCHUP SCOUT")
		_set_named_label(scout_layer, "ScoutStartButton", "立即开始" if _ui_is_zh() else "START NOW")
		_set_named_label(scout_layer, "ScoutDetailTitle", "所选单位详情" if _ui_is_zh() else "SELECTED UNIT DETAIL")
		scout_timer_label.text = ("%s  选出战后开始" if _ui_is_zh() else "%s  PICK THEN START") % _match_format_short()
	_update_training_dummy_radius_ui()
	var seat_visible := pending_battle_mode in [MODE_AI, MODE_TRAINING, MODE_PVP]
	if scout_seat_label != null:
		scout_seat_label.text = "席位/视角" if _ui_is_zh() else "SEAT / VIEW"
		scout_seat_label.visible = seat_visible
	for i in range(scout_seat_buttons.size()):
		var seat_button: Button = scout_seat_buttons[i]
		seat_button.visible = seat_visible
		seat_button.disabled = not seat_visible
		var seat_index := i + 1
		var seat_is_selected := seat_visible and ai_battle_seat == seat_index and (pending_battle_mode != MODE_TRAINING or training_seat_confirmed)
		seat_button.modulate = Color(0.35, 0.95, 1.0, 1.0) if seat_is_selected else Color(0.86, 0.9, 0.94, 1.0)
	if scout_color_label != null:
		scout_color_label.text = "P%d 颜色  %s" % [scout_sortie_player_id, _team_color_name(scout_sortie_player_id)]
	_set_named_label(scout_layer, "ScoutEnemyTitle", ("P%d 队伍" if _ui_is_zh() else "P%d ROSTER") % _scout_opponent_player_id())
	_set_named_label(scout_layer, "ScoutPlayerTitle", ("P%d 出战" if _ui_is_zh() else "P%d SORTIE") % scout_sortie_player_id)
	for i in range(scout_color_buttons.size()):
		var color_button: Button = scout_color_buttons[i]
		if i >= TEAM_COLOR_PRESETS.size():
			color_button.visible = false
			color_button.disabled = true
			continue
		color_button.visible = true
		color_button.disabled = false
		var preset: Dictionary = TEAM_COLOR_PRESETS[i]
		var primary: Color = preset.get("primary", Color.WHITE)
		var accent: Color = preset.get("accent", Color.WHITE)
		var selected := _team_color_index(scout_sortie_player_id) == i
		color_button.text = "选中" if selected else ""
		color_button.modulate = primary.lerp(accent, 0.22 if selected else 0.0)
	for button in scout_ai_team_buttons:
		var ai_button: Button = button
		var visible_ai_tools := pending_battle_mode == MODE_AI
		ai_button.visible = visible_ai_tools
		ai_button.disabled = not visible_ai_tools
		if not visible_ai_tools:
			continue
		var player_id := int(ai_button.get_meta("player_id", 1))
		var mode := String(ai_button.get_meta("mode", "random"))
		var template_label := _ai_template_label(String(ai_team_template_choice.get(player_id, "teamedit_generated")))
		if mode == "cycle":
			ai_button.text = "P%d模板" % player_id if _ui_is_zh() else "P%d TPL" % player_id
		elif mode == "edit":
			ai_button.text = "编辑P%d" % player_id if _ui_is_zh() else "P%d EDIT" % player_id
		else:
			ai_button.text = "P%d自动" % player_id if _ui_is_zh() else "P%d AUTO" % player_id
		var locked := bool(ai_team_manual_lock.get(player_id, false))
		ai_button.modulate = Color(1.0, 0.86, 0.3, 1.0) if locked else Color(0.35, 0.95, 1.0, 1.0)
	var opponent_player_id := _scout_opponent_player_id()
	var enemy_order := _all_roster_order(opponent_player_id)
	var selected_ref := _entry_ref(scout_selected_entry)
	for i in range(scout_opponent_buttons.size()):
		var button: Button = scout_opponent_buttons[i]
		var thumb: SortieThumbView = scout_opponent_thumb_views[i] if i < scout_opponent_thumb_views.size() else null
		var visible_item := i < enemy_order.size()
		button.visible = visible_item
		button.disabled = not visible_item
		if thumb != null:
			thumb.visible = visible_item
		if not visible_item:
			button.text = ""
			if thumb != null:
				thumb.set_entry(opponent_player_id, i, {}, {}, "reserve", ui_language)
			continue
		var entry: Dictionary = enemy_order[i]
		var role_key := String(entry.get("role", "hero"))
		var unit_index := int(entry.get("index", 0))
		var stats := _compute_unit_stats(opponent_player_id, role_key, unit_index)
		var marker := "> " if _entry_ref(entry) == selected_ref and scout_selected_player_id == opponent_player_id else "  "
		var opponent_pos := _sortie_position_for_entry(opponent_player_id, entry)
		var opponent_slot := "出%d" % [opponent_pos + 1] if opponent_pos >= 0 else "候"
		button.text = "%s%s P%d %02d %s#%d  ¥%d" % [marker, opponent_slot, opponent_player_id, i + 1, _role_short(role_key), unit_index + 1, int(stats.get("cost", 0))] if _ui_is_zh() else "%s%s P%d %02d %s#%d  $%d" % [marker, opponent_slot, opponent_player_id, i + 1, _role_short(role_key), unit_index + 1, int(stats.get("cost", 0))]
		if thumb != null:
			thumb.set_entry(opponent_player_id, i, entry, stats, "pending" if opponent_pos >= 0 else "reserve", ui_language)
	if enemy_order.is_empty():
		if scout_detail_view != null:
			if pending_battle_mode == MODE_TRAINING:
				scout_detail_view.clear(_training_validation_report_text())
			else:
				scout_detail_view.clear("没有对手队伍数据。" if _ui_is_zh() else "No opponent roster data.")
		return
	if not _valid_roster_entry(scout_selected_player_id, scout_selected_entry):
		scout_selected_player_id = opponent_player_id
		scout_selected_entry = Dictionary(enemy_order[0]).duplicate(true)
	if scout_detail_view != null:
		if pending_battle_mode == MODE_TRAINING:
			scout_detail_view.clear(_training_validation_report_text())
		else:
			var detail_role := String(scout_selected_entry.get("role", "hero"))
			var detail_index := int(scout_selected_entry.get("index", 0))
			var detail_stats := _compute_unit_stats(scout_selected_player_id, detail_role, detail_index)
			scout_detail_view.set_unit(scout_selected_player_id, scout_selected_entry, detail_stats, _scout_unit_detail(scout_selected_player_id, scout_selected_entry), ui_language)
	for i in range(scout_sortie_side_buttons.size()):
		var side_button: Button = scout_sortie_side_buttons[i]
		var side := i + 1
		side_button.modulate = Color(0.35, 0.95, 1.0, 1.0) if scout_sortie_player_id == side else Color(0.86, 0.9, 0.94, 1.0)
	scout_player_label.text = _scout_sortie_control_text(scout_sortie_player_id)
	var player_order := _all_roster_order(scout_sortie_player_id)
	var starter_entry := _starter_sortie_entry(scout_sortie_player_id)
	for i in range(scout_player_buttons.size()):
		var player_button: Button = scout_player_buttons[i]
		var player_thumb: SortieThumbView = scout_player_thumb_views[i] if i < scout_player_thumb_views.size() else null
		var visible_player_item := i < player_order.size()
		player_button.visible = visible_player_item
		player_button.disabled = not visible_player_item
		if player_thumb != null:
			player_thumb.visible = visible_player_item
		if not visible_player_item:
			player_button.text = ""
			if player_thumb != null:
				player_thumb.set_entry(scout_sortie_player_id, i, {}, {}, "reserve", ui_language)
			continue
		var entry: Dictionary = player_order[i]
		var role_key := String(entry.get("role", "hero"))
		var unit_index := int(entry.get("index", 0))
		var stats := _compute_unit_stats(scout_sortie_player_id, role_key, unit_index)
		var pos := _sortie_position_for_entry(scout_sortie_player_id, entry)
		var starter := _entry_ref(entry) == _entry_ref(starter_entry)
		var slot_text := "R"
		if pos >= 0:
			slot_text = "出%d%s" % [pos + 1, "*" if starter else ""]
		var starter_warning := "!" if int(stats.get("deploy_cost", stats.get("cost", 0))) > INITIAL_ENTRY_COST_CAP else ""
		var selected_marker := ">" if _entry_ref(entry) == selected_ref and scout_selected_player_id == scout_sortie_player_id else " "
		player_button.text = "%s%s P%d %02d %s#%d%s  ¥%d" % [selected_marker, slot_text, scout_sortie_player_id, i + 1, _role_short(role_key), unit_index + 1, starter_warning, int(stats.get("cost", 0))] if _ui_is_zh() else "%s%s P%d %02d %s#%d%s  $%d" % [selected_marker, slot_text, scout_sortie_player_id, i + 1, _role_short(role_key), unit_index + 1, starter_warning, int(stats.get("cost", 0))]
		if player_thumb != null:
			var thumb_status := "pending" if pos >= 0 else "reserve"
			player_thumb.set_entry(scout_sortie_player_id, i, entry, stats, thumb_status, ui_language)


func _compact_roster_public_list(player_id: int, max_items: int) -> String:
	var order := _all_roster_order(player_id)
	var lines: Array = []
	var limit := mini(order.size(), max_items)
	for i in range(limit):
		var entry: Dictionary = order[i]
		var role_key := String(entry.get("role", "hero"))
		var unit_index := int(entry.get("index", 0))
		var stats := _compute_unit_stats(player_id, role_key, unit_index)
		lines.append("%02d %s#%d %s 造价%d 入场%d" % [i + 1, _role_name(role_key), unit_index + 1, _short_part_name(String(stats.get("name", ""))), int(stats.get("cost", 0)), int(stats.get("deploy_cost", 0))])
	if order.size() > limit:
		lines.append("+%d 个预备单位" % [order.size() - limit])
	return "\n".join(lines)


func _scout_sortie_control_text(player_id: int) -> String:
	var loadout := _team_sortie_order(player_id)
	var summary := _team_summary(player_id)
	var starter := _starter_sortie_entry(player_id)
	var ok_text := "OK" if bool(summary.get("initial_valid", false)) else "!"
	return "出 %d/%d  首 %s  %s" % [loadout.size(), _current_sortie_cap(), _role_short(String(starter.get("role", "hero"))), ok_text] if _ui_is_zh() else "OUT %d/%d  START %s  %s" % [loadout.size(), _current_sortie_cap(), _role_short(String(starter.get("role", "hero"))), ok_text]


func _barrier_terrain_scout_preview_lines(unit_bp: Dictionary, context: Dictionary = {}) -> Array:
	if String(unit_bp.get("role", "barrier")) != "barrier":
		return []
	var source_tiles: Array = Array(unit_bp.get("barrier_tiles", []))
	if source_tiles.is_empty():
		return []
	var preview: Dictionary = _barrier_terrain_editor_preview(unit_bp, context)
	var tiles: Array = Array(preview.get("tiles", []))
	if tiles.is_empty():
		return []
	var outcome_counts := {}
	for raw_tile in tiles:
		if not (raw_tile is Dictionary):
			continue
		var tile_preview: Dictionary = Dictionary(raw_tile)
		var placement: Dictionary = Dictionary(tile_preview.get("placement", {}))
		var outcome := String(placement.get("outcome", "free"))
		if outcome == "":
			outcome = "free"
		outcome_counts[outcome] = int(outcome_counts.get(outcome, 0)) + 1
	var ordered_outcomes := ["attach", "bridge", "reinforce", "breach", "portal", "mechanism", "overlap", "replace", "blocked", "free"]
	var count_bits: Array = []
	for outcome in ordered_outcomes:
		var count := int(outcome_counts.get(outcome, 0))
		if count > 0:
			count_bits.append("%s %d" % [outcome, count])
	if count_bits.is_empty():
		count_bits.append("free 0")
	var lines: Array = []
	var arena_id := String(preview.get("arena_id", ""))
	if arena_id == "":
		arena_id = "unknown_arena"
	lines.append("地形预览：%s / %d块 / %s" % [arena_id, tiles.size(), "，".join(count_bits)] if _ui_is_zh() else "TERRAIN PREVIEW: %s / %d tiles / %s" % [arena_id, tiles.size(), ", ".join(count_bits)])
	var limit := mini(tiles.size(), 4)
	for i in range(limit):
		if not (tiles[i] is Dictionary):
			continue
		var tile_preview: Dictionary = Dictionary(tiles[i])
		var placement: Dictionary = Dictionary(tile_preview.get("placement", {}))
		var outcome := String(placement.get("outcome", "free"))
		if outcome == "":
			outcome = "free"
		var feature_id := String(placement.get("feature_id", ""))
		if feature_id == "":
			feature_id = "-"
		var terrain_kind := String(placement.get("terrain_kind", ""))
		if terrain_kind == "":
			terrain_kind = "-"
		var actions: Array = []
		for raw_intent in Array(tile_preview.get("deployment_intents", [])):
			if raw_intent is Dictionary:
				var intent: Dictionary = Dictionary(raw_intent)
				var action := String(intent.get("action", ""))
				if action != "":
					actions.append(action)
		var action_text := "+".join(actions) if not actions.is_empty() else "no_deployment_intent"
		lines.append("  T%02d %s %s %s / %s" % [int(tile_preview.get("tile_index", i)), outcome, terrain_kind, feature_id, action_text])
	if tiles.size() > limit:
		lines.append("  +%d terrain preview tiles" % [tiles.size() - limit])
	return lines


func _scout_unit_detail(player_id: int, entry: Dictionary) -> String:
	var role_key := String(entry.get("role", "hero"))
	var unit_index := int(entry.get("index", 0))
	var unit_bp := _blueprint_for(player_id, role_key, unit_index)
	var stats := _compute_unit_stats(player_id, role_key, unit_index)
	var lines: Array = []
	lines.append("%s #%d  %s" % [_role_name(role_key), unit_index + 1, String(stats.get("name", ""))])
	lines.append("造价 %d  入场 %d  等待 %.1f秒" % [int(stats.get("cost", 0)), int(stats.get("deploy_cost", 0)), float(stats.get("deploy_wait", DEPLOY_WAIT_SECONDS))])
	lines.append("生命 %d  质量 %.0f  长度 %.2f  半径 %.2f  信息安全 %.2f" % [int(stats.get("health", 0)), float(stats.get("mass", 0.0)), float(stats.get("length", 0.0)), float(stats.get("radius", 0.0)), float(stats.get("data_security", 1.0))])
	if String(stats.get("electronic_armor_note", "")) != "":
		lines.append(String(stats.get("electronic_armor_note", "")))
	if role_key == "hero":
		lines.append("速度 %.2f  加速 %.2f  转向 %.2f  散热/秒 %.1f  热池 %.0f  常热负载 %.1f" % [float(stats.get("speed", 0.0)), float(stats.get("acceleration", 0.0)), float(stats.get("turn_speed", 0.0)), float(stats.get("cooling", 0.0)), float(stats.get("heat_capacity", 0.0)), float(stats.get("idle_heat_load", 0.0))])
		if String(stats.get("soul_heat_note", "")) != "":
			lines.append(String(stats.get("soul_heat_note", "")))
		lines.append("热力：常热负载只做构筑压力；Boost、背刺、结界热场和强力动作会产生事件热。")
	else:
		lines.append("速度 %.2f  加速 %.2f  转向 %.2f  散热 %.1f  无热力槽" % [float(stats.get("speed", 0.0)), float(stats.get("acceleration", 0.0)), float(stats.get("turn_speed", 0.0)), float(stats.get("cooling", 0.0))])
	lines.append("伤害 %s  普通/正面护甲/背面激活 %d/%d/%d  距离 %.2f/%.2f/%.2f" % [
		_damage_name(String(stats.get("damage_type", "blunt"))),
		int(stats.get("normal_damage", 0)),
		int(stats.get("armor_damage", 0)),
		int(stats.get("active_damage", 0)),
		float(stats.get("normal_range", 0.0)),
		float(stats.get("armor_range", 0.0)),
		float(stats.get("active_range", 0.0)),
	])
	var resistance = stats.get("resistances", {})
	lines.append("近战承伤倍率  钝/刺/斩 %.2f/%.2f/%.2f" % [
		float(resistance.get("blunt", 1.0)),
		float(resistance.get("pierce", 1.0)),
		float(resistance.get("tear", 1.0)),
	])
	var tiers = stats.get("counter_tiers", {})
	lines.append("近战克制等级  钝/刺/斩 %d/%d/%d" % [
		int(tiers.get("blunt", 0)),
		int(tiers.get("pierce", 0)),
		int(tiers.get("tear", 0)),
	])
	lines.append("投射物：不再有抗性数值；子弹/化学/激光通过弹药、轨迹、射程、后座、热力和命中特效区分。")
	var ammo = stats.get("ammo_capacity", {})
	if int(ammo.get("bullet", 0)) + int(ammo.get("laser", 0)) + int(ammo.get("chemical", 0)) + int(ammo.get("explosive", 0)) + int(ammo.get("web", 0)) > 0:
		lines.append("弹药 子弹/激光/化学/炸药/蛛丝 %d/%d/%d/%d/%d" % [
			int(ammo.get("bullet", 0)),
			int(ammo.get("laser", 0)),
			int(ammo.get("chemical", 0)),
			int(ammo.get("explosive", 0)),
			int(ammo.get("web", 0)),
		])
	for note_key in ["soul_note", "pirate_note", "slot_payload_note", "ammo_note", "power_note", "thermal_note", "joint_momentum_note", "momentum_note", "stiffness_note"]:
		var note_text := String(stats.get(note_key, ""))
		if note_text != "":
			lines.append(note_text)
	var manufacturer := _manufacturer_rule_note(stats)
	if manufacturer != "":
		lines.append(manufacturer)

	var special_lines: Array = []
	if role_key == "puppet":
		special_lines.append("SOURCE: %d bodies / routine %s / conditions %d / sequence limit %d" % [int(stats.get("group_count", 1)), String(stats.get("ai", "direct")), int(stats.get("condition_slots", 1)), int(stats.get("module_sequence_limit", 1))])
		special_lines.append("SOURCE GROUP: every spawned puppet body carries this same source-code action module")
		if String(stats.get("source_target_policy", "")) != "" or String(stats.get("source_attack_preference", "")) != "":
			special_lines.append("SOURCE LOGIC: target %s / attack %s / close %s / keep %.2f" % [
				String(stats.get("source_target_policy", "nearest")),
				String(stats.get("source_attack_preference", "default")),
				String(stats.get("source_close_response", "default")),
				float(stats.get("source_keep_range", stats.get("hold_range", 0.0))),
			])
		var source_rules: Dictionary = stats.get("source_rules", {})
		for condition_key in SOURCE_CONDITION_ORDER:
			if not source_rules.has(condition_key):
				continue
			var rule: Dictionary = source_rules.get(condition_key, {})
			var module_labels: Array = []
			for module_id in Array(rule.get("modules", [])):
				module_labels.append("M%d" % (int(module_id) + 1))
			special_lines.append("  %s -> %s / %s / %s" % [condition_key, String(rule.get("move", "hold")), ",".join(module_labels), ",".join(Array(rule.get("states", [])))])
	if role_key == "barrier" or int(stats.get("material_slots", 0)) > 0 or float(stats.get("space_size", 0.0)) > 0.0:
		special_lines.append("以太空间：槽位 %d / 尺寸 %.2f / 逻辑 %s / 断开组件 %s" % [int(stats.get("material_slots", 0)), float(stats.get("space_size", 0.0)), _zh_part_name(String(stats.get("barrier_logic", "")).to_upper()), "是" if bool(stats.get("barrier_disconnected", false)) else "否"] if _ui_is_zh() else "ETHER SPACE: slots %d / size %.2f / logic %s / disconnected %s" % [int(stats.get("material_slots", 0)), float(stats.get("space_size", 0.0)), String(stats.get("barrier_logic", "")), str(bool(stats.get("barrier_disconnected", false)))])
		if int(stats.get("ether_count", 0)) > 0:
			special_lines.append("以太组：%d/%d 个以太 / 绑定半径 %.1fm / 类型 %s" % [
				int(stats.get("ether_count", 0)),
				int(stats.get("ether_group_capacity", 1)),
				float(stats.get("ether_bind_radius_m", 0.0)),
				_zh_part_name(String(stats.get("ether_group_kind", "single_space")).to_upper()),
			] if _ui_is_zh() else "ETHER GROUP: %d/%d ethers / bind %.1fm / kind %s" % [
				int(stats.get("ether_count", 0)),
				int(stats.get("ether_group_capacity", 1)),
				float(stats.get("ether_bind_radius_m", 0.0)),
				String(stats.get("ether_group_kind", "single_space")),
			])
		if bool(stats.get("is_gravity_field", false)):
			var gravity_effects: Array = Array(stats.get("ether_effects", []))
			if gravity_effects.size() > 1:
				var directions := PackedStringArray()
				var max_radius := 0.0
				var total_force := 0.0
				for raw_effect in gravity_effects:
					if raw_effect is Dictionary:
						var effect: Dictionary = raw_effect
						directions.append(String(effect.get("direction", "forward")))
						max_radius = maxf(max_radius, float(effect.get("radius", 0.0)))
						total_force += float(effect.get("force", 0.0))
				special_lines.append("方向重力 VECTOR GRAVITY: dirs %s / effects %d / max radius %.2f / total force %.2f" % [
					"/".join(directions),
					gravity_effects.size(),
					max_radius,
					total_force,
				])
			else:
				special_lines.append("方向重力 VECTOR GRAVITY: dir %s / radius %.2f / force %.2f" % [
					String(stats.get("gravity_direction", "forward")),
					float(stats.get("gravity_radius", 0.0)),
					float(stats.get("gravity_force", 0.0)),
				])
		if Array(stats.get("barrier_map_tiles", [])).size() > 0:
			special_lines.append("BARRIER BLUEPRINT: %d separated tiles on %dx%d screen grid; max footprint %.1fx%.1f, unit HP is shared" % [Array(stats.get("barrier_map_tiles", [])).size(), int(stats.get("barrier_map_columns", BARRIER_MAP_COLUMNS)), int(stats.get("barrier_map_rows", BARRIER_MAP_ROWS)), float(stats.get("barrier_map_width", BARRIER_BLUEPRINT_WIDTH)), float(stats.get("barrier_map_height", BARRIER_BLUEPRINT_HEIGHT))])
			special_lines.append_array(_barrier_terrain_scout_preview_lines(unit_bp))
	if bool(stats.get("projectile", false)) or String(stats.get("projectile_style", "")) != "":
		var projectile_behavior := String(stats.get("projectile_behavior", ""))
		var projectile_note := ""
		var projectile_event := stats.duplicate(true)
		projectile_event["projectile"] = true
		var projectile_speed := _projectile_collision_speed_for_event(projectile_event)
		var projectile_mass := _projectile_mass_for_event(projectile_event, projectile_speed)
		var projectile_momentum := _projectile_momentum_for_event(projectile_event)
		var gun_kind := String(stats.get("gun_kind", ""))
		var ammo_kind := String(stats.get("ammo_kind", ""))
		if gun_kind != "" or ammo_kind != "":
			projectile_note += " / GUN %s / AMMO %s" % [gun_kind.to_upper(), ammo_kind.to_upper()]
		if projectile_behavior == "true_bullet":
			projectile_note += " / lock %.2fs" % float(stats.get("sniper_fire_delay", stats.get("bullet_lock_time", TRUE_BULLET_DEFAULT_LOCK_SECONDS)))
		elif projectile_behavior == "bullet_hell":
			projectile_note += " / speed x%.1f" % float(stats.get("projectile_speed_mult", BULLET_HELL_DEFAULT_SPEED_MULT))
		elif projectile_behavior == "explosive":
			projectile_note += " / blast %.2f / ammo %s" % [float(stats.get("explosion_radius", 0.0)), ammo_kind if ammo_kind != "" else "explosive"]
		if projectile_momentum > 0.0:
			projectile_note += " / P-MASS %.2f / V %.1f / P-MOM %.0f / RECOIL-MOM %.0f" % [projectile_mass, projectile_speed, projectile_momentum, projectile_momentum]
		special_lines.append("PROJECTILE: %s %s / range %.2f / path %s%s" % [String(stats.get("projectile_style", "shot")), projectile_behavior.to_upper(), float(stats.get("projectile_range", 0.0)), String(stats.get("travel_path", "straight")), projectile_note])
	if bool(stats.get("is_homing_launcher", false)):
		special_lines.append("HOMING: radius %.2f / interval %.2f / accuracy %.2f / dmg %d %s" % [float(stats.get("homing_radius", 0.0)), float(stats.get("homing_interval", 0.0)), float(stats.get("homing_accuracy", 0.0)), int(stats.get("homing_damage", 0)), _damage_name(String(stats.get("homing_damage_type", "bullet")))])
	if bool(stats.get("is_trap_field", false)):
		special_lines.append("TRAP: %s command %s radius %.2f power %.2f affects %s" % [String(stats.get("trap_effect", "")), String(stats.get("trap_command", "")), float(stats.get("trap_radius", 0.0)), float(stats.get("trap_power", 0.0)), String(stats.get("trap_affects", "enemy"))])
	if bool(stats.get("is_support_node", false)):
		special_lines.append("SUPPORT: %s radius %.2f rate %.2f amount %d affects %s" % [String(stats.get("support_kind", "")), float(stats.get("support_radius", 0.0)), float(stats.get("support_rate", 0.0)), int(stats.get("support_amount", 0)), String(stats.get("support_affects", "ally"))])
	if bool(stats.get("is_speed_lane", false)):
		special_lines.append("SPEED LANE: radius %.2f width %.2f x%.2f pull %.2f affects %s" % [float(stats.get("speed_lane_radius", 0.0)), float(stats.get("speed_lane_width", 0.0)), float(stats.get("speed_lane_mult", 1.0)), float(stats.get("speed_lane_pull", 0.0)), String(stats.get("speed_lane_affects", "all"))])
	if bool(stats.get("is_coin_generator", false)):
		special_lines.append("COIN NODE: interval %.1fs value %d pickup %.2f" % [float(stats.get("coin_interval", 0.0)), int(stats.get("coin_value", 0)), float(stats.get("coin_pickup_radius", 0.0))])
	if bool(stats.get("is_one_way_shield", false)):
		special_lines.append("ONE-WAY SHIELD: radius %.2f pass %s block x%.2f affects %s" % [float(stats.get("shield_radius", 0.0)), String(stats.get("shield_pass_mode", "directional")), float(stats.get("shield_block_damage_mult", 1.0)), String(stats.get("shield_affects", "enemy"))])
	if bool(stats.get("reflect_projectiles", false)):
		special_lines.append("REFLECTOR: %s power %.2f bonus %.2f affects %s" % [",".join(Array(stats.get("reflect_types", []))), float(stats.get("reflect_power", 0.0)), float(stats.get("reflect_bonus_range", 0.0)), String(stats.get("reflect_affects", "ally"))])
	if bool(stats.get("is_signal_jammer", false)):
		special_lines.append("JAMMER: radius %.2f charge %.1fs duration %.1fs affects %s" % [float(stats.get("jam_radius", 0.0)), float(stats.get("jam_seconds", 0.0)), float(stats.get("jam_duration", 0.0)), String(stats.get("jam_affects", "enemy"))])
	if bool(stats.get("is_hack_field", false)) or bool(stats.get("takeover_on_hit", false)):
		special_lines.append("TAKEOVER: field %.2f / hit %s / seconds %.1f / power %.2f" % [float(stats.get("hack_radius", 0.0)), str(bool(stats.get("takeover_on_hit", false))), float(stats.get("takeover_seconds", 0.0)), float(stats.get("takeover_power", 1.0))])
	if bool(stats.get("is_barrage_emitter", false)):
		special_lines.append("BARRAGE: %s every %.2fs / dmg %d %s / range %.2f" % [String(stats.get("barrage_mode", "")), float(stats.get("barrage_interval", 0.0)), int(stats.get("barrage_damage", 0)), _damage_name(String(stats.get("barrage_damage_type", "bullet"))), float(stats.get("barrage_range", 0.0))])
	if int(stats.get("explosion_damage", 0)) > 0:
		special_lines.append("EXPLOSION: radius %.2f / dmg %d %s / style %s" % [float(stats.get("explosion_radius", 0.0)), int(stats.get("explosion_damage", 0)), _damage_name(String(stats.get("explosion_damage_type", "blunt"))), String(stats.get("explosion_style", ""))])
	if int(stats.get("entry_breach_damage", 0)) > 0:
		special_lines.append("ENTRY BREACH: dmg %d %s / self heat %.0f" % [int(stats.get("entry_breach_damage", 0)), _damage_name(String(stats.get("entry_breach_damage_type", "blunt"))), float(stats.get("entry_breach_self_heat", 0.0))])
	if special_lines.size() > 0:
		lines.append("\nSPECIAL LOGIC")
		lines.append("\n".join(special_lines))

	lines.append("\nBUILD SLOTS")
	var part_lines: Array = []
	for slot_key in BUILD_SLOTS:
		var part := _selected_component(role_key, slot_key, int(unit_bp.get(slot_key, 0)))
		part_lines.append("%s: %s  cost %d  maker %s" % [_slot_name(slot_key), _short_part_display_name(part), int(part.get("cost", 0)), _manufacturer_for_part(part, slot_key)])
	lines.append("\n".join(part_lines))

	if unit_bp.has("custom_topology"):
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		var nodes: Array = topology.get("nodes", [])
		lines.append("\nCUSTOM TOPOLOGY")
		lines.append(_module_material_rule_note(unit_bp))
		if _role_uses_body_board(role_key):
			lines.append(_action_module_rule_note(unit_bp, role_key))
		lines.append(_topology_rule_note(unit_bp, role_key, stats))
		for i in range(nodes.size()):
			var node: Dictionary = nodes[i]
			if _topology_node_is_component(node):
				var slot_key := _topology_node_slot(node)
				var part := _topology_node_part(role_key, node, unit_bp)
				var module_names_component: Array = []
				for node_module_component in _module_parts_for_topology_node(role_key, node, unit_bp):
					module_names_component.append(_short_part_name(String(node_module_component.get("name", ""))))
				var pos_component: Vector2 = node.get("pos", Vector2(0.5, 0.5))
				lines.append("N%02d %s %.2f,%.2f  %s  L%.2f  ends %d  MOD x%d %s" % [i + 1, String(node.get("label", "NODE")), pos_component.x, pos_component.y, _slot_name(slot_key), float(part.get("length", 0.0)), int(part.get("connection_ends", 0)), module_names_component.size(), ", ".join(module_names_component)])
				continue
			var node_joint := _selected_component(role_key, "joint", int(node.get("joint", unit_bp.get("joint", 0))))
			var node_limb := _selected_component(role_key, "limb_muscle", int(node.get("limb_muscle", unit_bp.get("limb_muscle", 0))))
			var node_muscle := _selected_component(role_key, "muscle", int(node.get("muscle", unit_bp.get("muscle", 0))))
			var module_names: Array = []
			for node_module in _module_parts_for_topology_node(role_key, node, unit_bp):
				module_names.append(_short_part_name(String(node_module.get("name", ""))))
			var pos: Vector2 = node.get("pos", Vector2(0.5, 0.5))
			lines.append("N%02d %s %.2f,%.2f  L%.2f  %s / %s / %s / MOD x%d %s" % [i + 1, String(node.get("label", "NODE")), pos.x, pos.y, float(node_joint.get("length", 0.0)) + float(node_limb.get("length", 0.0)) + float(node_muscle.get("length", 0.0)), _short_part_name(String(node_joint.get("name", ""))), _short_part_name(String(node_limb.get("name", ""))), _short_part_name(String(node_muscle.get("name", ""))), module_names.size(), ", ".join(module_names)])
	return "\n".join(lines)


func _update_editor_ui(force_now: bool = false) -> void:
	var update_start_usec := Time.get_ticks_usec()
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("teamedit.update_ui")
	var current_frame := Engine.get_process_frames()
	var ui_state_signature := "%s|%s|%d|%d|%s|%s|%d|%d|%d|%s|%d|%s|%d|%s|%s" % [
		editor_panel_mode,
		editor_load_mode,
		editor_role_index,
		editor_slot_index,
		editor_part_group_mode,
		editor_part_filter_mode,
		editor_catalog_page,
		editor_load_page,
		editor_topology_node_index,
		editor_board_tool,
		editor_pending_orientation_node_index,
		ui_language,
		editor_assembly_guide_step_index,
		String(editor_connection_evaluation.get("state", "")),
		String(editor_connection_evaluation.get("topology_signature", "")),
	]
	if not force_now and editor_update_ui_last_frame == current_frame and ui_state_signature == editor_update_ui_last_state_signature:
		editor_update_ui_deferred_count += 1
		mark_editor_dirty(EDITOR_DIRTY_DASHBOARD | EDITOR_DIRTY_HOVER | EDITOR_DIRTY_ACTION_BUTTONS)
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("teamedit.update_ui")
		return
	editor_update_ui_last_frame = current_frame
	editor_update_ui_last_state_signature = ui_state_signature
	editor_update_ui_deferred = false
	editor_update_ui_count += 1
	editor_full_update_request_count += 1
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	if not blueprints.has(player_id):
		blueprints[player_id] = _blank_player_roster()
	var roster: Array = Array(blueprints[player_id].get(role_key, []))
	if _editor_is_blank_work_canvas() and editor_working_role_key != role_key:
		_reset_editor_working_canvas(role_key)
	if not _editor_is_blank_work_canvas() and roster.is_empty():
		_reset_editor_working_canvas(role_key)
	editor_unit_indices[role_key] = clampi(int(editor_unit_indices[role_key]), 0, maxi(0, roster.size() - 1))
	if not _editor_is_blank_work_canvas():
		active_roster_indices[player_id][role_key] = int(editor_unit_indices[role_key])
	var unit_bp: Dictionary = _editor_current_blueprint()
	for current_role in ROLE_ORDER:
		var role_roster: Array = Array(blueprints[player_id].get(current_role, []))
		var marker := "> " if current_role == role_key else "  "
		var current_count := role_roster.size()
		var display_index := 0 if current_count <= 0 else int(editor_unit_indices[current_role]) + 1
		_set_control_text_if_changed(editor_role_labels[current_role], "%s%s %d/%d" % [marker, _role_name(current_role), display_index, current_count])
		_set_canvas_item_modulate_if_changed(editor_role_labels[current_role], Color(0.35, 0.95, 1.0, 1.0) if current_role == role_key else Color(0.84, 0.88, 0.92, 1.0))
	for i in range(BUILD_SLOTS.size()):
		var slot_key: String = BUILD_SLOTS[i]
		var part := _selected_component(role_key, slot_key, int(unit_bp.get(slot_key, 0)))
		var marker := "> " if i == editor_slot_index else "  "
		_set_control_text_if_changed(editor_slot_labels[i], "%s%s  %s  [%d]" % [marker, _slot_name(slot_key), _short_part_name(String(part["name"])), int(part["cost"])])
		_set_canvas_item_modulate_if_changed(editor_slot_labels[i], Color(1.0, 0.88, 0.32, 1.0) if i == editor_slot_index else Color(0.9, 0.94, 0.98, 1.0))

	var summary := _team_summary(player_id)
	var stats := _editor_current_stats()
	var module_rule_note := _module_material_rule_note(unit_bp) if _role_uses_body_board(role_key) else ""
	var selected_slot_key: String = BUILD_SLOTS[editor_slot_index]
	var selected_component_index := int(unit_bp.get(selected_slot_key, 0))
	if _role_uses_body_board(role_key) and unit_bp.has("custom_topology") and not (role_key == "barrier" and _barrier_uses_screen_board(unit_bp)) and _is_body_group_slot(selected_slot_key):
		var topology_for_selection: Dictionary = unit_bp.get("custom_topology", {})
		var nodes_for_selection: Array = topology_for_selection.get("nodes", [])
		if not nodes_for_selection.is_empty():
			editor_topology_node_index = clampi(editor_topology_node_index, 0, nodes_for_selection.size() - 1)
			var selected_node_bp: Dictionary = nodes_for_selection[editor_topology_node_index]
			if _topology_node_is_component(selected_node_bp):
				if _topology_node_slot(selected_node_bp) == selected_slot_key:
					selected_component_index = _topology_node_part_index(selected_node_bp, unit_bp)
				elif _has_pending_canvas_part() and editor_pending_place_slot == selected_slot_key:
					selected_component_index = editor_pending_place_index
			else:
				selected_component_index = int(selected_node_bp.get(selected_slot_key, selected_component_index))
	selected_component = _selected_component(role_key, selected_slot_key, selected_component_index)
	var current_is_blank := bool(stats.get("blank_canvas", false))
	var current_cost_label := "当前画布造价" if _ui_is_zh() and (_editor_is_blank_work_canvas() or current_is_blank) else ("当前单位造价" if _ui_is_zh() else ("Canvas Cost" if (_editor_is_blank_work_canvas() or current_is_blank) else "Unit Cost"))
	var current_cost_text := "%s %d" % [current_cost_label, int(stats.get("cost", 0))]
	if _editor_is_blank_work_canvas():
		_set_control_text_if_changed(editor_unit_label, ("P%d 临时%s\n%s" if _ui_is_zh() else "P%d TEMP %s\n%s") % [player_id, _role_short(role_key), current_cost_text])
	else:
		_set_control_text_if_changed(editor_unit_label, ("P%d %s %d/%d\n%s" if _ui_is_zh() else "P%d %s %d/%d\n%s") % [player_id, _role_short(role_key), int(editor_unit_indices[role_key]) + 1, roster.size(), current_cost_text])
	var unit_line := ("%s：%d" if _ui_is_zh() else "%s: %d") % [current_cost_label, int(stats.get("cost", 0))]
	var unit_note := "单位编辑：保存后在已保存单位页编成队伍。" if _ui_is_zh() else "Unit Edit: save, then compose teams from Saved Units."
	if String(stats.get("slot_payload_note", "")) != "":
		unit_note = _localized_system_text(String(stats.get("slot_payload_note", ""))) if _ui_is_zh() else String(stats.get("slot_payload_note", ""))
	var roster_line := ("P%d %s" if _ui_is_zh() else "P%d %s") % [player_id, unit_note]
	_set_control_text_if_changed(editor_summary_label, "%s\n%s" % [unit_line, roster_line])
	_refresh_unit_editor_legality_status(role_key, unit_bp)
	_set_control_text_if_changed(editor_stats_label, _format_unit_stats(stats))
	var switch_note: String = " | %s %s" % [_ui_term("shift"), String(selected_component.get("role_switch", "")).to_upper()] if String(selected_component.get("role_switch", "")) != "" else ""
	var heat_slot_note := " | 英魂热池 %.0f" % float(selected_component.get("soul_heat_capacity", 0.0)) if _ui_is_zh() and selected_component.has("soul_heat_capacity") else (" | Soul Heat Pool %.0f" % float(selected_component.get("soul_heat_capacity", 0.0)) if selected_component.has("soul_heat_capacity") else "")
	var electronic_armor_slot_note := " | 护盾 %.0f 回%.1f 覆%.2f" % [float(selected_component.get("shield_hp", selected_component.get("electronic_armor_hp", 0.0))), float(selected_component.get("shield_regen", selected_component.get("electronic_armor_regen", 0.0))), float(selected_component.get("shield_coverage", selected_component.get("electronic_armor_coverage", 0.0)))] if _ui_is_zh() and (bool(selected_component.get("electronic_armor", false)) or bool(selected_component.get("shield_payload", false))) else (" | Shield %.0f R%.1f C%.2f" % [float(selected_component.get("shield_hp", selected_component.get("electronic_armor_hp", 0.0))), float(selected_component.get("shield_regen", selected_component.get("electronic_armor_regen", 0.0))), float(selected_component.get("shield_coverage", selected_component.get("electronic_armor_coverage", 0.0)))] if bool(selected_component.get("electronic_armor", false)) or bool(selected_component.get("shield_payload", false)) else "")
	var stiffness_note := ""
	if selected_slot_key == "joint":
		stiffness_note = " | 刚度 %.0f" % _part_stiffness(selected_component, selected_slot_key) if _ui_is_zh() else " | STIFF %.0f" % _part_stiffness(selected_component, selected_slot_key)
	elif selected_slot_key in ["limb_muscle", "muscle"]:
		stiffness_note = " | 刚度 %.0f" % _part_stiffness(selected_component, selected_slot_key) if _ui_is_zh() else " | STIFF %.0f" % _part_stiffness(selected_component, selected_slot_key)
	var joint_power_note := " | 固定输出动量 %.0f" % _joint_fixed_output_momentum(selected_component) if _ui_is_zh() and selected_slot_key == "joint" else (" | OUT-MOM %.0f" % _joint_fixed_output_momentum(selected_component) if selected_slot_key == "joint" else "")
	var slot_volume_note := " | 体积 %s" % _volume_rank_label(_part_slot_volume_rank(selected_component, selected_slot_key)) if _ui_is_zh() and (selected_slot_key in ["engine", "cooling", "booster"] or bool(selected_component.get("torso_slot_payload", false))) else (" | VOL %s" % _volume_rank_label(_part_slot_volume_rank(selected_component, selected_slot_key)) if selected_slot_key in ["engine", "cooling", "booster"] or bool(selected_component.get("torso_slot_payload", false)) else "")
	var engine_power_note := " | 动力 %.0f | 常热负载 %.1f" % [_engine_momentum_output_for_part(selected_component), _engine_idle_heat_for_part(selected_component, _engine_momentum_output_for_part(selected_component))] if _ui_is_zh() and selected_slot_key == "engine" else (" | POWER %.0f | IDLE LOAD %.1f" % [_engine_momentum_output_for_part(selected_component), _engine_idle_heat_for_part(selected_component, _engine_momentum_output_for_part(selected_component))] if selected_slot_key == "engine" else "")
	var detail_summary := _localized_component_summary(selected_component, selected_slot_key)
	var size_label := _zh_part_name(String(selected_component.get("size_class", "standard")).to_upper()) if _ui_is_zh() else String(selected_component.get("size_class", "standard")).to_upper()
	var class_label := _zh_part_name(String(selected_component.get("material_class", "part")).to_upper()) if _ui_is_zh() else String(selected_component.get("material_class", "part")).to_upper()
	var compact_detail_bits: Array = []
	compact_detail_bits.append(("价%d" if _ui_is_zh() else "C%d") % int(selected_component.get("cost", 0)))
	if _component_has_combat_volume(selected_component, selected_slot_key):
		compact_detail_bits.append(("HP%d" if _ui_is_zh() else "HP%d") % int(selected_component.get("hp", 0)))
	compact_detail_bits.append(("质%.0f" if _ui_is_zh() else "M%.0f") % float(selected_component.get("mass", 0.0)))
	if float(selected_component.get("length", 0.0)) > 0.0:
		compact_detail_bits.append(("长%.2f" if _ui_is_zh() else "L%.2f") % float(selected_component.get("length", 0.0)))
	if _part_stiffness(selected_component, selected_slot_key) > 0.0:
		compact_detail_bits.append(("刚%.0f" if _ui_is_zh() else "ST%.0f") % _part_stiffness(selected_component, selected_slot_key))
	if selected_slot_key == "engine":
		compact_detail_bits.append(("动力%.0f" if _ui_is_zh() else "PWR%.0f") % _engine_momentum_output_for_part(selected_component))
	if selected_slot_key in ["engine", "cooling", "booster"] or bool(selected_component.get("torso_slot_payload", false)):
		compact_detail_bits.append(("槽%s" if _ui_is_zh() else "VOL%s") % _volume_rank_label(_part_slot_volume_rank(selected_component, selected_slot_key)))
	var detail_text := "%s\n%s | %s | %s" % [detail_summary, " | ".join(compact_detail_bits), size_label, class_label]
	if _component_is_gun_muscle(selected_component, selected_slot_key):
		var gun_ammo_mass := _ammo_capacity_mass(selected_component.get("ammo_capacity", {}))
		detail_text += ("\n射速 %.2f/s | 自带弹药 %d | 弹药质量 %.1f" if _ui_is_zh() else "\nFire %.2f/s | Carried Ammo %d | Ammo Mass %.1f") % [float(selected_component.get("fire_rate", 0.0)), int(selected_component.get("carried_ammo", 0)), gun_ammo_mass]
	_set_control_text_if_changed(editor_detail_label, detail_text)
	_update_editor_art(selected_slot_key, selected_component)
	_update_editor_board_ui(role_key, unit_bp, stats)
	_apply_editor_panel_visibility(role_key, unit_bp)
	_refresh_editor_stats_rail(stats)
	_update_editor_roster_overview()
	_refresh_editor_module_binding_buttons()
	if editor_action_buttons.has("edit_side"):
		var side_button: Button = editor_action_buttons["edit_side"]
		_set_control_text_if_changed(side_button, "编辑 P%d" % player_id if _ui_is_zh() else "EDIT P%d" % player_id)
		_set_canvas_item_modulate_if_changed(side_button, Color(0.35, 0.95, 1.0, 1.0) if player_id == 1 else Color(1.0, 0.34, 0.48, 1.0))
	editor_update_ui_last_usec = Time.get_ticks_usec() - update_start_usec
	if hot_path_profiler != null:
		hot_path_profiler.record_value("teamedit.update_ui_usec", editor_update_ui_last_usec)
		hot_path_profiler.scope_end("teamedit.update_ui")


func _module_binding_overlay_active() -> bool:
	return (
		editor_layer != null
		and editor_layer.visible
		and editor_torso_detail_view != null
		and editor_torso_detail_view.visible
		and editor_torso_detail_view.binding_mode
		and not editor_pending_module_binding.is_empty()
		and bool(editor_pending_module_binding.get("target_selected", false))
	)


func _binding_overlay_rect_to_button_parent(button: Button, local_rect: Rect2) -> Rect2:
	if editor_torso_detail_view == null:
		return local_rect
	var global_pos := editor_torso_detail_view.get_global_rect().position + local_rect.position
	var local_pos := global_pos
	var parent_control: Control = button.get_parent() as Control
	if parent_control != null:
		local_pos = parent_control.get_global_transform().affine_inverse() * global_pos
	return Rect2(local_pos, local_rect.size)


func _layout_module_binding_key_overlay() -> bool:
	var overlay_active := _module_binding_overlay_active()
	var side_required := overlay_active and bool(editor_pending_module_binding.get("side_mount_action_required", false))
	var side_selected := String(editor_pending_module_binding.get("side_mount_action_side", "")) != ""
	var key_ready := overlay_active and (not side_required or side_selected)
	var overlay_has_click_targets := false
	for side_key in ["left", "right"]:
		var button_key := "bind_side_%s" % side_key
		if not editor_action_buttons.has(button_key):
			continue
		var side_button: Button = editor_action_buttons[button_key]
		var should_show_side := overlay_active and side_required
		_set_canvas_item_visible_if_changed(side_button, should_show_side)
		_set_button_disabled_if_changed(side_button, not should_show_side)
		if should_show_side:
			var side_rect := _binding_overlay_rect_to_button_parent(side_button, editor_torso_detail_view._binding_action_side_rect(side_key))
			_set_control_position_if_changed(side_button, side_rect.position)
			_set_control_size_if_changed(side_button, side_rect.size)
			side_button.mouse_filter = Control.MOUSE_FILTER_STOP
			side_button.z_index = MODULE_BINDING_OVERLAY_Z_INDEX
			_set_control_text_if_changed(side_button, _side_mount_action_side_label(side_key))
			_set_control_tooltip_if_changed(side_button, ("选择%s后再绑定攻击键" if _ui_is_zh() else "Pick %s before choosing an attack key") % _side_mount_action_side_label(side_key))
			var selected: bool = _normalize_side_mount_action_side(editor_pending_module_binding.get("side_mount_action_side", "")) == side_key
			_set_canvas_item_modulate_if_changed(side_button, Color(1.0, 0.86, 0.22, 1.0) if selected else Color(0.56, 0.92, 1.0, 0.96))
			side_button.move_to_front()
			overlay_has_click_targets = true
	for key_index in range(1, ATTACK_GROUP_COUNT + 1):
		var button_key := "bind_key_%d" % key_index
		if not editor_action_buttons.has(button_key):
			continue
		var key_button: Button = editor_action_buttons[button_key]
		if key_ready:
			var key_rect := _binding_overlay_rect_to_button_parent(key_button, editor_torso_detail_view._binding_key_rect(key_index))
			_set_control_position_if_changed(key_button, key_rect.position)
			_set_control_size_if_changed(key_button, key_rect.size)
			key_button.mouse_filter = Control.MOUSE_FILTER_STOP
			key_button.z_index = MODULE_BINDING_OVERLAY_Z_INDEX
			_set_canvas_item_visible_if_changed(key_button, true)
			_set_button_disabled_if_changed(key_button, false)
			_set_control_text_if_changed(key_button, "%d %s" % [key_index, _attack_key_label(key_index)])
			_set_control_tooltip_if_changed(key_button, ("绑定到攻击键 %d（键盘 %s）" if _ui_is_zh() else "Bind to attack key %d (keyboard %s)") % [key_index, _attack_key_label(key_index)])
			var selected_key := int(editor_pending_module_binding.get("attack_key", 0))
			_set_canvas_item_modulate_if_changed(key_button, Color(1.0, 0.86, 0.22, 1.0) if selected_key == key_index else Color(0.58, 0.82, 1.0, 0.96))
			key_button.move_to_front()
			overlay_has_click_targets = true
		elif overlay_active:
			_set_canvas_item_visible_if_changed(key_button, false)
			_set_button_disabled_if_changed(key_button, true)
	if overlay_has_click_targets:
		_clear_editor_hover_card(true)
		_close_engine_momentum_allocation_panel()
	return overlay_active


func _refresh_editor_module_binding_buttons() -> void:
	var pending := not editor_pending_module_binding.is_empty()
	var overlay_handled := _layout_module_binding_key_overlay()
	if overlay_handled:
		return
	var bound_keys := {}
	if not pending:
		var role_key: String = ROLE_ORDER[editor_role_index]
		var unit_bp: Dictionary = _editor_current_blueprint()
		if _role_uses_body_board(role_key) and unit_bp.has("custom_topology") and not (role_key == "barrier" and _barrier_uses_screen_board(unit_bp)):
			for raw_binding in _runtime_module_bindings_for_blueprint(role_key, unit_bp):
				if raw_binding is Dictionary and bool(Dictionary(raw_binding).get("runtime_valid", true)):
					bound_keys[clampi(int(Dictionary(raw_binding).get("attack_key", 0)), 1, ATTACK_GROUP_COUNT)] = true
	for key_index in range(1, ATTACK_GROUP_COUNT + 1):
		var button_key := "bind_key_%d" % key_index
		if not editor_action_buttons.has(button_key):
			continue
		var button: Button = editor_action_buttons[button_key]
		var bound_ready := bound_keys.has(key_index)
		var should_show := bound_ready and not pending and editor_layer != null and editor_layer.visible
		_set_control_position_if_changed(button, Vector2(286.0 + float(key_index - 1) * 56.0, 618.0))
		_set_control_size_if_changed(button, Vector2(50.0, 24.0))
		button.mouse_filter = Control.MOUSE_FILTER_STOP
		button.z_index = MODULE_BINDING_TRYOUT_Z_INDEX
		_set_canvas_item_visible_if_changed(button, should_show)
		_set_button_disabled_if_changed(button, not should_show)
		var label_prefix := "试" if bound_ready and not pending and _ui_is_zh() else ("TRY" if bound_ready and not pending else "")
		var button_text := "%s%d %s" % [label_prefix, key_index, _attack_key_label(key_index)] if label_prefix != "" else "%d %s" % [key_index, _attack_key_label(key_index)]
		_set_control_text_if_changed(button, button_text)
		var tip := ("试用攻击键 %d（无伤害、不耗弹、不发热）" if _ui_is_zh() else "Try attack key %d (no damage, ammo, or heat)") % key_index if bound_ready and not pending else (("绑定到攻击键 %d（键盘 %s）" if _ui_is_zh() else "Bind to attack key %d (keyboard %s)") % [key_index, _attack_key_label(key_index)])
		_set_control_tooltip_if_changed(button, tip)
		_set_canvas_item_modulate_if_changed(button, Color(0.42, 1.0, 0.76, 0.96) if bound_ready and not pending else Color(0.58, 0.82, 1.0, 0.92))
		if button.visible:
			button.move_to_front()
	for side_key in ["left", "right"]:
		var side_button_key := "bind_side_%s" % side_key
		if not editor_action_buttons.has(side_button_key):
			continue
		var side_button: Button = editor_action_buttons[side_button_key]
		_set_canvas_item_visible_if_changed(side_button, false)
		_set_button_disabled_if_changed(side_button, true)


func _editor_template_category_label(role_key: String) -> String:
	if _ui_is_zh():
		match role_key:
			"hero":
				return "加载已保存英雄 / 预组英雄"
			"puppet":
				return "加载已保存傀儡组 / 预组傀儡组"
			"barrier":
				return "加载已保存结界群 / 预组结界群"
		return "加载已保存单位"
	match role_key:
		"hero":
			return "LOAD HERO / PREBUILT HERO"
		"puppet":
			return "LOAD PUPPET GROUP / PREBUILT PUPPETS"
		"barrier":
			return "LOAD BARRIER GROUP / PREBUILT BARRIERS"
	return "LOAD SAVED UNIT"


func _layout_editor_template_drawer(role_key: String, drawer_visible: bool) -> void:
	var body_board_enabled := _role_uses_body_board(role_key)
	var count := BARRIER_TEMPLATE_ORDER.size() if role_key == "barrier" else ARCHETYPE_ORDER.size()
	var rows := ceili(float(maxi(1, count)) / 2.0)
	if editor_template_panel != null:
		_set_control_position_if_changed(editor_template_panel, Vector2(932.0, 398.0))
		_set_control_size_if_changed(editor_template_panel, Vector2(278.0, maxf(92.0, 18.0 + float(rows) * 28.0)))
		_set_canvas_item_visible_if_changed(editor_template_panel, drawer_visible)
	if editor_section_labels.has("template"):
		var template_label: Label = editor_section_labels["template"]
		_set_control_position_if_changed(template_label, Vector2(936.0, 374.0))
		_set_control_size_if_changed(template_label, Vector2(270.0, 20.0))
		_set_control_text_if_changed(template_label, _editor_template_category_label(role_key))
		_set_canvas_item_visible_if_changed(template_label, drawer_visible)
	var visible_index := 0
	for i in range(editor_template_buttons.size()):
		var template_button: Button = editor_template_buttons[i]
		var is_barrier_template := i >= ARCHETYPE_ORDER.size()
		var show_button := drawer_visible and ((is_barrier_template and role_key == "barrier") or ((not is_barrier_template) and body_board_enabled and role_key != "barrier"))
		_set_canvas_item_visible_if_changed(template_button, show_button)
		_set_button_disabled_if_changed(template_button, not show_button)
		if show_button:
			_set_control_position_if_changed(template_button, Vector2(940.0 + float(visible_index % 2) * 134.0, 406.0 + float(floori(float(visible_index) / 2.0)) * 28.0))
			_set_control_size_if_changed(template_button, Vector2(126.0, 24.0))
			visible_index += 1


func _editor_load_entry_stats(player_id: int, fallback_role: String, entry: Dictionary) -> Dictionary:
	var entry_role := String(entry.get("role", fallback_role))
	var entry_index := int(entry.get("index", 0))
	var unit_library := bool(entry.get("unit_library", false))
	var entry_bp := Dictionary(entry.get("blueprint", {})) if unit_library else _blueprint_for(player_id, entry_role, entry_index)
	var cache_key := "%d|%s|%d|%s|%d" % [player_id, entry_role, entry_index, str(unit_library), hash(entry_bp)]
	if editor_load_entry_stats_cache.has(cache_key):
		return Dictionary(editor_load_entry_stats_cache[cache_key])
	var stats := _compute_unit_stats(player_id, entry_role, entry_index, entry_bp if unit_library else {})
	editor_load_entry_stats_cache[cache_key] = stats
	_trim_dictionary_cache(editor_load_entry_stats_cache, 120)
	return stats


func _update_editor_load_card_buttons(role_key: String) -> void:
	var load_visible := editor_panel_mode == "load"
	var page_size: int = maxi(1, editor_load_card_buttons.size())
	var entries := _editor_load_entries() if load_visible else []
	var max_page := maxi(0, int(ceilf(float(entries.size()) / float(page_size))) - 1)
	editor_load_page = clampi(editor_load_page, 0, max_page)
	if editor_action_buttons.has("prev_catalog") and load_visible:
		var prev_button: Button = editor_action_buttons["prev_catalog"]
		_set_button_disabled_if_changed(prev_button, editor_load_page <= 0 or max_page <= 0)
		_set_control_text_if_changed(prev_button, "<")
	if editor_action_buttons.has("next_catalog") and load_visible:
		var next_button: Button = editor_action_buttons["next_catalog"]
		_set_button_disabled_if_changed(next_button, editor_load_page >= max_page or max_page <= 0)
		_set_control_text_if_changed(next_button, ">")
	if not load_visible:
		for hidden_button in editor_load_card_buttons:
			var button: Button = hidden_button
			_set_canvas_item_visible_if_changed(button, false)
			_set_button_disabled_if_changed(button, true)
		return
	var player_id := _editor_player()
	if editor_catalog_page_label != null and load_visible:
		_set_control_position_if_changed(editor_catalog_page_label, Vector2(966.0, 654.0))
		_set_control_size_if_changed(editor_catalog_page_label, Vector2(210.0, 22.0))
		_set_control_text_if_changed(editor_catalog_page_label, ("页 %d/%d  %d" if _ui_is_zh() else "P %d/%d  %d") % [editor_load_page + 1, max_page + 1, entries.size()])
	for i in range(editor_load_card_buttons.size()):
		var button: Button = editor_load_card_buttons[i]
		var actual_index := editor_load_page * page_size + i
		var show_button := load_visible and actual_index < entries.size()
		_set_canvas_item_visible_if_changed(button, show_button)
		_set_button_disabled_if_changed(button, not show_button)
		if not show_button:
			_set_control_text_if_changed(button, "")
			continue
		var entry: Dictionary = entries[actual_index]
		if bool(entry.get("empty", false)):
			var empty_role := String(entry.get("role", ROLE_ORDER[actual_index % ROLE_ORDER.size()]))
			_set_control_position_if_changed(button, Vector2(936.0, 224.0 + float(i) * 34.0))
			_set_control_size_if_changed(button, Vector2(270.0, 30.0))
			if _ui_is_zh():
				_set_control_text_if_changed(button, "%02d %s  空  ¥0" % [actual_index + 1, _role_short(empty_role)])
			else:
				_set_control_text_if_changed(button, "%02d %s  EMPTY  $0" % [actual_index + 1, _role_short(empty_role)])
			_set_canvas_item_modulate_if_changed(button, Color(0.58, 0.64, 0.68, 0.76))
			continue
		var entry_role := String(entry.get("role", role_key))
		var entry_index := int(entry.get("index", 0))
		var stats := _editor_load_entry_stats(player_id, role_key, entry)
		var in_sortie := bool(entry.get("in_sortie", false))
		var prefix := ""
		if editor_load_mode == "team":
			prefix = ("队" if _ui_is_zh() else "T")
			_set_control_position_if_changed(button, Vector2(936.0, 224.0 + float(i) * 34.0))
		elif bool(entry.get("builtin_hero_preset", false)):
			prefix = ("预" if _ui_is_zh() else "P")
			_set_control_position_if_changed(button, Vector2(936.0, 250.0 + float(i) * 34.0))
		else:
			prefix = ("库" if _ui_is_zh() else "U")
			_set_control_position_if_changed(button, Vector2(936.0, 250.0 + float(i) * 34.0))
		_set_control_size_if_changed(button, Vector2(270.0, 30.0))
		var localized_name := _short_part_name(String(stats.get("name", "")))
		var index_text := ("#%d" % (entry_index + 1)) if entry_index >= 0 else ""
		_set_control_text_if_changed(button, "%s%02d %s%s  %s  ¥%d" % [prefix, actual_index + 1, _role_short(entry_role), index_text, localized_name, int(stats.get("cost", 0))] if _ui_is_zh() else "%s%02d %s%s  %s  $%d" % [prefix, actual_index + 1, _role_short(entry_role), index_text, localized_name, int(stats.get("cost", 0))])
		_set_canvas_item_modulate_if_changed(button, Color(0.74, 1.0, 0.48, 1.0) if bool(entry.get("builtin_hero_preset", false)) else (Color(0.38, 0.96, 1.0, 1.0) if bool(entry.get("unit_library", false)) else (Color(1.0, 0.86, 0.28, 1.0) if (editor_load_mode == "unit" and entry_index == int(editor_unit_indices.get(entry_role, 0))) else Color(0.84, 0.9, 0.94, 1.0))))


