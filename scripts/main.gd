func _economy_median_mass_for_rank(rank_value: int) -> float:
	return _unit_stats_service().economy_median_mass_for_rank(rank_value)


func _economy_engine_idle_heat_target(rank_value: int) -> float:
	return _economy_engine_momentum_target(rank_value) * float(_engine_family_defaults("balanced").get("engine_heat_coeff", 0.055))


func _economy_booster_idle_heat_target(rank_value: int) -> float:
	return _economy_median_mass_for_rank(rank_value) * 0.045 + float(rank_value) * 0.55


func _economy_cooling_target(rank_value: int) -> float:
	return (_economy_engine_idle_heat_target(rank_value) + _economy_booster_idle_heat_target(rank_value)) * 1.1


func _economy_engine_momentum_target(rank_value: int) -> float:
	var median_mass := _economy_median_mass_for_rank(rank_value)
	return maxf(18.0 + median_mass * 1.18 + float(rank_value) * 6.0, median_mass * 0.75)


func _economy_heat_capacity_target(rank_value: int) -> float:
	return 18.0 + _economy_median_mass_for_rank(rank_value) * 0.72


func _economy_plugin_rank(part: Dictionary, slot_key: String) -> int:
	if part.has("slot_volume_tier"):
		return _volume_rank_from_value(part["slot_volume_tier"], 1)
	return clampi(int(round(_part_slot_volume_rank(part, slot_key))), 1, 5)


func _economy_rebalanced_plugin_component(part: Dictionary, slot_key: String) -> Dictionary:
	if not (slot_key in ["engine", "booster", "cooling"]):
		return part
	var adjusted := part.duplicate(true)
	var rank := _economy_plugin_rank(adjusted, slot_key)
	adjusted["slot_volume_tier"] = _volume_rank_label(float(rank))
	var median_mass := _economy_median_mass_for_rank(rank)
	match slot_key:
		"engine":
			adjusted["engine_momentum_output"] = maxf(float(adjusted.get("engine_momentum_output", 0.0)), _economy_engine_momentum_target(rank))
			adjusted = _engine_with_philosophy_defaults(adjusted)
			if not adjusted.has("engine_heat_coeff"):
				var target_heat := _economy_engine_idle_heat_target(rank)
				adjusted["engine_heat_coeff"] = target_heat / maxf(1.0, float(adjusted["engine_momentum_output"]))
			for legacy_key in ["power", "engine_power", "required_power", "engine_torque", "engine_motion_scale", "idle_heat", "energy"]:
				adjusted.erase(legacy_key)
		"booster":
			var normal_momentum := median_mass * ECONOMY_THRUSTER_TARGET_SPEED
			if not adjusted.has("allocated_momentum"):
				var defaults := _thruster_family_defaults(String(adjusted.get("thruster_family", "cruise_blue")))
				var move_eff := clampf(float(adjusted.get("move_efficiency", defaults.get("move_efficiency", 1.0))), 0.2, 3.0)
				adjusted["allocated_momentum"] = normal_momentum / maxf(0.2, move_eff)
			if not adjusted.has("momentum_min") and not adjusted.has("drive_demand"):
				adjusted["momentum_min"] = maxf(0.0, float(adjusted.get("allocated_momentum", normal_momentum)))
			elif adjusted.has("drive_demand") and not adjusted.has("momentum_min"):
				adjusted["momentum_min"] = maxf(0.0, float(adjusted.get("drive_demand", 0.0)))
			adjusted["drive_demand"] = maxf(0.0, float(adjusted.get("momentum_min", 0.0)))
			if not adjusted.has("thruster_duration"):
				adjusted["thruster_duration"] = ECONOMY_THRUSTER_TARGET_DURATION
			if not adjusted.has("boost_momentum"):
				adjusted["boost_momentum"] = normal_momentum
			if not adjusted.has("boost_duration"):
				adjusted["boost_duration"] = ECONOMY_THRUSTER_TARGET_DURATION
			if not adjusted.has("thruster_idle_heat_coeff"):
				adjusted["thruster_idle_heat_coeff"] = _economy_booster_idle_heat_target(rank) / maxf(1.0, float(adjusted["allocated_momentum"]))
			if not adjusted.has("thruster_family"):
				adjusted["thruster_family"] = "cruise_blue"
			if not adjusted.has("flame_color"):
				adjusted["flame_color"] = "blue"
			if not adjusted.has("brake_efficiency"):
				adjusted["brake_efficiency"] = 1.0
			adjusted = _thruster_with_drive_defaults(adjusted)
			for legacy_key in ["thruster_momentum", "normal_thrust", "boost_power", "boost_cone", "booster_size", "boost_style", "boost_flame", "idle_heat", "power_load", "recoil_cancel"]:
				adjusted.erase(legacy_key)
		"cooling":
			adjusted = _cooling_with_v3_defaults(adjusted)
	return adjusted


func _economy_priced_component(part: Dictionary) -> Dictionary:
	var priced := part.duplicate(true)
	var raw_cost := int(priced.get("cost", 0))
	if raw_cost > 0 and ECONOMY_PRICE_MULTIPLIER != 1.0:
		priced["raw_cost"] = raw_cost
		priced["cost"] = maxi(1, int(roundf(float(raw_cost) * ECONOMY_PRICE_MULTIPLIER)))
	return priced


func _component_is_gun_muscle(part: Dictionary, slot_key: String) -> bool:
	if slot_key != "muscle":
		return false
	var material_class := String(part.get("material_class", "")).to_lower()
	var shape := String(part.get("shape", "")).to_lower()
	return bool(part.get("projectile", false)) or material_class in ["gun", "missile_launcher", "web_gun"] or shape.contains("gun") or shape.contains("rifle") or shape.contains("cannon") or shape.contains("turret") or shape.contains("missile")


func _gun_default_profile_key(part: Dictionary) -> String:
	var behavior := _projectile_behavior_for_data(part)
	var damage_type := String(part.get("projectile_damage_type", part.get("damage_type", ""))).to_lower()
	var style := String(part.get("projectile_style", "")).to_lower()
	if behavior == "web_tether" or style in ["web", "web_snap"] or String(part.get("travel_path", "")).to_lower() == "tether":
		return "web_tether"
	if behavior in ["chemical_line", "chemical_firework"]:
		return "chemical"
	if behavior != "":
		return behavior
	if damage_type == "laser":
		return "laser"
	if style == "missile":
		return "missile"
	if style in ["explosive", "blast"] or float(part.get("explosion_radius", 0.0)) > 0.0:
		return "explosive"
	return "bullet_hell"


func _gun_kind_for_data(data: Dictionary) -> String:
	var explicit := String(data.get("gun_kind", "")).to_lower()
	if explicit in GUN_KINDS:
		return explicit
	var profile_key := _gun_default_profile_key(data)
	var shape := String(data.get("shape", "")).to_lower()
	var material_class := String(data.get("material_class", "")).to_lower()
	if profile_key == "web_tether" or material_class == "web_gun" or shape.contains("web"):
		return "web_gun"
	if profile_key == "true_bullet" or shape.contains("rail") or shape.contains("sniper") or shape.contains("heavy_cannon"):
		return "sniper"
	if profile_key == "laser":
		return "laser_gun"
	if profile_key == "chemical" or shape.contains("siphon") or shape.contains("nozzle") or shape.contains("acid"):
		return "sprayer"
	if profile_key == "explosive" or shape.contains("mortar") or shape.contains("cannon"):
		return "grenade_launcher"
	if profile_key == "missile" or material_class == "missile_launcher" or shape.contains("missile"):
		return "missile_launcher"
	return "rifle"


func _ammo_kind_for_data(data: Dictionary) -> String:
	var explicit := String(data.get("ammo_kind", "")).to_lower()
	if explicit in AMMO_TYPES:
		return explicit
	var style := String(data.get("projectile_style", "")).to_lower()
	var behavior := _projectile_behavior_for_data(data)
	var damage_type := String(data.get("projectile_damage_type", data.get("damage_type", ""))).to_lower()
	if style in ["web", "web_snap"] or String(data.get("travel_path", "")).to_lower() == "tether":
		return "web"
	if behavior == "explosive" or style in ["explosive", "blast", "missile"] or float(data.get("explosion_radius", 0.0)) > 0.0:
		return "explosive"
	if damage_type == "laser":
		return "laser"
	if damage_type == "chemical":
		return "chemical"
	return "bullet"


func _gun_default_carried_ammo(part: Dictionary, profile_key: String) -> int:
	var mass := float(part.get("mass", 0.0))
	match profile_key:
		"true_bullet":
			return 3 if mass >= 40.0 else (5 if mass >= 14.0 else 8)
		"bullet_hell":
			return 40 if mass >= 16.0 else (30 if mass >= 6.0 else 20)
		"laser":
			return 5 if mass >= 30.0 else (7 if mass >= 8.0 else 10)
		"chemical":
			return 8 if mass >= 18.0 else (10 if mass >= 6.0 else 12)
		"web_tether":
			return STANDARD_WEB_TETHER_AMMO_CAPACITY
		"explosive", "missile":
			return 2 if mass >= 18.0 else (3 if mass >= 7.0 else 4)
	return int(GUN_DEFAULT_CARRIED_AMMO.get(profile_key, 8))


func _gun_default_fire_rate(part: Dictionary, profile_key: String) -> float:
	var base := float(GUN_DEFAULT_FIRE_RATE.get(profile_key, 2.0))
	var mass := maxf(0.0, float(part.get("mass", 0.0)))
	var mass_mult := 1.0
	if mass >= 40.0:
		mass_mult = 0.58
	elif mass >= 16.0:
		mass_mult = 0.72
	elif mass <= 4.0:
		mass_mult = 1.18
	if profile_key == "laser":
		mass_mult = lerpf(mass_mult, 1.0, 0.45)
	return clampf(base * mass_mult, 0.18, 7.5)


func _gun_part_with_runtime_defaults(part: Dictionary, slot_key: String) -> Dictionary:
	if not _component_is_gun_muscle(part, slot_key):
		return part
	var gun := part.duplicate(true)
	var original_name := String(gun.get("name", ""))
	var profile_key := _gun_default_profile_key(gun)
	if not gun.has("gun_kind"):
