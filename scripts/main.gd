func _append_editor_section(entries: Array, label: String, color: Color) -> void:
	entries.append({
		"kind": "section",
		"label": label,
		"color": color,
	})


func _append_editor_stat(entries: Array, label: String, key: String, current_stats: Dictionary, preview_stats: Dictionary, base_max: float, unit: String, illegal: bool, pinned: bool = false) -> void:
	var value := float(current_stats.get(key, 0.0))
	var preview := float(preview_stats.get(key, value))
	_append_editor_stat_from_values(entries, label, value, preview, base_max, unit, illegal, pinned)


func _append_editor_stat_from_values(entries: Array, label: String, value: float, preview: float, base_max: float, unit: String, illegal: bool, pinned: bool = false) -> void:
	var max_value := maxf(base_max, maxf(absf(value), absf(preview)) * 1.18)
	entries.append({
		"label": label,
		"value": value,
		"preview": preview,
		"max_value": max_value,
		"unit": unit,
		"illegal": illegal,
		"pinned": pinned,
	})


func _append_editor_balance_stat(entries: Array, label: String, current_stats: Dictionary, preview_stats: Dictionary, supply_key: String, demand_key: String, supply_label: String, demand_label: String, illegal: bool, pinned: bool = false) -> void:
	var supply := float(current_stats.get(supply_key, 0.0))
	var demand := float(current_stats.get(demand_key, 0.0))
	var preview_supply := float(preview_stats.get(supply_key, supply))
	var preview_demand := float(preview_stats.get(demand_key, demand))
	var max_value := maxf(1.0, maxf(maxf(supply, demand), maxf(preview_supply, preview_demand)) * 1.18)
	entries.append({
		"kind": "balance",
		"label": label,
		"supply": supply,
		"demand": demand,
		"margin": supply - demand,
		"preview_supply": preview_supply,
		"preview_demand": preview_demand,
		"preview_margin": preview_supply - preview_demand,
		"max_value": max_value,
		"unit": "",
		"supply_label": supply_label,
		"demand_label": demand_label,
		"surplus_label": "余量" if _ui_is_zh() else "Reserve",
		"shortage_label": "不足" if _ui_is_zh() else "Short",
		"preview_illegal": preview_supply < preview_demand,
		"illegal": illegal or supply < demand,
		"pinned": pinned,
	})


