func _append_editor_section(entries: Array, label: String, color: Color) -> void:
	entries.append({
		"kind": "section",
		"label": label,
		"color": color,
	})


func _append_editor_stat(entries: Array, label: String, key: String, current_stats: Dictionary, preview_stats: Dictionary, base_max: float, unit: String, illegal: bool, pinned: bool = false) -> void:
	var value := float(current_stats.get(key, 0.0))
	var preview := float(preview_stats.get(key, value))
	_append_editor_stat_from_values(entries, label, value, preview, base_max, unit, illegal, pinned)


func _append_editor_stat_from_values(entries: Array, label: String, value: float, preview: float, base_max: float, unit: String, illegal: bool, pinned: bool = false) -> void:
	var max_value := maxf(base_max, maxf(absf(value), absf(preview)) * 1.18)
	entries.append({
		"label": label,
		"value": value,
		"preview": preview,
		"max_value": max_value,
		"unit": unit,
		"illegal": illegal,
		"pinned": pinned,
	})


func _append_editor_balance_stat(entries: Array, label: String, current_stats: Dictionary, preview_stats: Dictionary, supply_key: String, demand_key: String, supply_label: String, demand_label: String, illegal: bool, pinned: bool = false) -> void:
	var supply := float(current_stats.get(supply_key, 0.0))
	var demand := float(current_stats.get(demand_key, 0.0))
	var preview_supply := float(preview_stats.get(supply_key, supply))
	var preview_demand := float(preview_stats.get(demand_key, demand))
	var max_value := maxf(1.0, maxf(maxf(supply, demand), maxf(preview_supply, preview_demand)) * 1.18)
	entries.append({
		"kind": "balance",
		"label": label,
		"supply": supply,
		"demand": demand,
		"margin": supply - demand,
		"preview_supply": preview_supply,
		"preview_demand": preview_demand,
		"preview_margin": preview_supply - preview_demand,
		"max_value": max_value,
		"unit": "",
		"supply_label": supply_label,
		"demand_label": demand_label,
		"surplus_label": "余量" if _ui_is_zh() else "Reserve",
		"shortage_label": "不足" if _ui_is_zh() else "Short",
		"preview_illegal": preview_supply < preview_demand,
		"illegal": illegal or supply < demand,
		"pinned": pinned,
	})


func _torso_detail_template_key(part: Dictionary) -> String:
	return "%s|%s|%s|%d|%d|%s" % [
		ui_language,
		String(part.get("stable_key", part.get("name", ""))),
		PartArt.normalized_size_tier(part),
		_torso_plugin_capacity_for_part(part),
		_torso_software_capacity_for_part(part),
		String(part.get("material_visual", part.get("material_class", ""))),
	]


func _empty_torso_plugin_entries(torso_part: Dictionary, capacity: int) -> Array:
	var display: Array = []
	var slot_sizes := _torso_internal_slot_size_ranks(torso_part)
	for i in range(capacity):
		var label := _volume_rank_label(float(slot_sizes[i])) if i < slot_sizes.size() else "-"
		display.append({"empty": true, "slot_size_label": label})
	return display


func _empty_torso_software_entries(capacity: int) -> Array:
	var display: Array = []
	for _i in range(capacity):
		display.append({"empty": true})
	return display


func _build_torso_detail_template(part: Dictionary) -> Dictionary:
	var plugin_capacity := _torso_plugin_capacity_for_part(part)
	var software_capacity := _torso_software_capacity_for_part(part)
	var title := _zh_part_name(String(part.get("name", "TORSO"))) if _ui_is_zh() else String(part.get("name", "TORSO"))
	var subtitle := ("接口 %d  机内插件槽 %d/%d  软件槽 %d/%d" if _ui_is_zh() else "Ports %d  Internal %d/%d  Software %d/%d") % [
		int(part.get("joint_ports", part.get("connection_ends", 0))),
		0,
		plugin_capacity,
		0,
		software_capacity,
	]
	return {
		"title": title,
		"subtitle": subtitle,
		"plugin_display": _empty_torso_plugin_entries(part, plugin_capacity),
		"plugin_capacity": plugin_capacity,
		"software_display": _empty_torso_software_entries(software_capacity),
		"software_capacity": software_capacity,
	}


func _prewarm_torso_detail_template(part: Dictionary) -> bool:
	if part.is_empty() or not _component_is_torso(part):
		return false
	var key := _torso_detail_template_key(part)
	if editor_torso_detail_template_cache.has(key):
		return false
	editor_torso_detail_template_cache[key] = _build_torso_detail_template(part)
	return true


func _apply_torso_detail_template(state: Dictionary) -> void:
	if editor_torso_detail_view == null:
		return
	_set_editor_torso_detail_binding_layout(false)
	editor_torso_detail_view.set_detail(
		String(state.get("title", "")),
		String(state.get("subtitle", "")),
		Array(state.get("plugin_display", [])),
		int(state.get("plugin_capacity", 0)),
		Array(state.get("software_display", [])),
		int(state.get("software_capacity", 0)),
		editor_selected_torso_slot_kind,
		editor_selected_torso_slot_index,
		ui_language
	)
	editor_torso_detail_view.set_binding_state(false)


func _refresh_torso_detail_view() -> void:
	editor_torso_detail_refresh_count += 1
	if editor_torso_detail_view == null:
		return
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	if editor_open_torso_node_index < 0 or not unit_bp.has("custom_topology"):
		_set_editor_torso_detail_binding_layout(false)
		editor_torso_detail_view.visible = false
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if editor_open_torso_node_index >= nodes.size() or not _topology_node_is_torso(role_key, nodes[editor_open_torso_node_index], unit_bp):
		_set_editor_torso_detail_binding_layout(false)
		editor_torso_detail_view.visible = false
		return
	var part := _topology_node_part(role_key, nodes[editor_open_torso_node_index], unit_bp)
	var plugin_capacity := _torso_plugin_capacity_for_part(part)
	var software_capacity := _torso_software_capacity_for_part(part)
	var plugins := _torso_plugin_slot_summary(unit_bp, editor_open_torso_node_index)
	var software := _torso_software_slot_summary(unit_bp, editor_open_torso_node_index)
	var can_use_template := plugins.is_empty() \
		and software.is_empty() \
		and editor_pending_module_binding.is_empty() \
		and editor_selected_torso_slot_kind == "" \
		and editor_selected_torso_slot_index < 0
	if can_use_template:
		var template_key := _torso_detail_template_key(part)
		if not editor_torso_detail_template_cache.has(template_key):
			editor_torso_detail_cache_miss_count += 1
			_prewarm_torso_detail_template(part)
		if editor_torso_detail_template_cache.has(template_key):
			_apply_torso_detail_template(Dictionary(editor_torso_detail_template_cache[template_key]))
			return
	var plugin_display := _torso_detail_display_entries(unit_bp, editor_open_torso_node_index, "plugin", plugin_capacity, part)
	var software_display := _torso_detail_display_entries(unit_bp, editor_open_torso_node_index, "software", software_capacity, part)
	var title := _zh_part_name(String(part.get("name", "TORSO"))) if _ui_is_zh() else String(part.get("name", "TORSO"))
	var subtitle := ("接口 %d  机内插件槽 %d/%d  软件槽 %d/%d" if _ui_is_zh() else "Ports %d  Internal %d/%d  Software %d/%d") % [
		int(part.get("joint_ports", part.get("connection_ends", 0))),
		plugins.size(),
		plugin_capacity,
		software.size(),
		software_capacity,
	]
	editor_torso_detail_view.set_detail(
		title,
		subtitle,
		plugin_display,
		plugin_capacity,
		software_display,
		software_capacity,
		editor_selected_torso_slot_kind,
		editor_selected_torso_slot_index,
		ui_language
	)
	var binding_active := false
	if not editor_pending_module_binding.is_empty():
		var payload_index := int(editor_pending_module_binding.get("payload_index", -1))
		var payloads: Array = Array(unit_bp.get("slot_payloads", []))
		if payload_index >= 0 and payload_index < payloads.size() and payloads[payload_index] is Dictionary:
			var payload: Dictionary = Dictionary(payloads[payload_index])
			var payload_torso := int(payload.get("torso_node", editor_open_torso_node_index))
			if payload_torso == editor_open_torso_node_index:
				binding_active = true
				var module_part := _selected_component(role_key, "module", int(editor_pending_module_binding.get("module_index", payload.get("module", 0))))
				var candidates := _torso_detail_module_binding_candidates(unit_bp, payload_index, module_part)
				var selected_index := -1
				var selected_root := int(editor_pending_module_binding.get("root_index", -999))
				for i in range(candidates.size()):
					if int(Dictionary(candidates[i]).get("root_index", -1)) == selected_root:
						selected_index = i
						break
				var module_name := _zh_part_name(String(module_part.get("name", "行动模块"))) if _ui_is_zh() else String(module_part.get("name", "MODULE"))
				var bind_title := ("绑定行动模块：%s" if _ui_is_zh() else "Bind action module: %s") % module_name
				var bind_subtitle := _pending_module_binding_hint()
				editor_torso_detail_view.set_binding_state(true, bind_title, bind_subtitle, candidates, selected_index, bool(editor_pending_module_binding.get("target_selected", false)))
			else:
				editor_torso_detail_view.set_binding_state(false)
		else:
			editor_torso_detail_view.set_binding_state(false)
	else:
		editor_torso_detail_view.set_binding_state(false)
	_set_editor_torso_detail_binding_layout(binding_active)


func _editor_side_preview_signature(slot_key: String, part: Dictionary, snap_amount: float) -> String:
	return "|".join([
		slot_key,
		ui_language,
		String(part.get("name", "")),
		String(part.get("stable_key", "")),
		str(int(part.get("part_index", part.get("index", -1)))),
		str(snappedf(snap_amount, 0.01)),
	])


func _refresh_editor_selected_part_preview(slot_key: String, part: Dictionary, snap_amount: float, force_refresh: bool = false) -> void:
	var signature := _editor_side_preview_signature(slot_key, part, snap_amount)
	if not force_refresh and signature == editor_side_preview_signature:
		editor_side_preview_noop_count += 1
		return
	editor_side_preview_signature = signature
	editor_side_preview_update_count += 1
	if component_art_view != null:
		component_art_view.set_component(slot_key, part, snap_amount)
	if editor_battle_preview_view != null:
		editor_battle_preview_view.set_component(slot_key, part, ui_language)
	if editor_structure_reference_view != null:
		editor_structure_reference_view.visible = false
		editor_structure_reference_view.texture = null
		if editor_structure_reference_label != null:
			editor_structure_reference_label.visible = false
			editor_structure_reference_label.text = ""


