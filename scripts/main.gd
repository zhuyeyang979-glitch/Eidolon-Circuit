func _build_battle_runtime_menu(root: Control) -> void:
	_ensure_menu_view()
	battle_runtime_menu_panel = menu_view.build_battle_runtime_menu(root, _ui_viewport_size())
	battle_runtime_menu_buttons = menu_view.battle_runtime_menu_buttons


func _build_post_battle_review_ui(root: Control) -> void:
	_ensure_menu_view()
	post_battle_review_panel = menu_view.build_post_battle_review(root, _ui_viewport_size())
	post_battle_review_buttons = menu_view.post_battle_review_buttons


func _toggle_battle_runtime_menu() -> void:
	if menu_view == null or battle_runtime_menu_panel == null:
		return
	menu_view.toggle_battle_runtime()
	_update_battle_runtime_menu_ui()


func _hide_battle_runtime_menu() -> void:
	if menu_view != null:
		menu_view.hide_battle_runtime()
	elif battle_runtime_menu_panel != null:
		battle_runtime_menu_panel.visible = false


func _update_battle_runtime_menu_ui() -> void:
	if battle_runtime_menu_panel == null or menu_controller == null or menu_view == null:
		return
	menu_view.update_battle_runtime(menu_controller.battle_runtime_model(ui_language, battle_mode, MODE_TRAINING, training_dummy_state, game_over))


func _battle_runtime_menu_action(action_key: String) -> void:
	var action := menu_controller.battle_runtime_action(action_key) if menu_controller != null else {"action": action_key}
	match String(action.get("action", action_key)):
		"continue":
			_hide_battle_runtime_menu()
		"post_review":
			_hide_battle_runtime_menu()
			_show_post_battle_review(post_battle_review_winner_id, post_battle_review_reason)
		"battle_reset":
			_hide_battle_runtime_menu()
			_begin_battle(battle_mode, false, "battle_reset")
		"cycle_dummy_state":
			var order := ["idle_brake", "free_physics", "fixed", "sparring"]
			var index := order.find(training_dummy_state)
			var previous_state := training_dummy_state
			var next_state := String(order[_wrapped_index(index + 1, order.size())])
			_set_training_dummy_state(next_state)
			if battle_mode == MODE_TRAINING and ((previous_state == "sparring") != (next_state == "sparring")):
				if _configure_training_sides_for_seat():
					_hide_battle_runtime_menu()
					_begin_battle(MODE_TRAINING, true, "training_opponent_state_switch")
		"settings_input":
			_hide_battle_runtime_menu()
			_show_settings(false, "input")
		"settings":
			_hide_battle_runtime_menu()
			_show_settings()
		"training_config":
			_hide_battle_runtime_menu()
			_show_training_config(false)
		"main_menu":
			_hide_battle_runtime_menu()
			_show_menu()


func _show_post_battle_review(winner_id: int, reason: String = "victory") -> void:
	post_battle_review_winner_id = winner_id
	post_battle_review_reason = reason
	if menu_view == null or menu_controller == null:
		return
	menu_view.update_post_battle_review(menu_controller.post_battle_review_model(ui_language, winner_id, victory_points, match_time_remaining, battle_mode, _battle_review_diagnostic_summary_text(), _post_battle_star_soul_summary_rows()))
	menu_view.show_post_battle_review()


func _post_battle_star_soul_summary_rows() -> Array:
	var star_soul_model := _battle_hud_service().star_soul_hud_model(_battle_star_soul_runtime_snapshot(), _battle_hud_terms())
	return Array(star_soul_model.get("summary_rows", [])).duplicate(true)


func _hide_post_battle_review() -> void:
	if menu_view != null:
		menu_view.hide_post_battle_review()
	elif post_battle_review_panel != null:
		post_battle_review_panel.visible = false


func _post_battle_review_action(action_key: String) -> void:
	var action := menu_controller.post_battle_review_action(action_key) if menu_controller != null else {"action": action_key}
	match String(action.get("action", action_key)):
		"review":
			_hide_post_battle_review()
		"adjust_sortie":
			_hide_post_battle_review()
			_show_scout(battle_mode, true)
		"edit_units":
			_hide_post_battle_review()
			_show_editor_preserve_canvas(true)
		"rematch":
			_hide_post_battle_review()
			_begin_battle(battle_mode, true, "post_battle_rematch")
		"main_menu":
			_hide_post_battle_review()
			_show_menu()


func _build_page_options_ui() -> void:
	_ensure_menu_view()
	page_options_layer = menu_view.build_page_options(self, _ui_viewport_size())
	page_options_panel = menu_view.page_options_panel
	page_options_buttons = menu_view.page_options_buttons


func _show_page_options(context: String) -> void:
	if page_options_layer == null:
		return
	var route_context := _navigation_current_page()
	if route_context == "" or route_context == STATE_LOADING:
		route_context = context
	page_options_context = route_context
	if menu_view != null:
		menu_view.show_page_options(route_context)
	else:
		page_options_layer.visible = true
	_update_page_options_ui()


func _hide_page_options() -> void:
	if menu_view != null:
		menu_view.hide_page_options()
	elif page_options_layer != null:
		page_options_layer.visible = false
	page_options_context = ""


func _update_page_options_ui() -> void:
	if page_options_layer == null or page_options_panel == null or menu_controller == null or menu_view == null:
		return
	menu_view.update_page_options(menu_controller.page_options_model(ui_language))


func _page_options_action(action_key: String) -> void:
	var context := page_options_context
	var current_subroute := settings_category if context == STATE_SETTINGS else ""
	var action := NavigationService.route_action(NavigationService.ACTION_CLOSE)
	if navigation_service != null:
		action = navigation_service.resolve_option_action(action_key, current_subroute)
	if menu_controller != null:
		action = menu_controller.page_option_action(action_key, action)
	_hide_page_options()
	_execute_page_options_action(action, context)


func _page_options_back(context: String) -> void:
	var current_subroute := settings_category if context == STATE_SETTINGS else ""
	var action := NavigationService.route_action(NavigationService.ACTION_NAVIGATE_MENU, STATE_MENU, "page_options_back_legacy")
	if navigation_service != null:
		action = navigation_service.resolve_option_action("back", current_subroute)
	_execute_page_options_action(action, context)


func _execute_page_options_action(action: Dictionary, context: String) -> void:
	var routed := action.duplicate(true)
	if String(routed.get("action", "")) == NavigationService.ACTION_SHOW_HELP and String(routed.get("context", "")) == "":
		routed["context"] = context
	_navigate_page(routed)


func _show_context_help(context: String) -> void:
	var text := ""
	if _ui_is_zh():
		match context:
			"editor":
				text = "单位编辑：只编辑单个单位；保存后在已保存单位页勾选组成队伍。"
			"saved_units":
				text = "已保存单位：卡片可 hover 查看详情；勾选单位组成队伍，也可载入单位继续编辑。"
			"scout":
				text = "训练配置/赛前侦查：先选 P1/P2/P3 席位，再设置靶机体积与状态后开始。"
			"settings":
				text = "设置分为声音、画面、系统语言和按键绑定；返回请使用页面按钮，Esc 仅关闭详情或取消按键监听。"
			_:
				text = "选项菜单用于返回上级、打开设置或回到主菜单。"
	else:
		match context:
			"editor":
				text = "Unit Edit: edit one unit at a time; save it, then compose teams from Saved Units."
			"saved_units":
				text = "Saved Units: hover cards for details; select one or multiple units for Training."
			"scout":
				text = "Training Config / Scout: choose P1/P2/P3, then set dummy size and behavior before starting."
			"settings":
				text = "Settings are split into sound, video, language, and input pages. Use page buttons to go back; Esc only closes details or cancels input listening."
			_:
				text = "The Options menu handles back, settings, help, and main menu navigation."
	match context:
		"editor":
			if editor_summary_label != null:
				editor_summary_label.text = text
		"saved_units":
			if saved_unit_hint_label != null:
				saved_unit_hint_label.text = text
		"scout":
			if scout_hint_label != null:
				scout_hint_label.text = text
		"settings":
			if settings_rebind_status_label != null:
				settings_rebind_status_label.text = text
		_:
			_show_battle_message(text, 3.0)


func _build_music_system() -> void:
	if not is_inside_tree() or not _audio_system_enabled():
		return
	var stream := AudioStreamGenerator.new()
	stream.mix_rate = 22050
	stream.buffer_length = 0.24
	music_player = AudioStreamPlayer.new()
	music_player.name = "ProceduralMusic"
	music_player.stream = stream
	music_player.volume_db = -20.0
	add_child(music_player)
	music_player.play()
	music_playback = music_player.get_stream_playback()


func _audio_system_enabled() -> bool:
	return DisplayServer.get_name() != "headless"


func _shutdown_audio_system() -> void:
	music_playback = null
	var player := music_player
	music_player = null
	if player != null and is_instance_valid(player):
		player.stop()
		player.stream = null
		var parent := player.get_parent()
		if parent != null:
			parent.remove_child(player)
		player.free()


func _play_sfx_wave(kind: String, pitch: float, duration: float, volume_db: float = -12.0) -> void:
	if not is_inside_tree() or not _audio_system_enabled():
		return
	var stream := AudioStreamGenerator.new()
	stream.mix_rate = 22050
	stream.buffer_length = maxf(0.05, duration + 0.08)
	var player := AudioStreamPlayer.new()
	player.name = "SFX_%s" % kind
	player.stream = stream
	player.volume_db = volume_db
	add_child(player)
	player.play()
	var playback: AudioStreamGeneratorPlayback = player.get_stream_playback()
	if playback == null:
		player.queue_free()
		return
	var frames: int = mini(playback.get_frames_available(), int(duration * 22050.0))
	for i in range(frames):
		var t := float(i) / 22050.0
		var n := t / maxf(0.001, duration)
		var env := sin(clampf(n, 0.0, 1.0) * PI)
		var sample := 0.0
		match kind:
			"tear":
				sample = (sin((pitch + n * 520.0) * t * TAU) * 0.12 + sin((pitch * 1.7) * t * TAU) * 0.05) * env
			"blunt":
				sample = sin((pitch * (1.0 - n * 0.38)) * t * TAU) * 0.22 * pow(1.0 - n, 1.8)
			"pierce":
				sample = sin((pitch + 900.0) * t * TAU) * 0.12 * pow(1.0 - n, 0.75)
			"chemical":
				sample = (sin(pitch * t * TAU) + sin((pitch * 1.035 + sin(t * 90.0) * 18.0) * t * TAU)) * 0.08 * env
			"chem_splash":
				var fizz := sin((pitch * 0.72 + sin(t * 180.0) * 44.0) * t * TAU)
				var drip := sin((pitch * 1.9 + n * 180.0) * t * TAU)
				sample = (fizz * 0.1 + drip * 0.035) * env
			"laser":
				sample = sin((pitch + n * 1100.0) * t * TAU) * 0.11 * env
			"bullet":
				sample = sin((pitch * 0.55) * t * TAU) * 0.18 * pow(1.0 - n, 3.0)
				if n < 0.08:
					sample += 0.22 * (1.0 - n / 0.08)
			"true_bullet":
				sample = sin((pitch * 0.38 + n * 260.0) * t * TAU) * 0.18 * pow(1.0 - n, 2.7)
				if n < 0.045:
					sample += 0.34 * (1.0 - n / 0.045)
			"bullet_hell":
				sample = sin((pitch * 0.68 + n * 120.0) * t * TAU) * 0.12 * pow(1.0 - n, 2.1)
				if n < 0.06:
					sample += 0.12 * (1.0 - n / 0.06)
			"missile":
				sample = (sin((pitch * 0.42 + n * 70.0) * t * TAU) * 0.13 + sin((pitch * 0.18) * t * TAU) * 0.09) * env
			"explosion":
				var thump := sin((pitch * (1.0 - n * 0.55)) * t * TAU) * 0.26 * pow(1.0 - n, 1.65)
				var crack := sin((pitch * 2.8 + n * 680.0) * t * TAU) * 0.06 * env
				sample = thump + crack
			"identity":
				sample = (sin(pitch * t * TAU) * 0.12 + sin((pitch * 1.5 + n * 220.0) * t * TAU) * 0.06) * env
			"web":
				sample = (sin((pitch + n * 120.0) * t * TAU) * 0.09 + sin((pitch * 2.4) * t * TAU) * 0.025) * env
			"blind":
				sample = (sin((pitch * 0.5) * t * TAU) * 0.08 + sin((pitch * 1.8 + sin(n * TAU) * 70.0) * t * TAU) * 0.05) * env
			"alarm":
				var gate := 1.0 if fmod(n * 5.0, 1.0) < 0.52 else 0.18
				sample = sin((pitch + gate * 85.0) * t * TAU) * 0.19 * gate * pow(1.0 - n, 0.45)
			_:
				sample = sin(pitch * t * TAU) * 0.1 * env
		playback.push_frame(Vector2(sample, sample))
	get_tree().create_timer(duration + 0.09).timeout.connect(player.queue_free)


func _play_projectile_launch_sfx(event: Dictionary) -> void:
	var style := String(event.get("projectile_style", ""))
	var damage_type := String(event.get("damage_type", "bullet"))
	if style == "true_bullet":
		_play_sfx_wave("true_bullet", 920.0, 0.11, -17.0)
	elif style == "bullet_hell":
		_play_sfx_wave("bullet_hell", 560.0 + randf_range(-40.0, 40.0), 0.075, -19.0)
	elif style in ["beam", "chaos"] or damage_type == "laser":
		_play_sfx_wave("laser", 1060.0, 0.12, -18.0)
	elif style == "spray" or damage_type == "chemical":
		_play_sfx_wave("chem_splash", 280.0, 0.19, -17.0)
	elif style == "missile":
		_play_sfx_wave("missile", 220.0, 0.26, -17.0)
	elif style in ["explosive", "blast"]:
		_play_sfx_wave("explosion", 190.0, 0.32, -13.0)


func _play_hit_sfx(damage_type: String, projectile_style: String, nullified: bool, tier: int) -> void:
	if nullified:
		_play_sfx_wave("blunt", 140.0, 0.1, -18.0)
		return
	if projectile_style == "true_bullet":
		_play_sfx_wave("true_bullet", 720.0 + float(tier) * 55.0, 0.13, -12.0)
		return
	if projectile_style == "bullet_hell":
		_play_sfx_wave("bullet_hell", 440.0 + float(tier) * 44.0, 0.09, -14.0)
		return
	if projectile_style == "spray":
		_play_sfx_wave("chem_splash", 260.0 + float(tier) * 30.0, 0.26, -12.0)
		return
	if projectile_style == "missile":
		_play_sfx_wave("missile", 260.0 + float(tier) * 32.0, 0.34, -10.0)
		return
	if projectile_style in ["explosive", "blast"]:
		_play_sfx_wave("explosion", 210.0 + float(tier) * 32.0, 0.36, -8.5)
		return
	if projectile_style == "web" or projectile_style == "web_snap":
		_play_sfx_wave("web", 460.0 + float(tier) * 36.0, 0.18, -12.0)
		return
	if projectile_style == "blind":
		_play_sfx_wave("blind", 260.0 + float(tier) * 24.0, 0.32, -11.0)
		return
	var pitch_map := {
		"tear": 720.0,
		"blunt": 190.0,
		"pierce": 1180.0,
		"chemical": 310.0,
		"laser": 880.0,
		"bullet": 360.0,
	}
	var duration_map := {
		"tear": 0.16,
		"blunt": 0.2,
		"pierce": 0.11,
		"chemical": 0.28,
		"laser": 0.12,
		"bullet": 0.09,
	}
	_play_sfx_wave(damage_type, float(pitch_map.get(damage_type, 440.0)) + float(tier) * 42.0, float(duration_map.get(damage_type, 0.14)), -13.0)


func _update_music() -> void:
	if music_playback == null:
		return
	var frames := music_playback.get_frames_available()
	var mix_rate := 22050.0
	var tempo := 0.78
	var root_freq := 54.0
	var shimmer := 0.018
	if game_state == STATE_EDITOR or game_state == STATE_SAVED_UNITS:
		tempo = 0.55
		root_freq = 48.0
		shimmer = 0.026
	elif game_state == STATE_BATTLE:
		tempo = 1.22
		root_freq = 62.0
		shimmer = 0.034
	elif game_state == STATE_SETTINGS:
		tempo = 0.44
		root_freq = 42.0
		shimmer = 0.014
	for i in range(frames):
		music_phase = fmod(music_phase + root_freq / mix_rate, 1.0)
		music_beat_phase = fmod(music_beat_phase + tempo / mix_rate, 1.0)
		var bass := sin(music_phase * TAU) * 0.065
		var fifth := sin(music_phase * TAU * 1.5) * 0.025
		var pulse := 1.0 if music_beat_phase < 0.035 else 0.0
		var metallic := sin((music_phase * 7.0 + music_beat_phase * 3.0) * TAU) * shimmer
		var sample := (bass + fifth + metallic + pulse * 0.08) * (0.6 if game_state != STATE_BATTLE else 0.9)
		music_playback.push_frame(Vector2(sample, sample))


