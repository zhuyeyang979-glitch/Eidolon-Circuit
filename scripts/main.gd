func _module_action_data_line(part: Dictionary, profile: String, command_profile: String, zh: bool) -> String:
	var data: Array = []
	var variant_label := String(part.get("module_variant_label", "")) if zh else String(part.get("module_variant_label_en", part.get("module_variant_label", "")))
	if variant_label != "":
		data.append(variant_label)
	var startup := float(part.get("startup_ratio", 0.0))
	var recovery := float(part.get("recovery_ratio", 0.0))
	if startup > 0.0:
		data.append(("启动%.0f%%" if zh else "start %.0f%%") % (startup * 100.0))
	if recovery > 0.0:
		data.append(("恢复%.0f%%" if zh else "recover %.0f%%") % (recovery * 100.0))
	var arc := float(part.get("swing_arc_degrees", 0.0))
	if arc > 0.0:
		data.append(("弧%.0f°" if zh else "arc %.0f deg") % arc)
	var extension := float(part.get("module_extension_m", part.get("required_extension_m", 0.0)))
	if extension > 0.0:
		data.append(("伸%.1fm" if zh else "extend %.1fm") % extension)
	var special_heat := float(part.get("special_heat_fraction", 0.0))
	if special_heat > 0.0:
		data.append(("必杀热%.0f%%" if zh else "special heat %.0f%%") % (special_heat * 100.0))
	elif float(part.get("armor_heat", 0.0)) > 0.0 or float(part.get("active_heat", 0.0)) > 0.0:
		data.append(("热%.0f/%.0f" if zh else "heat %.0f/%.0f") % [float(part.get("armor_heat", 0.0)), float(part.get("active_heat", 0.0))])
	if _gun_activation_profiles().has(profile):
		if profile == "missile_lock_activate":
			data.append(("锁定锥%.0f°" if zh else "cone %.0f deg") % float(part.get("missile_lock_cone_degrees", 0.0)))
		elif profile == "laser_beam_activate":
			data.append(("间隔%.2fs" if zh else "tick %.2fs") % float(part.get("laser_tick_interval", STANDARD_LASER_FIRE_INTERVAL)))
		elif float(part.get("module_range", 0.0)) > 0.0:
			data.append(("射程%.1fm" if zh else "range %.1fm") % float(part.get("module_range", 0.0)))
		data.append("弹药/热量看绑定武器" if zh else "ammo/heat from bound weapon")
	match String(part.get("module_variant_key", "")):
		"balance_string":
			data.append(("换肢%.0f%%CD" if zh else "next limb %.0f%% CD") % (float(part.get("combo_balance_cooldown_mult", 1.0)) * 100.0))
		"vise_close":
			data.append(("压制%.2fs" if zh else "pin %.2fs") % float(part.get("clamp_pin_seconds", 0.0)))
		"pickup_dash":
			data.append(("推进%.2f" if zh else "dash %.2f") % float(part.get("pickup_dash_impulse", 0.0)))
		"crush_windup":
			data.append(("动量%.2fx" if zh else "mom %.2fx") % float(part.get("crush_contact_momentum_mult", 1.0)))
		"feint_thrust":
			data.append(("再瞄%.0f°" if zh else "retarget %.0f deg") % float(part.get("feint_retarget_degrees", 0.0)))
		"explosive_arc_salvo":
			data.append(("落点%.1f-%.1fm" if zh else "mark %.1f-%.1fm") % [float(part.get("salvo_arc_min_range", 0.0)), float(part.get("salvo_arc_max_range", 0.0))])
	if data.is_empty():
		data.append("数据随绑定部位与动力预算结算" if zh else "stats resolve from target and drive budget")
	return ("数据：" if zh else "Data: ") + " / ".join(data) + "。"


func _hover_card_module_stat_entries(part: Dictionary) -> Array:
	var entries: Array = []
	var model := _module_action_card_model(part)
	_add_hover_stat(entries, "价格" if _ui_is_zh() else "Cost", float(part.get("cost", 0.0)), 180.0, "", Color(1.0, 0.84, 0.24, 1.0), "cost")
	_add_hover_stat_text(entries, "分类" if _ui_is_zh() else "Type", String(model.get("category_label", "")), Color(0.78, 0.88, 1.0, 1.0), "software")
	_add_hover_stat_text(entries, "输入" if _ui_is_zh() else "Input", String(model.get("input_short", "X")), Color(0.72, 0.98, 0.82, 1.0), "input")
	_add_hover_stat_text(entries, "关节" if _ui_is_zh() else "Joint", String(model.get("joint_short", "")), Color(0.42, 0.98, 1.0, 1.0), String(model.get("joint_icon", "joint_ball")))
	_add_hover_stat_text(entries, "武器" if _ui_is_zh() else "Weapon", String(model.get("weapon_short", "")), Color(1.0, 0.72, 0.28, 1.0), String(model.get("weapon_icon", "weapon_blunt")))
	var startup := float(part.get("startup_ratio", 0.0))
	var recovery := float(part.get("recovery_ratio", 0.0))
	if startup > 0.0:
		_add_hover_stat(entries, "启动" if _ui_is_zh() else "Start", startup * 100.0, 100.0, "%", Color(1.0, 0.58, 0.24, 1.0), "action")
	else:
		_add_hover_stat_text(entries, "启动" if _ui_is_zh() else "Start", "按住" if _ui_is_zh() and _gun_activation_profiles().has(String(model.get("profile", ""))) else ("Hold" if _gun_activation_profiles().has(String(model.get("profile", ""))) else "X"), Color(1.0, 0.58, 0.24, 1.0), "action")
	if recovery > 0.0:
		_add_hover_stat(entries, "恢复" if _ui_is_zh() else "Recover", recovery * 100.0, 100.0, "%", Color(0.52, 0.78, 1.0, 1.0), "cool")
	else:
		_add_hover_stat_text(entries, "结束" if _ui_is_zh() else "End", "松开" if _ui_is_zh() and _gun_activation_profiles().has(String(model.get("profile", ""))) else ("Release" if _gun_activation_profiles().has(String(model.get("profile", ""))) else "Pose"), Color(0.52, 0.78, 1.0, 1.0), "cool")
	_add_hover_stat_text(entries, "伤害结算" if _ui_is_zh() else "Damage Resolve", String(model.get("damage_source", "")), Color(1.0, 0.72, 0.34, 1.0), String(model.get("source_icon", "contact")))
	var heat := float(part.get("special_heat_fraction", 0.0)) * 100.0
	if heat <= 0.0:
		heat = maxf(float(part.get("armor_heat", 0.0)), float(part.get("active_heat", 0.0)))
	if heat > 0.0:
		_add_hover_stat(entries, "热量" if _ui_is_zh() else "Heat", heat, 60.0, "%" if float(part.get("special_heat_fraction", 0.0)) > 0.0 else "", Color(1.0, 0.3, 0.18, 1.0), "heat")
	elif float(part.get("swing_arc_degrees", 0.0)) > 0.0:
