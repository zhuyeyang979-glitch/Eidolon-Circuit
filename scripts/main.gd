func _boost_duration_for_stats(stats: Dictionary) -> float:
	if stats.has("boost_duration"):
		var explicit_duration := float(stats.get("boost_duration", 0.0))
		if explicit_duration > 0.0:
			return explicit_duration
	return ECONOMY_THRUSTER_TARGET_DURATION if float(stats.get("thruster_boost_extra_demand", 0.0)) > 0.0 else 0.0


func _apply_thruster_momentum_stats(stats: Dictionary, role_key: String) -> void:
	if role_key == "barrier":
		stats["move_momentum"] = 0.0
		stats["boost_momentum"] = 0.0
		stats["boost_total_momentum"] = 0.0
		stats["thruster_boost_extra_demand"] = 0.0
		stats["thruster_boost_peak_demand"] = 0.0
		stats["thruster_effective_drive_demand"] = 0.0
		stats["thruster_effective_boost_peak_demand"] = 0.0
		stats["engine_drive_chain_ratio"] = 0.0
		stats["engine_boost_chain_ratio"] = 0.0
		stats["move_speed"] = 0.0
		stats["move_acceleration"] = 0.0
		stats["boost_speed"] = 0.0
		stats["boost_duration"] = 0.0
		stats["speedometer_max_speed"] = 0.0
		stats["speed_limit"] = 0.0
	var mass := maxf(1.0, float(stats.get("mass", 1.0)))
	var legacy_allocated_momentum := maxf(0.0, float(stats.get("thruster_allocated_momentum", 0.0)))
	var legacy_direct_stats := not stats.has("thruster_drive_demand") and legacy_allocated_momentum > 0.0
	var drive_demand := maxf(0.0, float(stats.get("thruster_drive_demand", legacy_allocated_momentum)))
	var drive_chain_default := 1.0 if legacy_direct_stats else 0.0
	var drive_chain_ratio := clampf(float(stats.get("engine_drive_chain_ratio", drive_chain_default)), 0.0, 1.0)
	var allocated_momentum := maxf(0.0, float(stats.get("thruster_effective_drive_demand", legacy_allocated_momentum if legacy_direct_stats else drive_demand * drive_chain_ratio)))
	var efficiency_weight := maxf(0.0, float(stats.get("thruster_efficiency_weight", 0.0)))
	var move_efficiency := clampf(float(stats.get("move_efficiency", 1.0)), 0.2, 3.0)
	var boost_efficiency := clampf(float(stats.get("boost_efficiency", ECONOMY_BOOST_MOMENTUM_MULT)), 0.2, 4.0)
	var turn_efficiency := clampf(float(stats.get("turn_efficiency", 1.0)), 0.2, 3.0)
	var brake_efficiency := clampf(float(stats.get("brake_efficiency", 1.0)), 0.2, 3.0)
	if efficiency_weight > 0.001:
		move_efficiency = clampf(float(stats.get("move_efficiency_sum", 0.0)) / efficiency_weight, 0.2, 3.0)
		boost_efficiency = clampf(float(stats.get("boost_efficiency_sum", 0.0)) / efficiency_weight, 0.2, 4.0)
		turn_efficiency = clampf(float(stats.get("turn_efficiency_sum", 0.0)) / efficiency_weight, 0.2, 3.0)
	var thruster_momentum := allocated_momentum * move_efficiency
	var boost_extra_demand := maxf(0.0, float(stats.get("thruster_boost_extra_demand", stats.get("boost_momentum", 0.0))))
	var boost_peak_demand := maxf(0.0, float(stats.get("thruster_boost_peak_demand", drive_demand + boost_extra_demand)))
	if boost_peak_demand <= 0.0:
		boost_peak_demand = drive_demand + boost_extra_demand
	var boost_chain_ratio := clampf(float(stats.get("engine_boost_chain_ratio", drive_chain_ratio)), 0.0, 1.0)
	var effective_boost_peak := maxf(0.0, float(stats.get("thruster_effective_boost_peak_demand", boost_peak_demand * boost_chain_ratio)))
	var boost_momentum := boost_extra_demand
	var boost_duration := _boost_duration_for_stats(stats)
	var boost_total_momentum := 0.0
	if boost_extra_demand > 0.0 and effective_boost_peak > 0.0 and boost_duration > 0.0 and boost_efficiency > 0.0:
		boost_total_momentum = maxf(0.0, effective_boost_peak * boost_efficiency)
	var thruster_acceleration := thruster_momentum / mass
	var body_move_speed := maxf(0.0, thruster_acceleration)
	var boost_speed := maxf(0.0, boost_total_momentum / mass)
	var torso_speed_mult := maxf(0.25, float(stats.get("speedometer_mult", stats.get("speed_limit_mult", 1.0))))
	var derived_speed_limit := maxf(1.0, maxf(body_move_speed * 3.0, boost_speed * 2.0) * 1.5 * torso_speed_mult)
	var speedometer_max_speed := derived_speed_limit
	stats["move_momentum"] = thruster_momentum
	stats["boost_momentum"] = boost_extra_demand
	stats["boost_total_momentum"] = boost_total_momentum
	stats["thruster_drive_demand"] = drive_demand
	stats["thruster_boost_extra_demand"] = boost_extra_demand
	stats["thruster_boost_peak_demand"] = boost_peak_demand
	stats["thruster_effective_drive_demand"] = allocated_momentum
	stats["thruster_effective_boost_peak_demand"] = effective_boost_peak
	stats["engine_drive_chain_ratio"] = drive_chain_ratio
	stats["engine_boost_chain_ratio"] = boost_chain_ratio
	stats["move_speed"] = body_move_speed
	stats["move_acceleration"] = thruster_acceleration
	stats["body_move_speed"] = body_move_speed
	stats["thruster_acceleration"] = thruster_acceleration
	stats["boost_speed"] = boost_speed
	stats["move_efficiency"] = move_efficiency
	stats["boost_efficiency"] = boost_efficiency
	stats["turn_efficiency"] = turn_efficiency
	stats["brake_efficiency"] = brake_efficiency
	stats["speedometer_max_speed"] = speedometer_max_speed
	stats["speed_limit"] = speedometer_max_speed
	stats["boost_duration"] = boost_duration
	stats["brake_power"] = maxf(0.0, (allocated_momentum * brake_efficiency) / mass) if legacy_direct_stats else maxf(0.0, effective_boost_peak / mass)
	if body_move_speed > 0.0:
		stats["speed"] = body_move_speed / MOMENTUM_MOVE_SPEED_MULT
	if drive_system_service != null:
		drive_system_service.apply_drive_contract(stats, role_key)


func _apply_drive_motion_stats(stats: Dictionary, role_key: String) -> void:
	_apply_thruster_momentum_stats(stats, role_key)


func _estimated_boost_attack_speed(stats: Dictionary) -> float:
	var stat_boost_speed := float(stats.get("boost_speed", 0.0))
	if stat_boost_speed > 0.0:
		return stat_boost_speed
	var mass := maxf(1.0, float(stats.get("mass", 1.0)))
	return maxf(0.0, float(stats.get("boost_total_momentum", 0.0))) / mass


func _group_limb_end_mass(group: Dictionary, stats: Dictionary) -> float:
	var terminal_mass := maxf(0.0, float(group.get("terminal_weapon_mass", group.get("mass", 0.0))))
	var muscle_mass := maxf(0.0, float(group.get("muscle_mass", 0.0)))
	var fallback_mass := maxf(0.6, float(stats.get("mass", 8.0)) * 0.12)
	return maxf(0.45, terminal_mass + muscle_mass * 0.72 + fallback_mass * 0.18)


func _group_joint_equivalent_mass(stats: Dictionary, group: Dictionary) -> float:
	var end_mass := _group_limb_end_mass(group, stats)
	var body_mass := maxf(1.0, float(stats.get("mass", 1.0)) - end_mass * 0.35)
	return maxf(0.45, (end_mass * body_mass) / maxf(0.001, end_mass + body_mass))


func _group_joint_actuation_speed(stats: Dictionary, group: Dictionary, state_key: String = "normal") -> float:
	var output_momentum := maxf(0.0, float(group.get("fixed_output_momentum", 0.0)))
	if output_momentum <= 0.0:
		var joint_power := maxf(0.08, float(group.get("joint_power", 0.0)))
		if joint_power <= 0.081:
			joint_power = 0.72 + float(group.get("joint_range", 0.0)) * 1.6 + float(group.get("range_mult", 1.0)) * 0.22 + float(stats.get("cancel_power", 0.0)) * 0.75
		output_momentum = joint_power * 145.0
	var driven_mass := _group_limb_end_mass(group, stats)
	var motion := String(group.get("motion", "straight"))
	var motion_mult := 1.0
	if motion.contains("chain"):
		motion_mult = 1.18
	elif motion in ["pendulum", "swing_aim", "auto_swing", "pincer_clamp"]:
		motion_mult = 1.08
	elif motion.contains("thrust") or motion.contains("突击"):
		motion_mult = 1.12
	var speed_bonus := 1.0 + clampf(float(group.get("swing_speed_bonus", 0.0)), -0.45, 0.75)
	var overload := maxf(1.0, float(stats.get("load_overload_ratio", 1.0)))
	var speed := output_momentum * motion_mult * speed_bonus * _state_momentum_mult(state_key) / maxf(0.45, driven_mass)
	return clampf(speed / sqrt(overload), 0.03, 5.4)


func _melee_module_heat_key(group: Dictionary, attack_index: int) -> String:
	var module_name := String(group.get("module_name", ""))
	if module_name != "":
		return module_name
	var profile := String(group.get("module_action_profile", ""))
	if profile != "":
		return profile
	var effect := String(group.get("module_effect", ""))
	if effect != "":
		return effect
	return "%s:%d" % [String(group.get("motion", "melee")), attack_index]


func _melee_module_repeat_info(attacker, group: Dictionary, attack_index: int) -> Dictionary:
	var now := battle_simulation_time_seconds
	var key := _melee_module_heat_key(group, attack_index)
	var ledger: Dictionary = {}
	if attacker.has_meta("melee_module_heat_ledger") and attacker.get_meta("melee_module_heat_ledger") is Dictionary:
		ledger = attacker.get_meta("melee_module_heat_ledger").duplicate(true)
	var previous: Dictionary = ledger.get(key, {})
	var last_time := float(previous.get("time", -999.0))
	var previous_stack := int(previous.get("stack", 0))
	var last_sequence_key := String(attacker.get_meta("last_melee_module_heat_key", ""))
	var within_window := last_sequence_key == key and now - last_time <= MELEE_MODULE_HEAT_WINDOW_SECONDS
	var stack := clampi(previous_stack if within_window else 0, 0, MELEE_MODULE_REPEAT_HEAT_MAX_STACK)
	var same_frame_pair := bool(group.get("requires_joint_pair", false)) and within_window and now - last_time < 0.05
	if not same_frame_pair:
		ledger[key] = {
			"time": now,
			"stack": clampi(stack + 1, 0, MELEE_MODULE_REPEAT_HEAT_MAX_STACK),
		}
		attacker.set_meta("last_melee_module_heat_key", key)
	else:
		ledger[key] = previous
	attacker.set_meta("melee_module_heat_ledger", ledger)
	return {
		"key": key,
		"stack": stack,
		"mult": 1.0 + float(stack) * MELEE_MODULE_REPEAT_HEAT_STEP,
		"consecutive_same": last_sequence_key == key,
	}


func _apply_melee_module_heat(attacker, event: Dictionary, group: Dictionary, attack_index: int) -> void:
	var repeat_info := _melee_module_repeat_info(attacker, group, attack_index) if attacker != null and is_instance_valid(attacker) else {}
	event["module_heat_raw"] = 0.0
	event["module_heat_cooling_offset"] = 0.0
	event["module_heat_repeat_stack"] = int(repeat_info.get("stack", 0))
	event["module_heat_repeat_mult"] = 1.0
	event["module_heat_consecutive_same"] = bool(repeat_info.get("consecutive_same", false))
	event["module_cancel_heat_reward"] = bool(event.get("module_cancel", false))
	event["module_heat_cost"] = 0.0
	event["terminal_momentum_mult"] = _terminal_momentum_multiplier(group)
	if attacker != null and is_instance_valid(attacker):
		attacker.set_meta("last_module_heat_cost", 0.0)
		attacker.set_meta("last_module_heat_repeat_stack", int(repeat_info.get("stack", 0)))


func _momentum_damage_for_event(attacker, event: Dictionary) -> float:
	if attacker == null or not is_instance_valid(attacker) or bool(event.get("projectile", false)):
		return float(event.get("damage", 0.0))
	var stats: Dictionary = attacker.stats
	var group: Dictionary = event.get("collision_group", {})
	var state_key := String(event.get("state", "normal"))
	var coeff := maxf(0.0, float(event.get("weapon_damage_coeff", _weapon_damage_coefficient(float(event.get("damage", 1.0)), group, state_key))))
	var velocity_info := _active_melee_momentum_velocity(attacker, event)
	var attack_collider := _attack_collider_for_event(attacker, event)
	if not attack_collider.is_empty():
		coeff = _runtime_contact_part_damage_coeff(attack_collider) * _state_momentum_mult(state_key)
	var attack_speed := maxf(0.0, float(velocity_info.get("net_speed", 0.0)))
	var collider_velocity: Vector2 = velocity_info.get("collider_velocity", Vector2.ZERO)
	if attack_speed < 0.04:
		event["momentum"] = 0.0
		_set_event_momentum_vector(event, Vector2.ZERO, 0.0)
		event["momentum_attack_speed"] = attack_speed
		event["momentum_body_speed"] = float(velocity_info.get("body_speed", 0.0))
		event["momentum_component_speed"] = float(velocity_info.get("component_speed", 0.0))
		event["momentum_net_speed"] = attack_speed
		return 0.0
	var terminal_momentum_mult := _terminal_momentum_multiplier(group)
	var momentum := maxf(1.0, float(stats.get("mass", 1.0))) * attack_speed * terminal_momentum_mult
	momentum *= maxf(0.1, float(event.get("contact_momentum_mult", 1.0)))
	var fallback_stiffness := maxf(0.0, float(stats.get("stiffness", 0.0)))
	if fallback_stiffness <= 1.0 and not group.has("group_stiffness"):
		fallback_stiffness = maxf(MOMENTUM_STIFFNESS_UNIT, momentum * 0.92)
	var stiffness := maxf(1.0, float(event.get("group_stiffness", group.get("group_stiffness", fallback_stiffness))))
	var overload_penalty := clampf(stiffness / maxf(stiffness, momentum), 0.42, 1.0)
	event["momentum"] = momentum
	var momentum_direction: Vector2 = collider_velocity.normalized() if collider_velocity.length() > 0.001 else Vector2(velocity_info.get("direction", Vector2.RIGHT))
	if momentum_direction.length() <= 0.001:
		momentum_direction = Vector2(float(attacker.facing), 0.0)
	_set_event_momentum_vector(event, momentum_direction.normalized() * momentum, momentum)
	event["momentum_velocity_vector"] = collider_velocity
	event["momentum_attack_speed"] = attack_speed
	event["momentum_body_speed"] = float(velocity_info.get("body_speed", 0.0))
	event["momentum_component_speed"] = float(velocity_info.get("component_speed", 0.0))
	event["momentum_net_speed"] = attack_speed
	event["terminal_momentum_mult"] = terminal_momentum_mult
	return maxf(1.0, momentum * coeff * MOMENTUM_DAMAGE_SCALE * overload_penalty)


func _active_melee_momentum_velocity(attacker, event: Dictionary) -> Dictionary:
	var direction := Vector2(float(attacker.facing), 0.0)
	if event.has("direction") and event["direction"] is Vector2:
		direction = event["direction"]
	if direction.length() <= 0.01:
		direction = Vector2(float(attacker.facing), 0.0)
	direction = direction.normalized()
	var body_velocity: Vector2 = attacker.velocity
	var collider_velocity := body_velocity
	var attack_collider := _attack_collider_for_event(attacker, event)
	var has_collider := not attack_collider.is_empty()
	if has_collider:
		collider_velocity = _contact_collider_velocity(attacker, attack_collider)
		var runtime_module_speed := 0.0
		if bool(event.get("runtime_direct_module", false)):
			runtime_module_speed = maxf(runtime_module_speed, float(event.get("joint_actuation_speed", 0.0)))
			var output_momentum := maxf(0.0, float(event.get("fixed_output_momentum", 0.0)))
			if output_momentum > 0.0:
				runtime_module_speed = maxf(runtime_module_speed, output_momentum / maxf(1.0, float(attacker.stats.get("mass", 1.0))))
		if runtime_module_speed > 0.0 and collider_velocity.length() < runtime_module_speed:
			collider_velocity = direction * runtime_module_speed + body_velocity.project(direction)
	else:
		var synthetic_component := direction * (maxf(0.0, float(event.get("joint_actuation_speed", 0.0))) * 0.08)
		collider_velocity = body_velocity + synthetic_component
	var net_speed := collider_velocity.length()
	var net_axis := collider_velocity.normalized() if net_speed > 0.001 else direction
	var body_speed := body_velocity.dot(net_axis)
	var component_speed := net_speed - body_speed
	return {
		"direction": direction,
		"body_speed": body_speed,
		"component_speed": component_speed,
		"net_speed": maxf(0.0, net_speed),
		"raw_net_speed": net_speed,
		"collider_velocity": collider_velocity,
	}


func _melee_damage_adjusted(event: Dictionary, damage: int) -> int:
	if damage <= 0 or bool(event.get("projectile", false)):
		return damage
	var adjustments := _battle_hit_resolution_service().melee_type_adjustments(String(event.get("damage_type", "blunt")))
	return maxi(1, int(roundf(float(damage) * float(adjustments.get("damage_adjustment", 1.0)))))


func _register_part_damage(target, event: Dictionary, damage: int, counter_tier: int) -> void:
	var route := _battle_hit_resolution_service().part_damage_intent({
		"mode": "route",
		"target_valid": target != null and is_instance_valid(target),
		"target_mech": _unit_is_mech_physics_subject(target) if target != null and is_instance_valid(target) else false,
		"projectile": bool(event.get("projectile", false)),
		"damage_type": String(event.get("damage_type", "")),
		"raw_index": int(event.get("target_part_index", event.get("muscle_node", -1))),
		"part_kind": String(event.get("target_part_kind", "core")),
		"torso_index": int(event.get("target_torso_unit_index", -1)),
		"attack_group_count": ATTACK_GROUP_COUNT,
	})
	match String(route.get("action", "none")):
		"route_torso":
			_register_torso_unit_damage(target, event, damage, counter_tier)
		"route_terminal":
			_register_terminal_part_damage(target, event, int(route.get("attack_index", 0)), damage, counter_tier)
		"route_limb":
			_register_limb_part_damage(target, event, int(route.get("attack_index", 0)), damage, counter_tier)


func _register_limb_part_damage(target, event: Dictionary, attack_index: int, damage: int, counter_tier: int) -> void:
	if target == null or not is_instance_valid(target):
		return
	var severed: Dictionary = {}
	if target.has_meta("severed_limbs") and target.get_meta("severed_limbs") is Dictionary:
		severed = target.get_meta("severed_limbs")
	var limb_key := str(attack_index)
	var max_limb_hp := _target_limb_max_hp(target, attack_index)
	var limb_hp: Dictionary = {}
	if target.has_meta("limb_hp") and target.get_meta("limb_hp") is Dictionary:
		limb_hp = target.get_meta("limb_hp")
	var intent := _battle_hit_resolution_service().part_damage_intent({
		"mode": "hp",
		"part_kind": "limb",
		"part_key": limb_key,
		"max_hp": max_limb_hp,
		"current_hp": float(limb_hp.get(limb_key, max_limb_hp)),
		"already_broken": bool(severed.get(limb_key, false)),
		"damage": damage,
		"counter_tier": counter_tier,
	})
	var action := String(intent.get("action", "none"))
	if action == "none":
		return
	limb_hp[limb_key] = float(intent.get("next_hp", limb_hp.get(limb_key, max_limb_hp)))
	target.set_meta("limb_hp", limb_hp)
	if String(intent.get("action", "")) == "update":
		if float(intent.get("flash_timer", 0.0)) > 0.0:
			target.set_meta("part_fail_flash", float(intent.get("flash_timer", 0.0)))
		return
	severed[limb_key] = true
	target.set_meta("severed_limbs", severed)
	target.set_meta("part_fail_flash", float(intent.get("flash_timer", 0.55)))
	_play_module_fail_sfx()
	_spawn_hit_effect(target, 2, "tear", false, "slash")
	_show_battle_message("%s limb %d severed by tearing strike" % [target.unit_name, attack_index + 1], 0.8)


