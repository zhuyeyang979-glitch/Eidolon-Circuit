func _terminal_weapon_category_path(part: Dictionary, slot_key: String, zh: bool) -> String:
	if slot_key != "muscle" or _terminal_weapon_kind_for_part(part, slot_key) == "":
		return ""
	if _part_is_ranged_terminal_weapon(part):
		return "武器 > 枪械 > %s" % _gun_family_label(part, zh) if zh else "Weapon > Gun > %s" % _gun_family_label(part, zh)
	if _component_is_blade_weapon(part):
		return "武器 > 近战 > 斩击 > %s" % _terminal_weapon_family_label(part, zh) if zh else "Weapon > Melee > Blade > %s" % _terminal_weapon_family_label(part, zh)
	if _component_is_blunt_weapon(part):
		return "武器 > 近战 > 钝击 > %s" % _terminal_weapon_family_label(part, zh) if zh else "Weapon > Melee > Blunt > %s" % _terminal_weapon_family_label(part, zh)
	if _component_is_pierce_weapon(part):
		return "武器 > 近战 > 戳刺 > %s" % _terminal_weapon_family_label(part, zh) if zh else "Weapon > Melee > Pierce > %s" % _terminal_weapon_family_label(part, zh)
	return "武器 > 近战" if zh else "Weapon > Melee"


func _terminal_weapon_short_category(part: Dictionary, zh: bool) -> String:
	if _part_is_ranged_terminal_weapon(part):
		return ("枪械>%s" if zh else "GUN>%s") % _gun_family_short_label(part, zh)
	if _component_is_blade_weapon(part):
		return ("近战>斩击" if zh else "MEL>BLADE")
	if _component_is_blunt_weapon(part):
		return ("近战>钝击" if zh else "MEL>BLUNT")
	if _component_is_pierce_weapon(part):
		return ("近战>戳刺" if zh else "MEL>PIERCE")
	return "近战" if zh else "MELEE"


func _component_is_torso(part: Dictionary) -> bool:
	return _unit_stats_service().component_is_torso(part)


func _component_is_brain_torso(part: Dictionary) -> bool:
	return _unit_stats_service().component_is_brain_torso(part)


func _part_can_damage_as_limb(part: Dictionary, slot_kind: String) -> bool:
	return slot_kind == "limb_muscle" and bool(part.get("whip_damage_part", false)) and float(part.get("normal_damage", 0.0)) > 0.0


func _motion_allows_limb_damage(motion: String) -> bool:
	return motion.contains("chain") or motion in ["pendulum", "swing_aim", "auto_swing", "pincer_clamp"]


func _apply_load_balance(stats: Dictionary) -> void:
	var capacity := maxf(0.0, float(stats.get("momentum_capacity", stats.get("load_capacity", 0.0))))
	stats["load_capacity"] = capacity
	stats["load_overload_ratio"] = 1.0
	stats["load_note"] = ""
	if bool(stats.get("dual_mount_module", false)):
		stats["recoil"] = float(stats.get("recoil", 0.06)) * float(stats.get("recoil_brace_mult", 1.0))
		stats["normal_cooldown"] = float(stats.get("normal_cooldown", 0.34)) * 0.92
		stats["active_cooldown"] = float(stats.get("active_cooldown", 0.74)) * 0.94

func _module_payload_index_set(unit_bp: Dictionary) -> Dictionary:
	var result := {}
	for raw_payload in Array(unit_bp.get("slot_payloads", [])):
		if not (raw_payload is Dictionary):
			continue
		var payload: Dictionary = raw_payload
		if String(payload.get("kind", "")) != "module":
			continue
		var module_index := int(payload.get("module", -1))
		if module_index >= 0:
			result[module_index] = true
	return result


func _module_indices_for_topology_node(node: Dictionary, unit_bp: Dictionary) -> Array:
	var indices: Array = []
	if node.has("modules") and node["modules"] is Array:
		for raw_index in Array(node["modules"]):
			indices.append(int(raw_index))
	elif _topology_node_is_component(node) and not node.has("module"):
		return indices
	else:
		indices.append(int(node.get("module", unit_bp.get("module", 0))))
	if indices.is_empty() and not _topology_node_is_component(node):
		indices.append(int(unit_bp.get("module", 0)))
	var payload_indices := _module_payload_index_set(unit_bp)
	var normalized: Array = []
	for raw_index in indices:
		var module_index := int(raw_index)
		if not payload_indices.is_empty() and not payload_indices.has(module_index):
			continue
		if not normalized.has(module_index):
			normalized.append(module_index)
	return normalized


func _set_topology_node_slot(node: Dictionary, slot_key: String, value: int) -> Dictionary:
	if _topology_node_is_component(node) and _is_topology_part_slot(slot_key):
		node["slot"] = slot_key
		node["part_index"] = value
		node[slot_key] = value
		var part := _selected_component(ROLE_ORDER[editor_role_index], slot_key, value)
		node["label"] = _topology_component_label(slot_key, part, int(node.get("id", editor_topology_node_index)))
		node["size_tier"] = PartArt.normalized_size_tier(part)
		if slot_key == "muscle" and _part_counts_as_terminal_weapon(part, "muscle"):
			node["terminal_weapon"] = true
			node["terminal_weapon_kind"] = _terminal_weapon_kind_for_part(part, "muscle")
			node["projectile"] = _terminal_weapon_kind_for_part(part, "muscle") == "ranged" and bool(part.get("projectile", false))
		else:
			node.erase("terminal_weapon")
			node.erase("terminal_weapon_kind")
			node.erase("projectile")
		node.erase("module")
		node.erase("modules")
		node.erase("attack_key")
		return node
	node[slot_key] = value
	if slot_key == "module":
		var modules: Array = Array(node.get("modules", []))
		if modules.is_empty():
			modules.append(value)
		else:
			modules[0] = value
		node["modules"] = modules
		node["module"] = value
		if _topology_node_is_component(node) and not _topology_node_is_torso(ROLE_ORDER[editor_role_index], node, _editor_current_blueprint()) and not node.has("attack_key"):
			node["attack_key"] = clampi(editor_topology_node_index + 1, 1, ATTACK_GROUP_COUNT)
	return node


func _module_parts_for_topology_node(role_key: String, node: Dictionary, unit_bp: Dictionary) -> Array:
	var parts: Array = []
	var catalog: Array = _catalog_for(role_key, "module")
	for module_index in _module_indices_for_topology_node(node, unit_bp):
		var module_part: Dictionary = catalog[clampi(int(module_index), 0, catalog.size() - 1)]
		parts.append(_economy_priced_component(module_part))
	return parts


func _primary_module_for_topology_node(role_key: String, node: Dictionary, unit_bp: Dictionary) -> Dictionary:
	var parts := _module_parts_for_topology_node(role_key, node, unit_bp)
	return parts[0] if not parts.is_empty() else _selected_component(role_key, "module", int(unit_bp.get("module", 0)))


func _merge_custom_topology_part_stats(stats: Dictionary, part: Dictionary, part_slot: String, part_scale: float, node: Dictionary = {}) -> void:
	var part_is_torso := _component_is_torso(part)
	var cost_scale := 1.0 if _topology_node_is_component(node) else part_scale
	stats["cost"] = int(stats["cost"]) + int(roundf(float(part.get("cost", 0)) * cost_scale))
	stats["health"] = int(stats["health"]) + int(roundf(float(part.get("hp", 0)) * part_scale))
	stats["mass"] = float(stats["mass"]) + float(part.get("mass", 0.0)) * part_scale
	if part_slot != "joint":
		stats["structural_mass"] = float(stats.get("structural_mass", 0.0)) + float(part.get("mass", 0.0)) * part_scale
	var part_power_load := 0.0 * part_scale
	stats["energy"] = float(stats["energy"]) + part_power_load
	stats["power_load"] = float(stats.get("power_load", 0.0)) + part_power_load
	stats["length"] = float(stats["length"]) + float(part.get("length", 0.0)) * part_scale
	stats["radius"] = float(stats["radius"]) + float(part.get("radius", 0.0)) * part_scale
	if not part_is_torso:
		stats["normal_damage"] = int(stats["normal_damage"]) + int(roundf(float(part.get("normal_damage", 0)) * part_scale))
		stats["armor_damage"] = int(stats["armor_damage"]) + int(roundf(float(part.get("armor_damage", 0)) * part_scale))
		stats["active_damage"] = int(stats["active_damage"]) + int(roundf(float(part.get("active_damage", 0)) * part_scale))
		stats["normal_range"] = float(stats["normal_range"]) + float(part.get("range", 0.0)) * part_scale
		stats["active_range"] = float(stats["active_range"]) + float(part.get("active_range", 0.0)) * part_scale
	var part_stiffness := _part_stiffness(part, part_slot) * part_scale
	stats["stiffness"] = float(stats.get("stiffness", 0.0)) + part_stiffness
	if part_slot == "joint":
		var part_momentum_capacity := _part_momentum_capacity(part, part_slot) * part_scale
		stats["momentum_capacity"] = float(stats.get("momentum_capacity", 0.0)) + part_momentum_capacity
		stats["load_capacity"] = float(stats.get("load_capacity", 0.0)) + part_momentum_capacity
		stats["max_joint_output_momentum"] = maxf(float(stats.get("max_joint_output_momentum", 0.0)), _joint_fixed_output_momentum(part) * part_scale)
	elif (part_slot == "limb_muscle" or part_slot == "muscle") and not part_is_torso:
		var embedded_profile := _embedded_joint_profile_for_part(part, part_slot)
		var embedded_capacity := float(embedded_profile.get("momentum_capacity", 0.0)) * part_scale
		stats["momentum_capacity"] = float(stats.get("momentum_capacity", 0.0)) + embedded_capacity
		stats["load_capacity"] = float(stats.get("load_capacity", 0.0)) + embedded_capacity
		stats["max_joint_output_momentum"] = maxf(float(stats.get("max_joint_output_momentum", 0.0)), float(embedded_profile.get("output_momentum", 0.0)) * part_scale)
	_merge_attitude_control_stats(stats, part, part_scale)
	_merge_torso_stiffness_segment_stats(stats, part, part_slot, part_scale, node)
	if _part_counts_as_terminal_weapon(part, part_slot):
		stats["terminal_weapon_mass"] = maxf(float(stats.get("terminal_weapon_mass", 0.0)), float(part.get("terminal_weapon_mass", part.get("mass", 0.0))) * lerpf(0.5, 1.0, part_scale))
		stats["requires_dual_mount"] = bool(stats.get("requires_dual_mount", false)) or bool(part.get("requires_dual_mount", false))
		stats["dual_mount_points"] = maxi(int(stats.get("dual_mount_points", 1)), int(part.get("dual_mount_points", 1)))
	if part.has("resist"):
		var part_resist: Dictionary = part["resist"]
		for damage_type in MELEE_DAMAGE_TYPES:
			var blended := lerpf(1.0, float(part_resist.get(damage_type, 1.0)), part_scale * 0.5)
			stats["resistances"][damage_type] = float(stats["resistances"][damage_type]) * blended
	if part.has("counter_tiers"):
		_merge_counter_tiers(stats, part["counter_tiers"])
	if part.has("data_security"):
		stats["data_security"] = float(stats["data_security"]) + float(part["data_security"]) * part_scale
	if part_is_torso:
		stats["module_slots"] = max(int(stats.get("module_slots", 0)), _torso_software_capacity_for_part(part))
		stats["torso_slots"] = max(int(stats.get("torso_slots", 0)), _torso_plugin_capacity_for_part(part))
	for capacity_key in ["joint_ports", "weapon_bays", "engine_slots", "booster_slots", "cooling_slots", "module_slots", "torso_slots", "spare_weapon_slots"]:
		if part.has(capacity_key):
			var capacity_value := int(part[capacity_key])
			if part_is_torso and capacity_key == "module_slots":
				capacity_value = _torso_software_capacity_for_part(part)
			elif part_is_torso and capacity_key == "torso_slots":
				capacity_value = _torso_plugin_capacity_for_part(part)
			stats[capacity_key] = max(int(stats.get(capacity_key, 0)), capacity_value)
	_merge_scaled_part_logic(stats, part, part_scale)


func _apply_custom_topology_stats(stats: Dictionary, role_key: String, unit_bp: Dictionary) -> void:
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if nodes.is_empty():
		return
	var part_scale := 0.55
	if _topology_uses_component_nodes(nodes):
		for node in nodes:
			if not (node is Dictionary):
				continue
			if not _topology_node_is_component(node):
				continue
			var slot_key := _topology_node_slot(node)
			var part := _topology_node_part(role_key, node, unit_bp)
			_merge_custom_topology_part_stats(stats, part, slot_key, part_scale, node)
			var module_parts := _module_parts_for_topology_node(role_key, node, unit_bp)
			var module_scale := 0.28 / maxf(1.0, sqrt(float(module_parts.size())))
			for module_part in module_parts:
				var module_power_load := 0.0 * module_scale
				stats["energy"] = float(stats["energy"]) + module_power_load
				stats["power_load"] = float(stats.get("power_load", 0.0)) + module_power_load
				if bool(module_part.get("dual_mount_module", false)):
					stats["dual_mount_module"] = true
					stats["dual_mount_load_mult"] = maxf(float(stats.get("dual_mount_load_mult", 1.0)), float(module_part.get("dual_mount_load_mult", 1.0)))
					stats["recoil_brace_mult"] = minf(float(stats.get("recoil_brace_mult", 1.0)), float(module_part.get("recoil_brace_mult", 1.0)))
				if module_part.has("data_security"):
					stats["data_security"] = float(stats["data_security"]) + float(module_part["data_security"]) * module_scale
				_merge_scaled_part_logic(stats, module_part, module_scale)
		_append_custom_torso_connector_stiffness_segments(stats, role_key, unit_bp)
		stats["topology_nodes"] = nodes.size()
		stats["topology_edges"] = Array(topology.get("edges", [])).size()
		return
	for node in nodes:
		if not (node is Dictionary):
			continue
		var joint_part := _selected_component(role_key, "joint", int(node.get("joint", unit_bp.get("joint", 0))))
		var limb_part := _selected_component(role_key, "limb_muscle", int(node.get("limb_muscle", unit_bp.get("limb_muscle", 0))))
		var muscle_part := _selected_component(role_key, "muscle", int(node.get("muscle", unit_bp.get("muscle", 0))))
		for part in [joint_part, limb_part, muscle_part]:
			var part_slot := "joint"
			if part == limb_part:
				part_slot = "limb_muscle"
			elif part == muscle_part:
				part_slot = "muscle"
			var part_is_torso := _component_is_torso(part)
			stats["cost"] = int(stats["cost"]) + int(roundf(float(part.get("cost", 0)) * part_scale))
			stats["health"] = int(stats["health"]) + int(roundf(float(part.get("hp", 0)) * part_scale))
			stats["mass"] = float(stats["mass"]) + float(part.get("mass", 0.0)) * part_scale
			if part_slot != "joint":
				stats["structural_mass"] = float(stats.get("structural_mass", 0.0)) + float(part.get("mass", 0.0)) * part_scale
			var part_power_load := 0.0 * part_scale
			stats["energy"] = float(stats["energy"]) + part_power_load
			stats["power_load"] = float(stats.get("power_load", 0.0)) + part_power_load
			stats["length"] = float(stats["length"]) + float(part.get("length", 0.0)) * part_scale
			stats["radius"] = float(stats["radius"]) + float(part.get("radius", 0.0)) * part_scale
			if not part_is_torso:
				stats["normal_damage"] = int(stats["normal_damage"]) + int(roundf(float(part.get("normal_damage", 0)) * part_scale))
				stats["armor_damage"] = int(stats["armor_damage"]) + int(roundf(float(part.get("armor_damage", 0)) * part_scale))
				stats["active_damage"] = int(stats["active_damage"]) + int(roundf(float(part.get("active_damage", 0)) * part_scale))
				stats["normal_range"] = float(stats["normal_range"]) + float(part.get("range", 0.0)) * part_scale
				stats["active_range"] = float(stats["active_range"]) + float(part.get("active_range", 0.0)) * part_scale
			var part_stiffness := _part_stiffness(part, part_slot) * part_scale
			stats["stiffness"] = float(stats.get("stiffness", 0.0)) + part_stiffness
			if part_slot == "joint":
				var part_momentum_capacity := _part_momentum_capacity(part, part_slot) * part_scale
				stats["momentum_capacity"] = float(stats.get("momentum_capacity", 0.0)) + part_momentum_capacity
				stats["load_capacity"] = float(stats.get("load_capacity", 0.0)) + part_momentum_capacity
				stats["max_joint_output_momentum"] = maxf(float(stats.get("max_joint_output_momentum", 0.0)), _joint_fixed_output_momentum(part) * part_scale)
			_merge_attitude_control_stats(stats, part, part_scale)
			_merge_torso_stiffness_segment_stats(stats, part, part_slot, part_scale)
			if _part_counts_as_terminal_weapon(part, part_slot):
				stats["terminal_weapon_mass"] = maxf(float(stats.get("terminal_weapon_mass", 0.0)), float(part.get("terminal_weapon_mass", part.get("mass", 0.0))) * lerpf(0.5, 1.0, part_scale))
				stats["requires_dual_mount"] = bool(stats.get("requires_dual_mount", false)) or bool(part.get("requires_dual_mount", false))
				stats["dual_mount_points"] = maxi(int(stats.get("dual_mount_points", 1)), int(part.get("dual_mount_points", 1)))
			if part.has("resist"):
				var part_resist: Dictionary = part["resist"]
				for damage_type in MELEE_DAMAGE_TYPES:
					var blended := lerpf(1.0, float(part_resist.get(damage_type, 1.0)), part_scale * 0.5)
					stats["resistances"][damage_type] = float(stats["resistances"][damage_type]) * blended
			if part.has("counter_tiers"):
				_merge_counter_tiers(stats, part["counter_tiers"])
			if part.has("data_security"):
				stats["data_security"] = float(stats["data_security"]) + float(part["data_security"]) * part_scale
			if part_is_torso:
				stats["module_slots"] = max(int(stats.get("module_slots", 0)), _torso_software_capacity_for_part(part))
				stats["torso_slots"] = max(int(stats.get("torso_slots", 0)), _torso_plugin_capacity_for_part(part))
			for capacity_key in ["joint_ports", "weapon_bays", "engine_slots", "booster_slots", "cooling_slots", "module_slots", "torso_slots", "spare_weapon_slots"]:
				if part.has(capacity_key):
					var capacity_value := int(part[capacity_key])
					if part_is_torso and capacity_key == "module_slots":
						capacity_value = _torso_software_capacity_for_part(part)
					elif part_is_torso and capacity_key == "torso_slots":
						capacity_value = _torso_plugin_capacity_for_part(part)
					stats[capacity_key] = max(int(stats.get(capacity_key, 0)), capacity_value)
			_merge_scaled_part_logic(stats, part, part_scale)
		var module_parts := _module_parts_for_topology_node(role_key, node, unit_bp)
		var module_scale := 0.35 / maxf(1.0, sqrt(float(module_parts.size())))
		for module_part in module_parts:
			stats["cost"] = int(stats["cost"]) + int(roundf(float(module_part.get("cost", 0)) * module_scale))
			var module_power_load := 0.0 * module_scale
			stats["energy"] = float(stats["energy"]) + module_power_load
			stats["power_load"] = float(stats.get("power_load", 0.0)) + module_power_load
			if bool(module_part.get("dual_mount_module", false)):
				stats["dual_mount_module"] = true
				stats["dual_mount_load_mult"] = maxf(float(stats.get("dual_mount_load_mult", 1.0)), float(module_part.get("dual_mount_load_mult", 1.0)))
				stats["recoil_brace_mult"] = minf(float(stats.get("recoil_brace_mult", 1.0)), float(module_part.get("recoil_brace_mult", 1.0)))
			if module_part.has("data_security"):
				stats["data_security"] = float(stats["data_security"]) + float(module_part["data_security"]) * module_scale
			_merge_scaled_part_logic(stats, module_part, module_scale)
	stats["topology_nodes"] = nodes.size()
	stats["topology_edges"] = Array(topology.get("edges", [])).size()


func _apply_barrier_tile_stats(stats: Dictionary, role_key: String, unit_bp: Dictionary) -> void:
	if role_key != "barrier" or not unit_bp.has("barrier_tiles"):
		return
	var tiles: Array = unit_bp.get("barrier_tiles", [])
	var part_scale := 0.42
	var runtime_tiles: Array = []
	var columns := BARRIER_MAP_COLUMNS
	var rows := BARRIER_MAP_ROWS
	var cell_width := BARRIER_BLUEPRINT_WIDTH / float(columns)
	var cell_height := BARRIER_BLUEPRINT_HEIGHT / float(rows)
	var ether_threshold_coeff := maxf(0.08, float(stats.get("ether_momentum_threshold_coeff", BARRIER_DEFAULT_MOMENTUM_THRESHOLD_COEFF)))
	for tile in tiles:
		if not (tile is Dictionary):
			continue
		var tile_slot := "joint" if tile.has("joint") else "muscle"
		var tile_part := _selected_component(role_key, tile_slot, int(tile.get(tile_slot, unit_bp.get(tile_slot, unit_bp.get("muscle", 0)))))
		var screen_pos := _barrier_tile_screen_pos(tile)
		var cell_index := int(tile.get("index", _barrier_pos_to_legacy_cell_index(screen_pos)))
		if cell_index < 0:
			cell_index = runtime_tiles.size()
		var col := clampi(int(floor(screen_pos.x * float(columns))), 0, columns - 1)
		var row := clampi(int(floor(screen_pos.y * float(rows))), 0, rows - 1)
		var local_ring := screen_pos.x * BARRIER_BLUEPRINT_WIDTH - BARRIER_BLUEPRINT_WIDTH * 0.5
		var local_lane := screen_pos.y * BARRIER_BLUEPRINT_HEIGHT - BARRIER_BLUEPRINT_HEIGHT * 0.5
		var shape := String(tile_part.get("shape", "barrier_tile"))
		var material_class := String(tile_part.get("material_class", "barrier_wall"))
		var orientation := String(tile.get("orientation", ""))
		if orientation == "":
			if shape.contains("shield") or material_class == "one_way_shield":
				orientation = "vertical"
			elif shape.contains("lane") or bool(tile_part.get("is_speed_lane", false)):
				orientation = "horizontal"
			elif shape.contains("arc") or shape.contains("crescent"):
				orientation = "diagonal_pos" if col % 2 == 0 else "diagonal_neg"
			else:
				orientation = "vertical" if (col + row) % 2 == 0 else "horizontal"
		var base_length := maxf(float(tile_part.get("length", 0.0)), minf(cell_width, cell_height) * 0.62)
		if material_class in ["barrier_wall", "one_way_shield"] or material_class.contains("wall_joint") or bool(tile_part.get("is_cage_wall", false)):
			base_length = maxf(base_length, minf(cell_width, cell_height) * 0.92)
		elif bool(tile_part.get("is_speed_lane", false)) or bool(tile_part.get("is_support_platform", false)):
			base_length = maxf(base_length, cell_width * 0.84)
		var tile_radius := maxf(0.035, float(tile_part.get("radius", 0.08)))
		var tile_mass := maxf(0.05, float(tile_part.get("mass", 1.0)) * part_scale)
		var tile_hp := maxf(1.0, float(tile_part.get("hp", 8.0)) * part_scale)
		var tile_threshold_coeff := maxf(0.08, float(tile_part.get("barrier_momentum_threshold_coeff", 1.0)) * ether_threshold_coeff)
		var runtime_tile := {
			"index": cell_index,
			"pos": screen_pos,
			"col": col,
			"row": row,
			"local_ring": local_ring,
			"local_lane": local_lane,
			"length": base_length,
			"radius": tile_radius,
			"mass": tile_mass,
			"hp": tile_hp,
			"momentum_threshold": tile_threshold_coeff * tile_mass,
			"ether_threshold_coeff": ether_threshold_coeff,
			"orientation": orientation,
			"shape": shape,
			"material_class": material_class,
			"damage_type": String(tile_part.get("projectile_damage_type", tile_part.get("damage_type", "blunt"))),
			"name": String(tile_part.get("name", "BARRIER TILE")),
			"effect_tags": _barrier_tile_effect_tags(tile_part),
			"field_radius": maxf(float(tile_part.get("support_radius", 0.0)), maxf(float(tile_part.get("gravity_radius", 0.0)), maxf(float(tile_part.get("coolant_radius", 0.0)), maxf(float(tile_part.get("heat_field_radius", 0.0)), float(tile_part.get("trap_radius", 0.0)))))),
		}
		if tile.has("tile_id"):
			runtime_tile["tile_id"] = String(tile.get("tile_id", ""))
		if tile.get("terrain_policy", {}) is Dictionary:
			var terrain_policy: Dictionary = Dictionary(tile.get("terrain_policy", {}))
			if not terrain_policy.is_empty():
				runtime_tile["terrain_policy"] = terrain_policy.duplicate(true)
		runtime_tiles.append(runtime_tile)
		stats["cost"] = int(stats["cost"]) + int(roundf(float(tile_part.get("cost", 0)) * part_scale))
		stats["health"] = int(stats["health"]) + int(roundf(float(tile_part.get("hp", 0)) * part_scale))
		stats["mass"] = float(stats["mass"]) + float(tile_part.get("mass", 0.0)) * part_scale
		stats["structural_mass"] = float(stats.get("structural_mass", 0.0)) + float(tile_part.get("mass", 0.0)) * part_scale
		var tile_power_load := 0.0 * part_scale
		stats["energy"] = float(stats["energy"]) + tile_power_load
		stats["power_load"] = float(stats.get("power_load", 0.0)) + tile_power_load
		stats["length"] = float(stats["length"]) + float(tile_part.get("length", 0.0)) * part_scale
		stats["radius"] = maxf(float(stats["radius"]), float(tile_part.get("radius", 0.0)) * 1.4)
		if tile_part.has("resist"):
			var part_resist: Dictionary = tile_part["resist"]
			for damage_type in MELEE_DAMAGE_TYPES:
				stats["resistances"][damage_type] = float(stats["resistances"][damage_type]) * lerpf(1.0, float(part_resist.get(damage_type, 1.0)), part_scale)
		if tile_part.has("counter_tiers"):
			_merge_counter_tiers(stats, tile_part["counter_tiers"])
		_merge_scaled_part_logic(stats, tile_part, part_scale)
	stats["barrier_tile_count"] = tiles.size()
	stats["barrier_map_tiles"] = runtime_tiles
	stats["barrier_map_columns"] = columns
	stats["barrier_map_rows"] = rows
	stats["barrier_map_width"] = BARRIER_BLUEPRINT_WIDTH
	stats["barrier_map_height"] = BARRIER_BLUEPRINT_HEIGHT


func _barrier_tile_effect_tags(part: Dictionary) -> Array:
	var tags: Array = []
	if bool(part.get("is_gravity_field", false)):
		tags.append("gravity")
	if bool(part.get("is_coolant_field", false)):
		tags.append("coolant")
	if bool(part.get("is_heat_field", false)):
		tags.append("heat")
	if bool(part.get("is_repulsion_field", false)):
		tags.append("repulsion")
	if bool(part.get("is_resource_siphon", false)):
		tags.append("siphon")
	if bool(part.get("is_hack_field", false)):
		tags.append("hack")
	if bool(part.get("is_trap_field", false)):
		tags.append("trap")
	if bool(part.get("is_signal_jammer", false)):
		tags.append("jammer")
	if bool(part.get("is_support_node", false)) or bool(part.get("is_repair_station", false)):
		tags.append("support")
	if bool(part.get("is_speed_lane", false)):
		tags.append("speed_lane")
	if bool(part.get("is_coin_generator", false)):
		tags.append("coin")
	if bool(part.get("is_one_way_shield", false)):
		tags.append("one_way_shield")
	if bool(part.get("reflect_projectiles", false)):
		tags.append("reflector")
	if bool(part.get("is_barrage_emitter", false)):
		tags.append("barrage")
	if bool(part.get("is_homing_launcher", false)):
		tags.append("homing")
	if bool(part.get("is_hatchery", false)):
		tags.append("hatchery")
	if bool(part.get("is_cage_wall", false)):
		tags.append("cage")
	if int(part.get("entry_breach_damage", 0)) > 0:
		tags.append("entry_breach")
	return tags


func _barrier_field_tag_from_kind(field_kind: String) -> String:
	if field_kind.begins_with("gravity"):
		return "gravity"
	match field_kind:
		"coolant":
			return "coolant"
		"heat":
			return "heat"
		"repulsion":
			return "repulsion"
		"siphon":
			return "siphon"
		"hack":
			return "hack"
		"trap":
			return "trap"
		"jam":
			return "jammer"
		"support":
			return "support"
		"speed_lane":
			return "speed_lane"
		"coin":
			return "coin"
		"one_way_shield":
			return "one_way_shield"
		"reflector":
			return "reflector"
		"barrage":
			return "barrage"
		"homing":
			return "homing"
		"cage":
			return "cage"
	return ""


func _barrier_has_tile_effect_tag(barrier, field_tag: String) -> bool:
	if field_tag == "" or not _barrier_has_map_tiles(barrier):
		return false
	for raw_tile in Array(barrier.stats.get("barrier_map_tiles", [])):
		if raw_tile is Dictionary and Array(Dictionary(raw_tile).get("effect_tags", [])).has(field_tag):
			return true
	return false


func _barrier_tile_matches_field(tile: Dictionary, field_tag: String, has_tagged_tiles: bool) -> bool:
	if field_tag == "" or not has_tagged_tiles:
		return true
	return Array(tile.get("effect_tags", [])).has(field_tag)


func _merge_scaled_part_logic(stats: Dictionary, part: Dictionary, scale: float) -> void:
	if part.has("ammo_capacity"):
		var ammo_scale := 1.0 if _component_is_gun_muscle(part, "muscle") else scale
		_merge_ammo_capacity(stats, part.get("ammo_capacity", {}), ammo_scale)
	if bool(part.get("is_gravity_field", false)):
		stats["is_gravity_field"] = true
		var gravity_radius := float(part.get("gravity_radius", part.get("radius", 0.0))) * lerpf(0.72, 1.0, scale)
		var gravity_force := float(part.get("gravity_force", 0.0)) * lerpf(0.62, 1.0, scale)
		var gravity_direction := String(part.get("gravity_direction", stats.get("gravity_direction", "forward")))
		stats["gravity_radius"] = maxf(float(stats.get("gravity_radius", 0.0)), gravity_radius)
		if gravity_force >= float(stats.get("gravity_force", 0.0)):
			stats["gravity_force"] = gravity_force
			stats["gravity_direction"] = gravity_direction
		var gravity_effects: Array = Array(stats.get("ether_effects", [])).duplicate(true)
		gravity_effects.append({
			"kind": "gravity",
			"direction": gravity_direction,
			"force": gravity_force,
			"radius": gravity_radius,
		})
		stats["ether_effects"] = gravity_effects
	if bool(part.get("is_coolant_field", false)):
		stats["is_coolant_field"] = true
		stats["coolant_radius"] = maxf(float(stats.get("coolant_radius", 0.0)), float(part.get("coolant_radius", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["coolant_boost"] = maxf(float(stats.get("coolant_boost", 0.0)), float(part.get("coolant_boost", 0.0)) * lerpf(0.6, 1.0, scale))
		stats["coolant_affects"] = String(part.get("coolant_affects", stats.get("coolant_affects", "ally")))
	if bool(part.get("is_heat_field", false)):
		stats["is_heat_field"] = true
		stats["heat_field_radius"] = maxf(float(stats.get("heat_field_radius", 0.0)), float(part.get("heat_field_radius", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["heat_field_rate"] = maxf(float(stats.get("heat_field_rate", 0.0)), float(part.get("heat_field_rate", 0.0)) * lerpf(0.58, 1.0, scale))
		stats["heat_field_affects"] = String(part.get("heat_field_affects", stats.get("heat_field_affects", "all")))
	if bool(part.get("is_repulsion_field", false)):
		stats["is_repulsion_field"] = true
		stats["repulsion_radius"] = maxf(float(stats.get("repulsion_radius", 0.0)), float(part.get("repulsion_radius", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["repulsion_force"] = maxf(float(stats.get("repulsion_force", 0.0)), float(part.get("repulsion_force", 0.0)) * lerpf(0.62, 1.0, scale))
	if bool(part.get("is_resource_siphon", false)):
		stats["is_resource_siphon"] = true
		stats["siphon_radius"] = maxf(float(stats.get("siphon_radius", 0.0)), float(part.get("siphon_radius", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["siphon_rate"] = maxf(float(stats.get("siphon_rate", 0.0)), float(part.get("siphon_rate", 0.0)) * lerpf(0.55, 1.0, scale))
	if bool(part.get("is_hack_field", false)):
		stats["is_hack_field"] = true
		stats["hack_radius"] = maxf(float(stats.get("hack_radius", 0.0)), float(part.get("hack_radius", 0.0)) * lerpf(0.72, 1.0, scale))
		var hack_seconds := float(part.get("hack_seconds", 0.0))
		if hack_seconds > 0.0 and (float(stats.get("hack_seconds", 0.0)) <= 0.0 or hack_seconds < float(stats.get("hack_seconds", 0.0))):
			stats["hack_seconds"] = hack_seconds
		stats["hack_power"] = maxf(float(stats.get("hack_power", 1.0)), float(part.get("hack_power", 1.0)))
	if bool(part.get("is_signal_jammer", false)):
		stats["is_signal_jammer"] = true
		stats["jam_radius"] = maxf(float(stats.get("jam_radius", 0.0)), float(part.get("jam_radius", 0.0)) * lerpf(0.72, 1.0, scale))
		var jam_seconds := float(part.get("jam_seconds", 0.0))
		if jam_seconds > 0.0 and (float(stats.get("jam_seconds", 0.0)) <= 0.0 or jam_seconds < float(stats.get("jam_seconds", 0.0))):
			stats["jam_seconds"] = jam_seconds
		stats["jam_power"] = maxf(float(stats.get("jam_power", 1.0)), float(part.get("jam_power", 1.0)))
		stats["jam_duration"] = maxf(float(stats.get("jam_duration", 0.0)), float(part.get("jam_duration", 0.0)))
		stats["jam_affects"] = String(part.get("jam_affects", stats.get("jam_affects", "enemy")))
	if bool(part.get("is_repair_station", false)):
		stats["is_repair_station"] = true
		stats["repair_rate"] = maxf(float(stats.get("repair_rate", 0.0)), float(part.get("repair_rate", 0.0)) * lerpf(0.6, 1.0, scale))
		stats["repair_capacity"] = maxi(int(stats.get("repair_capacity", 0)), int(part.get("repair_capacity", 0)))
		stats["station_repair_mult"] = maxf(float(stats.get("station_repair_mult", 1.0)), float(part.get("station_repair_mult", 1.0)))
	if bool(part.get("is_hatchery", false)):
		stats["is_hatchery"] = true
		stats["hatch_profile"] = String(part.get("hatch_profile", stats.get("hatch_profile", "")))
		var hatch_interval := float(part.get("hatch_interval", 0.0))
		var current_hatch_interval := float(stats.get("hatch_interval", 0.0))
		stats["hatch_interval"] = hatch_interval if current_hatch_interval <= 0.0 else minf(current_hatch_interval, hatch_interval)
		stats["hatch_limit"] = maxi(int(stats.get("hatch_limit", 0)), int(part.get("hatch_limit", 0)))
		stats["hatch_ai"] = String(part.get("hatch_ai", stats.get("hatch_ai", "")))
		stats["hatch_modifier"] = String(part.get("hatch_modifier", stats.get("hatch_modifier", "")))
	if bool(part.get("is_trap_field", false)):
		stats["is_trap_field"] = true
		var trap_radius := float(part.get("trap_radius", 0.0)) * lerpf(0.72, 1.0, scale)
		var trap_damage := int(roundf(float(part.get("trap_damage", 0)) * lerpf(0.58, 1.0, scale)))
		var trap_power := float(part.get("trap_power", 0.0)) * lerpf(0.62, 1.0, scale)
		var trap_score := float(trap_damage) + trap_power * 18.0 + trap_radius * 5.0
		var current_trap_score := float(stats.get("trap_damage", 0)) + float(stats.get("trap_power", 0.0)) * 18.0 + float(stats.get("trap_radius", 0.0)) * 5.0
		stats["trap_radius"] = maxf(float(stats.get("trap_radius", 0.0)), trap_radius)
		if trap_score >= current_trap_score:
			stats["trap_effect"] = String(part.get("trap_effect", stats.get("trap_effect", "")))
			stats["trap_command"] = String(part.get("trap_command", stats.get("trap_command", "")))
			stats["trap_cooldown"] = float(part.get("trap_cooldown", stats.get("trap_cooldown", 0.0)))
			stats["trap_power"] = trap_power
			stats["trap_damage"] = trap_damage
			stats["trap_damage_type"] = String(part.get("trap_damage_type", part.get("damage_type", stats.get("trap_damage_type", ""))))
			stats["trap_slow_duration"] = float(part.get("trap_slow_duration", stats.get("trap_slow_duration", 0.0)))
			stats["trap_affects"] = String(part.get("trap_affects", stats.get("trap_affects", "enemy")))
			stats["trap_direction_mode"] = String(part.get("trap_direction_mode", stats.get("trap_direction_mode", "input")))
			stats["trap_link"] = String(part.get("trap_link", stats.get("trap_link", "")))
		stats["lease_rate"] = float(stats.get("lease_rate", 0.0)) + float(part.get("lease_rate", 0.0)) * scale
		stats["lease_heat_penalty"] = maxf(float(stats.get("lease_heat_penalty", 0.0)), float(part.get("lease_heat_penalty", 0.0)))
	if bool(part.get("reflect_projectiles", false)):
		stats["reflect_projectiles"] = true
		var reflect_types: Array = Array(stats.get("reflect_types", [])).duplicate()
		for raw_type in Array(part.get("reflect_types", [])):
			var type_name := String(raw_type)
			if not reflect_types.has(type_name):
				reflect_types.append(type_name)
		stats["reflect_types"] = reflect_types
		stats["reflect_power"] = maxf(float(stats.get("reflect_power", 0.0)), float(part.get("reflect_power", 0.0)) * lerpf(0.62, 1.0, scale))
		stats["reflect_bonus_range"] = maxf(float(stats.get("reflect_bonus_range", 0.0)), float(part.get("reflect_bonus_range", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["reflect_affects"] = String(part.get("reflect_affects", stats.get("reflect_affects", "ally")))
	if int(part.get("entry_breach_damage", 0)) > 0:
		var breach_damage := int(roundf(float(part.get("entry_breach_damage", 0)) * lerpf(0.65, 1.0, scale)))
		if breach_damage >= int(stats.get("entry_breach_damage", 0)):
			stats["entry_breach_damage"] = breach_damage
			stats["entry_breach_damage_type"] = String(part.get("entry_breach_damage_type", stats.get("entry_breach_damage_type", "blunt")))
			stats["entry_breach_self_heat"] = float(part.get("entry_breach_self_heat", stats.get("entry_breach_self_heat", 0.0)))
	if bool(part.get("is_support_node", false)):
		stats["is_support_node"] = true
		stats["support_kind"] = String(part.get("support_kind", stats.get("support_kind", "")))
		stats["support_radius"] = maxf(float(stats.get("support_radius", 0.0)), float(part.get("support_radius", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["support_rate"] = maxf(float(stats.get("support_rate", 0.0)), float(part.get("support_rate", 0.0)) * lerpf(0.6, 1.0, scale))
		stats["support_amount"] = maxi(int(stats.get("support_amount", 0)), int(roundf(float(part.get("support_amount", 0)) * lerpf(0.62, 1.0, scale))))
		stats["support_refill_seconds"] = minf(float(stats.get("support_refill_seconds", 1.0)), float(part.get("support_refill_seconds", 1.0)))
		stats["support_ammo_type"] = String(part.get("support_ammo_type", stats.get("support_ammo_type", "")))
		stats["support_buff_type"] = String(part.get("support_buff_type", stats.get("support_buff_type", "")))
		stats["support_buff_mult"] = maxf(float(stats.get("support_buff_mult", 1.0)), lerpf(1.0, float(part.get("support_buff_mult", 1.0)), scale))
		stats["support_duration"] = maxf(float(stats.get("support_duration", 0.0)), float(part.get("support_duration", 0.0)))
		stats["support_affects"] = String(part.get("support_affects", stats.get("support_affects", "ally")))
		stats["support_field_shape"] = String(part.get("support_field_shape", stats.get("support_field_shape", "circle")))
		stats["is_support_platform"] = bool(part.get("is_support_platform", stats.get("is_support_platform", false)))
		stats["platform_pair_range"] = maxf(float(stats.get("platform_pair_range", 0.0)), float(part.get("platform_pair_range", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["platform_width"] = maxf(float(stats.get("platform_width", 0.0)), float(part.get("platform_width", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["platform_armor_hp"] = maxf(float(stats.get("platform_armor_hp", 0.0)), float(part.get("platform_armor_hp", 0.0)) * lerpf(0.62, 1.0, scale))
	if bool(part.get("is_speed_lane", false)):
		stats["is_speed_lane"] = true
		stats["speed_lane_radius"] = maxf(float(stats.get("speed_lane_radius", 0.0)), float(part.get("speed_lane_radius", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["speed_lane_width"] = maxf(float(stats.get("speed_lane_width", 0.0)), float(part.get("speed_lane_width", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["speed_lane_mult"] = maxf(float(stats.get("speed_lane_mult", 1.0)), lerpf(1.0, float(part.get("speed_lane_mult", 1.0)), scale))
		stats["speed_lane_pull"] = maxf(float(stats.get("speed_lane_pull", 0.0)), float(part.get("speed_lane_pull", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["speed_lane_affects"] = String(part.get("speed_lane_affects", stats.get("speed_lane_affects", "all")))
		stats["speed_field_shape"] = String(part.get("speed_field_shape", stats.get("speed_field_shape", "rectangle")))
	if bool(part.get("is_coin_generator", false)):
		stats["is_coin_generator"] = true
		var interval := float(part.get("coin_interval", 0.0))
		var current_interval := float(stats.get("coin_interval", 0.0))
		stats["coin_interval"] = interval if current_interval <= 0.0 else minf(current_interval, interval)
		stats["coin_value"] = maxi(int(stats.get("coin_value", 0)), int(roundf(float(part.get("coin_value", 0)) * lerpf(0.65, 1.0, scale))))
		stats["coin_ttl"] = maxf(float(stats.get("coin_ttl", 0.0)), float(part.get("coin_ttl", 0.0)))
		stats["coin_spawn_radius"] = maxf(float(stats.get("coin_spawn_radius", 0.0)), float(part.get("coin_spawn_radius", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["coin_pickup_radius"] = maxf(float(stats.get("coin_pickup_radius", 0.0)), float(part.get("coin_pickup_radius", 0.0)))
	if bool(part.get("is_one_way_shield", false)):
		stats["is_one_way_shield"] = true
		stats["shield_radius"] = maxf(float(stats.get("shield_radius", 0.0)), float(part.get("shield_radius", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["shield_lane_width"] = maxf(float(stats.get("shield_lane_width", 0.0)), float(part.get("shield_lane_width", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["shield_pass_mode"] = String(part.get("shield_pass_mode", stats.get("shield_pass_mode", "directional")))
		stats["shield_pass_direction"] = String(part.get("shield_pass_direction", stats.get("shield_pass_direction", "facing")))
		stats["shield_block_damage_mult"] = minf(float(stats.get("shield_block_damage_mult", 1.0)), float(part.get("shield_block_damage_mult", 1.0)))
		stats["shield_affects"] = String(part.get("shield_affects", stats.get("shield_affects", "enemy")))
	if bool(part.get("is_homing_launcher", false)):
		stats["is_homing_launcher"] = true
		stats["homing_radius"] = maxf(float(stats.get("homing_radius", 0.0)), float(part.get("homing_radius", 0.0)) * lerpf(0.72, 1.0, scale))
		var interval := float(part.get("homing_interval", 1.4))
		var current_interval := float(stats.get("homing_interval", 0.0))
		stats["homing_interval"] = interval if current_interval <= 0.0 else minf(current_interval, interval)
		stats["homing_accuracy"] = maxf(float(stats.get("homing_accuracy", 0.0)), float(part.get("homing_accuracy", 0.5)))
		stats["homing_damage"] = maxi(int(stats.get("homing_damage", 0)), int(roundf(float(part.get("homing_damage", 0)) * lerpf(0.58, 1.0, scale))))
		stats["homing_damage_type"] = String(part.get("homing_damage_type", stats.get("homing_damage_type", "bullet")))
		stats["homing_heat"] = maxf(float(stats.get("homing_heat", 0.0)), float(part.get("homing_heat", 0.0)) * lerpf(0.5, 1.0, scale))
		stats["homing_knock"] = maxf(float(stats.get("homing_knock", 0.08)), float(part.get("homing_knock", 0.08)))
		stats["homing_affects"] = String(part.get("homing_affects", stats.get("homing_affects", "enemy")))
	if bool(part.get("is_barrage_emitter", false)):
		stats["is_barrage_emitter"] = true
		stats["barrage_mode"] = String(part.get("barrage_mode", stats.get("barrage_mode", "fixed")))
		var barrage_interval := float(part.get("barrage_interval", 1.0))
		var current_barrage_interval := float(stats.get("barrage_interval", 0.0))
		stats["barrage_interval"] = barrage_interval if current_barrage_interval <= 0.0 else minf(current_barrage_interval, barrage_interval)
		stats["barrage_damage"] = maxi(int(stats.get("barrage_damage", 0)), int(roundf(float(part.get("barrage_damage", 0)) * lerpf(0.58, 1.0, scale))))
		stats["barrage_damage_type"] = String(part.get("barrage_damage_type", stats.get("barrage_damage_type", "bullet")))
		stats["barrage_range"] = maxf(float(stats.get("barrage_range", 0.0)), float(part.get("barrage_range", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["barrage_lane_range"] = maxf(float(stats.get("barrage_lane_range", 0.0)), float(part.get("barrage_lane_range", 0.0)) * lerpf(0.72, 1.0, scale))
		stats["barrage_heat"] = maxf(float(stats.get("barrage_heat", 0.0)), float(part.get("barrage_heat", 0.0)) * lerpf(0.5, 1.0, scale))
		stats["barrage_style"] = String(part.get("barrage_style", stats.get("barrage_style", "")))
		stats["barrage_spin_rate"] = maxf(float(stats.get("barrage_spin_rate", 1.0)), float(part.get("barrage_spin_rate", 1.0)))
		stats["barrage_affects"] = String(part.get("barrage_affects", stats.get("barrage_affects", "enemy")))
	if float(part.get("explosion_radius", 0.0)) > 0.0:
		stats["explosion_radius"] = maxf(float(stats.get("explosion_radius", 0.0)), float(part.get("explosion_radius", 0.0)) * lerpf(0.7, 1.0, scale))
		stats["explosion_damage"] = maxi(int(stats.get("explosion_damage", 0)), int(roundf(float(part.get("explosion_damage", 0)) * lerpf(0.6, 1.0, scale))))
		stats["explosion_damage_type"] = String(part.get("explosion_damage_type", part.get("damage_type", stats.get("explosion_damage_type", "blunt"))))
		stats["explosion_style"] = String(part.get("explosion_style", stats.get("explosion_style", "blast")))
	if part.has("takeover_power"):
		stats["takeover_power"] = maxf(float(stats.get("takeover_power", 1.0)), 1.0 + float(part["takeover_power"]) * scale)
	if bool(part.get("is_cage_wall", false)):
		stats["is_cage_wall"] = true
		stats["cage_radius"] = maxf(float(stats.get("cage_radius", 0.0)), float(part.get("cage_radius", 0.0)) * lerpf(0.78, 1.0, scale))
		stats["cage_damage"] = maxi(int(stats.get("cage_damage", 0)), int(roundf(float(part.get("cage_damage", 0)) * lerpf(0.65, 1.0, scale))))
		stats["cage_damage_type"] = String(part.get("cage_damage_type", stats.get("cage_damage_type", "blunt")))
		stats["cage_repel"] = maxf(float(stats.get("cage_repel", 0.0)), float(part.get("cage_repel", 0.0)))
		stats["cage_hit_interval"] = minf(float(stats.get("cage_hit_interval", 0.6)), float(part.get("cage_hit_interval", 0.6)))
		stats["cage_affects"] = String(part.get("cage_affects", stats.get("cage_affects", "enemy")))
		stats["cage_shape"] = String(part.get("bend", part.get("shape", stats.get("cage_shape", ""))))


func _apply_soul_bonus(stats: Dictionary, unit_bp: Dictionary, soul_part: Dictionary) -> void:
	var context := {}
	if String(soul_part.get("soul_archetype", "")) == "duelist_oath":
		context["duelist_oath_fail_reason"] = _duelist_oath_fail_reason(stats, unit_bp, soul_part)
	else:
		context["requirements_met"] = _soul_requirements_met(stats, unit_bp, Dictionary(soul_part.get("soul_requirements", {})))
	_unit_stats_service().apply_soul_bonus_stats(stats, soul_part, context)


func _duelist_oath_fail_reason(stats: Dictionary, unit_bp: Dictionary, soul_part: Dictionary) -> String:
	var requirements: Dictionary = soul_part.get("soul_requirements", {})
	var mass := float(stats.get("mass", 0.0))
	if requirements.has("mass_min") and mass < float(requirements["mass_min"]):
		return "body_too_light"
	if requirements.has("mass_max") and mass > float(requirements["mass_max"]):
		return "body_too_heavy"
	var radius := float(stats.get("radius", 0.0))
	if requirements.has("radius_max") and radius > float(requirements["radius_max"]):
		return "radius_too_large"
	if requirements.has("radius_min") and radius < float(requirements["radius_min"]):
		return "radius_too_small"
	var module_min := int(requirements.get("module_group_min", 0))
	if module_min > 0 and _soul_module_group_count(unit_bp) < module_min:
		return "missing_bound_modules"
	var contact_min := int(requirements.get("duelist_real_contact_min", 0))
	if contact_min > 0 and _soul_duelist_real_contact_module_count(unit_bp) < contact_min:
		return "missing_duelist_action"
	if _soul_has_xl_limb(unit_bp):
		return "xl_limb"
	if _soul_has_disallowed_duelist_terminal(unit_bp):
		return "ranged_or_heavy_weapon"
	var weapon_mass_max := float(requirements.get("terminal_weapon_mass_max", 0.0))
	if weapon_mass_max > 0.0 and _soul_terminal_weapon_mass(unit_bp, "hero") > weapon_mass_max:
		return "weapon_load_too_heavy"
	return ""


func _soul_module_group_count(unit_bp: Dictionary) -> int:
	var modules := {}
	var topology_count := _module_control_group_count(unit_bp)
	for raw_binding in Array(unit_bp.get("module_bindings", [])):
		if not (raw_binding is Dictionary):
			continue
		var binding: Dictionary = raw_binding
		var module_index := _soul_module_index_from_binding(unit_bp, binding)
		if module_index >= 0:
			modules[module_index] = true
	return maxi(topology_count, modules.size())


func _soul_module_index_from_binding(unit_bp: Dictionary, binding: Dictionary) -> int:
	if binding.has("module_index"):
		return int(binding.get("module_index", -1))
	var payload_index := int(binding.get("software_slot_index", -1))
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	if payload_index >= 0 and payload_index < payloads.size() and payloads[payload_index] is Dictionary:
		return int(Dictionary(payloads[payload_index]).get("module", -1))
	return int(binding.get("module", unit_bp.get("module", -1)))


func _soul_duelist_real_contact_module_count(unit_bp: Dictionary) -> int:
	var modules := {}
	for raw_binding in Array(unit_bp.get("module_bindings", [])):
		if not (raw_binding is Dictionary):
			continue
		var binding: Dictionary = raw_binding
		var module_index := _soul_module_index_from_binding(unit_bp, binding)
		if module_index < 0:
			continue
		var module_part := _selected_component("hero", "module", module_index)
		if _soul_module_is_duelist_real_contact(module_part, binding):
			modules[module_index] = true
	if unit_bp.has("custom_topology"):
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		for raw_node in Array(topology.get("nodes", [])):
			if not (raw_node is Dictionary):
				continue
			for raw_module_index in _module_indices_for_topology_node(raw_node, unit_bp):
				var module_index := int(raw_module_index)
				if module_index < 0:
					continue
				var module_part := _selected_component("hero", "module", module_index)
				if _soul_module_is_duelist_real_contact(module_part, {}):
					modules[module_index] = true
	return modules.size()


func _soul_module_is_duelist_real_contact(module_part: Dictionary, binding: Dictionary = {}) -> bool:
	var profile := String(module_part.get("module_action_profile", binding.get("module_action_profile", ""))).to_lower()
	var target_kind := String(module_part.get("module_target_kind", binding.get("target_kind", ""))).to_lower()
	if profile in ["gun_activate", "rifle_burst_activate", "laser_beam_activate", "missile_lock_activate", "web_tether_activate", "grenade_arc_activate"]:
		return false
	if profile in ["two_link_forward_snap", "pierce_rail_3m", "pierce_telescopic_lunge", "rapier_feint_thrust", "lance_couched_charge", "blade_arc_return", "katana_quickdraw", "scythe_hook_return", "greatsword_commit_cleave", "triple_limb_cross_cut", "extend_slash_driver"]:
		return true
	for token in ["duel", "feint", "thrust", "pierce", "blade", "slash", "katana", "scythe"]:
		if profile.find(token) >= 0 or target_kind.find(token) >= 0:
			return true
	return false


func _soul_terminal_weapon_mass(unit_bp: Dictionary, role_key: String = "hero") -> float:
	var result := 0.0
	if unit_bp.has("custom_topology"):
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		for raw_node in Array(topology.get("nodes", [])):
			if not (raw_node is Dictionary):
				continue
			var node: Dictionary = raw_node
			if _topology_node_slot(node) != "muscle":
				continue
			var part := _topology_node_part(role_key, node, unit_bp)
			if _component_is_torso(part):
				continue
			if _part_counts_as_terminal_weapon(part, "muscle") or bool(part.get("terminal_weapon", false)) or bool(part.get("projectile", false)):
				result = maxf(result, float(part.get("mass", 0.0)))
		return result
	var part := _selected_component(role_key, "muscle", int(unit_bp.get("muscle", 0)))
	if not _component_is_torso(part):
		result = float(part.get("mass", 0.0))
	return result


func _soul_has_xl_limb(unit_bp: Dictionary) -> bool:
	if not unit_bp.has("custom_topology"):
		var limb := _selected_component("hero", "limb_muscle", int(unit_bp.get("limb_muscle", 0)))
		var tier := String(limb.get("size_tier", PartArt.normalized_size_tier(limb))).to_upper()
		return tier in ["XL", "MONSTER", "LEVIATHAN"]
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	for raw_node in Array(topology.get("nodes", [])):
		if not (raw_node is Dictionary):
			continue
		var node: Dictionary = raw_node
		if _topology_node_slot(node) != "limb_muscle":
			continue
		var part := _topology_node_part("hero", node, unit_bp)
		var tier := String(part.get("size_tier", PartArt.normalized_size_tier(part))).to_upper()
		if tier in ["XL", "MONSTER", "LEVIATHAN"]:
			return true
	return false


func _soul_has_disallowed_duelist_terminal(unit_bp: Dictionary) -> bool:
	var parts: Array = []
	if unit_bp.has("custom_topology"):
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		for raw_node in Array(topology.get("nodes", [])):
			if not (raw_node is Dictionary):
				continue
			var node: Dictionary = raw_node
			if _topology_node_slot(node) != "muscle":
				continue
			var part := _topology_node_part("hero", node, unit_bp)
			if not _component_is_torso(part):
				parts.append(part)
	else:
		parts.append(_selected_component("hero", "muscle", int(unit_bp.get("muscle", 0))))
	for raw_part in parts:
		if not (raw_part is Dictionary):
			continue
		var part: Dictionary = raw_part
		var gun_kind := String(part.get("gun_kind", "")).to_lower()
		if gun_kind == "missile_launcher":
			return true
		var family := String(part.get("weapon_family", part.get("blade_family", ""))).to_lower()
		if family in ["shield", "hammer", "maul"] and float(part.get("mass", 0.0)) >= 18.0:
			return true
	return false


func _duelist_oath_reason_label(reason: String, zh: bool = true) -> String:
	match reason:
		"", "active":
			return "誓约已激活" if zh else "Oath active"
		"body_too_light":
			return "机体过轻" if zh else "body too light"
		"body_too_heavy":
			return "机体过重" if zh else "body too heavy"
		"radius_too_large":
			return "半径过大" if zh else "radius too large"
		"radius_too_small":
			return "半径过小" if zh else "radius too small"
		"missing_bound_modules":
			return "缺少绑定模块" if zh else "missing bound modules"
		"missing_duelist_action":
			return "缺少决斗动作" if zh else "missing duelist action"
		"xl_limb":
			return "存在 XL 连接件" if zh else "XL connector installed"
		"ranged_or_heavy_weapon":
			return "远程或重型盾锤构筑" if zh else "ranged or heavy shield/hammer build"
		"weapon_load_too_heavy":
			return "武器负载过重" if zh else "weapon load too heavy"
		_:
			return reason


func _soul_requirements_met(stats: Dictionary, unit_bp: Dictionary, requirements: Dictionary) -> bool:
	var mass := float(stats.get("mass", 0.0))
	if requirements.has("mass_min") and mass < float(requirements["mass_min"]):
		return false
	if requirements.has("mass_max") and mass > float(requirements["mass_max"]):
		return false
	if requirements.has("mass_ranges"):
		var matched_range := false
		for range_pair in requirements["mass_ranges"]:
			if range_pair is Array and range_pair.size() >= 2 and mass >= float(range_pair[0]) and mass <= float(range_pair[1]):
				matched_range = true
				break
		if not matched_range:
			return false
	if requirements.has("cooling_min") and float(stats.get("cooling", 0.0)) < float(requirements["cooling_min"]):
		return false
	if requirements.has("radius_max") and float(stats.get("radius", 0.0)) > float(requirements["radius_max"]):
		return false
	if requirements.has("radius_min") and float(stats.get("radius", 0.0)) < float(requirements["radius_min"]):
		return false
	if requirements.has("module_group_min") and _module_control_group_count(unit_bp) < int(requirements["module_group_min"]):
		return false
	return true


func _module_control_group_count(unit_bp: Dictionary) -> int:
	var modules := {}
	if unit_bp.has("custom_topology"):
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		for node in Array(topology.get("nodes", [])):
			if node is Dictionary:
				for module_index in _module_indices_for_topology_node(node, unit_bp):
					modules[int(module_index)] = true
	else:
		modules[int(unit_bp.get("module", 0))] = true
	return modules.size()


func _source_rules_for_blueprint(unit_bp: Dictionary, stats: Dictionary) -> Dictionary:
	var rules: Dictionary = {}
	if unit_bp.has("source_rules"):
		rules = unit_bp.get("source_rules", {}).duplicate(true)
	elif stats.has("source_rules"):
		var raw_rules = stats.get("source_rules", {})
		if raw_rules is Dictionary and not raw_rules.is_empty():
			rules = raw_rules.duplicate(true)
	else:
		rules = _default_source_rules(String(stats.get("ai", "line")), Array(stats.get("sequence", ["normal"])))
	for condition in SOURCE_CONDITION_ORDER:
		if not rules.has(condition):
			rules[condition] = _default_source_rule_for_condition(condition, String(stats.get("ai", "line")), Array(stats.get("sequence", ["normal"])))
	var condition_limit: int = clampi(int(stats.get("condition_slots", 1)), 1, SOURCE_CONDITION_ORDER.size())
	var module_limit: int = clampi(int(stats.get("module_sequence_limit", 1)), 1, 7)
	var normalized: Dictionary = {}
	for i in range(mini(condition_limit, SOURCE_CONDITION_ORDER.size())):
		var condition_key: String = String(SOURCE_CONDITION_ORDER[i])
		var rule: Dictionary = rules.get(condition_key, _default_source_rule_for_condition(condition_key, String(stats.get("ai", "line")), Array(stats.get("sequence", ["normal"]))))
		var modules: Array = rule.get("modules", [0])
		var states: Array = rule.get("states", ["normal"])
		rule["modules"] = modules.slice(0, module_limit)
		rule["states"] = states.slice(0, module_limit)
		normalized[condition_key] = rule
	if not normalized.has("default"):
		var default_rule: Dictionary = rules.get("default", _default_source_rule_for_condition("default", String(stats.get("ai", "line")), Array(stats.get("sequence", ["normal"]))))
		default_rule["modules"] = Array(default_rule.get("modules", [0])).slice(0, module_limit)
		default_rule["states"] = Array(default_rule.get("states", ["normal"])).slice(0, module_limit)
		normalized["default"] = default_rule
	return normalized


func _default_source_rules(ai_kind: String, sequence: Array) -> Dictionary:
	var rules: Dictionary = {}
	for condition in SOURCE_CONDITION_ORDER:
		rules[condition] = _default_source_rule_for_condition(condition, ai_kind, sequence)
	return rules


func _default_source_rule_for_condition(condition: String, ai_kind: String, sequence: Array) -> Dictionary:
	var base_states: Array = sequence.duplicate()
	if base_states.is_empty():
		base_states = ["normal"]
	var modules: Array = [0]
	var move := "approach"
	match condition:
		"enemy_shooting":
			move = "retreat"
			modules = [0, 1]
			base_states = ["armor", "normal"]
		"enemy_far":
			move = "approach"
			modules = [2, 3]
			base_states = ["normal"]
		"enemy_close":
			move = "retreat" if ai_kind in ["volley", "screen_wall"] else "flank"
			modules = [0, 1]
			base_states = ["normal", "active"]
		"hero_absent":
			move = "hold"
			modules = [0, 4]
			base_states = ["armor", "normal"]
		"self_overheat":
			move = "retreat"
			modules = [5]
			base_states = ["normal"]
		_:
			move = "orbit" if ai_kind in ["figure8", "mine_dance", "guard_orbit"] else "approach"
			modules = [0, 1, 2]
	return {"move": move, "modules": modules, "states": base_states}


func _normalized_ammo_type(ammo_type: String) -> String:
	var normalized := ammo_type.to_lower()
	if normalized in ["explosion", "missile"]:
		return "explosive"
	if normalized in ["chemical_splash", "acid"]:
		return "chemical"
	if normalized in ["silk", "thread"]:
		return "web"
	return normalized if AMMO_TYPES.has(normalized) else ""


func _ammo_unit_mass(ammo_type: String) -> float:
	return float(AMMO_UNIT_MASS.get(_normalized_ammo_type(ammo_type), 0.0))


func _ammo_capacity_mass(capacity: Variant, scale: float = 1.0) -> float:
	if not (capacity is Dictionary):
		return 0.0
	var total := 0.0
	for raw_type in capacity.keys():
		var ammo_type := _normalized_ammo_type(String(raw_type))
		if ammo_type == "":
			continue
		total += maxf(0.0, float(capacity.get(raw_type, 0.0)) * scale) * _ammo_unit_mass(ammo_type)
	return total


func _merge_ammo_capacity(stats: Dictionary, capacity: Variant, scale: float = 1.0) -> void:
	if not (capacity is Dictionary):
		return
	var ammo_capacity: Dictionary = stats.get("ammo_capacity", {"bullet": 0, "chemical": 0, "laser": 0})
	var added_mass := 0.0
	for raw_type in capacity.keys():
		var ammo_type := _normalized_ammo_type(String(raw_type))
		if ammo_type == "":
			continue
		var added_count := maxi(0, int(roundf(float(capacity.get(raw_type, 0)) * scale)))
		ammo_capacity[ammo_type] = int(ammo_capacity.get(ammo_type, 0)) + added_count
		added_mass += float(added_count) * _ammo_unit_mass(ammo_type)
	stats["ammo_capacity"] = ammo_capacity
	if added_mass > 0.0:
		stats["ammo_payload_mass"] = float(stats.get("ammo_payload_mass", 0.0)) + added_mass
		stats["mass"] = float(stats.get("mass", 0.0)) + added_mass


func _ensure_projectile_ammo_capacity(stats: Dictionary) -> void:
	var segments: Array = stats.get("runtime_topology_segments", [])
	if segments.is_empty():
		return
	var ammo_capacity: Dictionary = stats.get("ammo_capacity", {"bullet": 0, "laser": 0, "chemical": 0, "explosive": 0, "web": 0})
	var inferred := {"bullet": 0, "laser": 0, "chemical": 0, "explosive": 0, "web": 0}
	for raw_segment in segments:
		if not (raw_segment is Dictionary):
			continue
		var segment: Dictionary = raw_segment
		if not bool(segment.get("projectile", false)):
			continue
		var ammo_type := _normalized_ammo_type(String(segment.get("ammo_kind", segment.get("projectile_damage_type", segment.get("damage_type", "bullet")))))
		if not AMMO_TYPES.has(ammo_type):
			continue
		var reserve := int(segment.get("carried_ammo", segment.get("ammo_count", 0)))
		if reserve <= 0:
			match ammo_type:
				"bullet":
					reserve = 8
				"laser":
					reserve = 4
				"chemical":
					reserve = 5
				"explosive":
					reserve = 3
				"web":
					reserve = 6
				_:
					reserve = 4
		inferred[ammo_type] = int(inferred.get(ammo_type, 0)) + reserve
	var changed := false
	var added_capacity := {"bullet": 0, "laser": 0, "chemical": 0, "explosive": 0, "web": 0}
	for ammo_type in AMMO_TYPES:
		if int(ammo_capacity.get(ammo_type, 0)) <= 0 and int(inferred.get(ammo_type, 0)) > 0:
			ammo_capacity[ammo_type] = int(inferred[ammo_type])
			added_capacity[ammo_type] = int(inferred[ammo_type])
			changed = true
	if changed:
		stats["ammo_capacity"] = ammo_capacity
		var added_mass := _ammo_capacity_mass(added_capacity)
		stats["ammo_payload_mass"] = float(stats.get("ammo_payload_mass", 0.0)) + added_mass
		stats["mass"] = float(stats.get("mass", 0.0)) + added_mass
		stats["integrated_ammo_note"] = "RUNTIME MUZZLE AMMO B/L/C/X/W %d/%d/%d/%d/%d" % [
			int(ammo_capacity.get("bullet", 0)),
			int(ammo_capacity.get("laser", 0)),
			int(ammo_capacity.get("chemical", 0)),
			int(ammo_capacity.get("explosive", 0)),
			int(ammo_capacity.get("web", 0)),
		]

func _merge_counter_tiers(stats: Dictionary, tier_dict: Dictionary) -> void:
	var counters: Dictionary = stats.get("counter_tiers", {})
	for damage_type in MELEE_DAMAGE_TYPES:
		counters[damage_type] = maxi(int(counters.get(damage_type, 0)), int(tier_dict.get(damage_type, 0)))
	stats["counter_tiers"] = counters


func _topology_nearest_torso_node_index(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, start_index: int) -> int:
	if start_index < 0 or start_index >= nodes.size():
		return -1
	var visited := {start_index: true}
	var queue: Array = [start_index]
	while not queue.is_empty():
		var current := int(queue.pop_front())
		if current != start_index and _topology_node_is_torso(role_key, nodes[current], unit_bp):
			return current
		for neighbor_raw in _connected_topology_neighbors(edges, current, nodes.size()):
			var neighbor := int(neighbor_raw)
			if neighbor < 0 or neighbor >= nodes.size() or visited.has(neighbor):
				continue
			if not _topology_node_is_component(nodes[neighbor]):
				continue
			visited[neighbor] = true
			queue.append(neighbor)
	return -1


func _topology_attack_anchor_metadata(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, source_joint_index: int, first_muscle_index: int) -> Dictionary:
	var metadata := {}
	if source_joint_index < 0 or first_muscle_index < 0 or source_joint_index >= nodes.size() or first_muscle_index >= nodes.size():
		return metadata
	var joint_pos := _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, source_joint_index, "root_joint", -1)
	var first_muscle_pos := _topology_node_position(nodes[first_muscle_index])
	var rest_delta := first_muscle_pos - joint_pos
	metadata["topology_joint_pos"] = joint_pos
	metadata["topology_first_muscle_pos"] = first_muscle_pos
	if rest_delta.length() > 0.0001:
		metadata["topology_rest_direction_local"] = rest_delta.normalized()
	var torso_index := _topology_nearest_torso_node_index(role_key, unit_bp, nodes, edges, source_joint_index)
	if torso_index >= 0:
		var torso_pos := _topology_node_position(nodes[torso_index])
		metadata["topology_anchor_torso_node"] = torso_index
		metadata["topology_torso_pos"] = torso_pos
		metadata["topology_anchor_local"] = (joint_pos - torso_pos) * TOPOLOGY_BOARD_PHYSICAL_UNITS
		metadata["topology_anchor_valid"] = true
	return metadata


func _component_topology_attack_nodes(role_key: String, unit_bp: Dictionary, limit_to_attack_keys: bool = true) -> Array:
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	var synthetic_nodes: Array = []
	if not _topology_uses_component_nodes(nodes):
		return synthetic_nodes
	for driven_node_index in range(nodes.size()):
		var driven_node: Dictionary = nodes[driven_node_index]
		if not _topology_node_is_component(driven_node):
			continue
		var driven_slot := _topology_node_slot(driven_node)
		if driven_slot == "joint" or _topology_node_is_torso(role_key, driven_node, unit_bp):
			continue
		var driven_modules := _module_indices_for_topology_node(driven_node, unit_bp)
		if driven_modules.is_empty() and not driven_node.has("attack_key"):
			continue
		var has_two_link_module := false
		var has_live_melee_module := false
		for module_index in driven_modules:
			var module_part := _selected_component(role_key, "module", int(module_index))
			var module_profile := String(module_part.get("module_action_profile", ""))
			if String(module_profile) == "two_link_forward_snap":
				has_two_link_module = true
			has_live_melee_module = has_live_melee_module or _action_profile_registry().is_melee_profile(module_profile)
		var attack_key := int(driven_node.get("attack_key", synthetic_nodes.size() + 1))
		if limit_to_attack_keys and (attack_key < 1 or attack_key > ATTACK_GROUP_COUNT):
			continue
		if limit_to_attack_keys and synthetic_nodes.size() >= ATTACK_GROUP_COUNT:
			return synthetic_nodes
		var driven_part := _topology_node_part(role_key, driven_node, unit_bp)
		var limb_index := int(unit_bp.get("limb_muscle", 0))
		var terminal_index := -1
		var terminal_node_index := -1
		if driven_slot == "limb_muscle":
			limb_index = _topology_node_part_index(driven_node, unit_bp)
			var next_index := _next_topology_chain_node(role_key, unit_bp, nodes, edges, driven_node_index, -1)
			while next_index >= 0 and next_index < nodes.size():
				var next_node: Dictionary = nodes[next_index]
				if _topology_node_slot(next_node) == "muscle":
					var next_part := _topology_node_part(role_key, next_node, unit_bp)
					if _part_counts_as_terminal_weapon(next_part, "muscle"):
						terminal_index = _topology_node_part_index(next_node, unit_bp)
						terminal_node_index = next_index
						break
				next_index = _next_topology_chain_node(role_key, unit_bp, nodes, edges, next_index, driven_node_index)
		elif driven_slot == "muscle" and _part_counts_as_terminal_weapon(driven_part, "muscle"):
			terminal_index = _topology_node_part_index(driven_node, unit_bp)
			terminal_node_index = driven_node_index
		if terminal_index < 0:
			var limb_part := _selected_component(role_key, "limb_muscle", limb_index)
			if not has_two_link_module and not has_live_melee_module and not _part_can_damage_as_limb(limb_part, "limb_muscle"):
				continue
			if has_live_melee_module:
				terminal_index = _topology_node_part_index(driven_node, unit_bp)
				terminal_node_index = driven_node_index
			else:
				terminal_index = 84 if COMMON_CATALOG["muscle"].size() > 84 else int(unit_bp.get("muscle", 0))
		var modules: Array = []
		for module_index in driven_modules:
			if not modules.has(module_index):
				modules.append(module_index)
		if terminal_node_index >= 0:
			for module_index in _module_indices_for_topology_node(nodes[terminal_node_index], unit_bp):
				if not modules.has(module_index):
					modules.append(module_index)
		if modules.is_empty():
			continue
		var primary_module := int(modules[0])
		var boot_driver_module := -1
		var boot_driver_nodes: Array = []
		var boot_driver_extension := 0.0
		for module_index in modules:
			var module_part := _selected_component(role_key, "module", int(module_index))
			if String(module_part.get("module_action_profile", "")) != BOOT_ACTION_DRIVER_PROFILE:
				continue
			var resolved := _boot_driver_binding_nodes_for_selection(role_key, unit_bp, nodes, edges, [driven_node_index], module_part)
			if resolved.size() == 2:
				boot_driver_module = int(module_index)
				boot_driver_nodes = resolved
				var weapon_part := _topology_node_part(role_key, nodes[int(resolved[1])], unit_bp)
				boot_driver_extension = _boot_driver_weapon_extension_m(weapon_part, module_part)
				break
		if boot_driver_module >= 0:
			primary_module = boot_driver_module
			terminal_node_index = int(boot_driver_nodes[1])
			terminal_index = _topology_node_part_index(nodes[terminal_node_index], unit_bp)
		var label := String(driven_node.get("label", "LIMB")).replace("L%02d " % [driven_node_index + 1], "")
		var terminal_part_for_label := _selected_component(role_key, "muscle", terminal_index)
		label = "%s -> %s" % [_short_part_name(label), _short_part_name(String(terminal_part_for_label.get("name", "TIP")))]
		var synthetic := _topology_node_from_parts(
			synthetic_nodes.size(),
			label,
			_topology_socket_position_by_id(role_key, unit_bp, nodes, edges, driven_node_index, "root_joint"),
			0,
			terminal_index,
			primary_module,
			modules,
			limb_index
		)
		synthetic["id"] = "component_group_%d" % synthetic_nodes.size()
		synthetic["attack_key"] = attack_key
		synthetic["source_joint_node"] = driven_node_index
		synthetic["source_embedded_joint_node"] = driven_node_index
		synthetic["source_first_muscle_node"] = driven_node_index
		synthetic["embedded_joint_slot"] = driven_slot
		synthetic["embedded_joint_part"] = _topology_node_part_index(driven_node, unit_bp)
		var topology_anchor := _topology_attack_anchor_metadata(role_key, unit_bp, nodes, edges, driven_node_index, driven_node_index)
		for topology_key in topology_anchor.keys():
			synthetic[topology_key] = topology_anchor[topology_key]
		synthetic["source_module_nodes"] = [driven_node_index]
		if terminal_node_index >= 0:
			synthetic["source_module_nodes"].append(terminal_node_index)
		if boot_driver_module >= 0 and boot_driver_nodes.size() == 2:
			synthetic["boot_driver_rotating_node"] = int(boot_driver_nodes[0])
			synthetic["boot_driver_weapon_node"] = int(boot_driver_nodes[1])
			synthetic["boot_driver_extension_m"] = boot_driver_extension
		synthetic_nodes.append(synthetic)
	return synthetic_nodes


func _topology_chain_entry_for_node(role_key: String, unit_bp: Dictionary, node: Dictionary) -> Dictionary:
	var slot_key := _topology_node_slot(node)
	var part := _topology_node_part(role_key, node, unit_bp)
	var part_kind := "limb_muscle"
	if slot_key == "muscle" and _part_counts_as_terminal_weapon(part, "muscle"):
		part_kind = "terminal"
	elif slot_key == "muscle" and not bool(part.get("is_torso", false)):
		part_kind = "limb_muscle"
	var effective_part := _part_with_effective_terminal_geometry(part, slot_key)
	var radius := maxf(0.006, float(effective_part.get("radius", 0.035)))
	var entry := {
		"part_kind": part_kind,
		"length": maxf(0.0, float(effective_part.get("length", 0.0))),
		"radius": radius,
		"name": String(part.get("name", node.get("label", ""))),
		"slot": slot_key,
		"node_index": int(node.get("id", -1)),
	}
	if part_kind == "terminal":
		entry["terminal_geometry_scaled"] = true
	return entry


func _next_topology_chain_node(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, current_index: int, previous_index: int) -> int:
	if current_index < 0 or current_index >= nodes.size():
		return -1
	var best_terminal := -1
	var best_next := -1
	for neighbor_raw in _connected_topology_neighbors(edges, current_index, nodes.size()):
		var neighbor_index := int(neighbor_raw)
		if neighbor_index == previous_index or neighbor_index < 0 or neighbor_index >= nodes.size():
			continue
		var neighbor_node: Dictionary = nodes[neighbor_index]
		if not _topology_node_is_component(neighbor_node):
			continue
		var edge = _topology_find_edge_between(edges, current_index, neighbor_index)
		var current_socket := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, current_index))
		var neighbor_socket := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, neighbor_index))
		if current_socket != "distal" or neighbor_socket != "root_joint":
			continue
		var neighbor_slot := _topology_node_slot(neighbor_node)
		if neighbor_slot == "muscle":
			var neighbor_part := _topology_node_part(role_key, neighbor_node, unit_bp)
			if _part_counts_as_terminal_weapon(neighbor_part, "muscle"):
				best_terminal = neighbor_index
				continue
		if best_next < 0:
			best_next = neighbor_index
	return best_terminal if best_terminal >= 0 else best_next


func _topology_downstream_chain_entries(role_key: String, unit_bp: Dictionary, source_joint_index: int, first_muscle_index: int) -> Array:
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	if source_joint_index < 0 or first_muscle_index < 0 or source_joint_index >= nodes.size() or first_muscle_index >= nodes.size():
		return []
	if not _topology_node_is_component(nodes[source_joint_index]) or _topology_node_slot(nodes[source_joint_index]) == "joint":
		return []
	var entries: Array = []
	var previous := -1
	var current := source_joint_index
	var visited := {}
	var guard := 0
	var previous_axis := Vector2.ZERO
	while current >= 0 and current < nodes.size() and guard < 18:
		guard += 1
		if visited.has(current):
			break
		visited[current] = true
		var node: Dictionary = nodes[current]
		if not _topology_node_is_component(node):
			break
		var part := _topology_node_part(role_key, node, unit_bp)
		if bool(part.get("is_torso", false)):
			break
		var entry := _topology_chain_entry_for_node(role_key, unit_bp, node)
		if String(entry.get("part_kind", "")) in ["limb_muscle", "terminal"]:
			var rest_axis := _topology_endpoint_axis_for_node(current, nodes, edges)
			if rest_axis.length() > 0.0001:
				rest_axis = rest_axis.normalized()
				entry["rest_direction_local"] = rest_axis
				entry["local_angle"] = float(node.get("local_angle", 0.0))
				if previous_axis.length() > 0.0001:
					entry["relative_angle_to_previous"] = wrapf(rest_axis.angle() - previous_axis.angle(), -PI, PI)
				else:
					entry["relative_angle_to_previous"] = 0.0
				previous_axis = rest_axis
		entries.append(entry)
		if String(entry.get("part_kind", "")) == "terminal":
			break
		var next_index := _next_topology_chain_node(role_key, unit_bp, nodes, edges, current, previous)
		previous = current
		current = next_index
	return entries


