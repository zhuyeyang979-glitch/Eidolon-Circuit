		str(custom_board_enabled),
		custom_board_cache_key,
		_editor_board_dynamic_revision_key() if custom_board_enabled else "",
		editor_topology_node_index,
		editor_open_torso_node_index,
		editor_board_tool,
		editor_pending_place_slot,
		str(editor_pending_place_index),
		editor_pending_payload_slot,
		str(editor_pending_payload_index),
		_editor_visual_stats_revision_key(visual_stats),
		1 if editor_barrier_grid_guides_enabled else 0,
		_battle_terrain_snapshot_revision_key() if role_key == "barrier" and _barrier_uses_screen_board(unit_bp) else "",
	]


func _sync_editor_board_visual_domain_after_fast_update(role_key: String, unit_bp: Dictionary, custom_board_cache_key: String = "") -> void:
	var custom_board_enabled := _role_uses_body_board(role_key) \
			and unit_bp.has("custom_topology") \
			and not (role_key == "barrier" and _barrier_uses_screen_board(unit_bp))
	if not custom_board_enabled:
		return
	if custom_board_cache_key == "":
		custom_board_cache_key = _editor_board_snapshot_cache_key(role_key, unit_bp)
	if custom_board_cache_key == "":
		return
	editor_board_visual_domain_revision_key = _editor_board_visual_domain_key(
		role_key,
		unit_bp,
		custom_board_enabled,
		custom_board_cache_key,
		_editor_lightweight_board_stats()
	)


func _editor_fast_enriched_board_node(role_key: String, unit_bp: Dictionary, source_nodes: Array, source_edges: Array, index: int) -> Dictionary:
	if index < 0 or index >= source_nodes.size() or not (source_nodes[index] is Dictionary):
		return {}
	var node: Dictionary = Dictionary(source_nodes[index]).duplicate(false)
	if not _topology_node_is_component(node):
		return node
	var slot_key := _topology_node_slot(node)
	var part := _topology_node_part(role_key, node, unit_bp)
	var part_index := int(node.get("part_index", -1))
	var template := _placement_template_for_part(slot_key, part_index, false)
	var effective_part := _part_with_effective_terminal_geometry(part, slot_key)
	var component_node := Dictionary(template.get("component_node", {})) if not template.is_empty() else AssemblyBoardRenderer.part_to_component_node(slot_key, effective_part)
	var saved_handedness := _topology_node_visual_handedness(node) if node.has("visual_mount_side") or node.has("visual_handedness") else ""
	for key in component_node.keys():
		node[key] = component_node[key]
	if saved_handedness != "":
		node["visual_mount_side"] = saved_handedness
		node["visual_handedness"] = saved_handedness
	_apply_visual_handedness_defaults_to_node(node, part, slot_key)
	if _topology_node_supports_visual_handedness(role_key, unit_bp, node):
		node["mount_parent_axis_local"] = _topology_mount_parent_axis_for_node(role_key, unit_bp, source_nodes, source_edges, index)
	node["slot"] = slot_key
	node["damage_type"] = String(part.get("projectile_damage_type", part.get("damage_type", "blunt")))
	node["component_length"] = float(template.get("component_length", effective_part.get("length", 0.0)))
	node["joint_length"] = float(effective_part.get("length", 0.0)) if slot_key == "joint" else 0.0
	node["muscle_length"] = float(effective_part.get("length", 0.0)) if slot_key == "limb_muscle" else 0.0
	node["terminal_length"] = float(effective_part.get("length", 0.0)) if slot_key == "muscle" else 0.0
	node["component_radius"] = maxf(0.012, float(template.get("component_radius", effective_part.get("radius", 0.04))))
	node["component_mass"] = maxf(0.0, float(template.get("component_mass", part.get("mass", 0.0))))
	node["component_name"] = String(template.get("part_name", part.get("name", node.get("label", ""))))
	node["terminal_weapon"] = bool(template.get("terminal_weapon", part.get("terminal_weapon", node.get("terminal_weapon", false))))
	node["connection_ends"] = int(template.get("connection_ends", part.get("connection_ends", node.get("connection_ends", 2))))
	node["size_class"] = String(template.get("size_class", part.get("size_class", part.get("slot_volume_tier", ""))))
	node["material_class"] = String(template.get("material_class", part.get("material_class", slot_key)))
	node["shape"] = String(template.get("shape", part.get("shape", node.get("shape", slot_key))))
	node["projectile"] = bool(template.get("projectile", part.get("projectile", false)))
	node["is_torso"] = bool(template.get("is_torso", part.get("is_torso", false)))
	node["joint_ports"] = _torso_external_joint_ports(part) if _component_is_torso(part) else int(part.get("joint_ports", part.get("connection_ends", 0)))
	node["module_slots"] = _torso_software_capacity_for_part(part) if _component_is_torso(part) else int(part.get("module_slots", 0))
	node["torso_slots"] = _torso_plugin_capacity_for_part(part) if _component_is_torso(part) else int(part.get("torso_slots", 0))
	if _component_is_torso(part):
		node["torso_port_directions"] = _torso_port_directions(part)
		node["occupied_ports"] = _torso_occupied_port_indices(role_key, unit_bp, source_nodes, source_edges, index)
		node["torso_detail_open"] = index == editor_open_torso_node_index
		node["torso_hovered"] = false
	node["edge_extent_units"] = _topology_node_edge_extent_units(role_key, node, unit_bp)
	node["projectile_damage_type"] = String(part.get("projectile_damage_type", part.get("damage_type", "")))
	node["projectile_behavior"] = String(part.get("projectile_behavior", part.get("projectile_style", "")))
	node["range"] = float(part.get("projectile_range", part.get("range", 0.0)))
	node["material_visual"] = String(part.get("material_visual", part.get("torso_material", "")))
	node["archetype"] = String(part.get("archetype", ""))
	node["module_count"] = _module_indices_for_topology_node(node, unit_bp).size()
	node["label"] = String(node.get("label", _topology_component_label(slot_key, part, index)))
	if slot_key == "joint":
		node["downstream_rotation_radius_units"] = _topology_joint_max_rotation_radius_units(role_key, unit_bp, source_nodes, source_edges, index)
	return node


func _refresh_editor_visual_views_fast_drag(changed_nodes: Array = [], component_only: bool = false, retained_pose_diff: bool = false) -> void:
	if assembly_board_view == null:
		return
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	if role_key == "barrier" and _barrier_uses_screen_board(unit_bp):
		_refresh_editor_visual_views({}, false)
		return
	if not _role_uses_body_board(role_key) or not unit_bp.has("custom_topology") or editor_board_base_snapshot_cache.is_empty():
		_refresh_editor_visual_views({}, false)
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var source_nodes: Array = Array(topology.get("nodes", []))
	var source_edges: Array = Array(topology.get("edges", []))
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("pose.visual.snapshot")
	var snapshot: Dictionary = editor_board_base_snapshot_cache.duplicate(false)
	var nodes: Array = Array(snapshot.get("nodes", [])).duplicate(false)
	if nodes.size() != source_nodes.size():
		nodes.resize(source_nodes.size())
	var indices: Array = changed_nodes.duplicate()
	if indices.is_empty():
		for i in range(source_nodes.size()):
			indices.append(i)
	for raw_index in indices:
		var index := int(raw_index)
		if index < 0 or index >= nodes.size() or index >= source_nodes.size() or not (source_nodes[index] is Dictionary):
			continue
		var source_node: Dictionary = source_nodes[index]
		var node: Dictionary = Dictionary(nodes[index]).duplicate(false) if nodes[index] is Dictionary else _editor_fast_enriched_board_node(role_key, unit_bp, source_nodes, source_edges, index)
		if node.is_empty() or not node.has("component_name"):
			node = _editor_fast_enriched_board_node(role_key, unit_bp, source_nodes, source_edges, index)
		for pose_key in ["pos", "axis", "rotation", "local_angle", "local_extension", "parent_node", "parent_socket", "root_socket"]:
			if source_node.has(pose_key):
				node[pose_key] = source_node[pose_key]
		nodes[index] = node
	for i in range(source_nodes.size()):
		if i >= nodes.size() or nodes[i] is Dictionary:
			continue
		nodes[i] = _editor_fast_enriched_board_node(role_key, unit_bp, source_nodes, source_edges, i)
	var shallow_edges: Array = []
	shallow_edges.resize(source_edges.size())
	for edge_i in range(source_edges.size()):
		shallow_edges[edge_i] = Dictionary(source_edges[edge_i]).duplicate(false) if source_edges[edge_i] is Dictionary else source_edges[edge_i]
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("pose.visual.snapshot")
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("pose.visual.art_positions")
	nodes = _board_nodes_with_art_visual_positions(role_key, unit_bp, nodes, shallow_edges)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("pose.visual.art_positions")
	snapshot["nodes"] = nodes
	snapshot["edges"] = shallow_edges
	var base_key := String(editor_board_base_snapshot_cache_key)
	if base_key == "":
		base_key = _editor_board_snapshot_cache_key(role_key, unit_bp)
	var current_base_key := _editor_board_snapshot_cache_key(role_key, unit_bp)
	if current_base_key != "":
		base_key = current_base_key
		editor_board_base_snapshot_cache = snapshot.duplicate(false)
		editor_board_base_snapshot_cache_key = current_base_key
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("pose.visual.dynamic")
	if retained_pose_diff:
		snapshot = _apply_editor_board_pose_dynamic_fields(snapshot, role_key, unit_bp, nodes, shallow_edges, indices, base_key)
	else:
		snapshot = _apply_editor_board_dynamic_fields(snapshot, role_key, unit_bp, base_key, {})
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("pose.visual.dynamic")
	editor_fast_board_revision_counter += 1
	var fast_revision := "%s|fast:%d:%d:%d:%d" % [
		base_key,
		editor_fast_board_revision_counter,
		int(editor_dragging_node_index),
		int(editor_pose_root_node),
		indices.size(),
	]
	snapshot["revision_key"] = fast_revision
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("pose.visual.apply_diff")
	assembly_board_view.apply_board_diff({
		"snapshot": snapshot,
		"changed_nodes": indices,
		"component_only": component_only or retained_pose_diff,
		"defer_component_draw": component_only and not retained_pose_diff,
		"update_edge_socket_items": retained_pose_diff,
		"selected_part": editor_selected_body_part,
		"illegal_parts": {},
		"snap_part": editor_snap_part,
		"snap_amount": clampf(editor_snap_timer / 0.28, 0.0, 1.0),
		"mode": "custom",
		"language": ui_language,
		"motion_phase": editor_canvas_motion_phase,
	}, fast_revision)
	_sync_editor_board_visual_domain_after_fast_update(role_key, unit_bp, base_key)
	_refresh_editor_orientation_popup()
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("pose.visual.apply_diff")


func _apply_editor_component_node_direct(node_index: int, defer_draw: bool = true) -> bool:
	if assembly_board_view == null or node_index < 0:
		return false
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	if not _role_uses_body_board(role_key) or not unit_bp.has("custom_topology"):
		return false
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var source_nodes: Array = Array(topology.get("nodes", []))
	var source_edges: Array = Array(topology.get("edges", []))
	if node_index >= source_nodes.size():
		return false
	var node := Dictionary(editor_last_added_topology_node_snapshot).duplicate(false) if node_index == editor_last_added_topology_node_index and not editor_last_added_topology_node_snapshot.is_empty() else _editor_fast_enriched_board_node(role_key, unit_bp, source_nodes, source_edges, node_index)
	if node.is_empty():
		return false
	var visual_nodes := _board_nodes_with_art_visual_positions(role_key, unit_bp, [node], [])
	if not visual_nodes.is_empty() and visual_nodes[0] is Dictionary:
		node = visual_nodes[0]
	editor_fast_board_revision_counter += 1
	var fast_revision := "component:%d:%d:%s" % [
		node_index,
		editor_fast_board_revision_counter,
		_editor_board_dynamic_revision_key(),
	]
	assembly_board_view.apply_component_node_diff(node_index, node, fast_revision, defer_draw)
	_sync_editor_board_visual_domain_after_fast_update(role_key, unit_bp)
	return true


func _record_engine_allocation_undo_once() -> void:
	if editor_engine_allocation_undo_recorded:
		return
	_record_editor_undo_state("调整连接件动力" if _ui_is_zh() else "adjust connector drive")
	editor_engine_allocation_undo_recorded = true


func _set_engine_momentum_allocation_ratio(entry_id: String, requested_ratio: float) -> void:
	var unit_bp: Dictionary = _editor_current_blueprint()
	var entry := _engine_allocation_view_entry_for_id(entry_id)
	if bool(entry.get("readonly", false)):
		return
	var pool := maxf(0.0, float(engine_momentum_allocation_view.engine_output)) if engine_momentum_allocation_view != null and engine_momentum_allocation_view.visible else 0.0
	var ratio := _engine_allocation_clamped_ratio_from_entries(Array(engine_momentum_allocation_view.entries), entry_id, requested_ratio, pool) if engine_momentum_allocation_view != null and engine_momentum_allocation_view.visible else 0.0
	if entry.is_empty() or pool <= 0.0:
		var data := {}
		if engine_momentum_allocation_view != null and engine_momentum_allocation_view.visible:
			data = _engine_momentum_allocation_data(unit_bp, editor_engine_allocation_torso_node_index, editor_engine_allocation_payload_index)
		else:
			var target := _editor_active_engine_allocation_target()
			if not target.is_empty():
				data = Dictionary(target.get("data", {}))
		entry = _engine_allocation_entry_for_id(data, entry_id)
		pool = maxf(0.0, float(data.get("engine_output", 0.0)))
		ratio = _engine_allocation_clamped_ratio(data, entry_id, requested_ratio)
	if entry.is_empty():
		return
	if bool(entry.get("readonly", false)):
		return
	_record_engine_allocation_undo_once()
	var momentum := pool * ratio
	_write_engine_allocation_entry_momentum(unit_bp, entry, momentum)
	_invalidate_editor_current_stats_cache()
	_update_engine_allocation_view_entry(entry_id, ratio, momentum)
	ai_team_manual_lock[_editor_player()] = true
	_refresh_editor_dashboard_after_allocation(false)


func _set_engine_momentum_allocation_value(entry_id: String, requested_momentum: float) -> void:
	var unit_bp: Dictionary = _editor_current_blueprint()
	var data := {}
	if engine_momentum_allocation_view != null and engine_momentum_allocation_view.visible:
		data = {
			"entries": Array(engine_momentum_allocation_view.entries),
			"engine_output": engine_momentum_allocation_view.engine_output,
		}
	else:
		var target := _editor_active_engine_allocation_target()
		if not target.is_empty():
			data = Dictionary(target.get("data", {}))
	if data.is_empty():
		return
	var entry := _engine_allocation_entry_for_id(data, entry_id)
	if entry.is_empty() or bool(entry.get("readonly", false)):
		return
	var pool := maxf(0.0, float(data.get("engine_output", 0.0)))
	var momentum := _engine_allocation_clamped_momentum_from_entries(Array(data.get("entries", [])), entry_id, requested_momentum, pool)
	var ratio := momentum / maxf(1.0, pool) if pool > 0.0 else 0.0
	_record_engine_allocation_undo_once()
	_write_engine_allocation_entry_momentum(unit_bp, entry, momentum)
	_invalidate_editor_current_stats_cache()
	_update_engine_allocation_view_entry(entry_id, ratio, momentum)
	ai_team_manual_lock[_editor_player()] = true
	_refresh_editor_dashboard_after_allocation(false)


func _finish_engine_momentum_allocation_drag(_entry_id: String = "") -> void:
	_refresh_editor_dashboard_after_allocation(true)


func _refresh_editor_dashboard_after_allocation(full_refresh: bool) -> void:
	if full_refresh:
		editor_allocation_full_refresh_count += 1
		editor_deferred_full_refresh_request_count += 1
		mark_editor_dirty(EDITOR_DIRTY_DASHBOARD | EDITOR_DIRTY_STATS | EDITOR_DIRTY_LEGALITY | EDITOR_DIRTY_DETAIL | EDITOR_DIRTY_ACTION_BUTTONS)
		_refresh_editor_dashboard_after_allocation(false)
		return
	editor_allocation_light_refresh_count += 1
	# Slider drag must stay cheap: live allocation numbers update immediately,
	# while stats/legal/detail recompute is deferred to drag end or idle flush.
	if engine_momentum_allocation_view != null and engine_momentum_allocation_view.visible:
		engine_momentum_allocation_view.queue_redraw()
	_refresh_engine_allocation_dashboard_summary()


func _equalize_engine_momentum_allocation() -> void:
	var unit_bp: Dictionary = _editor_current_blueprint()
	var data := _engine_momentum_allocation_data(unit_bp, editor_engine_allocation_torso_node_index, editor_engine_allocation_payload_index)
	var entries: Array = Array(data.get("entries", []))
	if entries.is_empty():
		return
	var momentum_by_id := _power_allocation_service().equalized_entry_momentum(entries, float(data.get("engine_output", 0.0)))
	if momentum_by_id.is_empty():
		return
	_record_engine_allocation_undo_once()
	for raw_entry in entries:
		if not (raw_entry is Dictionary):
			continue
		var entry: Dictionary = raw_entry
		var entry_id := String(entry.get("id", ""))
		if not momentum_by_id.has(entry_id):
			continue
		_write_engine_allocation_entry_momentum(unit_bp, entry, float(momentum_by_id.get(entry_id, 0.0)))
	_invalidate_editor_current_stats_cache()
	ai_team_manual_lock[_editor_player()] = true
	if engine_momentum_allocation_view != null and engine_momentum_allocation_view.visible:
		_refresh_engine_momentum_allocation_view()
	_refresh_editor_dashboard_after_allocation(true)


func _trim_text(value: String, max_chars: int) -> String:
	if value.length() <= max_chars:
		return value
	return value.substr(0, maxi(1, max_chars - 1)) + "."


func _topology_node_connection_limit(role_key: String, node: Dictionary, unit_bp: Dictionary) -> int:
	if not _topology_node_is_component(node):
		return 999
	var slot_key := _topology_node_slot(node)
	var part := _topology_node_part(role_key, node, unit_bp)
	if slot_key == "joint":
		return 0
	if slot_key == "limb_muscle":
		return 2
	if slot_key == "muscle":
		if _component_is_torso(part):
			return _torso_external_joint_ports(part)
		if _part_counts_as_terminal_weapon(part, "muscle") or bool(part.get("projectile", false)):
			return 1
		return clampi(int(part.get("connection_ends", 2)), 1, 2)
	return 999


func _topology_node_has_connection_capacity(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int) -> bool:
	if node_index < 0 or node_index >= nodes.size():
		return false
	var limit := _topology_node_connection_limit(role_key, nodes[node_index], unit_bp)
	return _topology_node_edge_count(edges, node_index) < limit


func _topology_edge_capacity_note(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, a: int, b: int) -> String:
	for node_index in [a, b]:
		if node_index < 0 or node_index >= nodes.size():
			return "INVALID: topology edge references missing node."
		var node: Dictionary = nodes[node_index]
		if not _topology_node_is_component(node):
			continue
		var limit := _topology_node_connection_limit(role_key, node, unit_bp)
		var current := _topology_node_edge_count(edges, node_index)
		if current >= limit:
			var slot_key := _topology_node_slot(node)
			if slot_key == "joint":
				return "INVALID: node %d is a deprecated independent joint. Rebuild with embedded-joint muscles." % [node_index + 1]
			return "INVALID: node %d has %d/%d occupied interfaces." % [node_index + 1, current, limit]
	return ""


func _topology_edge_can_connect(node_a: Dictionary, node_b: Dictionary) -> bool:
	if not _topology_node_is_component(node_a) or not _topology_node_is_component(node_b):
		return true
	if _topology_node_slot(node_a) == "joint" or _topology_node_slot(node_b) == "joint":
		return false
	var family_a := _topology_slot_family(_topology_node_slot(node_a))
	var family_b := _topology_slot_family(_topology_node_slot(node_b))
	if family_a != "muscle" or family_b != "muscle":
		return false
	var a_torso := bool(node_a.get("is_torso_node", node_a.get("is_torso", false)))
	var b_torso := bool(node_b.get("is_torso_node", node_b.get("is_torso", false)))
	return not (a_torso and b_torso)


func _topology_node_limb_material_key(role_key: String, unit_bp: Dictionary, node: Dictionary) -> String:
	if not _topology_node_is_component(node):
		return ""
	var slot_key := _topology_node_slot(node)
	if slot_key == "joint":
		return ""
	var part := _topology_node_part(role_key, node, unit_bp)
	if slot_key == "limb_muscle":
		return _stiffness_segment_material_family_for_part(part, slot_key)
	if slot_key == "muscle":
		if _component_is_torso(part):
			return ""
		if _part_counts_as_terminal_weapon(part, "muscle"):
			return ""
		if bool(part.get("projectile", false)) or int(part.get("connection_ends", 1)) <= 1:
			return ""
		return _stiffness_segment_material_family_for_part(part, slot_key)
	return ""


func _topology_node_is_limb_material_member(role_key: String, unit_bp: Dictionary, node: Dictionary) -> bool:
	return _topology_node_limb_material_key(role_key, unit_bp, node) != ""


func _topology_limb_material_context(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, anchor_index: int, excluded_nodes: Array = []) -> Dictionary:
	var excluded := {}
	for raw_index in excluded_nodes:
		excluded[int(raw_index)] = true
	var group_nodes: Array = []
	var material_nodes: Array = []
	var materials := {}
	if anchor_index < 0 or anchor_index >= nodes.size() or bool(excluded.get(anchor_index, false)):
		return {"group_nodes": group_nodes, "material_nodes": material_nodes, "materials": materials}
	var visited := {}
	var queue: Array = [anchor_index]
	while not queue.is_empty():
		var current := int(queue.pop_front())
		if current < 0 or current >= nodes.size() or bool(visited.get(current, false)) or bool(excluded.get(current, false)):
			continue
		visited[current] = true
		if not (nodes[current] is Dictionary):
			continue
		var node: Dictionary = nodes[current]
		if not _topology_node_is_component(node):
			continue
		var is_torso := _topology_node_is_torso(role_key, node, unit_bp)
		if not is_torso:
			group_nodes.append(current)
		var material_key := _topology_node_limb_material_key(role_key, unit_bp, node)
		if material_key != "":
			material_nodes.append(current)
			materials[material_key] = true
		if is_torso:
			continue
		for neighbor_raw in _connected_topology_neighbors(edges, current, nodes.size()):
			var neighbor_index := int(neighbor_raw)
			if neighbor_index >= 0 and neighbor_index < nodes.size() and not bool(visited.get(neighbor_index, false)) and not bool(excluded.get(neighbor_index, false)):
				queue.append(neighbor_index)
	return {"group_nodes": group_nodes, "material_nodes": material_nodes, "materials": materials}


func _topology_material_edge_error(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, a: int, b: int) -> String:
	if a < 0 or b < 0 or a >= nodes.size() or b >= nodes.size() or a == b:
		return ""
	if _topology_edge_exists(edges, a, b):
		return ""
	for pair in [[a, b], [b, a]]:
		var material_index := int(pair[0])
		var anchor_index := int(pair[1])
		var node: Dictionary = nodes[material_index]
		var material_key := _topology_node_limb_material_key(role_key, unit_bp, node)
		if material_key == "":
			continue
		var context := _topology_limb_material_context(role_key, unit_bp, nodes, edges, anchor_index, [material_index])
		var materials: Dictionary = context.get("materials", {})
		for existing_raw in materials.keys():
			var existing := String(existing_raw)
			if existing != "" and existing != material_key:
				return "INVALID: material mismatch; same limb connectors must use one material (%s vs %s)." % [material_key, existing]
	return ""


func _topology_node_uses_endpoint_sides(role_key: String, node: Dictionary, unit_bp: Dictionary) -> bool:
	if not _topology_node_is_component(node):
		return false
	var slot_key := _topology_node_slot(node)
	if slot_key == "joint":
		return false
	if slot_key == "limb_muscle":
		return true
	if slot_key != "muscle":
		return false
	var part := _topology_node_part(role_key, node, unit_bp)
	if bool(part.get("is_torso", false)):
		return false
	return true


func _topology_node_is_single_endpoint_muscle(role_key: String, node: Dictionary, unit_bp: Dictionary) -> bool:
	if not _topology_node_is_component(node):
		return false
	if _topology_node_slot(node) != "muscle":
		return false
	var part := _topology_node_part(role_key, node, unit_bp)
	if _component_is_torso(part):
		return false
	return int(part.get("connection_ends", 1)) <= 1 or _part_counts_as_terminal_weapon(part, "muscle") or bool(part.get("projectile", false))


func _topology_terminal_connect_side(role_key: String, node: Dictionary, unit_bp: Dictionary) -> int:
	return -1 if _topology_node_is_single_endpoint_muscle(role_key, node, unit_bp) else 0


func _topology_edge_node_a(edge) -> int:
	if edge is Dictionary:
		return int(Dictionary(edge).get("a_node", Dictionary(edge).get("a", -1)))
	if edge is Array and edge.size() >= 2:
		return int(edge[0])
	return -1


func _topology_edge_node_b(edge) -> int:
	if edge is Dictionary:
		return int(Dictionary(edge).get("b_node", Dictionary(edge).get("b", -1)))
	if edge is Array and edge.size() >= 2:
		return int(edge[1])
	return -1


func _topology_edge_socket_for_node(edge, node_index: int) -> String:
	if edge is Dictionary:
		var dict: Dictionary = edge
		if int(dict.get("a_node", dict.get("a", -1))) == node_index:
			return String(dict.get("a_socket", ""))
		if int(dict.get("b_node", dict.get("b", -1))) == node_index:
			return String(dict.get("b_socket", ""))
	return ""


func _topology_make_socket_edge(a: int, a_socket: String, b: int, b_socket: String) -> Dictionary:
	return {
		"a_node": a,
		"a_socket": a_socket,
		"b_node": b,
		"b_socket": b_socket,
		"schema": "socket_edge_v1",
	}


func _topology_edge_other_node(edge, node_index: int) -> int:
	var a := _topology_edge_node_a(edge)
	var b := _topology_edge_node_b(edge)
	if a == node_index:
		return b
	if b == node_index:
		return a
	return -1


func _topology_edge_has_node(edge, node_index: int) -> bool:
	return _topology_edge_node_a(edge) == node_index or _topology_edge_node_b(edge) == node_index


func _topology_find_edge_between(edges: Array, a: int, b: int):
	for edge in edges:
		var edge_a := _topology_edge_node_a(edge)
		var edge_b := _topology_edge_node_b(edge)
		if (edge_a == a and edge_b == b) or (edge_a == b and edge_b == a):
			return edge
	return null


func _topology_endpoint_axis_for_node(node_index: int, nodes: Array, edges: Array) -> Vector2:
	if node_index < 0 or node_index >= nodes.size():
		return Vector2.RIGHT
	var center := _topology_node_position(nodes[node_index])
	if nodes[node_index] is Dictionary and Dictionary(nodes[node_index]).has("axis"):
		var stored_axis = Dictionary(nodes[node_index]).get("axis")
		if stored_axis is Vector2 and Vector2(stored_axis).length() > 0.0001:
			return Vector2(stored_axis).normalized()
	if nodes[node_index] is Dictionary:
		var node_dict: Dictionary = nodes[node_index]
		var slot_key := _topology_node_slot(node_dict)
		var material_class := String(node_dict.get("material_class", "")).to_lower()
		if slot_key == "muscle" and (bool(node_dict.get("is_torso", false)) or material_class == "torso"):
			return Vector2.RIGHT
	var neighbors := _connected_topology_neighbors(edges, node_index, nodes.size())
	if neighbors.size() >= 2:
		var negative_pos := Vector2.INF
		var positive_pos := Vector2.INF
		for neighbor_raw in neighbors:
			var neighbor := int(neighbor_raw)
			var edge = _topology_find_edge_between(edges, node_index, neighbor)
			var socket_id := _topology_edge_socket_for_node(edge, node_index)
			if socket_id in ["end:a", "handle", "side:-1", "side:a", "root_joint"]:
				negative_pos = _topology_node_position(nodes[neighbor])
			elif socket_id in ["end:b", "side:1", "side:b", "distal"]:
				positive_pos = _topology_node_position(nodes[neighbor])
		var paired_axis := Vector2.ZERO
		if negative_pos != Vector2.INF and positive_pos != Vector2.INF:
			paired_axis = positive_pos - negative_pos
		else:
			var first := _topology_node_position(nodes[int(neighbors[0])])
			var second := _topology_node_position(nodes[int(neighbors[1])])
			paired_axis = second - first
		if paired_axis.length() > 0.0001:
			return paired_axis.normalized()
	if neighbors.size() == 1:
		var neighbor := int(neighbors[0])
		var edge = _topology_find_edge_between(edges, node_index, neighbor)
		var socket_id := _topology_edge_socket_for_node(edge, node_index)
		var side := _topology_socket_side_value(socket_id)
		var to_neighbor := _topology_node_position(nodes[neighbor]) - center
		if abs(side) > 0 and to_neighbor.length() > 0.0001:
			return to_neighbor.normalized() * float(side)
		var outward := center - _topology_node_position(nodes[neighbor])
		if outward.length() > 0.0001:
			return outward.normalized()
	return Vector2.RIGHT


func _topology_endpoint_axis_for_socket(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int, neighbor_index: int) -> Vector2:
	var axis := _topology_endpoint_axis_for_node(node_index, nodes, edges)
	if node_index < 0 or node_index >= nodes.size():
		return axis
	var node: Dictionary = nodes[node_index]
	if neighbor_index >= 0 and neighbor_index < nodes.size():
		var edge = _topology_find_edge_between(edges, node_index, neighbor_index)
		var own_socket := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, node_index))
		var neighbor_socket := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, neighbor_index))
		var side := _topology_socket_side_value(own_socket)
		if side != 0 and neighbor_socket != "" and _topology_node_is_torso(role_key, nodes[neighbor_index], unit_bp):
			var target_pos := _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, neighbor_index, neighbor_socket, node_index)
			var to_target := target_pos - _topology_node_position(node)
			if to_target.length() > 0.0001:
				axis = -to_target.normalized() if side < 0 else to_target.normalized()
	if _topology_node_is_single_endpoint_muscle(role_key, node, unit_bp) and _connected_topology_neighbors(edges, node_index, nodes.size()).is_empty() and neighbor_index >= 0 and neighbor_index < nodes.size():
		var outward := _topology_node_position(node) - _topology_node_position(nodes[neighbor_index])
		if outward.length() > 0.0001:
			axis = outward.normalized()
	if axis.length() < 0.0001:
		axis = Vector2.RIGHT
	return axis.normalized()


func _topology_socket_ids_for_node(role_key: String, node: Dictionary, unit_bp: Dictionary) -> Array:
	if not _topology_node_is_component(node):
		return ["body"]
	var slot_key := _topology_node_slot(node)
	if _topology_node_is_torso(role_key, node, unit_bp):
		var part := _topology_node_part(role_key, node, unit_bp)
		var ids: Array = []
		for i in range(_torso_external_joint_ports(part)):
			ids.append("torso_port:%d" % i)
		return ids
	if slot_key == "joint":
		return []
	# Saved direct-topology units store their socket contract on the node.  Use
	# that as the authority before falling back to catalog heuristics, otherwise
	# older terminal weapons whose catalog metadata is incomplete can become
	# falsely illegal even though their root socket is explicit in the blueprint.
	var explicit_root := String(node.get("root_socket", ""))
	var explicit_distal := String(node.get("distal_socket", ""))
	if explicit_root == "root_joint":
		if explicit_distal == "distal" or slot_key == "limb_muscle" or (slot_key == "muscle" and not _topology_node_is_single_endpoint_muscle(role_key, node, unit_bp)):
			return ["root_joint", "distal"]
		return ["root_joint"]
	if _topology_node_is_single_endpoint_muscle(role_key, node, unit_bp):
		return ["root_joint"]
	if _topology_node_uses_endpoint_sides(role_key, node, unit_bp):
		return ["root_joint", "distal"]
	return ["center"]


func _topology_canonical_socket_id(socket_id: String) -> String:
	return TopologyGeometry.canonical_socket_id(socket_id)


func _topology_socket_is_connectable(role_key: String, node: Dictionary, unit_bp: Dictionary, socket_id: String) -> bool:
	var id := _topology_canonical_socket_id(socket_id)
	if id == "center":
		return false
	if id == "body":
		return true
	if _topology_node_is_torso(role_key, node, unit_bp):
		return id.begins_with("torso_port:")
	if _topology_node_slot(node) == "joint":
		return false
	var explicit_root := String(node.get("root_socket", ""))
	var explicit_distal := String(node.get("distal_socket", ""))
	if id == "root_joint" and explicit_root == "root_joint":
		return true
	if id == "distal" and explicit_distal == "distal":
		return true
	if _topology_node_is_single_endpoint_muscle(role_key, node, unit_bp):
		return id == "root_joint"
	return id in ["root_joint", "distal"]


func _topology_socket_side_value(socket_id: String) -> int:
	return TopologyGeometry.socket_side_value(socket_id)


func _topology_joint_socket_accepts_direction(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, joint_index: int, socket_id: String, other_index: int) -> bool:
	# Independent joint nodes are deprecated. Embedded-joint muscles use socket
	# occupancy and root/distal directionality instead of side direction gates.
	return true


func _topology_socket_position_by_id(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int, socket_id: String, neighbor_index: int = -1) -> Vector2:
	if node_index < 0 or node_index >= nodes.size():
		return Vector2.ZERO
	var node: Dictionary = nodes[node_index]
	var center := _topology_node_position(node)
	var id := _topology_canonical_socket_id(socket_id)
	if _topology_node_is_torso(role_key, node, unit_bp):
		var port_positions := _topology_torso_port_positions(role_key, node, unit_bp)
		if id.begins_with("torso_port:"):
			var port_index := clampi(int(id.get_slice(":", 1)), 0, maxi(0, port_positions.size() - 1))
			if port_positions.size() > 0:
				return port_positions[port_index]
		return center
	if _topology_node_slot(node) == "joint":
		return center
	if _topology_node_uses_endpoint_sides(role_key, node, unit_bp):
		var axis := _topology_endpoint_axis_for_socket(role_key, unit_bp, nodes, edges, node_index, neighbor_index)
		if axis.length() < 0.0001:
			axis = Vector2.RIGHT
		var side := _topology_socket_side_value(id)
		var extent := _topology_node_visual_edge_extent_units(role_key, node, unit_bp, id) / TOPOLOGY_BOARD_PHYSICAL_UNITS
		return center + axis.normalized() * extent * float(side)
	return center


func _topology_socket_specs_for_node(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int, neighbor_index: int = -1) -> Array:
	var specs: Array = []
	if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
		return specs
	var node: Dictionary = nodes[node_index]
	for raw_id in _topology_socket_ids_for_node(role_key, node, unit_bp):
		var socket_id := String(raw_id)
		specs.append({
			"id": socket_id,
			"pos": _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, node_index, socket_id, neighbor_index),
			"side": _topology_socket_side_value(socket_id),
			"connectable": _topology_socket_is_connectable(role_key, node, unit_bp, socket_id),
		})
	return specs


func _topology_socket_spec_by_id(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int, socket_id: String, neighbor_index: int = -1) -> Dictionary:
	var id := _topology_canonical_socket_id(socket_id)
	for spec in _topology_socket_specs_for_node(role_key, unit_bp, nodes, edges, node_index, neighbor_index):
		if spec is Dictionary and _topology_canonical_socket_id(String(Dictionary(spec).get("id", ""))) == id:
			return Dictionary(spec)
	return {}


func _topology_endpoint_side_for_neighbor(node_index: int, neighbor_index: int, nodes: Array, edges: Array) -> int:
	if node_index < 0 or neighbor_index < 0 or node_index >= nodes.size() or neighbor_index >= nodes.size():
		return 1
	var axis := _topology_endpoint_axis_for_node(node_index, nodes, edges)
	if axis.length() < 0.0001:
		axis = Vector2.RIGHT
	var direction := _topology_node_position(nodes[neighbor_index]) - _topology_node_position(nodes[node_index])
	if direction.length() < 0.0001:
		return 1
	return 1 if direction.normalized().dot(axis.normalized()) >= 0.0 else -1


func _topology_socket_for_connection(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int, neighbor_index: int) -> Dictionary:
	if node_index < 0 or neighbor_index < 0 or node_index >= nodes.size() or neighbor_index >= nodes.size():
		return {}
	var node: Dictionary = nodes[node_index]
	if not _topology_node_is_component(node):
		return {"id": "body", "pos": _topology_node_position(node), "side": 0, "occupied": false}
	var explicit_edge = _topology_find_edge_between(edges, node_index, neighbor_index)
	var explicit_socket := _topology_edge_socket_for_node(explicit_edge, node_index)
	if explicit_socket != "":
		var explicit_spec := _topology_socket_spec_by_id(role_key, unit_bp, nodes, edges, node_index, explicit_socket, neighbor_index)
		if not explicit_spec.is_empty():
			explicit_spec["occupied"] = true
			return explicit_spec
	var best := {}
	var best_distance := 999999.0
	var neighbor_pos := _topology_node_position(nodes[neighbor_index])
	for raw_spec in _topology_socket_specs_for_node(role_key, unit_bp, nodes, edges, node_index, neighbor_index):
		if not (raw_spec is Dictionary):
			continue
		var spec: Dictionary = raw_spec
		if not bool(spec.get("connectable", true)):
			continue
		var distance := Vector2(spec.get("pos", _topology_node_position(node))).distance_to(neighbor_pos)
		if distance < best_distance:
			best_distance = distance
			best = spec
	if best.is_empty():
		return {"id": "center", "pos": _topology_node_position(node), "side": 0, "occupied": false}
	best["occupied"] = false
	return best


func _topology_socket_occupancy(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array) -> Dictionary:
	var occupancy := {}
	for edge in edges:
		var a := _topology_edge_node_a(edge)
		var b := _topology_edge_node_b(edge)
		if a < 0 or b < 0 or a >= nodes.size() or b >= nodes.size():
			continue
		var socket_a := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, a))
		var socket_b := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, b))
		if socket_a == "" or socket_b == "":
			continue
		for pair in [[a, socket_a], [b, socket_b]]:
			var node_index := int(pair[0])
			var socket_id := String(pair[1])
			if not occupancy.has(node_index):
				occupancy[node_index] = {}
			if not occupancy[node_index].has(socket_id):
				occupancy[node_index][socket_id] = []
			occupancy[node_index][socket_id].append(edge)
	return occupancy


func _topology_socket_occupied(occupancy: Dictionary, node_index: int, socket_id: String) -> bool:
	var id := _topology_canonical_socket_id(socket_id)
	return id != "" and occupancy.has(node_index) and Dictionary(occupancy[node_index]).has(id)


func _topology_socket_edge_error_for_sockets(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, a: int, a_socket: String, b: int, b_socket: String) -> String:
	if a < 0 or b < 0 or a >= nodes.size() or b >= nodes.size() or a == b:
		return "INVALID: topology edge references missing node."
	var socket_a := _topology_canonical_socket_id(a_socket)
	var socket_b := _topology_canonical_socket_id(b_socket)
	if socket_a == "" or socket_b == "":
		return "INVALID: missing connection socket."
	if not _topology_edge_can_connect(nodes[a], nodes[b]):
		return "INVALID: hard rule, independent joints are deprecated; connect torso ports or muscle distal sockets directly to downstream muscle root joints."
	if _topology_edge_exists(edges, a, b):
		return "INVALID: nodes are already linked."
	if _topology_socket_spec_by_id(role_key, unit_bp, nodes, edges, a, socket_a, b).is_empty():
		return "INVALID: source socket is not available."
	if _topology_socket_spec_by_id(role_key, unit_bp, nodes, edges, b, socket_b, a).is_empty():
		return "INVALID: target socket is not available."
	if not _topology_socket_pair_can_connect(role_key, unit_bp, nodes, a, socket_a, b, socket_b):
		return "INVALID: socket pair cannot connect."
	var occupancy := _topology_socket_occupancy(role_key, unit_bp, nodes, edges)
	if _topology_socket_occupied(occupancy, a, socket_a):
		return "INVALID: node %d socket %s is already occupied." % [a + 1, socket_a]
	if _topology_socket_occupied(occupancy, b, socket_b):
		return "INVALID: node %d socket %s is already occupied." % [b + 1, socket_b]
	return ""


func _topology_try_connect_sockets(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, a: int, a_socket: String, b: int, b_socket: String) -> Dictionary:
	var socket_a := _topology_canonical_socket_id(a_socket)
	var socket_b := _topology_canonical_socket_id(b_socket)
	var error := _topology_socket_edge_error_for_sockets(role_key, unit_bp, nodes, edges, a, socket_a, b, socket_b)
	if error != "":
		return {"ok": false, "error": error}
	var edge := _topology_make_socket_edge(a, socket_a, b, socket_b)
	edges.append(edge)
	return {"ok": true, "edge": edge}


func _topology_append_socket_edge_if_free(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, a: int, a_socket: String, b: int, b_socket: String) -> bool:
	return bool(_topology_try_connect_sockets(role_key, unit_bp, nodes, edges, a, a_socket, b, b_socket).get("ok", false))


func _topology_socket_edge_error(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, a: int, b: int, include_material: bool = true) -> String:
	if a < 0 or b < 0 or a >= nodes.size() or b >= nodes.size() or a == b:
		return "INVALID: topology edge references missing node."
	if not _topology_edge_can_connect(nodes[a], nodes[b]):
		return "INVALID: hard rule, independent joints are deprecated; connect torso ports or muscle distal sockets directly to downstream muscle root joints."
	if _topology_edge_exists(edges, a, b):
		return ""
	var terminal_side_error := _topology_terminal_socket_side_error(role_key, unit_bp, nodes, edges, a, b)
	if terminal_side_error != "":
		return terminal_side_error
	var candidate := _topology_socket_candidate_for_pair(role_key, unit_bp, nodes, edges, a, b, false, false)
	if candidate.is_empty():
		return "INVALID: no free one-to-one socket pair."
	var socket_a: Dictionary = candidate.get("socket_a", {})
	var socket_b: Dictionary = candidate.get("socket_b", {})
	var id_a := _topology_canonical_socket_id(String(socket_a.get("id", "")))
	var id_b := _topology_canonical_socket_id(String(socket_b.get("id", "")))
	var socket_error := _topology_socket_edge_error_for_sockets(role_key, unit_bp, nodes, edges, a, id_a, b, id_b)
	if socket_error != "":
		return socket_error
	if include_material:
		var material_error := _topology_material_edge_error(role_key, unit_bp, nodes, edges, a, b)
		if material_error != "":
			return material_error
	return ""


func _topology_terminal_socket_side_error(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, a: int, b: int) -> String:
	return ""


func _topology_socket_pair_can_connect(role_key: String, unit_bp: Dictionary, nodes: Array, source_index: int, source_socket: String, target_index: int, target_socket: String) -> bool:
	if source_index < 0 or target_index < 0 or source_index >= nodes.size() or target_index >= nodes.size():
		return false
	var source_node: Dictionary = nodes[source_index]
	var target_node: Dictionary = nodes[target_index]
	if not _topology_edge_can_connect(source_node, target_node):
		return false
	return TopologyGeometry.socket_pair_can_connect(source_socket, target_socket)


func _topology_socket_candidate_for_pair(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, source_index: int, target_index: int, require_snap_threshold: bool = true, include_material: bool = true, occupancy_override: Dictionary = {}, source_specs_override: Array = []) -> Dictionary:
	if source_index < 0 or target_index < 0 or source_index >= nodes.size() or target_index >= nodes.size() or source_index == target_index:
		return {}
	var dragged_node: Dictionary = nodes[source_index]
	var target_node: Dictionary = nodes[target_index]
	if not _topology_edge_can_connect(dragged_node, target_node):
		return {}
	if _topology_edge_exists(edges, source_index, target_index):
		return {}
	var terminal_side_error := _topology_terminal_socket_side_error(role_key, unit_bp, nodes, edges, source_index, target_index)
	if terminal_side_error != "":
		return {}
	var best := {}
	var best_score := 999999.0
	var occupancy := occupancy_override if not occupancy_override.is_empty() else _topology_socket_occupancy(role_key, unit_bp, nodes, edges)
	var source_specs := source_specs_override if not source_specs_override.is_empty() else _topology_socket_specs_for_node(role_key, unit_bp, nodes, edges, source_index, target_index)
	var target_specs := _topology_socket_specs_for_node(role_key, unit_bp, nodes, edges, target_index, source_index)
	for raw_socket_a in source_specs:
		if not (raw_socket_a is Dictionary):
			continue
		var socket_a: Dictionary = raw_socket_a
		var id_a := _topology_canonical_socket_id(String(socket_a.get("id", "")))
		if not bool(socket_a.get("connectable", true)):
			continue
		if not _topology_joint_socket_accepts_direction(role_key, unit_bp, nodes, edges, source_index, id_a, target_index):
			continue
		if occupancy.has(source_index) and Dictionary(occupancy[source_index]).has(id_a):
			continue
		for raw_socket_b in target_specs:
			if not (raw_socket_b is Dictionary):
				continue
			var socket_b: Dictionary = raw_socket_b
			var id_b := _topology_canonical_socket_id(String(socket_b.get("id", "")))
			if not bool(socket_b.get("connectable", true)):
				continue
			if not _topology_socket_pair_can_connect(role_key, unit_bp, nodes, source_index, id_a, target_index, id_b):
				continue
			if not _topology_joint_socket_accepts_direction(role_key, unit_bp, nodes, edges, target_index, id_b, source_index):
				continue
			if occupancy.has(target_index) and Dictionary(occupancy[target_index]).has(id_b):
				continue
			var socket_pos_a: Vector2 = socket_a.get("pos", Vector2.ZERO)
			var socket_pos_b: Vector2 = socket_b.get("pos", Vector2.ZERO)
			var socket_gap := _topology_position_to_board_local(socket_pos_a).distance_to(_topology_position_to_board_local(socket_pos_b))
			var threshold := maxf(TOPOLOGY_MAGNET_SNAP_PIXELS, 28.0 * clampf(editor_board_zoom, EDITOR_BOARD_ZOOM_MIN, EDITOR_BOARD_ZOOM_MAX))
			if require_snap_threshold and socket_gap > threshold:
				continue
			var score := socket_gap
			var source_single_endpoint := _topology_node_is_single_endpoint_muscle(role_key, dragged_node, unit_bp)
			var target_single_endpoint := _topology_node_is_single_endpoint_muscle(role_key, target_node, unit_bp)
			if source_single_endpoint and not (id_a == "root_joint" and (id_b == "distal" or id_b.begins_with("torso_port:"))):
				continue
			if target_single_endpoint and not (id_b == "root_joint" and (id_a == "distal" or id_a.begins_with("torso_port:"))):
				continue
			if _topology_node_supports_visual_handedness(role_key, unit_bp, dragged_node) and id_a == "root_joint":
				score -= 0.001
			if _topology_node_supports_visual_handedness(role_key, unit_bp, target_node) and id_b == "root_joint":
				score -= 0.001
			if score < best_score:
				best_score = score
				best = {
					"target": target_index,
					"source_node": source_index,
					"target_node": target_index,
					"source_socket": id_a,
					"target_socket": id_b,
					"socket_a": socket_a,
					"socket_b": socket_b,
					"socket_gap": socket_gap,
					"distance_error": socket_gap,
					"score": score,
				}
	if include_material and not best.is_empty():
		var material_error := _topology_material_edge_error(role_key, unit_bp, nodes, edges, source_index, target_index)
		if material_error != "":
			return {}
	return best


func _topology_socket_candidate(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int, require_snap_threshold: bool = true) -> Dictionary:
	if node_index < 0 or node_index >= nodes.size():
		return {}
	var best := {}
	var best_score := 999999.0
	var occupancy := _topology_socket_occupancy(role_key, unit_bp, nodes, edges)
	var target_indices: Array = []
	if require_snap_threshold:
		var source_pos := _topology_position_to_board_local(_topology_node_position(nodes[node_index]))
		var zoom := clampf(editor_board_zoom, EDITOR_BOARD_ZOOM_MIN, EDITOR_BOARD_ZOOM_MAX)
		var snap_threshold := maxf(TOPOLOGY_MAGNET_SNAP_PIXELS, 28.0 * zoom)
		var near_radius := snap_threshold + 420.0 * zoom
		for i in range(nodes.size()):
			if i == node_index:
				continue
			var target_pos := _topology_position_to_board_local(_topology_node_position(nodes[i]))
			var distance := source_pos.distance_to(target_pos)
			if distance <= near_radius:
				target_indices.append({"index": i, "distance": distance})
		target_indices.sort_custom(func(a, b): return float(Dictionary(a).get("distance", 0.0)) < float(Dictionary(b).get("distance", 0.0)))
	else:
		for i in range(nodes.size()):
			if i != node_index:
				target_indices.append({"index": i, "distance": 0.0})
	var checked := 0
	var max_checked := 4 if require_snap_threshold else target_indices.size()
	for raw_target in target_indices:
		if checked >= max_checked:
			break
		var i := int(Dictionary(raw_target).get("index", -1))
		if i < 0 or i == node_index:
			continue
		checked += 1
		var candidate := _topology_socket_candidate_for_pair(role_key, unit_bp, nodes, edges, node_index, i, require_snap_threshold, true, occupancy)
		if candidate.is_empty():
			continue
		var score := float(candidate.get("score", 999999.0))
		if score < best_score:
			best_score = score
			best = candidate
	return best


func _topology_material_blocked_candidate(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int) -> Dictionary:
	if node_index < 0 or node_index >= nodes.size():
		return {}
	var dragged_node: Dictionary = nodes[node_index]
	var best := {}
	var best_score := 999999.0
	for i in range(nodes.size()):
		if i == node_index:
			continue
		if _topology_socket_edge_error(role_key, unit_bp, nodes, edges, node_index, i, false) != "":
			continue
		var material_error := _topology_material_edge_error(role_key, unit_bp, nodes, edges, node_index, i)
		if material_error == "":
			continue
		var candidate := _topology_socket_candidate_for_pair(role_key, unit_bp, nodes, edges, node_index, i, true, false)
		if candidate.is_empty():
			continue
		var socket_a: Dictionary = candidate.get("socket_a", {})
		var socket_b: Dictionary = candidate.get("socket_b", {})
		if socket_a.is_empty() or socket_b.is_empty():
			continue
		var socket_pos_a: Vector2 = socket_a.get("pos", Vector2.ZERO)
		var socket_pos_b: Vector2 = socket_b.get("pos", Vector2.ZERO)
		var socket_gap := _topology_position_to_board_local(socket_pos_a).distance_to(_topology_position_to_board_local(socket_pos_b))
		var distance_error := socket_gap
		var score := socket_gap
		if score < best_score:
			best_score = score
			best = {
				"target": i,
				"socket_a": socket_a,
				"socket_b": socket_b,
				"socket_gap": socket_gap,
				"distance_error": distance_error,
				"score": score,
				"reason": material_error,
			}
	return best


func _topology_edge_socket_board_points(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, a: int, b: int) -> Dictionary:
	var socket_a := _topology_socket_for_connection(role_key, unit_bp, nodes, edges, a, b)
	var socket_b := _topology_socket_for_connection(role_key, unit_bp, nodes, edges, b, a)
	if socket_a.is_empty() or socket_b.is_empty():
		return {}
	var socket_pos_a: Vector2 = socket_a.get("pos", _topology_node_position(nodes[a]))
	var socket_pos_b: Vector2 = socket_b.get("pos", _topology_node_position(nodes[b]))
	return {
		"a": _topology_position_to_board_local(socket_pos_a),
		"b": _topology_position_to_board_local(socket_pos_b),
		"socket_a": String(socket_a.get("id", "")),
		"socket_b": String(socket_b.get("id", "")),
	}


func _topology_max_socket_gap(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array) -> float:
	var max_gap := 0.0
	for raw_edge in edges:
		var a := _topology_edge_node_a(raw_edge)
		var b := _topology_edge_node_b(raw_edge)
		if a < 0 or b < 0 or a >= nodes.size() or b >= nodes.size():
			continue
		var a_socket := _topology_edge_socket_for_node(raw_edge, a)
		var b_socket := _topology_edge_socket_for_node(raw_edge, b)
		if a_socket == "" or b_socket == "":
			continue
		var a_pos := _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, a, a_socket, b)
		var b_pos := _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, b, b_socket, a)
		max_gap = maxf(max_gap, a_pos.distance_to(b_pos))
	return max_gap


func _topology_socket_markers_for_board(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array) -> Array:
	var markers: Array = []
	var occupancy := _topology_socket_occupancy(role_key, unit_bp, nodes, edges)
	var selected_lookup := {}
	for raw_index in editor_selected_topology_nodes:
		selected_lookup[int(raw_index)] = true
	if editor_topology_node_index >= 0:
		selected_lookup[editor_topology_node_index] = true
	for node_index in range(nodes.size()):
		if not (nodes[node_index] is Dictionary):
			continue
		var node: Dictionary = nodes[node_index]
		if not _topology_node_is_component(node):
			continue
		var slot_key := _topology_node_slot(node)
		var center := _topology_node_position(node)
		var node_markers: Array = []
		for raw_spec in _topology_socket_specs_for_node(role_key, unit_bp, nodes, edges, node_index):
			if not (raw_spec is Dictionary):
				continue
			var spec: Dictionary = raw_spec
			if not bool(spec.get("connectable", true)):
				continue
			node_markers.append({
				"id": String(spec.get("id", "")),
				"pos": spec.get("pos", center),
				"side": int(spec.get("side", 0)),
			})
		for marker in node_markers:
			var socket_id := _topology_canonical_socket_id(String(marker.get("id", "")))
			var occupied := occupancy.has(node_index) and Dictionary(occupancy[node_index]).has(socket_id)
			var marker_pos: Vector2 = marker.get("pos", center)
			var board_pos := _topology_position_to_board_local(marker_pos)
			markers.append({
				"node": node_index,
				"id": socket_id,
				"pos": board_pos,
				"slot": slot_key,
				"occupied": occupied,
				"selected": bool(selected_lookup.get(node_index, false)),
			})
	return markers


func _active_topology_preview_part_info(role_key: String, unit_bp: Dictionary, nodes: Array = []) -> Dictionary:
	if editor_dragging_node_index >= 0 and editor_dragging_node_index < nodes.size() and nodes[editor_dragging_node_index] is Dictionary and _topology_node_is_component(nodes[editor_dragging_node_index]):
		var drag_node: Dictionary = nodes[editor_dragging_node_index]
		var drag_slot := _topology_node_slot(drag_node)
		var drag_index := _topology_node_part_index(drag_node, unit_bp)
		return {
			"slot": drag_slot,
			"part_index": drag_index,
			"part": _topology_node_part(role_key, drag_node, unit_bp),
			"exclude_node": editor_dragging_node_index,
		}
	if editor_drag_catalog_active and _is_topology_part_slot(editor_drag_catalog_slot) and editor_drag_catalog_index >= 0:
		return {
			"slot": editor_drag_catalog_slot,
			"part_index": editor_drag_catalog_index,
			"part": _selected_component(role_key, editor_drag_catalog_slot, editor_drag_catalog_index),
			"exclude_node": -1,
		}
	if _is_topology_part_slot(editor_hover_slot_key) and editor_hover_part_index >= 0:
		return {
			"slot": editor_hover_slot_key,
			"part_index": editor_hover_part_index,
			"part": _selected_component(role_key, editor_hover_slot_key, editor_hover_part_index),
			"exclude_node": -1,
		}
	if _has_pending_canvas_part():
		return {
			"slot": editor_pending_place_slot,
			"part_index": editor_pending_place_index,
			"part": _selected_component(role_key, editor_pending_place_slot, editor_pending_place_index),
			"exclude_node": -1,
		}
	return {}


func _topology_preview_material_node(role_key: String, unit_bp: Dictionary, preview: Dictionary) -> Dictionary:
	var slot_key := String(preview.get("slot", ""))
	var part_index := int(preview.get("part_index", -1))
	var part: Dictionary = preview.get("part", {})
	if slot_key == "" or part_index < 0 or part.is_empty():
		return {}
	return _topology_component_node(-1, "PREVIEW", Vector2(0.5, 0.5), slot_key, part_index)


func _topology_material_highlights_for_board(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array) -> Dictionary:
	var preview := _active_topology_preview_part_info(role_key, unit_bp, nodes)
	if preview.is_empty():
		return {}
	var preview_node := _topology_preview_material_node(role_key, unit_bp, preview)
	if preview_node.is_empty():
		return {}
	var exclude_node := int(preview.get("exclude_node", -1))
	var highlights := {}
	for i in range(nodes.size()):
		if i == exclude_node or not (nodes[i] is Dictionary):
			continue
		var target_node: Dictionary = nodes[i]
		if not _topology_node_is_component(target_node):
			continue
		if not _topology_edge_can_connect(preview_node, target_node):
			continue
		if not _topology_node_has_connection_capacity(role_key, unit_bp, nodes, edges, i):
			continue
		var context := _topology_limb_material_context(role_key, unit_bp, nodes, edges, i, [exclude_node])
		var material_error := _topology_material_edge_error_for_preview(role_key, unit_bp, nodes, edges, preview_node, i, exclude_node)
		var target_state := "illegal_material" if material_error != "" else "legal_socket"
		highlights[str(i)] = {
			"state": target_state,
			"reason": material_error,
		}
		var group_nodes: Array = context.get("group_nodes", [])
		for group_raw in group_nodes:
			var group_index := int(group_raw)
			if group_index < 0 or group_index >= nodes.size() or group_index == i:
				continue
			var existing_state := String(Dictionary(highlights.get(str(group_index), {})).get("state", ""))
			if target_state == "illegal_material":
				highlights[str(group_index)] = {"state": "illegal_group", "reason": material_error}
			elif existing_state == "":
				highlights[str(group_index)] = {"state": "same_limb", "reason": ""}
	return highlights


func _topology_material_edge_error_for_preview(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, preview_node: Dictionary, target_index: int, exclude_node: int = -1) -> String:
	if target_index < 0 or target_index >= nodes.size() or preview_node.is_empty():
		return ""
	var preview_key := _topology_node_limb_material_key_for_part(role_key, unit_bp, preview_node)
	if preview_key == "":
		return ""
	var excluded := [exclude_node] if exclude_node >= 0 else []
	var context := _topology_limb_material_context(role_key, unit_bp, nodes, edges, target_index, excluded)
	var materials: Dictionary = context.get("materials", {})
	for existing_raw in materials.keys():
		var existing := String(existing_raw)
		if existing != "" and existing != preview_key:
			return "INVALID: material mismatch; same limb connectors must use one material (%s vs %s)." % [preview_key, existing]
	return ""


func _topology_node_limb_material_key_for_part(role_key: String, unit_bp: Dictionary, node: Dictionary) -> String:
	var slot_key := _topology_node_slot(node)
	if not _is_topology_part_slot(slot_key):
		return ""
	var part := _topology_node_part(role_key, node, unit_bp)
	if slot_key == "limb_muscle":
		return _stiffness_segment_material_family_for_part(part, slot_key)
	if slot_key == "muscle":
		if _component_is_torso(part) or _part_counts_as_terminal_weapon(part, "muscle") or bool(part.get("projectile", false)) or int(part.get("connection_ends", 1)) <= 1:
			return ""
		return _stiffness_segment_material_family_for_part(part, slot_key)
	return ""


func _topology_endpoint_conflicts(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array) -> Dictionary:
	var conflicts := {}
	var occupancy := _topology_socket_occupancy(role_key, unit_bp, nodes, edges)
	for node_index_raw in occupancy.keys():
		var node_index := int(node_index_raw)
		var socket_map: Dictionary = occupancy[node_index]
		for socket_id_raw in socket_map.keys():
			var socket_id := String(socket_id_raw)
			var socket_edges: Array = socket_map[socket_id]
			if socket_edges.size() <= 1:
				continue
			for raw_edge in socket_edges:
				var a := _topology_edge_node_a(raw_edge)
				var b := _topology_edge_node_b(raw_edge)
				if a >= 0 and b >= 0:
					conflicts[_topology_edge_key(a, b)] = true
			conflicts["note"] = "INVALID: node %d socket %s has multiple links; each visible joint/interface socket is one-to-one." % [node_index + 1, socket_id]
	return conflicts


func _torso_port_directions(part: Dictionary) -> Array:
	var count := _torso_external_joint_ports(part)
	if count <= 0:
		return []
	return PartArt.torso_hull_port_directions(part, count)


func _topology_node_axis(node: Dictionary) -> Vector2:
	var axis := Vector2.RIGHT
	if node.has("axis") and node.get("axis") is Vector2:
		axis = node.get("axis")
	elif node.has("rotation"):
		axis = Vector2.RIGHT.rotated(float(node.get("rotation", 0.0)))
	if axis.length() < 0.0001:
		axis = Vector2.RIGHT
	return axis.normalized()


func _topology_display_component_node(role_key: String, node: Dictionary, unit_bp: Dictionary) -> Dictionary:
	if not _topology_node_is_component(node):
		return node.duplicate(false)
	var slot_key := _topology_node_slot(node)
	var part := _topology_node_part(role_key, node, unit_bp)
	var effective_part := _part_with_effective_terminal_geometry(part, slot_key)
	var component_node := AssemblyBoardRenderer.part_to_component_node(slot_key, effective_part)
	_apply_visual_handedness_defaults_to_node(component_node, part, slot_key)
	for key in ["joint_ports", "connection_ends", "is_torso", "terminal_weapon", "material_class", "shape", "size_class", "orientation_category", "orientation_basis", "visual_mount_side", "default_mount_side", "mount_side_choices", "mount_parent_axis_local", "visual_handedness", "default_visual_handedness", "asymmetric_terminal", "orientation_choices"]:
		if node.has(key):
			component_node[key] = node[key]
	return component_node


func _topology_display_metrics_units(role_key: String, node: Dictionary, unit_bp: Dictionary) -> Dictionary:
	var component_node := _topology_display_component_node(role_key, node, unit_bp)
	var part := _topology_node_part(role_key, node, unit_bp) if _topology_node_is_component(node) else {}
	var length_units := _topology_node_physical_length_units(role_key, node, unit_bp)
	var radius_units := maxf(0.001, float(part.get("radius", node.get("component_radius", 0.04))))
	return AssemblyBoardRenderer.component_display_metrics(component_node, radius_units, length_units, false)


func _topology_node_visual_edge_extent_units(role_key: String, node: Dictionary, unit_bp: Dictionary, socket_id: String = "") -> float:
	if not _topology_node_is_component(node):
		return _topology_node_physical_length_units(role_key, node, unit_bp) * 0.5
	var id := _topology_canonical_socket_id(socket_id)
	if _topology_node_is_torso(role_key, node, unit_bp):
		return float(_topology_display_metrics_units(role_key, node, unit_bp).get("length", _topology_node_physical_length_units(role_key, node, unit_bp))) * 0.5
	var metrics := _topology_display_metrics_units(role_key, node, unit_bp)
	if id in ["root_joint", "handle", "end:a", "side:-1", "side:a"]:
		return float(metrics.get("root_extent", float(metrics.get("length", 0.0)) * 0.5))
	if id in ["distal", "end:b", "side:1", "side:b"]:
		return float(metrics.get("tip_extent", float(metrics.get("length", 0.0)) * 0.5))
	return float(metrics.get("length", _topology_node_physical_length_units(role_key, node, unit_bp))) * 0.5


func _topology_torso_port_positions(role_key: String, node: Dictionary, unit_bp: Dictionary) -> Array:
	var part := _topology_node_part(role_key, node, unit_bp)
	var count := _torso_external_joint_ports(part)
	if count <= 0:
		return []
	var center := _topology_node_position(node)
	var forward := _topology_node_axis(node)
	var right := Vector2(-forward.y, forward.x)
	var component_node := _topology_display_component_node(role_key, node, unit_bp)
	var metrics := _topology_display_metrics_units(role_key, node, unit_bp)
	var radius_units := float(metrics.get("display_radius", 0.01))
	var port_offsets := AssemblyBoardRenderer.torso_port_positions(
		Vector2.ZERO,
		component_node,
		Vector2.RIGHT,
		radius_units,
		float(metrics.get("length", 0.0)),
		false
	)
	var positions: Array = []
	for local in port_offsets:
		var p: Vector2 = local
		positions.append(center + (forward * p.x + right * p.y) / maxf(0.001, TOPOLOGY_BOARD_PHYSICAL_UNITS))
	return positions


func _topology_socket_offset_units_for_display(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int, socket_id: String, neighbor_index: int = -1) -> Vector2:
	if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
		return Vector2.ZERO
	var node: Dictionary = nodes[node_index]
	var id := _topology_canonical_socket_id(socket_id)
	if _topology_node_is_torso(role_key, node, unit_bp):
		var center := _topology_node_position(node)
		var ports := _topology_torso_port_positions(role_key, node, unit_bp)
		if id.begins_with("torso_port:") and ports.size() > 0:
			return ports[clampi(int(id.get_slice(":", 1)), 0, ports.size() - 1)] - center
		return Vector2.ZERO
	if _topology_node_slot(node) == "joint":
		return Vector2.ZERO
	if _topology_node_uses_endpoint_sides(role_key, node, unit_bp):
		var axis := _topology_endpoint_axis_for_socket(role_key, unit_bp, nodes, edges, node_index, neighbor_index)
		if axis.length() < 0.0001:
			axis = Vector2.RIGHT
		var side := _topology_socket_side_value(id)
		return axis.normalized() * (_topology_node_visual_edge_extent_units(role_key, node, unit_bp, id) / maxf(0.001, TOPOLOGY_BOARD_PHYSICAL_UNITS)) * float(side)
	return Vector2.ZERO


func _board_nodes_with_art_visual_positions(role_key: String, unit_bp: Dictionary, source_nodes: Array, edges: Array) -> Array:
	var visual_nodes: Array = []
	visual_nodes.resize(source_nodes.size())
	var visual_positions := {}
	for i in range(source_nodes.size()):
		if not (source_nodes[i] is Dictionary):
			visual_nodes[i] = source_nodes[i]
			continue
		var node: Dictionary = Dictionary(source_nodes[i]).duplicate(false)
		visual_nodes[i] = node
		if _topology_node_is_torso(role_key, node, unit_bp):
			visual_positions[i] = _topology_node_position(node)
	if visual_positions.is_empty() and source_nodes.size() > 0 and source_nodes[0] is Dictionary:
		visual_positions[0] = _topology_node_position(source_nodes[0])
	for _pass in range(maxi(1, source_nodes.size() * 2)):
		var changed := false
		for raw_edge in edges:
			var a := _topology_edge_node_a(raw_edge)
			var b := _topology_edge_node_b(raw_edge)
			if a < 0 or b < 0 or a >= source_nodes.size() or b >= source_nodes.size():
				continue
			if not (source_nodes[a] is Dictionary) or not (source_nodes[b] is Dictionary):
				continue
			var a_known := visual_positions.has(a)
			var b_known := visual_positions.has(b)
			if a_known == b_known:
				continue
			var known := a if a_known else b
			var unknown := b if a_known else a
			var known_socket := _topology_edge_socket_for_node(raw_edge, known)
			var unknown_socket := _topology_edge_socket_for_node(raw_edge, unknown)
			if known_socket == "" or unknown_socket == "":
				continue
			var known_offset := _topology_socket_offset_units_for_display(role_key, unit_bp, source_nodes, edges, known, known_socket, unknown)
			var unknown_offset := _topology_socket_offset_units_for_display(role_key, unit_bp, source_nodes, edges, unknown, unknown_socket, known)
			var known_pos: Vector2 = visual_positions[known]
			visual_positions[unknown] = known_pos + known_offset - unknown_offset
			changed = true
		if not changed:
			break
	for i in range(source_nodes.size()):
		if not (visual_nodes[i] is Dictionary):
			continue
		var node: Dictionary = Dictionary(visual_nodes[i]).duplicate(false)
		var topology_pos := _topology_node_position(node)
		var visual_pos: Vector2 = visual_positions[i] if visual_positions.has(i) else topology_pos
		node["topology_pos"] = topology_pos
		node["visual_pos"] = visual_pos
		node["pos"] = visual_pos
		if _topology_node_supports_visual_handedness(role_key, unit_bp, node):
			node["mount_parent_axis_local"] = _topology_mount_parent_axis_for_node(role_key, unit_bp, source_nodes, edges, i)
		visual_nodes[i] = node
	return visual_nodes


func _torso_joint_slot_profiles_for_part(part: Dictionary) -> Array:
	var count := _torso_external_joint_ports(part)
	var profiles: Array = []
	if count <= 0:
		return profiles
	var length := 2.0
	var front_width := 0.72
	var rear_width := 1.56
	var offsets := PartArt.torso_hull_port_local_offsets(part, count, length, front_width, rear_width)
	var angles: Array = []
	for raw_offset in offsets:
		var offset: Vector2 = raw_offset
		angles.append(offset.angle() if offset.length() > 0.001 else 0.0)
	for i in range(offsets.size()):
		var offset: Vector2 = offsets[i]
		var center_angle := float(angles[i])
		# Torso ports are deliberately permissive: the torso design is expected
		# to keep each first limb segment clear by default, while real legality
		# errors should come from downstream/cross-torso sweep collisions.
		var half_width := PI
		profiles.append({
			"port_index": i,
			"center_angle": center_angle,
			"min_angle": wrapf(center_angle - half_width, -PI, PI),
			"max_angle": wrapf(center_angle + half_width, -PI, PI),
			"half_width": half_width,
			"motion_kind": "ball",
			"clearance_radius": maxf(0.035, float(part.get("radius", 0.12)) * 0.58),
		})
	if part.has("joint_slot_profiles") and part["joint_slot_profiles"] is Array:
		for raw_override in Array(part["joint_slot_profiles"]):
			if not (raw_override is Dictionary):
				continue
			var override: Dictionary = raw_override
			var port_index := clampi(int(override.get("port_index", -1)), 0, profiles.size() - 1)
			if port_index < 0 or port_index >= profiles.size():
				continue
			var merged: Dictionary = profiles[port_index]
			for key in override.keys():
				merged[key] = override[key]
			for angle_key in ["center_angle", "min_angle", "max_angle"]:
				if merged.has(angle_key):
					var raw_value = merged[angle_key]
					if raw_value is String:
						merged[angle_key] = deg_to_rad(float(String(raw_value)))
					elif absf(float(raw_value)) > TAU:
						merged[angle_key] = deg_to_rad(float(raw_value))
			if merged.has("center_angle") and merged.has("min_angle") and merged.has("max_angle"):
				var center_angle := float(merged.get("center_angle", 0.0))
				merged["half_width"] = maxf(absf(wrapf(float(merged.get("max_angle", center_angle)) - center_angle, -PI, PI)), absf(wrapf(center_angle - float(merged.get("min_angle", center_angle)), -PI, PI)))
			profiles[port_index] = merged
	return profiles


func _torso_joint_slot_profile_for_socket(role_key: String, unit_bp: Dictionary, nodes: Array, torso_index: int, port_socket: String) -> Dictionary:
	if torso_index < 0 or torso_index >= nodes.size():
		return {}
	var part := _topology_node_part(role_key, nodes[torso_index], unit_bp)
	var profiles := _torso_joint_slot_profiles_for_part(part)
	if profiles.is_empty():
		return {}
	var port_index := 0
	if port_socket.begins_with("torso_port:"):
		port_index = int(port_socket.get_slice(":", 1))
	port_index = clampi(port_index, 0, profiles.size() - 1)
	return Dictionary(profiles[port_index])


func _nearest_torso_port_index(direction: Vector2, port_dirs: Array) -> int:
	if port_dirs.is_empty():
		return -1
	var best := 0
	var best_dot := -999.0
	var dir := direction.normalized() if direction.length() > 0.001 else Vector2.RIGHT
	for i in range(port_dirs.size()):
		var port_dir: Vector2 = port_dirs[i]
		var score := dir.dot(port_dir.normalized() if port_dir.length() > 0.001 else Vector2.RIGHT)
		if score > best_dot:
			best_dot = score
			best = i
	return best


func _nearest_torso_port_position_index(center: Vector2, direction: Vector2, port_positions: Array) -> int:
	if port_positions.is_empty():
		return -1
	var best := 0
	var best_dot := -999.0
	var dir := direction.normalized() if direction.length() > 0.001 else Vector2.RIGHT
	for i in range(port_positions.size()):
		var port_pos: Vector2 = port_positions[i]
		var port_dir := port_pos - center
		var score := dir.dot(port_dir.normalized() if port_dir.length() > 0.001 else Vector2.RIGHT)
		if score > best_dot:
			best_dot = score
			best = i
	return best


func _torso_occupied_port_indices(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, torso_index: int) -> Array:
	var occupied: Array = []
	if torso_index < 0 or torso_index >= nodes.size() or not _topology_node_is_torso(role_key, nodes[torso_index], unit_bp):
		return occupied
	var center := _topology_node_position(nodes[torso_index])
	var port_positions := _topology_torso_port_positions(role_key, nodes[torso_index], unit_bp)
	for edge in edges:
		var a := _topology_edge_node_a(edge)
		var b := _topology_edge_node_b(edge)
		var neighbor := -1
		if a == torso_index:
			neighbor = b
		elif b == torso_index:
			neighbor = a
		if neighbor < 0 or neighbor >= nodes.size():
			continue
		var explicit_socket := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, torso_index))
		if explicit_socket.begins_with("torso_port:"):
			var explicit_port := int(explicit_socket.get_slice(":", 1))
			if explicit_port >= 0 and explicit_port < port_positions.size() and not occupied.has(explicit_port):
				occupied.append(explicit_port)
			continue
		var direction := _topology_node_position(nodes[neighbor]) - _topology_node_position(nodes[torso_index])
		if direction.length() <= 0.0001:
			continue
		var port_index := _nearest_torso_port_position_index(center, direction.normalized(), port_positions)
		if port_index >= 0 and not occupied.has(port_index):
			occupied.append(port_index)
	return occupied


