func _visible_control_count(node: Node) -> int:
	var count := 0
	if node is CanvasItem and (node as CanvasItem).visible:
		count += 1
	for child in node.get_children():
		count += _visible_control_count(child)
	return count


func _update_editor_perf_overlay() -> void:
	if editor_perf_overlay_label == null:
		return
	editor_perf_overlay_label.visible = editor_perf_overlay_enabled
	if not editor_perf_overlay_enabled:
		return
	editor_perf_overlay_label.text = _editor_perf_overlay_text()


func _module_material_rule_note(unit_bp: Dictionary) -> String:
	if unit_bp.has("custom_topology"):
		return _custom_module_material_rule_note(unit_bp)
	return "INVALID: legacy body-group editing is removed; create or import a free-canvas component graph."


func _custom_module_material_rule_note(unit_bp: Dictionary) -> String:
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if _topology_is_canonical_component_graph(topology):
		return "Module material rule OK: component graph uses embedded-joint direct muscle links; software groups are assigned after placement."
	return "INVALID: legacy synthetic topology is removed; migrate to component nodes."


func _action_module_rule_note(unit_bp: Dictionary, role_key: String) -> String:
	if not unit_bp.has("custom_topology"):
		return "INVALID: legacy body-group editing is removed; import or create a free-canvas topology."
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if nodes.is_empty():
		return "INVALID: no component graph for action modules."
	if not _topology_is_canonical_component_graph(topology):
		return "INVALID: legacy synthetic topology must be migrated to component nodes."
	var attack_nodes := _component_topology_attack_nodes(role_key, unit_bp, false)
	var used_keys := {}
	var paired_counts := {}
	var paired_required := {}
	var executable_joint_nodes := {}
	var executable_count := 0
	for i in range(attack_nodes.size()):
		var attack_node: Dictionary = attack_nodes[i]
		var attack_key := int(attack_node.get("attack_key", i + 1))
		if attack_key < 1 or attack_key > ATTACK_GROUP_COUNT:
			return "INVALID: action module %s needs one of the six attack keys." % String(attack_node.get("label", "NODE"))
		var module_parts := _module_parts_for_topology_node(role_key, attack_node, unit_bp)
		var signature := _module_binding_signature(module_parts)
		var shares_key_for_pair := _module_parts_require_pair(module_parts)
		if used_keys.has(attack_key):
			var previous: Dictionary = used_keys[attack_key]
			if not shares_key_for_pair or not bool(previous.get("paired", false)) or String(previous.get("signature", "")) != signature:
				return "INVALID: attack key %d is bound to multiple action modules." % attack_key
		else:
			used_keys[attack_key] = {"signature": signature, "paired": shares_key_for_pair}
		if attack_node.has("source_joint_node"):
			executable_joint_nodes[int(attack_node["source_joint_node"])] = true
		executable_count += 1
		for module_part in module_parts:
			if not _module_requires_execution_binding(module_part):
				continue
			var reason := _module_execution_invalid_reason(module_part, attack_node, role_key, unit_bp)
			if reason != "":
				return "INVALID: key %d %s -> %s" % [attack_key, _short_part_name(String(module_part.get("name", "MODULE"))), reason]
			if bool(module_part.get("requires_joint_pair", false)):
				var pair_key := _module_pair_key(attack_key, module_part)
				paired_counts[pair_key] = int(paired_counts.get(pair_key, 0)) + 1
				paired_required[pair_key] = maxi(int(paired_required.get(pair_key, 0)), int(module_part.get("paired_joint_count", 2)))
	for pair_key in paired_required.keys():
		if int(paired_counts.get(pair_key, 0)) < int(paired_required[pair_key]):
			return "INVALID: key %d needs %d selected joints for %s; found %d." % [
				_module_pair_key_attack_key(String(pair_key)),
				int(paired_required[pair_key]),
				_module_pair_key_name(String(pair_key)),
				int(paired_counts.get(pair_key, 0))
			]
	for node_index in range(nodes.size()):
		var node: Dictionary = nodes[node_index]
		var module_parts_on_node := _module_parts_for_topology_node(role_key, node, unit_bp)
		for module_part_on_node in module_parts_on_node:
			if not _module_requires_execution_binding(module_part_on_node):
				continue
			if not _topology_node_is_component(node) or _topology_node_slot(node) == "joint" or _topology_node_is_torso(role_key, node, unit_bp):
				return "INVALID: %s must be bound to a muscle with an embedded root joint, not node %d." % [_short_part_name(String(module_part_on_node.get("name", "MODULE"))), node_index + 1]
			if not executable_joint_nodes.has(node_index):
				return "INVALID: %s on node %d has no legal connected execution part." % [_short_part_name(String(module_part_on_node.get("name", "MODULE"))), node_index + 1]
	return "行动绑定正常：%d 个可执行构件组映射到六个攻击键。近战通用：X普通，正面+X护甲，背面+X激活。" % executable_count if _ui_is_zh() else "Action binding OK: %d executable groups mapped to six attack keys. Universal melee states: X normal, front+X armor, rear+X active." % executable_count


func _module_requires_execution_binding(module_part: Dictionary) -> bool:
	if bool(module_part.get("requires_bound_key", false)):
		return true
	var motion := String(module_part.get("motion", ""))
	if motion in ["software", "firewall", "retreat", "identity_shift", "fracture_brood"]:
		return false
	return String(module_part.get("module_target_kind", "")) != ""


func _module_binding_signature(module_parts: Array) -> String:
	var names: Array = []
	for module_part in module_parts:
		if module_part is Dictionary and _module_requires_execution_binding(module_part):
			names.append(String(Dictionary(module_part).get("name", "MODULE")))
	names.sort()
	return "|".join(names)


func _module_parts_require_pair(module_parts: Array) -> bool:
	for module_part in module_parts:
		if module_part is Dictionary and _module_requires_execution_binding(module_part) and bool(Dictionary(module_part).get("requires_joint_pair", false)):
			return true
	return false


func _module_pair_key(attack_key: int, module_part: Dictionary) -> String:
	return "%d::%s" % [attack_key, String(module_part.get("name", "MODULE"))]


func _module_pair_key_attack_key(pair_key: String) -> int:
	var pieces := pair_key.split("::", false, 1)
	return int(pieces[0]) if pieces.size() > 0 else 0


func _module_pair_key_name(pair_key: String) -> String:
	var pieces := pair_key.split("::", false, 1)
	return pieces[1] if pieces.size() > 1 else pair_key


func _module_execution_invalid_reason(module_part: Dictionary, attack_node: Dictionary, role_key: String, unit_bp: Dictionary) -> String:
	var target_kind := String(module_part.get("module_target_kind", ""))
	if target_kind == "":
		return ""
	if target_kind == "two_link_rotating_limb":
		return _two_link_forward_snap_invalid_reason(module_part, attack_node, role_key, unit_bp)
	var limb_part := _selected_component(role_key, "limb_muscle", int(attack_node.get("limb_muscle", unit_bp.get("limb_muscle", 0))))
	var terminal_part := _selected_component(role_key, "muscle", int(attack_node.get("muscle", unit_bp.get("muscle", 0))))
	var embedded_slot := String(attack_node.get("embedded_joint_slot", "limb_muscle"))
	var embedded_part_index := int(attack_node.get("embedded_joint_part", attack_node.get("limb_muscle", unit_bp.get("limb_muscle", 0))))
	var embedded_part := _selected_component(role_key, embedded_slot, embedded_part_index)
	var embedded_profile := _embedded_joint_profile_for_part(embedded_part, embedded_slot, module_part)
	var embedded_kind := String(embedded_profile.get("kind", "ball"))
	var embedded_degrees := int(embedded_profile.get("angle", 180))
	var embedded_extension := float(embedded_profile.get("extension", 0.0))
	match target_kind:
		"ball_joint":
			var required_degrees := int(module_part.get("required_joint_degrees", 90))
			if embedded_kind != "ball" or embedded_degrees < required_degrees:
				return "needs an embedded %d-degree ball/yoke joint; selected %s." % [required_degrees, _short_part_name(String(embedded_part.get("name", "MUSCLE")))]
		"dual_ball_joint":
			var required_degrees := int(module_part.get("required_joint_degrees", 60))
			if embedded_kind != "ball" or embedded_degrees < required_degrees:
				return "needs each paired embedded joint to be a %d-degree ball/yoke joint; selected %s." % [required_degrees, _short_part_name(String(embedded_part.get("name", "MUSCLE")))]
		"telescopic_joint":
			var required_extension := float(module_part.get("required_extension_m", 1.0))
			if embedded_kind != "linear" or embedded_extension < required_extension:
				return "needs an embedded telescopic joint rated for %.0fm extension; selected %s." % [required_extension, _short_part_name(String(embedded_part.get("name", "MUSCLE")))]
		"dual_telescopic_joint":
			var required_extension := float(module_part.get("required_extension_m", 2.0))
			if embedded_kind != "linear" or embedded_extension < required_extension:
				return "needs each paired embedded joint to be telescopic and rated for %.0fm extension; selected %s." % [required_extension, _short_part_name(String(embedded_part.get("name", "MUSCLE")))]
		"gun_joint":
			if not bool(module_part.get("requires_connected_gun", false)):
				return ""
			if _terminal_weapon_kind_for_part(terminal_part, "muscle") != "ranged" or not bool(terminal_part.get("projectile", false)):
				return "needs a connected projectile gun at the terminal muscle."
		"gun_terminal":
			if _terminal_weapon_kind_for_part(terminal_part, "muscle") != "ranged" or not bool(terminal_part.get("projectile", false)):
				return "needs a projectile gun terminal muscle."
			var gun_profile := String(module_part.get("module_action_profile", ""))
			if _gun_activation_profiles().has(gun_profile):
				var terminal_gun_kind := String(terminal_part.get("gun_kind", _gun_kind_for_data(terminal_part)))
				var terminal_ammo_kind := String(terminal_part.get("ammo_kind", _ammo_kind_for_data(terminal_part)))
				if not _gun_activation_profile_supports_kind(gun_profile, terminal_gun_kind, terminal_ammo_kind):
					return "this gun module does not support the selected gun terminal."
		"braced_gun_joint":
			if embedded_kind != "ball" or embedded_degrees < 90:
				return "needs a steerable ball/yoke joint for braced gun sweep."
			if _terminal_weapon_kind_for_part(terminal_part, "muscle") != "ranged" or not bool(terminal_part.get("projectile", false)):
				return "needs a connected projectile gun at the terminal muscle."
		"ejectable_muscle_joint":
			if not _part_is_ejectable_muscle(terminal_part):
				return "needs an adjacent ejectable terminal muscle, such as a shield, chain fist, scythe, blade, lance, hammer, or glove."
		"chain_limb_joint":
			var required_degrees := int(module_part.get("required_joint_degrees", 180))
			if embedded_kind != "ball" or embedded_degrees < required_degrees:
				return "needs a %d-degree embedded ball/yoke joint to drive a whip chain." % required_degrees
			if not (_part_is_chain_limb_piece(embedded_part) or _part_is_chain_limb_piece(limb_part) or _part_is_chain_limb_piece(terminal_part)):
				return "needs a chain, whip, tendon, tentacle, or whip-damage limb segment."
		"blade_ball_joint":
			var required_degrees := int(module_part.get("required_joint_degrees", 180))
			if embedded_kind != "ball" or embedded_degrees < required_degrees:
				return "needs a %d-degree embedded ball/yoke joint for blade orbit." % required_degrees
			if not _component_is_blade_weapon(terminal_part):
				return "needs a blade terminal muscle such as scythe, katana, machete, or greatsword."
			var required_family := String(module_part.get("required_blade_family", "")).to_lower()
			if required_family != "" and _blade_weapon_family_for_part(terminal_part) != required_family:
				return "needs a %s blade terminal." % required_family
			if bool(module_part.get("requires_extend_or_hybrid_chain", false)):
				var chain_has_extend := embedded_kind in ["linear", "hybrid"] or String(limb_part.get("embedded_joint_kind", "")).to_lower() in ["linear", "hybrid"] or String(terminal_part.get("embedded_joint_kind", "")).to_lower() in ["linear", "hybrid"]
				if not chain_has_extend:
					return "needs a telescopic or hybrid linked blade chain."
		"pierce_telescopic_joint":
			var required_extension := float(module_part.get("required_extension_m", 1.0))
			if embedded_kind != "linear" or embedded_extension < required_extension:
				return "needs an embedded telescopic joint rated for %.0fm extension." % required_extension
			if not _component_is_pierce_weapon(terminal_part):
				return "needs a piercing terminal muscle such as lance, rapier, spike, or drill."
		"blunt_ball_joint":
			var required_degrees := int(module_part.get("required_joint_degrees", 180))
			if embedded_kind != "ball" or embedded_degrees < required_degrees:
				return "needs a %d-degree embedded ball/yoke joint for heavy blunt swing." % required_degrees
			if not _component_is_blunt_weapon(terminal_part):
				return "needs a blunt terminal muscle such as shield, hammer, glove, or jack."
		"blunt_hybrid_gauntlet":
			var required_degrees := int(module_part.get("required_joint_degrees", 90))
			var required_extension := float(module_part.get("required_extension_m", STANDARD_GAUNTLET_EXTENSION_M))
			if embedded_kind != "hybrid" or embedded_degrees < required_degrees or embedded_extension < required_extension:
				return "needs a blunt gauntlet terminal with a hybrid rotate+extend joint rated for %d degrees and %.1fm extension." % [required_degrees, required_extension]
			if not _part_is_standard_blunt_gauntlet(embedded_part):
				return "needs a blunt gauntlet terminal muscle."
		"blunt_shield_terminal":
			var required_degrees := int(module_part.get("required_joint_degrees", 90))
			if embedded_kind != "ball" or embedded_degrees < required_degrees:
				return "needs a blunt shield terminal with an embedded %d-degree ball/yoke joint." % required_degrees
			if not _part_is_blunt_shield_terminal(terminal_part):
				return "needs a blunt shield terminal muscle."
		"blunt_hammer_terminal":
			var required_degrees := int(module_part.get("required_joint_degrees", 120))
			if embedded_kind != "ball" or embedded_degrees < required_degrees:
				return "needs a blunt hammer terminal with an embedded %d-degree ball/yoke joint." % required_degrees
			if not _part_is_blunt_hammer_terminal(terminal_part):
				return "needs a blunt hammer or maul terminal muscle."
	return ""


func _two_link_chain_node_indices(role_key: String, unit_bp: Dictionary, source_index: int) -> Array:
	if not unit_bp.has("custom_topology"):
		return []
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	if source_index < 0 or source_index >= nodes.size() or not (nodes[source_index] is Dictionary):
		return []
	var raw_chain := _topology_downstream_node_indices(role_key, unit_bp, nodes, edges, source_index)
	var chain: Array = []
	for raw_index in raw_chain:
		var index := int(raw_index)
		if index < 0 or index >= nodes.size() or not (nodes[index] is Dictionary):
			continue
		if _topology_node_is_torso(role_key, nodes[index], unit_bp):
			continue
		if not _topology_node_is_component(nodes[index]):
			continue
		if not chain.has(index):
			chain.append(index)
	return chain


func _two_link_binding_root_for_selection(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, selection: Array) -> int:
	var candidates: Array = []
	for raw_index in selection:
		var index := int(raw_index)
		if index < 0 or index >= nodes.size() or not (nodes[index] is Dictionary):
			continue
		var cursor := index
		var guard := 0
		while cursor >= 0 and cursor < nodes.size() and guard < nodes.size():
			guard += 1
			if _topology_node_is_component(nodes[cursor]) and not _topology_node_is_torso(role_key, nodes[cursor], unit_bp):
				if not candidates.has(cursor):
					candidates.append(cursor)
			var parent_index := _topology_parent_index_for_node(role_key, unit_bp, nodes, edges, cursor)
			if parent_index < 0 or parent_index >= nodes.size() or _topology_node_is_torso(role_key, nodes[parent_index], unit_bp):
				break
			cursor = parent_index
	var best := -1
	var best_distance := 999999
	for raw_candidate in candidates:
		var candidate := int(raw_candidate)
		var chain := _two_link_chain_node_indices(role_key, unit_bp, candidate)
		if chain.size() != 2:
			continue
		var contains_selection := false
		for raw_selected in selection:
			if chain.has(int(raw_selected)):
				contains_selection = true
				break
		if not contains_selection:
			continue
		var distance := _topology_distance_from_nearest_torso(role_key, unit_bp, nodes, edges, candidate)
		if distance < best_distance:
			best_distance = distance
			best = candidate
	return best


func _two_link_forward_snap_invalid_reason(module_part: Dictionary, attack_node: Dictionary, role_key: String, unit_bp: Dictionary) -> String:
	var source_index := int(attack_node.get("source_embedded_joint_node", attack_node.get("source_joint_node", -1)))
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	if source_index < 0 or source_index >= nodes.size():
		return "needs a bound two-segment limb in custom topology."
	var chain := _two_link_chain_node_indices(role_key, unit_bp, source_index)
	if chain.size() != 2:
		return "needs exactly two connected muscle segments and no third downstream segment."
	var first_index := int(chain[0])
	var second_index := int(chain[1])
	var first_node: Dictionary = nodes[first_index]
	var second_node: Dictionary = nodes[second_index]
	var first_slot := _topology_node_slot(first_node)
	if not (first_slot in ["limb_muscle", "muscle"]):
		return "first segment must be a limb muscle or rotating melee terminal muscle."
	var second_slot := _topology_node_slot(second_node)
	if not (second_slot in ["limb_muscle", "muscle"]):
		return "second segment must be a limb muscle or a rotating melee terminal muscle."
	var first_part := _topology_node_part(role_key, first_node, unit_bp)
	var second_part := _topology_node_part(role_key, second_node, unit_bp)
	if first_slot == "muscle":
		if not _part_counts_as_terminal_weapon(first_part, "muscle"):
			return "first muscle must be a terminal weapon if it uses the muscle catalog."
	if second_slot == "muscle":
		if not _part_counts_as_terminal_weapon(second_part, "muscle"):
			return "second muscle must be a terminal weapon if it uses the muscle catalog."
	var first_profile := _embedded_joint_profile_for_part(first_part, first_slot, module_part)
	var second_profile := _embedded_joint_profile_for_part(second_part, second_slot, module_part)
	if String(first_profile.get("kind", "")) != "ball":
		return "first segment needs a rotating embedded joint."
	if String(second_profile.get("kind", "")) != "ball":
		return "second segment needs a rotating embedded joint."
	return ""


func _part_is_ejectable_muscle(part: Dictionary) -> bool:
	if part.is_empty():
		return false
	if bool(part.get("is_torso", false)) or bool(part.get("projectile_only", false)):
		return false
	if bool(part.get("ejectable_muscle", false)) or bool(part.get("terminal_weapon", false)):
		return true
	if not _part_counts_as_terminal_weapon(part, "muscle"):
		return false
	var shape := String(part.get("shape", "")).to_lower()
	var material_class := String(part.get("material_class", "")).to_lower()
	if material_class in ["weapon", "whip_muscle", "chain", "wood", "barrier_wall"]:
		return true
	for token in ["shield", "glove", "fist", "hammer", "scythe", "katana", "blade", "sword", "lance", "pike", "spike", "drill", "machete", "jaw", "horn", "tail"]:
		if shape.contains(token):
			return true
	return false


func _part_is_chain_limb_piece(part: Dictionary) -> bool:
	if part.is_empty():
		return false
	var name := String(part.get("name", "")).to_upper()
	var shape := String(part.get("shape", "")).to_lower()
	var material_class := String(part.get("material_class", "")).to_lower()
	return material_class in ["chain", "whip_muscle", "whip_joint"] or bool(part.get("whip_damage_part", false)) or name.contains("CHAIN") or name.contains("WHIP") or name.contains("TENDON") or name.contains("TENTACLE") or shape.contains("chain") or shape.contains("whip") or shape.contains("tendon") or shape.contains("tentacle")


func _joint_supports_ball_swing(joint_part: Dictionary, required_degrees: int) -> bool:
	var name := String(joint_part.get("name", "")).to_upper()
	var shape := String(joint_part.get("shape", "")).to_lower()
	var material_class := String(joint_part.get("material_class", "")).to_lower()
	if bool(joint_part.get("fixed_corner_joint", false)) or shape.contains("corner"):
		return false
	if shape.contains("linear") or shape.contains("telescopic") or name.contains("LINEAR") or name.contains("TELESCOPIC"):
		return false
	if material_class == "whip_joint" or bool(joint_part.get("whip_damage_part", false)):
		return required_degrees <= 180
	if not (shape.contains("ball") or shape.contains("socket") or shape.contains("yoke") or shape.contains("gimbal") or name.contains("BALL") or name.contains("SOCKET") or name.contains("YOKE") or name.contains("GIMBAL") or name.contains("GYRO")):
		return required_degrees <= 90 and name.contains("JOINT")
	return _joint_supported_degrees(joint_part) >= required_degrees


func _joint_supports_telescopic_extension(joint_part: Dictionary, required_extension_m: float) -> bool:
	var name := String(joint_part.get("name", "")).to_upper()
	var shape := String(joint_part.get("shape", "")).to_lower()
	if not (shape.contains("linear") or shape.contains("telescopic") or shape.contains("curved") or name.contains("LINEAR") or name.contains("TELESCOPIC")):
		return false
	return _joint_supported_extension_m(joint_part) >= required_extension_m


func _joint_supported_degrees(joint_part: Dictionary) -> int:
	if joint_part.has("joint_degrees"):
		return int(joint_part["joint_degrees"])
	var name := String(joint_part.get("name", "")).to_upper()
	var shape := String(joint_part.get("shape", "")).to_lower()
	if bool(joint_part.get("fixed_corner_joint", false)) or shape.contains("corner"):
		return 0
	if name.contains("360") or shape.contains("360") or String(joint_part.get("cancel_profile", "")).contains("omni"):
		return 360
	if name.contains("180") or shape.contains("180") or name.contains("YOKE") or name.contains("GIMBAL") or String(joint_part.get("cancel_profile", "")) == "bidirectional":
		return 180
	if name.contains("90") or shape.contains("90"):
		return 90
	var range_value := float(joint_part.get("range", 0.0))
	if range_value >= 0.75:
		return 360
	if range_value >= 0.08:
		return 180
	return 90


func _joint_supported_extension_m(joint_part: Dictionary) -> float:
	if joint_part.has("max_extension_m"):
		return float(joint_part["max_extension_m"])
	var range_value := float(joint_part.get("range", 0.0))
	if range_value >= 0.3:
		return 3.0
	if range_value >= 0.2:
		return 2.0
	if range_value >= 0.1:
		return 1.0
	return 0.0


func _ether_group_rule_note(unit_bp: Dictionary, stats: Dictionary) -> String:
	if stats.is_empty():
		return ""
	var ether_count := int(stats.get("ether_count", 0))
	if ether_count <= 0:
		return ""
	var capacity := maxi(1, int(stats.get("ether_group_capacity", 1)))
	if ether_count > capacity:
		return "INVALID: ether group %d/%d. This ether can link with at most %d other ethers." % [ether_count, capacity, maxi(0, capacity - 1)]
	return ""


func _topology_rule_note(unit_bp: Dictionary, role_key: String, stats: Dictionary) -> String:
	if role_key == "barrier":
		var ether_note := _ether_group_rule_note(unit_bp, stats)
		if ether_note != "":
			return ether_note
	if not unit_bp.has("custom_topology"):
		return ""
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	if bool(topology.get("legacy_rejected", false)):
		return "INVALID: old independent-joint topology is deprecated; rebuild this unit in TeamEdit."
	if nodes.is_empty():
		return "INVALID: blank topology needs at least one material node."
	if role_key == "barrier":
		var material_slots := int(stats.get("material_slots", 0))
		if material_slots > 0 and nodes.size() > material_slots:
			return "INVALID: ether material slots %d/%d." % [nodes.size(), material_slots]
	elif nodes.size() > 1 and not _topology_connected(nodes.size(), edges):
		return "INVALID: non-barrier topology must be connected."
	if role_key != "barrier":
		var has_torso_or_core := false
		for torso_check_index in range(nodes.size()):
			if nodes[torso_check_index] is Dictionary and _topology_node_is_torso(role_key, nodes[torso_check_index], unit_bp):
				has_torso_or_core = true
				break
		if not has_torso_or_core:
			return "INVALID: free-canvas robots need at least one torso/core connector."
	for i in range(nodes.size()):
		var node: Dictionary = nodes[i]
		if _topology_node_is_component(node):
			var slot_key := _topology_node_slot(node)
			var part := _topology_node_part(role_key, node, unit_bp)
			if part.is_empty():
				return "INVALID: node %d has no purchased component." % [i + 1]
			if slot_key == "joint":
				return "INVALID: node %d uses deprecated independent joint topology; rebuild with muscles that have embedded root joints." % [i + 1]
			var socket_ids := _topology_socket_ids_for_node(role_key, node, unit_bp)
			if slot_key == "limb_muscle" and (not socket_ids.has("root_joint") or not socket_ids.has("distal")):
				return "INVALID: node %d limb muscle must have root_joint and distal interfaces." % [i + 1]
			if slot_key == "muscle" and not _component_is_torso(part) and not socket_ids.has("root_joint"):
				return "INVALID: node %d terminal/torso muscle needs a root_joint interface." % [i + 1]
			var occupied_interfaces := _connected_topology_neighbors(edges, i, nodes.size()).size()
			var interface_limit := _topology_node_connection_limit(role_key, node, unit_bp)
			if occupied_interfaces > interface_limit:
				if slot_key == "joint":
					return "INVALID: node %d uses deprecated independent joint topology." % [i + 1]
				return "INVALID: node %d has %d/%d occupied interfaces." % [i + 1, occupied_interfaces, interface_limit]
			continue
		return "INVALID: old abstract topology node %d is deprecated; rebuild with direct muscle components." % [i + 1]
	for edge in edges:
		var a := _topology_edge_node_a(edge)
		var b := _topology_edge_node_b(edge)
		if a < 0 or b < 0 or a >= nodes.size() or b >= nodes.size():
			return "INVALID: topology edge references missing node."
		var node_a: Dictionary = nodes[a]
		var node_b: Dictionary = nodes[b]
		if not _topology_edge_can_connect(node_a, node_b):
			return "INVALID: nodes %d-%d violate hard assembly: torso/muscle distal must connect to downstream muscle root_joint." % [a + 1, b + 1]
		var rank_a := 0
		var rank_b := 0
		if _topology_node_is_component(node_a):
			rank_a = _component_size_rank(_topology_node_part(role_key, node_a, unit_bp))
		else:
			var limb_a := _selected_component(role_key, "limb_muscle", int(node_a.get("limb_muscle", unit_bp.get("limb_muscle", 0))))
			rank_a = _component_size_rank(limb_a)
		if _topology_node_is_component(node_b):
			rank_b = _component_size_rank(_topology_node_part(role_key, node_b, unit_bp))
		else:
			var limb_b := _selected_component(role_key, "limb_muscle", int(node_b.get("limb_muscle", unit_bp.get("limb_muscle", 0))))
			rank_b = _component_size_rank(limb_b)
		if absi(rank_a - rank_b) > 2:
			return "INVALID: nodes %d-%d change size too abruptly; add an intermediate part." % [a + 1, b + 1]
		var edge_points := _topology_edge_socket_board_points(role_key, unit_bp, nodes, edges, a, b)
		if edge_points.is_empty():
			return "INVALID: nodes %d-%d have no explicit socket pair." % [a + 1, b + 1]
		var socket_a_pos: Vector2 = edge_points.get("a", Vector2.ZERO)
		var socket_b_pos: Vector2 = edge_points.get("b", Vector2.ZERO)
		var socket_gap_units := socket_a_pos.distance_to(socket_b_pos) / maxf(1.0, _topology_board_uniform_scale()) * TOPOLOGY_BOARD_PHYSICAL_UNITS
		if socket_gap_units > TOPOLOGY_EDGE_TOLERANCE:
			return "INVALID: nodes %d-%d sockets must overlap; gap %.2f. Drag the connected part or reconnect the joint." % [a + 1, b + 1, socket_gap_units]
	var endpoint_conflicts := _topology_endpoint_conflicts(role_key, unit_bp, nodes, edges)
	if endpoint_conflicts.has("note"):
		return String(endpoint_conflicts["note"])
	var slot_note := String(stats.get("joint_slot_note", ""))
	if slot_note.begins_with("INVALID"):
		return slot_note
	var sweep_note := String(stats.get("swept_collision_note", ""))
	if sweep_note.begins_with("INVALID"):
		return sweep_note
	if _role_uses_body_board(role_key):
		var action_note := _action_module_rule_note(unit_bp, role_key)
		if action_note.begins_with("INVALID"):
			return action_note
	return "Topology OK: %d material nodes / %d links." % [nodes.size(), edges.size()]


func _topology_connected(node_count: int, edges: Array) -> bool:
	if node_count <= 1:
		return true
	var seen := {0: true}
	var frontier := [0]
	while not frontier.is_empty():
		var current := int(frontier.pop_back())
		for edge in edges:
			var a := _topology_edge_node_a(edge)
			var b := _topology_edge_node_b(edge)
			var next := -1
			if a == current:
				next = b
			elif b == current:
				next = a
			if next >= 0 and next < node_count and not seen.has(next):
				seen[next] = true
				frontier.append(next)
	return seen.size() == node_count


func _normalize_size_tier_label(raw_tier: String) -> String:
	var value := raw_tier.strip_edges().to_upper()
	if value in ["XS", "S", "M", "L", "XL"]:
		return value
	match value.to_lower():
		"starter", "nano", "micro", "tiny":
			return "XS"
		"small":
			return "S"
		"standard", "medium":
			return "M"
		"long", "heavy", "siege", "titan":
			return "L"
		"colossus", "kaiju", "monster", "leviathan":
			return "XL"
	return "M"


func _size_tier_rank(label: String) -> int:
	match _normalize_size_tier_label(label):
		"XS":
			return 1
		"S":
			return 2
		"M":
			return 3
		"L":
			return 4
		"XL":
			return 5
	return 3


func _size_tier_from_footprint(length: float, radius: float, mass: float = 0.0) -> String:
	var footprint := maxf(length, radius * 2.7) + mass * 0.002
	if footprint <= 0.18:
		return "XS"
	if footprint <= 0.48:
		return "S"
	if footprint <= 1.15:
		return "M"
	if footprint <= 2.35:
		return "L"
	return "XL"


func _part_size_tier_label(part: Dictionary, _slot_key: String = "") -> String:
	if part.has("size_tier"):
		return _normalize_size_tier_label(String(part["size_tier"]))
	if part.has("size_class"):
		return _normalize_size_tier_label(String(part["size_class"]))
	return _size_tier_from_footprint(float(part.get("length", 0.0)), float(part.get("radius", 0.0)), float(part.get("mass", 0.0)))


func _component_size_rank(part: Dictionary) -> int:
	match _part_size_tier_label(part):
		"XS":
			return 0
		"S":
			return 1
		"M":
			return 3
		"L":
			return 5
		"XL":
			return 7
	return 3


func _stiffness_size_multiplier_for_label(size_label: String) -> float:
	match _normalize_size_tier_label(size_label):
		"XS":
			return 0.25
		"S":
			return 0.5
		"M":
			return 1.0
		"L":
			return 2.0
		"XL":
			return 4.0
	return 1.0


func _part_stiffness_size_multiplier(part: Dictionary) -> float:
	return _stiffness_size_multiplier_for_label(_part_size_tier_label(part))


func _collider_stiffness_size_multiplier(collider: Dictionary, unit = null) -> float:
	if collider.has("size_tier"):
		return _stiffness_size_multiplier_for_label(String(collider.get("size_tier", "M")))
	var size_rank := int(collider.get("size_rank", 3))
	if size_rank <= 0:
		return 0.25
	if size_rank <= 1:
		return 0.5
	if size_rank <= 3:
		return 1.0
	if size_rank <= 5:
		return 2.0
	if size_rank <= 7:
		return 4.0
	if unit != null and is_instance_valid(unit):
		return _stiffness_size_multiplier_for_label(String(unit.stats.get("size_class", "M")))
	return 1.0


func _stats_size_rank_value(stats: Dictionary) -> float:
	var label := String(stats.get("size_class", ""))
	if label != "":
		return float(_size_tier_rank(label))
	return float(_size_tier_rank(_size_tier_from_footprint(float(stats.get("length", 0.0)), float(stats.get("radius", 0.0)), float(stats.get("mass", 0.0)))))


func _add_roster_unit() -> void:
	var player_id := _editor_player()
	if _roster_unit_total(player_id) >= _current_roster_cap():
		editor_summary_label.text = "队伍已满：%s 当前最多构筑 %d 个单位。" % [_match_format_name(), _current_roster_cap()] if _ui_is_zh() else "ROSTER FULL: %s can build at most %d units." % [_match_format_name(), _current_roster_cap()]
		return
	var role_key: String = ROLE_ORDER[editor_role_index]
	var source: Dictionary = _blueprint_for(player_id, role_key, int(editor_unit_indices[role_key])).duplicate(true)
	source["name"] = "P%d %s %d" % [player_id, _role_name(role_key), blueprints[player_id][role_key].size() + 1]
	blueprints[player_id][role_key].append(source)
	editor_unit_indices[role_key] = blueprints[player_id][role_key].size() - 1
	active_roster_indices[player_id][role_key] = int(editor_unit_indices[role_key])
	sortie_loadouts[player_id] = []
	initial_sortie_slot[player_id] = 0
	ai_team_manual_lock[player_id] = true
	_update_editor_ui()


func _delete_roster_unit() -> void:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var roster: Array = blueprints[player_id][role_key]
	if roster.is_empty():
		editor_summary_label.text = "当前类别没有可删除的单位。" if _ui_is_zh() else "No unit in this role to delete."
		return
	var deleted_index := int(editor_unit_indices[role_key])
	roster.remove_at(deleted_index)
	_update_sortie_after_delete(player_id, role_key, deleted_index)
	sortie_loadouts[player_id] = []
	initial_sortie_slot[player_id] = 0
	editor_unit_indices[role_key] = clampi(int(editor_unit_indices[role_key]), 0, maxi(0, roster.size() - 1))
	active_roster_indices[player_id][role_key] = int(editor_unit_indices[role_key])
	ai_team_manual_lock[player_id] = true
	if roster.is_empty():
		_reset_editor_working_canvas(role_key)
	_update_editor_ui()


func _tick_battle(delta: float) -> void:
	_reset_battle_vfx_frame_budget()
	if game_over:
		if Input.is_action_just_pressed("menu_confirm"):
			_show_menu()
		return

	if identity_transfer_active:
		identity_freeze_timer = maxf(0.0, identity_freeze_timer - delta)
		_update_aim_lines(0.0)
		_update_battle_ui()
		return
	if hitstop_timer > 0.0:
		hitstop_timer = maxf(0.0, hitstop_timer - delta)
		_update_units(0.0)
		_update_aim_lines(0.0)
		_update_battle_ui()
		return

	runtime_resource[1] = float(runtime_resource[1]) + RESOURCE_GAIN_PER_SECOND * delta
	if battle_mode != MODE_TRAINING:
		runtime_resource[2] = float(runtime_resource[2]) + RESOURCE_GAIN_PER_SECOND * delta
	_tick_sortie_price_discounts(delta)
	_apply_lease_costs(delta)
	_apply_annuity_income(delta)
	match_time_remaining = maxf(0.0, match_time_remaining - delta)
	if match_time_remaining <= 0.0:
		_resolve_timeout()
		return

	if battle_message_timer > 0.0:
		battle_message_timer -= delta
		if battle_message_timer <= 0.0:
			battle_message = ""

	_tick_deploys(delta)
	_update_blind_zones(delta)
	_update_retreat_repairs(delta)
	_update_served_balls(delta)
	_apply_signal_jammers(delta)
	_apply_homing_launchers(delta)
	_apply_barrage_emitters(delta)
	_apply_support_components(delta)
	_apply_speed_lanes(delta)
	_apply_coin_generators(delta)
	_update_field_coins(delta)
	_update_one_way_shields(delta)
	_update_escape_pods(delta)
	_update_laser_telegraphs(delta)
	_update_true_bullet_locks(delta)
	_update_chemical_projectiles(delta)
	_update_missile_projectiles(delta)
	_update_web_tethers(delta)
	_update_web_swings(delta)
	_handle_battle_input(delta)
	if battle_mode == MODE_AI:
		if ai_battle_seat != 1:
			_update_ai_player(1, delta)
		if ai_battle_seat != 2:
			_update_ai_player(2, delta)
	elif battle_mode == MODE_TRAINING:
		_update_training_dummy(delta)

	_update_anti_stall_summons(delta)
	_update_puppets(delta)
	_update_barriers(delta)
	_update_units(delta, false)
	_update_camera_center()
	_tick_mobius_visual_twist(delta)
	_refresh_mobius_surface_view()
	_update_parallax_background()
	_refresh_unit_screen_positions()
	_update_aim_lines(delta)
	_update_combat_geometry_debug_overlay()
	_update_battle_ui()


func _refresh_battle_camera_projection_now() -> void:
	if game_state != STATE_BATTLE:
		return
	_update_camera_center()
	_refresh_mobius_surface_view()
	_update_parallax_background()
	_refresh_unit_screen_positions()


func _apply_lease_costs(delta: float) -> void:
	for unit in all_units:
		if not _is_live_unit(unit):
			continue
		var lease_rate := float(unit.stats.get("lease_rate", 0.0))
		if lease_rate <= 0.0:
			continue
		var owner := int(unit.owner_id)
		var owed := lease_rate * delta
		var available := maxf(0.0, float(runtime_resource.get(owner, 0.0)))
		var paid := minf(available, owed)
		runtime_resource[owner] = available - paid
		if paid < owed:
			_add_unit_heat(unit, float(unit.stats.get("lease_heat_penalty", 4.0)) * delta)
		var warn_timer := maxf(0.0, float(unit.get_meta("lease_warn_timer", 0.0)) - delta)
		if warn_timer <= 0.0:
			unit.set_meta("lease_warn_timer", 2.4)
			_show_battle_message("P%d YOKE lease drains %.0f/sec" % [owner, lease_rate], 0.55)
		else:
			unit.set_meta("lease_warn_timer", warn_timer)


func _apply_annuity_income(delta: float) -> void:
	for unit in all_units:
		if not _is_live_unit(unit):
			continue
		var rate := float(unit.stats.get("annuity_rate", 0.0))
		if rate <= 0.0:
			continue
		var owner := int(unit.owner_id)
		runtime_resource[owner] = float(runtime_resource.get(owner, 0.0)) + rate * delta
		var timer := maxf(0.0, float(unit.get_meta("annuity_tick", 0.0)) - delta)
		if timer <= 0.0:
			unit.set_meta("annuity_tick", 3.0)
			_spawn_hit_effect(unit, 1, "laser", false, "shield")
		else:
			unit.set_meta("annuity_tick", timer)


func _apply_support_components(delta: float) -> void:
	for support in all_units:
		if not _is_live_unit(support) or not bool(support.stats.get("is_support_node", false)):
			continue
		if float(support.get_meta("jammed_timer", 0.0)) > 0.0:
			continue
		var kind := String(support.stats.get("support_kind", ""))
		if kind == "":
			continue
		var radius := _support_effect_radius(support)
		_update_field_aura_visual(support, _support_aura_kind(kind), radius, _support_visual_strength(support), delta)
		var owner := int(support.owner_id)
		for target in _field_targets_for(owner, String(support.stats.get("support_affects", "ally"))):
			if not _support_can_affect_target(support, target):
				continue
			if not _unit_in_support_area(support, target):
				continue
			_apply_support_to_target(support, target, delta)


func _support_effect_radius(support) -> float:
	if bool(support.stats.get("is_support_platform", false)):
		return maxf(0.1, maxf(float(support.stats.get("platform_pair_range", 0.0)), float(support.stats.get("support_radius", 0.0))))
	return maxf(0.1, float(support.stats.get("support_radius", 0.6)))


func _support_aura_kind(kind: String) -> String:
	match kind:
		"ammo":
			return "support_ammo"
		"repair":
			return "support_repair"
		"cooling":
			return "coolant"
		"damage_buff":
			return "support_buff"
		"armor":
			return "support_armor"
	return "support"


func _support_can_affect_target(support, target) -> bool:
	if not _is_live_unit(target):
		return false
	var kind := String(support.stats.get("support_kind", ""))
	if kind in ["ammo", "repair", "cooling", "damage_buff", "armor"]:
		return String(target.role) in ["hero", "puppet", "barrier"]
	return _unit_is_mech_physics_subject(target)


func _apply_speed_lanes(delta: float) -> void:
	for lane_node in all_units:
		if not _is_live_unit(lane_node) or not bool(lane_node.stats.get("is_speed_lane", false)):
			continue
		if float(lane_node.get_meta("jammed_timer", 0.0)) > 0.0:
			continue
		var radius := maxf(0.1, float(lane_node.stats.get("speed_lane_radius", 0.72)))
		_update_field_aura_visual(lane_node, "speed_lane", radius, float(lane_node.stats.get("speed_lane_mult", 1.5)), delta)
		var owner := int(lane_node.owner_id)
		for target in _field_targets_for(owner, String(lane_node.stats.get("speed_lane_affects", "all"))):
			if target == lane_node or not _is_live_unit(target) or not _unit_is_mech_physics_subject(target):
				continue
			if not _unit_in_speed_lane(lane_node, target):
				continue
			_apply_speed_lane_to_unit(lane_node, target, delta)


func _unit_in_speed_lane(lane_node, unit) -> bool:
	var radius := maxf(0.1, float(lane_node.stats.get("speed_lane_radius", 0.72)))
	var width := maxf(0.06, float(lane_node.stats.get("speed_lane_width", 0.2)))
	var delta := _mobius_delta_vec_between(lane_node, unit)
	return absf(delta.x) <= radius + float(unit.stats.get("radius", 0.2)) and absf(delta.y) <= width + float(unit.stats.get("radius", 0.2)) * 0.5


func _apply_speed_lane_to_unit(lane_node, unit, delta: float) -> void:
	var base_mult := float(lane_node.stats.get("speed_lane_mult", 1.5))
	var affinity := float(unit.stats.get("speed_lane_affinity", 0.0))
	var mult := clampf(base_mult + affinity, 1.0, 3.5)
	var pull := maxf(0.02, float(lane_node.stats.get("speed_lane_pull", 0.32)))
	var dir_sign := float(lane_node.facing)
	if bool(lane_node.stats.get("speed_lane_bidirectional", true)) and absf(unit.velocity.x) > 0.03:
		dir_sign = signf(unit.velocity.x)
	if dir_sign == 0.0:
		dir_sign = 1.0
	var unit_speed := maxf(0.12, float(unit.stats.get("speed", 0.8)))
	var base_speed := maxf(absf(unit.velocity.x), unit_speed * 0.55)
	var desired := clampf(base_speed * mult, 0.0, unit_speed * mult + 1.2)
	unit.velocity.x = move_toward(unit.velocity.x, dir_sign * desired, (pull + desired) * delta * 2.2)
	unit.velocity.y = move_toward(unit.velocity.y, 0.0, pull * delta * 0.45)
	unit.set_meta("speed_lane_timer", 0.18)
	unit.set_meta("speed_lane_mult", mult)
	if randf() < delta * 3.5:
		_spawn_hit_effect(unit, 0, "laser", false, "guided")


func _apply_coin_generators(delta: float) -> void:
	for generator in all_units:
		if not _is_live_unit(generator) or not bool(generator.stats.get("is_coin_generator", false)):
			continue
		if float(generator.get_meta("jammed_timer", 0.0)) > 0.0:
			continue
		var radius := maxf(0.12, float(generator.stats.get("coin_spawn_radius", 0.48)))
		_update_field_aura_visual(generator, "siphon", radius, 1.0, delta)
		var timer := maxf(0.0, float(generator.get_meta("coin_timer", float(generator.stats.get("coin_interval", 6.0)))) - delta)
		if timer > 0.0:
			generator.set_meta("coin_timer", timer)
			continue
		generator.set_meta("coin_timer", maxf(0.6, float(generator.stats.get("coin_interval", 6.0))))
		_spawn_field_coin(generator)


func _spawn_field_coin(generator) -> void:
	if effects_root == null:
		return
	var owner := int(generator.owner_id)
	var radius := maxf(0.08, float(generator.stats.get("coin_spawn_radius", 0.48)))
	var value := maxi(1, int(generator.stats.get("coin_value", 100)))
	var ttl := maxf(0.6, float(generator.stats.get("coin_ttl", 5.0)))
	var angle := randf() * TAU
	var ring_value := wrapf(generator.ring_pos + cos(angle) * radius * randf_range(0.25, 1.0), 0.0, RING_LENGTH)
	var lane_value := clampf(generator.lane + sin(angle) * radius * 0.72, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	var visual := CoinPickupEffect.new()
	visual.setup(owner, value, ttl)
	var screen := _screen_from_ring(ring_value, lane_value)
	visual.position = screen["position"]
	visual.visible = bool(screen["visible"])
	effects_root.add_child(visual)
	field_coins.append({
		"owner": owner,
		"ring": ring_value,
		"lane": lane_value,
		"value": value,
		"pickup_radius": maxf(0.08, float(generator.stats.get("coin_pickup_radius", 0.16))),
		"visual": visual,
	})
	_show_battle_message("P%d coin minted +%d route prize" % [owner, value], 0.45)


func _update_field_coins(delta: float) -> void:
	for coin in field_coins.duplicate():
		if not (coin is Dictionary):
			field_coins.erase(coin)
			continue
		var visual = coin.get("visual", null)
		if visual == null or not is_instance_valid(visual):
			field_coins.erase(coin)
			continue
		var ring_value := float(coin.get("ring", 0.0))
		var lane_value := float(coin.get("lane", 0.0))
		var screen := _screen_from_ring(ring_value, lane_value)
		visual.update_screen(screen["position"], bool(screen["visible"]), delta)
		if visual.expired():
			field_coins.erase(coin)
			continue
		var collector = _coin_collector(coin)
		if collector == null:
			continue
		var value := int(coin.get("value", 100))
		var owner := int(collector.owner_id)
		runtime_resource[owner] = float(runtime_resource.get(owner, 0.0)) + float(value)
		visual.collect()
		field_coins.erase(coin)
		_spawn_hit_effect(collector, 1, "laser", false, "shield")
		_show_battle_message("%s picked +%d resource coin" % [collector.unit_name, value], 0.55)


func _coin_collector(coin: Dictionary):
	var best = null
	var best_distance := 999.0
	var coin_ring := float(coin.get("ring", 0.0))
	var coin_lane := float(coin.get("lane", 0.0))
	var pickup_radius := maxf(0.08, float(coin.get("pickup_radius", 0.16)))
	for unit in all_units:
		if not _is_live_unit(unit) or not _unit_is_mech_physics_subject(unit):
			continue
		var coin_delta := _mobius_delta_unit_to_point(unit, coin_ring, coin_lane, 1.25)
		var distance := absf(coin_delta.x) + absf(coin_delta.y)
		var reach := pickup_radius + float(unit.stats.get("radius", 0.1)) * 0.8
		if distance <= reach and distance < best_distance:
			best_distance = distance
			best = unit
	return best


func _update_one_way_shields(delta: float) -> void:
	for shield in all_units:
		if not _is_live_unit(shield) or not bool(shield.stats.get("is_one_way_shield", false)):
			continue
		var radius := maxf(0.14, float(shield.stats.get("shield_radius", 0.74)))
		var flash := 2.2 if float(shield.get_meta("shield_flash_timer", 0.0)) > 0.0 else 1.0
		_update_field_aura_visual(shield, "one_way_shield", radius, flash, delta)


func _support_visual_strength(support) -> float:
	var kind := String(support.stats.get("support_kind", ""))
	match kind:
		"ammo":
			return maxf(0.5, float(support.stats.get("support_amount", 1)) * 0.22)
		"repair":
			return maxf(0.5, float(support.stats.get("support_rate", 1.0)) / 12.0)
		"cooling":
			return maxf(0.5, float(support.stats.get("support_rate", support.stats.get("coolant_boost", 12.0))) / 18.0)
		"damage_buff":
			return maxf(0.5, float(support.stats.get("support_buff_mult", 1.0)))
		"armor":
			return maxf(0.5, float(support.stats.get("platform_armor_hp", 0.0)) / 18.0)
	return 1.0


func _unit_in_support_area(support, target) -> bool:
	if not _is_live_unit(support) or not _is_live_unit(target):
		return false
	if bool(support.stats.get("is_support_platform", false)) or String(support.stats.get("support_field_shape", "")) == "rectangle":
		var range := maxf(0.1, float(support.stats.get("platform_pair_range", support.stats.get("support_radius", 0.8))))
		var width := maxf(0.05, float(support.stats.get("platform_width", 0.32)))
		var delta_vec := _mobius_delta_vec_between(support, target)
		return absf(delta_vec.x) <= range + float(target.stats.get("radius", 0.2)) and absf(delta_vec.y) <= width + float(target.stats.get("radius", 0.2)) * 0.42
	return _unit_in_barrier_aura(support, target, maxf(0.1, float(support.stats.get("support_radius", 0.6))), "support")


func _apply_support_to_target(support, target, delta: float) -> void:
	var kind := String(support.stats.get("support_kind", ""))
	match kind:
		"ammo":
			var ammo_type := String(support.stats.get("support_ammo_type", "bullet"))
			var key := "support_ammo_time_%d_%s" % [int(support.get_instance_id()), ammo_type]
			var progress := float(target.get_meta(key, 0.0)) + delta
			var needed := maxf(0.1, float(support.stats.get("support_refill_seconds", 1.0)))
			if progress >= needed:
				progress = 0.0
				var refill_result := _paid_refill_ammo(target, ammo_type, maxi(1, int(support.stats.get("support_amount", 1))))
				var refilled := int(refill_result.get("refilled", 0))
				if refilled > 0:
					_spawn_hit_effect(target, 0, ammo_type, false, _projectile_style_for_damage(ammo_type))
					var spent := float(refill_result.get("cost", 0.0))
					if _ui_is_zh():
						_show_battle_message("%s 为 %s 补给%s x%d，消耗 %.1f 资源" % [support.unit_name, target.unit_name, _damage_name(ammo_type), refilled, spent], 0.5)
					else:
						_show_battle_message("%s buys %s ammo x%d for %s (-%.1f resource)" % [support.unit_name, ammo_type.to_upper(), refilled, target.unit_name, spent], 0.5)
				elif String(refill_result.get("reason", "")) == "resource":
					_play_module_fail_sfx()
					if _ui_is_zh():
						_show_battle_message("%s 补给%s失败：资源不足" % [target.unit_name, _damage_name(ammo_type)], 0.48)
					else:
						_show_battle_message("%s %s refill failed: resource short" % [target.unit_name, ammo_type.to_upper()], 0.48)
			target.set_meta(key, progress)
		"repair":
			if target.health < target.max_health:
				target.health = mini(target.max_health, target.health + int(ceilf(float(support.stats.get("support_rate", 8.0)) * delta)))
				if randf() < delta * 1.8:
					_spawn_hit_effect(target, 0, "chemical", false, "shield")
		"cooling":
			var cooling_rate := float(support.stats.get("support_rate", support.stats.get("coolant_boost", 16.0)))
			_cool_unit_heat(target, cooling_rate * delta, float(target.stats.get("overheat_clear_ratio", 0.42)))
		"damage_buff":
			target.set_meta("field_damage_boost_type", String(support.stats.get("support_buff_type", "tear")))
			target.set_meta("field_damage_boost_mult", maxf(1.0, float(support.stats.get("support_buff_mult", 1.12))))
			target.set_meta("field_damage_boost_timer", maxf(0.12, float(support.stats.get("support_duration", 0.28))))
		"armor":
			var armor_hp := maxf(1.0, float(support.stats.get("platform_armor_hp", 16.0)))
			target.set_meta("support_armor_timer", 0.18)
			target.set_meta("support_armor_source", int(support.get_instance_id()))
			target.set_meta("support_armor_hp", maxf(float(target.get_meta("support_armor_hp", 0.0)), armor_hp))


func _apply_signal_jammers(delta: float) -> void:
	for jammer in all_units:
		if not _is_live_unit(jammer) or not bool(jammer.stats.get("is_signal_jammer", false)):
			continue
		var owner := int(jammer.owner_id)
		var radius := maxf(0.1, float(jammer.stats.get("jam_radius", 0.8)))
		var required := maxf(0.25, float(jammer.stats.get("jam_seconds", 2.0)))
		var jam_power := maxf(0.1, float(jammer.stats.get("jam_power", 1.0)))
		var duration := maxf(0.2, float(jammer.stats.get("jam_duration", 1.2)))
		_update_field_aura_visual(jammer, "jam", radius, required, delta)
		for target in _field_targets_for(owner, String(jammer.stats.get("jam_affects", "enemy"))):
			if target == jammer or not _is_live_unit(target) or not _unit_can_be_jammed(target):
				continue
			if not _unit_in_barrier_aura(jammer, target, radius, "jammer"):
				continue
			var key := "jam_time_%d" % int(jammer.get_instance_id())
			var progress := float(target.get_meta(key, 0.0)) + delta
			target.set_meta(key, progress)
			target.set_meta("jam_warning_timer", 0.35)
			var target_required := _security_adjusted_seconds(required, target, jam_power, 0.25)
			if progress >= target_required:
				target.set_meta(key, 0.0)
				target.set_meta("jammed_timer", maxf(float(target.get_meta("jammed_timer", 0.0)), duration))
				if bool(target.stats.get("is_trap_field", false)):
					target.set_meta("trap_cooldown_timer", maxf(float(target.get_meta("trap_cooldown_timer", 0.0)), duration + 0.6))
				_spawn_hit_effect(target, 2, "laser", false, "blind")
				_show_battle_message("%s JAMMED %s / SEC %.2f" % [jammer.unit_name, target.unit_name, _data_security_value(target)], 0.65)


func _apply_homing_launchers(delta: float) -> void:
	# Projectile systems are frozen until they are driven by explicit gun_activate modules.
	# Seeker parts remain catalog data, but proximity alone must not fire missiles or UI alerts.
	return
	for launcher in all_units:
		if not _is_live_unit(launcher) or not bool(launcher.stats.get("is_homing_launcher", false)):
			continue
		if float(launcher.get_meta("jammed_timer", 0.0)) > 0.0:
			continue
		var interval := maxf(0.18, float(launcher.stats.get("homing_interval", 1.2)))
		var timer := maxf(0.0, float(launcher.get_meta("homing_timer", randf_range(0.05, interval))) - delta)
		launcher.set_meta("homing_timer", timer)
		if timer > 0.0:
			continue
		var radius := maxf(0.1, float(launcher.stats.get("homing_radius", 1.4)))
		var target = _nearest_homing_target(launcher, radius)
		if target == null:
			launcher.set_meta("homing_timer", interval * 0.45)
			continue
		launcher.set_meta("homing_timer", interval)
		_fire_homing_missile(launcher, target, radius)


func _nearest_homing_target(launcher, radius: float):
	var best = null
	var best_score := 999.0
	for target in _field_targets_for(int(launcher.owner_id), String(launcher.stats.get("homing_affects", "enemy"))):
		if target == launcher or not _is_live_unit(target):
			continue
		var target_delta := _mobius_delta_vec_between(launcher, target)
		var distance := absf(target_delta.x)
		var lane_distance := absf(target_delta.y)
		var target_radius := float(target.stats.get("radius", 0.2))
		if distance > radius + target_radius or lane_distance > radius * 0.72 + target_radius * 0.5:
			continue
		var score := distance + lane_distance * 0.72 - target_radius * 0.14
		if score < best_score:
			best_score = score
			best = target
	return best


func _fire_homing_missile(launcher, target, radius: float) -> void:
	var damage_type := String(launcher.stats.get("homing_damage_type", "bullet"))
	var accuracy := clampf(float(launcher.stats.get("homing_accuracy", 0.65)), 0.0, 1.0)
	var delta_vec := _mobius_delta_vec_between(launcher, target, 1.25)
	if delta_vec.length() <= 0.01:
		delta_vec = Vector2(float(launcher.facing), 0.0)
	var error_angle := randf_range(-1.0, 1.0) * (1.0 - accuracy) * 0.82
	var direction := delta_vec.normalized().rotated(error_angle).normalized()
	var event: Dictionary = {
		"owner_id": int(launcher.owner_id),
		"state": "normal",
		"damage": maxi(1, int(launcher.stats.get("homing_damage", 8))),
		"range": radius + float(target.stats.get("radius", 0.2)),
		"lane_range": 0.2 + (1.0 - accuracy) * 0.24 + float(target.stats.get("radius", 0.2)) * 0.45,
		"knock": float(launcher.stats.get("homing_knock", 0.08)),
		"damage_type": damage_type,
		"material_class": "projectile",
		"recoil": 0.03,
		"source_name": launcher.unit_name,
		"projectile": true,
		"projectile_style": "missile",
		"travel_path": "homing",
		"direction": direction,
	}
	_spawn_hit_effect(launcher, 0, damage_type, false, "missile")
	_show_battle_message("%s SEEKER %.0f%%" % [launcher.unit_name, accuracy * 100.0], 0.32)
	_resolve_attack(launcher, event)


func _apply_barrage_emitters(delta: float) -> void:
	for emitter in all_units:
		if not _is_live_unit(emitter) or not bool(emitter.stats.get("is_barrage_emitter", false)):
			continue
		if float(emitter.get_meta("jammed_timer", 0.0)) > 0.0:
			continue
		var interval := maxf(0.16, float(emitter.stats.get("barrage_interval", 0.8)))
		var timer := maxf(0.0, float(emitter.get_meta("barrage_timer", randf_range(0.02, interval))) - delta)
		emitter.set_meta("barrage_timer", timer)
		emitter.set_meta("barrage_spin_phase", float(emitter.get_meta("barrage_spin_phase", 0.0)) + delta * float(emitter.stats.get("barrage_spin_rate", 1.0)))
		if timer > 0.0:
			continue
		emitter.set_meta("barrage_timer", interval)
		_fire_barrage_projectile(emitter)


func _fire_barrage_projectile(emitter) -> void:
	var damage_type := String(emitter.stats.get("barrage_damage_type", "bullet"))
	var mode := String(emitter.stats.get("barrage_mode", "fixed"))
	var event: Dictionary = {
		"owner_id": int(emitter.owner_id),
		"state": "normal",
		"damage": maxi(1, int(emitter.stats.get("barrage_damage", 5))),
		"range": maxf(0.25, float(emitter.stats.get("barrage_range", 1.2))),
		"lane_range": maxf(0.08, float(emitter.stats.get("barrage_lane_range", 0.18))),
		"knock": 0.04,
		"damage_type": damage_type,
		"material_class": "projectile",
		"recoil": 0.0,
		"source_name": emitter.unit_name,
		"projectile": true,
		"projectile_style": String(emitter.stats.get("barrage_style", _projectile_style_for_damage(damage_type))),
		"travel_path": mode,
	}
	if mode == "fixed":
		event["direction"] = Vector2(float(emitter.facing), 0.0)
	elif mode == "spin":
		var phase := float(emitter.get_meta("barrage_spin_phase", 0.0))
		event["direction"] = Vector2(cos(phase), sin(phase) * 0.9).normalized()
	elif mode == "around":
		event["lane_range"] = maxf(float(event["lane_range"]), float(event["range"]) * 0.72)
	_spawn_hit_effect(emitter, 0, damage_type, false, String(event["projectile_style"]))
	_resolve_attack(emitter, event)


func _update_escape_pods(delta: float) -> void:
	for pod in all_units.duplicate():
		if not _is_live_unit(pod) or not bool(pod.get_meta("escape_pod", false)):
			continue
		var target_ring := float(pod.get_meta("escape_target_ring", pod.ring_pos))
		var target_lane := float(pod.get_meta("escape_target_lane", pod.lane))
		var delta_vec := _mobius_delta_unit_to_point(pod, target_ring, target_lane, 1.25)
		if delta_vec.length() <= 0.06:
			var carried := int(pod.get_meta("carried_modules", 0))
			_detach_unit(pod)
			pod.queue_free()
			_show_battle_message("Escape pod secured %d action modules" % carried, 0.75)
			continue
		var speed := maxf(0.12, float(pod.stats.get("speed", pod.get_meta("escape_speed", 1.0))))
		var dir := delta_vec.normalized()
		pod.velocity = Vector2(dir.x, dir.y * 0.7) * speed
		if pod.has_method("request_facing"):
			pod.request_facing(1 if dir.x >= 0.0 else -1)
		else:
			pod.facing = 1 if dir.x >= 0.0 else -1
		_spawn_escape_pod_trail(pod, delta)


func _spawn_escape_pod_trail(pod, delta: float) -> void:
	if randf() > delta * 5.5:
		return
	_spawn_hit_effect(pod, 0, "laser", false, "guided")


func _unit_can_be_jammed(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	return _unit_is_mech_physics_subject(unit) or bool(unit.stats.get("is_trap_field", false))


func _data_security_value(unit) -> float:
	if unit == null or not is_instance_valid(unit):
		return 1.0
	return clampf(float(unit.stats.get("data_security", 1.0)), 0.25, 3.6)


func _security_adjusted_seconds(base_seconds: float, target, attack_power: float = 1.0, floor_seconds: float = 0.25) -> float:
	var security := _data_security_value(target)
	var power := maxf(0.12, attack_power)
	return maxf(floor_seconds, base_seconds * security / power)


func _handle_battle_input(delta: float) -> void:
	if Input.is_action_just_pressed("menu_back"):
		if battle_runtime_menu_panel != null and battle_runtime_menu_panel.visible:
			_hide_battle_runtime_menu()
		else:
			_toggle_battle_runtime_menu()
		return
	if battle_runtime_menu_panel != null and battle_runtime_menu_panel.visible:
		return
	if battle_mode == MODE_AI:
		if ai_battle_seat == 1:
			_handle_player_battle_input(1, delta, "p1")
		elif ai_battle_seat == 2:
			_handle_player_battle_input(2, delta, "p1")
		else:
			_handle_spectator_battle_input(delta)
		return
	if battle_mode == MODE_PVP:
		_handle_player_battle_input(1, delta, "p1")
		_handle_player_battle_input(2, delta, "p2")
	else:
		if ai_battle_seat == 2:
			_handle_player_battle_input(2, delta, "p1")
		elif ai_battle_seat == 3:
			_handle_spectator_battle_input(delta)
		else:
			_handle_player_battle_input(1, delta, "p1")


func _handle_spectator_battle_input(delta: float) -> void:
	var input_vector := _input_vector_for("p1")
	if input_vector.length() > 0.12:
		spectator_view_mode = SPECTATOR_VIEW_FREE
		var pan_speed := VIEW_WIDTH * 0.62
		spectator_camera_center = wrapf(spectator_camera_center + input_vector.x * pan_speed * delta, 0.0, RING_LENGTH)
		spectator_camera_lane = clampf(spectator_camera_lane + input_vector.y * pan_speed * delta, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	if Input.is_action_just_pressed("p1_face_left"):
		_cycle_spectator_view(-1)
	if Input.is_action_just_pressed("p1_face_right"):
		_cycle_spectator_view(1)
	if Input.is_action_just_pressed("p1_attack_1"):
		_set_spectator_view_mode(SPECTATOR_VIEW_P1)
	elif Input.is_action_just_pressed("p1_attack_2"):
		_set_spectator_view_mode(SPECTATOR_VIEW_P2)
	elif Input.is_action_just_pressed("p1_attack_3"):
		_set_spectator_view_mode(SPECTATOR_VIEW_MID)
	elif Input.is_action_just_pressed("p1_attack_4"):
		_set_spectator_view_mode(SPECTATOR_VIEW_FREE)


func _cycle_spectator_view(direction: int) -> void:
	var index := SPECTATOR_VIEW_ORDER.find(spectator_view_mode)
	if index < 0:
		index = 0
	_set_spectator_view_mode(String(SPECTATOR_VIEW_ORDER[_wrapped_index(index + direction, SPECTATOR_VIEW_ORDER.size())]))


func _set_spectator_view_mode(mode: String) -> void:
	if not SPECTATOR_VIEW_ORDER.has(mode):
		mode = SPECTATOR_VIEW_MID
	spectator_view_mode = mode
	match spectator_view_mode:
		SPECTATOR_VIEW_P1:
			spectator_camera_center = _camera_center_for_player(1)
			spectator_camera_lane = _camera_lane_for_player(1)
		SPECTATOR_VIEW_P2:
			spectator_camera_center = _camera_center_for_player(2)
			spectator_camera_lane = _camera_lane_for_player(2)
		SPECTATOR_VIEW_MID:
			spectator_camera_center = _spectator_camera_focus()
			spectator_camera_lane = _spectator_lane_focus()
	_show_battle_message("P3 镜头：%s" % _spectator_view_label() if _ui_is_zh() else "P3 CAMERA: %s" % _spectator_view_label(), 0.75)


func _consume_attack_chord(unit, prefix: String, chord: Array, latch_key: String) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	var all_pressed := true
	var any_just_pressed := false
	for raw_index in chord:
		var action_name := "%s_attack_%d" % [prefix, int(raw_index) + 1]
		if not Input.is_action_pressed(action_name):
			all_pressed = false
		if Input.is_action_just_pressed(action_name):
			any_just_pressed = true
	if not all_pressed:
		unit.set_meta(latch_key, false)
		return false
	if bool(unit.get_meta(latch_key, false)):
		return false
	if not any_just_pressed:
		return false
	unit.set_meta(latch_key, true)
	return true


func _end_stagger_combo_now(unit) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	_set_unit_stagger_timer(unit, 0.0)
	unit.set("action_cooldown", 0.0)
	unit.set("current_state", "normal")
	unit.set("state_timer", 0.0)
	unit.set("recovery_boost_timer", 0.0)
	_clear_combo_opportunity(unit)


func _try_burst_break_chord(player_id: int, prefix: String, input_vector: Vector2) -> bool:
	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero):
		return false
	if not _consume_attack_chord(hero, prefix, BURST_ATTACK_CHORD, "burst_chord_latch"):
		return false
	var price := maxi(1, int(hero.stats.get("cost", hero.stats.get("deploy_cost", 90))))
	var burst_cost := maxi(1, int(ceilf(float(price) / 3.0)))
	if float(runtime_resource.get(player_id, 0.0)) < float(burst_cost):
		_play_module_fail_sfx()
		_show_battle_message("P%d 爆霸需要 %d 资源" % [player_id, burst_cost] if _ui_is_zh() else "P%d burst needs %d resource" % [player_id, burst_cost], 0.65)
		return true
	_execute_burst_break(player_id, hero, input_vector, burst_cost)
	return true


func _execute_burst_break(player_id: int, hero, input_vector: Vector2, burst_cost: int = -1) -> void:
	if not _is_live_unit(hero):
		return
	var price := maxi(1, int(hero.stats.get("cost", hero.stats.get("deploy_cost", 90))))
	var cost := maxi(1, int(ceilf(float(price) / 3.0))) if burst_cost < 0 else maxi(0, burst_cost)
	if cost > 0:
		runtime_resource[player_id] = maxf(0.0, float(runtime_resource.get(player_id, 0.0)) - float(cost))
	aim_holding[player_id] = false
	aim_action_name[player_id] = ""
	_end_stagger_combo_now(hero)
	var burst_origin := Vector2(hero.ring_pos, hero.lane)
	var burst_power := clampf(1.25 + _unit_effective_mass(hero) * 0.002 + _unit_thruster_power(hero) * 0.32, 1.15, 3.25)
	for target in _enemy_units(player_id):
		if not _is_live_unit(target) or not _unit_role_is_mech(target):
			continue
		var direction := _mobius_delta_points(burst_origin.x, burst_origin.y, target.ring_pos, target.lane)
		if direction.length() <= 0.001:
			direction = input_vector if input_vector.length() > 0.01 else _unit_forward_vector(hero)
		if direction.length() <= 0.001:
			direction = Vector2(float(hero.facing), 0.0)
		direction = direction.normalized()
		var target_mult := _unit_impulse_motion_mult(target)
		_apply_unit_displacement(target, direction, burst_power * target_mult)
		target.velocity += direction * burst_power * 3.8 * target_mult
		if target.has_method("apply_physics_impulse"):
			target.apply_physics_impulse(direction, burst_power * 0.78, -1, 0.0)
		_spawn_hit_effect(target, 0, "blunt", false, "explosion")
	_spawn_hit_effect(hero, 0, "blunt", false, "explosion")
	_play_sfx_wave("explosion", 160.0, 0.42, -6.0)
	_show_battle_message("P%d 爆霸 -%d：硬直结束，全屏击退" % [player_id, cost] if _ui_is_zh() else "P%d BURST -%d: stagger break, full-screen push" % [player_id, cost], 0.9)


func _try_romance_cancel_chord(player_id: int, prefix: String) -> bool:
	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero):
		return false
	if not _consume_attack_chord(hero, prefix, ROMANCE_CANCEL_CHORD, "romance_cancel_chord_latch"):
		return false
	if _combo_opportunity_active(hero):
		_play_module_fail_sfx()
		_show_battle_message("P%d 硬直中只能爆霸" % player_id if _ui_is_zh() else "P%d staggered: burst only" % player_id, 0.55)
		return true
	_execute_romance_cancel(player_id, hero)
	return true


func _execute_romance_cancel(player_id: int, hero) -> void:
	if not _is_live_unit(hero):
		return
	hero.set("action_cooldown", 0.0)
	hero.set("active_part_timer", 0.0)
	hero.set("state_timer", 0.0)
	hero.set("current_state", "normal")
	hero.set_meta("module_cancel_ready", true)
	hero.set_meta("last_module_gate_reason", "romance_cancel")
	_spawn_hit_effect(hero, 0, "laser", false, "shield")
	_play_sfx_wave("identity", 620.0, 0.18, -9.0)
	_show_battle_message("P%d 浪漫取消：动作恢复已重置" % player_id if _ui_is_zh() else "P%d ROMANCE CANCEL: recovery reset" % player_id, 0.75)


func _spectator_view_label() -> String:
	match spectator_view_mode:
		SPECTATOR_VIEW_FREE:
			return _ui_term("free_camera")
		SPECTATOR_VIEW_P1:
			return _ui_term("p1_view")
		SPECTATOR_VIEW_P2:
			return _ui_term("p2_view")
	return _ui_term("mid_view")


func _battle_movement_vector_for_unit(unit, raw_input: Vector2) -> Dictionary:
	var gameplay_input := GameplayTransform.screen_input_to_gameplay_motion(raw_input)
	var surface_input := _mobius_surface_input_for_unit(unit, raw_input) if mobius_enabled and _is_live_unit(unit) else gameplay_input
	var actual_input := surface_input if mobius_enabled else gameplay_input
	return {
		"raw": raw_input,
		"gameplay": gameplay_input,
		"surface": surface_input,
		"actual": actual_input,
	}


func _handle_player_battle_input(player_id: int, delta: float, prefix: String) -> void:
	var facing_unit = active_units[player_id]["hero"]
	var face_left_held := Input.is_action_pressed("%s_face_left" % prefix)
	var face_right_held := Input.is_action_pressed("%s_face_right" % prefix)
	var turn_keys_reserved_for_weapon_aim := _held_aim_uses_turn_keys(player_id, prefix)
	if _is_live_unit(facing_unit) and not turn_keys_reserved_for_weapon_aim:
		var turn_sign := (-1 if face_left_held else 0) + (1 if face_right_held else 0)
		if facing_unit.has_method("set_turn_input_active"):
			facing_unit.set_turn_input_active(turn_sign != 0)
		if turn_sign != 0:
			if facing_unit.has_method("request_turn"):
				facing_unit.request_turn(turn_sign, delta)
			elif facing_unit.has_method("request_facing"):
				facing_unit.request_facing(turn_sign)
			else:
				facing_unit.facing = turn_sign
	if Input.is_action_just_pressed("%s_portal" % prefix):
		portal_index[player_id] = _wrapped_index(int(portal_index[player_id]) + 1, PORTALS.size())
		var portal: Dictionary = PORTALS[int(portal_index[player_id])]
		_show_battle_message("P%d %s：%s" % [player_id, _ui_term("portal"), portal["name"]], 0.9)

	var input_vector := _input_vector_for(prefix)
	var previous_input: Vector2 = battle_last_move_input_vectors.get(player_id, Vector2.ZERO)
	var has_move_input := input_vector.length() > 0.04
	var movement_just_pressed := has_move_input and (previous_input.length() <= 0.04 or _battle_direction_just_pressed(prefix))
	battle_last_move_input_vectors[player_id] = input_vector
	battle_last_move_just_pressed[player_id] = movement_just_pressed
	var hero_for_chord = active_units[player_id]["hero"]
	if _is_live_unit(hero_for_chord):
		if _try_burst_break_chord(player_id, prefix, input_vector):
			return
		if _try_romance_cancel_chord(player_id, prefix):
			return
	if not _attack_windows_any_open(player_id) and not _runtime_gun_activation_active(player_id) and _try_attack_pair_summon(player_id, prefix, input_vector):
		return

	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero):
		return
	if float(hero.get_meta("active_cool_lock", 0.0)) > 0.0:
		hero.velocity = Vector2.ZERO
		return
	if float(hero.get_meta("jammed_timer", 0.0)) > 0.0:
		aim_holding[player_id] = false
		aim_action_name[player_id] = ""
		_show_battle_message("P%d SIGNAL JAM %.1fs" % [player_id, float(hero.get_meta("jammed_timer", 0.0))], 0.25)
		return
	var movement_vectors := _battle_movement_vector_for_unit(hero, input_vector)
	var surface_input_vector: Vector2 = movement_vectors.get("surface", Vector2.ZERO)
	var gameplay_input_vector: Vector2 = movement_vectors.get("gameplay", Vector2.ZERO)
	var movement_input_vector: Vector2 = movement_vectors.get("actual", Vector2.ZERO)
	if input_vector.length() <= 0.04 and hero.has_method("note_movement_input_released"):
		hero.note_movement_input_released()
	if movement_just_pressed and hero.has_method("note_movement_input_pressed"):
		hero.note_movement_input_pressed(movement_input_vector)
	if hero.has_method("set_meta"):
		hero.set_meta("move_input_vector", input_vector)
		hero.set_meta("surface_move_input_vector", surface_input_vector)
		hero.set_meta("gameplay_move_input_vector", gameplay_input_vector)
		hero.set_meta("actual_move_input_vector", movement_input_vector)
		hero.set_meta("move_input_just_pressed", movement_just_pressed)

	_tick_runtime_gun_activation(player_id, prefix, delta)
	_tick_attack_command_windows(player_id, prefix, delta)
	var attack_window_active := _attack_windows_any_open(player_id)
	var gun_activation_active := _runtime_gun_activation_active(player_id)
	if attack_window_active or gun_activation_active:
		_handle_direction_taps(player_id, prefix)
	else:
		_handle_face_chord_boost(player_id, prefix, input_vector)
		if not _unit_uses_direct_runtime_topology(hero):
			_record_command_input(player_id, prefix)
		_handle_direction_taps(player_id, prefix)
	if hero.has_method("move_by_gameplay"):
		hero.move_by_gameplay(movement_input_vector, delta, RING_LENGTH)
	else:
		hero.move_by(movement_input_vector, delta, RING_LENGTH)
	if not attack_window_active and not gun_activation_active:
		hero.try_cancel(movement_input_vector, delta)

	var requested_attack_state := "normal" if _unit_uses_direct_runtime_topology(hero) else _melee_command_attack_kind(player_id, hero, false, input_vector)
	var handled_attack := false
	if not bool(aim_holding[player_id]):
		for attack_index in range(ATTACK_GROUP_COUNT):
			var action_name := "%s_attack_%d" % [prefix, attack_index + 1]
			if Input.is_action_just_pressed(action_name):
				_start_or_fire_attack_button(player_id, prefix, input_vector, attack_index, action_name, requested_attack_state)
				handled_attack = true
	if handled_attack:
		return
	if bool(aim_holding[player_id]):
		var held_action := String(aim_action_name[player_id])
		if held_action != "" and Input.is_action_pressed(held_action):
			_update_held_aim(player_id, prefix, input_vector, delta)
		if held_action == "" or Input.is_action_just_released(held_action):
			var locked_target = aim_locked_targets[player_id]
			var locked_direction: Vector2 = aim_locked_directions[player_id]
			var fire_direction: Vector2 = locked_direction if locked_direction.length() > 0.01 else aim_directions[player_id]
			var release_group := _attack_group(hero, int(aim_attack_index[player_id]))
			var release_should_fire := bool(release_group.get("release_to_fire", false)) or (not bool(release_group.get("hold_to_activate", false))) or _group_uses_true_bullet(release_group)
			aim_holding[player_id] = false
			if release_should_fire:
				_hero_normal_attack(player_id, prefix, fire_direction, int(aim_attack_index[player_id]), String(aim_action_state[player_id]), locked_target)
			aim_action_name[player_id] = ""
			aim_action_state[player_id] = "normal"
			aim_hold_fire_timers[player_id] = 0.0
			aim_locked_targets[player_id] = null
			aim_locked_directions[player_id] = Vector2.ZERO


func _held_aim_uses_turn_keys(player_id: int, prefix: String = "") -> bool:
	if _runtime_gun_activation_active(player_id):
		return true
	if prefix != "":
		var runtime_hero = active_units[player_id]["hero"]
		if _is_live_unit(runtime_hero) and _unit_uses_direct_runtime_topology(runtime_hero):
			for attack_index in range(ATTACK_GROUP_COUNT):
				var action_name := "%s_attack_%d" % [prefix, attack_index + 1]
				if Input.is_action_just_pressed(action_name) and _runtime_binding_is_gun_activation(_runtime_binding_for_attack_index(runtime_hero, attack_index)):
					return true
	if not bool(aim_holding[player_id]):
		return false
	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero):
		return false
	if _unit_uses_direct_runtime_topology(hero):
		return false
	var group := _attack_group(hero, int(aim_attack_index[player_id]))
	return bool(group.get("turn_keys_steer_joint", false))


func _hold_activation_initial_delay(group: Dictionary) -> float:
	if not bool(group.get("hold_to_activate", false)) or not bool(group.get("projectile", false)):
		return 0.0
	if bool(group.get("release_to_fire", false)):
		return 9999.0
	if _group_uses_true_bullet(group):
		return 9999.0
	var damage_type := String(group.get("projectile_damage_type", group.get("damage_type", "")))
	if damage_type == "laser":
		return 0.0
	return 0.0


func _hold_activation_fire_interval(group: Dictionary) -> float:
	if float(group.get("fire_rate", 0.0)) > 0.0:
		return 1.0 / maxf(0.05, float(group.get("fire_rate", 0.0)))
	if float(group.get("fire_interval", 0.0)) > 0.0:
		return maxf(0.04, float(group.get("fire_interval", 0.0)))
	var damage_type := String(group.get("projectile_damage_type", group.get("damage_type", "")))
	if damage_type == "laser":
		return clampf(float(group.get("laser_aim_time", LASER_DEFAULT_AIM_SECONDS)), LASER_MIN_AIM_SECONDS, LASER_MAX_AIM_SECONDS) + 0.32
	if damage_type == "chemical":
		return 0.2
	if _projectile_behavior_for_data(group) == "bullet_hell":
		return 0.16
	return 0.24


func _try_attack_pair_summon(player_id: int, prefix: String, input_vector: Vector2) -> bool:
	var bindings := _ensure_summon_pair_bindings(player_id)
	for slot_index in range(bindings.size()):
		var pair: Array = bindings[slot_index]
		if pair.size() < 2:
			continue
		var action_a := "%s_attack_%d" % [prefix, int(pair[0])]
		var action_b := "%s_attack_%d" % [prefix, int(pair[1])]
		var both_pressed := Input.is_action_pressed(action_a) and Input.is_action_pressed(action_b)
		var fresh_pair := Input.is_action_just_pressed(action_a) or Input.is_action_just_pressed(action_b)
		if both_pressed and fresh_pair:
			_summon_sortie_slot(player_id, slot_index, input_vector)
			aim_holding[player_id] = false
			aim_action_name[player_id] = ""
			return true
	return false


func _summon_sortie_slot(player_id: int, slot_index: int, input_vector: Vector2) -> bool:
	var sortie_order := _team_sortie_order(player_id)
	if slot_index < 0 or slot_index >= sortie_order.size():
		_illegal_summon_feedback(player_id, "No sortie unit assigned to pair slot %d" % [slot_index + 1])
		return false
	var entry: Dictionary = sortie_order[slot_index]
	var role_key := String(entry.get("role", "hero"))
	var unit_index := int(entry.get("index", 0))
	var previous_index := int(active_roster_indices[player_id].get(role_key, 0))
	active_roster_indices[player_id][role_key] = unit_index
	var next_portal := _portal_index_from_vector(input_vector, int(portal_index[player_id]))
	portal_index[player_id] = next_portal
	var portal: Dictionary = PORTALS[next_portal]
	var accepted := _summon_role(player_id, role_key, false)
	if accepted:
		_show_battle_message("P%d SLOT %d %s #%d via %s" % [player_id, slot_index + 1, _role_name(role_key), unit_index + 1, String(portal["name"])], 1.0)
	else:
		active_roster_indices[player_id][role_key] = previous_index
	return accepted


func _team_sortie_order(player_id: int) -> Array:
	var loadout := _ensure_sortie_loadout(player_id)
	var order: Array = []
	for entry in loadout:
		if entry is Dictionary and _valid_roster_entry(player_id, entry):
			order.append(Dictionary(entry).duplicate(true))
		if order.size() >= _current_sortie_cap():
			break
	return order


func _sortie_pair_preview(player_id: int, max_items: int = SORTIE_UNIT_CAP) -> String:
	var order := _team_sortie_order(player_id)
	var bindings := _ensure_summon_pair_bindings(player_id)
	var pieces: Array = []
	var limit: int = mini(max_items, mini(order.size(), bindings.size()))
	for i in range(limit):
		var pair: Array = bindings[i]
		var entry: Dictionary = order[i]
		pieces.append("%s:%s" % [_pair_label(pair), _sortie_entry_label(player_id, entry, game_state == STATE_BATTLE)])
	if order.size() > limit:
		pieces.append("+%d" % [order.size() - limit])
	return ("组合召唤 " if _ui_is_zh() else "PAIR SUMMON ") + "  ".join(pieces)


func _portal_index_from_vector(input_vector: Vector2, fallback_index: int) -> int:
	if input_vector.length() < 0.34:
		return clampi(fallback_index, 0, PORTALS.size() - 1)
	var x := input_vector.x
	var y := input_vector.y
	if y < -0.35:
		if x < -0.35:
			return 0
		if x > 0.35:
			return 2
		return 1
	if y > 0.35:
		if x < -0.35:
			return 5
		if x > 0.35:
			return 7
		return 6
	if x < -0.35:
		return 3
	if x > 0.35:
		return 4
	return clampi(fallback_index, 0, PORTALS.size() - 1)


func _start_or_fire_attack_button(player_id: int, prefix: String, input_vector: Vector2, attack_index: int, action_name: String, requested_state: String = "normal") -> void:
	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero):
		return
	if _unit_uses_direct_runtime_topology(hero):
		var binding := _runtime_binding_for_attack_index(hero, attack_index)
		if _runtime_binding_is_gun_activation(binding):
			_start_runtime_gun_activation(player_id, prefix, attack_index, action_name, binding)
			return
		if _attack_windows_any_open(player_id) and _ensure_attack_command_windows(player_id).has(_attack_window_key(attack_index)):
			_resolve_attack_command_window(player_id, prefix, input_vector, attack_index, "normal")
			return
		if binding.is_empty():
			_play_module_fail_sfx()
			_show_battle_message("攻击键 %d 未绑定行动模块" % [attack_index + 1] if _ui_is_zh() else "Attack key %d has no module binding" % [attack_index + 1], 0.55)
			return
		_open_attack_command_window(player_id, prefix, attack_index, binding)
		return
	var group := _attack_group(hero, attack_index)
	requested_state = _attack_state_for_group(player_id, hero, group, input_vector, requested_state)
	var aim_mode := String(group.get("aim_mode", hero.stats.get("aim_mode", "fixed")))
	if _group_uses_true_bullet(group):
		aim_mode = "manual"
	if requested_state in ["active", "armor"]:
		if String(group.get("module_action_profile", "")) == "two_link_forward_snap":
			command_buffers[player_id] = []
		else:
			_consume_melee_state_command(player_id, hero, requested_state, input_vector)
	if aim_mode == "fixed":
		_hero_normal_attack(player_id, prefix, input_vector, attack_index, requested_state)
		return
	aim_holding[player_id] = true
	aim_attack_index[player_id] = attack_index
	aim_action_name[player_id] = action_name
	aim_action_state[player_id] = requested_state
	aim_directions[player_id] = _attack_direction_for_group(hero, input_vector, group)
	aim_auto_phase[player_id] = 0.0
	aim_hold_fire_timers[player_id] = _hold_activation_initial_delay(group)
	aim_locked_targets[player_id] = null
	aim_locked_directions[player_id] = Vector2.ZERO
	if hero.has_method("set_aim_pose"):
		hero.set_aim_pose(attack_index, aim_directions[player_id], 0.18)


func _input_vector_for(prefix: String) -> Vector2:
	var input_vector := Vector2(
		Input.get_action_strength("%s_right" % prefix) - Input.get_action_strength("%s_left" % prefix),
		Input.get_action_strength("%s_down" % prefix) - Input.get_action_strength("%s_up" % prefix)
	)
	if input_vector.length() <= 0.08:
		return Vector2.ZERO
	return input_vector.normalized() if input_vector.length() > 1.0 else input_vector


func _gun_turn_input_vector_for(prefix: String) -> Vector2:
	var x := Input.get_action_strength("%s_face_right" % prefix) - Input.get_action_strength("%s_face_left" % prefix)
	if absf(x) <= 0.08:
		return Vector2.ZERO
	return Vector2(clampf(x, -1.0, 1.0), 0.0)


func _refresh_boost_visibility_after_start(unit) -> void:
	if not _is_live_unit(unit):
		return
	_guard_camera_to_unit_projection(unit, _unit_combat_coord(unit))
	_refresh_unit_screen_positions()


func _handle_direction_taps(player_id: int, prefix: String) -> void:
	var tap_window := 0.28
	var now := Time.get_ticks_msec() * 0.001
	var directions := {
		"left": Vector2.LEFT,
		"right": Vector2.RIGHT,
		"up": Vector2.UP,
		"down": Vector2.DOWN,
	}
	if _attack_windows_any_open(player_id):
		if _battle_direction_just_pressed(prefix):
			_record_command_input(player_id, prefix)
			_handle_attack_window_direction_resolution(player_id, prefix, _input_vector_for(prefix))
		return
	if _runtime_gun_activation_active(player_id):
		return
	for name in directions.keys():
		if Input.is_action_just_pressed("%s_%s" % [prefix, name]):
			var last_time: float = float(last_direction_taps[player_id][name])
			if now - last_time <= tap_window:
				var hero = active_units[player_id]["hero"]
				var boost_dir := _input_vector_for(prefix)
				if boost_dir.length() <= 0.04:
					boost_dir = directions[name]
				var boost_vectors := _battle_movement_vector_for_unit(hero, boost_dir)
				boost_dir = boost_vectors.get("actual", Vector2.ZERO)
				if _is_live_unit(hero) and hero.boost(boost_dir, RING_LENGTH):
					_refresh_boost_visibility_after_start(hero)
					_show_battle_message("P%d BOOST %s" % [player_id, String(name).to_upper()], 0.35)
			last_direction_taps[player_id][name] = now


func _handle_face_chord_boost(player_id: int, prefix: String, input_vector: Vector2) -> void:
	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero):
		return
	if _held_aim_uses_turn_keys(player_id):
		return
	var chord_pressed := Input.is_action_pressed("%s_face_left" % prefix) and Input.is_action_pressed("%s_face_right" % prefix)
	if not chord_pressed:
		hero.set_meta("face_chord_boost_latch", false)
		return
	if bool(hero.get_meta("face_chord_boost_latch", false)):
		return
	hero.set_meta("face_chord_boost_latch", true)
	var boost_dir := input_vector
	if boost_dir.length() < 0.16:
		boost_dir = _unit_forward_vector(hero)
	else:
		var boost_vectors := _battle_movement_vector_for_unit(hero, boost_dir)
		boost_dir = boost_vectors.get("actual", Vector2.ZERO)
	if hero.boost(boost_dir, RING_LENGTH):
		_refresh_boost_visibility_after_start(hero)
		_show_battle_message("P%d BOOST CHORD" % player_id, 0.35)


func _update_held_aim(player_id: int, prefix: String, input_vector: Vector2, delta: float) -> void:
	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero):
		return
	var group := _attack_group(hero, int(aim_attack_index[player_id]))
	var mode := String(group.get("aim_mode", hero.stats.get("aim_mode", "fixed")))
	var direction: Vector2 = aim_directions[player_id]
	var true_bullet_aim := _group_uses_true_bullet(group)
	if true_bullet_aim and _is_live_unit(aim_locked_targets[player_id]):
		direction = aim_locked_directions[player_id]
	elif mode == "manual":
		if bool(group.get("turn_keys_steer_joint", false)):
			var steer := 0.0
			if Input.is_action_pressed("%s_face_left" % prefix):
				steer -= 1.0
			if Input.is_action_pressed("%s_face_right" % prefix):
				steer += 1.0
			if steer != 0.0:
				var turn_rate := float(group.get("manual_turn_rate", hero.stats.get("aim_swing", 5.5)))
				direction = direction.rotated(steer * turn_rate * delta).normalized()
		elif input_vector.length() > 0.18:
			var target := input_vector.normalized()
			var swing_rate: float = float(group.get("aim_swing", hero.stats.get("aim_swing", 5.5)))
			direction = direction.lerp(target, clampf(delta * swing_rate, 0.0, 1.0)).normalized()
	elif mode == "auto":
		aim_auto_phase[player_id] = float(aim_auto_phase[player_id]) + delta * float(group.get("auto_swing", hero.stats.get("auto_swing", 2.4)))
		var forward := _unit_forward_vector(hero)
		var side := Vector2(-forward.y, forward.x)
		direction = (forward + side * sin(float(aim_auto_phase[player_id])) * 0.95).normalized()
	aim_directions[player_id] = direction
	if hero.has_method("set_aim_pose"):
		hero.set_aim_pose(int(aim_attack_index[player_id]), direction, 0.14)
	if true_bullet_aim and not _is_live_unit(aim_locked_targets[player_id]):
		var preview_event := _true_bullet_event_for_aim(hero, direction, group, int(aim_attack_index[player_id]))
		var locked_target = _acquire_true_bullet_target(hero, preview_event)
		if _is_live_unit(locked_target):
			aim_locked_targets[player_id] = locked_target
			aim_locked_directions[player_id] = direction
			_show_battle_message("P%d TRUE BULLET AIM LOCK" % player_id, 0.42)
	_update_hold_activation_fire(player_id, prefix, direction, delta, group, true_bullet_aim)


func _update_hold_activation_fire(player_id: int, prefix: String, direction: Vector2, delta: float, group: Dictionary, true_bullet_aim: bool) -> void:
	if true_bullet_aim:
		return
	if not bool(group.get("hold_to_activate", false)) or not bool(group.get("projectile", false)):
		return
	var timer := float(aim_hold_fire_timers[player_id]) - delta
	if timer > 0.0:
		aim_hold_fire_timers[player_id] = timer
		return
	aim_hold_fire_timers[player_id] = _hold_activation_fire_interval(group)
	_hero_normal_attack(player_id, prefix, direction, int(aim_attack_index[player_id]), String(aim_action_state[player_id]), null, true)


func _record_command_input(player_id: int, prefix: String) -> void:
	command_timers[player_id] = maxf(0.0, float(command_timers[player_id]) - get_process_delta_time())
	if float(command_timers[player_id]) <= 0.0:
		command_buffers[player_id] = []

	var buffer: Array = command_buffers[player_id]
	var added_input := false
	if Input.is_action_just_pressed("%s_down" % prefix):
		buffer.append("2")
		added_input = true
	if Input.is_action_just_pressed("%s_right" % prefix):
		buffer.append("6")
		added_input = true
	if Input.is_action_just_pressed("%s_left" % prefix):
		buffer.append("4")
		added_input = true
	if Input.is_action_just_pressed("%s_up" % prefix):
		buffer.append("8")
		added_input = true
	if added_input:
		command_timers[player_id] = 0.42
	while buffer.size() > 8:
		buffer.pop_front()


func _begin_unit_module_action(unit, action_kind: String, group: Dictionary, attack_index: int) -> Dictionary:
	if unit == null or not is_instance_valid(unit):
		return {}
	var module_key := _melee_module_heat_key(group, attack_index)
	if unit.has_method("begin_module_action"):
		return unit.begin_module_action(action_kind, module_key, attack_index, bool(group.get("requires_joint_pair", false)))
	return unit.begin_action(action_kind)


func _unit_uses_direct_runtime_topology(unit) -> bool:
	return _is_live_unit(unit) and bool(unit.stats.get("teamedit_runtime_topology", false))


func _runtime_binding_for_attack_index(unit, attack_index: int) -> Dictionary:
	if not _unit_uses_direct_runtime_topology(unit):
		return {}
	var desired_key := clampi(attack_index + 1, 1, ATTACK_GROUP_COUNT)
	for raw_binding in Array(unit.stats.get("runtime_module_bindings", [])):
		if not (raw_binding is Dictionary):
			continue
		var binding: Dictionary = raw_binding
		if not bool(binding.get("runtime_valid", true)):
			continue
		if int(binding.get("attack_key", -1)) == desired_key:
			return binding.duplicate(true)
	return {}


func _runtime_binding_is_gun_activate(binding: Dictionary) -> bool:
	return _runtime_binding_is_gun_activation(binding)


func _runtime_binding_profile(binding: Dictionary) -> String:
	var module_part: Dictionary = binding.get("module_part", {}) if binding.get("module_part", {}) is Dictionary else {}
	return String(binding.get("module_action_profile", module_part.get("module_action_profile", "")))


func _gun_activation_profiles() -> Array:
	if action_profile_registry != null:
		return action_profile_registry.projectile_profiles()
	return ActionProfileRegistry.PROJECTILE_PROFILES.duplicate()


func _runtime_binding_is_gun_activation(binding: Dictionary) -> bool:
	return _gun_activation_profiles().has(_runtime_binding_profile(binding))


func _gun_activation_profile_for_kind(gun_kind: String) -> String:
	if action_profile_registry != null:
		return action_profile_registry.profile_for_gun_kind(gun_kind)
	return ActionProfileRegistry.new().profile_for_gun_kind(gun_kind)


func _effective_gun_activation_profile(module_profile: String, gun_kind: String, ammo_kind: String = "") -> String:
	if module_profile == "":
		return _gun_activation_profile_for_kind(gun_kind)
	if action_profile_registry != null:
		return action_profile_registry.effective_profile_for_activation(module_profile, gun_kind, ammo_kind)
	return ActionProfileRegistry.new().effective_profile_for_activation(module_profile, gun_kind, ammo_kind)


func _gun_activation_spec(gun_kind: String, profile: String = "") -> Dictionary:
	if profile == "":
		profile = _gun_activation_profile_for_kind(gun_kind)
	elif profile == "gun_activate" and not (gun_kind in ["sniper", "sprayer"]):
		profile = _gun_activation_profile_for_kind(gun_kind)
	match gun_kind:
		"sniper":
			if profile != "gun_activate":
				return {}
			return {"profile": "gun_activate", "semantic": "release_lock", "projectile_damage_type": "bullet", "projectile_style": "true_bullet", "projectile_behavior": "true_bullet", "travel_path": "instant_line", "default_width": STANDARD_SNIPER_PROJECTILE_WIDTH_M, "default_fire_interval": 9999.0}
		"sprayer":
			if profile != "gun_activate":
				return {}
			return {"profile": "gun_activate", "semantic": "hold_stream", "projectile_damage_type": "chemical", "projectile_style": "spray", "projectile_behavior": "chemical_line", "travel_path": "straight", "default_width": STANDARD_CHEMICAL_SPRAYER_WIDTH_M, "default_range": STANDARD_CHEMICAL_SPRAYER_RANGE_M, "default_fire_interval": STANDARD_CHEMICAL_SPRAYER_FIRE_INTERVAL}
		"rifle":
			if profile != "rifle_burst_activate":
				return {}
			return {"profile": "rifle_burst_activate", "semantic": "hold_burst", "projectile_damage_type": "bullet", "projectile_style": "bullet_hell", "projectile_behavior": "bullet_hell", "travel_path": "straight", "default_width": 0.12, "default_fire_interval": 0.18}
		"grenade_launcher":
			if profile != "grenade_arc_activate":
				return {}
			return {"profile": "grenade_arc_activate", "semantic": "hold_grenade_arc", "projectile_damage_type": "explosion", "projectile_style": "explosive", "projectile_behavior": "explosive", "travel_path": "arc_u", "default_width": 0.18, "default_range": 2.65, "default_fire_interval": 1.111111}
		"laser_gun":
			if profile != "laser_beam_activate":
				return {}
			return {"profile": "laser_beam_activate", "semantic": "hold_beam", "projectile_damage_type": "laser", "projectile_style": "beam", "projectile_behavior": "laser", "travel_path": "instant_line", "default_width": STANDARD_LASER_WIDTH_M, "default_range": STANDARD_LASER_RANGE_M, "default_fire_interval": STANDARD_LASER_FIRE_INTERVAL}
		"missile_launcher":
			if profile != "missile_lock_activate":
				return {}
			return {"profile": "missile_lock_activate", "semantic": "release_missile_lock", "projectile_damage_type": "bullet", "projectile_style": "missile", "projectile_behavior": "explosive", "travel_path": "homing", "default_width": STANDARD_MISSILE_WIDTH_M, "default_range": STANDARD_MISSILE_RANGE_M, "default_fire_interval": 9999.0}
		"web_gun":
			if profile != "web_tether_activate":
				return {}
			return {"profile": "web_tether_activate", "semantic": "release_web", "projectile_damage_type": "blunt", "projectile_style": "web", "projectile_behavior": "web_tether", "travel_path": "tether", "default_width": STANDARD_WEB_TETHER_WIDTH_M, "default_range": STANDARD_WEB_TETHER_RANGE_M, "default_fire_interval": 9999.0}
	return {}


func _gun_activation_profile_supports_kind(profile: String, gun_kind: String, ammo_kind: String = "") -> bool:
	if action_profile_registry != null:
		if not action_profile_registry.module_supports_gun(profile, gun_kind, ammo_kind):
			return false
	elif not ActionProfileRegistry.new().module_supports_gun(profile, gun_kind, ammo_kind):
		return false
	var spec := _gun_activation_spec(gun_kind, profile)
	if spec.is_empty():
		return false
	if profile == "laser_beam_activate":
		return gun_kind == "laser_gun" and ammo_kind == "laser"
	if profile == "rifle_burst_activate":
		return gun_kind == "rifle" and ammo_kind == "bullet"
	if profile == "grenade_arc_activate":
		return gun_kind == "grenade_launcher" and ammo_kind == "explosive"
	if profile == "web_tether_activate":
		return gun_kind == "web_gun" and ammo_kind == "web"
	if profile == "missile_lock_activate":
		return gun_kind == "missile_launcher" and ammo_kind == "explosive"
	return true


func _gun_activate_supports_kind(gun_kind: String) -> bool:
	return _gun_activation_profile_supports_kind("gun_activate", gun_kind)


func _runtime_gun_activation_active(player_id: int) -> bool:
	return gun_activation_state.has(player_id) and gun_activation_state[player_id] is Dictionary and not Dictionary(gun_activation_state[player_id]).is_empty()


func _binding_drive_allocation_for_node(binding: Dictionary, node_index: int, fallback: float = 0.0) -> float:
	var by_node = binding.get("joint_drive_allocation_by_node", {})
	if not (by_node is Dictionary) or Dictionary(by_node).is_empty():
		by_node = binding.get("allocated_limb_momentum_by_node", {})
	if by_node is Dictionary:
		var node_key := str(node_index)
		if Dictionary(by_node).has(node_key):
			return maxf(0.0, float(Dictionary(by_node).get(node_key, fallback)))
		if Dictionary(by_node).has(node_index):
			return maxf(0.0, float(Dictionary(by_node).get(node_index, fallback)))
	var target_count := maxi(1, Array(binding.get("target_nodes", [])).size())
	if binding.has("joint_drive_allocation_total"):
		return maxf(0.0, float(binding.get("joint_drive_allocation_total", 0.0)) / float(target_count))
	if binding.has("allocated_limb_momentum"):
		return maxf(0.0, float(binding.get("allocated_limb_momentum", 0.0)) / float(target_count))
	return maxf(0.0, fallback)


func _gun_drive_info_for_binding(unit, binding: Dictionary, node_index: int) -> Dictionary:
	var segment := _runtime_gun_segment_for_binding(unit, binding)
	var min_momentum := maxf(0.0, float(segment.get("momentum_min", 0.0)))
	var max_momentum := maxf(min_momentum, float(segment.get("momentum_max", min_momentum)))
	var fallback := maxf(0.0, float(segment.get("allocated_limb_momentum", segment.get("joint_output_momentum_base", 0.0))))
	var allocated := clampf(_binding_drive_allocation_for_node(binding, node_index, fallback), min_momentum, max_momentum if max_momentum > min_momentum else maxf(min_momentum, fallback))
	var ratio := allocated / maxf(1.0, min_momentum)
	var ratio_to_max := allocated / maxf(1.0, max_momentum)
	return {
		"allocated": allocated,
		"min": min_momentum,
		"max": max_momentum,
		"ratio": ratio,
		"ratio_to_max": ratio_to_max,
	}


func _gun_drive_aim_speed_mult(gun_drive_ratio: float) -> float:
	if gun_drive_ratio < 1.0:
		return clampf(0.45 + gun_drive_ratio * 0.55, 0.28, 1.0)
	return clampf(1.0 + sqrt(maxf(0.0, gun_drive_ratio - 1.0)) * 0.26, 1.0, 1.45)


func _gun_drive_projectile_momentum_mult(gun_drive_ratio: float) -> float:
	return 1.0


func _projectile_drive_momentum_mult_for_event(event: Dictionary) -> float:
	if not event.has("gun_drive_ratio"):
		return 1.0
	return _gun_drive_projectile_momentum_mult(float(event.get("gun_drive_ratio", 1.0)))


func _sync_projectile_drive_momentum_fields(event: Dictionary) -> void:
	if not bool(event.get("projectile", false)):
		return
	var base_momentum := maxf(0.0, float(event.get("projectile_base_momentum", event.get("projectile_momentum", 0.0))))
	var drive_mult := _projectile_drive_momentum_mult_for_event(event)
	event["projectile_base_momentum"] = base_momentum
	event["projectile_drive_momentum_mult"] = drive_mult
	event["projectile_effective_momentum"] = base_momentum * drive_mult


func _runtime_gun_segment_for_binding(unit, binding: Dictionary) -> Dictionary:
	var source := _runtime_gun_source_for_binding(unit, binding)
	return source.get("segment", {}) if source.get("segment", {}) is Dictionary else {}


func _runtime_gun_source_for_binding(unit, binding: Dictionary) -> Dictionary:
	if not _is_live_unit(unit) or not unit.has_method("runtime_world_segment_for_node"):
		return {}
	var target_nodes: Array = []
	for raw_node in Array(binding.get("target_nodes", [])):
		target_nodes.append(int(raw_node))
	if target_nodes.is_empty():
		return {}
	var node_index := int(target_nodes[target_nodes.size() - 1])
	var segment: Dictionary = unit.runtime_world_segment_for_node(node_index, true)
	if segment.is_empty():
		return {}
	var group: Dictionary = unit.runtime_group_for_node(node_index) if unit.has_method("runtime_group_for_node") else {}
	var terminal_kind := String(segment.get("terminal_weapon_kind", group.get("terminal_weapon_kind", ""))).to_lower()
	var material_class := String(group.get("material_class", segment.get("material_class", ""))).to_lower()
	var is_gun := terminal_kind == "ranged" or bool(segment.get("projectile", false)) or bool(group.get("projectile", false)) or material_class in ["gun", "missile_launcher", "web_gun"]
	if not is_gun:
		return {}
	var root: Vector2 = segment.get("a", Vector2(unit.ring_pos, unit.lane))
	var muzzle: Vector2 = segment.get("b", root)
	var direction := muzzle - root
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(unit)
	return {
		"source_gun_node": node_index,
		"source_node_index": node_index,
		"runtime_target_nodes": target_nodes.duplicate(true),
		"segment": segment.duplicate(true),
		"group": group.duplicate(true),
		"muzzle_combat_position": muzzle,
		"muzzle_direction": direction.normalized(),
	}


func _runtime_gun_group_for_binding(unit, binding: Dictionary) -> Dictionary:
	if not _is_live_unit(unit) or not unit.has_method("runtime_group_for_node"):
		return {}
	var source := _runtime_gun_source_for_binding(unit, binding)
	if source.is_empty():
		return {}
	var node_index := int(source.get("source_gun_node", -1))
	var group: Dictionary = source.get("group", {}) if source.get("group", {}) is Dictionary else unit.runtime_group_for_node(node_index)
	var drive_info := _gun_drive_info_for_binding(unit, binding, node_index)
	group["gun_drive_allocated"] = float(drive_info.get("allocated", 0.0))
	group["gun_drive_min"] = float(drive_info.get("min", 0.0))
	group["gun_drive_max"] = float(drive_info.get("max", 0.0))
	group["gun_drive_ratio"] = float(drive_info.get("ratio", 0.0))
	group["gun_drive_ratio_to_max"] = float(drive_info.get("ratio_to_max", 0.0))
	group["gun_projectile_damage_mult"] = _gun_projectile_damage_mult_max_for_data(group)
	group["gun_projectile_damage_mult_current"] = _gun_projectile_damage_mult_for_event(group)
	group["projectile"] = true
	group["projectile_only"] = true
	var material_class := String(group.get("material_class", "")).to_lower()
	if material_class == "" or not (material_class in ["gun", "missile_launcher", "web_gun"]):
		group["material_class"] = "gun"
	if String(group.get("shape", "")).to_lower() == "":
		group["shape"] = "rifle"
	return group


func _runtime_gun_activation_direction(unit, binding: Dictionary) -> Vector2:
	var segment := _runtime_gun_segment_for_binding(unit, binding)
	if segment.is_empty():
		return _unit_forward_vector(unit)
	var a: Vector2 = segment.get("a", Vector2(unit.ring_pos, unit.lane))
	var b: Vector2 = segment.get("b", a)
	var direction := b - a
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(unit)
	return direction.normalized()


func _rotate_direction_toward(current_direction: Vector2, target_direction: Vector2, max_angle_delta: float) -> Vector2:
	var current := current_direction.normalized() if current_direction.length() > 0.01 else Vector2.RIGHT
	var target := target_direction.normalized() if target_direction.length() > 0.01 else current
	var delta := wrapf(target.angle() - current.angle(), -PI, PI)
	var step := clampf(delta, -absf(max_angle_delta), absf(max_angle_delta))
	return current.rotated(step).normalized()


func _gun_activation_local_turn_sign(unit, input_vector: Vector2) -> int:
	if input_vector.length() <= 0.18:
		return 0
	if absf(input_vector.x) < 0.18:
		return 0
	return -1 if input_vector.x < 0.0 else 1


func _gun_activation_rotated_direction(unit, current_direction: Vector2, input_vector: Vector2, rotate_speed: float, delta: float) -> Vector2:
	var current := current_direction.normalized() if current_direction.length() > 0.01 else _unit_forward_vector(unit)
	var turn_sign := _gun_activation_local_turn_sign(unit, input_vector)
	if turn_sign == 0:
		return current
	var step := float(turn_sign) * maxf(0.0, rotate_speed) * maxf(0.0, delta)
	return current.rotated(step).normalized()


func _runtime_gun_activation_event_for(player_id: int) -> Dictionary:
	if not _runtime_gun_activation_active(player_id):
		return {}
	var state: Dictionary = gun_activation_state[player_id]
	var unit = active_units[player_id]["hero"]
	if not _is_live_unit(unit):
		return {}
	var binding: Dictionary = state.get("binding", {}) if state.get("binding", {}) is Dictionary else {}
	if binding.is_empty():
		return {}
	var group := _runtime_gun_group_for_binding(unit, binding)
	if group.is_empty():
		return {}
	var direction := Vector2.ZERO
	if state.get("aim_direction", Vector2.ZERO) is Vector2:
		direction = state.get("aim_direction", Vector2.ZERO)
	if direction.length() <= 0.01:
		direction = _runtime_gun_activation_direction(unit, binding)
	direction = direction.normalized() if direction.length() > 0.01 else _unit_forward_vector(unit)
	var target_nodes: Array = Array(binding.get("target_nodes", []))
	var node_index := int(target_nodes[target_nodes.size() - 1]) if not target_nodes.is_empty() else int(binding.get("attack_key", 1)) - 1
	if unit.has_method("set_aim_pose"):
		unit.set_aim_pose(node_index, direction, 0.16)
	var gun_source := _runtime_gun_source_for_binding(unit, binding)
	if gun_source.is_empty():
		return {}
	target_nodes = Array(gun_source.get("runtime_target_nodes", target_nodes)).duplicate(true)
	node_index = int(gun_source.get("source_gun_node", node_index))
	var gun_kind := String(group.get("gun_kind", _gun_kind_for_data(group)))
	var ammo_kind := String(group.get("ammo_kind", _ammo_kind_for_data(group)))
	var profile := _runtime_binding_profile(binding)
	var effective_profile := _effective_gun_activation_profile(profile, gun_kind, ammo_kind)
	if effective_profile == "":
		return {}
	var module_part: Dictionary = binding.get("module_part", {}) if binding.get("module_part", {}) is Dictionary else {}
	var spec := _gun_activation_spec(gun_kind, effective_profile)
	if spec.is_empty():
		return {}
	var projectile_damage_type := String(spec.get("projectile_damage_type", group.get("projectile_damage_type", group.get("damage_type", "bullet"))))
	var projectile_style := String(spec.get("projectile_style", group.get("projectile_style", "true_bullet")))
	var projectile_behavior := String(spec.get("projectile_behavior", group.get("projectile_behavior", projectile_style)))
	var default_width := float(spec.get("default_width", STANDARD_SNIPER_PROJECTILE_WIDTH_M))
	var event := _true_bullet_event_for_aim(unit, direction, group, node_index, {
		"runtime_target_nodes": target_nodes.duplicate(true),
		"source_gun_node": node_index,
		"source_node_index": node_index,
		"muzzle_combat_position": gun_source.get("muzzle_combat_position", Vector2(unit.ring_pos, unit.lane)),
		"muzzle_direction": gun_source.get("muzzle_direction", direction),
		"attack_key": int(binding.get("attack_key", 1)),
		"module_action_profile": profile,
		"effective_gun_activation_profile": effective_profile,
		"gun_activation": true,
		"gun_kind": gun_kind,
		"ammo_kind": ammo_kind,
	})
	_copy_module_variant_fields(event, module_part)
	event["gun_kind"] = gun_kind
	event["ammo_kind"] = ammo_kind
	event["projectile_momentum"] = maxf(float(group.get("projectile_momentum", 0.0)), float(event.get("projectile_momentum", 0.0)))
	if float(event.get("projectile_momentum", 0.0)) <= 0.0:
		event["projectile_momentum"] = maxf(1.0, float(group.get("normal_damage", 8.0)) * 3.5)
	event["projectile_damage_type"] = projectile_damage_type
	event["damage_type"] = String(event.get("projectile_damage_type", "bullet"))
	event["projectile_style"] = projectile_style
	event["projectile_behavior"] = projectile_behavior
	event["travel_path"] = String(spec.get("travel_path", group.get("travel_path", "instant_line")))
	event["projectile_width_m"] = float(group.get("projectile_width_m", default_width))
	event["projectile_break_coeff"] = float(group.get("projectile_break_coeff", 0.0))
	event["projectile_consumes_on_fire"] = bool(group.get("projectile_consumes_on_fire", true))
	event["gun_drive_allocated"] = float(group.get("gun_drive_allocated", 0.0))
	event["gun_drive_min"] = float(group.get("gun_drive_min", 0.0))
	event["gun_drive_max"] = float(group.get("gun_drive_max", 0.0))
	event["gun_drive_ratio"] = float(group.get("gun_drive_ratio", 1.0))
	event["gun_drive_ratio_to_max"] = float(group.get("gun_drive_ratio_to_max", 1.0))
	event["gun_projectile_damage_mult"] = _gun_projectile_damage_mult_max_for_data(group)
	event["gun_projectile_damage_mult_current"] = _gun_projectile_damage_mult_for_event(event)
	event["normal_heat"] = float(group.get("normal_heat", 0.0))
	event["sniper_fire_delay"] = float(group.get("sniper_fire_delay", group.get("bullet_lock_time", TRUE_BULLET_DEFAULT_LOCK_SECONDS)))
	event["bullet_lock_time"] = event["sniper_fire_delay"]
	event["fire_interval"] = maxf(0.04, float(group.get("laser_tick_interval", group.get("fire_interval", spec.get("default_fire_interval", 0.24)))))
	match String(spec.get("semantic", "")):
		"hold_stream":
			event["range"] = maxf(0.1, float(group.get("projectile_range", group.get("range", spec.get("default_range", STANDARD_CHEMICAL_SPRAYER_RANGE_M)))))
			event["lane_range"] = maxf(0.01, float(event.get("projectile_width_m", default_width)) * 0.5)
			event["chemical_dot_duration"] = float(group.get("chemical_dot_duration", STANDARD_CHEMICAL_SPRAYER_DOT_SECONDS))
			event["chemical_dot_mult"] = float(group.get("chemical_dot_mult", 1.0))
			event["chemical_frontload"] = float(group.get("chemical_frontload", 1.0 / 3.0))
			event["chemical_dot_tick_seconds"] = float(group.get("chemical_dot_tick_seconds", STANDARD_CHEMICAL_SPRAYER_TICK_SECONDS))
			event["chemical_dot_no_stack"] = bool(group.get("chemical_dot_no_stack", true))
			event["projectile_speed_mult"] = float(group.get("projectile_speed_mult", CHEMICAL_PROJECTILE_DEFAULT_SPEED_MULT))
		"hold_beam":
			event["range"] = maxf(float(group.get("projectile_range", STANDARD_LASER_RANGE_M)), _laser_visible_world_range(unit, direction))
			event["lane_range"] = maxf(0.01, float(event.get("projectile_width_m", STANDARD_LASER_WIDTH_M)) * 0.5)
			event["laser_telegraph_ready"] = true
			event["laser_charge_time"] = float(group.get("laser_charge_time", 0.0))
		"hold_burst":
			event["range"] = maxf(0.1, float(group.get("projectile_range", group.get("range", 2.8))))
			event["lane_range"] = maxf(0.01, float(event.get("projectile_width_m", default_width)) * 0.5)
			event["projectile_speed_mult"] = float(group.get("projectile_speed_mult", BULLET_HELL_DEFAULT_SPEED_MULT))
		"hold_grenade_arc":
			event["range"] = maxf(0.1, float(group.get("projectile_range", group.get("range", spec.get("default_range", 2.65)))))
			if String(event.get("module_variant_key", "")) == "explosive_arc_salvo":
				var hold_seconds := maxf(0.05, float(event.get("salvo_hold_range_seconds", 0.75)))
				var hold_t := clampf(float(state.get("hold_time", 0.0)) / hold_seconds, 0.0, 1.0)
				var min_range := maxf(0.1, float(event.get("salvo_arc_min_range", 1.35)))
				var max_range := maxf(min_range, float(event.get("salvo_arc_max_range", 3.8)))
				event["range"] = lerpf(min_range, max_range, hold_t)
				event["salvo_hold_ratio"] = hold_t
				event["salvo_landing_marker"] = true
				event["salvo_landing_distance"] = float(event["range"])
			event["lane_range"] = maxf(0.01, float(event.get("projectile_width_m", default_width)) * 0.5)
			event["projectile_speed_mult"] = float(group.get("projectile_speed_mult", 1.35))
			event["projectile_momentum"] = maxf(float(group.get("projectile_momentum", 72.0)), float(event.get("projectile_momentum", 0.0)))
			event["explosion_radius"] = maxf(0.01, float(group.get("explosion_radius", 0.56)))
			event["explosion_style"] = String(group.get("explosion_style", "grenade"))
		"release_web":
			event["range"] = maxf(0.1, float(group.get("projectile_range", group.get("range", spec.get("default_range", STANDARD_WEB_TETHER_RANGE_M)))))
			event["lane_range"] = maxf(0.01, float(event.get("projectile_width_m", default_width)) * 0.5)
			event["non_damage"] = true
			event["web_strength"] = maxf(0.01, float(group.get("web_strength", STANDARD_WEB_TETHER_STRENGTH)))
			event["web_break_force"] = maxf(0.08, float(group.get("web_break_force", STANDARD_WEB_TETHER_BREAK_FORCE)))
			event["web_duration"] = maxf(0.1, float(group.get("web_duration", STANDARD_WEB_TETHER_DURATION)))
			event["web_pull_mode"] = String(group.get("web_pull_mode", "mass_duel"))
			event["web_target_filter"] = String(group.get("web_target_filter", "all"))
			event["web_anchor_swing"] = bool(group.get("web_anchor_swing", true))
			event["web_swing_uses_melee_collision"] = bool(group.get("web_swing_uses_melee_collision", true))
		"release_missile_lock":
			event["range"] = maxf(0.1, float(group.get("projectile_range", group.get("range", spec.get("default_range", STANDARD_MISSILE_RANGE_M)))))
			event["lane_range"] = maxf(0.01, float(event.get("projectile_width_m", default_width)) * 0.5)
			event["projectile_speed_mult"] = float(group.get("projectile_speed_mult", STANDARD_MISSILE_SPEED_MULT))
			event["projectile_momentum"] = maxf(float(group.get("projectile_momentum", STANDARD_MISSILE_PROJECTILE_MOMENTUM)), float(event.get("projectile_momentum", 0.0)))
			event["explosion_radius"] = maxf(0.01, float(group.get("explosion_radius", STANDARD_MISSILE_EXPLOSION_RADIUS)))
			event["explosion_style"] = String(group.get("explosion_style", "missile"))
			event["missile_lock_priority"] = String(module_part.get("missile_lock_priority", group.get("missile_lock_priority", "screen_hero_first")))
			event["missile_lock_cone_degrees"] = float(module_part.get("missile_lock_cone_degrees", group.get("missile_lock_cone_degrees", 52.0)))
			event["missile_lock_range"] = maxf(0.1, float(group.get("missile_lock_range", event.get("range", STANDARD_MISSILE_RANGE_M))))
			event["missile_lock_target_classes"] = Array(group.get("missile_lock_target_classes", ["hero", "puppet", "barrier_support", "barrier_attack", "barrier_other"])).duplicate(true)
			event["missile_occlusion_grace"] = maxf(0.0, float(module_part.get("missile_occlusion_grace", group.get("missile_occlusion_grace", STANDARD_MISSILE_OCCLUSION_GRACE))))
		_:
			event["range"] = maxf(float(group.get("projectile_range", 0.0)), _laser_visible_world_range(unit, direction))
			event["lane_range"] = maxf(STANDARD_SNIPER_PROJECTILE_WIDTH_M * 0.5, float(event.get("projectile_width_m", STANDARD_SNIPER_PROJECTILE_WIDTH_M)) * 0.5)
	_sync_projectile_drive_momentum_fields(event)
	return event


func _start_runtime_gun_activation(player_id: int, prefix: String, attack_index: int, action_name: String, binding: Dictionary) -> void:
	var unit = active_units[player_id]["hero"]
	if not _is_live_unit(unit):
		return
	var segment := _runtime_gun_segment_for_binding(unit, binding)
	if segment.is_empty() or String(segment.get("terminal_weapon_kind", "")) != "ranged" or not bool(segment.get("projectile", false)):
		_play_module_fail_sfx()
		_show_battle_message("枪械启动需要绑定枪械末端肌肉" if _ui_is_zh() else "Gun Activate needs a gun terminal muscle", 0.62)
		return
	var group := _runtime_gun_group_for_binding(unit, binding)
	var gun_kind := String(group.get("gun_kind", _gun_kind_for_data(group)))
	var profile := _runtime_binding_profile(binding)
	var ammo_kind := String(group.get("ammo_kind", _ammo_kind_for_data(group)))
	var effective_profile := _effective_gun_activation_profile(profile, gun_kind, ammo_kind)
	var spec := _gun_activation_spec(gun_kind, effective_profile)
	if effective_profile == "" or spec.is_empty() or not _gun_activation_profile_supports_kind(profile, gun_kind, ammo_kind):
		_show_battle_message("该行动模块不支持此枪械类型" if _ui_is_zh() else "This module does not support that gun kind", 0.55)
		return
	var module_part: Dictionary = binding.get("module_part", {}) if binding.get("module_part", {}) is Dictionary else {}
	var rotate_speed := float(module_part.get("gun_rotate_speed", 0.0))
	if rotate_speed <= 0.0:
		rotate_speed = _unit2_turn_speed_reference()
	rotate_speed *= _gun_drive_aim_speed_mult(float(group.get("gun_drive_ratio", 1.0)))
	var aim_direction := _runtime_gun_activation_direction(unit, binding)
	gun_activation_state[player_id] = {
		"prefix": prefix,
		"attack_index": attack_index,
		"action_name": action_name,
		"binding": binding.duplicate(true),
		"locked_target": null,
		"locked_direction": Vector2.ZERO,
		"aim_direction": aim_direction,
		"gun_rotate_speed": rotate_speed,
		"gun_kind": gun_kind,
		"effective_gun_activation_profile": effective_profile,
		"activation_semantic": String(spec.get("semantic", "")),
		"fire_timer": 0.0,
		"hold_time": 0.0,
	}
	_clear_attack_command_windows(player_id)
	match String(spec.get("semantic", "")):
		"hold_stream":
			_show_battle_message("P%d 枪械启动：化学喷射" % player_id if _ui_is_zh() else "P%d Gun Activate: chemical spray" % player_id, 0.45)
		"hold_beam":
			_show_battle_message("P%d 棱镜照射：激光" % player_id if _ui_is_zh() else "P%d Prism Beam: laser" % player_id, 0.45)
		"hold_burst":
			_show_battle_message("P%d 来复枪点射" % player_id if _ui_is_zh() else "P%d Rifle burst" % player_id, 0.45)
		"hold_grenade_arc":
			_show_battle_message("P%d 榴弹弧射" % player_id if _ui_is_zh() else "P%d Grenade arc" % player_id, 0.45)
		"release_web":
			_show_battle_message("P%d 蛛丝牵引准备" % player_id if _ui_is_zh() else "P%d Web tether ready" % player_id, 0.45)
		"release_missile_lock":
			_show_battle_message("P%d 猎隼锁射准备" % player_id if _ui_is_zh() else "P%d Kestrel missile lock ready" % player_id, 0.45)
		_:
			_show_battle_message("P%d 枪械启动：狙击瞄准" % player_id if _ui_is_zh() else "P%d Gun Activate: sniper aim" % player_id, 0.45)


func _runtime_gun_activation_fire_once(unit, event: Dictionary) -> bool:
	var ammo_kind := String(event.get("ammo_kind", _ammo_type_for_event(event)))
	if ammo_kind != "" and _ammo_capacity_for(unit, ammo_kind) > 0 and _current_ammo(unit, ammo_kind) <= 0:
		_show_battle_message("%s %s AMMO EMPTY" % [unit.unit_name, ammo_kind.to_upper()], 0.62)
		return false
	_resolve_attack(unit, event)
	if unit != null and is_instance_valid(unit) and event.has("normal_heat"):
		_add_unit_heat(unit, float(event.get("normal_heat", 0.0)), _heat_reason_for_projectile_event(event))
	return true


func _salvo_preview_points(unit, event: Dictionary) -> Dictionary:
	if not _is_live_unit(unit) or event.is_empty():
		return {}
	var collider: Dictionary = _attack_collider_for_event(unit, event)
	var start_combat: Vector2 = collider.get("a", _unit_combat_coord(unit)) if not collider.is_empty() else _unit_combat_coord(unit)
	var direction := Vector2(event.get("direction", _unit_forward_vector(unit)))
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(unit)
	direction = direction.normalized()
	var range_m := maxf(0.2, float(event.get("salvo_landing_distance", event.get("range", 1.5))))
	var start_screen: Vector2 = _project_combat_coord_to_screen(start_combat)["position"]
	var landing_screen: Vector2 = _gameplay_ray_screen_end(start_screen, direction, range_m, 92.0)
	return {"start": start_screen, "landing": landing_screen}


func _update_salvo_landing_preview(player_id: int, unit, event: Dictionary) -> void:
	if effects_root == null or not bool(event.get("salvo_landing_marker", false)):
		return
	var points := _salvo_preview_points(unit, event)
	if points.is_empty():
		return
	var effect: SalvoLandingPreviewEffect = null
	if salvo_landing_preview_effects.has(player_id):
		var existing = salvo_landing_preview_effects[player_id]
		if existing != null and is_instance_valid(existing) and existing is SalvoLandingPreviewEffect:
			effect = existing
	if effect == null:
		effect = SalvoLandingPreviewEffect.new()
		effects_root.add_child(effect)
		salvo_landing_preview_effects[player_id] = effect
	effect.refresh(points["start"], points["landing"], float(event.get("salvo_hold_ratio", 0.0)))


func _clear_salvo_landing_preview(player_id: int) -> void:
	if not salvo_landing_preview_effects.has(player_id):
		return
	var existing = salvo_landing_preview_effects[player_id]
	if existing != null and is_instance_valid(existing):
		existing.queue_free()
	salvo_landing_preview_effects.erase(player_id)


func _tick_runtime_gun_activation(player_id: int, prefix: String, delta: float) -> void:
	if not _runtime_gun_activation_active(player_id):
		return
	var state: Dictionary = gun_activation_state[player_id]
	var action_name := String(state.get("action_name", ""))
	if action_name == "" or Input.is_action_just_released(action_name) or not Input.is_action_pressed(action_name):
		_release_runtime_gun_activation(player_id)
		return
	var unit = active_units[player_id]["hero"]
	if not _is_live_unit(unit):
		gun_activation_state[player_id] = {}
		_clear_salvo_landing_preview(player_id)
		return
	state["hold_time"] = float(state.get("hold_time", 0.0)) + delta
	var binding: Dictionary = state.get("binding", {}) if state.get("binding", {}) is Dictionary else {}
	var current_direction := _runtime_gun_activation_direction(unit, binding)
	if state.get("aim_direction", Vector2.ZERO) is Vector2:
		current_direction = state.get("aim_direction", Vector2.ZERO)
	var turn_input_vector := _gun_turn_input_vector_for(prefix)
	var rotate_speed := float(state.get("gun_rotate_speed", _unit2_turn_speed_reference()))
	state["aim_direction"] = _gun_activation_rotated_direction(unit, current_direction, turn_input_vector, rotate_speed, delta)
	var event := _runtime_gun_activation_event_for(player_id)
	if event.is_empty():
		_clear_salvo_landing_preview(player_id)
		_clear_runtime_gun_pose_for_payload(unit, state)
		gun_activation_state[player_id] = state
		return
	var semantic := String(state.get("activation_semantic", ""))
	if semantic == "hold_grenade_arc" and String(event.get("module_variant_key", "")) == "explosive_arc_salvo":
		_update_salvo_landing_preview(player_id, unit, event)
		gun_activation_state[player_id] = state
		if unit.has_method("set_aim_pose"):
			unit.set_aim_pose(_projectile_source_node_for_event(event), Vector2(event.get("direction", _unit_forward_vector(unit))), 0.1)
		return
	if semantic in ["hold_stream", "hold_beam", "hold_burst", "hold_grenade_arc"]:
		var fire_timer := float(state.get("fire_timer", 0.0)) - delta
		if fire_timer <= 0.0:
			if not _runtime_gun_activation_fire_once(unit, event):
				_clear_runtime_gun_pose_for_payload(unit, event)
				gun_activation_state[player_id] = {}
				return
			fire_timer = maxf(0.05, float(event.get("fire_interval", 0.24)))
		state["fire_timer"] = fire_timer
		gun_activation_state[player_id] = state
		if unit.has_method("set_aim_pose"):
			unit.set_aim_pose(_projectile_source_node_for_event(event), Vector2(event.get("direction", _unit_forward_vector(unit))), 0.1)
		return
	if semantic == "release_web":
		gun_activation_state[player_id] = state
		if unit.has_method("set_aim_pose"):
			unit.set_aim_pose(_projectile_source_node_for_event(event), Vector2(event.get("direction", _unit_forward_vector(unit))), 0.1)
		return
	if semantic == "release_missile_lock":
		var missile_target = _acquire_missile_lock_target(unit, event)
		state["locked_target"] = missile_target
		state["locked_direction"] = _missile_direction_to_target(unit, missile_target, Vector2(event.get("direction", _unit_forward_vector(unit)))) if _is_live_unit(missile_target) else Vector2(event.get("direction", _unit_forward_vector(unit)))
		gun_activation_state[player_id] = state
		if unit.has_method("set_aim_pose"):
			unit.set_aim_pose(_projectile_source_node_for_event(event), Vector2(event.get("direction", _unit_forward_vector(unit))), 0.1)
		return
	if semantic != "release_lock":
		gun_activation_state[player_id] = {}
		return
	var target = _acquire_true_bullet_target(unit, event)
	state["locked_target"] = target
	state["locked_direction"] = _true_bullet_direction_to_target(unit, target) if _is_live_unit(target) else Vector2(event.get("direction", _unit_forward_vector(unit)))
	gun_activation_state[player_id] = state
	if unit.has_method("set_aim_pose"):
		unit.set_aim_pose(_projectile_source_node_for_event(event), Vector2(event.get("direction", _unit_forward_vector(unit))), 0.1)


func _release_runtime_gun_activation(player_id: int) -> void:
	if not _runtime_gun_activation_active(player_id):
		return
	var state: Dictionary = gun_activation_state[player_id]
	var unit = active_units[player_id]["hero"]
	if not _is_live_unit(unit):
		gun_activation_state[player_id] = {}
		_clear_salvo_landing_preview(player_id)
		return
	var event := _runtime_gun_activation_event_for(player_id)
	gun_activation_state[player_id] = {}
	_clear_salvo_landing_preview(player_id)
	if event.is_empty():
		_clear_runtime_gun_pose_for_payload(unit, state)
		return
	if String(state.get("activation_semantic", "")) == "hold_grenade_arc" and String(event.get("module_variant_key", "")) == "explosive_arc_salvo":
		event["salvo_release_fire"] = true
		_runtime_gun_activation_fire_once(unit, event)
		_clear_runtime_gun_pose_for_payload(unit, event)
		return
	if String(state.get("activation_semantic", "")) == "release_web":
		_fire_runtime_web_tether(unit, event)
		_clear_runtime_gun_pose_for_payload(unit, event)
		return
	if String(state.get("activation_semantic", "")) == "release_missile_lock":
		var missile_target = state.get("locked_target", null)
		if not _is_live_unit(missile_target):
			missile_target = _acquire_missile_lock_target(unit, event)
		if not _is_live_unit(missile_target):
			_show_battle_message("%s MISSILE: no lock" % String(unit.unit_name), 0.52)
			_clear_runtime_gun_pose_for_payload(unit, event)
			return
		event["locked_target"] = missile_target
		event["aim_locked"] = true
		event["direction"] = _missile_direction_to_target(unit, missile_target, Vector2(event.get("direction", _unit_forward_vector(unit))))
		_runtime_gun_activation_fire_once(unit, event)
		_clear_runtime_gun_pose_for_payload(unit, event)
		return
	if String(state.get("activation_semantic", "")) != "release_lock":
		_clear_runtime_gun_pose_for_payload(unit, event)
		return
	var target = state.get("locked_target", null)
	if not _is_live_unit(target):
		_clear_runtime_gun_pose_for_payload(unit, event)
		return
	event["locked_target"] = target
	event["aim_locked"] = true
	event["direction"] = _true_bullet_direction_to_target(unit, target)
	event["bullet_lock_time"] = float(event.get("sniper_fire_delay", event.get("bullet_lock_time", TRUE_BULLET_DEFAULT_LOCK_SECONDS)))
	_queue_true_bullet_lock(unit, event)


func _ensure_attack_command_windows(player_id: int) -> Dictionary:
	if not attack_command_windows.has(player_id) or not (attack_command_windows[player_id] is Dictionary):
		attack_command_windows[player_id] = {}
	return attack_command_windows[player_id]


func _attack_windows_any_open(player_id: int) -> bool:
	return not _ensure_attack_command_windows(player_id).is_empty()


func _attack_window_key(attack_index: int) -> String:
	return str(clampi(attack_index, 0, ATTACK_GROUP_COUNT - 1))


func _open_attack_command_window(player_id: int, prefix: String, attack_index: int, binding: Dictionary) -> void:
	var windows := _ensure_attack_command_windows(player_id)
	var now := Time.get_ticks_msec() * 0.001
	windows[_attack_window_key(attack_index)] = {
		"attack_index": attack_index,
		"attack_key": attack_index + 1,
		"prefix": prefix,
		"binding": binding.duplicate(true),
		"opened_at": now,
		"timer": ATTACK_WINDOW_TIMEOUT,
		"hold_time": 0.0,
	}
	attack_command_windows[player_id] = windows
	_show_battle_message("P%d 攻击%d 输入窗口" % [player_id, attack_index + 1] if _ui_is_zh() else "P%d attack %d window" % [player_id, attack_index + 1], 0.45)


func _close_attack_command_window(player_id: int, attack_index: int) -> void:
	var windows := _ensure_attack_command_windows(player_id)
	windows.erase(_attack_window_key(attack_index))
	attack_command_windows[player_id] = windows


func _clear_attack_command_windows(player_id: int) -> void:
	attack_command_windows[player_id] = {}


func _tick_attack_command_windows(player_id: int, prefix: String, delta: float) -> void:
	var windows := _ensure_attack_command_windows(player_id)
	if windows.is_empty():
		return
	var changed := false
	for raw_key in windows.keys():
		var key := String(raw_key)
		var window: Dictionary = windows[key]
		var attack_index := int(window.get("attack_index", key.to_int()))
		var action_name := "%s_attack_%d" % [prefix, attack_index + 1]
		window["timer"] = float(window.get("timer", ATTACK_WINDOW_TIMEOUT)) - delta
		if Input.is_action_pressed(action_name):
			window["hold_time"] = float(window.get("hold_time", 0.0)) + delta
		else:
			window["hold_time"] = 0.0
		if float(window.get("hold_time", 0.0)) >= ATTACK_WINDOW_HOLD_CANCEL:
			windows.erase(key)
			changed = true
			_show_battle_message("P%d 攻击%d 窗口取消" % [player_id, attack_index + 1] if _ui_is_zh() else "P%d attack %d window canceled" % [player_id, attack_index + 1], 0.35)
			continue
		if float(window.get("timer", 0.0)) <= 0.0:
			windows.erase(key)
			changed = true
			continue
		windows[key] = window
	if changed:
		attack_command_windows[player_id] = windows


func _battle_direction_just_pressed(prefix: String) -> bool:
	return Input.is_action_just_pressed("%s_left" % prefix) or Input.is_action_just_pressed("%s_right" % prefix) or Input.is_action_just_pressed("%s_up" % prefix) or Input.is_action_just_pressed("%s_down" % prefix)


func _attack_window_state_from_direction(hero, input_vector: Vector2) -> String:
	if input_vector.length() < 0.18:
		return ""
	var forward := _unit_forward_vector(hero)
	if forward.length() < 0.01:
		return ""
	var dot := input_vector.normalized().dot(forward.normalized())
	if dot >= 0.38:
		return "armor"
	if dot <= -0.38:
		return "active"
	return ""


func _attack_window_state_for_binding(hero, binding: Dictionary, input_vector: Vector2) -> String:
	if input_vector.length() < 0.18:
		return ""
	var module_part: Dictionary = binding.get("module_part", {}) if binding.get("module_part", {}) is Dictionary else {}
	var profile := String(binding.get("command_window_profile", module_part.get("command_window_profile", "")))
	if profile not in ["two_link_4_6", "blade_simple_4_6", "blunt_terminal_4_6_236_214"]:
		return ""
	var forward := _unit_forward_vector(hero)
	if forward.length() < 0.01:
		return ""
	var dot := input_vector.normalized().dot(forward.normalized())
	if dot >= 0.38:
		return "armor"
	if dot <= -0.38:
		return "active"
	return ""


func _gauntlet_command_text_state(player_id: int) -> String:
	var text := _command_text(player_id)
	if _text_matches_any(text, ["236", "26"]):
		return "armor"
	if _text_matches_any(text, ["214", "24"]):
		return "active"
	return ""


func _blade_command_text_state(player_id: int, binding: Dictionary) -> String:
	var module_part: Dictionary = binding.get("module_part", {}) if binding.get("module_part", {}) is Dictionary else {}
	var profile := String(binding.get("command_window_profile", module_part.get("command_window_profile", "")))
	var text := _command_text(player_id)
	if profile == "blade_simple_4_6":
		if _text_matches_any(text, ["6"]):
			return "armor"
		if _text_matches_any(text, ["4"]):
			return "active"
	elif profile == "blade_complex_236_214":
		if _text_matches_any(text, ["236", "26"]):
			return "armor"
		if _text_matches_any(text, ["214", "24"]):
			return "active"
	return ""


func _blade_command_variant_for_binding(player_id: int, binding: Dictionary, action_state: String) -> String:
	var module_part: Dictionary = binding.get("module_part", {}) if binding.get("module_part", {}) is Dictionary else {}
	var profile := String(binding.get("command_window_profile", module_part.get("command_window_profile", "")))
	var text := _command_text(player_id)
	if profile == "blade_simple_4_6":
		if _text_matches_any(text, ["6"]) or action_state == "armor":
			return "armor_forward_cut"
		if _text_matches_any(text, ["4"]) or action_state == "active":
			return "active_reverse_cut"
		return "normal_sweep"
	if profile == "blade_complex_236_214":
		if _text_matches_any(text, ["236", "26"]) or action_state == "armor":
			return "armor_special"
		if _text_matches_any(text, ["214", "24"]) or action_state == "active":
			return "active_special"
	return "normal_sweep"


func _blunt_terminal_profile(profile: String) -> bool:
	return profile in [SHIELD_GUARD_BASH_PROFILE, HAMMER_WINDUP_SLAM_PROFILE]


func _blunt_terminal_command_variant_for_binding(player_id: int, hero, binding: Dictionary, input_vector: Vector2, action_state: String) -> String:
	var profile := String(binding.get("module_action_profile", ""))
	var text := _command_text(player_id)
	if profile == SHIELD_GUARD_BASH_PROFILE:
		if _text_matches_any(text, ["236", "26"]) or action_state == "armor":
			return "armor_guard_bash"
		if _text_matches_any(text, ["214", "24"]) or action_state == "active":
			return "active_shoulder_bash"
		var shield_direction := input_vector
		if shield_direction.length() < 0.18:
			shield_direction = _latest_command_direction(player_id)
		if shield_direction.length() >= 0.18:
			var shield_forward := _unit_forward_vector(hero)
			if shield_forward.length() >= 0.01:
				var shield_dot := shield_direction.normalized().dot(shield_forward.normalized())
				if shield_dot >= 0.38:
					return "normal_forward_bash"
				if shield_dot <= -0.38:
					return "normal_back_bash"
		return "normal_guard"
	if _text_matches_any(text, ["236", "26"]) or action_state == "armor":
		return "armor_overhead_slam"
	if _text_matches_any(text, ["214", "24"]) or action_state == "active":
		return "active_side_slam"
	var hammer_direction := input_vector
	if hammer_direction.length() < 0.18:
		hammer_direction = _latest_command_direction(player_id)
	if hammer_direction.length() >= 0.18:
		var hammer_forward := _unit_forward_vector(hero)
		if hammer_forward.length() >= 0.01:
			var hammer_dot := hammer_direction.normalized().dot(hammer_forward.normalized())
			if hammer_dot >= 0.38:
				return "normal_forward_slam"
			if hammer_dot <= -0.38:
				return "normal_back_slam"
	return "normal_short_swing"


func _gauntlet_command_variant_for_binding(player_id: int, hero, binding: Dictionary, input_vector: Vector2, action_state: String) -> String:
	var text := _command_text(player_id)
	if _text_matches_any(text, ["236", "26"]) or action_state == "armor":
		return "armor_inward_extend"
	if _text_matches_any(text, ["214", "24"]) or action_state == "active":
		return "active_outward_extend"
	var command_direction := input_vector
	if command_direction.length() < 0.18:
		command_direction = _latest_command_direction(player_id)
	if command_direction.length() >= 0.18:
		var forward := _unit_forward_vector(hero)
		if forward.length() >= 0.01:
			var dot := command_direction.normalized().dot(forward.normalized())
			if dot >= 0.38:
				return "normal_inward_swing"
			if dot <= -0.38:
				return "normal_outward_swing"
	return "normal_extend"


func _resolve_attack_command_window(player_id: int, prefix: String, input_vector: Vector2, attack_index: int, action_state: String) -> bool:
	var windows := _ensure_attack_command_windows(player_id)
	if not windows.has(_attack_window_key(attack_index)):
		return false
	_close_attack_command_window(player_id, attack_index)
	_hero_runtime_module_attack(player_id, prefix, input_vector, attack_index, action_state)
	return true


func _resolve_all_attack_command_windows(player_id: int, prefix: String, input_vector: Vector2, action_state: String) -> bool:
	var windows := _ensure_attack_command_windows(player_id)
	if windows.is_empty():
		return false
	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero):
		return false
	var resolved_entries: Array = []
	for raw_key in windows.keys():
		var window: Dictionary = windows[raw_key]
		var attack_index := int(window.get("attack_index", String(raw_key).to_int()))
		var resolved_state := action_state
		if resolved_state == "":
			var binding: Dictionary = window.get("binding", {}) if window.get("binding", {}) is Dictionary else {}
			if binding.is_empty():
				binding = _runtime_binding_for_attack_index(hero, attack_index)
			resolved_state = _attack_window_state_for_binding(hero, binding, input_vector)
		if resolved_state == "":
			continue
		resolved_entries.append({
			"window_key": String(raw_key),
			"attack_index": attack_index,
			"state": resolved_state,
		})
	if resolved_entries.is_empty():
		return false
	resolved_entries.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return int(a.get("attack_index", 0)) < int(b.get("attack_index", 0))
	)
	for entry in resolved_entries:
		windows.erase(String(entry.get("window_key", "")))
	attack_command_windows[player_id] = windows
	for entry in resolved_entries:
		var attack_index := int(entry.get("attack_index", 0))
		if _is_live_unit(hero) and _unit_uses_direct_runtime_topology(hero):
			hero.set("action_cooldown", 0.0)
		_hero_runtime_module_attack(player_id, prefix, input_vector, attack_index, String(entry.get("state", "normal")))
	return true


func _handle_attack_window_direction_resolution(player_id: int, prefix: String, input_vector: Vector2) -> bool:
	if not _attack_windows_any_open(player_id):
		return false
	if not _battle_direction_just_pressed(prefix):
		return false
	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero):
		return false
	return _resolve_all_attack_command_windows(player_id, prefix, input_vector, "")


func _runtime_module_state_for_binding(player_id: int, unit, binding: Dictionary, input_vector: Vector2, fallback_state: String) -> String:
	var module_part: Dictionary = binding.get("module_part", {}) if binding.get("module_part", {}) is Dictionary else {}
	var profile := String(binding.get("module_action_profile", module_part.get("module_action_profile", "")))
	if profile == "blunt_gauntlet_extend_swing":
		var command_state := _gauntlet_command_text_state(player_id)
		if command_state != "":
			return command_state
	if _blunt_terminal_profile(profile):
		var blunt_state := _gauntlet_command_text_state(player_id)
		if blunt_state != "":
			return blunt_state
	if profile in ["blade_arc_return", "katana_quickdraw", "scythe_hook_return", "greatsword_commit_cleave", "triple_limb_cross_cut", "extend_slash_driver"]:
		var blade_state := _blade_command_text_state(player_id, binding)
		if blade_state != "":
			return blade_state
	return fallback_state


func _hero_runtime_module_attack(player_id: int, prefix: String, input_vector: Vector2, attack_index: int, requested_state: String = "normal") -> void:
	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero):
		return
	var binding := _runtime_binding_for_attack_index(hero, attack_index)
	if binding.is_empty():
		_play_module_fail_sfx()
		_show_battle_message("攻击键 %d 未绑定行动模块" % [attack_index + 1] if _ui_is_zh() else "Attack key %d has no module binding" % [attack_index + 1], 0.55)
		return
	var action_state := _runtime_module_state_for_binding(player_id, hero, binding, input_vector, requested_state)
	var runtime_binding := binding.duplicate(true)
	var binding_module_part: Dictionary = runtime_binding.get("module_part", {}) if runtime_binding.get("module_part", {}) is Dictionary else {}
	var runtime_profile := String(runtime_binding.get("module_action_profile", binding_module_part.get("module_action_profile", "")))
	if runtime_profile == "blunt_gauntlet_extend_swing":
		runtime_binding["runtime_command_variant"] = _gauntlet_command_variant_for_binding(player_id, hero, runtime_binding, input_vector, action_state)
	elif _blunt_terminal_profile(runtime_profile):
		runtime_binding["runtime_command_variant"] = _blunt_terminal_command_variant_for_binding(player_id, hero, runtime_binding, input_vector, action_state)
	elif runtime_profile in ["blade_arc_return", "katana_quickdraw", "scythe_hook_return", "greatsword_commit_cleave", "triple_limb_cross_cut", "extend_slash_driver"]:
		runtime_binding["runtime_command_variant"] = _blade_command_variant_for_binding(player_id, runtime_binding, action_state)
	if action_state in ["active", "armor"] or runtime_profile in ["blunt_gauntlet_extend_swing", SHIELD_GUARD_BASH_PROFILE, HAMMER_WINDUP_SLAM_PROFILE, "blade_arc_return", "katana_quickdraw", "scythe_hook_return", "greatsword_commit_cleave", "triple_limb_cross_cut", "extend_slash_driver"]:
		command_buffers[player_id] = []
	var direction := input_vector.normalized() if input_vector.length() >= 0.18 else _unit_forward_vector(hero)
	var event: Dictionary = {}
	if hero.has_method("begin_runtime_module_action"):
		event = hero.begin_runtime_module_action(action_state, runtime_binding, direction)
	if event.is_empty():
		_play_module_fail_sfx()
		var reason := String(hero.get_meta("last_module_gate_reason", "locked"))
		_show_battle_message("行动模块无法触发：%s" % reason if _ui_is_zh() else "Module trigger blocked: %s" % reason, 0.45)
		return
	var module_part: Dictionary = binding.get("module_part", {}) if binding.get("module_part", {}) is Dictionary else {}
	event["direction"] = direction
	event["group_name"] = String(module_part.get("name", "ACTION MODULE"))
	event["damage_type"] = String(module_part.get("damage_type", event.get("damage_type", "blunt")))
	event["material_class"] = String(module_part.get("material_class", event.get("material_class", "weapon")))
	event["weapon_damage_coeff"] = _weapon_damage_coefficient(float(event.get("damage", 1.0)), module_part, String(event.get("state", action_state)))
	event["fixed_output_momentum"] = float(module_part.get("fixed_output_momentum", module_part.get("joint_output_momentum", 0.0)))
	event["runtime_direct_module"] = true
	_copy_module_variant_fields(event, module_part)
	event["recoil_countered"] = _is_recoil_countered(player_id, prefix, direction)
	if not bool(event.get("projectile", false)):
		hero.apply_recoil(direction, float(event.get("recoil", 0.04)), bool(event["recoil_countered"]))
	var state_label := String(event.get("state", action_state)).to_upper()
	_show_battle_message("P%d %s %s" % [player_id, _short_part_name(String(event["group_name"])), state_label], 0.45)
	_resolve_attack(hero, event)


func _hero_normal_attack(player_id: int, prefix: String, input_vector: Vector2, attack_index: int = 0, requested_state: String = "normal", prelocked_target = null, held_activation_fire: bool = false, override_group: Dictionary = {}) -> void:
	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero):
		return
	if _unit_uses_direct_runtime_topology(hero) and override_group.is_empty():
		_hero_runtime_module_attack(player_id, prefix, input_vector, attack_index, requested_state)
		return
	if _part_disabled(hero, attack_index):
		_module_fail_feedback(hero, attack_index)
		return
	var group := override_group.duplicate(true) if not override_group.is_empty() else _attack_group(hero, attack_index)
	if override_group.is_empty() and bool(group.get("requires_joint_pair", false)):
		var paired_entries := _attack_group_entries_for_key(hero, attack_index)
		if paired_entries.size() > 1:
			for pair_index in range(paired_entries.size()):
				var entry: Dictionary = paired_entries[pair_index]
				var member_group: Dictionary = entry.get("group", {})
				var member_attack_index := int(entry.get("index", attack_index))
				var member_direction := _paired_attack_direction(hero, input_vector, member_group, pair_index, paired_entries.size())
				_hero_normal_attack(player_id, prefix, member_direction, member_attack_index, requested_state, prelocked_target, held_activation_fire, member_group)
			return
	if String(group.get("module_effect", "")) == "trap_control":
		var command := String(group.get("command", "236"))
		if not _command_matches(player_id, command):
			_show_battle_message("Trap link command miss. Try %s + attack %d." % [command, attack_index + 1], 0.65)
			return
		var link := String(group.get("trap_link", "all"))
		if _try_trigger_trap_fields(player_id, link, input_vector, true):
			_show_battle_message("P%d attack %d routed to trap link %s" % [player_id, attack_index + 1, link.to_upper()], 0.55)
		else:
			_play_module_fail_sfx()
			_show_battle_message("No linked trap has a valid target", 0.65)
		return
	var group_projectile := bool(group.get("projectile", hero.stats.get("projectile", false)))
	var action_kind := "normal"
	if requested_state in ["active", "armor"]:
		action_kind = requested_state
	var event: Dictionary = _begin_unit_module_action(hero, action_kind, group, attack_index)
	if event.is_empty():
		return
	var direction := _attack_direction_for_group(hero, input_vector, group)
	if String(group.get("module_action_profile", "")) == "two_link_forward_snap":
		direction = _unit_forward_vector(hero)
	event["direction"] = direction
	if _is_live_unit(prelocked_target):
		event["locked_target"] = prelocked_target
	event["muscle_node"] = attack_index
	event["collision_group"] = group.duplicate(true)
	event["group_name"] = String(group.get("name", ATTACK_GROUP_FALLBACK[attack_index]))
	event["damage_type"] = String(group.get("damage_type", event.get("damage_type", "blunt")))
	event["material_class"] = String(group.get("melee_contact_class", group.get("material_class", "weapon")))
	var state_key := String(event.get("state", "normal"))
	var override_key := "%s_damage_override" % state_key
	var base_damage := float(event.get("damage", 1))
	if group.has(override_key):
		base_damage = float(group[override_key])
	event["damage"] = int(roundf(base_damage * float(group.get("damage_mult", 1.0))))
	event["range"] = float(event.get("range", 0.3)) * float(group.get("range_mult", 1.0))
	event["range"] = float(event["range"]) + _damage_type_range_bonus(hero.stats, String(event.get("damage_type", "blunt")))
	event["lane_range"] = float(event.get("lane_range", 0.2)) * float(group.get("lane_mult", 1.0))
	event["recoil"] = float(event.get("recoil", 0.06)) * float(group.get("recoil_mult", 1.0))
	if group_projectile:
		event["projectile"] = true
		event["material_class"] = "projectile"
		event["damage_type"] = String(group.get("projectile_damage_type", event.get("damage_type", "bullet")))
		event["projectile_style"] = String(group.get("projectile_style", _projectile_style_for_damage(String(event["damage_type"]))))
		event["projectile_behavior"] = _projectile_behavior_for_data(group)
		if String(event["projectile_behavior"]) == "bullet_hell":
			event["projectile_style"] = "bullet_hell"
			event["projectile_speed_mult"] = float(group.get("projectile_speed_mult", BULLET_HELL_DEFAULT_SPEED_MULT))
		event["travel_path"] = String(group.get("travel_path", "straight"))
		event["range"] = maxf(float(event["range"]), float(group.get("projectile_range", 2.25)))
		if String(event["projectile_behavior"]) == "true_bullet":
			event["projectile_style"] = "true_bullet"
			event["travel_path"] = "instant_line"
			event["range"] = maxf(float(event["range"]), _laser_visible_world_range(hero, direction))
		if event["projectile_style"] == "missile":
			event["range"] = maxf(float(event["range"]), 3.2)
			event["lane_range"] = float(event["lane_range"]) + 0.18
			event["damage"] = int(roundf(float(event["damage"]) * 1.18))
	_copy_control_event_fields(event, group)
	if String(group.get("module_effect", "")) != "":
		_apply_module_event_fields(event, group)
	if not bool(event.get("projectile", false)):
		event["weapon_damage_coeff"] = _weapon_damage_coefficient(float(event.get("damage", base_damage)), group, state_key)
		event["joint_power"] = float(group.get("joint_power", 0.0))
		event["fixed_output_momentum"] = float(group.get("fixed_output_momentum", 0.0))
		event["limb_end_mass"] = float(group.get("limb_end_mass", group.get("terminal_weapon_mass", 0.0)))
		event["group_stiffness"] = float(group.get("group_stiffness", hero.stats.get("stiffness", 0.0)))
		event["joint_actuation_speed"] = _group_joint_actuation_speed(hero.stats, group, state_key)
		_apply_melee_module_heat(hero, event, group, attack_index)
	if hero.has_method("mark_part_action"):
		hero.mark_part_action(attack_index, direction, state_key, float(hero.state_timer))
	var countered := _is_recoil_countered(player_id, prefix, direction)
	event["recoil_countered"] = countered
	if not bool(event.get("projectile", false)):
		hero.apply_recoil(direction, float(event.get("recoil", 0.06)), countered)
	var damage_name: String = _damage_name(String(event.get("damage_type", "blunt")))
	var state_label := String(event.get("state", "normal")).to_upper()
	var cancel_label := " 取消" if _ui_is_zh() and bool(event.get("module_cancel", false)) else (" CANCEL" if bool(event.get("module_cancel", false)) else "")
	_show_battle_message("P%d %s %s %s %s%s" % [player_id, String(event["group_name"]), state_label, damage_name, "projectile" if bool(event.get("projectile", false)) else "strike", cancel_label], 0.45)
	_resolve_attack(hero, event)


func _apply_module_event_fields(event: Dictionary, group: Dictionary) -> void:
	var module_effect := String(group.get("module_effect", ""))
	event["module_effect"] = module_effect
	event["travel_path"] = String(group.get("travel_path", event.get("travel_path", "straight")))
	if module_effect in ["eject", "chain_recall", "capture", "tether", "entangle", "barrier_break", "boomerang_recall", "guided_eject", "group_throw", "throw_guidance", "web_anchor", "web_reel", "web_tether", "light_sink"]:
		event["projectile"] = true
		event["range"] = maxf(float(event.get("range", 0.5)), float(group.get("module_range", 1.4)))
		event["lane_range"] = maxf(float(event.get("lane_range", 0.24)), float(group.get("module_lane_range", 0.34)))
		event["projectile_style"] = String(group.get("projectile_style", module_effect))
		event["state"] = String(group.get("module_state", event.get("state", "normal")))
		event["damage"] = int(roundf(float(event.get("damage", 1)) * float(group.get("module_damage_mult", 1.0))))
	_copy_control_event_fields(event, group)
	if module_effect in ["web_anchor", "web_reel", "web_tether", "light_sink"] or bool(event.get("non_damage", false)):
		event["non_damage"] = true
		event["damage"] = 0
	if module_effect == "chaos_shot":
		event["projectile"] = true
		event["projectile_style"] = "chaos"
		event["travel_path"] = "instant_line"
		event["range"] = maxf(float(event.get("range", 0.5)), 4.15)
		event["lane_range"] = maxf(float(event.get("lane_range", 0.24)), 0.18)
		event["damage"] = int(roundf(float(event.get("damage", 1)) * 0.82))


func _copy_module_variant_fields(event: Dictionary, module_part: Dictionary) -> void:
	var variant_key := String(module_part.get("module_variant_key", "")).to_lower()
	if variant_key == "":
		return
	event["module_variant_key"] = variant_key
	event["module_visual_family"] = String(module_part.get("module_visual_family", variant_key))
	event["module_variant_label"] = String(module_part.get("module_variant_label", ""))
	match variant_key:
		"balance_string":
			event["combo_balance_window"] = float(module_part.get("combo_balance_window", 1.2))
			event["combo_balance_cooldown_mult"] = float(module_part.get("combo_balance_cooldown_mult", 0.62))
		"vise_close":
			event["clamp_pin_seconds"] = float(module_part.get("clamp_pin_seconds", 0.38))
			event["clamp_velocity_mult"] = float(module_part.get("clamp_velocity_mult", 0.35))
			event["clamp_knock_mult"] = float(module_part.get("clamp_knock_mult", 0.38))
			event["knock"] = float(event.get("knock", 0.12)) * clampf(float(module_part.get("clamp_knock_mult", 0.38)), 0.05, 1.0)
		"pickup_dash":
			event["pickup_dash_impulse"] = float(module_part.get("pickup_dash_impulse", 0.65))
			event["pickup_dash_on_hit_impulse"] = float(module_part.get("pickup_dash_on_hit_impulse", 0.35))
			event["route_lane_pull"] = float(module_part.get("route_lane_pull", 0.1))
		"crush_windup":
			event["contact_momentum_mult"] = float(module_part.get("crush_contact_momentum_mult", 1.45))
			event["crush_stagger_mult"] = float(module_part.get("crush_stagger_mult", 1.35))
			event["whiff_recovery_mult"] = float(module_part.get("whiff_recovery_mult", 1.25))
			event["runtime_contact_damage_mult"] = float(module_part.get("runtime_contact_damage_mult", 1.24))
		"feint_thrust":
			event["feint_retarget_degrees"] = float(module_part.get("feint_retarget_degrees", 18.0))
			event["feint_ghost_phase"] = float(module_part.get("feint_ghost_phase", 0.42))
			event["feint_final_width_mult"] = float(module_part.get("feint_final_width_mult", 0.65))
		"explosive_arc_salvo":
			event["salvo_arc_min_range"] = float(module_part.get("salvo_arc_min_range", 1.35))
			event["salvo_arc_max_range"] = float(module_part.get("salvo_arc_max_range", 3.8))
			event["salvo_hold_range_seconds"] = float(module_part.get("salvo_hold_range_seconds", 0.75))
			event["salvo_landing_marker"] = bool(module_part.get("salvo_landing_marker", true))


func _copy_control_event_fields(event: Dictionary, group: Dictionary) -> void:
	for event_key in ["non_damage", "web_strength", "web_break_force", "web_pull_mode", "blind_radius", "blind_duration", "blind_strength", "takeover_on_hit", "takeover_seconds", "takeover_power", "takeover_damage_rate", "takeover_damage_type", "explosion_radius", "explosion_damage_type", "explosion_style", "back_hit_heat_bonus", "back_hit_heat_mult", "laser_aim_time", "projectile_behavior", "projectile_momentum", "projectile_base_momentum", "projectile_effective_momentum", "projectile_drive_momentum_mult", "projectile_mass", "projectile_collision_speed", "projectile_speed_mult", "gun_projectile_damage_mult", "gun_projectile_damage_mult_current", "gun_drive_allocated", "gun_drive_min", "gun_drive_max", "gun_drive_ratio", "gun_drive_ratio_to_max", "fire_rate", "fire_interval", "carried_ammo", "ammo_capacity", "bullet_lock_time", "bullet_lock_radius", "chemical_dot_duration", "chemical_dot_mult", "chemical_frontload", "chemical_pellets", "chemical_spread", "missile_lock_priority", "missile_lock_cone_degrees", "missile_lock_range", "missile_lock_target_classes", "missile_occlusion_grace"]:
		if group.has(event_key):
			event[event_key] = group[event_key]
	if bool(event.get("non_damage", false)):
		event["damage"] = 0


func _projectile_style_for_damage(damage_type: String) -> String:
	match damage_type:
		"chemical":
			return "spray"
		"laser":
			return "beam"
		"bullet":
			return "bullet"
	return "thrown"


func _damage_type_range_bonus(stats: Dictionary, damage_type: String) -> float:
	match damage_type:
		"pierce":
			return float(stats.get("pierce_range_bonus", 0.0))
		"tear":
			return float(stats.get("tear_range_bonus", 0.0))
	return 0.0


func _hero_command_skill(player_id: int, prefix: String, input_vector: Vector2, requested_state: String = "active") -> void:
	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero):
		return
	var command: String = String(hero.stats.get("command", "236"))
	if not _command_matches(player_id, command):
		_show_battle_message("Command miss. Try %s + %s." % [command, requested_state.to_upper()], 0.65)
		return
	if String(hero.stats.get("role_switch", "")) != "":
		if not _try_consume_command_heat(hero, requested_state):
			return
		_try_role_switch_module(hero)
		return
	if String(hero.stats.get("module_effect", "")) == "soul_cast_transfer":
		if not _try_consume_command_heat(hero, requested_state):
			return
		_try_soul_cast_transfer(hero)
		return
	if String(hero.stats.get("module_effect", "")) == "role_form_shift":
		if not _try_consume_command_heat(hero, requested_state):
			return
		_try_role_form_shift(hero)
		return
	if String(hero.stats.get("module_effect", "")) == "morph":
		if not _try_consume_command_heat(hero, requested_state):
			return
		_try_morph_unit(hero)
		return
	if String(hero.stats.get("module_effect", "")) == "combine":
		if not _try_consume_command_heat(hero, requested_state):
			return
		_try_combine_or_separate(hero)
		return
	if String(hero.stats.get("module_effect", "")) == "racket_serve":
		if not _try_consume_command_heat(hero, requested_state):
			return
		_try_racket_serve(hero, input_vector)
		return
	if String(hero.stats.get("module_effect", "")) == "active_cool":
		_try_active_cooling_module(hero)
		return
	if String(hero.stats.get("module_effect", "")) == "projectile_shield":
		if not _try_consume_command_heat(hero, requested_state):
			return
		_try_projectile_shield_module(hero)
		return
	if String(hero.stats.get("module_effect", "")) == "weapon_swap":
		if not _try_consume_command_heat(hero, requested_state):
			return
		_try_weapon_swap_module(hero)
		return
	if String(hero.stats.get("module_effect", "")) == "control_page_shift":
		if not _try_consume_command_heat(hero, requested_state):
			return
		_try_control_page_shift_module(hero)
		return
	if String(hero.stats.get("module_effect", "")) == "fold_barrier_squad":
		if not _try_consume_command_heat(hero, requested_state):
			return
		if _try_fold_barrier_squad(hero):
			return
	var action_kind: String = requested_state if requested_state in ["active", "armor"] else String(hero.stats.get("skill_state", "active"))
	var module_state := String(hero.stats.get("module_state", ""))
	if module_state in ["active", "armor"]:
		action_kind = module_state
	var command_group := _attack_group(hero, 0)
	var event: Dictionary = _begin_unit_module_action(hero, action_kind, command_group, 0)
	if event.is_empty():
		return
	event["direction"] = _attack_direction(hero, input_vector)
	event["muscle_node"] = 0
	event["collision_group"] = command_group.duplicate(true)
	event["command"] = command
	event["projectile"] = bool(hero.stats.get("projectile", false))
	event["material_class"] = "projectile" if bool(event["projectile"]) else String(hero.stats.get("material_class", "weapon"))
	event["projectile_style"] = _projectile_style_for_damage(String(event.get("damage_type", "blunt"))) if bool(event["projectile"]) else ""
	event["travel_path"] = String(hero.stats.get("travel_path", "straight"))
	_copy_control_event_fields(event, hero.stats)
	if String(hero.stats.get("module_effect", "")) != "":
		_apply_module_event_fields(event, hero.stats)
	if not bool(event.get("projectile", false)):
		var command_state := String(event.get("state", action_kind))
		event["weapon_damage_coeff"] = _weapon_damage_coefficient(float(event.get("damage", 1.0)), command_group, command_state)
		event["joint_power"] = float(command_group.get("joint_power", 0.0))
		event["fixed_output_momentum"] = float(command_group.get("fixed_output_momentum", 0.0))
		event["limb_end_mass"] = float(command_group.get("limb_end_mass", command_group.get("terminal_weapon_mass", 0.0)))
		event["group_stiffness"] = float(command_group.get("group_stiffness", hero.stats.get("stiffness", 0.0)))
		event["joint_actuation_speed"] = _group_joint_actuation_speed(hero.stats, command_group, command_state)
		_apply_melee_module_heat(hero, event, command_group, 0)
	if hero.has_method("mark_part_action"):
		hero.mark_part_action(0, event["direction"], String(event.get("state", action_kind)), float(hero.state_timer))
	event["recoil_countered"] = _is_recoil_countered(player_id, prefix, event["direction"])
	if not bool(event.get("projectile", false)):
		hero.apply_recoil(event["direction"], float(event.get("recoil", 0.08)) * 1.2, bool(event["recoil_countered"]))
	_show_battle_message("%sX %s" % [command, action_kind.to_upper()], 0.75)
	_resolve_attack(hero, event)


func _try_consume_command_heat(hero, requested_state: String) -> bool:
	# Universal command actions no longer spend heat; stronger explicit heat skills can opt in later.
	return true


func _try_morph_unit(unit) -> bool:
	if not _is_live_unit(unit):
		return false
	var timer := maxf(0.0, float(unit.get_meta("morph_timer", 0.0)))
	if timer > 0.0:
		_show_battle_message("%s morph cooling %.1fs" % [unit.unit_name, timer], 0.45)
		_play_module_fail_sfx()
		return false
	var modes: Array = unit.stats.get("morph_modes", ["combat", "travel"])
	if modes.is_empty():
		modes = ["combat", "travel"]
	var index := (int(unit.get_meta("morph_index", 0)) + 1) % modes.size()
	unit.set_meta("morph_index", index)
	unit.set_meta("morph_timer", float(unit.stats.get("morph_cooldown", 2.6)))
	unit.stats["shape"] = _morph_shape_for(String(unit.stats.get("shape", "core")), String(modes[index]))
	if unit.has_method("_apply_topology_visuals"):
		unit._apply_topology_visuals()
	if unit.has_method("_refresh_visuals"):
		unit._refresh_visuals()
	_spawn_hit_effect(unit, 2, "laser", false, "guided")
	_show_battle_message("%s MORPH: %s" % [unit.unit_name, String(modes[index]).to_upper()], 0.75)
	return true


func _try_combine_or_separate(unit) -> bool:
	if not _is_live_unit(unit):
		return false
	if bool(unit.get_meta("combined", false)):
		var stored: Dictionary = unit.get_meta("combine_store", {})
		var partner_snapshots: Array = stored.get("partners", [])
		unit.stats = stored.get("stats", unit.stats).duplicate(true)
		unit.max_health = int(stored.get("max_health", unit.max_health))
		unit.health = mini(unit.health, unit.max_health)
		unit.set_meta("combined", false)
		unit.set_meta("combine_store", {})
		for i in range(partner_snapshots.size()):
			_restore_combine_partner_snapshot(int(unit.owner_id), unit, partner_snapshots[i], i, partner_snapshots.size())
		if unit.has_method("_apply_topology_visuals"):
			unit._apply_topology_visuals()
		if unit.has_method("_refresh_visuals"):
			unit._refresh_visuals()
		_show_battle_message("%s SEPARATED" % unit.unit_name, 0.7)
		_spawn_hit_effect(unit, 1, "laser", false, "guided")
		_update_battle_ui()
		return true
	var required_partners := maxi(1, int(unit.stats.get("combine_partner_count", 1)))
	var max_partners := maxi(required_partners, int(unit.stats.get("combine_max_partners", required_partners)))
	var range := float(unit.stats.get("combine_range", 0.58))
	var candidates: Array = []
	for ally in _friendly_units(int(unit.owner_id)):
		if ally == unit or not _is_live_unit(ally):
			continue
		if String(ally.stats.get("module_effect", "")) != "combine":
			continue
		if bool(ally.get_meta("combined", false)):
			continue
		var delta := _mobius_delta_vec_between(unit, ally)
		var distance := absf(delta.x) + absf(delta.y) * 0.72
		if absf(delta.x) <= range and absf(delta.y) <= range * 0.72:
			candidates.append({"unit": ally, "distance": distance})
	candidates.sort_custom(func(a, b): return float(a["distance"]) < float(b["distance"]))
	var partners: Array = []
	for item in candidates:
		if partners.size() >= max_partners:
			break
		partners.append(item["unit"])
	if partners.size() < required_partners:
		_show_battle_message("%s needs %d nearby combine partner(s)" % [unit.unit_name, required_partners], 0.65)
		_play_module_fail_sfx()
		return false
	var partner_snapshots: Array = []
	var total_partner_health := 0
	var total_partner_radius := 0.0
	var total_partner_length := 0.0
	for partner in partners:
		partner_snapshots.append({
			"stats": partner.stats.duplicate(true),
			"max_health": partner.max_health,
			"health": partner.health,
			"role": String(partner.role),
			"name": String(partner.unit_name),
		})
		total_partner_health += int(partner.health)
		total_partner_radius += float(partner.stats.get("radius", 0.2))
		total_partner_length += float(partner.stats.get("length", 0.4))
	unit.set_meta("combine_store", {"stats": unit.stats.duplicate(true), "max_health": unit.max_health, "partners": partner_snapshots})
	unit.set_meta("combined", true)
	unit.stats["shape"] = String(unit.stats.get("combine_shape", "tank")) if String(unit.stats.get("combine_shape", "")) != "" else "tank"
	unit.stats["radius"] = float(unit.stats.get("radius", 0.3)) + total_partner_radius * 0.72
	unit.stats["length"] = minf(4.5, float(unit.stats.get("length", 1.0)) + total_partner_length * 0.64)
	unit.max_health += total_partner_health + int(unit.stats.get("combine_bonus_hp", 24))
	unit.health = mini(unit.max_health, unit.health + total_partner_health)
	for partner in partners:
		_detach_unit(partner)
		partner.queue_free()
	if unit.has_method("_apply_topology_visuals"):
		unit._apply_topology_visuals()
	if unit.has_method("_refresh_visuals"):
		unit._refresh_visuals()
	_spawn_hit_effect(unit, 2, "laser", false, "shield")
	_show_battle_message("%s COMBINED x%d" % [unit.unit_name, partners.size() + 1], 0.9)
	_update_battle_ui()
	return true


func _restore_combine_partner_snapshot(owner: int, lead_unit, snapshot: Dictionary, index: int, count: int) -> void:
	if not _is_live_unit(lead_unit):
		return
	var stats: Dictionary = snapshot.get("stats", {}).duplicate(true)
	if stats.is_empty():
		return
	var role_key := String(snapshot.get("role", "puppet"))
	if role_key == "hero" and _is_live_unit(active_units[owner]["hero"]):
		role_key = "puppet"
	if role_key == "barrier" and _is_live_unit(active_units[owner]["barrier"]):
		role_key = "puppet"
	var angle := TAU * float(index + 1) / float(maxi(2, count + 1))
	var spawn_ring := wrapf(lead_unit.ring_pos + cos(angle) * 0.32, 0.0, RING_LENGTH)
	var spawn_lane := clampf(lead_unit.lane + sin(angle) * 0.28, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	var restored = _create_unit(owner, role_key, stats, String(snapshot.get("name", "P%d SEPARATED" % owner)), spawn_ring, spawn_lane)
	restored.max_health = int(snapshot.get("max_health", restored.max_health))
	restored.health = clampi(int(snapshot.get("health", restored.max_health)), 1, restored.max_health)
	_assign_unit_role(restored, role_key)
	_spawn_hit_effect(restored, 1, "laser", false, "guided")


func _try_active_cooling_module(unit) -> bool:
	if not _is_live_unit(unit) or not _unit_uses_heat(unit):
		return false
	var burst := maxf(1.0, float(unit.stats.get("cool_burst", 40.0)))
	_cool_unit_heat(unit, burst, 0.72 if bool(unit.stats.get("cool_overheat_clear", false)) else 0.42)
	unit.set_meta("active_cool_lock", maxf(0.1, float(unit.stats.get("cool_lock", 0.42))))
	unit.velocity = unit.velocity.move_toward(Vector2.ZERO, 999.0)
	_spawn_hit_effect(unit, 1, "chemical", false, "shield")
	_play_sfx_wave("chemical", 220.0, 0.3, -9.0)
	_show_battle_message("%s 主动散热 -%.0f 热力" % [unit.unit_name, burst] if _ui_is_zh() else "%s ACTIVE COOL -%.0f HEAT" % [unit.unit_name, burst], 0.72)
	return true


func _try_projectile_shield_module(unit) -> bool:
	if not _is_live_unit(unit):
