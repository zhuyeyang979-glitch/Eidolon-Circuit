func _apply_barrier_field_damage(barrier, target, player_id: int, damage_type: String, damage: int, interval: float, delta: float) -> void:
	if not _is_live_unit(target):
		return
	var key := "field_tick_%d" % int(target.get_instance_id())
	var timer := maxf(0.0, float(barrier.get_meta(key, 0.0)) - delta)
	if timer > 0.0:
		barrier.set_meta(key, timer)
		return
	barrier.set_meta(key, interval)
	var event: Dictionary = {"damage_type": damage_type, "projectile": false}
	var final_damage: int = maxi(1, int(roundf(float(damage) * _vulnerability_multiplier(target, event))))
	final_damage = _projectile_material_adjusted_damage(target, event, final_damage)
	var blocked := final_damage <= 0 or bool(event.get("contact_gate_blocked", false))
	_spawn_hit_effect(target, 1, damage_type, blocked, "field")
	if blocked:
		return
	var killed: bool = target.take_hit(final_damage, "normal", player_id, damage_type, "field")
	if killed:
		_handle_unit_killed(target, player_id)


func _unit_in_barrier_aura(barrier, unit, aura_range: float, field_tag: String = "") -> bool:
	if not _is_live_unit(unit):
		return false
	if _barrier_has_map_tiles(barrier):
		var unit_radius := float(unit.stats.get("radius", 0.2))
		var has_tagged_tiles := _barrier_has_tile_effect_tag(barrier, field_tag)
		for raw_tile in Array(barrier.stats.get("barrier_map_tiles", [])):
			if not (raw_tile is Dictionary):
				continue
			var tile: Dictionary = raw_tile
			if not _barrier_tile_matches_field(tile, field_tag, has_tagged_tiles):
				continue
			var tile_pos := _barrier_tile_world_position(barrier, tile, true)
			var tile_extent := maxf(float(tile.get("radius", 0.08)), float(tile.get("length", 0.2)) * 0.5)
			var range_x := aura_range + tile_extent + unit_radius
			var range_y := aura_range * 0.72 + tile_extent * 0.5 + unit_radius
			var tile_delta := _mobius_delta_points(tile_pos.x, tile_pos.y, unit.ring_pos, unit.lane)
			if absf(tile_delta.x) <= range_x and absf(tile_delta.y) <= range_y:
				return true
		return false
	var delta := _mobius_delta_vec_between(barrier, unit)
	return absf(delta.x) <= aura_range + float(unit.stats.get("radius", 0.2)) and absf(delta.y) <= aura_range * 0.72 + float(unit.stats.get("radius", 0.2))


func _friendly_units(player_id: int) -> Array:
	var units: Array = []
	var hero = active_units[player_id]["hero"]
	if _is_live_unit(hero):
		units.append(hero)
	var barrier = active_units[player_id]["barrier"]
	if _is_live_unit(barrier):
		units.append(barrier)
	for unit in active_units[player_id]["puppet"]:
		if _is_live_unit(unit):
			units.append(unit)
	return units


func _resolve_unit_body_spacing(delta: float) -> void:
	if delta <= 0.0:
		return
	runtime_contact_pairs_seen = {}
	gpu_collision_pair_dispatch_count = 0
	gpu_collision_candidate_count = 0
	gpu_collision_contact_count = 0
	gpu_collision_skipped_runtime_pairs = 0
	gpu_collision_readback_bytes = 0
	_cleanup_active_melee_contact_suppression()
	var live_subjects: Array = []
	var has_runtime_subject := false
	for unit in all_units:
		if _is_live_unit(unit) and _unit_is_mech_physics_subject(unit):
			live_subjects.append(unit)
			if _unit_uses_direct_runtime_topology(unit):
				has_runtime_subject = true
	if has_runtime_subject:
		if _gpu_collision_available():
			_gpu_collision_and_response_step(live_subjects, delta)
		else:
			gpu_collision_skipped_runtime_pairs += 1
			_warn_gpu_collision_unavailable()
	for i in range(live_subjects.size()):
		var a = live_subjects[i]
		if not _is_live_unit(a):
			continue
		for j in range(i + 1, live_subjects.size()):
			var b = live_subjects[j]
			if not _is_live_unit(b):
				continue
			_separate_unit_pair(a, b, delta)
	for key in runtime_contact_pairs_active.keys():
		if not runtime_contact_pairs_seen.has(key):
			runtime_contact_pairs_active.erase(key)


func _separate_unit_pair(a, b, delta: float) -> void:
	var offset := _mobius_delta_vec_between(a, b)
	var distance := offset.length()
	var exact_runtime_pair := _unit_uses_direct_runtime_topology(a) or _unit_uses_direct_runtime_topology(b)
	if exact_runtime_pair:
		return
	if not exact_runtime_pair and not (_barrier_has_map_tiles(a) or _barrier_has_map_tiles(b)):
		var a_radius := _unit_contact_radius(a)
		var b_radius := _unit_contact_radius(b)
		var min_distance := a_radius + b_radius + UNIT_BODY_SPACING_PADDING
		if distance < min_distance:
			var direction := offset / distance if distance > 0.001 else Vector2(float(1 if int(a.owner_id) <= int(b.owner_id) else -1), 0.0)
			var penetration := min_distance - distance
			var mass_a := _unit_effective_mass(a)
			var mass_b := _unit_effective_mass(b)
			var total_mass := mass_a + mass_b
			var a_share := clampf(mass_b / total_mass, 0.12, 0.88)
			var b_share := clampf(mass_a / total_mass, 0.12, 0.88)
			var thruster_a := _unit_thruster_power(a)
			var thruster_b := _unit_thruster_power(b)
			var a_anchor := clampf(thruster_a / (thruster_a + mass_b * 0.28 + 8.0), 0.0, 0.58)
			var b_anchor := clampf(thruster_b / (thruster_b + mass_a * 0.28 + 8.0), 0.0, 0.58)
			var correction := penetration * clampf(0.62 + delta * 6.0, 0.62, 0.94)
			var a_move := correction * a_share * (1.0 - a_anchor * 0.42)
			var b_move := correction * b_share * (1.0 - b_anchor * 0.42)
			_apply_unit_displacement(a, -direction, a_move)
			_apply_unit_displacement(b, direction, b_move)
			a.velocity -= direction * a_move * 1.35
			b.velocity += direction * b_move * 1.35
			if a.has_method("apply_physics_impulse"):
				a.apply_physics_impulse(-direction, a_move * 0.82, -1, 0.0)
			if b.has_method("apply_physics_impulse"):
				b.apply_physics_impulse(direction, b_move * 0.82, -1, 0.0)
	_separate_unit_part_pair(a, b, delta)


func _separate_unit_part_pair(a, b, delta: float) -> void:
	if a == b:
		return
	var a_colliders := _unit_part_colliders(a)
	var b_colliders := _unit_part_colliders(b)
	if a_colliders.is_empty() or b_colliders.is_empty():
		return
	var exact_runtime_pair := _unit_uses_direct_runtime_topology(a) or _unit_uses_direct_runtime_topology(b)
	if exact_runtime_pair:
		a_colliders = _runtime_contact_sorted_colliders(a_colliders)
		b_colliders = _runtime_contact_sorted_colliders(b_colliders)
	var contact_padding := 0.0 if exact_runtime_pair else UNIT_PART_SPACING_PADDING
	var patch_origin := _combat_patch_origin_for_unit(a)
	var origin_x: float = patch_origin.x
	var origin_lane: float = patch_origin.y
	var mass_a := _unit_effective_mass(a)
	var mass_b := _unit_effective_mass(b)
	var total_mass := mass_a + mass_b
	var a_share := clampf(mass_b / total_mass, 0.12, 0.88)
	var b_share := clampf(mass_a / total_mass, 0.12, 0.88)
	var max_checks := 0
	var deferred_runtime_responses: Array = []
	var shifted_a_colliders: Array = []
	for raw_a in a_colliders:
		if not (raw_a is Dictionary):
			continue
		var raw_collider_a: Dictionary = raw_a
		shifted_a_colliders.append({"raw": raw_collider_a, "shifted": _shift_collider_to_origin(raw_collider_a, origin_x, origin_lane)})
	var shifted_b_colliders: Array = []
	for raw_b in b_colliders:
		if not (raw_b is Dictionary):
			continue
		var raw_collider_b: Dictionary = raw_b
		shifted_b_colliders.append({"raw": raw_collider_b, "shifted": _shift_collider_to_origin(raw_collider_b, origin_x, origin_lane)})
	for entry_a in shifted_a_colliders:
		var raw_collider_a: Dictionary = Dictionary(entry_a.get("raw", {}))
		var collider_a: Dictionary = Dictionary(entry_a.get("shifted", {}))
		for entry_b in shifted_b_colliders:
			collision_pair_loop_count += 1
			var raw_collider_b: Dictionary = Dictionary(entry_b.get("raw", {}))
			var collider_b: Dictionary = Dictionary(entry_b.get("shifted", {}))
			var broadphase_gap := _collider_broadphase_gap(collider_a, collider_b)
			var broadphase_margin := contact_padding + (RUNTIME_CONTACT_REQUIRED_OVERLAP if exact_runtime_pair else 0.0) + 0.02
			if broadphase_gap > broadphase_margin:
				collision_broadphase_skip_count += 1
				continue
			collision_polygon_precise_check_count += 1
			var gap := _collider_gap(collider_a, collider_b) - contact_padding
			if exact_runtime_pair:
				if gap > -RUNTIME_CONTACT_REQUIRED_OVERLAP:
					continue
			elif gap >= 0.0:
				continue
			var direction := _collider_center(collider_b) - _collider_center(collider_a)
			if direction.length() <= 0.001:
				direction = _mobius_delta_vec_between(a, b)
			if direction.length() <= 0.001:
				direction = Vector2(float(1 if int(a.owner_id) <= int(b.owner_id) else -1), 0.0)
			direction = direction.normalized()
			if int(a.owner_id) != int(b.owner_id):
				if exact_runtime_pair:
					_resolve_runtime_contact_pair_once(a, raw_collider_a, collider_a, b, raw_collider_b, collider_b, direction, -gap, deferred_runtime_responses)
				else:
					_resolve_passive_contact_pair(a, raw_collider_a, collider_a, b, raw_collider_b, collider_b, direction, -gap, delta)
				if not _is_live_unit(a) or not _is_live_unit(b):
					_flush_runtime_contact_velocity_responses(deferred_runtime_responses)
					return
			var penetration := minf(-gap, 0.22)
			var correction := penetration * clampf(0.44 + delta * 8.0, 0.44, 0.86)
			if exact_runtime_pair:
				correction = penetration * clampf(0.58 + delta * 5.0, 0.58, 0.92)
			var a_move := correction * a_share
			var b_move := correction * b_share
			if _unit_is_anchored_barrier(a) and _unit_is_anchored_barrier(b):
				a_move = 0.0
				b_move = 0.0
			elif _unit_is_anchored_barrier(a):
				b_move = correction
				a_move = 0.0
			elif _unit_is_anchored_barrier(b):
				a_move = correction
				b_move = 0.0
			_apply_unit_displacement(a, -direction, a_move)
			_apply_unit_displacement(b, direction, b_move)
			if not exact_runtime_pair:
				a.velocity -= direction * a_move * 2.0
				b.velocity += direction * b_move * 2.0
				if a.has_method("apply_physics_impulse"):
					a.apply_physics_impulse(-direction, a_move * 1.65, int(collider_a.get("part_index", -1)), 0.0)
				if b.has_method("apply_physics_impulse"):
					b.apply_physics_impulse(direction, b_move * 1.65, int(collider_b.get("part_index", -1)), 0.0)
			max_checks += 1
			if max_checks >= 10:
				_flush_runtime_contact_velocity_responses(deferred_runtime_responses)
				return
	_flush_runtime_contact_velocity_responses(deferred_runtime_responses)


func _gpu_collision_and_response_step(live_subjects: Array, delta: float) -> void:
	if delta <= 0.0 or live_subjects.size() < 2:
		return
	var gpu_colliders: Array = []
	var entries: Array = []
	var unit_key := 1
	for unit in live_subjects:
		if not _is_live_unit(unit):
			continue
		var colliders := _unit_part_colliders(unit)
		if colliders.is_empty():
			continue
		if _unit_uses_direct_runtime_topology(unit):
			colliders = _runtime_contact_sorted_colliders(colliders)
		_append_gpu_collision_unit_colliders(unit, colliders, 0.0, unit_key, entries, gpu_colliders)
		unit_key += 1
	if gpu_colliders.size() < 2:
		return
	gpu_collision_pair_dispatch_count += 1
	var records := gpu_collision_pipeline.compute_contact_responses_deferred(gpu_colliders, RUNTIME_CONTACT_REQUIRED_OVERLAP, delta)
	gpu_collision_candidate_count += int(gpu_collision_pipeline.last_candidate_count)
	gpu_collision_contact_count += records.size()
	gpu_collision_readback_bytes += int(gpu_collision_pipeline.last_readback_bytes)
	if records.is_empty():
		return
	for raw_record in records:
		if not (raw_record is Dictionary):
			continue
		var record: Dictionary = raw_record
		var index_a := int(record.get("index_a", -1))
		var index_b := int(record.get("index_b", -1))
		if index_a < 0 or index_b < 0 or index_a >= entries.size() or index_b >= entries.size():
			continue
		var entry_a: Dictionary = Dictionary(entries[index_a])
		var entry_b: Dictionary = Dictionary(entries[index_b])
		var unit_a = entry_a.get("unit", null)
		var unit_b = entry_b.get("unit", null)
		if unit_a == unit_b or unit_a == null or unit_b == null:
			continue
		if not is_instance_valid(unit_a) or not is_instance_valid(unit_b):
			continue
		if not _is_live_unit(unit_a) or not _is_live_unit(unit_b):
			continue
		var raw_collider_a: Dictionary = Dictionary(entry_a.get("raw", {}))
		var raw_collider_b: Dictionary = Dictionary(entry_b.get("raw", {}))
		var collider_a: Dictionary = Dictionary(entry_a.get("shifted", {}))
		var collider_b: Dictionary = Dictionary(entry_b.get("shifted", {}))
		_resolve_runtime_gpu_contact_once(unit_a, raw_collider_a, collider_a, unit_b, raw_collider_b, collider_b, record)


func _resolve_runtime_gpu_contact_once(a, raw_collider_a: Dictionary, collider_a: Dictionary, b, raw_collider_b: Dictionary, collider_b: Dictionary, response: Dictionary) -> void:
	var normal: Vector2 = response.get("normal", Vector2.ZERO)
	if normal.length() <= 0.001 or not _is_live_unit(a) or not _is_live_unit(b):
		return
	normal = normal.normalized()
	var penetration := maxf(0.0, float(response.get("penetration", 0.0)))
	if penetration <= RUNTIME_CONTACT_REQUIRED_OVERLAP:
		return
	var key := _runtime_contact_pair_key(a, raw_collider_a, b, raw_collider_b)
	runtime_contact_pairs_seen[key] = true
	var position_delta_a: Vector2 = response.get("position_delta_a", Vector2.ZERO)
	var position_delta_b: Vector2 = response.get("position_delta_b", Vector2.ZERO)
	_apply_gpu_position_delta(a, position_delta_a)
	_apply_gpu_position_delta(b, position_delta_b)
	if runtime_contact_pairs_active.has(key):
		return
	runtime_contact_pairs_active[key] = true
	if bool(response.get("recovery_a", false)):
		_force_runtime_collision_recovery_from_gpu(a, raw_collider_a)
	if bool(response.get("recovery_b", false)):
		_force_runtime_collision_recovery_from_gpu(b, raw_collider_b)
	var contact_momentum := maxf(0.0, float(response.get("raw_contact_momentum", response.get("usable_contact_momentum", 0.0))))
	var response_momentum := maxf(0.0, float(response.get("usable_contact_momentum", 0.0)))
	var closing_speed := maxf(0.0, float(response.get("relative_normal_velocity", 0.0)))
	var hit_position: Vector2 = response.get("contact_point", _collider_hit_position(collider_a, collider_b))
	_emit_gpu_contact_vfx_descriptor(hit_position, normal, maxf(0.0, float(response.get("vfx_strength", 0.0))), int(response.get("vfx_kind", 0)))
	if int(a.owner_id) != int(b.owner_id) and closing_speed >= PASSIVE_CONTACT_MIN_SPEED:
		var source_a := _runtime_contact_source_for_collider(raw_collider_a)
		var source_b := _runtime_contact_source_for_collider(raw_collider_b)
		var allow_a_damage := true
		var allow_b_damage := true
		if source_a == "active_module_contact" and source_b != "active_module_contact":
			allow_b_damage = false
		elif source_b == "active_module_contact" and source_a != "active_module_contact":
			allow_a_damage = false
		if allow_a_damage and not _active_melee_contact_damage_suppressed(a, raw_collider_a, b, raw_collider_b):
			_apply_runtime_contact_damage(a, raw_collider_a, b, raw_collider_b, normal, contact_momentum, hit_position, source_a)
		if _is_live_unit(a) and _is_live_unit(b):
			if allow_b_damage and not _active_melee_contact_damage_suppressed(b, raw_collider_b, a, raw_collider_a):
				_apply_runtime_contact_damage(b, raw_collider_b, a, raw_collider_a, -normal, contact_momentum, hit_position, source_b)
	if _is_live_unit(a) and _is_live_unit(b) and response_momentum > 0.001:
		_apply_runtime_contact_velocity_delta(a, b, response.get("velocity_delta_a", Vector2.ZERO), response.get("velocity_delta_b", Vector2.ZERO))


func _emit_gpu_contact_vfx_descriptor(hit_position: Vector2, normal: Vector2, strength: float, kind: int) -> void:
	if strength <= 0.0 or battle_contact_vfx_pool == null or not is_instance_valid(battle_contact_vfx_pool):
		return
	if not _consume_battle_vfx_budget("contact_particle"):
		return
	if not _is_valid_combat_position(hit_position):
		return
	var screen := _screen_from_ring(wrapf(hit_position.x, 0.0, RING_LENGTH), clampf(hit_position.y, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT))
	if not bool(screen.get("visible", true)):
		return
	battle_contact_vfx_pool.emit_gpu_contact(screen["position"], normal, strength, kind)


func _apply_gpu_position_delta(unit, delta_vec: Vector2) -> void:
	if unit == null or not is_instance_valid(unit) or delta_vec.length() <= 0.00001:
		return
	_apply_unit_displacement(unit, delta_vec.normalized(), delta_vec.length())


func _apply_runtime_contact_velocity_delta(a, b, delta_a: Vector2, delta_b: Vector2) -> void:
	if a != null and is_instance_valid(a) and _is_live_unit(a) and not _unit_is_anchored_barrier(a):
		a.velocity += delta_a
		_request_runtime_collision_brake(a)
	if b != null and is_instance_valid(b) and _is_live_unit(b) and not _unit_is_anchored_barrier(b):
		b.velocity += delta_b
		_request_runtime_collision_brake(b)


func _force_runtime_collision_recovery_from_gpu(unit, collider: Dictionary) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	var node_index := int(collider.get("node_index", collider.get("part_index", -1)))
	if node_index < 0:
		return
	if unit.has_method("force_runtime_recovery_from_gpu"):
		unit.force_runtime_recovery_from_gpu(node_index)
	elif unit.has_method("force_runtime_recovery_from_collision"):
		unit.force_runtime_recovery_from_collision(node_index)


func _append_gpu_collision_unit_colliders(unit, colliders: Array, origin_x: float, unit_key: int, entries: Array, gpu_colliders: Array, origin_lane: float = 1.0e20, query_event: Dictionary = {}) -> void:
	for raw in colliders:
		if not (raw is Dictionary):
			continue
		var raw_collider: Dictionary = raw
		var shifted := _shift_collider_to_origin(raw_collider, origin_x, origin_lane)
		if bool(query_event.get("projectile", false)):
			shifted = _target_collider_for_projectile_query(unit, shifted, query_event)
		shifted["gpu_unit_key"] = unit_key
		shifted["gpu_team_key"] = int(unit.owner_id) if unit != null and is_instance_valid(unit) else 0
		shifted["gpu_mass"] = maxf(1.0, _unit_effective_mass(unit)) if unit != null and is_instance_valid(unit) else maxf(1.0, float(raw_collider.get("mass", 1.0)))
		shifted["gpu_path_stiffness"] = _runtime_contact_path_stiffness(unit, raw_collider) if unit != null and is_instance_valid(unit) else maxf(1.0, float(raw_collider.get("path_stiffness_momentum", raw_collider.get("stiffness_momentum", 1.0))))
		shifted["gpu_recovery_capable"] = _gpu_collision_recovery_capable(unit, raw_collider)
		shifted["gpu_action_phase"] = _gpu_collision_action_phase(unit, raw_collider)
		shifted["gpu_anchored"] = _unit_is_anchored_barrier(unit) if unit != null and is_instance_valid(unit) else false
		shifted["unit_velocity"] = unit.velocity if unit != null and is_instance_valid(unit) else Vector2.ZERO
		entries.append({
			"unit": unit,
			"raw": raw_collider,
			"query": shifted.duplicate(true),
			"shifted": shifted,
		})
		gpu_colliders.append(shifted)


func _gpu_collision_recovery_capable(unit, collider: Dictionary) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	var node_index := int(collider.get("node_index", collider.get("part_index", -1)))
	if node_index < 0:
		return false
	var actions = unit.get("runtime_module_actions")
	if not (actions is Array):
		return false
	for raw_action in Array(actions):
		if not (raw_action is Dictionary):
			continue
		var action: Dictionary = raw_action
		if not _runtime_node_array_has_for_gpu(Array(action.get("target_nodes", [])), node_index):
			continue
		var duration := maxf(0.001, float(action.get("duration", 0.62)))
		var phase := clampf(1.0 - float(action.get("timer", 0.0)) / duration, 0.0, 1.0)
		var startup_ratio := clampf(float(action.get("startup_ratio", 1.0 / 3.0)), 0.05, 0.95)
		if phase < startup_ratio:
			return true
	return false


func _gpu_collision_action_phase(unit, collider: Dictionary) -> float:
	if unit == null or not is_instance_valid(unit):
		return 1.0
	var node_index := int(collider.get("node_index", collider.get("part_index", -1)))
	if node_index < 0:
		return 1.0
	var actions = unit.get("runtime_module_actions")
	if not (actions is Array):
		return 1.0
	for raw_action in Array(actions):
		if not (raw_action is Dictionary):
			continue
		var action: Dictionary = raw_action
		if not _runtime_node_array_has_for_gpu(Array(action.get("target_nodes", [])), node_index):
			continue
		var duration := maxf(0.001, float(action.get("duration", 0.62)))
		return clampf(1.0 - float(action.get("timer", 0.0)) / duration, 0.0, 1.0)
	return 1.0


func _runtime_node_array_has_for_gpu(raw_nodes: Array, node_index: int) -> bool:
	for raw_node in raw_nodes:
		if int(raw_node) == node_index:
			return true
	return false


func _runtime_contact_socket_key(collider: Dictionary) -> String:
	if _runtime_collider_uses_torso_damage(collider):
		return "torso:%d:proxy" % int(collider.get("damage_proxy_torso_unit_index", collider.get("torso_unit_index", 0)))
	return "%s:%s:%d" % [String(collider.get("part_kind", "")), str(collider.get("node_index", collider.get("part_index", ""))), int(collider.get("torso_unit_index", -1))]


func _runtime_contact_sorted_colliders(colliders: Array) -> Array:
	var sorted := colliders.duplicate()
	sorted.sort_custom(Callable(self, "_runtime_contact_collider_sort"))
	return sorted


func _runtime_contact_collider_sort(a, b) -> bool:
	return _runtime_contact_collider_priority(a) < _runtime_contact_collider_priority(b)


func _runtime_contact_collider_priority(raw_collider) -> int:
	if not (raw_collider is Dictionary):
		return 999
	var collider: Dictionary = raw_collider
	var part_kind := String(collider.get("part_kind", ""))
	var independent := bool(collider.get("independent_damage", false)) and part_kind != "torso"
	if independent:
		if part_kind == "terminal":
			return 0
		return 1
	if part_kind == "torso":
		return 8
	if _runtime_collider_uses_torso_damage(collider):
		return 9
	return 5


func _runtime_contact_pair_key(a, collider_a: Dictionary, b, collider_b: Dictionary) -> String:
	var aid := int(a.get_instance_id()) if a != null and is_instance_valid(a) else 0
	var bid := int(b.get_instance_id()) if b != null and is_instance_valid(b) else 0
	var a_socket := _runtime_contact_socket_key(collider_a)
	var b_socket := _runtime_contact_socket_key(collider_b)
	if aid > bid:
		var tmp_id := aid
		aid = bid
		bid = tmp_id
		var tmp_socket := a_socket
		a_socket = b_socket
		b_socket = tmp_socket
	return "%d|%s--%d|%s" % [aid, a_socket, bid, b_socket]


func _runtime_directed_contact_key(a, collider_a: Dictionary, b, collider_b: Dictionary) -> String:
	var aid := int(a.get_instance_id()) if a != null and is_instance_valid(a) else 0
	var bid := int(b.get_instance_id()) if b != null and is_instance_valid(b) else 0
	var a_socket := _runtime_contact_socket_key(collider_a)
	var b_socket := _runtime_contact_socket_key(collider_b)
	return "%d|%s->%d|%s" % [aid, a_socket, bid, b_socket]


func _mark_active_melee_contact_suppression(attacker, attacker_collider: Dictionary, target, target_collider: Dictionary) -> void:
	if attacker == null or target == null or not is_instance_valid(attacker) or not is_instance_valid(target):
		return
	var reverse_key := _runtime_directed_contact_key(target, target_collider, attacker, attacker_collider)
	var now := Time.get_ticks_msec() * 0.001
	active_melee_contact_suppression[reverse_key] = {
		"expires": now + 2.0,
		"grace_until": now + 0.24,
		"pair_key": _runtime_contact_pair_key(attacker, attacker_collider, target, target_collider),
	}


func _active_melee_contact_damage_suppressed(attacker, attacker_collider: Dictionary, target, target_collider: Dictionary) -> bool:
	if active_melee_contact_suppression.is_empty():
		return false
	var key := _runtime_directed_contact_key(attacker, attacker_collider, target, target_collider)
	if not active_melee_contact_suppression.has(key):
		return false
	var entry = active_melee_contact_suppression.get(key, {})
	var expires := float(entry.get("expires", 0.0)) if entry is Dictionary else float(entry)
	return Time.get_ticks_msec() * 0.001 <= expires


func _cleanup_active_melee_contact_suppression() -> void:
	if active_melee_contact_suppression.is_empty():
		return
	var now := Time.get_ticks_msec() * 0.001
	for key in active_melee_contact_suppression.keys():
		var entry = active_melee_contact_suppression.get(key, {})
		var expires := float(entry.get("expires", 0.0)) if entry is Dictionary else float(entry)
		var pair_key := String(entry.get("pair_key", "")) if entry is Dictionary else ""
		var grace_until := float(entry.get("grace_until", 0.0)) if entry is Dictionary else 0.0
		if now > expires or (pair_key != "" and now > grace_until and not runtime_contact_pairs_active.has(pair_key)):
			active_melee_contact_suppression.erase(key)


func _runtime_collider_uses_torso_damage(collider: Dictionary) -> bool:
	return String(collider.get("damage_proxy", "")).to_lower() == "torso" or (collider.has("independent_damage") and not bool(collider.get("independent_damage", true)))


func _runtime_contact_part_damage_coeff(collider: Dictionary) -> float:
	if _runtime_collider_uses_torso_damage(collider):
		return PART_DAMAGE_COEFF_TORSO
	if collider.has("damage_coeff"):
		return maxf(0.0, float(collider.get("damage_coeff", 0.0)))
	match String(collider.get("part_kind", "")):
		"torso":
			return PART_DAMAGE_COEFF_TORSO
		"terminal":
			return PART_DAMAGE_COEFF_TERMINAL_RANGED if String(collider.get("terminal_weapon_kind", "")).to_lower() == "ranged" else PART_DAMAGE_COEFF_TERMINAL_MELEE
		"barrier_tile":
			return PART_DAMAGE_COEFF_BARRIER
		_:
			return PART_DAMAGE_COEFF_LIMB


func _runtime_contact_part_break_coeff(collider: Dictionary) -> float:
	if _runtime_collider_uses_torso_damage(collider):
		return PART_BREAK_COEFF_TORSO
	if collider.has("break_coeff"):
		return maxf(0.0, float(collider.get("break_coeff", 0.0)))
	match String(collider.get("part_kind", "")):
		"torso":
			return PART_BREAK_COEFF_TORSO
		"terminal":
			return PART_BREAK_COEFF_TERMINAL_RANGED if String(collider.get("terminal_weapon_kind", "")).to_lower() == "ranged" else PART_BREAK_COEFF_TERMINAL_MELEE
		"barrier_tile":
			return PART_BREAK_COEFF_BARRIER
		_:
			return PART_BREAK_COEFF_LIMB


func _runtime_contact_part_stiffness(unit, collider: Dictionary) -> float:
	if _runtime_collider_uses_torso_damage(collider):
		var mult_proxy := _collider_stiffness_size_multiplier(collider, unit)
		return PART_STIFFNESS_BASE_MOMENTUM * 2.0 * mult_proxy
	if collider.has("stiffness_momentum"):
		return maxf(1.0, float(collider.get("stiffness_momentum", 0.0)))
	var mult := _collider_stiffness_size_multiplier(collider, unit)
	match String(collider.get("part_kind", "")):
		"torso":
			return PART_STIFFNESS_BASE_MOMENTUM * 2.0 * mult
		"terminal":
			var terminal_kind := String(collider.get("terminal_weapon_kind", "")).to_lower()
			return PART_STIFFNESS_BASE_MOMENTUM * (0.8 if terminal_kind == "ranged" else 2.0) * mult
		"barrier_tile":
			return PART_STIFFNESS_BASE_MOMENTUM * mult
		_:
			return PART_STIFFNESS_BASE_MOMENTUM * mult


func _runtime_contact_path_stiffness(unit, collider: Dictionary) -> float:
	if _runtime_collider_uses_torso_damage(collider):
		var mult_proxy := _collider_stiffness_size_multiplier(collider, unit)
		return PART_STIFFNESS_BASE_MOMENTUM * 2.0 * mult_proxy
	if collider.has("path_stiffness_momentum"):
		return maxf(1.0, float(collider.get("path_stiffness_momentum", 0.0)))
	var size_mult := _collider_stiffness_size_multiplier(collider, unit)
	var torso_stiffness := PART_STIFFNESS_BASE_MOMENTUM * 2.0 * size_mult
	var limb_stiffness := PART_STIFFNESS_BASE_MOMENTUM * size_mult
	var part_stiffness := _runtime_contact_part_stiffness(unit, collider)
	match String(collider.get("part_kind", "")):
		"torso":
			return part_stiffness
		"terminal":
			return maxf(1.0, minf(part_stiffness, minf(limb_stiffness, torso_stiffness)))
		"barrier_tile":
			return part_stiffness
		_:
			return maxf(1.0, minf(part_stiffness, torso_stiffness))


func _runtime_contact_break_threshold(unit, collider: Dictionary) -> float:
	return maxf(0.5, _runtime_contact_path_stiffness(unit, collider) * _runtime_contact_part_break_coeff(collider) * BREAK_STIFFNESS_SCALE)


func _runtime_contact_damage_type(collider: Dictionary) -> String:
	if _runtime_collider_uses_torso_damage(collider):
		return "blunt"
	var damage_type := String(collider.get("damage_type", "blunt"))
	if not MELEE_DAMAGE_TYPES.has(damage_type):
		return "blunt"
	return damage_type


func _runtime_contact_material_class(collider: Dictionary) -> String:
	if _runtime_collider_uses_torso_damage(collider):
		return "body"
	var material_class := String(collider.get("material_class", "body"))
	if material_class == "gun" or material_class == "missile_launcher" or material_class == "web_gun":
		return "body"
	return material_class


func _apply_runtime_contact_damage(attacker, attacker_collider: Dictionary, target, target_collider: Dictionary, normal: Vector2, contact_momentum: float, hit_position: Vector2, contact_source: String = "runtime_contact") -> void:
	if contact_momentum <= 0.001 or not _is_live_unit(attacker) or not _is_live_unit(target):
		return
	var damage_type := _runtime_contact_damage_type(attacker_collider)
	var material_class := _runtime_contact_material_class(attacker_collider)
	var attacker_path_stiffness := _runtime_contact_path_stiffness(attacker, attacker_collider)
	var usable_momentum := minf(contact_momentum, attacker_path_stiffness)
	var damage_float := usable_momentum * _runtime_contact_part_damage_coeff(attacker_collider) * CONTACT_DAMAGE_SCALE
	damage_float *= _vulnerability_multiplier(target, {
		"damage_type": damage_type,
		"passive_contact": true,
		"runtime_contact": true,
	})
	if damage_float <= 0.001:
		return
	var threshold := _runtime_contact_break_threshold(target, target_collider)
	var event := {
		"state": "normal",
		"projectile": false,
		"passive_contact": true,
		"runtime_contact": true,
		"contact_source": contact_source,
		"contact_node_key": _runtime_contact_socket_key(attacker_collider),
		"contact_segment_key": "%s:%s" % [String(attacker_collider.get("part_kind", "")), str(attacker_collider.get("node_index", attacker_collider.get("part_index", "")))],
		"contact_pair_key": _runtime_directed_contact_key(attacker, attacker_collider, target, target_collider),
		"damage_resolution_part": _runtime_contact_socket_key(target_collider),
		"damage_type": damage_type,
		"material_class": material_class,
		"direction": normal,
		"momentum": usable_momentum,
		"momentum_vector": normal * usable_momentum,
		"momentum_magnitude": usable_momentum,
		"raw_momentum": contact_momentum,
		"usable_contact_momentum": usable_momentum,
		"attacker_path_stiffness": attacker_path_stiffness,
		"target_path_stiffness": _runtime_contact_path_stiffness(target, target_collider),
		"break_threshold": threshold,
		"damage_after_break": damage_float,
		"contact_damage": damage_float,
		"target_part_index": int(target_collider.get("part_index", -1)),
		"target_part_kind": String(target_collider.get("part_kind", "core")),
		"target_part_name": String(target_collider.get("name", "CORE")),
		"target_torso_unit_index": int(target_collider.get("torso_unit_index", -1)),
		"attacker_part_index": int(attacker_collider.get("part_index", -1)),
		"attacker_part_kind": String(attacker_collider.get("part_kind", "")),
		"attacker_terminal_weapon_kind": String(attacker_collider.get("terminal_weapon_kind", "")),
		"hit_position_combat": hit_position,
	}
	if damage_float < threshold:
		_spawn_hit_effect(target, 1, damage_type, true, "threshold", hit_position)
		return
	var damage: int = max(1, int(roundf(damage_float)))
	damage = _melee_damage_adjusted(event, damage)
	if damage <= 0:
		return
	var counter_tier := _counter_tier_for_hit(target, damage_type)
	_spawn_hit_effect(target, 0, damage_type, false, "impact", hit_position)
	_apply_hitstop(damage_type, counter_tier, damage)
	var killed: bool = target.take_hit(damage, "normal", int(attacker.owner_id), damage_type, material_class)
	if not killed and _is_back_hit(attacker, target, event):
		_apply_back_hit_heat(attacker, target, event, damage)
	if killed:
		_handle_unit_killed(target, int(attacker.owner_id))


func _force_runtime_collision_recovery(unit, collider: Dictionary) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	if unit.has_method("force_runtime_recovery_from_collision"):
		unit.force_runtime_recovery_from_collision(int(collider.get("node_index", collider.get("part_index", -1))))


func _request_runtime_collision_brake(unit) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	if unit.has_method("request_collision_auto_brake"):
		unit.request_collision_auto_brake()


func _apply_runtime_contact_velocity_response(a, b, normal: Vector2, contact_momentum: float) -> void:
	if contact_momentum <= 0.001 or normal.length() <= 0.001:
		return
	var direction := normal.normalized()
	var mass_a := maxf(1.0, _unit_effective_mass(a))
	var mass_b := maxf(1.0, _unit_effective_mass(b))
	if not _unit_is_anchored_barrier(a):
		a.velocity -= direction * (contact_momentum / mass_a)
	if not _unit_is_anchored_barrier(b):
		b.velocity += direction * (contact_momentum / mass_b)
	_request_runtime_collision_brake(a)
	_request_runtime_collision_brake(b)


func _resolve_runtime_contact_pair_once(a, raw_collider_a: Dictionary, collider_a: Dictionary, b, raw_collider_b: Dictionary, collider_b: Dictionary, normal_a_to_b: Vector2, penetration: float, deferred_velocity_responses = null) -> void:
	if normal_a_to_b.length() <= 0.001 or not _is_live_unit(a) or not _is_live_unit(b):
		return
	var key := _runtime_contact_pair_key(a, raw_collider_a, b, raw_collider_b)
	runtime_contact_pairs_seen[key] = true
	if runtime_contact_pairs_active.has(key):
		return
	var normal := normal_a_to_b.normalized()
	var velocity_a := _contact_collider_velocity(a, raw_collider_a)
	var velocity_b := _contact_collider_velocity(b, raw_collider_b)
	var closing_speed := maxf(0.0, (velocity_a - velocity_b).dot(normal))
	if closing_speed < PASSIVE_CONTACT_MIN_SPEED:
		return
	var mass_a := maxf(1.0, _unit_effective_mass(a))
	var mass_b := maxf(1.0, _unit_effective_mass(b))
	var contact_momentum := closing_speed * (mass_a + mass_b)
	if contact_momentum <= 0.001:
		return
	runtime_contact_pairs_active[key] = true
	var hit_position := _collider_hit_position(collider_a, collider_b)
	var response_momentum := minf(contact_momentum, minf(_runtime_contact_path_stiffness(a, raw_collider_a), _runtime_contact_path_stiffness(b, raw_collider_b)))
	_force_runtime_collision_recovery(a, raw_collider_a)
	_force_runtime_collision_recovery(b, raw_collider_b)
	var source_a := _runtime_contact_source_for_collider(raw_collider_a)
	var source_b := _runtime_contact_source_for_collider(raw_collider_b)
	var allow_a_damage := true
	var allow_b_damage := true
	if source_a == "active_module_contact" and source_b != "active_module_contact":
		allow_b_damage = false
	elif source_b == "active_module_contact" and source_a != "active_module_contact":
		allow_a_damage = false
	if allow_a_damage and not _active_melee_contact_damage_suppressed(a, raw_collider_a, b, raw_collider_b):
		_apply_runtime_contact_damage(a, raw_collider_a, b, raw_collider_b, normal, contact_momentum, hit_position, source_a)
	if _is_live_unit(a) and _is_live_unit(b):
		if allow_b_damage and not _active_melee_contact_damage_suppressed(b, raw_collider_b, a, raw_collider_a):
			_apply_runtime_contact_damage(b, raw_collider_b, a, raw_collider_a, -normal, contact_momentum, hit_position, source_b)
	if _is_live_unit(a) and _is_live_unit(b):
		if deferred_velocity_responses is Array:
			deferred_velocity_responses.append({
				"a": a,
				"b": b,
				"normal": normal,
				"momentum": response_momentum,
			})
		else:
			_apply_runtime_contact_velocity_response(a, b, normal, response_momentum)


func _flush_runtime_contact_velocity_responses(responses: Array) -> void:
	for raw_response in responses:
		if not (raw_response is Dictionary):
			continue
		var response: Dictionary = raw_response
		var a = response.get("a", null)
		var b = response.get("b", null)
		if a == null or b == null or not is_instance_valid(a) or not is_instance_valid(b):
			continue
		if not _is_live_unit(a) or not _is_live_unit(b):
			continue
		var normal: Vector2 = response.get("normal", Vector2.ZERO)
		var momentum := float(response.get("momentum", 0.0))
		_apply_runtime_contact_velocity_response(a, b, normal, momentum)
	responses.clear()


func _runtime_contact_source_for_collider(collider: Dictionary) -> String:
	if bool(collider.get("independent_damage", false)) and String(collider.get("part_kind", "")) != "torso":
		return "active_module_contact"
	return "default_body_contact"


func _resolve_passive_contact_pair(a, raw_collider_a: Dictionary, collider_a: Dictionary, b, raw_collider_b: Dictionary, collider_b: Dictionary, normal_a_to_b: Vector2, penetration: float, delta: float) -> void:
	if delta <= 0.0 or normal_a_to_b.length() <= 0.001:
		return
	var same_owner := int(a.owner_id) == int(b.owner_id)
	var combo_same_owner_transfer := same_owner and _combo_contact_can_affect_same_owner(a, b)
	if same_owner and not combo_same_owner_transfer:
		return
	_resolve_passive_contact_hit(a, raw_collider_a, collider_a, b, raw_collider_b, collider_b, normal_a_to_b.normalized(), penetration, delta, combo_same_owner_transfer)
	if _is_live_unit(a) and _is_live_unit(b):
		_resolve_passive_contact_hit(b, raw_collider_b, collider_b, a, raw_collider_a, collider_a, -normal_a_to_b.normalized(), penetration, delta, combo_same_owner_transfer)


func _contact_momentum_for_stagger(unit, collider: Dictionary, toward_direction: Vector2) -> float:
	if unit == null or not is_instance_valid(unit) or toward_direction.length() <= 0.001:
		return 0.0
	var dir := toward_direction.normalized()
	var velocity := _contact_collider_velocity(unit, collider)
	var normal_speed := maxf(0.0, velocity.dot(dir))
	var tangent := Vector2(-dir.y, dir.x)
	var scrape_speed := absf(velocity.dot(tangent)) * _passive_contact_scrape_factor(collider) * 0.35
	var profile := _passive_contact_profile(unit, collider)
	var terminal_momentum_mult := _terminal_momentum_multiplier(profile)
	var raw_momentum := _unit_effective_mass(unit) * (normal_speed + scrape_speed) * terminal_momentum_mult
	return _combo_transfer_adjusted_momentum(unit, raw_momentum)


func _combo_transfer_momentum_cap(unit) -> float:
	if unit == null or not is_instance_valid(unit) or not _combo_opportunity_active(unit):
		return 0.0
	return maxf(0.0, float(unit.get_meta("combo_transfer_momentum_cap", unit.get_meta("stagger_combo_opening_momentum", 0.0))))


func _combo_transfer_momentum_scale(unit, raw_momentum: float) -> float:
	var cap := _combo_transfer_momentum_cap(unit)
	if cap <= 0.0 or raw_momentum <= cap:
		return 1.0
	return clampf(cap / maxf(0.001, raw_momentum), 0.0, 1.0)


func _combo_transfer_adjusted_momentum(unit, raw_momentum: float) -> float:
	return raw_momentum * _combo_transfer_momentum_scale(unit, raw_momentum)


func _combo_contact_victim(a, b):
	if _combo_opportunity_active(a):
		return a
	if _combo_opportunity_active(b):
		return b
	return null


func _combo_contact_has_participating_attacker(a, b) -> bool:
	var victim = _combo_contact_victim(a, b)
	if victim == null or not is_instance_valid(victim):
		return false
	var other = b if victim == a else a
	if other == null or not is_instance_valid(other):
		return false
	var attacker_hits: Dictionary = victim.get_meta("stagger_combo_attacker_hits", {})
	return attacker_hits.has(_combo_attacker_key(other))


func _combo_contact_can_affect_same_owner(a, b) -> bool:
	var victim = _combo_contact_victim(a, b)
	if victim == null or not is_instance_valid(victim):
		return false
	return not _combo_contact_has_participating_attacker(a, b)


func _combo_opportunity_active(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	return bool(unit.get_meta("stagger_combo_active", false)) and float(unit.get_meta("melee_stagger_timer", 0.0)) > 0.0


func _clear_combo_opportunity(unit) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	unit.set_meta("stagger_combo_active", false)
	unit.set_meta("stagger_combo_base_duration", 0.0)
	unit.set_meta("stagger_combo_total_hits", 0)
	unit.set_meta("stagger_combo_attacker_hits", {})
	unit.set_meta("stagger_combo_opening_momentum", 0.0)
	unit.set_meta("combo_transfer_momentum_cap", 0.0)


func _clear_combo_opportunity_if_expired(unit) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	if bool(unit.get_meta("stagger_combo_active", false)) and float(unit.get_meta("melee_stagger_timer", 0.0)) <= 0.0:
		_clear_combo_opportunity(unit)


func _set_unit_stagger_timer(unit, duration: float) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	var next_duration := maxf(0.0, duration)
	unit.set("melee_stagger_timer", next_duration)
	unit.set_meta("melee_stagger_timer", next_duration)
	unit.set("action_cooldown", maxf(float(unit.get("action_cooldown")), next_duration))


func _combo_attacker_key(attacker) -> String:
	if attacker == null or not is_instance_valid(attacker):
		return "none"
	return str(int(attacker.get_instance_id()))


func _open_stagger_combo(staggered, source_attacker, base_duration: float, initial_hit_counts: bool, opening_momentum: float = 0.0) -> void:
	if staggered == null or not is_instance_valid(staggered):
		return
	var duration := maxf(COMBO_REFRESH_FLOOR_SECONDS, base_duration)
	var serial := int(staggered.get_meta("stagger_combo_serial", 0)) + 1
	var attacker_hits := {}
	var total_hits := 0
	var momentum_cap := maxf(0.0, opening_momentum)
	if initial_hit_counts and source_attacker != null and is_instance_valid(source_attacker) and _unit_role_is_mech(source_attacker):
		attacker_hits[_combo_attacker_key(source_attacker)] = 1
		total_hits = 1
	if momentum_cap <= 0.0:
		momentum_cap = maxf(0.0, float(staggered.get_meta("last_melee_stagger_gap", 0.0)))
	staggered.set_meta("stagger_combo_serial", serial)
	staggered.set_meta("stagger_combo_active", true)
	staggered.set_meta("stagger_combo_id", serial)
	staggered.set_meta("stagger_combo_base_duration", duration)
	staggered.set_meta("stagger_combo_total_hits", total_hits)
	staggered.set_meta("stagger_combo_attacker_hits", attacker_hits)
	staggered.set_meta("stagger_combo_opening_momentum", momentum_cap)
	staggered.set_meta("combo_transfer_momentum_cap", momentum_cap)
	staggered.set_meta("stagger_combo_last_refresh", Time.get_ticks_msec() * 0.001)


func _refresh_stagger_combo(unit) -> void:
	if not _combo_opportunity_active(unit):
		return
	var base_duration := maxf(COMBO_REFRESH_FLOOR_SECONDS, float(unit.get_meta("stagger_combo_base_duration", 0.0)))
	_set_unit_stagger_timer(unit, base_duration)
	unit.set_meta("stagger_combo_last_refresh", Time.get_ticks_msec() * 0.001)


func _combo_damage_multiplier(hit_index: int) -> float:
	if hit_index <= 1:
		return 1.0
	var t := clampf(float(hit_index - 1) / float(COMBO_SCALING_MAX_HITS - 1), 0.0, 1.0)
	return lerpf(1.0, COMBO_DAMAGE_MIN_MULT, pow(t, COMBO_DAMAGE_CURVE_POWER))


func _combo_knock_multiplier(hit_index: int) -> float:
	if hit_index <= 1:
		return 1.0
	var t := clampf(float(hit_index - 1) / float(COMBO_SCALING_MAX_HITS - 1), 0.0, 1.0)
	return lerpf(1.0, COMBO_KNOCK_MAX_MULT, pow(t, COMBO_KNOCK_CURVE_POWER))


func _apply_combo_hit_scaling(attacker, target, event: Dictionary, damage: int) -> int:
	event["combo_active"] = false
	event["combo_damage_mult"] = 1.0
	event["combo_knock_mult"] = 1.0
	if damage <= 0 or not _combo_opportunity_active(target) or not _unit_role_is_mech(attacker) or not _unit_role_is_mech(target):
		return damage
	var attacker_key := _combo_attacker_key(attacker)
	var attacker_hits: Dictionary = target.get_meta("stagger_combo_attacker_hits", {})
	var attacker_count := int(attacker_hits.get(attacker_key, 0))
	event["combo_unscaled_damage"] = damage
	event["combo_opening_momentum"] = float(target.get_meta("stagger_combo_opening_momentum", 0.0))
	var total_hits := int(target.get_meta("stagger_combo_total_hits", 0)) + 1
	attacker_hits[attacker_key] = attacker_count + 1
	target.set_meta("stagger_combo_total_hits", total_hits)
	target.set_meta("stagger_combo_attacker_hits", attacker_hits)
	_refresh_stagger_combo(target)
	var scaled_index := clampi(total_hits, 1, COMBO_SCALING_MAX_HITS)
	var damage_mult := _combo_damage_multiplier(scaled_index)
	var knock_mult := _combo_knock_multiplier(scaled_index)
	event["combo_active"] = true
	event["combo_hit_index"] = total_hits
	event["combo_attacker_hits"] = attacker_count + 1
	event["combo_damage_mult"] = damage_mult
	event["combo_knock_mult"] = knock_mult
	if total_hits >= 2:
		_show_battle_message("%s COMBO x%d DMG %.0f%% KB %.0f%%" % [target.unit_name, total_hits, damage_mult * 100.0, knock_mult * 100.0], 0.34)
	return maxi(1, int(roundf(float(damage) * damage_mult)))


func _combo_knock_multiplier_for_event(event: Dictionary) -> float:
	return clampf(float(event.get("combo_knock_mult", 1.0)), 1.0, COMBO_KNOCK_MAX_MULT)


func _event_vector_value(event: Dictionary, key: String) -> Vector2:
	if event.has(key) and event[key] is Vector2:
		var value: Vector2 = event[key]
		return value
	return Vector2.ZERO


func _set_event_momentum_vector(event: Dictionary, vector: Vector2, magnitude: float = -1.0) -> void:
	var resolved_magnitude := magnitude if magnitude >= 0.0 else vector.length()
	event["momentum_vector"] = vector
	event["momentum_magnitude"] = resolved_magnitude
	if resolved_magnitude > 0.001 and vector.length() > 0.001:
		event["direction"] = vector.normalized()


func _event_direction_vector(attacker, target, event: Dictionary, fallback: Vector2 = Vector2.RIGHT) -> Vector2:
	var momentum_vector := _event_vector_value(event, "momentum_vector")
	if momentum_vector.length() > 0.001:
		return momentum_vector.normalized()
	var event_direction := _event_vector_value(event, "direction")
	if event_direction.length() > 0.001:
		return event_direction.normalized()
	if attacker != null and is_instance_valid(attacker) and target != null and is_instance_valid(target):
		var target_delta := _mobius_delta_vec_between(attacker, target)
		if target_delta.length() > 0.001:
			return target_delta.normalized()
	if attacker != null and is_instance_valid(attacker):
		var forward := _unit_forward_vector(attacker)
		if forward.length() > 0.001:
			return forward.normalized()
	if fallback.length() > 0.001:
		return fallback.normalized()
	return Vector2.RIGHT


func _event_momentum_magnitude(event: Dictionary, fallback: float = 0.0) -> float:
	var momentum_vector := _event_vector_value(event, "momentum_vector")
	if momentum_vector.length() > 0.001:
		return momentum_vector.length()
	if event.has("momentum_magnitude"):
		return maxf(0.0, float(event.get("momentum_magnitude", fallback)))
	if event.has("momentum"):
		return maxf(0.0, float(event.get("momentum", fallback)))
	return maxf(0.0, fallback)


func _apply_active_melee_momentum_stagger(attacker, target, event: Dictionary) -> void:
	if bool(event.get("projectile", false)) or not _unit_role_is_mech(attacker) or not _unit_role_is_mech(target):
		return
	if _combo_opportunity_active(target):
		return
	var direction := _event_direction_vector(attacker, target, event, Vector2(float(attacker.facing), 0.0))
	var attacker_momentum := _event_momentum_magnitude(event, maxf(0.0, float(event.get("momentum", 0.0))))
	var target_momentum := _unit_effective_mass(target) * maxf(0.0, -target.velocity.dot(direction))
	var target_collider := _target_collider_for_stagger(target, event, attacker.ring_pos)
	if not target_collider.is_empty():
		target_momentum = maxf(target_momentum, _contact_momentum_for_stagger(target, target_collider, -direction))
	attacker_momentum *= maxf(0.1, float(event.get("crush_stagger_mult", 1.0)))
	_apply_melee_momentum_stagger_pair(attacker, attacker_momentum, target, target_momentum, direction, "attack")


func _mark_module_variant_hit(attacker, event: Dictionary) -> void:
	if not _is_live_unit(attacker):
		return
	var variant_key := String(event.get("module_variant_key", ""))
	if variant_key == "":
		return
	event["module_variant_hit_confirmed"] = true
	if attacker.has_method("mark_runtime_module_variant_hit"):
		attacker.mark_runtime_module_variant_hit(int(event.get("attack_key", int(event.get("muscle_node", 0)) + 1)), variant_key)
	attacker.set_meta("last_module_variant_hit_key", variant_key)


func _apply_module_variant_hit_effect(attacker, target, event: Dictionary) -> void:
	var variant_key := String(event.get("module_variant_key", ""))
	if variant_key == "":
		return
	_mark_module_variant_hit(attacker, event)
	match variant_key:
		"vise_close":
			if _is_live_unit(target):
				var seconds := maxf(0.0, float(event.get("clamp_pin_seconds", 0.0)))
				var velocity_mult := clampf(float(event.get("clamp_velocity_mult", 0.35)), 0.05, 1.0)
				if target.has_method("apply_clamp_pin"):
					target.apply_clamp_pin(seconds, velocity_mult)
				else:
					target.velocity *= velocity_mult
					target.set_meta("clamp_pin_timer", maxf(float(target.get_meta("clamp_pin_timer", 0.0)), seconds))
					if seconds > 0.0 and target.get("action_cooldown") != null:
						target.action_cooldown = maxf(float(target.action_cooldown), seconds * 0.35)
		"pickup_dash":
			if _is_live_unit(attacker):
				var direction := _event_direction_vector(attacker, target, event, _unit_forward_vector(attacker))
				var impulse := maxf(0.0, float(event.get("pickup_dash_on_hit_impulse", 0.0)))
				if direction.length() > 0.001 and impulse > 0.0:
					attacker.velocity += direction.normalized() * impulse
					attacker.set_meta("last_pickup_dash_hit_impulse", impulse)


func _projectile_behavior_key(event: Dictionary) -> String:
	var behavior := _projectile_behavior_for_data(event)
	var style := String(event.get("projectile_style", ""))
	var damage_type := String(event.get("damage_type", event.get("projectile_damage_type", "bullet")))
	if behavior == "true_bullet" or style == "true_bullet":
		return "true_bullet"
	if behavior == "explosive" or style in ["explosive", "blast", "missile"]:
		return "explosive"
	if behavior == "bullet_hell" or style == "bullet_hell":
		return "bullet_hell"
	if damage_type == "laser" or style in ["beam", "chaos"]:
		return "laser"
	if damage_type == "chemical" or style == "spray":
		return "chemical"
	if damage_type == "bullet":
		return "bullet_hell"
	return ""


func _projectile_default_momentum_for_event(event: Dictionary) -> float:
	match _projectile_behavior_key(event):
		"true_bullet":
			return PROJECTILE_MOMENTUM_TRUE_BULLET
		"explosive":
			return PROJECTILE_MOMENTUM_EXPLOSIVE
		"bullet_hell":
			return PROJECTILE_MOMENTUM_BULLET_HELL
		"laser":
			return PROJECTILE_MOMENTUM_LASER
		"chemical":
			return PROJECTILE_MOMENTUM_CHEMICAL
	return 0.0


func _projectile_collision_speed_for_event(event: Dictionary) -> float:
	if not bool(event.get("projectile", false)):
		return 0.0
	if float(event.get("projectile_collision_speed", 0.0)) > 0.0:
		return maxf(0.0, float(event["projectile_collision_speed"]))
	match _projectile_behavior_key(event):
		"true_bullet":
			return PROJECTILE_SPEED_TRUE_BULLET
		"laser":
			return PROJECTILE_SPEED_LASER
		"explosive":
			return clampf(float(event.get("projectile_speed_mult", 1.6)), 0.9, 2.4) * PROJECTILE_SPEED_UNIT
		"bullet_hell":
			return clampf(float(event.get("projectile_speed_mult", BULLET_HELL_DEFAULT_SPEED_MULT)), 1.5, 5.0) * PROJECTILE_SPEED_UNIT
		"chemical":
			return clampf(float(event.get("projectile_speed_mult", CHEMICAL_PROJECTILE_DEFAULT_SPEED_MULT)), 0.35, 1.45) * PROJECTILE_SPEED_UNIT
	return PROJECTILE_SPEED_UNIT


func _projectile_mass_for_event(event: Dictionary, collision_speed: float = -1.0) -> float:
	if not bool(event.get("projectile", false)):
		return 0.0
	if float(event.get("projectile_mass", 0.0)) > 0.0:
		return maxf(0.0, float(event["projectile_mass"]))
	var speed := collision_speed if collision_speed > 0.0 else _projectile_collision_speed_for_event(event)
	if event.has("projectile_momentum") and float(event.get("projectile_momentum", 0.0)) > 0.0 and speed > 0.001:
		return maxf(0.01, float(event["projectile_momentum"]) * _projectile_drive_momentum_mult_for_event(event) / speed)
	match _projectile_behavior_key(event):
		"true_bullet":
			return PROJECTILE_MASS_TRUE_BULLET
		"explosive":
			return PROJECTILE_MASS_EXPLOSIVE
		"bullet_hell":
			return PROJECTILE_MASS_BULLET_HELL
		"laser":
			return PROJECTILE_MASS_LASER
		"chemical":
			return PROJECTILE_MASS_CHEMICAL
	return 1.0


func _projectile_velocity_vector_for_event(attacker, target, event: Dictionary) -> Vector2:
	if not bool(event.get("projectile", false)):
		return Vector2.ZERO
	var speed := _projectile_collision_speed_for_event(event)
	var direction := _event_direction_vector(attacker, target, event, _unit_forward_vector(attacker) if attacker != null and is_instance_valid(attacker) else Vector2.RIGHT)
	return direction * speed


func _projectile_collision_momentum(attacker, target, event: Dictionary, momentum_scale: float = 1.0) -> float:
	if not bool(event.get("projectile", false)):
		return 0.0
	var projectile_velocity := _projectile_velocity_vector_for_event(attacker, target, event)
	var projectile_speed := projectile_velocity.length()
	var projectile_direction := projectile_velocity.normalized() if projectile_speed > 0.001 else _event_direction_vector(attacker, target, event)
	var target_velocity := Vector2.ZERO
	if target != null and is_instance_valid(target):
		target_velocity = target.velocity
		var target_collider := _target_collider_for_stagger(target, event, attacker.ring_pos if attacker != null and is_instance_valid(attacker) else target.ring_pos)
		if not target_collider.is_empty():
			target_velocity = _contact_collider_velocity(target, target_collider)
	var relative_velocity := projectile_velocity - target_velocity
	var closing_speed := maxf(0.0, relative_velocity.dot(projectile_direction))
	var projectile_mass := _projectile_mass_for_event(event, projectile_speed)
	var explicit_momentum := _projectile_momentum_for_event(event)
	var momentum := projectile_mass * closing_speed * maxf(0.0, momentum_scale)
	if explicit_momentum > 0.0 and _projectile_behavior_key(event) == "true_bullet":
		momentum = explicit_momentum * maxf(0.0, momentum_scale)
	event["projectile_mass"] = projectile_mass
	event["projectile_collision_speed"] = projectile_speed
	event["projectile_velocity_vector"] = projectile_velocity
	event["projectile_target_velocity_vector"] = target_velocity
	event["projectile_relative_velocity_vector"] = relative_velocity
	event["projectile_closing_speed"] = closing_speed
	event["projectile_momentum_resolved"] = momentum
	event["momentum"] = momentum
	_set_event_momentum_vector(event, projectile_direction * momentum, momentum)
	return momentum


func _projectile_momentum_for_event(event: Dictionary) -> float:
	if not bool(event.get("projectile", false)):
		return 0.0
	if float(event.get("projectile_momentum", 0.0)) > 0.0:
		var effective := maxf(0.0, float(event.get("projectile_momentum", 0.0)) * _projectile_drive_momentum_mult_for_event(event))
		event["projectile_base_momentum"] = maxf(0.0, float(event.get("projectile_momentum", 0.0)))
		event["projectile_drive_momentum_mult"] = _projectile_drive_momentum_mult_for_event(event)
		event["projectile_effective_momentum"] = effective
		return effective
	var speed := _projectile_collision_speed_for_event(event)
	var mass := _projectile_mass_for_event(event, speed)
	return maxf(0.0, mass * speed)


func _ammo_damage_coeff_for_data(_data: Dictionary) -> float:
	return 1.0


func _gun_projectile_damage_mult_max_for_data(data: Dictionary) -> float:
	if bool(data.get("non_damage", false)):
		return 0.0
	if data.has("gun_projectile_damage_mult"):
		return maxf(0.0, float(data.get("gun_projectile_damage_mult", 0.0)))
	var gun_kind := String(data.get("gun_kind", _gun_kind_for_data(data))).to_lower()
	var ammo_kind := String(data.get("ammo_kind", _ammo_kind_for_data(data))).to_lower()
	match gun_kind:
		"sniper":
			return STANDARD_SNIPER_GUN_DAMAGE_COEFF
		"rifle":
			return 4.0
		"laser_gun":
			return 3.0
		"sprayer":
			return 2.0
		"grenade_launcher":
			return 4.0
		"missile_launcher":
			return 5.0
		"web_gun":
			return 0.0
	match ammo_kind:
		"laser":
			return 3.0
		"chemical":
			return 2.0
		"explosive":
			return 4.0
		"web":
			return 0.0
	return 1.0


func _gun_projectile_damage_mult_for_event(event: Dictionary) -> float:
	if bool(event.get("non_damage", false)):
		return 0.0
	if event.has("gun_projectile_damage_mult_current") and not event.has("gun_drive_allocated") and not event.has("gun_drive_max"):
		return maxf(0.0, float(event.get("gun_projectile_damage_mult_current", 0.0)))
	var max_mult := _gun_projectile_damage_mult_max_for_data(event)
	var max_drive := maxf(0.0, float(event.get("gun_drive_max", event.get("momentum_max", 0.0))))
	var allocated := clampf(float(event.get("gun_drive_allocated", max_drive)), 0.0, max_drive)
	return data_rule_service.gun_current_multiplier(max_mult, allocated, max_drive, false) if data_rule_service != null else DataRuleService.new().gun_current_multiplier(max_mult, allocated, max_drive, false)


func _gun_damage_coeff_for_data(data: Dictionary) -> float:
	return _gun_projectile_damage_mult_max_for_data(data)


func _projectile_damage_coeffs_for_event(event: Dictionary) -> Dictionary:
	var gun_mult := _gun_projectile_damage_mult_for_event(event)
	event["gun_projectile_damage_mult_current"] = gun_mult
	event["gun_projectile_damage_mult"] = _gun_projectile_damage_mult_max_for_data(event)
	return {"ammo": 1.0, "gun": gun_mult}


func _projectile_raw_damage_for_event(attacker, target, event: Dictionary) -> float:
	var projectile_momentum := _projectile_collision_momentum(attacker, target, event)
	if projectile_momentum <= 0.0:
		return 0.0
	var coeffs := _projectile_damage_coeffs_for_event(event)
	return projectile_momentum * float(coeffs.get("gun", 1.0))


func _default_recoil_transfer_for_projectile(event: Dictionary) -> float:
	match _projectile_behavior_key(event):
		"true_bullet":
			return 0.85
		"explosive":
			return 1.0
		"bullet_hell":
			return 0.7
		"laser":
			return 0.35
		"chemical":
			return 0.55
	return 0.65


func _apply_weapon_recoil_from_momentum(shooter, event: Dictionary) -> void:
	if not _is_live_unit(shooter) or not bool(event.get("projectile", false)):
		return
	if bool(event.get("weapon_recoil_applied", false)):
		return
	var projectile_velocity := _projectile_velocity_vector_for_event(shooter, null, event)
	if projectile_velocity.length() <= 0.001:
		return
	var launch_momentum := _projectile_momentum_for_event(event)
	if launch_momentum <= 0.001:
		return
	var shooter_mass := _unit_effective_mass(shooter)
	var recoil_amount := launch_momentum / maxf(1.0, shooter_mass)
	if recoil_amount <= 0.0001:
		return
	var direction := projectile_velocity.normalized()
	event["weapon_recoil_momentum"] = launch_momentum
	event["weapon_recoil_amount"] = recoil_amount
	event["weapon_recoil_direction"] = -direction
	event["weapon_recoil_applied"] = true
	if shooter.has_method("apply_projectile_recoil"):
		shooter.apply_projectile_recoil(direction, launch_momentum)
	elif shooter.has_method("apply_recoil"):
		shooter.apply_recoil(direction, recoil_amount, false)


func _apply_projectile_momentum_stagger(attacker, target, event: Dictionary, momentum_scale: float = 1.0) -> void:
	if not bool(event.get("projectile", false)) or not _unit_role_is_mech(target):
		return
	if _combo_opportunity_active(target):
		return
	var projectile_momentum := _projectile_collision_momentum(attacker, target, event, momentum_scale)
	var direction := _event_direction_vector(attacker, target, event, Vector2(float(target.facing), 0.0))
	if projectile_momentum < MELEE_STAGGER_MIN_MOMENTUM:
		return
	var threshold := _unit_melee_stability_threshold(target)
	var gap := projectile_momentum - threshold
	if gap <= 0.0:
		return
	var now := Time.get_ticks_msec() * 0.001
	if now < float(target.get_meta("melee_stagger_gate_until", 0.0)):
		return
	var ratio := gap / maxf(MELEE_STABILITY_THRESHOLD_FLOOR, threshold)
	var duration := clampf(MELEE_STAGGER_BASE_SECONDS + ratio * PROJECTILE_STAGGER_RATIO_SECONDS, 0.0, PROJECTILE_STAGGER_MAX_SECONDS)
	if duration <= 0.025:
		return
	target.set_meta("melee_stagger_gate_until", now + MELEE_STAGGER_GATE_SECONDS)
	if target.has_method("apply_melee_stagger"):
		target.apply_melee_stagger(duration, gap, threshold)
	else:
		target.action_cooldown = maxf(float(target.action_cooldown), duration)
		target.set_meta("melee_stagger_timer", duration)
	var actual_duration := maxf(duration, float(target.get_meta("melee_stagger_timer", duration)))
	_open_stagger_combo(target, attacker, actual_duration, true, projectile_momentum)
	var impact_combat := Vector2(target.ring_pos, target.lane)
	if event.has("hit_position_combat") and event["hit_position_combat"] is Vector2:
		impact_combat = event["hit_position_combat"]
	elif event.has("projectile_impact_position") and event["projectile_impact_position"] is Vector2:
		impact_combat = event["projectile_impact_position"]
	_apply_local_hitstop(attacker, target, MELEE_STAGGER_HITSTOP_SECONDS)
	_spawn_combo_ripple(impact_combat, int(target.owner_id), clampf(actual_duration / maxf(0.1, PROJECTILE_STAGGER_MAX_SECONDS), 0.75, 1.35))
	var impulse := clampf((projectile_momentum - threshold) * 0.0028, 0.025, 0.42)
	target.velocity += direction * impulse * _unit_impulse_motion_mult(target)
	if target.has_method("apply_physics_impulse"):
		target.apply_physics_impulse(direction, impulse, int(event.get("target_part_index", -1)), 0.0)
	_show_battle_message("%s %s %.2fs / P-MOM %.0f" % [target.unit_name, "远程硬直" if _ui_is_zh() else "PROJECTILE STAGGER", duration, projectile_momentum], 0.42)


func _target_collider_for_stagger(target, event: Dictionary, origin_x: float) -> Dictionary:
	if target == null or not is_instance_valid(target):
		return {}
	var part_index := int(event.get("target_part_index", -999))
	var part_kind := String(event.get("target_part_kind", ""))
	var torso_index := int(event.get("target_torso_unit_index", -999))
	for raw_collider in _unit_part_colliders(target):
		if not (raw_collider is Dictionary):
			continue
		var collider: Dictionary = raw_collider
		if part_kind != "" and String(collider.get("part_kind", "")) != part_kind:
			continue
		if part_index != -999 and int(collider.get("part_index", -999)) != part_index:
			continue
		if torso_index != -999 and int(collider.get("torso_unit_index", -999)) != torso_index:
			continue
		return collider
	return {}


func _apply_melee_momentum_stagger_pair(a, momentum_a: float, b, momentum_b: float, normal_a_to_b: Vector2, source: String, initial_hit_counts: bool = true) -> void:
	if not _unit_role_is_mech(a) or not _unit_role_is_mech(b):
		return
	var gap := absf(momentum_a - momentum_b)
	if gap < MELEE_STAGGER_MIN_MOMENTUM:
		return
	var staggered = a if momentum_a < momentum_b else b
	if _combo_opportunity_active(staggered):
		return
	var threshold := _unit_melee_stability_threshold(staggered)
	var required_gap := threshold
	if source == "collision":
		required_gap = maxf(required_gap, MELEE_STAGGER_MIN_MOMENTUM * PASSIVE_CONTACT_STAGGER_MIN_MULT)
	if gap <= required_gap:
		return
	var now := Time.get_ticks_msec() * 0.001
	if now < float(staggered.get_meta("melee_stagger_gate_until", 0.0)):
		return
	var ratio := (gap - required_gap) / maxf(MELEE_STABILITY_THRESHOLD_FLOOR, required_gap)
	var duration := clampf(MELEE_STAGGER_BASE_SECONDS + ratio * MELEE_STAGGER_RATIO_SECONDS, 0.0, MELEE_STAGGER_MAX_SECONDS)
	if duration <= 0.03:
		return
	staggered.set_meta("melee_stagger_gate_until", now + MELEE_STAGGER_GATE_SECONDS)
	if staggered.has_method("apply_melee_stagger"):
		staggered.apply_melee_stagger(duration, gap, threshold)
	else:
		staggered.action_cooldown = maxf(float(staggered.action_cooldown), duration)
		staggered.set_meta("melee_stagger_timer", duration)
	var source_attacker = b if staggered == a else a
	var actual_duration := maxf(duration, float(staggered.get_meta("melee_stagger_timer", duration)))
	_open_stagger_combo(staggered, source_attacker, actual_duration, initial_hit_counts, maxf(momentum_a, momentum_b))
	_apply_local_hitstop(source_attacker, staggered, MELEE_STAGGER_HITSTOP_SECONDS)
	var direction := normal_a_to_b.normalized() if normal_a_to_b.length() > 0.001 else Vector2.RIGHT
	if staggered == a:
		direction = -direction
	var ab_delta := _mobius_delta_vec_between(a, b)
	var b_near_x: float = a.ring_pos + ab_delta.x
	var impact_combat := Vector2(wrapf(lerpf(a.ring_pos, b_near_x, 0.5), 0.0, RING_LENGTH), a.lane + ab_delta.y * 0.5)
	_spawn_combo_ripple(impact_combat, int(staggered.owner_id), clampf(actual_duration / maxf(0.1, MELEE_STAGGER_MAX_SECONDS), 0.8, 1.45))
	_spawn_hit_effect(staggered, 2, "blunt", false, "impact", impact_combat)
	_show_battle_message("%s %s %.2fs" % [staggered.unit_name, "硬直" if _ui_is_zh() else "STAGGER", duration], 0.42)


func _resolve_passive_contact_hit(attacker, attacker_raw_collider: Dictionary, attacker_collider: Dictionary, target, target_raw_collider: Dictionary, target_collider: Dictionary, contact_normal: Vector2, penetration: float, delta: float, allow_same_owner: bool = false) -> void:
	var same_owner := attacker != null and target != null and is_instance_valid(attacker) and is_instance_valid(target) and int(attacker.owner_id) == int(target.owner_id)
	if not _is_live_unit(attacker) or not _is_live_unit(target) or (same_owner and not allow_same_owner):
		return
	if contact_normal.length() <= 0.001:
		return
	var normal := contact_normal.normalized()
	var attacker_velocity := _contact_collider_velocity(attacker, attacker_raw_collider)
	var target_velocity := _contact_collider_velocity(target, target_raw_collider)
	var relative_velocity := attacker_velocity - target_velocity
	var closing_speed := maxf(0.0, relative_velocity.dot(normal))
	if closing_speed < PASSIVE_CONTACT_MIN_SPEED:
		return
	var raw_momentum := closing_speed * (maxf(1.0, _unit_effective_mass(attacker)) + maxf(1.0, _unit_effective_mass(target)))
	var combo_subject = attacker if _combo_transfer_momentum_cap(attacker) > 0.0 else target
	var combo_transfer_scale := _combo_transfer_momentum_scale(combo_subject, raw_momentum)
	var momentum := raw_momentum * combo_transfer_scale
	var event := {
		"state": "normal",
		"projectile": false,
		"passive_contact": true,
		"runtime_contact": true,
		"damage_type": _runtime_contact_damage_type(attacker_raw_collider),
		"material_class": _runtime_contact_material_class(attacker_raw_collider),
		"direction": normal,
		"momentum": momentum,
		"momentum_vector": normal * momentum,
		"momentum_magnitude": momentum,
		"relative_velocity_vector": relative_velocity,
		"raw_momentum": raw_momentum,
		"combo_transfer_momentum_scale": combo_transfer_scale,
		"combo_transfer_momentum_cap": _combo_transfer_momentum_cap(combo_subject),
		"target_part_index": int(target_collider.get("part_index", -1)),
		"target_part_kind": String(target_collider.get("part_kind", "core")),
		"target_part_name": String(target_collider.get("name", "CORE")),
		"target_torso_unit_index": int(target_collider.get("torso_unit_index", -1)),
		"hit_position_combat": _collider_hit_position(attacker_collider, target_collider),
	}
	if _maybe_detach_barrier_tile_from_momentum(attacker, target, event, normal, momentum):
		return
	var response_momentum := minf(momentum, minf(_runtime_contact_path_stiffness(attacker, attacker_raw_collider), _runtime_contact_path_stiffness(target, target_raw_collider)))
	_apply_runtime_contact_damage(attacker, attacker_raw_collider, target, target_raw_collider, normal, momentum, Vector2(event.get("hit_position_combat", Vector2(target.ring_pos, target.lane))))
	if _is_live_unit(attacker) and _is_live_unit(target):
		_apply_runtime_contact_velocity_response(attacker, target, normal, response_momentum)


func _contact_collider_velocity(unit, collider: Dictionary) -> Vector2:
	if unit != null and is_instance_valid(unit) and unit.has_method("contact_velocity_for_collider"):
		return unit.contact_velocity_for_collider(collider)
	return unit.velocity if unit != null and is_instance_valid(unit) else Vector2.ZERO


func _passive_contact_scrape_factor(collider: Dictionary) -> float:
	match String(collider.get("part_kind", "")):
		"terminal":
			return PASSIVE_CONTACT_SCRAPE_MULT
		"limb_muscle":
			return PASSIVE_CONTACT_SCRAPE_MULT * maxf(0.25, float(collider.get("contact_damage_mult", 0.18)))
		"joint":
			return PASSIVE_CONTACT_SCRAPE_MULT * 0.18
	return PASSIVE_CONTACT_SCRAPE_MULT * 0.28


func _passive_contact_profile(unit, collider: Dictionary) -> Dictionary:
	var part_kind := String(collider.get("part_kind", "muscle"))
	var part_index := int(collider.get("part_index", -1))
	var group := _unit_group_for_collider(unit, collider)
	var state_key := "normal"
	if unit != null and is_instance_valid(unit) and unit.has_method("contact_state_for_part"):
		state_key = String(unit.contact_state_for_part(part_index))
	var material_class := String(collider.get("material_class", group.get("melee_contact_class", group.get("material_class", "body"))))
	if bool(group.get("projectile_only", false)) or material_class == "gun":
		material_class = "wood"
	var damage_type := String(collider.get("damage_type", group.get("damage_type", "blunt")))
	var base_damage := float(collider.get("contact_damage", group.get("normal_damage_override", group.get("normal_damage", unit.stats.get("normal_damage", 2)))))
	var coeff := 0.0
	match part_kind:
		"terminal":
			coeff = _weapon_damage_coefficient(maxf(1.0, base_damage), group, state_key)
			if material_class == "wood":
				coeff *= 0.34
		"limb_muscle":
			coeff = maxf(0.03, float(collider.get("contact_damage_mult", 0.18)))
			if String(material_class) in ["chain", "whip_muscle", "whip_joint"]:
				coeff = maxf(coeff, _weapon_damage_coefficient(maxf(1.0, base_damage), group, state_key) * 0.46)
		"joint":
			coeff = maxf(0.025, float(collider.get("contact_damage_mult", 0.14)))
			if String(material_class) == "whip_joint":
				coeff = maxf(coeff, _weapon_damage_coefficient(maxf(1.0, base_damage), group, state_key) * 0.42)
		"barrier_tile":
			coeff = 0.22 + maxf(0.0, base_damage) / 38.0
		_:
			coeff = maxf(0.04, float(collider.get("contact_damage_mult", 0.26)))
	if not MELEE_DAMAGE_TYPES.has(damage_type):
		damage_type = "blunt"
	var stiffness := float(group.get("group_stiffness", unit.stats.get("stiffness", MOMENTUM_STIFFNESS_UNIT)))
	return {
		"damage_type": damage_type,
		"material_class": material_class,
		"coeff": coeff,
		"state": state_key,
		"stiffness": stiffness,
		"terminal_momentum_mult": _terminal_momentum_multiplier(group),
	}


func _unit_group_for_collider(unit, collider: Dictionary) -> Dictionary:
	if unit == null or not is_instance_valid(unit):
		return {}
	if bool(collider.get("runtime_topology", false)):
		return collider
	return {}


func _passive_contact_damage_key(attacker, attacker_collider: Dictionary, target, target_collider: Dictionary, state_key: String) -> String:
	return "passive_contact_%d_%d_%s_%s_%s_%s_%s" % [
		int(attacker.get_instance_id()),
		int(target.get_instance_id()),
		_meta_safe_part_index(int(attacker_collider.get("part_index", -1))),
		String(attacker_collider.get("part_kind", "")),
		_meta_safe_part_index(int(target_collider.get("part_index", -1))),
		String(target_collider.get("part_kind", "")),
		state_key,
	]


func _meta_safe_part_index(part_index: int) -> String:
	return "m%d" % abs(part_index) if part_index < 0 else str(part_index)


func _maybe_spawn_passive_contact_feedback(target, key: String, delta: float, counter_tier: int, damage_type: String, nullified: bool, damage: int, hit_position_combat: Vector2 = Vector2(1.0e20, 1.0e20), feedback_style: String = "") -> void:
	var fx_key := "%s_fx" % key
	var timer := maxf(0.0, float(target.get_meta(fx_key, 0.0)) - delta)
	if timer > 0.0:
		target.set_meta(fx_key, timer)
		return
	target.set_meta(fx_key, 0.08 if damage < PASSIVE_CONTACT_HITSTOP_DAMAGE else 0.14)
	_spawn_hit_effect(target, counter_tier, damage_type, nullified, feedback_style, hit_position_combat)
	if damage >= PASSIVE_CONTACT_HITSTOP_DAMAGE:
		_apply_hitstop(damage_type, counter_tier, damage)


func _unit_contact_radius(unit) -> float:
	if unit == null or not is_instance_valid(unit):
		return 0.12
	var body_radius := maxf(0.04, float(unit.stats.get("radius", 0.22)))
	var body_length := maxf(0.12, float(unit.stats.get("length", 0.7)))
	var limb_count := maxi(1, int(unit.stats.get("group_count", ATTACK_GROUP_COUNT)))
	var limb_bonus := clampf(float(limb_count) * 0.012, 0.02, 0.11)
	return clampf((body_radius * 1.18 + sqrt(body_radius * body_length) * 0.18 + limb_bonus) * UNIT_BODY_SPACING_MULT, 0.18, 4.6)


func _unit_effective_mass(unit) -> float:
	if unit == null or not is_instance_valid(unit):
		return 1.0
	return maxf(1.0, float(unit.stats.get("mass", 1.0)))


func _unit_thruster_power(unit) -> float:
	if unit == null or not is_instance_valid(unit):
		return 0.0
	var mass := maxf(1.0, float(unit.stats.get("mass", 1.0)))
	return maxf(0.0, float(unit.stats.get("boost_momentum", 0.0))) / mass


func _unit_knockback_resist(unit) -> float:
	if unit == null or not is_instance_valid(unit):
		return 0.0
	return clampf(float(unit.stats.get("knockback_resist", 0.0)), 0.0, 0.68)


func _unit_melee_stability_threshold(unit) -> float:
	if unit == null or not is_instance_valid(unit):
		return MELEE_STABILITY_THRESHOLD_FLOOR
	return maxf(MELEE_STABILITY_THRESHOLD_FLOOR, float(unit.stats.get("melee_stability_threshold", MELEE_STABILITY_THRESHOLD_FLOOR)))


func _unit_impulse_motion_mult(unit) -> float:
	return clampf(1.0 - _unit_knockback_resist(unit) * 0.72, 0.48, 1.12)


func _unit_posture_anchor(unit, opposing_mass: float) -> float:
	if unit == null or not is_instance_valid(unit):
		return 0.0
	var mass := _unit_effective_mass(unit)
	var thruster := _unit_thruster_power(unit)
	var stabilization := clampf(float(unit.stats.get("recoil_stabilization", unit.stats.get("attitude_control", 0.85))), 0.0, 2.6)
	var thruster_anchor := thruster / maxf(0.001, thruster + opposing_mass * 0.36 + mass * 0.04 + 6.0)
	var control_anchor := clampf(_unit_knockback_resist(unit) + maxf(0.0, stabilization - 0.7) * 0.08, 0.0, 0.5)
	return clampf(thruster_anchor * 0.78 + control_anchor, 0.0, 0.82)


func _apply_unit_displacement(unit, direction: Vector2, distance: float) -> void:
	if unit == null or not is_instance_valid(unit) or direction.length() <= 0.001 or distance <= 0.0:
		return
	var dir := direction.normalized()
	if mobius_enabled and unit.get("mobius_s") != null:
		var next_coord := Vector2(float(unit.get("mobius_s")), float(unit.get("mobius_v"))) + dir * distance
		next_coord.y = clampf(next_coord.y, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
		unit.set("mobius_s", next_coord.x)
		unit.set("mobius_v", next_coord.y)
		unit.ring_pos = fposmod(next_coord.x, RING_LENGTH)
		unit.lane = next_coord.y
		return
	unit.ring_pos = wrapf(unit.ring_pos + dir.x * distance, 0.0, RING_LENGTH)
	unit.lane = clampf(unit.lane + dir.y * distance, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)


func _heat_reason_for_projectile_event(event: Dictionary) -> String:
	var tags: Array = ["heat:projectile"]
	var tag_source := ""
	for key in ["gun_kind", "ammo_kind", "projectile_style", "projectile_behavior", "module_action_profile"]:
		var value := String(event.get(key, ""))
		if value != "":
			tag_source += " " + value.to_lower()
	if tag_source.contains("laser"):
		tags.append("heat:laser")
	if tag_source.contains("chemical"):
		tags.append("heat:chemical")
	if tag_source.contains("missile") or tag_source.contains("explosive") or tag_source.contains("grenade"):
		tags.append("heat:missile")
	return " ".join(tags)


func _add_unit_heat(unit, amount: float, reason: String = "external heat") -> void:
	if not _unit_uses_heat(unit) or amount <= 0.0:
		return
	var heat_capacity := maxf(1.0, float(unit.stats.get("heat_capacity", 100.0)))
	if unit.has_method("add_heat"):
		unit.add_heat(amount, reason)
	else:
		unit.heat = clampf(float(unit.heat) + amount, 0.0, heat_capacity)
		unit.overheated = unit.heat >= heat_capacity


func _cool_unit_heat(unit, amount: float, clear_ratio: float = 0.42) -> void:
	if not _unit_uses_heat(unit) or amount <= 0.0:
		return
	var heat_capacity := maxf(1.0, float(unit.stats.get("heat_capacity", 100.0)))
	unit.heat = clampf(float(unit.heat) - amount, 0.0, heat_capacity)
	if unit.overheated and unit.heat <= heat_capacity * clear_ratio:
		unit.overheated = false


func _apply_hit_displacement(attacker, target, event: Dictionary, damage: int, nullified: bool) -> void:
	if attacker == null or target == null or not is_instance_valid(attacker) or not is_instance_valid(target):
		return
	if not _unit_is_mech_physics_subject(target):
		return
	if _unit_is_anchored_barrier(target):
		return
	var direction := _event_direction_vector(attacker, target, event, Vector2(float(attacker.facing), 0.0))
	var base_knock := maxf(0.02, float(event.get("knock", 0.08)))
	var combo_knock_mult := _combo_knock_multiplier_for_event(event)
	var damage_for_knock := int(event.get("combo_unscaled_damage", damage))
	if _unit_uses_direct_runtime_topology(attacker) or _unit_uses_direct_runtime_topology(target):
		var direct_attacker_mass := _unit_effective_mass(attacker)
		var direct_target_mass := _unit_effective_mass(target)
		var event_momentum := maxf(
			float(event.get("momentum", 0.0)),
			maxf(float(event.get("fixed_output_momentum", 0.0)), _projectile_momentum_for_event(event) if bool(event.get("projectile", false)) else 0.0)
		)
		if event_momentum <= 0.001:
			event_momentum = maxf(base_knock * direct_attacker_mass, float(damage_for_knock) * 0.42)
		var direct_transfer := event_momentum * (0.82 if bool(event.get("projectile", false)) else 0.58)
		if nullified:
			direct_transfer *= 0.35
		direct_transfer *= clampf(combo_knock_mult, 1.0, minf(COMBO_KNOCK_MAX_MULT, 1.65))
		if direct_transfer <= 0.001:
			return
		var target_velocity_impulse := direct_transfer / maxf(1.0, direct_target_mass)
		target.velocity += direction * target_velocity_impulse
		if not bool(event.get("projectile", false)):
			var direct_attacker_part_index := int(event.get("muscle_node", -1))
			var attacker_velocity_impulse := direct_transfer / maxf(1.0, direct_attacker_mass)
			if attacker.has_method("apply_attack_reaction"):
				attacker.apply_attack_reaction(-direction, attacker_velocity_impulse, direct_attacker_part_index, bool(event.get("recoil_countered", false)))
			elif not _unit_is_anchored_barrier(attacker):
				attacker.velocity -= direction * attacker_velocity_impulse
		return
	if bool(event.get("projectile", false)):
		var projectile_push := base_knock * PROJECTILE_SPACE_IMPULSE_MULT * (0.82 if nullified else 1.0) * (1.0 + clampf(float(damage_for_knock) / 80.0, 0.0, 0.45))
		projectile_push *= combo_knock_mult
		var target_mass := _unit_effective_mass(target)
		var target_anchor := _unit_posture_anchor(target, maxf(1.0, float(event.get("momentum", damage))))
		_apply_unit_displacement(target, direction, projectile_push * (1.0 - target_anchor * 0.28))
		target.velocity += direction * projectile_push * 1.65 * _unit_impulse_motion_mult(target)
		if target.has_method("apply_physics_impulse"):
			target.apply_physics_impulse(direction, projectile_push, int(event.get("target_part_index", -1)), 0.0)
		return

	var attacker_mass := _unit_effective_mass(attacker)
	var target_mass := _unit_effective_mass(target)
	var total_mass := attacker_mass + target_mass
	var attacker_share := clampf(target_mass / total_mass, 0.1, 0.9)
	var target_share := clampf(attacker_mass / total_mass, 0.1, 0.9)
	var attacker_anchor := _unit_posture_anchor(attacker, target_mass)
	var target_anchor := _unit_posture_anchor(target, attacker_mass)
	var impact_scale := 0.38 if nullified else 1.0
	var part_radius := _unit_contact_radius(target) * 0.08
	var damage_type := String(event.get("damage_type", "blunt"))
	var blunt_launch_mult := 2.0 if damage_type == "blunt" else 1.0
	var space_impulse := maxf(0.22, base_knock * 2.8 + float(damage_for_knock) * 0.006 + part_radius) * MELEE_SPACE_IMPULSE_MULT * blunt_launch_mult * impact_scale
	space_impulse *= combo_knock_mult
	var attacker_move := space_impulse * attacker_share * (1.0 - attacker_anchor)
	var target_move := space_impulse * target_share * (1.0 - target_anchor * 0.36)
	var attacker_residual_move := attacker_move
	var attacker_part_index := int(event.get("muscle_node", -1))
	if attacker.has_method("apply_attack_reaction"):
		var requested_velocity_impulse := attacker_move * 2.2 * _unit_impulse_motion_mult(attacker)
		var residual_velocity: float = attacker.apply_attack_reaction(-direction, requested_velocity_impulse, attacker_part_index, bool(event.get("recoil_countered", false)))
		var residual_ratio := 0.0 if requested_velocity_impulse <= 0.001 else clampf(residual_velocity / requested_velocity_impulse, 0.0, 1.0)
		attacker_residual_move = attacker_move * residual_ratio
	else:
		attacker.velocity -= direction * attacker_move * 2.2 * _unit_impulse_motion_mult(attacker)
	_apply_unit_displacement(attacker, -direction, attacker_residual_move)
	_apply_unit_displacement(target, direction, target_move)
	target.velocity += direction * target_move * 2.55 * _unit_impulse_motion_mult(target)
	var target_part_index := int(event.get("target_part_index", -1))
	if attacker.has_method("apply_physics_impulse") and not attacker.has_method("apply_attack_reaction"):
		attacker.apply_physics_impulse(-direction, attacker_move, attacker_part_index, 0.0)
	if target.has_method("apply_physics_impulse"):
		target.apply_physics_impulse(direction, target_move, target_part_index, 0.0)
	attacker.boost_flash_timer = maxf(float(attacker.boost_flash_timer), 0.13 + attacker_anchor * 0.1)
	if target_anchor > 0.08:
		target.boost_flash_timer = maxf(float(target.boost_flash_timer), 0.06 + target_anchor * 0.04)


func _update_units(delta: float, refresh_screen_positions: bool = true) -> void:
	for unit in all_units.duplicate():
		if not is_instance_valid(unit):
			all_units.erase(unit)
			continue
		if not unit.active:
			continue
		var unit_delta := _unit_local_hitstop_delta(unit, delta)
		if unit.has_meta("switch_timer"):
			unit.set_meta("switch_timer", maxf(0.0, float(unit.get_meta("switch_timer", 0.0)) - unit_delta))
		if unit.has_meta("projectile_signal"):
			unit.set_meta("projectile_signal", maxf(0.0, float(unit.get_meta("projectile_signal", 0.0)) - unit_delta))
		if unit.has_meta("receiver_flash"):
			unit.set_meta("receiver_flash", maxf(0.0, float(unit.get_meta("receiver_flash", 0.0)) - unit_delta))
		_update_unit_status_meta(unit, unit_delta)
		if float(unit.get_meta("active_cool_lock", 0.0)) > 0.0:
			unit.velocity = Vector2.ZERO
		unit.tick(unit_delta, RING_LENGTH)
		if _update_space_debris(unit, unit_delta):
			continue
		_clear_combo_opportunity_if_expired(unit)
	_resolve_unit_body_spacing(delta)
	if refresh_screen_positions:
		_refresh_unit_screen_positions()


func _battle_screen_center() -> Vector2:
	return Vector2((ARENA_LEFT + ARENA_RIGHT) * 0.5, (ARENA_TOP + ARENA_BOTTOM) * 0.5)


func _screen_position_is_finite(screen_position: Vector2) -> bool:
	return is_finite(screen_position.x) and is_finite(screen_position.y)


func _projection_screen_position(projection: Dictionary) -> Vector2:
	var raw_position = projection.get("position", _battle_screen_center())
	return raw_position if raw_position is Vector2 else _battle_screen_center()


func _projection_position_is_valid(projection: Dictionary) -> bool:
	return _screen_position_is_finite(_projection_screen_position(projection))


func _projection_with_readable_clamp(projection: Dictionary) -> Dictionary:
	var result := projection.duplicate(true)
	result["clamp_final_position"] = true
	result["readable_min"] = Vector2(ARENA_LEFT - 96.0, ARENA_TOP - 96.0)
	result["readable_max"] = Vector2(ARENA_RIGHT + 96.0, ARENA_BOTTOM + 96.0)
	return result


func _unit_is_camera_focus(unit) -> bool:
	if not _is_live_unit(unit):
		return false
	if battle_mode in [MODE_TRAINING, MODE_AI, MODE_PVP] and ai_battle_seat in [1, 2]:
		return unit == _first_live_unit_any_role(ai_battle_seat)
	if battle_mode in [MODE_AI, MODE_TRAINING, MODE_PVP] and ai_battle_seat == 3:
		if spectator_view_mode == SPECTATOR_VIEW_P1:
			return unit == _first_live_unit_any_role(1)
		if spectator_view_mode == SPECTATOR_VIEW_P2:
			return unit == _first_live_unit_any_role(2)
		return unit == _first_live_unit_any_role(1) or unit == _first_live_unit_any_role(2)
	var owner := int(unit.owner_id)
	return unit == _first_live_unit_any_role(owner)


func _unit_has_boost_projection_guard(unit) -> bool:
	if not _is_live_unit(unit):
		return false
	return float(unit.get_meta("boost_projection_guard_timer", 0.0)) > 0.0


func _unit_boost_guard_counts_as_critical(unit) -> bool:
	if not _unit_has_boost_projection_guard(unit):
		return false
	if bool(unit.get_meta("player_controlled", false)) or bool(unit.get_meta("camera_focus", false)):
		return true
	if _unit_is_camera_focus(unit):
		return true
	var owner := clampi(int(unit.owner_id), 1, 2)
	if battle_mode == MODE_PVP:
		return owner in [1, 2]
	if battle_mode in [MODE_TRAINING, MODE_AI] and ai_battle_seat in [1, 2]:
		return owner == ai_battle_seat
	if battle_mode in [MODE_TRAINING, MODE_AI, MODE_PVP] and ai_battle_seat == 3:
		return _unit_is_camera_focus(unit)
	return false


func _unit_is_player_controlled_or_camera_critical(unit) -> bool:
	if not _is_live_unit(unit):
		return false
	if _unit_boost_guard_counts_as_critical(unit):
		return true
	if bool(unit.get_meta("player_controlled", false)) or bool(unit.get_meta("camera_focus", false)):
		return true
	if _unit_is_camera_focus(unit):
		return true
	var owner := clampi(int(unit.owner_id), 1, 2)
	if battle_mode == MODE_PVP:
		return owner in [1, 2]
	if battle_mode in [MODE_TRAINING, MODE_AI] and ai_battle_seat in [1, 2] and owner == ai_battle_seat:
		return true
	if battle_mode in [MODE_TRAINING, MODE_AI, MODE_PVP] and ai_battle_seat == 3:
		match spectator_view_mode:
			SPECTATOR_VIEW_P1:
				return owner == 1 and unit == _first_live_unit_any_role(1)
			SPECTATOR_VIEW_P2:
				return owner == 2 and unit == _first_live_unit_any_role(2)
			_:
				return unit == _first_live_unit_any_role(1) or unit == _first_live_unit_any_role(2)
	return false


func _guard_camera_to_unit_projection(unit, coord: Vector2) -> void:
	var owner := clampi(int(unit.owner_id), 1, 2)
	player_camera_centers[owner] = coord.x if mobius_enabled else wrapf(coord.x, 0.0, RING_LENGTH)
	player_camera_lanes[owner] = _clamp_camera_lane_center(coord.y)
	if ai_battle_seat == 3:
		spectator_camera_center = coord.x if mobius_enabled else wrapf(coord.x, 0.0, RING_LENGTH)
		spectator_camera_lane = _clamp_camera_lane_center(coord.y)
	camera_lane_center = _clamp_camera_lane_center(coord.y)
	if mobius_enabled:
		camera_mobius_s = coord.x
		camera_center = fposmod(camera_mobius_s, RING_LENGTH)
	else:
		camera_center = wrapf(coord.x, 0.0, RING_LENGTH)
		_sync_camera_mobius_from_compat()


func _projection_last_finite_position(unit) -> Vector2:
	var last_finite = unit.get_meta("last_finite_screen_position", null)
	if last_finite is Vector2 and _screen_position_is_finite(last_finite):
		return last_finite
	var last_position = unit.get_meta("last_screen_position", null)
	if last_position is Vector2 and _screen_position_is_finite(last_position):
		return last_position
	return _battle_screen_center()


func _apply_projection_hysteresis(unit, projection: Dictionary, grace_budget: int = MOBIUS_PROJECTION_HIDDEN_GRACE_FRAMES) -> Dictionary:
	var result := projection.duplicate(true)
	var visible_now := bool(result.get("visible", true)) and _projection_position_is_valid(result)
	if visible_now:
		unit.set_meta("projection_hidden_grace_frames", maxi(0, grace_budget))
		unit.set_meta("last_finite_screen_position", _projection_screen_position(result))
		return result
	var grace_frames := int(unit.get_meta("projection_hidden_grace_frames", 0))
	if grace_frames <= 0:
		return result
	var last_position := _projection_last_finite_position(unit)
	result["position"] = last_position
	result["visible"] = true
	result["guarded"] = true
	result["critical"] = bool(result.get("critical", false))
	result["projection_source"] = "%s_hysteresis" % String(result.get("projection_source", "projection"))
	unit.set_meta("projection_hidden_grace_frames", grace_frames - 1)
	return result


func _critical_projection_fallback(unit, projection: Dictionary, projection_source: String) -> Dictionary:
	var result := projection.duplicate(true)
	result["position"] = _projection_last_finite_position(unit)
	if not _projection_position_is_valid(result):
		result["position"] = _battle_screen_center()
	result["visible"] = true
	result["guarded"] = true
	result["critical"] = true
	result["scale"] = maxf(1.0, float(result.get("scale", 1.0)))
	result["z_index"] = maxi(int(result.get("z_index", 0)), 8)
	result["projection_source"] = "%s_guard_fallback" % projection_source
	unit.set_meta("projection_hidden_grace_frames", MOBIUS_PROJECTION_CRITICAL_GRACE_FRAMES)
	return result


func _project_unit_for_screen(unit) -> Dictionary:
	var projection: Dictionary = {}
	var projection_source := "screen"
	if mobius_enabled:
		projection_source = "mobius"
		projection = _mobius_project_coord(_unit_mobius_coord(unit))
	else:
		projection = _screen_from_ring(unit.ring_pos, unit.lane)
	projection["projection_source"] = projection_source
	var visible_in_view := bool(projection.get("visible", true)) and _projection_position_is_valid(projection)
	if not visible_in_view and _barrier_has_map_tiles(unit):
		visible_in_view = _barrier_has_visible_tile(unit)
	projection["visible"] = visible_in_view
	projection["guarded"] = bool(projection.get("guarded", false))
	var critical := _unit_is_player_controlled_or_camera_critical(unit)
	projection["critical"] = critical
	if critical:
		projection = _projection_with_readable_clamp(projection)
	if critical and visible_in_view and _projection_position_is_valid(projection):
		return _apply_projection_hysteresis(unit, projection, MOBIUS_PROJECTION_CRITICAL_GRACE_FRAMES)
	if critical and (not visible_in_view or not _projection_position_is_valid(projection)):
		var coord := _unit_combat_coord(unit)
		_guard_camera_to_unit_projection(unit, coord)
		projection = _mobius_project_coord(coord) if mobius_enabled else _screen_from_ring(unit.ring_pos, unit.lane)
		visible_in_view = bool(projection.get("visible", true)) and _projection_position_is_valid(projection)
		projection["projection_source"] = "%s_guard_resync" % projection_source
		projection["guarded"] = true
		projection["critical"] = true
		projection = _projection_with_readable_clamp(projection)
		if not visible_in_view:
			projection = _critical_projection_fallback(unit, projection, projection_source)
		else:
			projection["visible"] = true
			unit.set_meta("projection_hidden_grace_frames", MOBIUS_PROJECTION_CRITICAL_GRACE_FRAMES)
		return projection
	return _apply_projection_hysteresis(unit, projection)


func _refresh_unit_screen_positions() -> void:
	for unit in all_units:
		if not _is_live_unit(unit):
			continue
		_sync_unit_mobius_from_compat(unit)
		var screen := _project_unit_for_screen(unit)
		var visible_in_view := bool(screen.get("visible", true))
		if mobius_enabled and unit.has_method("set_mobius_screen_projection"):
			unit.set_mobius_screen_projection(screen, visible_in_view)
		else:
			unit.set_screen_position(_projection_screen_position(screen), visible_in_view)


func _gameplay_direction_screen_vector(direction: Vector2, fallback: Vector2 = Vector2.RIGHT) -> Vector2:
	var result := direction if direction.length() > 0.01 else fallback
	if result.length() <= 0.01:
		result = Vector2.RIGHT
	return result.normalized()


func _gameplay_ray_screen_end(start_screen: Vector2, direction: Vector2, world_range: float, min_pixels: float = 80.0) -> Vector2:
	var screen_length := maxf(min_pixels, maxf(0.0, world_range) * _battle_world_to_screen_scale())
	return start_screen + _gameplay_direction_screen_vector(direction) * screen_length


func _projected_screen_segment_from_combat(start_combat: Vector2, end_combat: Vector2, min_pixels: float = 0.0) -> Dictionary:
	var start_projection: Dictionary = _project_combat_coord_to_screen(start_combat)
	var end_projection: Dictionary = _project_combat_coord_to_screen(end_combat)
	var start_screen: Vector2 = start_projection.get("position", Vector2.ZERO)
	var end_screen: Vector2 = end_projection.get("position", start_screen)
	var projected_delta := end_screen - start_screen
	if min_pixels > 0.0 and projected_delta.length() > 0.001 and projected_delta.length() < min_pixels:
		end_screen = start_screen + projected_delta.normalized() * min_pixels
	return {
		"start": start_screen,
		"end": end_screen,
		"start_visible": bool(start_projection.get("visible", true)),
		"end_visible": bool(end_projection.get("visible", true)),
		"visible": bool(start_projection.get("visible", true)) or bool(end_projection.get("visible", true)),
	}


func _projected_projectile_screen_segment(attacker, event: Dictionary, min_pixels: float = 80.0, include_occlusion: bool = false) -> Dictionary:
	if attacker == null or not is_instance_valid(attacker):
		return {}
	var collider: Dictionary = _attack_collider_for_event(attacker, event)
	var start_combat := _unit_combat_coord(attacker)
	var end_combat := start_combat
	if not collider.is_empty():
		start_combat = collider.get("a", start_combat)
		end_combat = collider.get("b", start_combat)
	elif event.has("muzzle_combat_position") and event["muzzle_combat_position"] is Vector2:
		start_combat = event["muzzle_combat_position"]
		end_combat = start_combat
	else:
		return {}
	if event.has("muzzle_combat_position") and event["muzzle_combat_position"] is Vector2:
		start_combat = event["muzzle_combat_position"]
	if event.has("projectile_impact_position") and event["projectile_impact_position"] is Vector2:
		end_combat = event["projectile_impact_position"]
	if start_combat.distance_to(end_combat) <= 0.01:
		var direction := Vector2(float(attacker.facing), 0.0)
		if event.has("direction") and event["direction"] is Vector2:
			direction = event["direction"]
		if direction.length() <= 0.01:
			direction = Vector2(float(attacker.facing), 0.0)
		end_combat = start_combat + direction.normalized() * maxf(0.04, float(event.get("range", 1.2)))
	if include_occlusion:
		var occlusion := _map_occlusion_query_for_event(attacker, event)
		if not occlusion.is_empty():
			end_combat = occlusion.get("position", end_combat)
	return _projected_screen_segment_from_combat(start_combat, end_combat, min_pixels)


func _update_aim_lines(delta: float) -> void:
	for player_id in [1, 2]:
		var line: Line2D = aim_lines[player_id]
		var hero = active_units[player_id]["hero"]
		if _runtime_gun_activation_active(player_id) and _is_live_unit(hero) and hero.visible:
			var event := _runtime_gun_activation_event_for(player_id)
			if event.is_empty():
				line.visible = false
				continue
			var projected_segment := _projected_projectile_screen_segment(hero, event, 120.0)
			if projected_segment.is_empty():
				line.visible = false
				continue
			var state: Dictionary = gun_activation_state[player_id]
			line.default_color = Color(1.0, 0.72, 0.16, 0.86) if _is_live_unit(state.get("locked_target", null)) else Color(0.62, 0.94, 1.0, 0.42)
			line.points = PackedVector2Array([projected_segment.get("start", hero.position), projected_segment.get("end", hero.position)])
			line.visible = bool(projected_segment.get("visible", true))
			continue
		if not bool(aim_holding[player_id]) or not _is_live_unit(hero) or not hero.visible:
			line.visible = false
			continue
		var group := _attack_group(hero, int(aim_attack_index[player_id]))
		var true_bullet_aim := _group_uses_true_bullet(group)
		var direction: Vector2 = aim_directions[player_id]
		if hero.has_method("set_aim_pose"):
			hero.set_aim_pose(int(aim_attack_index[player_id]), direction, 0.1)
		var start_combat := _unit_combat_coord(hero)
		if hero.has_method("muzzle_position_for_part"):
			var muzzle_world: Vector2 = hero.muzzle_position_for_part(int(aim_attack_index[player_id]))
			start_combat = muzzle_world
		var length: float = 120.0 + float(hero.stats.get("normal_range", 0.4)) * 90.0
		if true_bullet_aim:
			length = ARENA_WIDTH * 1.16
			if _is_live_unit(aim_locked_targets[player_id]):
				line.default_color = Color(1.0, 0.72, 0.16, 0.86)
			else:
				line.default_color = Color(1.0, 0.72, 0.16, 0.34)
		else:
			line.default_color = Color(0.55, 0.9, 1.0, 0.55)
		var world_range := maxf(1.0, float(hero.stats.get("normal_range", 0.4)) * 2.4)
		if hero.has_method("muzzle_position_for_part"):
			world_range = VIEW_WIDTH * 1.15 if true_bullet_aim else world_range
		var end_combat := start_combat + _gameplay_direction_screen_vector(direction) * world_range
		var aim_segment := _projected_screen_segment_from_combat(start_combat, end_combat, length)
		line.points = PackedVector2Array([aim_segment.get("start", hero.position), aim_segment.get("end", hero.position)])
		line.visible = bool(aim_segment.get("visible", true))


func _clear_combat_geometry_debug_overlay() -> void:
	if combat_geometry_debug_root == null or not is_instance_valid(combat_geometry_debug_root):
		return
	for child in combat_geometry_debug_root.get_children():
		child.queue_free()


func _debug_screen_from_gameplay_point(point: Vector2) -> Vector2:
	return _project_combat_coord_to_screen(point).get("position", Vector2.ZERO)


func _add_combat_geometry_debug_line(points: PackedVector2Array, color: Color, width: float = 1.0) -> void:
	if combat_geometry_debug_root == null or points.size() < 2:
		return
	var line := Line2D.new()
	line.points = points
	line.width = width
	line.default_color = color
	line.z_index = 96
	combat_geometry_debug_root.add_child(line)


func _debug_draw_gameplay_collider(collider: Dictionary, color: Color) -> void:
	var shape := String(collider.get("shape", "circle"))
	if shape == "polygon":
		var points := PackedVector2Array()
		for raw_point in Array(collider.get("polygon", [])):
			if raw_point is Vector2:
				points.append(_debug_screen_from_gameplay_point(raw_point))
		if points.size() >= 2:
			points.append(points[0])
			_add_combat_geometry_debug_line(points, color, 1.2)
	elif shape == "capsule":
		var a: Vector2 = collider.get("a", Vector2.ZERO)
		var b: Vector2 = collider.get("b", a)
		_add_combat_geometry_debug_line(PackedVector2Array([_debug_screen_from_gameplay_point(a), _debug_screen_from_gameplay_point(b)]), color, maxf(1.2, float(collider.get("radius", 0.02)) * _battle_world_to_screen_scale() * 2.0))
	else:
		var center: Vector2 = collider.get("center", Vector2.ZERO)
		var radius := maxf(0.02, float(collider.get("radius", 0.1))) * _battle_world_to_screen_scale()
		var points := PackedVector2Array()
		var screen_center := _debug_screen_from_gameplay_point(center)
		for i in range(24):
			var angle := TAU * float(i) / 24.0
			points.append(screen_center + Vector2(cos(angle), sin(angle)) * radius)
		points.append(points[0])
		_add_combat_geometry_debug_line(points, color, 1.0)


func _update_combat_geometry_debug_overlay() -> void:
	if combat_geometry_debug_root == null or not is_instance_valid(combat_geometry_debug_root):
		return
	combat_geometry_debug_root.visible = combat_geometry_debug and game_state == STATE_BATTLE
	_clear_combat_geometry_debug_overlay()
	if not combat_geometry_debug_root.visible:
		return
	for unit in all_units:
		if not _is_live_unit(unit):
			continue
		var color := Color(0.2, 0.92, 1.0, 0.44) if int(unit.owner_id) == 1 else Color(1.0, 0.28, 0.42, 0.44)
		for raw_collider in _unit_part_colliders(unit):
			if raw_collider is Dictionary:
				_debug_draw_gameplay_collider(raw_collider, color)
		var projected: Dictionary = _project_combat_coord_to_screen(_unit_combat_coord(unit))
		var center: Vector2 = projected.get("position", unit.position)
		_add_combat_geometry_debug_line(PackedVector2Array([center - Vector2(5.0, 0.0), center + Vector2(5.0, 0.0)]), Color.WHITE, 1.0)
		_add_combat_geometry_debug_line(PackedVector2Array([center - Vector2(0.0, 5.0), center + Vector2(0.0, 5.0)]), Color.WHITE, 1.0)
	for player_id in [1, 2]:
		var hero = active_units[player_id]["hero"]
		if not _is_live_unit(hero):
			continue
		var direction: Vector2 = aim_directions[player_id] if bool(aim_holding[player_id]) else hero.get_meta("move_input_vector", Vector2.ZERO)
		if direction.length() <= 0.01:
			continue
		var start: Vector2 = _debug_screen_from_gameplay_point(_unit_combat_coord(hero))
		_add_combat_geometry_debug_line(PackedVector2Array([start, _gameplay_ray_screen_end(start, direction, 2.2, 100.0)]), Color(1.0, 0.92, 0.18, 0.82), 2.0)


func _laser_telegraph_color(attacker) -> Color:
	if attacker != null and is_instance_valid(attacker):
		var owner_id := int(attacker.owner_id)
		if owner_id == 1:
			return Color(0.2, 0.9, 1.0, 1.0)
		return Color(1.0, 0.28, 0.72, 1.0)
	return Color(0.62, 0.94, 1.0, 1.0)


func _is_laser_telegraph_event(event: Dictionary) -> bool:
	if bool(event.get("laser_telegraph_ready", false)):
		return false
	if bool(event.get("non_damage", false)):
		return false
	if not bool(event.get("projectile", false)):
		return false
	var damage_type := String(event.get("damage_type", event.get("projectile_damage_type", "")))
	if damage_type != "laser":
		return false
	var style := String(event.get("projectile_style", "beam"))
	return style in ["", "beam", "laser", "rail"]


func _laser_visible_world_range(attacker, direction: Vector2) -> float:
	if attacker == null or not is_instance_valid(attacker):
		return VIEW_WIDTH
	var dir := direction.normalized()
	if dir.length() <= 0.01:
		dir = _unit_forward_vector(attacker)
	var start_screen: Vector2 = _project_combat_coord_to_screen(_unit_combat_coord(attacker))["position"]
	var screen_scale := ARENA_HEIGHT / VIEW_HEIGHT
	var best_distance := 999999.0
	if absf(dir.x) > 0.001:
		var edge_x := ARENA_RIGHT if dir.x > 0.0 else ARENA_LEFT
		var candidate := (edge_x - start_screen.x) / dir.x
		if candidate > 0.0:
			best_distance = minf(best_distance, candidate)
	if absf(dir.y) > 0.001:
		var edge_y := ARENA_BOTTOM if dir.y > 0.0 else ARENA_TOP
		var candidate := (edge_y - start_screen.y) / dir.y
		if candidate > 0.0:
			best_distance = minf(best_distance, candidate)
	if best_distance >= 999998.0:
		best_distance = ARENA_WIDTH
	return clampf(best_distance / maxf(1.0, screen_scale) + 0.08, 0.32, VIEW_WIDTH * 1.8)


func _laser_screen_segment(attacker, event: Dictionary) -> Dictionary:
	if attacker == null or not is_instance_valid(attacker):
		return {}
	var collider: Dictionary = _attack_collider_for_event(attacker, event)
	if collider.is_empty():
		return {}
	var start_combat: Vector2 = collider.get("a", _unit_combat_coord(attacker))
	var end_combat: Vector2 = collider.get("b", start_combat)
	if start_combat.distance_to(end_combat) <= 0.01:
		var direction := _unit_forward_vector(attacker)
		if event.has("direction") and event["direction"] is Vector2:
			direction = event["direction"]
		end_combat = start_combat + direction.normalized() * float(event.get("range", VIEW_WIDTH))
	var occlusion := _map_occlusion_query_for_event(attacker, event)
	if not occlusion.is_empty():
		end_combat = occlusion.get("position", end_combat)
	var start_screen: Vector2 = _project_combat_coord_to_screen(start_combat)["position"]
	var end_screen: Vector2 = _project_combat_coord_to_screen(end_combat)["position"]
	return {"start": start_screen, "end": end_screen}


func _spawn_laser_telegraph(attacker, event: Dictionary, aim_time: float) -> LaserAimTelegraphEffect:
	if effects_root == null or attacker == null or not is_instance_valid(attacker):
		return null
	var segment := _laser_screen_segment(attacker, event)
	if segment.is_empty():
		return null
	var telegraph := LaserAimTelegraphEffect.new()
	telegraph.setup(segment["start"], segment["end"], aim_time, _laser_telegraph_color(attacker))
	effects_root.add_child(telegraph)
	return telegraph


func _queue_laser_telegraph(attacker, event: Dictionary) -> bool:
	if attacker == null or not is_instance_valid(attacker):
		return false
	var shot_event := event.duplicate(true)
	var direction: Vector2 = shot_event.get("direction", _unit_forward_vector(attacker))
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(attacker)
	direction = direction.normalized()
	shot_event["direction"] = direction
	shot_event["aim_locked"] = true
	shot_event["laser_telegraph_ready"] = true
	shot_event["projectile_style"] = "beam"
	shot_event["travel_path"] = "instant_line"
	shot_event["range"] = _laser_visible_world_range(attacker, direction)
	var aim_time := clampf(float(shot_event.get("laser_aim_time", LASER_DEFAULT_AIM_SECONDS)), LASER_MIN_AIM_SECONDS, LASER_MAX_AIM_SECONDS)
	if attacker.has_method("set_aim_pose"):
		attacker.set_aim_pose(int(shot_event.get("muscle_node", 0)), direction, aim_time + 0.18)
	var telegraph := _spawn_laser_telegraph(attacker, shot_event, aim_time)
	pending_laser_shots.append({
		"attacker": attacker,
		"event": shot_event,
		"timer": aim_time,
		"telegraph": telegraph,
	})
	attacker.set_meta("projectile_signal", aim_time + 0.16)
	_show_battle_message("%s LASER AIM %.1fs" % [String(attacker.unit_name), aim_time], 0.5)
	return true


func _update_laser_telegraphs(delta: float) -> void:
	for index in range(pending_laser_shots.size() - 1, -1, -1):
		var shot: Dictionary = pending_laser_shots[index]
		var attacker = shot.get("attacker", null)
		var telegraph = shot.get("telegraph", null)
		if not _is_live_unit(attacker):
			if telegraph != null and is_instance_valid(telegraph):
				telegraph.queue_free()
			pending_laser_shots.remove_at(index)
			continue
		var event: Dictionary = shot.get("event", {})
		var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
		if direction.length() <= 0.01:
			direction = _unit_forward_vector(attacker)
		direction = direction.normalized()
		event["direction"] = direction
		if attacker.has_method("set_aim_pose"):
			attacker.set_aim_pose(_projectile_source_node_for_event(event), direction, 0.14)
		event["range"] = _laser_visible_world_range(attacker, direction)
		var segment := _laser_screen_segment(attacker, event)
		if telegraph != null and is_instance_valid(telegraph) and not segment.is_empty():
			telegraph.set_line(segment["start"], segment["end"])
		var timer := float(shot.get("timer", 0.0)) - delta
		if timer <= 0.0:
			if telegraph != null and is_instance_valid(telegraph):
				telegraph.queue_free()
			pending_laser_shots.remove_at(index)
			_resolve_attack(attacker, event)
			_clear_runtime_gun_pose_for_payload(attacker, event)
			continue
		shot["timer"] = timer
		shot["event"] = event
		pending_laser_shots[index] = shot


func _projectile_behavior_for_data(data: Dictionary) -> String:
	var behavior := String(data.get("projectile_behavior", ""))
	if behavior != "":
		return behavior
	var damage_type := String(data.get("projectile_damage_type", data.get("damage_type", "")))
	var style := String(data.get("projectile_style", ""))
	var path := String(data.get("travel_path", ""))
	if style in ["web", "web_snap"] or path == "tether":
		return "web_tether"
	if style in ["explosive", "blast"] or (style == "missile" and float(data.get("explosion_radius", 0.0)) > 0.0):
		return "explosive"
	if damage_type == "bullet":
		if style in ["true_bullet", "rail"]:
			return "true_bullet"
		if style in ["", "bullet", "bullet_hell"]:
			return "bullet_hell"
	if damage_type == "chemical":
		return "chemical_firework" if path in ["firework", "shotgun", "burst", "sine", "arc_u"] else "chemical_line"
	return ""


func _group_uses_true_bullet(group: Dictionary) -> bool:
	if not bool(group.get("projectile", false)):
		return false
	return _projectile_behavior_for_data(group) == "true_bullet"


func _is_true_bullet_event(event: Dictionary) -> bool:
	if bool(event.get("true_bullet_ready", false)):
		return false
	if bool(event.get("non_damage", false)):
		return false
	if not bool(event.get("projectile", false)):
		return false
	return _projectile_behavior_for_data(event) == "true_bullet"


func _projectile_event_has_gun_source(event: Dictionary) -> bool:
	if not bool(event.get("projectile", false)):
		return true
	if not event.has("muscle_node") or not event.has("collision_group"):
		return false
	var group_raw = event.get("collision_group", {})
	if not (group_raw is Dictionary):
		return false
	var group: Dictionary = group_raw
	if not bool(group.get("projectile", false)) and not bool(group.get("projectile_only", false)):
		return false
	var material_class := String(group.get("material_class", "")).to_lower()
	if material_class in ["gun", "missile_launcher", "web_gun"]:
		return true
	var shape := String(group.get("shape", "")).to_lower()
	return shape in ["gun", "rifle", "turret", "heavy_cannon", "mortar", "missile_rack", "web_gun"]


func _projectile_source_node_for_event(event: Dictionary, fallback: int = 0) -> int:
	return int(event.get("source_gun_node", event.get("source_node_index", event.get("muscle_node", fallback))))


func _clear_runtime_gun_pose_for_payload(unit, payload: Dictionary) -> void:
	if not _is_live_unit(unit) or not unit.has_method("clear_aim_pose"):
		return
	var node_index := -1
	if payload.has("source_gun_node") or payload.has("source_node_index") or payload.has("muscle_node"):
		node_index = _projectile_source_node_for_event(payload, -1)
	elif payload.has("binding") and payload.get("binding", {}) is Dictionary:
		var binding: Dictionary = payload.get("binding", {})
		var target_nodes: Array = Array(binding.get("target_nodes", []))
		if not target_nodes.is_empty():
			node_index = int(target_nodes[target_nodes.size() - 1])
	elif payload.has("target_nodes"):
		var direct_nodes: Array = Array(payload.get("target_nodes", []))
		if not direct_nodes.is_empty():
			node_index = int(direct_nodes[direct_nodes.size() - 1])
	unit.clear_aim_pose(node_index, true)


func _event_is_explicit_gun_activation(event: Dictionary) -> bool:
	var profile := String(event.get("module_action_profile", ""))
	if _gun_activation_profiles().has(profile):
		return true
	return bool(event.get("gun_activation", false)) and _gun_activation_profiles().has(profile)


func _clear_projectile_fields_for_runtime_melee(event: Dictionary) -> void:
	event["projectile"] = false
	event["projectile_only"] = false
	event["runtime_melee_contact"] = true
	event.erase("projectile_style")
	event.erase("projectile_behavior")
	event.erase("travel_path")
	event.erase("projectile_damage_type")


func _normalize_runtime_attack_event(attacker, event: Dictionary) -> Dictionary:
	if event.is_empty() or _event_is_explicit_gun_activation(event):
		return event
	if _unit_uses_direct_runtime_topology(attacker) or bool(event.get("runtime_binding", false)) or String(event.get("module_action_profile", "")) != "":
		_clear_projectile_fields_for_runtime_melee(event)
	return event


func _is_true_bullet_fired_event(event: Dictionary) -> bool:
	return bool(event.get("projectile", false)) and bool(event.get("true_bullet_ready", false)) and _projectile_behavior_for_data(event) == "true_bullet"


func _true_bullet_lock_color(attacker) -> Color:
	if attacker != null and is_instance_valid(attacker) and int(attacker.owner_id) == 2:
		return Color(1.0, 0.38, 0.7, 1.0)
	return Color(1.0, 0.78, 0.26, 1.0)


func _true_bullet_direction_to_target(attacker, target) -> Vector2:
	if not _is_live_unit(attacker) or not _is_live_unit(target):
		return _unit_forward_vector(attacker)
	var delta := _mobius_delta_vec_between(attacker, target)
	if delta.length() <= 0.01:
		return _unit_forward_vector(attacker)
	return delta.normalized()


func _true_bullet_event_for_aim(attacker, direction: Vector2, group: Dictionary, attack_index: int, base_event: Dictionary = {}) -> Dictionary:
	var event := base_event.duplicate(true)
	event["projectile"] = true
	event["damage_type"] = "bullet"
	event["projectile_damage_type"] = "bullet"
	event["projectile_behavior"] = "true_bullet"
	event["projectile_style"] = String(group.get("projectile_style", "true_bullet"))
	event["travel_path"] = "instant_line"
	var locked_direction := direction.normalized() if direction.length() > 0.01 else _unit_forward_vector(attacker)
	event["direction"] = locked_direction
	event["muscle_node"] = attack_index
	event["collision_group"] = group.duplicate(true)
	event["range"] = maxf(float(group.get("projectile_range", group.get("range", 0.0))), _laser_visible_world_range(attacker, locked_direction))
	event["lane_range"] = maxf(float(event.get("lane_range", 0.16)), float(group.get("bullet_lock_radius", TRUE_BULLET_DEFAULT_LOCK_RADIUS)))
	return event


func _acquire_true_bullet_target(attacker, event: Dictionary):
	if not _is_live_unit(attacker):
		return null
	var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(attacker)
	direction = direction.normalized()
	var test_event := event.duplicate(true)
	test_event["direction"] = direction
	test_event["range"] = _laser_visible_world_range(attacker, direction)
	test_event["lane_range"] = maxf(float(test_event.get("lane_range", 0.16)), float(test_event.get("bullet_lock_radius", TRUE_BULLET_DEFAULT_LOCK_RADIUS)))
	var collider: Dictionary = _attack_collider_for_event(attacker, test_event)
	if collider.is_empty():
		return null
	var start: Vector2 = collider.get("a", Vector2(attacker.ring_pos, attacker.lane))
	var best = null
	var best_distance := 999999.0
	for target in _enemy_units(int(attacker.owner_id)):
		if not _is_live_unit(target):
			continue
		var hit := _attack_part_hit(attacker, target, test_event)
		if hit.is_empty():
			continue
		var hit_position: Vector2 = hit.get("position", Vector2(target.ring_pos, target.lane))
		var delta := _mobius_delta_points(start.x, start.y, hit_position.x, hit_position.y)
		var distance := delta.dot(direction)
		if distance >= 0.0 and distance < best_distance:
			best_distance = distance
			best = target
	if best == null:
		var wrapped_hit := _sniper_wrapped_aim_query(attacker, start, direction)
		if not wrapped_hit.is_empty() and _is_live_unit(wrapped_hit.get("target", null)):
			best = wrapped_hit.get("target", null)
	return best


func _missile_target_class(target) -> String:
	if not _is_live_unit(target):
		return ""
	var role_key := String(target.role)
	if role_key == "" or not ROLE_ORDER.has(role_key):
		for player_id in active_units.keys():
			var roster: Dictionary = active_units[player_id]
			if roster.get("hero", null) == target:
				role_key = "hero"
				break
			if roster.get("barrier", null) == target:
				role_key = "barrier"
				break
			if Array(roster.get("puppet", [])).has(target):
				role_key = "puppet"
				break
	if role_key == "hero" or role_key == "puppet":
		return role_key
	if role_key != "barrier":
		return "barrier_other"
	if bool(target.stats.get("is_repair_station", false)) or bool(target.stats.get("is_coolant_field", false)) or bool(target.stats.get("is_coin_generator", false)) or bool(target.stats.get("is_resource_siphon", false)):
		return "barrier_support"
	var support_kind := String(target.stats.get("support_kind", ""))
	if support_kind in ["ammo", "repair", "cooling", "damage_buff", "armor", "resource"]:
		return "barrier_support"
	if bool(target.stats.get("is_barrage_emitter", false)) or bool(target.stats.get("is_trap_field", false)) or bool(target.stats.get("is_homing_launcher", false)) or bool(target.stats.get("is_hatchery", false)) or bool(target.stats.get("is_signal_jammer", false)) or bool(target.stats.get("is_hack_field", false)) or bool(target.stats.get("is_cage_wall", false)) or bool(target.stats.get("reflect_projectiles", false)):
		return "barrier_attack"
	return "barrier_other"


func _missile_target_class_allowed(target_class: String, event: Dictionary) -> bool:
	var classes: Array = Array(event.get("missile_lock_target_classes", ["hero", "puppet", "barrier_support", "barrier_attack", "barrier_other"]))
	return classes.is_empty() or classes.has(target_class)


func _missile_target_visible_same_screen(target) -> bool:
	if not _is_live_unit(target):
		return false
	var screen := _screen_from_ring(target.ring_pos, target.lane)
	return bool(screen.get("visible", false))


func _missile_lock_score(attacker, target, event: Dictionary, direction: Vector2) -> float:
	var target_delta := _mobius_delta_vec_between(attacker, target)
	var distance := target_delta.length()
	var target_dir := target_delta.normalized() if distance > 0.001 else direction
	var aim_error := acos(clampf(direction.normalized().dot(target_dir), -1.0, 1.0))
	var target_class := _missile_target_class(target)
	var priority := String(event.get("missile_lock_priority", "screen_hero_first"))
	if priority == "near_first":
		return distance * 1000.0 + aim_error * 10.0
	if priority == "far_first":
		return -distance * 1000.0 + aim_error * 10.0
	var role_rank := 4.0
	match target_class:
		"hero":
			role_rank = 0.0
		"puppet":
			role_rank = 1.0
		"barrier_support":
			role_rank = 2.0
		"barrier_attack":
			role_rank = 3.0
	var screen_rank := 0.0 if _missile_target_visible_same_screen(target) else 1.0
	return role_rank * 1000000.0 + screen_rank * 100000.0 + aim_error * 1000.0 + distance


func _acquire_missile_lock_target(attacker, event: Dictionary):
	if not _is_live_unit(attacker):
		return null
	var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(attacker)
	direction = direction.normalized()
	var max_range := maxf(0.1, float(event.get("missile_lock_range", event.get("range", STANDARD_MISSILE_RANGE_M))))
	var cone_cos := cos(deg_to_rad(clampf(float(event.get("missile_lock_cone_degrees", 52.0)), 1.0, 178.0)) * 0.5)
	var best = null
	var best_score := 1.0e20
	for target in _enemy_units(int(attacker.owner_id)):
		if not _is_live_unit(target):
			continue
		var target_class := _missile_target_class(target)
		if not _missile_target_class_allowed(target_class, event):
			continue
		var delta := _mobius_delta_vec_between(attacker, target)
		var distance := delta.length()
		if distance <= 0.001 or distance > max_range:
			continue
		var target_dir := delta / distance
		if direction.dot(target_dir) < cone_cos:
			continue
		if _map_line_occluded(attacker, target, event):
			continue
		var score := _missile_lock_score(attacker, target, event, direction)
		if score < best_score:
			best_score = score
			best = target
	return best


func _missile_direction_to_target(attacker, target, fallback: Vector2 = Vector2.ZERO) -> Vector2:
	if _is_live_unit(attacker) and _is_live_unit(target):
		var delta := _mobius_delta_vec_between(attacker, target)
		if delta.length() > 0.01:
			return delta.normalized()
	if fallback.length() > 0.01:
		return fallback.normalized()
	return _unit_forward_vector(attacker)


func _map_occlusion_kind_for_data(data: Dictionary, fallback: Dictionary = {}) -> String:
	var material_class := String(data.get("material_class", fallback.get("material_class", ""))).to_lower()
	var shape := String(data.get("shape", fallback.get("shape", ""))).to_lower()
	var family := String(data.get("panel_family", fallback.get("panel_family", ""))).to_lower()
	if bool(data.get("is_one_way_shield", fallback.get("is_one_way_shield", false))) or material_class == "one_way_shield":
		return MAP_OCCLUSION_ONE_WAY
	if bool(data.get("is_cage_wall", fallback.get("is_cage_wall", false))):
		return MAP_OCCLUSION_CAGE
	if bool(data.get("reflect_projectiles", fallback.get("reflect_projectiles", false))) or material_class == "reflector" or family == "reflector":
		return MAP_OCCLUSION_REFLECTOR
	if material_class in ["barrier_wall", "signal_jammer"] or material_class.contains("wall_joint") or material_class.contains("corner_joint"):
		return MAP_OCCLUSION_SOLID
	if family == "wall" or shape.contains("wall") or shape.contains("bulkhead") or shape.contains("cage") or shape.contains("corner"):
		return MAP_OCCLUSION_SOLID
	return MAP_OCCLUSION_NONE


func _map_occlusion_kind_for_collider(unit, collider: Dictionary) -> String:
	var fallback: Dictionary = unit.stats if _is_live_unit(unit) else {}
	if String(collider.get("part_kind", "")) == "barrier_tile" and _is_live_unit(unit):
		var tile := _barrier_tile_by_index(unit, int(collider.get("part_index", -1)))
		if not tile.is_empty():
			return _map_occlusion_kind_for_data(tile, fallback)
	return _map_occlusion_kind_for_data(collider, fallback)


func _map_occlusion_collider_for_event(attacker, event: Dictionary) -> Dictionary:
	if not _is_live_unit(attacker):
		return {}
	var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(attacker)
	direction = direction.normalized()
	var start := _combat_patch_origin_for_unit(attacker)
	var path_range := maxf(0.04, float(event.get("range", event.get("projectile_range", VIEW_WIDTH))))
	var width := maxf(float(event.get("projectile_width_m", 0.0)), float(event.get("lane_range", 0.08)))
	return {
		"shape": "capsule",
		"a": start,
		"b": start + direction * path_range,
		"radius": maxf(0.018, width * 0.5),
	}


func _map_occlusion_collider_between(attacker, target, event: Dictionary) -> Dictionary:
	if not _is_live_unit(attacker) or not _is_live_unit(target):
		return {}
	var start := _combat_patch_origin_for_unit(attacker)
	var delta := _mobius_delta_vec_between(attacker, target)
	if delta.length() <= 0.01:
		return {}
	var width := maxf(float(event.get("projectile_width_m", 0.0)), float(event.get("lane_range", 0.08)))
	return {
		"shape": "capsule",
		"a": start,
		"b": start + delta,
		"radius": maxf(0.018, width * 0.5),
	}


func _map_occlusion_query_for_path(attacker, path_collider: Dictionary, event: Dictionary, skip_units: Array = []) -> Dictionary:
	if not _is_live_unit(attacker) or path_collider.is_empty():
		return {}
	var start: Vector2 = path_collider.get("a", _collider_center(path_collider))
	var end: Vector2 = path_collider.get("b", start)
	var direction := end - start
	var path_length := direction.length()
	if path_length <= 0.01:
		return {}
	direction = direction / path_length
	var best: Dictionary = {}
	var best_distance := 999999.0
	for blocker in all_units:
		if blocker == attacker or skip_units.has(blocker) or not _is_live_unit(blocker):
			continue
		for raw_collider in _unit_part_colliders(blocker):
			if not (raw_collider is Dictionary):
				continue
			var raw_blocker_collider: Dictionary = raw_collider
			var kind := _map_occlusion_kind_for_collider(blocker, raw_blocker_collider)
			if kind == MAP_OCCLUSION_NONE:
				continue
			var blocker_collider := _shift_collider_to_origin(raw_blocker_collider, start.x, start.y)
			if _collider_gap(path_collider, blocker_collider) > 0.0:
				continue
			if kind == MAP_OCCLUSION_ONE_WAY and _one_way_shield_allows_projectile(blocker, attacker, direction):
				continue
			var center := _collider_center(blocker_collider)
			var projection := (center - start).dot(direction)
			var extent := _collider_extent_radius(blocker_collider)
			if projection < -extent or projection > path_length + extent:
				continue
			var distance := clampf(projection, 0.0, path_length)
			if distance >= best_distance:
				continue
			best_distance = distance
			best = {
				"kind": kind,
				"blocker": blocker,
				"blocker_name": String(blocker.unit_name),
				"position": start + direction * distance,
				"distance": distance,
				"collider": blocker_collider.duplicate(true),
			}
	return best


func _map_occlusion_query_for_event(attacker, event: Dictionary, skip_units: Array = []) -> Dictionary:
	return _map_occlusion_query_for_path(attacker, _map_occlusion_collider_for_event(attacker, event), event, skip_units)


func _map_occlusion_query_between(attacker, target, event: Dictionary = {}) -> Dictionary:
	return _map_occlusion_query_for_path(attacker, _map_occlusion_collider_between(attacker, target, event), event, [target])


func _map_occlusion_kind_between(attacker, target, event: Dictionary = {}) -> String:
	var query := _map_occlusion_query_between(attacker, target, event)
	return String(query.get("kind", MAP_OCCLUSION_NONE))


func _map_line_occluded(attacker, target, event: Dictionary = {}) -> bool:
	return _map_occlusion_kind_between(attacker, target, event) != MAP_OCCLUSION_NONE


func _map_line_of_sight_clear(attacker, target, event: Dictionary = {}) -> bool:
	return not _map_line_occluded(attacker, target, event)


func _missile_target_occluded(attacker, target, event: Dictionary) -> bool:
	if not _is_live_unit(attacker) or not _is_live_unit(target):
		return true
	return _map_line_occluded(attacker, target, event)


func _spawn_true_bullet_lock_effect(target, attacker, lock_time: float) -> TrueBulletTargetLockEffect:
	if effects_root == null or not _is_live_unit(target):
		return null
	var effect := TrueBulletTargetLockEffect.new()
	effect.setup(lock_time, _true_bullet_lock_color(attacker))
	var screen := _screen_from_ring(target.ring_pos, target.lane)
	effect.position = screen["position"]
	effect.visible = bool(screen["visible"])
	effects_root.add_child(effect)
	return effect


func _queue_true_bullet_lock(attacker, event: Dictionary) -> bool:
	if not _is_live_unit(attacker):
		return false
	var shot_event := event.duplicate(true)
	shot_event["projectile_behavior"] = "true_bullet"
	shot_event["projectile_style"] = "true_bullet"
	shot_event["travel_path"] = "instant_line"
	var direction: Vector2 = shot_event.get("direction", _unit_forward_vector(attacker))
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(attacker)
	direction = direction.normalized()
	shot_event["direction"] = direction
	if attacker.has_method("set_aim_pose"):
		attacker.set_aim_pose(int(shot_event.get("muscle_node", 0)), direction, 0.18)
	shot_event["range"] = maxf(float(shot_event.get("range", 0.0)), _laser_visible_world_range(attacker, direction))
	var target = shot_event.get("locked_target", null)
	if _is_live_unit(target) and _map_line_occluded(attacker, target, shot_event):
		target = null
	if not _is_live_unit(target):
		target = _acquire_true_bullet_target(attacker, shot_event)
	if not _is_live_unit(target):
		_spawn_projectile_trace(attacker, shot_event)
		_show_battle_message("%s TRUE BULLET: no lock" % String(attacker.unit_name), 0.52)
		_clear_runtime_gun_pose_for_payload(attacker, shot_event)
		return true
	shot_event["locked_target"] = target
	shot_event["aim_locked"] = true
	var lock_time := clampf(float(shot_event.get("bullet_lock_time", TRUE_BULLET_DEFAULT_LOCK_SECONDS)), TRUE_BULLET_MIN_LOCK_SECONDS, TRUE_BULLET_MAX_LOCK_SECONDS)
	var lock_effect := _spawn_true_bullet_lock_effect(target, attacker, lock_time)
	pending_true_bullet_shots.append({
		"attacker": attacker,
		"target": target,
		"event": shot_event,
		"timer": lock_time,
		"effect": lock_effect,
	})
	attacker.set_meta("projectile_signal", lock_time + 0.14)
	_show_battle_message("%s TRUE BULLET LOCK %.1fs" % [String(attacker.unit_name), lock_time], 0.64)
	return true


func _update_true_bullet_locks(delta: float) -> void:
	for index in range(pending_true_bullet_shots.size() - 1, -1, -1):
		var shot: Dictionary = pending_true_bullet_shots[index]
		var attacker = shot.get("attacker", null)
		var target = shot.get("target", null)
		var effect = shot.get("effect", null)
		if not _is_live_unit(attacker) or not _is_live_unit(target):
			if effect != null and is_instance_valid(effect):
				effect.queue_free()
			if _is_live_unit(attacker):
				var failed_event: Dictionary = shot.get("event", {})
				_clear_runtime_gun_pose_for_payload(attacker, failed_event)
			pending_true_bullet_shots.remove_at(index)
			continue
		if effect != null and is_instance_valid(effect):
			var screen := _screen_from_ring(target.ring_pos, target.lane)
			effect.position = screen["position"]
			effect.visible = bool(screen["visible"])
		var held_direction := _true_bullet_direction_to_target(attacker, target)
		if attacker.has_method("set_aim_pose"):
			var held_event: Dictionary = shot.get("event", {})
			attacker.set_aim_pose(_projectile_source_node_for_event(held_event), held_direction, 0.14)
		var timer := float(shot.get("timer", 0.0)) - delta
		if timer <= 0.0:
			if effect != null and is_instance_valid(effect):
				effect.queue_free()
			pending_true_bullet_shots.remove_at(index)
			var event: Dictionary = shot.get("event", {})
			var direction := _true_bullet_direction_to_target(attacker, target)
			if attacker.has_method("set_aim_pose"):
				attacker.set_aim_pose(_projectile_source_node_for_event(event), direction, 0.2)
			event["direction"] = direction
			event["range"] = maxf(float(event.get("range", 0.0)), _laser_visible_world_range(attacker, direction))
			event["true_bullet_ready"] = true
			event["aim_locked"] = true
			event["locked_target"] = target
			event["projectile_behavior"] = "true_bullet"
			event["projectile_style"] = "true_bullet"
			event["travel_path"] = "instant_line"
			_resolve_attack(attacker, event)
			_clear_runtime_gun_pose_for_payload(attacker, event)
			continue
		shot["timer"] = timer
		pending_true_bullet_shots[index] = shot


func _is_chemical_projectile_event(event: Dictionary) -> bool:
	if bool(event.get("non_damage", false)):
		return false
	if not bool(event.get("projectile", false)):
		return false
	var damage_type := String(event.get("damage_type", event.get("projectile_damage_type", "")))
	return damage_type == "chemical"


func _prepare_chemical_projectile_event(event: Dictionary) -> void:
	event["damage_type"] = "chemical"
	event["projectile_damage_type"] = "chemical"
	if String(event.get("projectile_style", "")) == "":
		event["projectile_style"] = "spray"
	if String(event.get("projectile_behavior", "")) == "":
		event["projectile_behavior"] = "chemical_firework" if _chemical_firework_event(event) else "chemical_line"
	if not event.has("projectile_speed_mult") or float(event.get("projectile_speed_mult", 0.0)) <= 0.0:
		event["projectile_speed_mult"] = CHEMICAL_PROJECTILE_DEFAULT_SPEED_MULT
	event["projectile_speed_mult"] = clampf(float(event.get("projectile_speed_mult", CHEMICAL_PROJECTILE_DEFAULT_SPEED_MULT)), 0.35, 1.45)
	if not event.has("chemical_dot_duration"):
		event["chemical_dot_duration"] = CHEMICAL_DOT_DEFAULT_DURATION
	if not event.has("chemical_dot_mult"):
		event["chemical_dot_mult"] = CHEMICAL_DOT_DEFAULT_MULT
	if not event.has("chemical_frontload"):
		event["chemical_frontload"] = CHEMICAL_DOT_DEFAULT_FRONTLOAD
	if not event.has("chemical_pellets"):
		event["chemical_pellets"] = 7 if _chemical_firework_event(event) else 1
	if not event.has("chemical_spread"):
		event["chemical_spread"] = 0.54 if _chemical_firework_event(event) else 0.0


func _chemical_firework_event(event: Dictionary) -> bool:
	var behavior := String(event.get("projectile_behavior", ""))
	if behavior == "chemical_firework":
		return true
	var path := String(event.get("travel_path", "straight"))
	return path in ["firework", "shotgun", "burst", "sine", "arc_u"]


func _queue_chemical_projectile(attacker, event: Dictionary) -> bool:
	if not _is_live_unit(attacker):
		return false
	var shot_event := event.duplicate(true)
	_prepare_chemical_projectile_event(shot_event)
	var direction: Vector2 = shot_event.get("direction", _unit_forward_vector(attacker))
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(attacker)
	shot_event["direction"] = direction.normalized()
	shot_event["chemical_projectile_ready"] = true
	_apply_weapon_recoil_from_momentum(attacker, shot_event)
	var travel_time := _chemical_projectile_travel_time(shot_event)
	_spawn_projectile_trace(attacker, shot_event)
	shot_event["projectile_trace_spawned"] = true
	pending_chemical_projectiles.append({
		"attacker": attacker,
		"event": shot_event,
		"timer": travel_time,
	})
	attacker.set_meta("projectile_signal", travel_time + 0.12)
	_show_battle_message("%s CHEM SPLASH %.1fs" % [String(attacker.unit_name), travel_time], 0.48)
	return true


func _chemical_projectile_travel_time(event: Dictionary) -> float:
	var travel_range := maxf(0.4, float(event.get("range", event.get("projectile_range", 1.2))))
	var speed_mult := clampf(float(event.get("projectile_speed_mult", CHEMICAL_PROJECTILE_DEFAULT_SPEED_MULT)), 0.35, 1.45)
	return clampf(travel_range / (2.15 * speed_mult), CHEMICAL_PROJECTILE_MIN_TRAVEL, CHEMICAL_PROJECTILE_MAX_TRAVEL)


func _update_chemical_projectiles(delta: float) -> void:
	for index in range(pending_chemical_projectiles.size() - 1, -1, -1):
		var shot: Dictionary = pending_chemical_projectiles[index]
		var attacker = shot.get("attacker", null)
		if not _is_live_unit(attacker):
			pending_chemical_projectiles.remove_at(index)
			continue
		var timer := float(shot.get("timer", 0.0)) - delta
		if timer <= 0.0:
			pending_chemical_projectiles.remove_at(index)
			var event: Dictionary = shot.get("event", {})
			event["chemical_projectile_ready"] = true
			_resolve_attack(attacker, event)
			continue
		shot["timer"] = timer
		pending_chemical_projectiles[index] = shot


func _is_missile_projectile_event(event: Dictionary) -> bool:
	if bool(event.get("missile_flight_ready", false)):
		return false
	if bool(event.get("non_damage", false)):
		return false
	if not bool(event.get("projectile", false)):
		return false
	return String(event.get("projectile_style", "")) == "missile" and String(event.get("travel_path", "")) == "homing"


func _missile_projectile_travel_time(attacker, target, event: Dictionary) -> float:
	var range_hint := maxf(0.4, float(event.get("range", event.get("projectile_range", STANDARD_MISSILE_RANGE_M))))
	if _is_live_unit(attacker) and _is_live_unit(target):
		range_hint = maxf(0.2, _mobius_delta_vec_between(attacker, target).length())
	var speed_mult := clampf(float(event.get("projectile_speed_mult", STANDARD_MISSILE_SPEED_MULT)), 0.45, 1.45)
	return clampf(range_hint / (2.05 * speed_mult), 0.38, 2.2)


func _queue_missile_projectile(attacker, event: Dictionary) -> bool:
	if not _is_live_unit(attacker):
		return false
	var shot_event := event.duplicate(true)
	shot_event["projectile_style"] = "missile"
	shot_event["projectile_behavior"] = "explosive"
	shot_event["travel_path"] = "homing"
	var target = shot_event.get("locked_target", null)
	if not _is_live_unit(target):
		target = _acquire_missile_lock_target(attacker, shot_event)
	if not _is_live_unit(target):
		_show_battle_message("%s MISSILE: no lock" % String(attacker.unit_name), 0.52)
		return true
	var direction := _missile_direction_to_target(attacker, target, Vector2(shot_event.get("direction", _unit_forward_vector(attacker))))
	shot_event["locked_target"] = target
	shot_event["aim_locked"] = true
	shot_event["direction"] = direction
	shot_event["range"] = maxf(float(shot_event.get("range", STANDARD_MISSILE_RANGE_M)), _mobius_delta_vec_between(attacker, target).length())
	_apply_weapon_recoil_from_momentum(attacker, shot_event)
	_spawn_projectile_trace(attacker, shot_event)
	shot_event["projectile_trace_spawned"] = true
	pending_missile_projectiles.append({
		"attacker": attacker,
		"target": target,
		"event": shot_event,
		"timer": _missile_projectile_travel_time(attacker, target, shot_event),
		"occluded_for": 0.0,
		"last_direction": direction,
	})
	attacker.set_meta("projectile_signal", float(pending_missile_projectiles[pending_missile_projectiles.size() - 1].get("timer", 0.5)) + 0.12)
	_show_battle_message("%s MISSILE LOCK" % String(attacker.unit_name), 0.5)
	return true


func _update_missile_projectiles(delta: float) -> void:
	for index in range(pending_missile_projectiles.size() - 1, -1, -1):
		var shot: Dictionary = pending_missile_projectiles[index]
		var attacker = shot.get("attacker", null)
		if not _is_live_unit(attacker):
			pending_missile_projectiles.remove_at(index)
			continue
		var event: Dictionary = shot.get("event", {})
		var target = shot.get("target", null)
		var last_direction: Vector2 = shot.get("last_direction", Vector2(event.get("direction", _unit_forward_vector(attacker))))
		if _is_live_unit(target):
			var current_direction := _missile_direction_to_target(attacker, target, last_direction)
			if _missile_target_occluded(attacker, target, event):
				shot["occluded_for"] = float(shot.get("occluded_for", 0.0)) + delta
			else:
				shot["occluded_for"] = 0.0
				last_direction = current_direction
			if float(shot.get("occluded_for", 0.0)) > float(event.get("missile_occlusion_grace", STANDARD_MISSILE_OCCLUSION_GRACE)):
				target = null
				shot["target"] = null
				event.erase("locked_target")
				event["aim_locked"] = false
			else:
				event["locked_target"] = target
				event["direction"] = current_direction
		event["direction"] = last_direction.normalized() if last_direction.length() > 0.01 else _unit_forward_vector(attacker)
		shot["last_direction"] = event["direction"]
		var timer := float(shot.get("timer", 0.0)) - delta
		if timer <= 0.0:
			pending_missile_projectiles.remove_at(index)
			event["missile_flight_ready"] = true
			event["projectile_trace_spawned"] = true
			if _is_live_unit(target):
				event["direction"] = _missile_direction_to_target(attacker, target, event["direction"])
				event["locked_target"] = target
				event["aim_locked"] = true
			_resolve_attack(attacker, event)
			continue
		shot["timer"] = timer
		shot["event"] = event
		pending_missile_projectiles[index] = shot


func _resolve_chemical_firework(attacker, event: Dictionary) -> void:
	var pellets := clampi(int(event.get("chemical_pellets", 7)), 3, 11)
	var spread := clampf(float(event.get("chemical_spread", 0.54)), 0.12, 1.1)
	var base_dir: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	if base_dir.length() <= 0.01:
		base_dir = _unit_forward_vector(attacker)
	base_dir = base_dir.normalized()
	for i in range(pellets):
		var t := 0.0 if pellets <= 1 else float(i) / float(pellets - 1)
		var angle := lerpf(-spread * 0.5, spread * 0.5, t)
		var pellet := event.duplicate(true)
		pellet["chemical_firework_expanded"] = true
		pellet["direction"] = base_dir.rotated(angle).normalized()
		pellet["range"] = float(event.get("range", 1.0)) * (0.82 + 0.06 * float(i % 3))
		pellet["lane_range"] = maxf(0.04, float(event.get("lane_range", 0.2)) * 0.62)
		pellet["damage"] = maxi(1, int(roundf(float(event.get("damage", 1)) * 0.46)))
		pellet["travel_path"] = "straight"
		_resolve_attack(attacker, pellet)


func _projection_to_target(attacker, target, direction: Vector2) -> float:
	if not _is_live_unit(attacker) or not _is_live_unit(target):
		return 999999.0
	var delta := _mobius_delta_vec_between(attacker, target)
	return delta.dot(direction.normalized() if direction.length() > 0.01 else _unit_forward_vector(attacker))


func _true_bullet_unit_before_locked_target(attacker, unit, locked_target, event: Dictionary) -> bool:
	var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	var target_distance := _projection_to_target(attacker, locked_target, direction)
	var unit_distance := _projection_to_target(attacker, unit, direction)
	return unit_distance >= 0.0 and unit_distance <= target_distance - 0.035


func _true_bullet_target_blocked(attacker, locked_target, event: Dictionary) -> bool:
	if _map_line_occluded(attacker, locked_target, event):
		return true
	for blocker in _enemy_units(int(attacker.owner_id)):
		if blocker == locked_target or not _is_live_unit(blocker):
			continue
		if not _true_bullet_unit_before_locked_target(attacker, blocker, locked_target, event):
			continue
		if not _attack_part_hit(attacker, blocker, event).is_empty():
			return true
	return false


func _projectile_consumes_on_first_hit(event: Dictionary) -> bool:
	if not bool(event.get("projectile", false)):
		return false
	if bool(event.get("non_damage", false)):
		return false
	var style := String(event.get("projectile_style", ""))
	if style in ["web", "web_snap", "blind", "shield", "chain"]:
		return false
	var damage_type := String(event.get("damage_type", ""))
	return damage_type in PROJECTILE_DAMAGE_TYPES or style in ["beam", "chaos", "true_bullet", "bullet_hell", "spray", "missile", "explosive", "blast"]


func _projectile_projection_from(attacker, position: Vector2, direction: Vector2) -> float:
	if not _is_live_unit(attacker):
		return 999999.0
	var normalized := direction.normalized() if direction.length() > 0.01 else _unit_forward_vector(attacker)
	var delta := _mobius_delta_unit_to_point(attacker, position.x, position.y)
	return delta.dot(normalized)


func _first_projectile_impact(attacker, event: Dictionary) -> Dictionary:
	if not _is_live_unit(attacker):
		return {}
	if _unit_uses_direct_runtime_topology(attacker):
		return _first_projectile_impact_gpu(attacker, event)
	var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(attacker)
	direction = direction.normalized()
	var best: Dictionary = {}
	var best_distance := 999999.0
	for target in _enemy_units(int(attacker.owner_id)):
		if not _is_live_unit(target):
			continue
		if _is_true_bullet_fired_event(event):
			var locked_target = event.get("locked_target", null)
			if _is_live_unit(locked_target):
				if target == locked_target and _true_bullet_target_blocked(attacker, locked_target, event):
					continue
				if target != locked_target and not _true_bullet_unit_before_locked_target(attacker, target, locked_target, event):
					continue
		var hit := _attack_part_hit(attacker, target, event)
		if hit.is_empty():
			continue
		var hit_position: Vector2 = hit.get("position", Vector2(target.ring_pos, target.lane))
		var projection := _projectile_projection_from(attacker, hit_position, direction)
		if projection < -0.001:
			continue
		if projection < best_distance:
			best_distance = projection
			best = {
				"target": target,
				"hit": hit,
				"position": hit_position,
				"distance": best_distance,
			}
	return best


func _first_projectile_impact_gpu(attacker, event: Dictionary) -> Dictionary:
	if not _is_live_unit(attacker) or not _gpu_collision_available():
		return {}
	var attack_collider: Dictionary = _attack_collider_for_event(attacker, event)
	if attack_collider.is_empty():
		return {}
	var start: Vector2 = attack_collider.get("a", _collider_center(attack_collider))
	var end: Vector2 = attack_collider.get("b", start)
	var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	if direction.length() > 0.01:
		var range := maxf(float(event.get("range", event.get("projectile_range", start.distance_to(end)))), start.distance_to(end))
		var ray := GameplayTransform.projectile_ray(start, direction, range)
		end = ray.get("end", end)
		direction = ray.get("direction", direction.normalized())
	var gpu_colliders: Array = []
	var entries: Array = []
	var unit_key := 2
	for target in _enemy_units(int(attacker.owner_id)):
		if not _is_live_unit(target):
			continue
		_append_gpu_collision_unit_colliders(target, _unit_part_colliders(target), start.x, unit_key, entries, gpu_colliders, start.y, event)
		unit_key += 1
	if gpu_colliders.is_empty():
		return {}
	var hits := _submit_gpu_geometry_queries_deferred(gpu_colliders, [{
		"start": start,
		"end": end,
		"radius": maxf(0.0, float(attack_collider.get("radius", event.get("lane_range", 0.0)))),
		"owner_unit_key": 1,
		"owner_team_key": int(attacker.owner_id),
		"query_id": 0,
		"include_friendly": false,
	}], get_physics_process_delta_time())
	if hits.is_empty():
		return {}
	var best: Dictionary = {}
	var best_distance := 999999.0
	for raw_hit in hits:
		if not (raw_hit is Dictionary):
			continue
		var hit_record: Dictionary = raw_hit
		var collider_index := int(hit_record.get("collider_index", -1))
		if collider_index < 0 or collider_index >= entries.size():
			continue
		var entry: Dictionary = Dictionary(entries[collider_index])
		var target = entry.get("unit", null)
		if not _is_live_unit(target):
			continue
		if _map_line_occluded(attacker, target, event):
			continue
		var distance := float(hit_record.get("distance", 999999.0))
		if distance >= best_distance:
			continue
		var target_collider: Dictionary = Dictionary(entry.get("query", entry.get("raw", {})))
		best_distance = distance
		best = {
			"target": target,
			"hit": {
				"part_index": int(target_collider.get("part_index", -1)),
				"part_kind": String(target_collider.get("part_kind", "core")),
				"part_name": String(target_collider.get("name", "CORE")),
				"torso_unit_index": int(target_collider.get("torso_unit_index", -1)),
				"target_terminal_weapon_kind": String(target_collider.get("terminal_weapon_kind", "")),
				"attacker_part_kind": String(attack_collider.get("part_kind", "")),
				"attacker_terminal_weapon_kind": String(attack_collider.get("terminal_weapon_kind", "")),
				"attacker_runtime_topology": true,
				"position": hit_record.get("position", _collider_center(target_collider)),
				"gap": -RUNTIME_CONTACT_REQUIRED_OVERLAP,
				"attacker_collider": attack_collider.duplicate(true),
				"target_collider": target_collider.duplicate(true),
				"contact_normal": hit_record.get("normal", Vector2.ZERO),
				"gpu_query_hit": true,
			},
			"position": hit_record.get("position", Vector2(target.ring_pos, target.lane)),
			"distance": best_distance,
		}
	return best


func _sniper_wrapped_aim_query(unit, muzzle: Vector2, aim_dir: Vector2) -> Dictionary:
	if not _is_live_unit(unit):
		return {}
	var direction := aim_dir.normalized() if aim_dir.length() > 0.01 else _unit_forward_vector(unit)
	var event := {
		"projectile": true,
		"gun_activation": true,
		"module_action_profile": "gun_activate",
		"projectile_behavior": "true_bullet",
		"projectile_style": "true_bullet",
		"damage_type": "bullet",
		"projectile_damage_type": "bullet",
		"direction": direction,
		"range": maxf(VIEW_WIDTH, RING_LENGTH * 0.5),
		"lane_range": STANDARD_SNIPER_PROJECTILE_WIDTH_M * 0.5,
	}
	var impact := _first_projectile_impact_gpu(unit, event)
	if not impact.is_empty():
		return impact
	var best = null
	var best_distance := 1.0e20
	for target in _enemy_units(int(unit.owner_id)):
		if not _is_live_unit(target):
			continue
		if _map_line_occluded(unit, target, event):
			continue
		var delta := _mobius_delta_points(muzzle.x, muzzle.y, target.ring_pos, target.lane)
		var projection := delta.dot(direction)
		if projection < 0.0 or projection > float(event["range"]):
			continue
		var lateral := absf(delta.cross(direction))
		var radius := maxf(0.08, float(target.stats.get("radius", 0.2)) * _projectile_target_hitbox_scale(target, event))
		if lateral > radius + float(event["lane_range"]):
			continue
		if projection < best_distance:
			best_distance = projection
			best = target
	if _is_live_unit(best):
		var position := Vector2(wrapf(muzzle.x + direction.x * best_distance, 0.0, RING_LENGTH), clampf(muzzle.y + direction.y * best_distance, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT))
		return {
			"target": best,
			"position": position,
			"distance": best_distance,
			"hit": {
				"part_kind": "core",
				"part_index": -1,
				"part_name": "CORE",
				"position": position,
				"contact_normal": direction,
			},
		}
	return {}


func _gpu_collider_sets_contact(colliders_a: Array, colliders_b: Array, delta: float) -> bool:
	return not _gpu_collider_set_responses(colliders_a, colliders_b, delta).is_empty()


func _gpu_collider_set_responses(colliders_a: Array, colliders_b: Array, delta: float) -> Array:
	if colliders_a.is_empty() or colliders_b.is_empty() or not _gpu_collision_available():
		return []
	var gpu_colliders: Array = []
	var entries: Array = []
	_append_gpu_collision_unit_colliders(null, colliders_a, 0.0, 1, entries, gpu_colliders)
	_append_gpu_collision_unit_colliders(null, colliders_b, 0.0, 2, entries, gpu_colliders)
	if gpu_colliders.size() < 2:
		return []
	var responses := gpu_collision_pipeline.compute_contact_responses(gpu_colliders, 0.0, delta)
	responses.sort_custom(func(a, b): return float(Dictionary(a).get("penetration", 0.0)) > float(Dictionary(b).get("penetration", 0.0)))
	return responses


func _resolve_runtime_melee_attack(attacker, event: Dictionary) -> void:
	if _unit_uses_direct_runtime_topology(attacker):
		_mark_unit_attack_executed(attacker)
		return
	var killed_units: Array = []
	for target in _enemy_units(int(attacker.owner_id)):
		if not _is_live_unit(target):
			continue
		var hit: Dictionary = _attack_part_hit(attacker, target, event)
		if hit.is_empty():
			continue
		var attacker_collider: Dictionary = hit.get("attacker_collider", {})
		var target_collider: Dictionary = hit.get("target_collider", {})
		if attacker_collider.is_empty() or target_collider.is_empty():
			continue
		var normal: Vector2 = hit.get("contact_normal", Vector2.ZERO)
		if normal.length() <= 0.001:
			normal = _collider_center(target_collider) - _collider_center(attacker_collider)
		if normal.length() <= 0.001:
			normal = _event_direction_vector(attacker, target, event)
		if normal.length() <= 0.001:
			normal = Vector2(float(attacker.facing), 0.0)
		normal = normal.normalized()
		var velocity_a := _contact_collider_velocity(attacker, attacker_collider)
		var velocity_b := _contact_collider_velocity(target, target_collider)
		var closing_speed := maxf(0.0, (velocity_a - velocity_b).dot(normal))
		if bool(event.get("runtime_binding", false)):
			var runtime_speed := maxf(0.0, float(event.get("runtime_contact_speed", event.get("joint_actuation_speed", 0.0))))
			if runtime_speed <= 0.001:
				runtime_speed = _collider_extent_radius(attacker_collider) * PI * 8.0 / maxf(0.001, float(event.get("runtime_action_duration", 0.62)))
			closing_speed = maxf(closing_speed, runtime_speed)
		var hit_position: Vector2 = hit.get("position", _collider_hit_position(attacker_collider, target_collider))
		if closing_speed < PASSIVE_CONTACT_MIN_SPEED:
			_spawn_hit_effect(target, 1, _runtime_contact_damage_type(attacker_collider), true, "low_momentum", hit_position)
			continue
		var contact_momentum := closing_speed * (maxf(1.0, _unit_effective_mass(attacker)) + maxf(1.0, _unit_effective_mass(target)))
		if contact_momentum <= 0.001:
			continue
		_force_runtime_collision_recovery(attacker, attacker_collider)
		var target_hp_before := float(target.health)
		_mark_active_melee_contact_suppression(attacker, attacker_collider, target, target_collider)
		_apply_runtime_contact_damage(attacker, attacker_collider, target, target_collider, normal, contact_momentum, hit_position, "active_melee")
		var response_momentum := minf(contact_momentum, minf(_runtime_contact_path_stiffness(attacker, attacker_collider), _runtime_contact_path_stiffness(target, target_collider)))
		if _is_live_unit(attacker) and _is_live_unit(target):
			_apply_runtime_contact_velocity_response(attacker, target, normal, response_momentum)
		if _is_live_unit(target) and float(target.health) < target_hp_before:
			_apply_module_hit_effect(attacker, target, event)
			_apply_module_variant_hit_effect(attacker, target, event)
		if not _is_live_unit(target):
			killed_units.append(target)
	for killed_unit in killed_units:
		_handle_unit_killed(killed_unit, int(attacker.owner_id))


func _resolve_attack(attacker, event: Dictionary) -> void:
	if not _is_live_unit(attacker) or event.is_empty():
		return
	event = _normalize_runtime_attack_event(attacker, event)

	if not bool(event.get("projectile", false)) and _unit_uses_direct_runtime_topology(attacker):
		_mark_unit_attack_executed(attacker)
		return

	if bool(event.get("projectile", false)) and _event_is_explicit_gun_activation(event) and not _projectile_event_has_gun_source(event):
		_play_module_fail_sfx()
		_show_battle_message("投射物必须由枪械末端肌肉发射" if _ui_is_zh() else "Projectile requires a gun terminal muscle", 0.62)
		return
	if _is_missile_projectile_event(event):
		var missile_target = event.get("locked_target", null)
		if not _is_live_unit(missile_target) or _map_line_occluded(attacker, missile_target, event):
			missile_target = _acquire_missile_lock_target(attacker, event)
		if not _is_live_unit(missile_target):
			_show_battle_message("%s MISSILE: no lock" % String(attacker.unit_name), 0.52)
			return
		event["locked_target"] = missile_target
		event["aim_locked"] = true
	if bool(event.get("projectile", false)) and not _event_is_explicit_gun_activation(event):
		_clear_projectile_fields_for_runtime_melee(event)
		if _unit_uses_direct_runtime_topology(attacker):
			_mark_unit_attack_executed(attacker)
			return

	if bool(event.get("projectile", false)) and attacker.has_method("set_aim_pose"):
		var shot_direction := _unit_forward_vector(attacker)
		if event.has("direction") and event["direction"] is Vector2:
			shot_direction = event["direction"]
		if shot_direction.length() > 0.01:
			attacker.set_aim_pose(_projectile_source_node_for_event(event), shot_direction.normalized(), 0.24)

	if bool(event.get("projectile", false)):
		attacker.set_meta("projectile_signal", 0.28)
		if not bool(event.get("ammo_consumed", false)) and not _consume_ammo_for_event(attacker, event):
			return
		event["ammo_consumed"] = true
	_mark_unit_attack_executed(attacker)
	var attacker_blind := _unit_blind_strength(attacker)
	if event.has("direction") and attacker_blind > 0.01 and not bool(event.get("aim_locked", false)):
		var original_direction: Vector2 = event["direction"]
		event["direction"] = original_direction.rotated(randf_range(-0.72, 0.72) * attacker_blind).normalized()
	if bool(event.get("projectile", false)) and _projectile_behavior_for_data(event) == "bullet_hell":
		event["projectile_behavior"] = "bullet_hell"
		if String(event.get("projectile_style", "bullet")) in ["", "bullet"]:
			event["projectile_style"] = "bullet_hell"
		event["projectile_speed_mult"] = float(event.get("projectile_speed_mult", BULLET_HELL_DEFAULT_SPEED_MULT))
	if bool(event.get("projectile", false)) and _projectile_behavior_for_data(event) == "explosive":
		event["projectile_behavior"] = "explosive"
		if String(event.get("projectile_style", "")) in ["", "bullet"]:
			event["projectile_style"] = "explosive"
		event["projectile_speed_mult"] = clampf(float(event.get("projectile_speed_mult", 1.6)), 0.45, 2.4)
		event["explosion_radius"] = maxf(float(event.get("explosion_radius", 0.0)), STANDARD_MISSILE_EXPLOSION_RADIUS if String(event.get("projectile_style", "")) == "missile" else 0.58)
		event.erase("explosion_damage")
		event.erase("explosion_damage_type")
		if String(event.get("explosion_style", "")) == "":
			event["explosion_style"] = String(event.get("projectile_style", "explosive"))
	if _is_laser_telegraph_event(event):
		_queue_laser_telegraph(attacker, event)
		return
	if _is_true_bullet_event(event):
		_queue_true_bullet_lock(attacker, event)
		return
	if _is_chemical_projectile_event(event):
		_prepare_chemical_projectile_event(event)
		if not bool(event.get("chemical_projectile_ready", false)):
			_queue_chemical_projectile(attacker, event)
			return
		if _chemical_firework_event(event) and not bool(event.get("chemical_firework_expanded", false)):
			_resolve_chemical_firework(attacker, event)
			return
	if _is_missile_projectile_event(event):
		_queue_missile_projectile(attacker, event)
		return
	var first_projectile_impact := {}
	if bool(event.get("projectile", false)):
		_apply_weapon_recoil_from_momentum(attacker, event)
		_apply_projectile_reflection(attacker, event)
		if _projectile_consumes_on_first_hit(event):
			first_projectile_impact = _first_projectile_impact(attacker, event)
			if not first_projectile_impact.is_empty():
				event["projectile_impact_position"] = first_projectile_impact.get("position", Vector2(attacker.ring_pos, attacker.lane))
				var impact_target = first_projectile_impact.get("target", null)
				if impact_target != null and is_instance_valid(impact_target):
					event["projectile_impact_target_id"] = int(impact_target.get_instance_id())
	if bool(event.get("projectile", false)) and not bool(event.get("projectile_trace_spawned", false)):
		_spawn_projectile_trace(attacker, event)

	var killed_units: Array = []
	for target in _enemy_units(int(attacker.owner_id)):
		if not _is_live_unit(target):
			continue
		if not first_projectile_impact.is_empty() and target != first_projectile_impact.get("target", null):
			continue
		if _is_true_bullet_fired_event(event) and not (_unit_uses_direct_runtime_topology(attacker) and not first_projectile_impact.is_empty()):
			var locked_target = event.get("locked_target", null)
			if _is_live_unit(locked_target):
				if target == locked_target and _true_bullet_target_blocked(attacker, locked_target, event):
					continue
				if target != locked_target and not _true_bullet_unit_before_locked_target(attacker, target, locked_target, event):
					continue
		var hit: Dictionary = Dictionary(first_projectile_impact.get("hit", {})) if (_unit_uses_direct_runtime_topology(attacker) and bool(event.get("projectile", false)) and not first_projectile_impact.is_empty()) else _attack_part_hit(attacker, target, event)
		if hit.is_empty():
			continue
		event["target_part_index"] = int(hit.get("part_index", -1))
		event["target_part_kind"] = String(hit.get("part_kind", "core"))
		event["target_part_name"] = String(hit.get("part_name", "CORE"))
		event["target_torso_unit_index"] = int(hit.get("torso_unit_index", -1))
		event["target_terminal_weapon_kind"] = String(hit.get("target_terminal_weapon_kind", ""))
		event["attacker_part_kind"] = String(hit.get("attacker_part_kind", event.get("attacker_part_kind", "")))
		event["attacker_terminal_weapon_kind"] = String(hit.get("attacker_terminal_weapon_kind", event.get("attacker_terminal_weapon_kind", "")))
		event["attacker_runtime_topology"] = bool(hit.get("attacker_runtime_topology", event.get("attacker_runtime_topology", false)))
		event["hit_position_combat"] = hit.get("position", Vector2(target.ring_pos, target.lane))

		var damage_type := String(event.get("damage_type", "blunt"))
		if bool(event.get("projectile", false)) and _one_way_shield_intercept(attacker, target, event):
			continue
		if bool(event.get("projectile", false)) and _target_projectile_shield_reflects(target, event):
			_reflect_projectile_from_target_shield(target, attacker, event)
			continue
		var material_class := String(event.get("material_class", "weapon"))
		var counter_tier := _counter_tier_for_hit(target, damage_type)
		var nullified := false
		var multiplier: float = _rps_multiplier(String(event.get("state", "normal")), target.current_state)
		multiplier *= _vulnerability_multiplier(target, event)
		multiplier *= _outgoing_damage_multiplier(attacker, event)
		var non_damage := bool(event.get("non_damage", false))
		var raw_damage := float(event.get("damage", 0.0))
		if not bool(event.get("projectile", false)):
			raw_damage = _momentum_damage_for_event(attacker, event)
			if raw_damage <= 0.001:
				continue
		else:
			raw_damage = _projectile_raw_damage_for_event(attacker, target, event)
		var impact_direction := _event_direction_vector(attacker, target, event)
		if _maybe_detach_barrier_tile_from_momentum(attacker, target, event, impact_direction, _event_momentum_magnitude(event, maxf(0.0, float(event.get("momentum", 0.0))))):
			continue
		var damage: int = 0 if non_damage else max(1, int(roundf(raw_damage * multiplier)))
		damage = _melee_damage_adjusted(event, damage)
		var projectile_style := String(event.get("projectile_style", ""))
		var contact_gate_blocked := false
		if not non_damage and not nullified:
			damage = _projectile_material_adjusted_damage(target, event, damage)
			contact_gate_blocked = bool(event.get("contact_gate_blocked", false))
		if not non_damage and not nullified and not contact_gate_blocked:
			damage = _apply_combo_hit_scaling(attacker, target, event, damage)
			if damage < 0:
				continue
		var chemical_dot_total := 0
		if not non_damage and not nullified and not contact_gate_blocked and _chemical_dot_applies(event):
			chemical_dot_total = maxi(1, int(roundf(float(damage) * float(event.get("chemical_dot_mult", CHEMICAL_DOT_DEFAULT_MULT)))))
			damage = maxi(1, int(roundf(float(damage) * clampf(float(event.get("chemical_frontload", CHEMICAL_DOT_DEFAULT_FRONTLOAD)), 0.18, 0.82))))
		var effect_style := "threshold" if contact_gate_blocked else projectile_style
		var hit_vfx_position := Vector2(event.get("hit_position_combat", Vector2(target.ring_pos, target.lane)))
		if bool(event.get("projectile", false)):
			_spawn_projectile_hit_vfx_on_target({
				"target": target,
				"counter_tier": counter_tier,
				"damage_type": damage_type,
				"nullified": nullified or contact_gate_blocked,
				"projectile_style": effect_style,
				"contact_point": hit_vfx_position,
			})
		else:
			_spawn_hit_effect(target, counter_tier, damage_type, nullified or contact_gate_blocked, effect_style, hit_vfx_position)
		if contact_gate_blocked:
			if bool(event.get("projectile", false)):
				_apply_projectile_momentum_stagger(attacker, target, event)
			else:
				_apply_active_melee_momentum_stagger(attacker, target, event)
			_apply_hitstop(damage_type, counter_tier, 0)
			continue
		_apply_module_hit_effect(attacker, target, event)
		_apply_module_variant_hit_effect(attacker, target, event)
		_apply_takeover_status(attacker, target, event)
		if not nullified and float(event.get("explosion_radius", 0.0)) > 0.0:
			for blasted in _apply_explosion_damage(attacker, target, event):
				if not killed_units.has(blasted):
					killed_units.append(blasted)
		if non_damage:
			continue
		if bool(attacker.stats.get("suicide_on_hit", false)):
			_detonate_suicide_puppet(attacker, target)
			return
		if not nullified:
			_register_part_damage(target, event, damage, counter_tier)
		_apply_hitstop(damage_type, counter_tier, damage)
		var unit_damage := _unit_damage_after_part_absorption(event, damage)
		var killed: bool = target.take_hit(unit_damage, String(event.get("state", "normal")), int(attacker.owner_id), damage_type, material_class)
		if not killed and chemical_dot_total > 0:
			_apply_chemical_dot_status(attacker, target, event, chemical_dot_total)
		if not killed and not nullified and _is_back_hit(attacker, target, event):
			_apply_back_hit_heat(attacker, target, event, damage)
		if not killed:
			if bool(event.get("projectile", false)):
				_apply_projectile_momentum_stagger(attacker, target, event)
			else:
				_apply_active_melee_momentum_stagger(attacker, target, event)
		_apply_hit_displacement(attacker, target, event, damage, nullified)
		if killed:
			killed_units.append(target)

	for killed_unit in killed_units:
		_handle_unit_killed(killed_unit, int(attacker.owner_id))


func _attack_part_hit(attacker, target, event: Dictionary) -> Dictionary:
	var attack_collider: Dictionary = _attack_collider_for_event(attacker, event)
	if attack_collider.is_empty():
		return {}
	if _unit_uses_direct_runtime_topology(attacker):
		if bool(event.get("projectile", false)) and _event_is_explicit_gun_activation(event):
			var gpu_impact := _first_projectile_impact_gpu(attacker, event)
			if gpu_impact.is_empty() or gpu_impact.get("target", null) != target:
				return {}
			return Dictionary(gpu_impact.get("hit", {}))
		return {}
	var origin_x: float = _collider_center(attack_collider).x
	var target_colliders: Array = _unit_part_colliders(target)
	var best_hit: Dictionary = {}
	var best_gap := 999999.0
	var is_projectile := bool(event.get("projectile", false)) and _event_is_explicit_gun_activation(event)
	if is_projectile:
		var occlusion := _map_occlusion_query_between(attacker, target, event)
		if not occlusion.is_empty():
			event["map_occlusion_kind"] = String(occlusion.get("kind", MAP_OCCLUSION_NONE))
			event["map_occlusion_blocker"] = String(occlusion.get("blocker_name", ""))
			return {}
	var direct_runtime_hit := _unit_uses_direct_runtime_topology(attacker) or _unit_uses_direct_runtime_topology(target)
	var hit_slop := 0.0 if is_projectile else 0.16
	if direct_runtime_hit:
		hit_slop = 0.0 if is_projectile else -RUNTIME_CONTACT_REQUIRED_OVERLAP
	if is_projectile:
		var projectile_style := String(event.get("projectile_style", ""))
		var projectile_damage_type := String(event.get("projectile_damage_type", event.get("damage_type", "")))
		if direct_runtime_hit:
			hit_slop = 0.0
		else:
			hit_slop = maxf(hit_slop, float(event.get("lane_range", 0.0)) * (0.22 if projectile_damage_type == "chemical" or projectile_style == "spray" else 0.08))
	for raw_collider in target_colliders:
		if not (raw_collider is Dictionary):
			continue
		var target_collider: Dictionary = _shift_collider_to_origin(raw_collider, origin_x, _collider_center(attack_collider).y)
		if is_projectile:
			target_collider = _target_collider_for_projectile_query(target, target_collider, event)
		if is_projectile and event.has("direction") and event["direction"] is Vector2:
			var attack_direction: Vector2 = event["direction"]
			if attack_direction.length() > 0.01:
				var projectile_origin: Vector2 = attack_collider.get("a", _collider_center(attack_collider)) if String(attack_collider.get("shape", "circle")) == "capsule" else _collider_center(attack_collider)
				var to_part: Vector2 = _collider_center(target_collider) - projectile_origin
				if to_part.length() > 0.001 and attack_direction.normalized().dot(to_part.normalized()) < 0.02:
					continue
		var gap: float = _collider_gap(attack_collider, target_collider)
		if gap <= hit_slop and gap < best_gap:
			best_gap = gap
			var attack_center := _collider_center(attack_collider)
			var target_center := _collider_center(target_collider)
			var contact_normal := target_center - attack_center
			if contact_normal.length() <= 0.001:
				contact_normal = _event_direction_vector(attacker, target, event)
			if contact_normal.length() <= 0.001:
				contact_normal = Vector2(float(attacker.facing), 0.0)
			contact_normal = contact_normal.normalized()
			best_hit = {
				"part_index": int(target_collider.get("part_index", -1)),
				"part_kind": String(target_collider.get("part_kind", "core")),
				"part_name": String(target_collider.get("name", "CORE")),
				"torso_unit_index": int(target_collider.get("torso_unit_index", -1)),
				"target_terminal_weapon_kind": String(target_collider.get("terminal_weapon_kind", "")),
				"attacker_part_kind": String(attack_collider.get("part_kind", "")),
				"attacker_terminal_weapon_kind": String(attack_collider.get("terminal_weapon_kind", "")),
				"attacker_runtime_topology": bool(attack_collider.get("runtime_topology", false)),
				"position": _collider_hit_position(attack_collider, target_collider),
				"gap": gap,
				"attacker_collider": attack_collider.duplicate(true),
				"target_collider": target_collider.duplicate(true),
				"contact_normal": contact_normal,
			}
	return best_hit


func _attack_collider_for_event(attacker, event: Dictionary) -> Dictionary:
	if bool(event.get("projectile", false)) and not _event_is_explicit_gun_activation(event):
		_clear_projectile_fields_for_runtime_melee(event)
	if bool(event.get("projectile", false)) and _event_is_explicit_gun_activation(event) and not _projectile_event_has_gun_source(event):
		return {}
	if _unit_uses_direct_runtime_topology(attacker) and not bool(event.get("projectile", false)):
		return {}
	if attacker != null and is_instance_valid(attacker) and attacker.has_method("attack_collider_for_event"):
		var collider: Dictionary = attacker.attack_collider_for_event(event)
		if not collider.is_empty():
			return collider
	if _unit_uses_direct_runtime_topology(attacker):
		return {}
	var direction := Vector2(float(attacker.facing), 0.0)
	if event.has("direction") and event["direction"] is Vector2:
		direction = event["direction"]
	if direction.length() <= 0.01:
		direction = Vector2(float(attacker.facing), 0.0)
	direction = direction.normalized()
	var attack_start := _combat_patch_origin_for_unit(attacker)
	var ray := GameplayTransform.projectile_ray(attack_start, direction, maxf(0.04, float(event.get("range", 0.35))))
	return {
		"shape": "capsule",
		"part_kind": "fallback_attack",
		"part_index": int(event.get("muscle_node", 0)),
		"name": String(event.get("group_name", "ATTACK")),
		"a": ray.get("start", attack_start),
		"b": ray.get("end", attack_start + direction * maxf(0.04, float(event.get("range", 0.35)))),
		"radius": maxf(0.02, float(event.get("lane_range", 0.2)) * 0.35),
	}


func _unit_part_colliders(unit) -> Array:
	if unit != null and is_instance_valid(unit) and unit.has_method("part_colliders"):
		var part_list: Array = unit.part_colliders()
		if not part_list.is_empty():
			return part_list
	if _unit_uses_direct_runtime_topology(unit):
		return []
	var radius := maxf(0.04, float(unit.stats.get("radius", 0.28)))
	return [{
		"shape": "circle",
		"part_kind": "core",
		"part_index": -1,
		"name": "CORE",
		"center": _unit_combat_coord(unit),
		"radius": radius,
	}]


func _visual_hitbox_scale_for_unit(unit) -> float:
	if unit == null or not is_instance_valid(unit):
		return 1.0
	if unit.get("visual_hitbox_scale") != null:
		return clampf(float(unit.get("visual_hitbox_scale")), VISUAL_HITBOX_SCALE_MIN, VISUAL_HITBOX_SCALE_MAX)
	return GameplayTransform.hitbox_scale_for_visual_scale(float(unit.get("mobius_visual_scale")) if unit.get("mobius_visual_scale") != null else 1.0, VISUAL_HITBOX_SCALE_STRENGTH, VISUAL_HITBOX_SCALE_MIN, VISUAL_HITBOX_SCALE_MAX)


func _projectile_target_hitbox_scale(unit, event: Dictionary) -> float:
	if not bool(event.get("projectile", false)):
		return 1.0
	return _visual_hitbox_scale_for_unit(unit)


func _scale_collider_around_center(collider: Dictionary, scale_value: float) -> Dictionary:
	var scale := maxf(0.001, scale_value)
	if absf(scale - 1.0) <= 0.001:
		return collider
	var scaled := collider.duplicate(true)
	var center := _collider_center(collider)
	scaled["visual_hitbox_scale"] = scale
	if scaled.has("radius"):
		scaled["radius"] = maxf(0.0, float(scaled.get("radius", 0.0)) * scale)
	if scaled.has("center") and scaled["center"] is Vector2:
		var center_value: Vector2 = scaled["center"]
		scaled["center"] = center + (center_value - center) * scale
	if scaled.has("a") and scaled["a"] is Vector2:
		var a_value: Vector2 = scaled["a"]
		scaled["a"] = center + (a_value - center) * scale
	if scaled.has("b") and scaled["b"] is Vector2:
		var b_value: Vector2 = scaled["b"]
		scaled["b"] = center + (b_value - center) * scale
	if scaled.has("pivot") and scaled["pivot"] is Vector2:
		var pivot_value: Vector2 = scaled["pivot"]
		scaled["pivot"] = center + (pivot_value - center) * scale
	if scaled.has("local_joint_center") and scaled["local_joint_center"] is Vector2:
		var joint_value: Vector2 = scaled["local_joint_center"]
		scaled["local_joint_center"] = center + (joint_value - center) * scale
	if scaled.has("polygon"):
		var scaled_polygon: Array = []
		for raw_point in Array(scaled.get("polygon", [])):
			if raw_point is Vector2:
				var point: Vector2 = raw_point
				scaled_polygon.append(center + (point - center) * scale)
		if scaled_polygon.size() >= 3:
			scaled["polygon"] = scaled_polygon
	return scaled


func _target_collider_for_projectile_query(unit, collider: Dictionary, event: Dictionary) -> Dictionary:
	return _scale_collider_around_center(collider, _projectile_target_hitbox_scale(unit, event))


func _shift_collider_to_origin(collider: Dictionary, origin_x: float, origin_lane: float = 1.0e20) -> Dictionary:
	var shifted := collider.duplicate(true)
	var center: Vector2 = _collider_center(collider)
	var shifted_center := Vector2(origin_x + _ring_delta(origin_x, center.x), center.y)
	if mobius_enabled and absf(origin_lane) < 1.0e10:
		var delta := _mobius_delta_points(origin_x, origin_lane, center.x, center.y)
		shifted_center = Vector2(origin_x, origin_lane) + delta
	var offset := shifted_center - center
	if shifted.has("center") and shifted["center"] is Vector2:
		var center_value: Vector2 = shifted["center"]
		center_value += offset
		shifted["center"] = center_value
	if shifted.has("a") and shifted["a"] is Vector2:
		var a_value: Vector2 = shifted["a"]
		a_value += offset
		shifted["a"] = a_value
	if shifted.has("b") and shifted["b"] is Vector2:
		var b_value: Vector2 = shifted["b"]
		b_value += offset
		shifted["b"] = b_value
	if shifted.has("pivot") and shifted["pivot"] is Vector2:
		var pivot_value: Vector2 = shifted["pivot"]
		pivot_value += offset
		shifted["pivot"] = pivot_value
	if shifted.has("local_joint_center") and shifted["local_joint_center"] is Vector2:
		var joint_value: Vector2 = shifted["local_joint_center"]
		joint_value += offset
		shifted["local_joint_center"] = joint_value
	if shifted.has("polygon"):
		var shifted_polygon: Array = []
		for raw_point in Array(shifted.get("polygon", [])):
			if raw_point is Vector2:
				var point: Vector2 = raw_point
				point += offset
				shifted_polygon.append(point)
		if shifted_polygon.size() >= 3:
			shifted["polygon"] = shifted_polygon
	return shifted


func _collider_center(collider: Dictionary) -> Vector2:
	if String(collider.get("shape", "circle")) == "polygon":
		var polygon := Array(collider.get("polygon", []))
		if polygon.is_empty():
			return Vector2.ZERO
		var sum := Vector2.ZERO
		var count := 0
		for raw_point in polygon:
			if raw_point is Vector2:
				sum += raw_point
				count += 1
		return sum / maxf(1.0, float(count))
	if String(collider.get("shape", "circle")) == "capsule":
		var a: Vector2 = collider.get("a", Vector2.ZERO)
		var b: Vector2 = collider.get("b", a)
		return (a + b) * 0.5
	return collider.get("center", Vector2.ZERO)


func _collider_extent_radius(collider: Dictionary) -> float:
	var center := _collider_center(collider)
	var result := 0.0
	if String(collider.get("shape", "circle")) == "polygon":
		for raw_point in Array(collider.get("polygon", [])):
			if raw_point is Vector2:
				result = maxf(result, center.distance_to(Vector2(raw_point)))
	elif String(collider.get("shape", "circle")) == "capsule":
		result = maxf(center.distance_to(Vector2(collider.get("a", center))), center.distance_to(Vector2(collider.get("b", center)))) + maxf(0.0, float(collider.get("radius", 0.0)))
	else:
		result = maxf(0.0, float(collider.get("radius", 0.0)))
	return maxf(result, 0.001)


func _collider_gap(a: Dictionary, b: Dictionary) -> float:
	var a_radius: float = float(a.get("radius", 0.0))
	var b_radius: float = float(b.get("radius", 0.0))
	var a_shape := String(a.get("shape", "circle"))
	var b_shape := String(b.get("shape", "circle"))
	var distance := 0.0
	if a_shape == "polygon" or b_shape == "polygon":
		distance = _polygon_collider_distance(a, b)
		if distance <= 0.0:
			return -_collider_overlap_depth_estimate(a, b)
	elif a_shape == "capsule" and b_shape == "capsule":
		var a0: Vector2 = a.get("a", Vector2.ZERO)
		var a1: Vector2 = a.get("b", Vector2.ZERO)
		var b0: Vector2 = b.get("a", Vector2.ZERO)
		var b1: Vector2 = b.get("b", Vector2.ZERO)
		distance = _segment_segment_distance(a0, a1, b0, b1)
	elif a_shape == "capsule":
		var point_b: Vector2 = b.get("center", Vector2.ZERO)
		var capsule_a0: Vector2 = a.get("a", Vector2.ZERO)
		var capsule_a1: Vector2 = a.get("b", Vector2.ZERO)
		distance = _point_segment_distance(point_b, capsule_a0, capsule_a1)
	elif b_shape == "capsule":
		var point_a: Vector2 = a.get("center", Vector2.ZERO)
		var capsule_b0: Vector2 = b.get("a", Vector2.ZERO)
		var capsule_b1: Vector2 = b.get("b", Vector2.ZERO)
		distance = _point_segment_distance(point_a, capsule_b0, capsule_b1)
	else:
		var center_a: Vector2 = a.get("center", Vector2.ZERO)
		var center_b: Vector2 = b.get("center", Vector2.ZERO)
		distance = center_a.distance_to(center_b)
	return distance - a_radius - b_radius


func _collider_bounding_radius(collider: Dictionary) -> float:
	if collider.has("bounding_radius"):
		return maxf(0.001, float(collider.get("bounding_radius", 0.0)))
	var center := _collider_center(collider)
	var shape := String(collider.get("shape", "circle"))
	if shape == "polygon":
		var radius := 0.0
		for raw_point in Array(collider.get("polygon", [])):
			if raw_point is Vector2:
				radius = maxf(radius, center.distance_to(Vector2(raw_point)))
		return radius
	if shape == "capsule":
		var a: Vector2 = collider.get("a", center)
		var b: Vector2 = collider.get("b", a)
		return maxf(center.distance_to(a), center.distance_to(b)) + maxf(0.0, float(collider.get("radius", 0.0)))
	return maxf(0.0, float(collider.get("radius", 0.0)))


func _collider_broadphase_gap(a: Dictionary, b: Dictionary) -> float:
	return _collider_center(a).distance_to(_collider_center(b)) - _collider_bounding_radius(a) - _collider_bounding_radius(b)


func _collider_overlap_depth_estimate(a: Dictionary, b: Dictionary) -> float:
	var center_distance := _collider_center(a).distance_to(_collider_center(b))
	var raw_depth := _collider_bounding_radius(a) + _collider_bounding_radius(b) - center_distance
	return clampf(raw_depth, 0.001, 0.12)


func _collider_hit_position(a: Dictionary, b: Dictionary) -> Vector2:
	return (_collider_center(a) + _collider_center(b)) * 0.5


func _collider_segments(collider: Dictionary) -> Array:
	var shape := String(collider.get("shape", "circle"))
	if shape == "polygon":
		var polygon := Array(collider.get("polygon", []))
		var segments: Array = []
		for i in range(polygon.size()):
			if not (polygon[i] is Vector2):
				continue
			var next_index := (i + 1) % polygon.size()
			if not (polygon[next_index] is Vector2):
				continue
			segments.append([polygon[i], polygon[next_index]])
		return segments
	if shape == "capsule":
		return [[collider.get("a", Vector2.ZERO), collider.get("b", Vector2.ZERO)]]
	return []


func _point_in_polygon(point: Vector2, polygon: Array) -> bool:
	var inside := false
	var count := polygon.size()
	if count < 3:
		return false
	var j := count - 1
	for i in range(count):
		if not (polygon[i] is Vector2) or not (polygon[j] is Vector2):
			j = i
			continue
		var pi: Vector2 = polygon[i]
		var pj: Vector2 = polygon[j]
		if ((pi.y > point.y) != (pj.y > point.y)) and (point.x < (pj.x - pi.x) * (point.y - pi.y) / maxf(0.000001, pj.y - pi.y) + pi.x):
			inside = not inside
		j = i
	return inside


func _polygon_collider_distance(a: Dictionary, b: Dictionary) -> float:
	var a_shape := String(a.get("shape", "circle"))
	var b_shape := String(b.get("shape", "circle"))
	var a_polygon := Array(a.get("polygon", []))
	var b_polygon := Array(b.get("polygon", []))
	if a_shape == "polygon" and b_shape == "polygon":
		for point in a_polygon:
			if point is Vector2 and _point_in_polygon(point, b_polygon):
				return 0.0
		for point in b_polygon:
			if point is Vector2 and _point_in_polygon(point, a_polygon):
				return 0.0
	elif a_shape == "polygon":
		var center_b: Vector2 = _collider_center(b)
		if _point_in_polygon(center_b, a_polygon):
			return 0.0
	elif b_shape == "polygon":
		var center_a: Vector2 = _collider_center(a)
		if _point_in_polygon(center_a, b_polygon):
			return 0.0
	var a_segments := _collider_segments(a)
	var b_segments := _collider_segments(b)
	for raw_a in a_segments:
		var seg_a: Array = raw_a
		for raw_b in b_segments:
			var seg_b: Array = raw_b
			if _segments_intersect(seg_a[0], seg_a[1], seg_b[0], seg_b[1]):
				return 0.0
	var best := 999999.0
	if a_shape == "polygon":
		for point in a_polygon:
			if not (point is Vector2):
				continue
			if b_shape == "capsule":
				best = minf(best, _point_segment_distance(point, b.get("a", Vector2.ZERO), b.get("b", Vector2.ZERO)))
			else:
				best = minf(best, point.distance_to(_collider_center(b)))
	if b_shape == "polygon":
		for point in b_polygon:
			if not (point is Vector2):
				continue
			if a_shape == "capsule":
				best = minf(best, _point_segment_distance(point, a.get("a", Vector2.ZERO), a.get("b", Vector2.ZERO)))
			else:
				best = minf(best, point.distance_to(_collider_center(a)))
	for raw_a in a_segments:
		var seg_a: Array = raw_a
		for raw_b in b_segments:
			var seg_b: Array = raw_b
			best = minf(best, _segment_segment_distance(seg_a[0], seg_a[1], seg_b[0], seg_b[1]))
	return best if best < 999998.0 else _collider_center(a).distance_to(_collider_center(b))


func _point_segment_distance(point: Vector2, a: Vector2, b: Vector2) -> float:
	var ab := b - a
	var denom := ab.length_squared()
	if denom <= 0.000001:
		return point.distance_to(a)
	var t := clampf((point - a).dot(ab) / denom, 0.0, 1.0)
	return point.distance_to(a + ab * t)


func _segment_segment_distance(a: Vector2, b: Vector2, c: Vector2, d: Vector2) -> float:
	if _segments_intersect(a, b, c, d):
		return 0.0
	return minf(
		minf(_point_segment_distance(a, c, d), _point_segment_distance(b, c, d)),
		minf(_point_segment_distance(c, a, b), _point_segment_distance(d, a, b))
	)


func _segments_intersect(a: Vector2, b: Vector2, c: Vector2, d: Vector2) -> bool:
	var r := b - a
	var s := d - c
	var denom := r.cross(s)
	var qmp := c - a
	if absf(denom) <= 0.000001:
		return _point_segment_distance(a, c, d) <= 0.0001 or _point_segment_distance(c, a, b) <= 0.0001
	var t := qmp.cross(s) / denom
	var u := qmp.cross(r) / denom
	return t >= 0.0 and t <= 1.0 and u >= 0.0 and u <= 1.0


func _is_back_hit(attacker, target, event: Dictionary) -> bool:
	if attacker == null or target == null or not is_instance_valid(attacker) or not is_instance_valid(target):
		return false
	if not _unit_role_is_mech(target):
		return false
	var direction := _event_direction_vector(attacker, target, event, Vector2.ZERO)
	if direction.length() <= 0.01:
		return false
	var x_axis := direction.normalized().x
	if absf(x_axis) < BACK_HIT_ANGLE_THRESHOLD:
		var attacker_side := _mobius_delta_vec_between(target, attacker).x
		if absf(attacker_side) <= 0.01:
			return false
		x_axis = -signf(attacker_side)
	return x_axis * float(target.facing) > BACK_HIT_ANGLE_THRESHOLD


func _apply_back_hit_heat(attacker, target, event: Dictionary, damage: int) -> void:
	if not _unit_uses_heat(target):
		return
	var bonus := maxf(BACK_HIT_HEAT_MIN, float(damage) * BACK_HIT_HEAT_DAMAGE_RATIO)
	bonus += float(attacker.stats.get("back_hit_heat_bonus", 0.0))
	bonus += float(event.get("back_hit_heat_bonus", 0.0))
	bonus *= maxf(0.1, float(attacker.stats.get("back_hit_heat_mult", 1.0)))
	bonus *= maxf(0.1, float(event.get("back_hit_heat_mult", 1.0)))
	if bonus <= 0.0:
		return
	_add_unit_heat(target, bonus)
	target.set_meta("rear_heat_flash_timer", 0.34)
	if target.overheated:
		target.velocity *= 0.42
		target.action_cooldown = maxf(float(target.action_cooldown), 0.28)
		_show_battle_message("BACK VENT SHOCK: %s overheated" % target.unit_name, 0.72)
	else:
		_show_battle_message("BACK HIT HEAT +%d" % int(roundf(bonus)), 0.42)
	_spawn_hit_effect(target, 2, "laser", false, "heat")


func _one_way_shield_intercept(attacker, target, event: Dictionary) -> bool:
	if attacker == null or target == null or not is_instance_valid(attacker) or not is_instance_valid(target):
		return false
	var occlusion := _map_occlusion_query_between(attacker, target, event)
	if String(occlusion.get("kind", MAP_OCCLUSION_NONE)) != MAP_OCCLUSION_ONE_WAY:
		return false
	var best = occlusion.get("blocker", null)
	if best == null:
		return false
	var damage_type := String(event.get("damage_type", "bullet"))
	var damage := maxi(1, int(roundf(float(event.get("damage", 1)) * float(best.stats.get("shield_block_damage_mult", 1.0)))))
	var style := String(event.get("projectile_style", "shield"))
	var shield_event := {"damage_type": damage_type, "projectile": true}
	damage = _projectile_material_adjusted_damage(best, shield_event, damage)
	var blocked := damage <= 0 or bool(shield_event.get("contact_gate_blocked", false))
	_spawn_hit_effect(best, _counter_tier_for_hit(best, damage_type), damage_type, blocked, style)
	_update_field_aura_visual(best, "one_way_shield", maxf(0.2, float(best.stats.get("shield_radius", 0.74))), 2.5, 0.0)
	best.set_meta("shield_flash_timer", 0.22)
	if blocked:
		_show_battle_message("%s 未破阈值：%s" % [best.unit_name, damage_type.to_upper()] if _ui_is_zh() else "%s threshold held: %s" % [best.unit_name, damage_type.to_upper()], 0.42)
		return true
	_apply_hitstop(damage_type, 1, damage)
	if best.take_hit(damage, "armor", int(attacker.owner_id), damage_type, "projectile"):
		_handle_unit_killed(best, int(attacker.owner_id))
	else:
		_show_battle_message("%s intercepted %s" % [best.unit_name, damage_type.to_upper()], 0.42)
	return true


func _one_way_shield_allows_projectile(shield, attacker, attack_direction: Vector2) -> bool:
	var mode := String(shield.stats.get("shield_pass_mode", "directional"))
	if mode in ["iff", "ally"]:
		return int(attacker.owner_id) == int(shield.owner_id)
	if mode == "enemy":
		return int(attacker.owner_id) != int(shield.owner_id)
	var dir_sign := signf(attack_direction.x)
	if dir_sign == 0.0:
		dir_sign = float(attacker.facing)
	var pass_facing := float(shield.facing)
	if String(shield.stats.get("shield_pass_direction", "facing")) == "reverse":
		pass_facing *= -1.0
	return dir_sign == pass_facing


func _cleanup_fracture_puppets_for_parent(parent) -> int:
	if parent == null or not is_instance_valid(parent):
		return 0
	var owner := int(parent.owner_id)
	if not active_units.has(owner):
		return 0
	var parent_id := str(parent.get_instance_id())
	var group: Array = active_units[owner]["puppet"]
	var kept: Array = []
	var removed := 0
	for child in group:
		if child != null and is_instance_valid(child) and _is_temporary_fracture_puppet(child) and String(child.get_meta("fracture_parent_id", "")) == parent_id:
			if _is_live_unit(child):
				child.retire()
			_detach_unit(child)
			child.queue_free()
			removed += 1
		elif child != parent:
			kept.append(child)
		else:
			kept.append(child)
	active_units[owner]["puppet"] = kept
	return removed


func _handle_unit_killed(unit, killer_id: int) -> void:
	if not is_instance_valid(unit):
		return

	var victim_id: int = int(unit.owner_id)
	var killed_role: String = String(unit.role)
	var killed_name: String = String(unit.unit_name)
	var temporary_fracture := _is_temporary_fracture_puppet(unit)
	if temporary_fracture:
		_detach_unit(unit)
		_show_battle_message("%s fracture puppet destroyed" % killed_name, 0.75)
		if not game_over and _live_units_for(victim_id) == 0 and battle_mode != MODE_TRAINING and [1, 2].has(killer_id):
			_end_battle(killer_id)
		unit.queue_free()
		return
	if _try_pirate_betrayal(unit, killer_id):
		return
	if _try_start_retreat(unit, killer_id):
		return
	if bool(unit.stats.get("is_repair_station", false)):
		_destroy_docked_units(unit)
	if bool(unit.get_meta("escape_pod", false)):
		_show_battle_message("逃生舱被击毁：携带的行动模块丢失" if _ui_is_zh() else "Escape pod shot down: carried action modules lost", 0.85)
	elif bool(unit.stats.get("has_escape_pod", false)):
		_launch_escape_pod(unit)
	_apply_destroy_economy(unit, killer_id)
	var cleaned_fragments := _cleanup_fracture_puppets_for_parent(unit)
	_detach_unit(unit)
	if cleaned_fragments > 0:
		_show_battle_message("%s 被摧毁：%d 个断裂临时傀儡同步崩溃" % [killed_name, cleaned_fragments] if _ui_is_zh() else "%s destroyed: %d fracture puppets collapsed" % [killed_name, cleaned_fragments], 0.95)
	if battle_mode == MODE_TRAINING and victim_id == 2 and unit.role == "hero":
		training_respawn_timer = 1.1
		_show_battle_message("靶机被摧毁，正在重生。" if _ui_is_zh() else "Dummy destroyed. Respawning.", 1.0)
	elif killed_role == "hero":
		victory_points[killer_id] = int(victory_points[killer_id]) + 1
		runtime_resource[victim_id] = float(runtime_resource[victim_id]) + HERO_KILL_REWARD
		_show_battle_message("P%d 英雄击破。P%d +1 胜利点，P%d +100 资源" % [victim_id, killer_id, victim_id] if _ui_is_zh() else "P%d HERO DOWN. P%d +1 VP, P%d +100 RESOURCE" % [victim_id, killer_id, victim_id], 1.6)
		if int(victory_points[killer_id]) >= WIN_POINTS:
			_end_battle(killer_id)
	else:
		if not _is_live_unit(active_units[victim_id]["hero"]):
			victory_points[killer_id] = int(victory_points[killer_id]) + 1
			_show_battle_message("%s 被摧毁，且英雄不在场。P%d +1 胜利点" % [killed_name, killer_id] if _ui_is_zh() else "%s destroyed while hero absent. P%d +1 VP" % [killed_name, killer_id], 1.1)
			if int(victory_points[killer_id]) >= WIN_POINTS:
				_end_battle(killer_id)
		else:
			_show_battle_message("%s 被摧毁" % killed_name if _ui_is_zh() else "%s destroyed" % killed_name, 0.8)

	if not game_over and _live_units_for(victim_id) == 0 and battle_mode != MODE_TRAINING:
		_end_battle(killer_id)
	unit.queue_free()


func _apply_destroy_economy(unit, killer_id: int) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	var victim_id := int(unit.owner_id)
	var bounty := int(unit.stats.get("bounty_reward", 0))
	if bounty > 0 and [1, 2].has(killer_id) and killer_id != victim_id:
		runtime_resource[killer_id] = float(runtime_resource.get(killer_id, 0.0)) + float(bounty)
		_show_battle_message("CROWN BOUNTY: P%d +%d" % [killer_id, bounty], 0.72)
	var refund := int(unit.stats.get("insured_refund", 0))
	if refund > 0 and [1, 2].has(victim_id):
		runtime_resource[victim_id] = float(runtime_resource.get(victim_id, 0.0)) + float(refund)
		_show_battle_message("PARACHUTE CLAIM: P%d +%d" % [victim_id, refund], 0.72)
	var penalty := int(unit.stats.get("owner_destroy_penalty", 0))
	if penalty > 0 and [1, 2].has(victim_id):
		var paid := minf(float(runtime_resource.get(victim_id, 0.0)), float(penalty))
		runtime_resource[victim_id] = float(runtime_resource.get(victim_id, 0.0)) - paid
		_show_battle_message("ADVANCE CLAWBACK: P%d -%d" % [victim_id, int(paid)], 0.72)


func _launch_escape_pod(unit) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	var owner := int(unit.owner_id)
	var carried := clampi(int(unit.stats.get("escape_module_slots", 1)), 1, 6)
	var speed := maxf(0.22, float(unit.stats.get("escape_speed", 0.95)))
	var target_ring := wrapf(unit.ring_pos + float(unit.stats.get("escape_target_ring_delta", 2.8)) * float(unit.facing), 0.0, RING_LENGTH)
	var target_lane := clampf(float(unit.stats.get("escape_target_lane", unit.lane)), -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	var pod_stats := {
		"role": "puppet",
		"name": "Escape Pod",
		"health": 10 + carried * 5,
		"mass": 2.0 + float(carried),
		"power": 8.0 + speed * 6.0,
		"energy": 4.0,
		"length": 0.18,
		"radius": 0.045 + float(carried) * 0.012,
		"speed": speed,
		"acceleration": 4.4 + speed,
		"drag": 1.6,
		"heat_capacity": 24.0,
		"cooling": 6.0,
		"shape": "drone_core",
		"damage_type": "blunt",
		"material_class": "escape_pod",
		"resistances": {"bullet": 1.1, "chemical": 1.12, "laser": 1.08, "blunt": 1.16, "pierce": 1.08, "tear": 1.1},
		"counter_tiers": {"bullet": 0, "chemical": 0, "laser": 0, "blunt": 0, "pierce": 0, "tear": 0},
		"primary_color": unit.primary_color,
		"accent_color": Color(1.0, 0.88, 0.28, 1.0),
	}
	var pod = _create_unit(owner, "puppet", pod_stats, "P%d ESCAPE POD" % owner, unit.ring_pos, unit.lane)
	var pod_group: Array = active_units[owner]["puppet"]
	pod_group.append(pod)
	active_units[owner]["puppet"] = pod_group
	pod.set_meta("escape_pod", true)
	pod.set_meta("carried_modules", carried)
	pod.set_meta("escape_speed", speed)
	pod.set_meta("escape_target_ring", target_ring)
	pod.set_meta("escape_target_lane", target_lane)
	_show_battle_message("%s launches escape pod carrying %d modules" % [unit.unit_name, carried], 0.95)
	_play_sfx_wave("boost", 620.0, 0.22, -10.0)


func _try_pirate_betrayal(unit, killer_id: int) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	if String(unit.role) != "puppet":
		return false
	var chance := clampf(float(unit.stats.get("betrayal_chance", 0.0)), 0.0, 1.0)
	chance = clampf(chance / _data_security_value(unit), 0.0, 1.0)
	if chance <= 0.0 or randf() > chance:
		return false
	_defect_unit_to_owner(unit, killer_id, "BOOTLEG REBOOT", true)
	return true


func _try_start_retreat(unit, killer_id: int) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	if not bool(unit.stats.get("retreat_on_defeat", false)):
		return false
	if not _unit_role_is_mech(unit):
		return false
	if bool(unit.get_meta("retreating", false)):
		return false
	var owner := int(unit.owner_id)
	var dock = _nearest_repair_station(unit, owner)
	var base_rate := maxf(1.0, float(unit.stats.get("retreat_repair_rate", 5.0)))
	var dock_rate := 0.0
	if dock != null:
		dock_rate = float(dock.stats.get("repair_rate", 0.0)) * float(dock.stats.get("station_repair_mult", 1.0))
	var missing := maxf(1.0, float(unit.max_health))
	var repair_time := clampf(missing / maxf(1.0, base_rate + dock_rate) * float(unit.stats.get("repair_time_mult", 1.0)), 2.2, 22.0)
	_detach_unit(unit)
	unit.active = false
	unit.visible = false
	unit.health = 1
	unit.set_meta("retreating", true)
	retreating_units.append({
		"unit": unit,
		"owner": owner,
		"role": String(unit.role),
		"timer": repair_time,
		"dock": dock,
	})
	_show_battle_message("%s retreats for repair %.1fs" % [unit.unit_name, repair_time], 1.0)
	_play_sfx_wave("web", 300.0, 0.22, -11.0)
	return true


func _nearest_repair_station(unit, owner: int):
	var best = null
	var best_distance := 999.0
	for candidate in _friendly_units(owner):
		if candidate == unit or not _is_live_unit(candidate) or not bool(candidate.stats.get("is_repair_station", false)):
			continue
		var delta := _mobius_delta_vec_between(unit, candidate)
		var distance := absf(delta.x) + absf(delta.y) * 0.65
		if distance < best_distance:
			best_distance = distance
			best = candidate
	return best


func _update_retreat_repairs(delta: float) -> void:
	for entry in retreating_units.duplicate():
		var unit = entry.get("unit", null)
		if unit == null or not is_instance_valid(unit):
			retreating_units.erase(entry)
			continue
		var dock = entry.get("dock", null)
		if dock != null and not is_instance_valid(dock):
			unit.queue_free()
			retreating_units.erase(entry)
			continue
		entry["timer"] = maxf(0.0, float(entry.get("timer", 0.0)) - delta)
		if float(entry["timer"]) > 0.0:
			continue
		if _restore_retreating_unit(entry):
			retreating_units.erase(entry)
		else:
			entry["timer"] = 0.45


func _restore_retreating_unit(entry: Dictionary) -> bool:
	var unit = entry.get("unit", null)
	if unit == null or not is_instance_valid(unit):
		return true
	var owner := int(entry.get("owner", unit.owner_id))
	var role_key := String(entry.get("role", unit.role))
	if role_key == "hero" and _is_live_unit(active_units[owner]["hero"]):
		return false
	if role_key == "barrier" and _is_live_unit(active_units[owner]["barrier"]):
		return false
	var dock = entry.get("dock", null)
	var owner_center := _camera_center_for_player(owner)
	var spawn_ring := owner_center
	var spawn_lane := _camera_lane_for_player(owner)
	if dock != null and is_instance_valid(dock):
		spawn_ring = dock.ring_pos
		spawn_lane = dock.lane
	else:
		spawn_ring = wrapf(owner_center + (-3.0 if owner == 1 else 3.0), 0.0, RING_LENGTH)
	unit.owner_id = owner
	unit.role = role_key
	unit.health = unit.max_health
	unit.set_meta("retreating", false)
	unit.set_meta("limb_hp", {})
	unit.set_meta("severed_limbs", {})
	unit.set_meta("disabled_parts", {})
	unit.set_meta("vuln_timer", 0.0)
	unit.active = true
	unit.visible = true
	if not all_units.has(unit):
		all_units.append(unit)
	_assign_unit_role(unit, role_key)
	unit.deploy(spawn_ring, spawn_lane)
	_show_battle_message("%s repaired and redeployed" % unit.unit_name, 0.85)
	_spawn_hit_effect(unit, 1, "chemical", false, "shield")
	return true


func _destroy_docked_units(station) -> void:
	for entry in retreating_units.duplicate():
		var dock = entry.get("dock", null)
		if dock != station:
			continue
		var unit = entry.get("unit", null)
		if unit != null and is_instance_valid(unit):
			unit.queue_free()
		retreating_units.erase(entry)
	_show_battle_message("Repair dock destroyed with its occupants", 0.8)


func _detonate_suicide_puppet(attacker, primary_target) -> void:
	if attacker == null or not is_instance_valid(attacker):
		return
	var owner := int(attacker.owner_id)
	var radius := maxf(0.12, float(attacker.stats.get("blast_radius", 0.45)))
	for target in _enemy_units(owner):
		if not _is_live_unit(target) or not _unit_is_mech_physics_subject(target):
			continue
		var delta := _mobius_delta_vec_between(attacker, target)
		if absf(delta.x) <= radius + float(target.stats.get("radius", 0.2)) and absf(delta.y) <= radius * 0.72 + float(target.stats.get("radius", 0.2)):
			_apply_vulnerability(target, String(attacker.stats.get("vuln_kind", "all")), float(attacker.stats.get("vuln_mult", 2.0)), float(attacker.stats.get("vuln_duration", 4.0)))
			_spawn_hit_effect(target, 2, String(attacker.stats.get("damage_type", "chemical")), false, "missile")
	_detach_unit(attacker)
	attacker.queue_free()
	_apply_hitstop(String(attacker.stats.get("damage_type", "chemical")), 2, 18)
	_show_battle_message("%s detonated a vulnerability scar" % attacker.unit_name, 0.75)


func _apply_vulnerability(target, kind: String, mult: float, duration: float) -> void:
	if target == null or not is_instance_valid(target):
		return
	target.set_meta("vuln_kind", kind)
	target.set_meta("vuln_mult", maxf(1.0, mult))
	target.set_meta("vuln_timer", maxf(float(target.get_meta("vuln_timer", 0.0)), duration))


func _vulnerability_multiplier(target, event: Dictionary) -> float:
	if target == null or not is_instance_valid(target) or float(target.get_meta("vuln_timer", 0.0)) <= 0.0:
		return 1.0
	var kind := String(target.get_meta("vuln_kind", "all"))
	var damage_type := String(event.get("damage_type", "blunt"))
	var is_projectile := bool(event.get("projectile", false))
	if kind == "all" or kind == damage_type or (kind == "projectile" and is_projectile) or (kind == "melee" and not is_projectile):
		return maxf(1.0, float(target.get_meta("vuln_mult", 1.0)))
	return 1.0


func _outgoing_damage_multiplier(attacker, event: Dictionary) -> float:
	if attacker == null or not is_instance_valid(attacker):
		return 1.0
	if float(attacker.get_meta("field_damage_boost_timer", 0.0)) <= 0.0:
		return 1.0
	var boost_type := String(attacker.get_meta("field_damage_boost_type", ""))
	var damage_type := String(event.get("damage_type", ""))
	if boost_type == "" or boost_type == "all" or boost_type == damage_type:
		return maxf(1.0, float(attacker.get_meta("field_damage_boost_mult", 1.0)))
	return 1.0


func _state_momentum_mult(state_key: String) -> float:
	match state_key:
		"armor":
			return MOMENTUM_STATE_ARMOR_MULT
		"active":
			return MOMENTUM_STATE_ACTIVE_MULT
	return MOMENTUM_STATE_NORMAL_MULT


func _terminal_momentum_multiplier(data: Dictionary) -> float:
	if data.has("terminal_momentum_mult"):
		return clampf(float(data["terminal_momentum_mult"]), 0.35, 3.0)
	var name := ("%s %s" % [String(data.get("name", "")), String(data.get("muscle_name", ""))]).to_upper()
	var shape := String(data.get("shape", "")).to_lower()
	var damage_type := String(data.get("damage_type", "")).to_lower()
	if damage_type == "blunt" and (name.contains("GLOVE") or name.contains("GAUNTLET") or name.contains("FIST") or shape.contains("glove") or shape.contains("gauntlet") or shape.contains("fist")):
		return 1.5
	if damage_type == "pierce" and (name.contains("DRILL") or name.contains("AUGER") or name.contains("BORER") or shape.contains("drill") or shape.contains("auger") or shape.contains("borer")):
		return 1.5
	if damage_type == "tear" and (name.contains("KATANA") or name.contains("WAKIZASHI") or name.contains("ODACHI") or shape.contains("katana") or shape.contains("saber")):
		return 1.5
	return 1.0


func _weapon_damage_coefficient(base_damage: float, group: Dictionary, state_key: String) -> float:
	if bool(group.get("non_damage", false)):
		return 0.0
	var coeff := 0.46 + maxf(0.0, base_damage) / 20.0
	coeff *= maxf(0.15, float(group.get("damage_mult", 1.0)))
	coeff *= _state_momentum_mult(state_key)
	if bool(group.get("terminal_weapon", true)):
		coeff *= 1.08
	if int(group.get("blade_count", 1)) > 1:
		coeff *= 1.12
	match String(group.get("damage_type", "")):
		"pierce":
			coeff *= 1.08
		"tear":
			coeff *= 1.02
		"blunt":
			coeff *= 0.96
	return clampf(coeff, 0.0, 5.2)


func _booster_style_momentum_mult(style: String, sustain: float) -> float:
	var style_mult := 1.0
	match style:
		"smooth":
			style_mult = 0.72
		"cruise":
			style_mult = 0.82
		"sustain":
			style_mult = 0.9 + sustain * 0.1
		"burst":
			style_mult = 1.14
		"overburn":
			style_mult = 1.42
		"titan":
			style_mult = 1.18
	return style_mult


func _booster_normal_momentum_for_part(part: Dictionary) -> float:
	return maxf(0.0, _thruster_drive_demand_for_part(part) * _thruster_move_efficiency_for_part(part))


func _booster_boost_momentum_for_part(part: Dictionary) -> float:
	if part.has("boost_momentum"):
		return maxf(0.0, float(part.get("boost_momentum", 0.0)))
	return 0.0


func _thruster_drive_allocation_min_for_part(part: Dictionary) -> float:
	return maxf(0.0, _thruster_drive_demand_for_part(_thruster_with_drive_defaults(part)))


func _thruster_drive_allocation_max_for_part(part: Dictionary) -> float:
	var minimum := _thruster_drive_allocation_min_for_part(part)
	return data_rule_service.allocation_max(minimum) if data_rule_service != null else DataRuleService.new().allocation_max(minimum)


func _thruster_boost_brake_allocation_min_for_part(part: Dictionary) -> float:
	return maxf(0.0, _booster_boost_momentum_for_part(_thruster_with_drive_defaults(part)))


func _thruster_boost_brake_allocation_max_for_part(part: Dictionary) -> float:
	var minimum := _thruster_boost_brake_allocation_min_for_part(part)
	return data_rule_service.allocation_max(minimum) if data_rule_service != null else DataRuleService.new().allocation_max(minimum)


func _thruster_drive_allocated_for_payload(payload: Dictionary, part: Dictionary) -> float:
	var minimum := _thruster_drive_allocation_min_for_part(part)
	var maximum := _thruster_drive_allocation_max_for_part(part)
	if maximum <= minimum:
		return minimum
	var value := minimum
	if payload.has("thruster_drive_allocated_momentum"):
		value = float(payload.get("thruster_drive_allocated_momentum", minimum))
	return data_rule_service.clamp_allocation(value, minimum, maximum) if data_rule_service != null else DataRuleService.new().clamp_allocation(value, minimum, maximum)


func _thruster_boost_brake_allocated_for_payload(payload: Dictionary, part: Dictionary) -> float:
	var minimum := _thruster_boost_brake_allocation_min_for_part(part)
	var maximum := _thruster_boost_brake_allocation_max_for_part(part)
	if maximum <= minimum:
		return minimum
	var value := minimum
	if payload.has("thruster_boost_brake_allocated_momentum"):
		value = float(payload.get("thruster_boost_brake_allocated_momentum", minimum))
	return data_rule_service.clamp_allocation(value, minimum, maximum) if data_rule_service != null else DataRuleService.new().clamp_allocation(value, minimum, maximum)


func _thruster_boost_total_momentum_for_part(part: Dictionary) -> float:
	var boost_extra := _booster_boost_momentum_for_part(part)
	var duration := maxf(0.0, float(part.get("boost_duration", ECONOMY_THRUSTER_TARGET_DURATION)))
	if boost_extra <= 0.0 or duration <= 0.0:
		return 0.0
	var demand := _thruster_drive_demand_for_part(part)
	return maxf(0.0, (demand + boost_extra) * _thruster_boost_efficiency_for_part(part))


func _boost_duration_for_stats(stats: Dictionary) -> float:
	if stats.has("boost_duration"):
		var explicit_duration := float(stats.get("boost_duration", 0.0))
		if explicit_duration > 0.0:
			return explicit_duration
	return ECONOMY_THRUSTER_TARGET_DURATION if float(stats.get("thruster_boost_extra_demand", 0.0)) > 0.0 else 0.0


func _apply_thruster_momentum_stats(stats: Dictionary, role_key: String) -> void:
	if role_key == "barrier":
		stats["move_momentum"] = 0.0
		stats["boost_momentum"] = 0.0
		stats["thruster_boost_extra_demand"] = 0.0
		stats["thruster_boost_peak_demand"] = 0.0
		stats["thruster_effective_drive_demand"] = 0.0
		stats["thruster_effective_boost_peak_demand"] = 0.0
		stats["engine_drive_chain_ratio"] = 0.0
		stats["engine_boost_chain_ratio"] = 0.0
		stats["move_speed"] = 0.0
		stats["move_acceleration"] = 0.0
		stats["boost_speed"] = 0.0
		stats["boost_duration"] = 0.0
		stats["speedometer_max_speed"] = 0.0
		stats["speed_limit"] = 0.0
		if drive_system_service != null:
			drive_system_service.apply_drive_contract(stats, role_key)
		return
	var mass := maxf(1.0, float(stats.get("mass", 1.0)))
	var drive_demand := maxf(0.0, float(stats.get("thruster_drive_demand", 0.0)))
	var drive_chain_ratio := clampf(float(stats.get("engine_drive_chain_ratio", 0.0)), 0.0, 1.0)
	var allocated_momentum := maxf(0.0, float(stats.get("thruster_effective_drive_demand", drive_demand * drive_chain_ratio)))
	var efficiency_weight := maxf(0.0, float(stats.get("thruster_efficiency_weight", 0.0)))
	var move_efficiency := clampf(float(stats.get("move_efficiency", 1.0)), 0.2, 3.0)
	var boost_efficiency := clampf(float(stats.get("boost_efficiency", ECONOMY_BOOST_MOMENTUM_MULT)), 0.2, 4.0)
	var turn_efficiency := clampf(float(stats.get("turn_efficiency", 1.0)), 0.2, 3.0)
	if efficiency_weight > 0.001:
		move_efficiency = clampf(float(stats.get("move_efficiency_sum", 0.0)) / efficiency_weight, 0.2, 3.0)
		boost_efficiency = clampf(float(stats.get("boost_efficiency_sum", 0.0)) / efficiency_weight, 0.2, 4.0)
		turn_efficiency = clampf(float(stats.get("turn_efficiency_sum", 0.0)) / efficiency_weight, 0.2, 3.0)
	var thruster_momentum := allocated_momentum * move_efficiency
	var boost_extra_demand := maxf(0.0, float(stats.get("thruster_boost_extra_demand", 0.0)))
	var boost_peak_demand := maxf(0.0, float(stats.get("thruster_boost_peak_demand", drive_demand + boost_extra_demand)))
	if boost_peak_demand <= 0.0:
		boost_peak_demand = drive_demand + boost_extra_demand
	var boost_chain_ratio := clampf(float(stats.get("engine_boost_chain_ratio", drive_chain_ratio)), 0.0, 1.0)
	var effective_boost_peak := maxf(0.0, float(stats.get("thruster_effective_boost_peak_demand", boost_peak_demand * boost_chain_ratio)))
	var boost_momentum := boost_extra_demand
	var boost_duration := _boost_duration_for_stats(stats)
	var boost_total_momentum := 0.0
	if boost_extra_demand > 0.0 and effective_boost_peak > 0.0 and boost_duration > 0.0 and boost_efficiency > 0.0:
		boost_total_momentum = maxf(0.0, effective_boost_peak * boost_efficiency)
	var thruster_acceleration := thruster_momentum / mass
	var body_move_speed := maxf(0.0, thruster_acceleration)
	var boost_speed := maxf(0.0, boost_total_momentum / mass)
	var torso_speed_mult := maxf(0.25, float(stats.get("speedometer_mult", stats.get("speed_limit_mult", 1.0))))
	var derived_speed_limit := maxf(1.0, maxf(body_move_speed * 3.0, boost_speed * 2.0) * 1.5 * torso_speed_mult)
	var speedometer_max_speed := derived_speed_limit
	stats["move_momentum"] = thruster_momentum
	stats["boost_momentum"] = boost_total_momentum
	stats["thruster_drive_demand"] = drive_demand
	stats["thruster_boost_extra_demand"] = boost_extra_demand
	stats["thruster_boost_peak_demand"] = boost_peak_demand
	stats["thruster_effective_drive_demand"] = allocated_momentum
	stats["thruster_effective_boost_peak_demand"] = effective_boost_peak
	stats["engine_drive_chain_ratio"] = drive_chain_ratio
	stats["engine_boost_chain_ratio"] = boost_chain_ratio
	stats["move_speed"] = body_move_speed
	stats["move_acceleration"] = thruster_acceleration
	stats["boost_speed"] = boost_speed
	stats["move_efficiency"] = move_efficiency
	stats["boost_efficiency"] = boost_efficiency
	stats["turn_efficiency"] = turn_efficiency
	stats["speedometer_max_speed"] = speedometer_max_speed
	stats["speed_limit"] = speedometer_max_speed
	stats["boost_duration"] = boost_duration
	stats["brake_power"] = maxf(0.0, effective_boost_peak / mass)
	if body_move_speed > 0.0:
		stats["speed"] = body_move_speed / MOMENTUM_MOVE_SPEED_MULT
	if drive_system_service != null:
		drive_system_service.apply_drive_contract(stats, role_key)


func _apply_drive_motion_stats(stats: Dictionary, role_key: String) -> void:
	_apply_thruster_momentum_stats(stats, role_key)


func _estimated_boost_attack_speed(stats: Dictionary) -> float:
	var stat_boost_speed := float(stats.get("boost_speed", 0.0))
	if stat_boost_speed > 0.0:
		return stat_boost_speed
	var mass := maxf(1.0, float(stats.get("mass", 1.0)))
	return maxf(0.0, float(stats.get("boost_total_momentum", 0.0))) / mass


func _group_limb_end_mass(group: Dictionary, stats: Dictionary) -> float:
	var terminal_mass := maxf(0.0, float(group.get("terminal_weapon_mass", group.get("mass", 0.0))))
	var muscle_mass := maxf(0.0, float(group.get("muscle_mass", 0.0)))
	var fallback_mass := maxf(0.6, float(stats.get("mass", 8.0)) * 0.12)
	return maxf(0.45, terminal_mass + muscle_mass * 0.72 + fallback_mass * 0.18)


func _group_joint_equivalent_mass(stats: Dictionary, group: Dictionary) -> float:
	var end_mass := _group_limb_end_mass(group, stats)
	var body_mass := maxf(1.0, float(stats.get("mass", 1.0)) - end_mass * 0.35)
	return maxf(0.45, (end_mass * body_mass) / maxf(0.001, end_mass + body_mass))


func _group_joint_actuation_speed(stats: Dictionary, group: Dictionary, state_key: String = "normal") -> float:
	var output_momentum := maxf(0.0, float(group.get("fixed_output_momentum", 0.0)))
	if output_momentum <= 0.0:
		var joint_power := maxf(0.08, float(group.get("joint_power", 0.0)))
		if joint_power <= 0.081:
			joint_power = 0.72 + float(group.get("joint_range", 0.0)) * 1.6 + float(group.get("range_mult", 1.0)) * 0.22 + float(stats.get("cancel_power", 0.0)) * 0.75
		output_momentum = joint_power * 145.0
	var driven_mass := _group_limb_end_mass(group, stats)
	var motion := String(group.get("motion", "straight"))
	var motion_mult := 1.0
	if motion.contains("chain"):
		motion_mult = 1.18
	elif motion in ["pendulum", "swing_aim", "auto_swing", "pincer_clamp"]:
		motion_mult = 1.08
	elif motion.contains("thrust") or motion.contains("突击"):
		motion_mult = 1.12
	var speed_bonus := 1.0 + clampf(float(group.get("swing_speed_bonus", 0.0)), -0.45, 0.75)
	var overload := maxf(1.0, float(stats.get("load_overload_ratio", 1.0)))
	var speed := output_momentum * motion_mult * speed_bonus * _state_momentum_mult(state_key) / maxf(0.45, driven_mass)
	return clampf(speed / sqrt(overload), 0.03, 5.4)


func _melee_module_heat_key(group: Dictionary, attack_index: int) -> String:
	var module_name := String(group.get("module_name", ""))
	if module_name != "":
		return module_name
	var profile := String(group.get("module_action_profile", ""))
	if profile != "":
		return profile
	var effect := String(group.get("module_effect", ""))
	if effect != "":
		return effect
	return "%s:%d" % [String(group.get("motion", "melee")), attack_index]


func _melee_module_repeat_info(attacker, group: Dictionary, attack_index: int) -> Dictionary:
	var now := Time.get_ticks_msec() * 0.001
	var key := _melee_module_heat_key(group, attack_index)
	var ledger: Dictionary = {}
	if attacker.has_meta("melee_module_heat_ledger") and attacker.get_meta("melee_module_heat_ledger") is Dictionary:
		ledger = attacker.get_meta("melee_module_heat_ledger").duplicate(true)
	var previous: Dictionary = ledger.get(key, {})
	var last_time := float(previous.get("time", -999.0))
	var previous_stack := int(previous.get("stack", 0))
	var last_sequence_key := String(attacker.get_meta("last_melee_module_heat_key", ""))
	var within_window := last_sequence_key == key and now - last_time <= MELEE_MODULE_HEAT_WINDOW_SECONDS
	var stack := clampi(previous_stack if within_window else 0, 0, MELEE_MODULE_REPEAT_HEAT_MAX_STACK)
	var same_frame_pair := bool(group.get("requires_joint_pair", false)) and within_window and now - last_time < 0.05
	if not same_frame_pair:
		ledger[key] = {
			"time": now,
			"stack": clampi(stack + 1, 0, MELEE_MODULE_REPEAT_HEAT_MAX_STACK),
		}
		attacker.set_meta("last_melee_module_heat_key", key)
	else:
		ledger[key] = previous
	attacker.set_meta("melee_module_heat_ledger", ledger)
	return {
		"key": key,
		"stack": stack,
		"mult": 1.0 + float(stack) * MELEE_MODULE_REPEAT_HEAT_STEP,
		"consecutive_same": last_sequence_key == key,
	}


func _apply_melee_module_heat(attacker, event: Dictionary, group: Dictionary, attack_index: int) -> void:
	var repeat_info := _melee_module_repeat_info(attacker, group, attack_index) if attacker != null and is_instance_valid(attacker) else {}
	event["module_heat_raw"] = 0.0
	event["module_heat_cooling_offset"] = 0.0
	event["module_heat_repeat_stack"] = int(repeat_info.get("stack", 0))
	event["module_heat_repeat_mult"] = 1.0
	event["module_heat_consecutive_same"] = bool(repeat_info.get("consecutive_same", false))
	event["module_cancel_heat_reward"] = bool(event.get("module_cancel", false))
	event["module_heat_cost"] = 0.0
	event["terminal_momentum_mult"] = _terminal_momentum_multiplier(group)
	if attacker != null and is_instance_valid(attacker):
		attacker.set_meta("last_module_heat_cost", 0.0)
		attacker.set_meta("last_module_heat_repeat_stack", int(repeat_info.get("stack", 0)))


func _momentum_damage_for_event(attacker, event: Dictionary) -> float:
	if attacker == null or not is_instance_valid(attacker) or bool(event.get("projectile", false)):
		return float(event.get("damage", 0.0))
	var stats: Dictionary = attacker.stats
	var group: Dictionary = event.get("collision_group", {})
	var state_key := String(event.get("state", "normal"))
	var coeff := maxf(0.0, float(event.get("weapon_damage_coeff", _weapon_damage_coefficient(float(event.get("damage", 1.0)), group, state_key))))
	var velocity_info := _active_melee_momentum_velocity(attacker, event)
	var attack_collider := _attack_collider_for_event(attacker, event)
	if not attack_collider.is_empty():
		coeff = _runtime_contact_part_damage_coeff(attack_collider) * _state_momentum_mult(state_key)
	var attack_speed := maxf(0.0, float(velocity_info.get("net_speed", 0.0)))
	var collider_velocity: Vector2 = velocity_info.get("collider_velocity", Vector2.ZERO)
	if attack_speed < 0.04:
		event["momentum"] = 0.0
		_set_event_momentum_vector(event, Vector2.ZERO, 0.0)
		event["momentum_attack_speed"] = attack_speed
		event["momentum_body_speed"] = float(velocity_info.get("body_speed", 0.0))
		event["momentum_component_speed"] = float(velocity_info.get("component_speed", 0.0))
		event["momentum_net_speed"] = attack_speed
		return 0.0
	var terminal_momentum_mult := _terminal_momentum_multiplier(group)
	var momentum := maxf(1.0, float(stats.get("mass", 1.0))) * attack_speed * terminal_momentum_mult
	momentum *= maxf(0.1, float(event.get("contact_momentum_mult", 1.0)))
	var fallback_stiffness := maxf(0.0, float(stats.get("stiffness", 0.0)))
	if fallback_stiffness <= 1.0 and not group.has("group_stiffness"):
		fallback_stiffness = maxf(MOMENTUM_STIFFNESS_UNIT, momentum * 0.92)
	var stiffness := maxf(1.0, float(event.get("group_stiffness", group.get("group_stiffness", fallback_stiffness))))
	var overload_penalty := clampf(stiffness / maxf(stiffness, momentum), 0.42, 1.0)
	event["momentum"] = momentum
	var momentum_direction: Vector2 = collider_velocity.normalized() if collider_velocity.length() > 0.001 else Vector2(velocity_info.get("direction", Vector2.RIGHT))
	if momentum_direction.length() <= 0.001:
		momentum_direction = Vector2(float(attacker.facing), 0.0)
	_set_event_momentum_vector(event, momentum_direction.normalized() * momentum, momentum)
	event["momentum_velocity_vector"] = collider_velocity
	event["momentum_attack_speed"] = attack_speed
	event["momentum_body_speed"] = float(velocity_info.get("body_speed", 0.0))
	event["momentum_component_speed"] = float(velocity_info.get("component_speed", 0.0))
	event["momentum_net_speed"] = attack_speed
	event["terminal_momentum_mult"] = terminal_momentum_mult
	return maxf(1.0, momentum * coeff * MOMENTUM_DAMAGE_SCALE * overload_penalty)


func _active_melee_momentum_velocity(attacker, event: Dictionary) -> Dictionary:
	var direction := Vector2(float(attacker.facing), 0.0)
	if event.has("direction") and event["direction"] is Vector2:
		direction = event["direction"]
	if direction.length() <= 0.01:
		direction = Vector2(float(attacker.facing), 0.0)
	direction = direction.normalized()
	var body_velocity: Vector2 = attacker.velocity
	var collider_velocity := body_velocity
	var attack_collider := _attack_collider_for_event(attacker, event)
	var has_collider := not attack_collider.is_empty()
	if has_collider:
		collider_velocity = _contact_collider_velocity(attacker, attack_collider)
		var runtime_module_speed := 0.0
		if bool(event.get("runtime_direct_module", false)):
			runtime_module_speed = maxf(runtime_module_speed, float(event.get("joint_actuation_speed", 0.0)))
			var output_momentum := maxf(0.0, float(event.get("fixed_output_momentum", 0.0)))
			if output_momentum > 0.0:
				runtime_module_speed = maxf(runtime_module_speed, output_momentum / maxf(1.0, float(attacker.stats.get("mass", 1.0))))
		if runtime_module_speed > 0.0 and collider_velocity.length() < runtime_module_speed:
			collider_velocity = direction * runtime_module_speed + body_velocity.project(direction)
	else:
		var synthetic_component := direction * (maxf(0.0, float(event.get("joint_actuation_speed", 0.0))) * 0.08)
		collider_velocity = body_velocity + synthetic_component
	var net_speed := collider_velocity.length()
	var net_axis := collider_velocity.normalized() if net_speed > 0.001 else direction
	var body_speed := body_velocity.dot(net_axis)
	var component_speed := net_speed - body_speed
	return {
		"direction": direction,
		"body_speed": body_speed,
		"component_speed": component_speed,
		"net_speed": maxf(0.0, net_speed),
		"raw_net_speed": net_speed,
		"collider_velocity": collider_velocity,
	}


func _melee_damage_adjusted(event: Dictionary, damage: int) -> int:
	if damage <= 0 or bool(event.get("projectile", false)):
		return damage
	match String(event.get("damage_type", "blunt")):
		"pierce":
			return damage
		"tear":
			return maxi(1, int(roundf(float(damage) * 0.96)))
		"blunt":
			return maxi(1, int(roundf(float(damage) * 0.9)))
	return damage


func _register_part_damage(target, event: Dictionary, damage: int, counter_tier: int) -> void:
	if target == null or not is_instance_valid(target) or not _unit_is_mech_physics_subject(target):
		return
	if bool(event.get("projectile", false)) or String(event.get("damage_type", "")) != "tear":
		return
	var raw_index := int(event.get("target_part_index", event.get("muscle_node", -1)))
	var part_kind := String(event.get("target_part_kind", "core"))
	if part_kind == "torso":
		_register_torso_unit_damage(target, event, damage, counter_tier)
		return
	if raw_index < 0:
		return
	var attack_index := clampi(raw_index, 0, ATTACK_GROUP_COUNT - 1)
	if part_kind == "terminal":
		_register_terminal_part_damage(target, event, attack_index, damage, counter_tier)
		return
	var severed: Dictionary = {}
	if target.has_meta("severed_limbs") and target.get_meta("severed_limbs") is Dictionary:
		severed = target.get_meta("severed_limbs")
	if bool(severed.get(str(attack_index), false)):
		return
	var max_limb_hp := _target_limb_max_hp(target, attack_index)
	if max_limb_hp <= 0.0:
		return
	var limb_hp: Dictionary = {}
	if target.has_meta("limb_hp") and target.get_meta("limb_hp") is Dictionary:
		limb_hp = target.get_meta("limb_hp")
	var limb_key := str(attack_index)
	var current_hp := float(limb_hp.get(limb_key, max_limb_hp))
	current_hp -= maxf(1.0, float(damage) * (1.0 + float(counter_tier) * 0.08))
	limb_hp[limb_key] = current_hp
	target.set_meta("limb_hp", limb_hp)
	if current_hp > 0.0:
		if float(damage) >= maxf(10.0, max_limb_hp * 0.24):
			target.set_meta("part_fail_flash", 0.2)
		return
	severed[limb_key] = true
	target.set_meta("severed_limbs", severed)
	target.set_meta("part_fail_flash", 0.55)
	_play_module_fail_sfx()
	_spawn_hit_effect(target, 2, "tear", false, "slash")
	_show_battle_message("%s limb %d severed by tearing strike" % [target.unit_name, attack_index + 1], 0.8)


func _register_terminal_part_damage(target, event: Dictionary, attack_index: int, damage: int, counter_tier: int) -> void:
	var max_part_hp := _target_part_max_hp(target, attack_index, "terminal")
	if max_part_hp <= 0.0:
		return
	var key := _part_damage_key(attack_index, "terminal")
	var broken: Dictionary = {}
	if target.has_meta("broken_part_segments") and target.get_meta("broken_part_segments") is Dictionary:
		broken = target.get_meta("broken_part_segments")
	if bool(broken.get(key, false)):
		return
	var part_hp: Dictionary = {}
	if target.has_meta("part_hp") and target.get_meta("part_hp") is Dictionary:
		part_hp = target.get_meta("part_hp")
	var current_hp := float(part_hp.get(key, max_part_hp))
	current_hp -= maxf(1.0, float(damage) * (1.0 + float(counter_tier) * 0.08))
	part_hp[key] = current_hp
	target.set_meta("part_hp", part_hp)
	if current_hp > 0.0:
		if float(damage) >= maxf(8.0, max_part_hp * 0.28):
			target.set_meta("part_fail_flash", 0.18)
		return
	broken[key] = true
	target.set_meta("broken_part_segments", broken)
	target.set_meta("part_fail_flash", 0.48)
	_play_module_fail_sfx()
	_spawn_hit_effect(target, 2, "tear", false, "slash")
	_show_battle_message("%s terminal %d cut off" % [target.unit_name, attack_index + 1], 0.75)


func _register_torso_unit_damage(target, event: Dictionary, damage: int, counter_tier: int) -> void:
	var torso_index := int(event.get("target_torso_unit_index", -1))
	var max_part_hp := _target_torso_unit_max_hp(target, torso_index)
	if max_part_hp <= 0.0:
		return
	var key := str(maxi(0, torso_index))
	var broken: Dictionary = {}
	if target.has_meta("broken_torso_units") and target.get_meta("broken_torso_units") is Dictionary:
		broken = target.get_meta("broken_torso_units")
	if bool(broken.get(key, false)):
		return
	var torso_hp: Dictionary = {}
	if target.has_meta("torso_unit_hp") and target.get_meta("torso_unit_hp") is Dictionary:
		torso_hp = target.get_meta("torso_unit_hp")
	var current_hp := float(torso_hp.get(key, max_part_hp))
	current_hp -= maxf(1.0, float(damage) * (1.0 + float(counter_tier) * 0.08))
	torso_hp[key] = current_hp
	target.set_meta("torso_unit_hp", torso_hp)
	if current_hp > 0.0:
		if float(damage) >= maxf(10.0, max_part_hp * 0.24):
			target.set_meta("part_fail_flash", 0.22)
		return
	broken[key] = true
	target.set_meta("broken_torso_units", broken)
	target.set_meta("part_fail_flash", 0.55)
	_play_module_fail_sfx()
	_spawn_hit_effect(target, 2, "tear", false, "slash")
	_show_battle_message("%s torso unit %d structurally cut" % [target.unit_name, maxi(0, torso_index) + 1], 0.8)
	_handle_torso_fracture_brood(target, torso_index, broken, torso_hp, max_part_hp)


func _part_damage_key(attack_index: int, part_kind: String) -> String:
	return "%d:%s" % [attack_index, part_kind]


func _target_torso_stiffness_segment(target, torso_index: int) -> Dictionary:
	if target == null or not is_instance_valid(target):
		return {}
	var units: Array = target.stats.get("torso_stiffness_segments", [])
	if units.is_empty():
		return {}
	var index := clampi(torso_index, 0, units.size() - 1)
	if units[index] is Dictionary:
		return units[index]
	return {}


func _target_torso_unit_max_hp(target, torso_index: int) -> float:
	var unit := _target_torso_stiffness_segment(target, torso_index)
	if unit.is_empty():
		if target != null and is_instance_valid(target):
			return maxf(CONTACT_UNIT_HP_MIN, float(target.stats.get("torso_stiffness_segment_hp", target.max_health * 0.32)))
		return 0.0
	return maxf(CONTACT_UNIT_HP_MIN, float(unit.get("unit_hp", 0.0)))


func _unit_has_fracture_brood_module(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	if String(unit.stats.get("module_effect", "")) == "torso_fracture_brood":
		return true
	for raw_binding in Array(unit.stats.get("runtime_module_bindings", [])):
		if raw_binding is Dictionary and String(Dictionary(raw_binding).get("module_effect", "")) == "torso_fracture_brood":
			return true
	return false


func _fracture_brood_ai_kind(unit) -> String:
	if unit == null or not is_instance_valid(unit):
		return "guard_orbit"
	var ai_kind := String(unit.stats.get("fracture_ai", ""))
	if ai_kind != "":
		return ai_kind
	for raw_binding in Array(unit.stats.get("runtime_module_bindings", [])):
		if raw_binding is Dictionary:
			var binding: Dictionary = raw_binding
			if String(binding.get("module_effect", "")) == "torso_fracture_brood":
				return String(binding.get("fracture_ai", "guard_orbit"))
	return "guard_orbit"


func _soul_anchor_torso_index(unit) -> int:
	if unit == null or not is_instance_valid(unit):
		return -1
	var units: Array = Array(unit.stats.get("torso_stiffness_segments", []))
	if units.is_empty():
		return 0 if bool(unit.stats.get("has_soul", false)) else -1
	var raw_anchor := int(unit.stats.get("soul_anchor_torso_unit_index", -1))
	if unit.has_meta("soul_anchor_torso_unit_index"):
		raw_anchor = int(unit.get_meta("soul_anchor_torso_unit_index"))
	if raw_anchor < 0:
		raw_anchor = int(floorf(float(units.size() - 1) * 0.5))
	return clampi(raw_anchor, 0, units.size() - 1)


func _torso_unit_world_position(unit, torso_index: int) -> Vector2:
	if unit == null or not is_instance_valid(unit):
		return Vector2.ZERO
	var entries: Array = Array(unit.stats.get("torso_stiffness_segments", []))
	var body_origin := Vector2(unit.ring_pos, unit.lane)
	var axis := Vector2(cos(float(unit.facing_angle)), sin(float(unit.facing_angle)))
	if axis.length_squared() <= 0.0001:
		axis = Vector2(float(unit.facing), 0.0)
	var side := Vector2(-axis.y, axis.x)
	var body_length := clampf(float(unit.stats.get("length", 1.0)), 0.12, 4.5)
	if torso_index >= 0 and torso_index < entries.size() and entries[torso_index] is Dictionary:
		var entry: Dictionary = entries[torso_index]
		var local_offset = entry.get("local_offset", Vector2.ZERO)
		if not (local_offset is Vector2):
			local_offset = Vector2.ZERO
		var center := body_origin + axis * float(local_offset.x) + side * float(local_offset.y)
		if entries.size() > 1 and not bool(entry.get("has_topology_offset", false)):
			var t := 0.5 if entries.size() <= 1 else float(torso_index) / float(entries.size() - 1)
			center += axis * (t - 0.5) * body_length * 0.52
		return Vector2(wrapf(center.x, 0.0, RING_LENGTH), clampf(center.y, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT))
	return body_origin


func _torso_fragment_stats(parent, torso_index: int, torso_unit: Dictionary) -> Dictionary:
	var count := maxi(1, Array(parent.stats.get("torso_stiffness_segments", [])).size())
	var unit_hp := maxf(CONTACT_UNIT_HP_MIN, float(torso_unit.get("unit_hp", parent.stats.get("torso_stiffness_segment_hp", parent.max_health * 0.22))))
	var fragment_length := clampf(float(torso_unit.get("length", parent.stats.get("length", 0.55) / float(count))), 0.08, 1.65)
	var fragment_radius := clampf(float(torso_unit.get("radius", parent.stats.get("radius", 0.16))), 0.035, 0.95)
	var fragment_mass := maxf(1.0, float(parent.stats.get("mass", 6.0)) / float(count))
	var stats: Dictionary = parent.stats.duplicate(true)
	stats["role"] = "puppet"
	stats["name"] = "%s BROOD %d" % [String(torso_unit.get("name", "TORSO")), torso_index + 1]
	stats["health"] = int(ceilf(unit_hp))
	stats["mass"] = fragment_mass
	stats["structural_mass"] = fragment_mass
	stats["length"] = fragment_length
	stats["radius"] = fragment_radius
	stats["speed"] = clampf(float(parent.stats.get("speed", 0.85)) * 1.05, 0.24, 2.2)
	stats["acceleration"] = clampf(float(parent.stats.get("acceleration", 2.5)) * 1.08, 0.6, 6.0)
	stats["drag"] = clampf(float(parent.stats.get("drag", 3.0)) + 0.4, 1.0, 7.2)
	stats["heat_capacity"] = 0.0
	stats["ai"] = _fracture_brood_ai_kind(parent)
	stats["group_count"] = 1
	stats["sequence"] = ["normal"]
	stats["projectile"] = false
	stats["module_effect"] = ""
	stats["role_switch"] = ""
	stats["deploy_cost"] = 0
	stats["bounty_reward"] = 0
	stats["insured_refund"] = 0
	stats["owner_destroy_penalty"] = 0
	stats["temporary_fracture_puppet"] = true
	stats["puppet_exception_group"] = true
	stats["fracture_parent_id"] = str(parent.get_instance_id())
	stats["fracture_origin_role"] = String(parent.role)
	stats["fracture_torso_index"] = torso_index
	stats["torso_visual_shape"] = String(parent.stats.get("torso_visual_shape", parent.stats.get("shape", "fragment")))
	stats["torso_visual_material"] = String(parent.stats.get("torso_visual_material", "metal"))
	stats["torso_stiffness_segment_count"] = 1
	stats["torso_stiffness_segment_hp"] = unit_hp
	stats["torso_break_threshold"] = float(torso_unit.get("threshold", parent.stats.get("torso_break_threshold", 0.0)))
	stats["torso_stiffness_segments"] = [{
		"name": String(torso_unit.get("name", "FRACTURE TORSO")),
		"length": fragment_length,
		"radius": fragment_radius,
		"unit_hp": unit_hp,
		"threshold": stats["torso_break_threshold"],
		"local_offset": Vector2.ZERO,
		"has_topology_offset": true,
	}]
	return stats


func _next_puppet_slot(player_id: int) -> int:
	var next_slot := 0
	for unit in active_units[player_id]["puppet"]:
		if _is_live_unit(unit):
			next_slot = maxi(next_slot, int(unit.get_meta("puppet_group_slot", -1)) + 1)
	return next_slot


func _spawn_torso_fragment_puppet(parent, torso_index: int) -> bool:
	if parent == null or not is_instance_valid(parent):
		return false
	if torso_index < 0:
		return false
	var spawned: Dictionary = {}
	if parent.has_meta("fracture_spawned_torso_units") and parent.get_meta("fracture_spawned_torso_units") is Dictionary:
		spawned = parent.get_meta("fracture_spawned_torso_units")
	var key := str(torso_index)
	if bool(spawned.get(key, false)):
		return false
	var torso_unit := _target_torso_stiffness_segment(parent, torso_index)
	if torso_unit.is_empty():
		return false
	var owner := int(parent.owner_id)
	var pos := _torso_unit_world_position(parent, torso_index)
	var stats := _torso_fragment_stats(parent, torso_index, torso_unit)
	var unit = _create_unit(owner, "puppet", stats, "P%d FRACTURE BROOD %d" % [owner, torso_index + 1], pos.x, pos.y)
	unit.set_meta("temporary_fracture_puppet", true)
	unit.set_meta("puppet_exception_group", true)
	unit.set_meta("fracture_parent_id", str(parent.get_instance_id()))
	unit.set_meta("fracture_torso_index", torso_index)
	var slot := _next_puppet_slot(owner)
	unit.set_meta("puppet_group_slot", slot)
	unit.set_meta("puppet_group_size", maxi(slot + 1, _puppet_group_size(owner)))
	unit.velocity = parent.velocity * 0.68 + Vector2(randf_range(-0.28, 0.28), randf_range(-0.22, 0.22))
	var group: Array = active_units[owner]["puppet"]
	group.append(unit)
	active_units[owner]["puppet"] = group
	spawned[key] = true
	parent.set_meta("fracture_spawned_torso_units", spawned)
	_spawn_hit_effect(unit, 1, "tear", false, "slash")
	return true


func _handle_torso_fracture_brood(target, torso_index: int, broken: Dictionary, torso_hp: Dictionary, max_part_hp: float) -> void:
	if target == null or not is_instance_valid(target):
		return
	var torso_units: Array = Array(target.stats.get("torso_stiffness_segments", []))
	if torso_units.size() < 2:
		return
	if not _unit_has_fracture_brood_module(target):
		return
	var spawned_count := 0
	var anchor := _soul_anchor_torso_index(target)
	var target_is_soul_hero := String(target.role) == "hero" and bool(target.stats.get("has_soul", false)) and torso_index == anchor
	if target_is_soul_hero:
		broken.erase(str(anchor))
		torso_hp[str(anchor)] = maxf(CONTACT_UNIT_HP_MIN, max_part_hp * 0.35)
		target.set_meta("torso_unit_hp", torso_hp)
		target.set_meta("soul_anchor_torso_unit_index", anchor)
		for i in range(torso_units.size()):
			if i == anchor:
				continue
			var key := str(i)
			if bool(broken.get(key, false)):
				continue
			broken[key] = true
			if _spawn_torso_fragment_puppet(target, i):
				spawned_count += 1
		target.set_meta("broken_torso_units", broken)
	else:
		if _spawn_torso_fragment_puppet(target, torso_index):
			spawned_count += 1
	if spawned_count > 0:
		target.set_meta("part_fail_flash", 0.75)
		_show_battle_message("%s torso fracture: temporary puppet brood online" % target.unit_name, 1.05)


