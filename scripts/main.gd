	if counts.has("NEURAL TETHER RESEARCH"):
		var strength := clampf(float(counts["NEURAL TETHER RESEARCH"]) / 4.0, 0.0, 1.5)
		stats["takeover_power"] = float(stats.get("takeover_power", 1.0)) + 0.12 * strength
		stats["web_strength"] = float(stats.get("web_strength", 0.0)) + 0.04 * strength
