func _try_control_page_shift_module(unit) -> bool:
	if not _is_live_unit(unit):
		return false
	var pages: Array = unit.stats.get("control_pages", ["limb", "spare", "trap"])
	if pages.is_empty():
		pages = ["limb"]
	var current := String(unit.get_meta("control_page", String(pages[0])))
	var next_index := (pages.find(current) + 1) % pages.size()
	if next_index < 0:
		next_index = 0
	var next_page := String(pages[next_index])
	unit.set_meta("control_page", next_page)
	_spawn_hit_effect(unit, 1, "laser", false, "web_snap")
	_show_battle_message("%s CONTROL PAGE: %s" % [unit.unit_name, next_page.to_upper()], 0.72)
	return true


func _try_fold_barrier_squad(unit) -> bool:
	if not _is_live_unit(unit):
		return false
	if String(unit.role) == "barrier" and String(unit.stats.get("role_switch", "")) == "":
		unit.stats["role_switch"] = "puppet"
		unit.stats["ai"] = String(unit.stats.get("ai", "screen_wall"))
		unit.stats["group_count"] = max(int(unit.stats.get("group_count", 1)), 4)
		return _try_role_switch_module(unit)
	if String(unit.stats.get("role_switch", "")) == "":
		var owner := int(unit.owner_id)
		var barrier = active_units[owner]["barrier"]
		if _is_live_unit(barrier):
			barrier.stats["role_switch"] = "puppet"
			barrier.stats["ai"] = String(unit.stats.get("ai", barrier.stats.get("ai", "screen_wall")))
			barrier.stats["group_count"] = max(int(unit.stats.get("group_count", 4)), int(barrier.stats.get("group_count", 1)))
			return _try_role_switch_module(barrier)
		_play_module_fail_sfx()
		_show_battle_message("%s needs a live Fold Parade barrier" % unit.unit_name, 0.72)
		return false
	return _try_role_switch_module(unit)


func _try_racket_serve(hero, input_vector: Vector2) -> bool:
	if not _is_live_unit(hero):
		return false
	var serve_range := maxf(0.12, float(hero.stats.get("serve_range", 0.72)))
	var best = null
	var best_distance := 999.0
	for ally in _friendly_units(int(hero.owner_id)):
		if ally == hero or not _is_live_unit(ally) or not bool(ally.stats.get("ball_puppet", false)):
			continue
		var delta := _mobius_delta_vec_between(hero, ally)
		var distance := absf(delta.x) + absf(delta.y) * 0.82
		if distance <= serve_range and distance < best_distance:
			best_distance = distance
			best = ally
	if best == null:
		_play_module_fail_sfx()
		_show_battle_message("%s needs a nearby ball puppet" % hero.unit_name, 0.62)
		return false
	var direction := _attack_direction(hero, input_vector)
	var power := maxf(0.1, float(hero.stats.get("racket_power", 1.1)))
	best.velocity += Vector2(direction.x, direction.y * 0.68) * power
	best.set_meta("served_ball_timer", 2.2)
	best.set_meta("served_ball_owner", int(hero.owner_id))
	best.set_meta("served_ball_damage", maxi(4, int(best.stats.get("ball_hit_damage", 12)) + int(roundf(power * 5.0))))
	best.set_meta("served_ball_damage_type", String(best.stats.get("damage_type", "blunt")))
	_spawn_hit_effect(best, 1, String(best.stats.get("damage_type", "blunt")), false, "shield")
	_show_battle_message("%s SERVES %s" % [hero.unit_name, best.unit_name], 0.62)
	return true


func _update_served_balls(delta: float) -> void:
	for ball in all_units:
		if not _is_live_unit(ball) or float(ball.get_meta("served_ball_timer", 0.0)) <= 0.0:
			continue
		var owner := int(ball.get_meta("served_ball_owner", ball.owner_id))
		var damage := maxi(1, int(ball.get_meta("served_ball_damage", ball.stats.get("ball_hit_damage", 10))))
		var damage_type := String(ball.get_meta("served_ball_damage_type", ball.stats.get("damage_type", "blunt")))
		for target in _enemy_units(owner):
			if not _is_live_unit(target):
				continue
			var ball_delta := _mobius_delta_vec_between(ball, target)
			var distance := absf(ball_delta.x)
			var lane_distance := absf(ball_delta.y)
			var radius := float(ball.stats.get("radius", 0.18)) + float(target.stats.get("radius", 0.18))
			if distance > radius + 0.16 or lane_distance > radius * 0.62 + 0.12:
				continue
			var event := {"damage_type": damage_type, "projectile": false}
			var final_damage := _projectile_material_adjusted_damage(target, event, damage)
			var blocked := final_damage <= 0 or bool(event.get("contact_gate_blocked", false))
			_spawn_hit_effect(target, 2, damage_type, blocked, "missile")
			if blocked:
				continue
			_apply_hitstop(damage_type, 2, final_damage)
			var killed: bool = target.take_hit(final_damage, "active", owner, damage_type, "weapon")
			ball.set_meta("served_ball_timer", 0.0)
			ball.velocity *= -0.35
			if killed:
				_handle_unit_killed(target, owner)
			break


func _morph_shape_for(current_shape: String, mode: String) -> String:
	match mode:
		"travel":
			return "snake"
		"siege":
			return "tank"
		"combat":
			return "crab" if current_shape in ["snake", "tank", "core"] else current_shape
	return current_shape


func _is_recoil_countered(player_id: int, prefix: String, attack_direction: Vector2) -> bool:
	var hero = active_units[player_id]["hero"]
	if not _is_live_unit(hero) or float(hero.stats.get("boost_momentum", 0.0)) <= 0.0:
		return false
	var held := _input_vector_for(prefix)
	if held.length() < 0.2:
		return false
	return held.normalized().dot(-attack_direction.normalized()) > 0.55


func _absolute_command_vector(token: String) -> Vector2:
	match token:
		"1":
			return Vector2(-1.0, 1.0)
		"2":
			return Vector2.DOWN
		"3":
			return Vector2(1.0, 1.0)
		"4":
			return Vector2.LEFT
		"6":
			return Vector2.RIGHT
		"7":
			return Vector2(-1.0, -1.0)
		"8":
			return Vector2.UP
		"9":
			return Vector2(1.0, -1.0)
	return Vector2.ZERO


func _latest_command_direction(player_id: int) -> Vector2:
	var buffer: Array = command_buffers.get(player_id, [])
	for i in range(buffer.size() - 1, -1, -1):
		var direction := _absolute_command_vector(String(buffer[i]))
		if direction.length() > 0.01:
			return direction.normalized()
	return Vector2.ZERO


func _facing_relative_attack_state(hero, input_vector: Vector2) -> String:
	var command_direction := input_vector
	if command_direction.length() < 0.18:
		command_direction = _latest_command_direction(int(hero.owner_id) if hero != null and is_instance_valid(hero) else 1)
	if command_direction.length() < 0.18:
		return "normal"
	var forward := _unit_forward_vector(hero)
	if forward.length() < 0.01:
		return "normal"
	var dot := command_direction.normalized().dot(forward.normalized())
	if dot >= 0.38:
		return "armor"
	if dot <= -0.38:
		return "active"
	return "normal"


func _two_link_forward_snap_attack_state(player_id: int, hero, input_vector: Vector2) -> String:
	var command_direction := input_vector
	if command_direction.length() < 0.18:
		command_direction = _latest_command_direction(player_id)
	if command_direction.length() < 0.18:
		return "normal"
	var forward := _unit_forward_vector(hero)
	if forward.length() < 0.01:
		return "normal"
	forward = forward.normalized()
	var normalized := command_direction.normalized()
	if normalized.dot(forward) >= 0.38:
		return "armor"
	if normalized.dot(-forward) >= 0.38:
		return "active"
	return "normal"


func _attack_state_for_group(player_id: int, hero, group: Dictionary, input_vector: Vector2, fallback_state: String) -> String:
	if String(group.get("module_action_profile", "")) == "two_link_forward_snap":
		return _two_link_forward_snap_attack_state(player_id, hero, input_vector)
	return fallback_state


func _melee_command_attack_kind(player_id: int, hero, consume: bool = true, input_vector: Vector2 = Vector2.ZERO) -> String:
	var attack_state := _facing_relative_attack_state(hero, input_vector)
	if attack_state in ["active", "armor"] and consume:
		command_buffers[player_id] = []
	return attack_state


func _consume_melee_state_command(player_id: int, hero, requested_state: String, input_vector: Vector2 = Vector2.ZERO) -> bool:
	if _melee_command_attack_kind(player_id, hero, false, input_vector) != requested_state:
		return false
	command_buffers[player_id] = []
	return true


func _attack_group(hero, attack_index: int) -> Dictionary:
	return {}

func _attack_group_entries_for_key(hero, attack_index: int) -> Array:
	return []

func _unit_forward_vector(unit) -> Vector2:
	if unit != null and is_instance_valid(unit) and unit.has_method("forward_vector"):
		var forward: Vector2 = unit.forward_vector()
		if forward.length() > 0.01:
			return forward.normalized()
	if unit != null and is_instance_valid(unit):
		return Vector2(float(unit.facing), 0.0)
	return Vector2.RIGHT


func _attack_direction_for_group(hero, input_vector: Vector2, group: Dictionary) -> Vector2:
	if input_vector.length() >= 0.2:
		return input_vector.normalized()
	var lane_bias: float = float(group.get("lane_bias", 0.0))
	var forward := _unit_forward_vector(hero)
	var side := Vector2(-forward.y, forward.x)
	return (forward + side * lane_bias).normalized()


func _paired_attack_direction(hero, input_vector: Vector2, group: Dictionary, pair_index: int, pair_count: int) -> Vector2:
	if String(group.get("paired_motion", "")) != "inward_clamp":
		return _attack_direction_for_group(hero, input_vector, group)
	var forward := _unit_forward_vector(hero)
	var side := Vector2(-forward.y, forward.x)
	var lane_bias := float(group.get("lane_bias", 0.0))
	var inward_sign := -signf(lane_bias)
	if inward_sign == 0.0:
		inward_sign = 1.0 if pair_index % 2 == 0 else -1.0
	var clamp_weight := clampf(float(group.get("clamp_close_angle_degrees", 120.0)) / 180.0, 0.28, 0.95)
	var direction := (forward * (1.0 - clamp_weight * 0.38) + side * inward_sign * clamp_weight).normalized()
	if input_vector.length() >= 0.2:
		direction = direction.lerp(input_vector.normalized(), 0.18).normalized()
	return direction


func _attack_direction(hero, input_vector: Vector2) -> Vector2:
	var direction := input_vector
	if direction.length() < 0.2:
		direction = _unit_forward_vector(hero)
	return direction.normalized()


func _command_matches(player_id: int, command: String) -> bool:
	var text := _command_text(player_id)
	var aliases := {
		"236": ["236", "26"],
		"214": ["214", "24"],
		"632146": ["632146", "6246"],
	}
	if _text_matches_any(text, aliases.get(command, [command])):
		command_buffers[player_id] = []
		return true
	return false


func _command_text(player_id: int) -> String:
	var text := ""
	for token in command_buffers[player_id]:
		text += String(token)
	return text


func _text_matches_any(text: String, candidates: Array) -> bool:
	for candidate in candidates:
		if text.ends_with(String(candidate)):
			return true
	return false


func _apply_ai_attack_group_event_fields(unit, event: Dictionary, group: Dictionary, attack_index: int, attack_direction: Vector2) -> void:
	event["direction"] = attack_direction
	event["muscle_node"] = attack_index
	event["collision_group"] = group.duplicate(true)
	event["group_name"] = String(group.get("name", ATTACK_GROUP_FALLBACK[attack_index]))
	event["damage_type"] = String(group.get("damage_type", event.get("damage_type", "blunt")))
	event["material_class"] = String(group.get("melee_contact_class", group.get("material_class", "weapon")))
	var state_key := String(event.get("state", "normal"))
	var override_key := "%s_damage_override" % state_key
	var base_damage := float(event.get("damage", 1))
	if group.has(override_key):
		base_damage = float(group[override_key])
	event["damage"] = int(roundf(base_damage * float(group.get("damage_mult", 1.0))))
	event["range"] = float(event.get("range", 0.3)) * float(group.get("range_mult", 1.0))
	event["range"] = float(event["range"]) + _damage_type_range_bonus(unit.stats, String(event.get("damage_type", "blunt")))
	event["lane_range"] = float(event.get("lane_range", 0.2)) * float(group.get("lane_mult", 1.0))
	event["recoil"] = float(event.get("recoil", 0.06)) * float(group.get("recoil_mult", 1.0))
	if bool(group.get("projectile", unit.stats.get("projectile", false))):
		event["projectile"] = true
		event["material_class"] = "projectile"
		event["damage_type"] = String(group.get("projectile_damage_type", event.get("damage_type", "bullet")))
		event["projectile_style"] = String(group.get("projectile_style", _projectile_style_for_damage(String(event["damage_type"]))))
		event["projectile_behavior"] = _projectile_behavior_for_data(group)
		if String(event["projectile_behavior"]) == "bullet_hell":
			event["projectile_style"] = "bullet_hell"
			event["projectile_speed_mult"] = float(group.get("projectile_speed_mult", BULLET_HELL_DEFAULT_SPEED_MULT))
		event["travel_path"] = String(group.get("travel_path", "straight"))
		event["range"] = maxf(float(event["range"]), float(group.get("projectile_range", 2.25)))
		if String(event["projectile_behavior"]) == "true_bullet":
			event["projectile_style"] = "true_bullet"
			event["travel_path"] = "instant_line"
			event["range"] = maxf(float(event["range"]), _laser_visible_world_range(unit, attack_direction))
		if event["projectile_style"] == "missile":
			event["range"] = maxf(float(event["range"]), 3.2)
			event["lane_range"] = float(event["lane_range"]) + 0.18
			event["damage"] = int(roundf(float(event["damage"]) * 1.18))
	else:
		event["weapon_damage_coeff"] = _weapon_damage_coefficient(float(event.get("damage", base_damage)), group, state_key)
		event["joint_power"] = float(group.get("joint_power", 0.0))
		event["fixed_output_momentum"] = float(group.get("fixed_output_momentum", 0.0))
		event["limb_end_mass"] = float(group.get("limb_end_mass", group.get("terminal_weapon_mass", 0.0)))
		event["group_stiffness"] = float(group.get("group_stiffness", unit.stats.get("stiffness", 0.0)))
		event["joint_actuation_speed"] = _group_joint_actuation_speed(unit.stats, group, state_key)
		_apply_melee_module_heat(unit, event, group, attack_index)
	_copy_control_event_fields(event, group)
	if String(group.get("module_effect", "")) != "":
		_apply_module_event_fields(event, group)


func _ai_group_attack_reach(unit, group: Dictionary, action_kind: String) -> float:
	var range_key := "%s_range" % action_kind
	var reach := float(unit.stats.get(range_key, unit.stats.get("normal_range", 0.42))) * float(group.get("range_mult", 1.0))
	reach += _damage_type_range_bonus(unit.stats, String(group.get("damage_type", "blunt")))
	if bool(group.get("projectile", false)):
		reach = maxf(reach, float(group.get("projectile_range", unit.stats.get("projectile_range", reach))))
	return maxf(0.08, reach)


func _ai_best_attack_reach(unit, action_kind: String, projectiles_only: bool = false) -> float:
	var runtime_segments: Array = unit.stats.get("runtime_topology_segments", [])
	if not runtime_segments.is_empty():
		var best_runtime := 0.0
		for raw_segment in runtime_segments:
			if not (raw_segment is Dictionary):
				continue
			var segment: Dictionary = raw_segment
			if String(segment.get("part_kind", "")) == "torso":
				continue
			if projectiles_only and not bool(segment.get("projectile", false)):
				continue
			var a: Vector2 = segment.get("a_local", Vector2.ZERO) if segment.get("a_local", Vector2.ZERO) is Vector2 else Vector2.ZERO
			var b: Vector2 = segment.get("b_local", a) if segment.get("b_local", a) is Vector2 else a
			best_runtime = maxf(best_runtime, a.distance_to(b))
		return best_runtime
	return 0.0
	var groups: Array = []
	var best := 0.0
	for i in range(mini(groups.size(), ATTACK_GROUP_COUNT)):
		var group: Dictionary = _attack_group(unit, i)
		if projectiles_only and not bool(group.get("projectile", false)):
			continue
		if bool(group.get("non_damage", false)) and not bool(group.get("projectile", false)):
			continue
		best = maxf(best, _ai_group_attack_reach(unit, group, action_kind))
	return best


func _ai_has_projectile_attack(unit) -> bool:
	for raw_segment in Array(unit.stats.get("runtime_topology_segments", [])):
		if raw_segment is Dictionary and bool(Dictionary(raw_segment).get("projectile", false)):
			return true
	return false


func _ai_attack_group_choice(unit, target, action_kind: String) -> Dictionary:
	var groups: Array = []
	return {"index": -1, "group": {}}
	var to_target := Vector2(_ring_delta(unit.ring_pos, target.ring_pos), target.lane - unit.lane)
	var target_lane := clampf(to_target.y / maxf(0.12, float(unit.stats.get("radius", 0.24)) * 2.0), -1.0, 1.0)
	var best_index := 0
	var best_score := 999999.0
	for prefer_damage in [true, false]:
		for i in range(mini(groups.size(), ATTACK_GROUP_COUNT)):
			var group: Dictionary = _attack_group(unit, i)
			if prefer_damage and bool(group.get("non_damage", false)):
				continue
			var reach := _ai_group_attack_reach(unit, group, action_kind)
			var range_score := maxf(0.0, to_target.length() - reach) * 1.4
			var lane_score := absf(float(group.get("lane_bias", 0.0)) - target_lane) / maxf(0.55, float(group.get("lane_mult", 1.0)))
			if absf(to_target.y) < 0.04:
				lane_score *= 0.45
			var projectile_adjust := 0.0
			if bool(group.get("projectile", false)):
				var melee_reach := float(unit.stats.get("%s_range" % action_kind, unit.stats.get("normal_range", 0.42)))
				projectile_adjust = -0.55 if to_target.length() > melee_reach * 1.15 else 0.08
			var score := lane_score + range_score + projectile_adjust
			if score < best_score:
				best_score = score
				best_index = i
		if best_score < 999998.0:
			break
	return {"index": best_index, "group": _attack_group(unit, best_index)}


func _update_ai_player(player_id: int, delta: float) -> void:
	var buy_timer := float(ai_buy_timers.get(player_id, 0.0)) - delta
	if buy_timer <= 0.0:
		buy_timer = 2.4 - float(ai_difficulty) * 0.45
		_ai_try_summon_from_sortie(player_id)
	ai_buy_timers[player_id] = buy_timer

	var ai_hero = active_units[player_id]["hero"]
	if not _is_live_unit(ai_hero):
		return
	var target = _nearest_enemy(ai_hero, player_id)
	if not _is_live_unit(target):
		return

	var target_delta := _mobius_delta_vec_between(ai_hero, target)
	var delta_ring: float = target_delta.x
	var delta_lane: float = target_delta.y
	var to_target := Vector2(delta_ring, delta_lane)
	var distance_2d := to_target.length()
	var approach_dir := to_target.normalized() if distance_2d > 0.01 else _unit_forward_vector(ai_hero)
	var strafe_dir := Vector2(-approach_dir.y, approach_dir.x)
	var orbit_phase := float(ai_hero.get_meta("ai_orbit_phase", randf() * TAU)) + delta * (1.1 + float(ai_difficulty) * 0.22)
	ai_hero.set_meta("ai_orbit_phase", fmod(orbit_phase, TAU))
	var melee_desired_range := maxf(0.42, float(ai_hero.stats.get("normal_range", 0.58)) * 0.78)
	var projectile_reach := _ai_best_attack_reach(ai_hero, "normal", true)
	var desired_range := melee_desired_range
	if projectile_reach > melee_desired_range:
		desired_range = clampf(projectile_reach * 0.68, melee_desired_range, projectile_reach * 0.9)
	var move := Vector2.ZERO
	if distance_2d > desired_range * 1.16:
		move += approach_dir
	elif distance_2d < desired_range * 0.58:
		move -= approach_dir * 0.85
	else:
		move += approach_dir * 0.18
	move += strafe_dir * sin(orbit_phase) * 0.86
	if absf(delta_lane) < 0.28:
		move.y += cos(orbit_phase * 0.73) * 0.62
	move = move.limit_length(1.0)
	var blind_strength := _unit_blind_strength(ai_hero)
	if blind_strength > 0.08:
		move = (_blind_escape_vector(ai_hero) + Vector2(-signf(delta_ring) * 0.28, 0.0)).limit_length(1.0)
	if absf(delta_ring) > 0.08:
		if ai_hero.has_method("request_facing"):
			ai_hero.request_facing(1 if delta_ring > 0.0 else -1)
		else:
			ai_hero.facing = 1 if delta_ring > 0.0 else -1
	if ai_hero.has_method("move_by_gameplay"):
		ai_hero.move_by_gameplay(move, delta, RING_LENGTH)
	else:
		ai_hero.move_by(move, delta, RING_LENGTH)

	var action_timer := float(ai_action_timers.get(player_id, 0.0)) - delta
	if action_timer <= 0.0:
		action_timer = 0.42 - float(ai_difficulty) * 0.07
		ai_action_timers[player_id] = action_timer
		if blind_strength > 0.22:
			return
		var distance: float = distance_2d
		var lane_distance: float = absf(delta_lane)
		var attack_direction := Vector2(delta_ring, delta_lane)
		if attack_direction.length() <= 0.01:
			attack_direction = _unit_forward_vector(ai_hero)
		attack_direction = attack_direction.normalized()
		var skill_state: String = String(ai_hero.stats.get("skill_state", "active"))
		var skill_reach := _ai_best_attack_reach(ai_hero, skill_state)
		var normal_reach := _ai_best_attack_reach(ai_hero, "normal")
		var has_projectile := _ai_has_projectile_attack(ai_hero)
		var skill_lane_limit := maxf(0.42, float(ai_hero.stats.get("%s_lane_range" % skill_state, 0.34)))
		var normal_lane_limit := maxf(0.38, float(ai_hero.stats.get("normal_lane_range", 0.3)))
		if has_projectile:
			skill_lane_limit = maxf(skill_lane_limit, BATTLE_HALF_HEIGHT * 2.0)
			normal_lane_limit = maxf(normal_lane_limit, BATTLE_HALF_HEIGHT * 2.0)
		if distance <= skill_reach and lane_distance <= skill_lane_limit and ai_hero.heat < float(ai_hero.stats.get("heat_capacity", 100.0)) * 0.68:
			var skill_choice: Dictionary = _ai_attack_group_choice(ai_hero, target, skill_state)
			var skill_index := int(skill_choice.get("index", 0))
			var skill_group: Dictionary = skill_choice.get("group", _attack_group(ai_hero, skill_index))
			var skill_event: Dictionary = _begin_unit_module_action(ai_hero, skill_state, skill_group, skill_index)
			if not skill_event.is_empty():
				_apply_ai_attack_group_event_fields(ai_hero, skill_event, skill_group, skill_index, attack_direction)
				if ai_hero.has_method("mark_part_action"):
					ai_hero.mark_part_action(skill_index, attack_direction, String(skill_event.get("state", skill_state)), float(ai_hero.state_timer))
				_resolve_attack(ai_hero, skill_event)
		elif distance <= normal_reach and lane_distance <= normal_lane_limit:
			var normal_choice: Dictionary = _ai_attack_group_choice(ai_hero, target, "normal")
			var normal_index := int(normal_choice.get("index", 0))
			var normal_group: Dictionary = normal_choice.get("group", _attack_group(ai_hero, normal_index))
			var normal_event: Dictionary = _begin_unit_module_action(ai_hero, "normal", normal_group, normal_index)
			if not normal_event.is_empty():
				_apply_ai_attack_group_event_fields(ai_hero, normal_event, normal_group, normal_index, attack_direction)
				if ai_hero.has_method("mark_part_action"):
					ai_hero.mark_part_action(normal_index, attack_direction, String(normal_event.get("state", "normal")), float(ai_hero.state_timer))
				_resolve_attack(ai_hero, normal_event)
	else:
		ai_action_timers[player_id] = action_timer


func _ai_try_summon_from_sortie(player_id: int) -> bool:
	var order := _team_sortie_order(player_id)
	if order.is_empty():
		return false
	var priority: Array = []
	if not _is_live_unit(active_units[player_id]["hero"]) and not _role_pending(player_id, "hero"):
		priority.append("hero")
	if _live_unit_count(active_units[player_id]["puppet"]) == 0 and not _role_pending(player_id, "puppet"):
		priority.append("puppet")
	if not _is_live_unit(active_units[player_id]["barrier"]) and not _role_pending(player_id, "barrier"):
		priority.append("barrier")
	for desired_role in priority:
		for entry in order:
			var role_key := String(Dictionary(entry).get("role", "hero"))
			if role_key != desired_role:
				continue
			var unit_index := int(Dictionary(entry).get("index", 0))
			var stats := _compute_unit_stats(player_id, role_key, unit_index)
			var cost := _discounted_deploy_cost(player_id, role_key, unit_index, int(stats.get("deploy_cost", 0)))
			if float(runtime_resource[player_id]) < float(cost):
				continue
			active_roster_indices[player_id][role_key] = unit_index
			return _summon_role(player_id, role_key, false, false, false)
	return false


func _update_anti_stall_summons(delta: float) -> void:
	for player_id in [1, 2]:
		auto_mech_summon_timers[player_id] = maxf(0.0, float(auto_mech_summon_timers.get(player_id, 0.0)) - delta)
		hero_idle_puppet_summon_timers[player_id] = maxf(0.0, float(hero_idle_puppet_summon_timers.get(player_id, 0.0)) - delta)
		if not _player_has_live_mech(player_id) and not _player_has_pending_mech(player_id):
			if float(auto_mech_summon_timers[player_id]) <= 0.0:
				if _auto_summon_first_affordable_sortie_role(player_id, ["hero", "puppet"], "no_mech"):
					auto_mech_summon_timers[player_id] = AUTO_MECH_SUMMON_COOLDOWN
				else:
					auto_mech_summon_timers[player_id] = AUTO_MECH_SUMMON_COOLDOWN
		var hero = active_units[player_id]["hero"] if active_units.has(player_id) else null
		if _is_live_unit(hero) and bool(hero.stats.get("has_soul", false)):
			var now := Time.get_ticks_msec() * 0.001
			var last_attack := float(hero.get_meta("last_attack_time", now))
			if now - last_attack >= HERO_IDLE_PUPPET_SUMMON_SECONDS and float(hero_idle_puppet_summon_timers[player_id]) <= 0.0:
				if _auto_summon_first_affordable_sortie_role(player_id, ["puppet"], "soul_idle"):
					hero.set_meta("last_attack_time", now)
				hero_idle_puppet_summon_timers[player_id] = HERO_IDLE_PUPPET_SUMMON_COOLDOWN


func _player_has_live_mech(player_id: int) -> bool:
	if not active_units.has(player_id):
		return false
	if _is_live_unit(active_units[player_id]["hero"]):
		return true
	return _live_primary_puppet_count(player_id) > 0


func _player_has_pending_mech(player_id: int) -> bool:
	return _role_pending(player_id, "hero") or _role_pending(player_id, "puppet")


func _role_available_for_auto_summon(player_id: int, role_key: String) -> bool:
	if not ROLE_ORDER.has(role_key) or not active_units.has(player_id):
		return false
	if _role_pending(player_id, role_key):
		return false
	if role_key == "puppet":
		return _live_primary_puppet_count(player_id) <= 0
	return not _is_live_unit(active_units[player_id][role_key])


func _auto_summon_first_affordable_sortie_role(player_id: int, role_filter: Array, reason: String = "") -> bool:
	for raw_entry in _team_sortie_order(player_id):
		if not (raw_entry is Dictionary):
			continue
		var entry: Dictionary = Dictionary(raw_entry)
		if not _valid_roster_entry(player_id, entry):
			continue
		var role_key := String(entry.get("role", "hero"))
		if not role_filter.has(role_key):
			continue
		if not _role_available_for_auto_summon(player_id, role_key):
			continue
		var unit_index := int(entry.get("index", 0))
		var stats := _compute_unit_stats(player_id, role_key, unit_index)
		var base_cost := int(stats.get("deploy_cost", stats.get("cost", 0)))
		var deploy_cost := _discounted_deploy_cost(player_id, role_key, unit_index, base_cost)
		if float(runtime_resource.get(player_id, 0.0)) < float(deploy_cost):
			continue
		var previous_index := int(active_roster_indices[player_id].get(role_key, 0))
		active_roster_indices[player_id][role_key] = unit_index
		var accepted := _summon_role(player_id, role_key, false, false, false)
		if accepted:
			if reason == "no_mech":
				_show_battle_message("P%d 场上无机甲：自动呼叫 %s #%d" % [player_id, _role_name(role_key), unit_index + 1] if _ui_is_zh() else "P%d no mech online: auto-calling %s #%d" % [player_id, _role_name(role_key), unit_index + 1], 1.0)
			elif reason == "soul_idle":
				_show_battle_message("P%d 英魂10秒未攻击：自动呼叫傀儡 #%d" % [player_id, unit_index + 1] if _ui_is_zh() else "P%d soul idle 10s: auto-calling puppet #%d" % [player_id, unit_index + 1], 1.0)
			return true
		active_roster_indices[player_id][role_key] = previous_index
	return false


func _update_training_dummy(delta: float) -> void:
	var dummy_player := 1 if ai_battle_seat == 2 else 2
	var dummy = active_units[dummy_player]["hero"]
	if _is_live_unit(dummy):
		dummy.set_meta("training_static_dummy", true)
		if training_dummy_state == "fixed":
			dummy.velocity = Vector2.ZERO
			dummy.angular_velocity = 0.0
			dummy.tick(delta, RING_LENGTH)
		else:
			dummy.tick(delta, RING_LENGTH)
		if training_dummy_state == "idle_brake":
			_apply_training_dummy_auto_brake(dummy, delta)
		return
	training_respawn_timer -= delta
	if training_respawn_timer <= 0.0:
		_summon_role(dummy_player, "hero", true)
		_show_battle_message("训练球体靶机已恢复。" if _ui_is_zh() else "Training ball dummy restored.", 1.0)


func _apply_training_dummy_auto_brake(dummy, delta: float) -> void:
	if not _is_live_unit(dummy) or delta <= 0.0:
		return
	var speed: float = dummy.velocity.length()
	if speed > 0.001:
		var mass := maxf(0.1, float(dummy.stats.get("mass", 1.0)))
		var duration := maxf(0.08, float(dummy.stats.get("boost_duration", 0.3)))
		var brake_delta := maxf(0.0, float(dummy.stats.get("brake_power", 0.0)))
		if bool(dummy.stats.get("training_ball_dummy", false)):
			brake_delta = brake_delta / mass
		if brake_delta <= 0.0:
			brake_delta = maxf(0.0, float(dummy.stats.get("move_momentum", 0.0))) / mass
		var brake_accel := brake_delta / duration
		if brake_accel > 0.0001:
			var next_speed := move_toward(speed, 0.0, brake_accel * delta)
			dummy.velocity = dummy.velocity.normalized() * next_speed if next_speed > 0.001 else Vector2.ZERO
	if absf(float(dummy.angular_velocity)) > 0.001:
		var turn_brake := maxf(0.1, float(dummy.stats.get("turn_speed", 0.0)) + float(dummy.stats.get("turn_command_rate", 0.0)))
		dummy.angular_velocity = move_toward(float(dummy.angular_velocity), 0.0, turn_brake * delta)


func _summon_role(player_id: int, role_key: String, free: bool, immediate: bool = false, alarm: bool = true) -> bool:
	var existing = active_units[player_id][role_key]
	if role_key == "puppet":
		if _live_primary_puppet_count(player_id) > 0:
			if alarm:
				_illegal_summon_feedback(player_id, "P%d 已有傀儡组在场" % player_id if _ui_is_zh() else "P%d already has a puppet group online" % player_id)
			return false
	elif _is_live_unit(existing):
		if alarm:
			_illegal_summon_feedback(player_id, "P%d %s 已在场" % [player_id, _role_name(role_key)] if _ui_is_zh() else "P%d %s already online" % [player_id, _role_name(role_key)])
		return false
	if _role_pending(player_id, role_key):
		if alarm:
			_illegal_summon_feedback(player_id, "P%d %s 正在等待入场" % [player_id, _role_name(role_key)] if _ui_is_zh() else "P%d %s deploy is already pending" % [player_id, _role_name(role_key)])
		return false

	var stats := _compute_unit_stats(player_id, role_key)
	var unit_index := int(stats.get("unit_index", active_roster_indices[player_id].get(role_key, 0)))
	var base_deploy_cost: int = int(stats["deploy_cost"])
	var deploy_cost: int = _discounted_deploy_cost(player_id, role_key, unit_index, base_deploy_cost)
	var summon_spawn := _spawn_for_selected_portal(player_id, role_key, stats)
	if role_key == "barrier" and not _barrier_entry_legal(player_id, stats, summon_spawn) and int(stats.get("entry_breach_damage", 0)) <= 0:
		if alarm:
			_illegal_summon_feedback(player_id, "结界入场受阻：先摧毁重叠的敌方结界组件" if _ui_is_zh() else "BARRIER ENTRY BLOCKED: destroy overlapping enemy barrier pieces")
		return false
	if not free and float(runtime_resource[player_id]) < float(deploy_cost):
		_show_battle_message("P%d 需要 %d 资源" % [player_id, deploy_cost] if _ui_is_zh() else "P%d needs %d resource" % [player_id, deploy_cost], 0.9)
		if alarm:
			_play_illegal_summon_sfx()
		return false
	if not free:
		runtime_resource[player_id] = float(runtime_resource[player_id]) - float(deploy_cost)
	if not immediate:
		var wait_time := maxf(0.4, float(stats.get("deploy_wait", DEPLOY_WAIT_SECONDS)))
		pending_deploys[player_id][role_key] = wait_time
		_store_pending_deploy_snapshot(player_id, role_key, summon_spawn, stats, unit_index, wait_time)
		if role_key == "barrier":
			_spawn_pending_barrier_preview(player_id, role_key, summon_spawn, stats)
		var cost_note := " 消耗 %d" % deploy_cost if _ui_is_zh() else " cost %d" % deploy_cost
		if deploy_cost < base_deploy_cost:
			cost_note = " 折扣 %d<%d" % [deploy_cost, base_deploy_cost] if _ui_is_zh() else " discount %d<%d" % [deploy_cost, base_deploy_cost]
		_show_battle_message("P%d %s %.1fs 后入场%s" % [player_id, _role_name(role_key), wait_time, cost_note] if _ui_is_zh() else "P%d %s entering in %.1fs%s" % [player_id, _role_name(role_key), wait_time, cost_note], 0.85)
		return true

	return _finish_summon_role(player_id, role_key)


func _finish_summon_role(player_id: int, role_key: String) -> bool:
	var existing = active_units[player_id][role_key]
	if role_key == "puppet":
		if _live_primary_puppet_count(player_id) > 0:
			return false
	elif _is_live_unit(existing):
		return false

	var pending_snapshot := _pending_deploy_snapshot(player_id, role_key)
	if pending_snapshot.has("unit_index"):
		active_roster_indices[player_id][role_key] = int(pending_snapshot.get("unit_index", active_roster_indices[player_id].get(role_key, 0)))
	var stats := _compute_unit_stats(player_id, role_key)
	var spawn := pending_snapshot if pending_snapshot.has("ring") and pending_snapshot.has("lane") else _spawn_for_selected_portal(player_id, role_key, stats)
	if role_key == "barrier" and not _barrier_entry_legal(player_id, stats, spawn):
		if not _try_force_barrier_entry(player_id, stats, spawn):
			_illegal_summon_feedback(player_id, "结界入场受阻：先摧毁重叠的敌方结界组件" if _ui_is_zh() else "BARRIER ENTRY BLOCKED: destroy overlapping enemy barrier pieces")
			return false

	var spawn_ring: float = float(spawn["ring"])
	var spawn_lane: float = float(spawn["lane"])

	if role_key == "puppet":
		var count: int = int(stats.get("group_count", 2))
		var group: Array = []
		var exception_group := _live_temporary_fracture_puppets(player_id)
		for i in range(count):
			var offset: float = (float(i) - float(count - 1) * 0.5) * 0.12
			var puppet_name := "P%d 傀儡 %d" % [player_id, i + 1] if _ui_is_zh() else "P%d PUPPET %d" % [player_id, i + 1]
			var unit = _create_unit(player_id, role_key, stats, puppet_name, wrapf(spawn_ring + offset, 0.0, RING_LENGTH), clampf(spawn_lane + offset * 0.7, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT))
			unit.set_meta("puppet_group_size", count)
			unit.set_meta("puppet_group_slot", i)
			group.append(unit)
		for i in range(exception_group.size()):
			var fragment = exception_group[i]
			if _is_live_unit(fragment):
				fragment.set_meta("puppet_group_slot", count + i)
				fragment.set_meta("puppet_group_size", count + exception_group.size())
				group.append(fragment)
		active_units[player_id][role_key] = group
		_apply_entry_grant(player_id, stats)
	else:
		var unit_name: String = "P%d %s" % [player_id, String(stats.get("name", _role_name(role_key)))]
		active_units[player_id][role_key] = _create_unit(player_id, role_key, stats, unit_name, spawn_ring, spawn_lane)
		_apply_entry_grant(player_id, stats)
		if role_key == "barrier":
			var barrier = active_units[player_id][role_key]
			barrier.set_meta("phase_in_timer", 0.18)
			barrier.set_meta("phase_push_timer", 0.18)
			_push_overlapping_mechs_from_barrier(barrier, player_id)

	_clear_pending_deploy_preview(player_id, role_key)
	_clear_pending_deploy_snapshot(player_id, role_key)
	_mark_sortie_unit_deployed(player_id, role_key, int(stats.get("unit_index", active_roster_indices[player_id].get(role_key, 0))))
	return true


func _apply_entry_grant(player_id: int, stats: Dictionary) -> void:
	var grant := int(stats.get("entry_grant", 0))
	if grant <= 0:
		return
	runtime_resource[player_id] = float(runtime_resource.get(player_id, 0.0)) + float(grant)
	_show_battle_message("P%d ADVANCE CAPITAL ENTRY +%d" % [player_id, grant], 0.85)


func _initialize_sortie_price_state() -> void:
	sortie_price_state = {1: {}, 2: {}}
	for player_id in [1, 2]:
		var player_state := {}
		for entry in _team_sortie_order(player_id):
			player_state[_entry_ref(entry)] = {
				"timer": 0.0,
				"deployed": false,
				"mult": 1.0,
			}
		sortie_price_state[player_id] = player_state


func _tick_sortie_price_discounts(delta: float) -> void:
	if game_state != STATE_BATTLE:
		return
	for player_id in [1, 2]:
		if not sortie_price_state.has(player_id):
			sortie_price_state[player_id] = {}
		var player_state: Dictionary = sortie_price_state[player_id]
		for entry in _team_sortie_order(player_id):
			var ref := _entry_ref(entry)
			var state: Dictionary = player_state.get(ref, {"timer": 0.0, "deployed": false, "mult": 1.0})
			var timer := float(state.get("timer", 0.0)) + delta
			var delay := SORTIE_REDEPLOY_DISCOUNT_DELAY if bool(state.get("deployed", false)) else SORTIE_RESERVE_DISCOUNT_DELAY
			var effective_time := maxf(0.0, timer - delay)
			var progress := clampf(effective_time / SORTIE_DISCOUNT_RAMP_SECONDS, 0.0, 1.0)
			var accelerated := pow(progress, SORTIE_DISCOUNT_ACCEL_POWER)
			state["timer"] = timer
			state["mult"] = lerpf(1.0, SORTIE_MIN_DEPLOY_COST_MULT, accelerated)
			player_state[ref] = state
		sortie_price_state[player_id] = player_state


func _mark_sortie_unit_deployed(player_id: int, role_key: String, unit_index: int) -> void:
	if not sortie_price_state.has(player_id):
		return
	var ref := _unit_ref(role_key, unit_index)
	var player_state: Dictionary = sortie_price_state[player_id]
	if not player_state.has(ref):
		return
	var state: Dictionary = player_state[ref]
	state["deployed"] = true
	state["timer"] = 0.0
	state["mult"] = 1.0
	player_state[ref] = state
	sortie_price_state[player_id] = player_state
	_flash_sortie_thumbnail(player_id, role_key, unit_index)


func _sortie_discount_multiplier(player_id: int, role_key: String, unit_index: int) -> float:
	if game_state != STATE_BATTLE or not sortie_price_state.has(player_id):
		return 1.0
	var player_state: Dictionary = sortie_price_state[player_id]
	var state: Dictionary = player_state.get(_unit_ref(role_key, unit_index), {})
	return clampf(float(state.get("mult", 1.0)), SORTIE_MIN_DEPLOY_COST_MULT, 1.0)


func _discounted_deploy_cost(player_id: int, role_key: String, unit_index: int, base_cost: int) -> int:
	if base_cost <= 0:
		return 0
	return maxi(1, int(ceilf(float(base_cost) * _sortie_discount_multiplier(player_id, role_key, unit_index))))


func _empty_pending_deploy_data() -> Dictionary:
	return {
		1: {"hero": {}, "puppet": {}, "barrier": {}},
		2: {"hero": {}, "puppet": {}, "barrier": {}},
	}


func _pending_deploy_preview_key(player_id: int, role_key: String) -> String:
	return "%d:%s" % [player_id, role_key]


func _store_pending_deploy_snapshot(player_id: int, role_key: String, spawn: Dictionary, stats: Dictionary, unit_index: int, wait_time: float) -> void:
	if not pending_deploy_data.has(player_id):
		pending_deploy_data[player_id] = {"hero": {}, "puppet": {}, "barrier": {}}
	var snapshot := {
		"ring": wrapf(float(spawn.get("ring", 0.0)), 0.0, RING_LENGTH),
		"lane": clampf(float(spawn.get("lane", 0.0)), -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT),
		"unit_index": unit_index,
		"unit_name": String(stats.get("name", _role_name(role_key))),
		"wait_time": wait_time,
	}
	pending_deploy_data[player_id][role_key] = snapshot


func _pending_deploy_snapshot(player_id: int, role_key: String) -> Dictionary:
	if not pending_deploy_data.has(player_id):
		return {}
	var by_role: Dictionary = pending_deploy_data[player_id]
	var snapshot = by_role.get(role_key, {})
	return snapshot if snapshot is Dictionary else {}


func _clear_pending_deploy_snapshot(player_id: int, role_key: String) -> void:
	if not pending_deploy_data.has(player_id):
		return
	pending_deploy_data[player_id][role_key] = {}


func _spawn_pending_barrier_preview(player_id: int, role_key: String, spawn: Dictionary, stats: Dictionary) -> void:
	_clear_pending_deploy_preview(player_id, role_key)
	if effects_root == null:
		return
	var preview := FieldAuraEffect.new()
	var radius := maxf(0.72, float(stats.get("space_size", stats.get("aura_range", stats.get("radius", 0.8)))))
	preview.setup(player_id, "one_way_shield", radius, 1.4)
	preview.modulate = Color(1.0, 1.0, 1.0, 0.62)
	effects_root.add_child(preview)
	pending_deploy_previews[_pending_deploy_preview_key(player_id, role_key)] = preview
	var screen := _screen_from_ring(float(spawn.get("ring", 0.0)), float(spawn.get("lane", 0.0)))
	preview.update_screen(screen["position"], bool(screen["visible"]), 0.0)


func _clear_pending_deploy_preview(player_id: int, role_key: String) -> void:
	var key := _pending_deploy_preview_key(player_id, role_key)
	if not pending_deploy_previews.has(key):
		return
	var preview = pending_deploy_previews[key]
	pending_deploy_previews.erase(key)
	if preview != null and is_instance_valid(preview):
		preview.queue_free()


func _update_pending_deploy_preview(player_id: int, role_key: String, delta: float) -> void:
	var key := _pending_deploy_preview_key(player_id, role_key)
	if not pending_deploy_previews.has(key):
		return
	var preview = pending_deploy_previews[key]
	if preview == null or not is_instance_valid(preview):
		pending_deploy_previews.erase(key)
		return
	var snapshot := _pending_deploy_snapshot(player_id, role_key)
	if not snapshot.has("ring") or not snapshot.has("lane"):
		_clear_pending_deploy_preview(player_id, role_key)
		return
	var screen := _screen_from_ring(float(snapshot["ring"]), float(snapshot["lane"]))
	preview.update_screen(screen["position"], bool(screen["visible"]), delta)


func _sortie_discount_status(player_id: int, max_items: int = 3) -> String:
	var order := _team_sortie_order(player_id)
	var pieces: Array = []
	var limit := mini(max_items, order.size())
	for i in range(limit):
		var entry: Dictionary = order[i]
		pieces.append("%d:%s" % [i + 1, _sortie_entry_label(player_id, entry, true)])
	return " ".join(pieces)


func _tick_deploys(delta: float) -> void:
	for player_id in [1, 2]:
		for role_key in ROLE_ORDER:
			var timer: float = float(pending_deploys[player_id][role_key])
			if timer <= 0.0:
				continue
			_update_pending_deploy_preview(player_id, role_key, delta)
			timer -= delta
			if timer <= 0.0:
				pending_deploys[player_id][role_key] = 0.0
				var finished := _finish_summon_role(player_id, role_key)
				if finished:
					_show_battle_message("P%d %s online" % [player_id, _role_name(role_key)], 0.8)
				else:
					_clear_pending_deploy_preview(player_id, role_key)
					_clear_pending_deploy_snapshot(player_id, role_key)
			else:
				pending_deploys[player_id][role_key] = timer


func _barrier_entry_legal(player_id: int, stats: Dictionary, spawn: Dictionary = {}) -> bool:
	return _barrier_entry_blocker(player_id, stats, spawn) == null


func _barrier_has_map_tiles(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	if String(unit.role) != "barrier":
		return false
	return Array(unit.stats.get("barrier_map_tiles", [])).size() > 0


func _barrier_tile_axis(tile: Dictionary) -> Vector2:
	match String(tile.get("orientation", "horizontal")):
		"vertical":
			return Vector2(0.0, 1.0)
		"diagonal_pos":
			return Vector2(1.0, 0.74).normalized()
		"diagonal_neg":
			return Vector2(1.0, -0.74).normalized()
	return Vector2(1.0, 0.0)


func _barrier_tile_world_position(barrier, tile: Dictionary, wrapped: bool = true) -> Vector2:
	var ring_value := float(barrier.ring_pos) + float(tile.get("local_ring", 0.0))
	if wrapped:
		ring_value = wrapf(ring_value, 0.0, RING_LENGTH)
	var lane_value := clampf(float(barrier.lane) + float(tile.get("local_lane", 0.0)), -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	return Vector2(ring_value, lane_value)


func _barrier_tile_collider_at(center_ring: float, center_lane: float, tile: Dictionary) -> Dictionary:
	var center := Vector2(center_ring + float(tile.get("local_ring", 0.0)), clampf(center_lane + float(tile.get("local_lane", 0.0)), -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT))
	var radius := maxf(0.035, float(tile.get("radius", 0.08)))
	var length := maxf(0.06, float(tile.get("length", 0.28)))
	var shape := String(tile.get("shape", "barrier_tile"))
	if shape.contains("question") or shape.contains("cache") or shape.contains("field") or shape.contains("hatchery"):
		return {
			"shape": "circle",
			"part_kind": "barrier_tile",
			"part_index": int(tile.get("index", -1)),
			"name": String(tile.get("name", "BARRIER TILE")),
			"center": center,
			"radius": maxf(radius, length * 0.28),
			"mass": float(tile.get("mass", 1.0)),
			"material_class": String(tile.get("material_class", "barrier_wall")),
			"damage_type": String(tile.get("damage_type", "blunt")),
			"contact_damage": float(tile.get("contact_damage", tile.get("cage_damage", 2.0))),
			"momentum_threshold": float(tile.get("momentum_threshold", 0.0)),
		}
	var axis := _barrier_tile_axis(tile)
	return {
		"shape": "capsule",
		"part_kind": "barrier_tile",
		"part_index": int(tile.get("index", -1)),
		"name": String(tile.get("name", "BARRIER TILE")),
		"a": center - axis * length * 0.5,
		"b": center + axis * length * 0.5,
		"radius": radius,
		"mass": float(tile.get("mass", 1.0)),
		"material_class": String(tile.get("material_class", "barrier_wall")),
		"damage_type": String(tile.get("damage_type", "blunt")),
		"contact_damage": float(tile.get("contact_damage", tile.get("cage_damage", 2.0))),
		"momentum_threshold": float(tile.get("momentum_threshold", 0.0)),
	}


func _barrier_colliders_from_stats(stats: Dictionary, center_ring: float, center_lane: float) -> Array:
	var colliders: Array = []
	for raw_tile in Array(stats.get("barrier_map_tiles", [])):
		if raw_tile is Dictionary:
			var tile: Dictionary = raw_tile
			colliders.append(_barrier_tile_collider_at(center_ring, center_lane, tile))
	return colliders


func _barrier_visible_tile_positions(barrier) -> Array:
	var positions: Array = []
	if not _barrier_has_map_tiles(barrier):
		return positions
	for raw_tile in Array(barrier.stats.get("barrier_map_tiles", [])):
		if raw_tile is Dictionary:
			var tile: Dictionary = raw_tile
			positions.append(_barrier_tile_world_position(barrier, tile, true))
	return positions


func _barrier_has_visible_tile(barrier) -> bool:
	for tile_pos in _barrier_visible_tile_positions(barrier):
		if tile_pos is Vector2:
			var screen := _screen_from_ring(float(tile_pos.x), float(tile_pos.y))
			if bool(screen.get("visible", false)):
				return true
	return false


func _unit_is_anchored_barrier(unit) -> bool:
	return _barrier_has_map_tiles(unit) and not bool(unit.get_meta("space_debris", false)) and not bool(unit.get_meta("detached_barrier_piece", false))


func _barrier_tile_by_index(barrier, tile_index: int) -> Dictionary:
	if barrier == null or not is_instance_valid(barrier):
		return {}
	for raw_tile in Array(barrier.stats.get("barrier_map_tiles", [])):
		if raw_tile is Dictionary:
			var tile: Dictionary = raw_tile
			if int(tile.get("index", -1)) == tile_index:
				return tile.duplicate(true)
	return {}


func _remove_barrier_tile_by_index(barrier, tile_index: int) -> bool:
	if barrier == null or not is_instance_valid(barrier):
		return false
	var next_tiles: Array = []
	var removed := false
	for raw_tile in Array(barrier.stats.get("barrier_map_tiles", [])):
		if not (raw_tile is Dictionary):
			continue
		var tile: Dictionary = raw_tile
		if int(tile.get("index", -1)) == tile_index and not removed:
			removed = true
			continue
		next_tiles.append(tile)
	if removed:
		barrier.stats["barrier_map_tiles"] = next_tiles
		barrier.stats["barrier_tile_count"] = next_tiles.size()
		if barrier.has_method("_refresh_visuals"):
			barrier._refresh_visuals()
	return removed


func _barrier_tile_momentum_threshold(barrier, tile: Dictionary) -> float:
	var mass := maxf(0.05, float(tile.get("mass", 1.0)))
	if float(tile.get("momentum_threshold", 0.0)) > 0.0:
		return float(tile["momentum_threshold"])
	var coeff := maxf(0.08, float(barrier.stats.get("ether_momentum_threshold_coeff", BARRIER_DEFAULT_MOMENTUM_THRESHOLD_COEFF)))
	return mass * coeff


func _barrier_tile_impact_direction(attacker, event: Dictionary, fallback_direction: Vector2) -> Vector2:
	var momentum_vector := _event_vector_value(event, "momentum_vector")
	if momentum_vector.length() > 0.01:
		return momentum_vector.normalized()
	if event.has("direction") and event["direction"] is Vector2:
		var event_direction: Vector2 = event["direction"]
		if event_direction.length() > 0.01:
			return event_direction.normalized()
	if fallback_direction.length() > 0.01:
		return fallback_direction.normalized()
	if attacker != null and is_instance_valid(attacker):
		if attacker.velocity.length() > 0.01:
			return attacker.velocity.normalized()
		return _unit_forward_vector(attacker)
	return Vector2.RIGHT


func _maybe_detach_barrier_tile_from_momentum(attacker, barrier, event: Dictionary, fallback_direction: Vector2, momentum: float) -> bool:
	if not _unit_is_anchored_barrier(barrier):
		return false
	if String(event.get("target_part_kind", "")) != "barrier_tile":
		return false
	var tile_index := int(event.get("target_part_index", -1))
	if tile_index < 0:
		return false
	var tile := _barrier_tile_by_index(barrier, tile_index)
	if tile.is_empty():
		return false
	var threshold := _barrier_tile_momentum_threshold(barrier, tile)
	event["barrier_tile_momentum_threshold"] = threshold
	if momentum < threshold:
		return false
	var world_pos := _barrier_tile_world_position(barrier, tile, true)
	if not _remove_barrier_tile_by_index(barrier, tile_index):
		return false
	var direction := _barrier_tile_impact_direction(attacker, event, fallback_direction)
	var mass := maxf(0.05, float(tile.get("mass", 1.0)))
	var speed := clampf(BARRIER_DEBRIS_MIN_SPEED + (momentum - threshold) / mass * 0.08 + momentum / maxf(1.0, mass + threshold) * 0.65, BARRIER_DEBRIS_MIN_SPEED, BARRIER_DEBRIS_MAX_SPEED)
	_spawn_space_debris_from_barrier_tile(int(barrier.owner_id), tile, world_pos, direction, speed, attacker.velocity if attacker != null and is_instance_valid(attacker) else Vector2.ZERO)
	_spawn_hit_effect(barrier, 2, "blunt", false, "impact")
	_show_battle_message("%s -> %s" % [String(tile.get("name", "BARRIER TILE")), "太空垃圾" if _ui_is_zh() else "SPACE DEBRIS"], 0.72)
	return true


func _spawn_space_debris_from_barrier_tile(origin_owner: int, tile: Dictionary, world_pos: Vector2, direction: Vector2, speed: float, source_velocity: Vector2):
	var debris_tile := tile.duplicate(true)
	debris_tile["index"] = 0
	debris_tile["local_ring"] = 0.0
	debris_tile["local_lane"] = 0.0
	debris_tile["name"] = "太空垃圾" if _ui_is_zh() else "SPACE DEBRIS"
	debris_tile["material_class"] = String(debris_tile.get("material_class", "space_debris"))
	var mass := maxf(0.05, float(debris_tile.get("mass", 1.0)))
	var debris_stats := {
		"health": maxi(1, int(roundf(float(debris_tile.get("hp", 12.0))))),
		"max_health": maxi(1, int(roundf(float(debris_tile.get("hp", 12.0))))),
		"mass": mass,
		"structural_mass": mass,
		"radius": maxf(0.04, float(debris_tile.get("radius", 0.08))),
		"length": maxf(0.08, float(debris_tile.get("length", 0.28))),
		"speed": 0.0,
		"acceleration": 0.0,
		"drag": 0.0,
		"cooling": 0.0,
		"heat_capacity": 1.0,
		"normal_damage": maxi(1, int(roundf(float(debris_tile.get("contact_damage", debris_tile.get("cage_damage", 2.0)))))),
		"damage_type": String(debris_tile.get("damage_type", "blunt")),
		"material_class": String(debris_tile.get("material_class", "space_debris")),
		"stiffness": maxf(1.0, mass * 1.35),
		"barrier_map_tiles": [debris_tile],
		"barrier_tile_count": 1,
		"barrier_map_columns": 1,
		"barrier_map_rows": 1,
		"barrier_map_width": maxf(0.1, float(debris_tile.get("length", 0.28))),
		"barrier_map_height": maxf(0.1, float(debris_tile.get("radius", 0.08)) * 2.0),
	}
	var debris = _create_unit(0, "barrier", debris_stats, "SPACE DEBRIS", world_pos.x, world_pos.y)
	debris.set_meta("space_debris", true)
	debris.set_meta("detached_barrier_piece", true)
	debris.set_meta("space_debris_origin_owner", origin_owner)
	debris.set_meta("space_debris_age", 0.0)
	debris.set_meta("space_debris_speed", speed)
	var dir := direction.normalized() if direction.length() > 0.01 else Vector2.RIGHT
	debris.velocity = dir * speed + source_velocity * clampf(0.08 + mass / 500.0, 0.08, 0.22)
	debris.modulate = Color(0.86, 0.9, 0.96, 0.9)
	_spawn_hit_effect(debris, 1, "blunt", false, "spark")
	return debris


func _barrier_entry_blocker(player_id: int, stats: Dictionary, spawn: Dictionary = {}):
	var enemy_id := 2 if player_id == 1 else 1
	var enemy_barrier = active_units[enemy_id]["barrier"]
	if not _is_live_unit(enemy_barrier):
		return null
	var center_ring := wrapf(float(spawn.get("ring", _camera_center_for_player(player_id))), 0.0, RING_LENGTH)
	var center_lane := clampf(float(spawn.get("lane", _camera_lane_for_player(player_id))), -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
	var candidate_colliders := _barrier_colliders_from_stats(stats, center_ring, center_lane)
	var enemy_colliders := _unit_part_colliders(enemy_barrier)
	if not candidate_colliders.is_empty() and not enemy_colliders.is_empty():
		if _gpu_collider_sets_contact(candidate_colliders, enemy_colliders, BATTLE_FRAME_DELTA):
			return enemy_barrier
		return null
	var radius := maxf(float(stats.get("space_size", stats.get("cage_radius", stats.get("radius", 0.35)))), float(stats.get("radius", 0.35)))
	var enemy_radius := maxf(float(enemy_barrier.stats.get("space_size", enemy_barrier.stats.get("cage_radius", enemy_barrier.stats.get("radius", 0.35)))), float(enemy_barrier.stats.get("radius", 0.35)))
	var overlap_delta := _mobius_delta_points(center_ring, center_lane, enemy_barrier.ring_pos, enemy_barrier.lane)
	var overlap_ring := absf(overlap_delta.x)
	var overlap_lane := absf(overlap_delta.y)
	var tolerance := (radius + enemy_radius) * 0.52
	if overlap_ring <= tolerance and overlap_lane <= tolerance * 0.72:
		return enemy_barrier
	return null


func _try_force_barrier_entry(player_id: int, stats: Dictionary, spawn: Dictionary = {}) -> bool:
	var blocker = _barrier_entry_blocker(player_id, stats, spawn)
	if not _is_live_unit(blocker):
		return true
	var damage := int(stats.get("entry_breach_damage", 0))
	if damage <= 0:
		_show_battle_message("Enemy barrier geometry blocks center entry", 0.85)
		return false
	var damage_type := String(stats.get("entry_breach_damage_type", "blunt"))
	var self_heat := float(stats.get("entry_breach_self_heat", 0.0))
	stats["entry_breach_consumed"] = true
	stats["entry_breach_damage"] = 0
	stats["health"] = maxi(12, int(stats.get("health", 25)) - maxi(8, int(roundf(float(damage) * 0.28))))
	stats["mass"] = maxf(0.1, float(stats.get("mass", 1.0)) - maxf(2.0, float(damage) * 0.06))
	stats["length"] = maxf(0.14, float(stats.get("length", 0.3)) - 0.12)
	stats["radius"] = maxf(0.06, float(stats.get("radius", 0.2)) - 0.035)
	var event := {"damage_type": damage_type, "projectile": false}
	var final_damage := maxi(1, int(roundf(float(damage) * _vulnerability_multiplier(blocker, event))))
	final_damage = _projectile_material_adjusted_damage(blocker, event, final_damage)
	var blocked := final_damage <= 0 or bool(event.get("contact_gate_blocked", false))
	_spawn_hit_effect(blocker, _counter_tier_for_hit(blocker, damage_type), damage_type, blocked, "blast")
	if blocked:
		_show_battle_message("FORCED ENTRY CHARGE failed to beat %s threshold" % String(event.get("stiffness_segment_name", "barrier")), 0.9)
		return true
	_apply_hitstop(damage_type, 2, final_damage)
	var killed: bool = blocker.take_hit(final_damage, "active", player_id, damage_type, "field")
	_show_battle_message("FORCED ENTRY CHARGE %d %s: rest of barrier phases in" % [final_damage, damage_type.to_upper()], 1.0)
	if killed:
		_handle_unit_killed(blocker, player_id)
	else:
		_add_unit_heat(blocker, self_heat * 0.5)
	return true


func _push_overlapping_mechs_from_barrier(barrier, player_id: int) -> void:
	if not _is_live_unit(barrier):
		return
	if _barrier_has_map_tiles(barrier):
		var barrier_colliders := _unit_part_colliders(barrier)
		for unit in all_units:
			if unit == barrier or not _is_live_unit(unit) or not _unit_is_mech_physics_subject(unit):
				continue
			var target_colliders := _unit_part_colliders(unit)
			var responses := _gpu_collider_set_responses(barrier_colliders, target_colliders, BATTLE_FRAME_DELTA)
			if responses.is_empty():
				continue
			var first_response: Dictionary = Dictionary(responses[0])
			var best_direction: Vector2 = first_response.get("normal", Vector2.ZERO)
			if best_direction.length() <= 0.01:
				best_direction = Vector2(float(1 if int(unit.owner_id) == player_id else -1), 0.0)
			best_direction = best_direction.normalized()
			var push := maxf(0.0, float(first_response.get("penetration", 0.0))) * 0.72
			_apply_unit_displacement(unit, Vector2(best_direction.x, best_direction.y * 0.72), push)
			unit.velocity += Vector2(best_direction.x, best_direction.y * 0.62) * maxf(0.18, push * 1.4)
			_spawn_hit_effect(unit, 0, "blunt", false, "shield")
		return
	var radius := maxf(float(barrier.stats.get("space_size", barrier.stats.get("cage_radius", barrier.stats.get("radius", 0.35)))), float(barrier.stats.get("radius", 0.35)))
	for unit in all_units:
		if unit == barrier or not _is_live_unit(unit) or not _unit_is_mech_physics_subject(unit):
			continue
		var delta_vec := _mobius_delta_vec_between(barrier, unit, 1.35)
		var distance := delta_vec.length()
		var min_distance := radius + float(unit.stats.get("radius", 0.2)) + 0.08
		if distance >= min_distance:
			continue
		var dir := delta_vec.normalized() if distance > 0.01 else Vector2(float(1 if int(unit.owner_id) == player_id else -1), 0.0)
		var push := (min_distance - distance) * 0.72
		_apply_unit_displacement(unit, Vector2(dir.x, dir.y * 0.72), push)
		unit.velocity += Vector2(dir.x, dir.y * 0.62) * maxf(0.18, push * 1.4)
		_spawn_hit_effect(unit, 0, "blunt", false, "shield")


func _role_pending(player_id: int, role_key: String) -> bool:
	return pending_deploys.has(player_id) and float(pending_deploys[player_id].get(role_key, 0.0)) > 0.0


func _create_unit(player_id: int, role_key: String, stats: Dictionary, unit_name: String, spawn_ring: float, spawn_lane: float):
	var unit = UnitScene.new()
	units_root.add_child(unit)
	unit.setup_unit({
		"owner_id": player_id,
		"role": role_key,
		"unit_name": unit_name,
		"group_name": String(stats.get("ai", "")),
		"stats": stats,
	})
	unit.deploy(spawn_ring, spawn_lane)
	if unit.has_method("set_facing_immediate"):
		unit.set_facing_immediate(1 if player_id == 1 else -1)
	_initialize_unit_runtime_resources(unit)
	_mark_unit_attack_executed(unit)
	all_units.append(unit)
	return unit


func _mark_unit_attack_executed(unit) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	unit.set_meta("last_attack_time", Time.get_ticks_msec() * 0.001)


func _initialize_unit_runtime_resources(unit) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	var ammo_capacity: Dictionary = unit.stats.get("ammo_capacity", {"bullet": 0, "chemical": 0, "laser": 0})
	for ammo_type in AMMO_TYPES:
		unit.set_meta(_ammo_meta_key(ammo_type), maxi(0, int(ammo_capacity.get(ammo_type, 0))))
	unit.set_meta("support_armor_hp", 0.0)
	unit.set_meta("support_armor_timer", 0.0)
	var electronic_armor_max := maxf(0.0, float(unit.stats.get("electronic_armor_max", 0.0)))
	unit.set_meta("electronic_armor_max", electronic_armor_max)
	unit.set_meta("electronic_armor_hp", electronic_armor_max)
	unit.set_meta("shield_max", electronic_armor_max)
	unit.set_meta("shield_hp", electronic_armor_max)
	unit.set_meta("electronic_armor_flash", 0.0)


func _ammo_meta_key(ammo_type: String) -> String:
	return "ammo_%s" % ammo_type


func _ammo_capacity_for(unit, ammo_type: String) -> int:
	if unit == null or not is_instance_valid(unit):
		return 0
	var ammo_capacity: Dictionary = unit.stats.get("ammo_capacity", {"bullet": 0, "chemical": 0, "laser": 0})
	return maxi(0, int(ammo_capacity.get(ammo_type, 0)))


func _current_ammo(unit, ammo_type: String) -> int:
	if unit == null or not is_instance_valid(unit):
		return 0
	return maxi(0, int(unit.get_meta(_ammo_meta_key(ammo_type), _ammo_capacity_for(unit, ammo_type))))


func _ammo_type_for_event(event: Dictionary) -> String:
	var ammo_kind := _normalized_ammo_type(String(event.get("ammo_kind", "")))
	if AMMO_TYPES.has(ammo_kind):
		return ammo_kind
	var damage_type := String(event.get("projectile_damage_type", event.get("damage_type", "")))
	return damage_type if AMMO_TYPES.has(damage_type) else ""


func _consume_ammo_for_event(attacker, event: Dictionary) -> bool:
	if not bool(event.get("projectile", false)):
		return true
	var ammo_type := _ammo_type_for_event(event)
	if ammo_type == "":
		return true
	var capacity := _ammo_capacity_for(attacker, ammo_type)
	if capacity <= 0:
		return true
	var current := _current_ammo(attacker, ammo_type)
	if current <= 0:
		_play_module_fail_sfx()
		_show_battle_message("%s %s AMMO EMPTY" % [attacker.unit_name, ammo_type.to_upper()], 0.62)
		return false
	unit_set_ammo(attacker, ammo_type, current - 1)
	return true


func unit_set_ammo(unit, ammo_type: String, amount: int) -> void:
	if unit == null or not is_instance_valid(unit):
		return
	unit.set_meta(_ammo_meta_key(ammo_type), clampi(amount, 0, max(0, _ammo_capacity_for(unit, ammo_type))))


func _ammo_unit_price(ammo_type: String) -> float:
	if not AMMO_TYPES.has(ammo_type):
		return 1.0
	var best_price := 999999.0
	for raw_part in Array(COMMON_CATALOG.get("muscle", [])):
		if not (raw_part is Dictionary):
			continue
		var part: Dictionary = _economy_priced_component(raw_part)
		if not bool(part.get("ammo_slot_payload", false)) and String(part.get("material_class", "")) != "ammo_payload":
			continue
		var capacity: Dictionary = part.get("ammo_capacity", {})
		var capacity_amount := int(capacity.get(ammo_type, 0))
		if capacity_amount <= 0:
			continue
		var unit_price := maxf(0.01, float(part.get("cost", 0)) / float(capacity_amount))
		best_price = minf(best_price, unit_price)
	if best_price >= 999998.0:
		return 1.0
	return best_price


func _paid_refill_ammo(unit, ammo_type: String, amount: int) -> Dictionary:
	var capacity := _ammo_capacity_for(unit, ammo_type)
	if capacity <= 0:
		return {"refilled": 0, "cost": 0.0, "reason": "no_capacity"}
	var current := _current_ammo(unit, ammo_type)
	if current >= capacity:
		return {"refilled": 0, "cost": 0.0, "reason": "full"}
	var requested := mini(maxi(1, amount), capacity - current)
	var owner := int(unit.owner_id) if unit != null and is_instance_valid(unit) else 1
	if not runtime_resource.has(owner):
		runtime_resource[owner] = 0.0
	var unit_price := maxf(0.01, _ammo_unit_price(ammo_type))
	var affordable := mini(requested, int(floorf(float(runtime_resource.get(owner, 0.0)) / unit_price)))
	if affordable <= 0:
		return {"refilled": 0, "cost": 0.0, "reason": "resource", "unit_price": unit_price}
	var cost := float(affordable) * unit_price
	runtime_resource[owner] = maxf(0.0, float(runtime_resource.get(owner, 0.0)) - cost)
	unit_set_ammo(unit, ammo_type, current + affordable)
	return {"refilled": affordable, "cost": cost, "reason": "ok", "unit_price": unit_price}


func _refill_ammo(unit, ammo_type: String, amount: int) -> bool:
	var capacity := _ammo_capacity_for(unit, ammo_type)
	if capacity <= 0:
		return false
	var current := _current_ammo(unit, ammo_type)
	if current >= capacity:
		return false
	unit_set_ammo(unit, ammo_type, mini(capacity, current + amount))
	return true


func _try_role_switch_module(unit) -> bool:
	if not _is_live_unit(unit):
		return false
	if identity_transfer_active or bool(unit.get_meta("identity_transfering", false)):
		return false
	var switch_timer := maxf(0.0, float(unit.get_meta("switch_timer", 0.0)))
	if switch_timer > 0.0:
		_show_battle_message("%s shift cooling %.1fs" % [unit.unit_name, switch_timer], 0.5)
		return false
	var target_role := _switch_target_role(unit)
	if target_role == "":
		return false
	var plan := _role_switch_plan(unit, target_role)
	if plan.is_empty():
		_show_battle_message("%s needs a live %s to exchange identity" % [unit.unit_name, ROLE_NAMES.get(target_role, target_role)], 0.75)
		return false
	_start_identity_transfer(plan)
	return true


func _try_soul_cast_transfer(unit) -> bool:
	if not _is_live_unit(unit):
		return false
	if identity_transfer_active or bool(unit.get_meta("identity_transfering", false)):
		return false
	if String(unit.role) != "hero":
		_show_battle_message("%s needs the soul before casting it" % unit.unit_name, 0.65)
		_play_module_fail_sfx()
		return false
	var switch_timer := maxf(0.0, float(unit.get_meta("switch_timer", 0.0)))
	if switch_timer > 0.0:
		_show_battle_message("%s soul cast cooling %.1fs" % [unit.unit_name, switch_timer], 0.5)
		return false
	var receiver_role := String(unit.stats.get("identity_receiver_role", "puppet"))
	if receiver_role == "":
		receiver_role = "puppet"
	var receiver_order := maxi(0, int(unit.stats.get("identity_receiver_order", 0)))
	var target = _select_identity_receiver(int(unit.owner_id), unit, receiver_role, receiver_order)
	if not _is_live_unit(target):
		_show_battle_message("%s has no live %s receiver" % [unit.unit_name, _role_name(receiver_role)], 0.72)
		_play_module_fail_sfx()
		return false
	var plan := {
		"source": unit,
		"target": target,
		"source_old_role": "hero",
		"target_old_role": String(target.role),
		"source_new_role": String(target.role),
		"target_new_role": "hero",
	}
	_start_identity_transfer(plan)
	return true


func _select_identity_receiver(owner: int, source, receiver_role: String, receiver_order: int):
	if receiver_role == "any":
		var best = null
		var best_distance := INF
		for candidate in _friendly_units(owner):
			if candidate == source or not _is_live_unit(candidate):
				continue
			var distance := absf(_ring_delta(source.ring_pos, candidate.ring_pos)) + absf(source.lane - candidate.lane) * 0.72
			if distance < best_distance:
				best_distance = distance
				best = candidate
		return best
	if receiver_role == "hero":
		var hero = active_units[owner]["hero"]
		return hero if _is_live_unit(hero) and hero != source else null
	if receiver_role == "barrier":
		var barrier = active_units[owner]["barrier"]
		return barrier if _is_live_unit(barrier) and barrier != source else null
	if receiver_role == "puppet":
		var receivers: Array = []
		for candidate in active_units[owner]["puppet"]:
			if _is_live_unit(candidate) and candidate != source:
				receivers.append(candidate)
		if receivers.is_empty():
			return null
		return receivers[clampi(receiver_order, 0, receivers.size() - 1)]
	return null


func _try_role_form_shift(unit) -> bool:
	if not _is_live_unit(unit):
		return false
	var switch_timer := maxf(0.0, float(unit.get_meta("switch_timer", 0.0)))
	if switch_timer > 0.0:
		_show_battle_message("%s form gate cooling %.1fs" % [unit.unit_name, switch_timer], 0.5)
		return false
	var target_role := _role_form_target(unit)
	if target_role == "" or target_role == String(unit.role):
		_play_module_fail_sfx()
		return false
	if not _can_self_form_shift(unit, target_role):
		_show_battle_message("%s cannot become %s now" % [unit.unit_name, _role_name(target_role)], 0.72)
		_play_module_fail_sfx()
		return false
	identity_transfer_active = true
	identity_freeze_timer = 0.32
	unit.set_meta("identity_transfering", true)
	if effects_root == null:
		_finish_role_form_shift(unit, target_role)
	else:
		_spawn_identity_effect(unit, unit, [_payload_for_role(String(unit.role)), _payload_for_role(target_role)], Callable(self, "_finish_role_form_shift").bind(unit, target_role))
	_play_identity_sfx(_payload_for_role(String(unit.role)), _payload_for_role(target_role))
	_show_battle_message("FORM FREEZE: %s -> %s" % [unit.unit_name, _role_name(target_role)], 0.72)
	return true


func _role_form_target(unit) -> String:
	var target := String(unit.stats.get("role_form_target_role", ""))
	if target == "cycle_mech_barrier" or target == "":
		if String(unit.role) == "barrier":
			return String(unit.stats.get("role_form_mech_role", "puppet"))
		return "barrier"
	if target in ROLE_ORDER:
		return target
	return ""


func _can_self_form_shift(unit, target_role: String) -> bool:
	var owner := int(unit.owner_id)
	if target_role == "hero" and _is_live_unit(active_units[owner]["hero"]) and active_units[owner]["hero"] != unit:
		return false
	if target_role == "barrier" and _is_live_unit(active_units[owner]["barrier"]) and active_units[owner]["barrier"] != unit:
		return false
	if target_role == "puppet" and String(unit.role) != "puppet":
		var group: Array = active_units[owner]["puppet"]
		for candidate in group:
			if _is_live_unit(candidate) and candidate != unit:
				return false
	return true


func _identity_switch_cooldown(unit) -> float:
	if unit == null or not is_instance_valid(unit):
		return IDENTITY_SWITCH_COOLDOWN_SECONDS
	return maxf(IDENTITY_SWITCH_COOLDOWN_SECONDS, float(unit.stats.get("switch_cooldown", IDENTITY_SWITCH_COOLDOWN_SECONDS)))


func _finish_role_form_shift(unit, target_role: String) -> void:
	if not _is_live_unit(unit):
		_clear_identity_transfer_lock(unit, null)
		return
	_detach_unit_reference(unit)
	_assign_unit_role(unit, target_role)
	var shape_hint := String(unit.stats.get("role_form_shape", ""))
	if shape_hint != "":
		unit.stats["shape"] = shape_hint
	elif target_role == "barrier":
		unit.stats["shape"] = "barrier"
	elif target_role == "puppet":
		unit.stats["shape"] = _morph_shape_for(String(unit.stats.get("shape", "core")), "travel")
	unit.set_meta("switch_timer", _identity_switch_cooldown(unit))
	_clear_identity_transfer_lock(unit, null)
	if unit.has_method("_apply_topology_visuals"):
		unit._apply_topology_visuals()
	if unit.has_method("_refresh_visuals"):
		unit._refresh_visuals()
	_update_units(0.0)
	_update_battle_ui()
	_show_battle_message("FORM SHIFT COMPLETE: %s is %s" % [unit.unit_name, _role_name(target_role)], 0.9)


func _role_switch_plan(source, target_role: String) -> Dictionary:
	if not _is_live_unit(source) or target_role not in ROLE_ORDER:
		return {}
	var source_role := String(source.role)
	if source_role == target_role:
		return {}
	var owner := int(source.owner_id)
	var target = _select_role_switch_target(owner, target_role, source)
	if not _is_live_unit(target):
		return {}
	return {
		"source": source,
		"target": target,
		"source_old_role": source_role,
		"target_old_role": String(target.role),
		"source_new_role": target_role,
		"target_new_role": source_role,
	}


func _select_role_switch_target(owner: int, target_role: String, source):
	if target_role == "hero":
		var hero = active_units[owner]["hero"]
		return hero if _is_live_unit(hero) and hero != source else null
	if target_role == "barrier":
		var barrier = active_units[owner]["barrier"]
		return barrier if _is_live_unit(barrier) and barrier != source else null
	if target_role == "puppet":
		var best = null
		var best_distance := 999.0
		for candidate in active_units[owner]["puppet"]:
			if not _is_live_unit(candidate) or candidate == source:
				continue
			var distance: float = absf(_ring_delta(source.ring_pos, candidate.ring_pos)) + absf(source.lane - candidate.lane) * 0.72
			if distance < best_distance:
				best_distance = distance
				best = candidate
		return best
	return null


func _start_identity_transfer(plan: Dictionary) -> void:
	var source = plan["source"]
	var target = plan["target"]
	if not _is_live_unit(source) or not _is_live_unit(target):
		return
	set_meta("last_identity_transfer_plan", plan)
	identity_transfer_active = true
	identity_freeze_timer = 0.92
	source.set_meta("identity_transfering", true)
	target.set_meta("identity_transfering", true)
	aim_holding[int(source.owner_id)] = false
	var source_payload := _payload_for_role(String(plan["source_old_role"]))
	var target_payload := _payload_for_role(String(plan["target_old_role"]))
	_spawn_identity_effect(source, target, [source_payload], Callable(self, "_finish_identity_transfer").bind(plan))
	_spawn_identity_effect(target, source, [target_payload], Callable())
	_play_identity_sfx(source_payload, target_payload)
	_show_battle_message("IDENTITY FREEZE: %s -> %s / %s -> %s" % [source_payload.to_upper(), target.unit_name, target_payload.to_upper(), source.unit_name], 1.0)


func _spawn_identity_effect(source, target, payloads: Array, callback: Callable) -> void:
	if effects_root == null:
		return
	var effect := IdentityTransferEffect.new()
	effect.setup(source, target, payloads, callback)
	effects_root.add_child(effect)


func _finish_identity_transfer(plan: Dictionary) -> void:
	var source = plan["source"]
	var target = plan["target"]
	if not _is_live_unit(source) or not _is_live_unit(target):
		_clear_identity_transfer_lock(source, target)
		return
	var source_new_role := String(plan["source_new_role"])
	var target_new_role := String(plan["target_new_role"])
	_detach_unit_reference(source)
	_detach_unit_reference(target)
	_assign_unit_role(source, source_new_role)
	_assign_unit_role(target, target_new_role)
	source.set_meta("switch_timer", _identity_switch_cooldown(source))
	target.set_meta("switch_timer", _identity_switch_cooldown(target))
	_clear_identity_transfer_lock(source, target)
	_update_units(0.0)
	_update_battle_ui()
	_show_battle_message("IDENTITY SWAP COMPLETE: %s is %s, %s is %s" % [source.unit_name, _role_name(source_new_role), target.unit_name, _role_name(target_new_role)], 1.05)


func _clear_identity_transfer_lock(source, target) -> void:
	identity_transfer_active = false
	identity_freeze_timer = 0.0
	if source != null and is_instance_valid(source):
		source.set_meta("identity_transfering", false)
	if target != null and is_instance_valid(target):
		target.set_meta("identity_transfering", false)


func _payload_for_role(role_key: String) -> String:
	match role_key:
		"hero":
			return "soul"
		"puppet":
			return "code"
		"barrier":
			return "ether"
	return "core"


func _assign_unit_role(unit, role_key: String) -> void:
	if not _is_live_unit(unit):
		return
	var owner: int = int(unit.owner_id)
	unit.role = role_key
	unit.stats["role"] = role_key
	unit.unit_name = "P%d %s %s" % [owner, _role_name(role_key), _payload_for_role(role_key).to_upper()]
	if role_key == "puppet":
		unit.group_name = String(unit.stats.get("ai", "line"))
		var group: Array = active_units[owner]["puppet"]
		if not group.has(unit):
			group.append(unit)
		active_units[owner]["puppet"] = group
	elif role_key == "hero":
		unit.group_name = ""
		active_units[owner]["hero"] = unit
	elif role_key == "barrier":
		unit.group_name = ""
		unit.velocity = Vector2.ZERO
		active_units[owner]["barrier"] = unit
	if unit.has_method("_apply_topology_visuals"):
		unit._apply_topology_visuals()
	if unit.has_method("_refresh_visuals"):
		unit._refresh_visuals()


func _switch_unit_role(unit, target_role: String) -> bool:
	if not _is_live_unit(unit) or target_role not in ROLE_ORDER:
		return false
	if String(unit.role) == target_role:
		return true
	_detach_unit_reference(unit)
	_assign_unit_role(unit, target_role)
	return true


func _play_identity_sfx(source_payload: String, target_payload: String) -> void:
	var pitch := 740.0
	if source_payload == "soul" or target_payload == "soul":
		pitch = 920.0
	elif source_payload == "ether" or target_payload == "ether":
		pitch = 520.0
	_play_sfx_wave("identity", pitch, 0.34, -11.0)


func _switch_unit_role_legacy_unused(unit, target_role: String) -> bool:
	if not _is_live_unit(unit) or target_role not in ROLE_ORDER:
		return false
	var owner: int = int(unit.owner_id)
	if String(unit.role) == target_role:
		return true
	if target_role == "hero" and _is_live_unit(active_units[owner]["hero"]):
		return false
	if target_role == "barrier" and _is_live_unit(active_units[owner]["barrier"]):
		return false
	_detach_unit_reference(unit)
	_assign_unit_role(unit, target_role)
	return true


func _unused_role_switch_placeholder() -> bool:
	return false


func _switch_target_role(unit) -> String:
	var target := String(unit.stats.get("role_switch", ""))
	if target == "cycle":
		match String(unit.role):
			"hero":
				return "puppet"
			"puppet":
				return "barrier"
			"barrier":
				return "hero"
		return "hero"
	if target in ROLE_ORDER:
		return target
	return ""


func _detach_unit_reference(unit) -> void:
	var owner: int = int(unit.owner_id)
	if active_units[owner]["hero"] == unit:
		active_units[owner]["hero"] = null
	if active_units[owner]["barrier"] == unit:
		active_units[owner]["barrier"] = null
	var group: Array = active_units[owner]["puppet"]
	if group.has(unit):
		group.erase(unit)
	active_units[owner]["puppet"] = group


func _update_puppets(delta: float) -> void:
	for player_id in [1, 2]:
		var group: Array = active_units[player_id]["puppet"]
		for unit in group:
			if not _is_live_unit(unit):
				continue
			var unit_index := group.find(unit)
			var target = _source_target_for_puppet(unit, player_id)
			if target == null:
				var drift := Vector2(0.2 * float(1 if player_id == 1 else -1), 0.0)
				if unit.has_method("move_by_gameplay"):
					unit.move_by_gameplay(drift, delta, RING_LENGTH)
				else:
					unit.move_by(drift, delta, RING_LENGTH)
				continue
			var condition := _puppet_condition(unit, target, player_id)
			unit.set_meta("source_condition", condition)
			var move := _puppet_move_vector(unit, target, player_id, unit_index, group.size(), delta, condition)
			if unit.has_method("move_by_gameplay"):
				unit.move_by_gameplay(move, delta, RING_LENGTH)
			else:
				unit.move_by(move, delta, RING_LENGTH)
			_try_puppet_action(unit, target, player_id, unit_index, delta, condition)


func _puppet_move_vector(unit, target, player_id: int, unit_index: int, group_size: int, delta: float, condition: String = "default") -> Vector2:
	var target_delta := _mobius_delta_vec_between(unit, target)
	var delta_ring: float = target_delta.x
	var delta_lane: float = target_delta.y
	var target_vec := Vector2(delta_ring, delta_lane)
	var move := target_vec.normalized() if target_vec.length() > 0.01 else Vector2(float(unit.facing), 0.0)
	var ai_kind := String(unit.stats.get("ai", "line"))
	var phase: float = float(unit.get_meta("phase", 0.0)) + delta * (1.8 + float(unit_index) * 0.17)
	unit.set_meta("phase", phase)
	var blind_strength := _unit_blind_strength(unit)
	if blind_strength > 0.08:
		return (_blind_escape_vector(unit) + Vector2(-signf(delta_ring) * 0.22, 0.0)).limit_length(1.0)
	if ai_kind == "drone_cloud":
		var orbit := float(unit.stats.get("orbit_radius", 1.02))
		var angle := phase * 1.55 + TAU * float(unit_index) / maxf(1.0, float(group_size))
		var anchor = active_units[player_id]["hero"]
		var anchor_ring: float = target.ring_pos
		var anchor_lane: float = target.lane
		if _is_live_unit(anchor):
			anchor_ring = anchor.ring_pos
			anchor_lane = anchor.lane
		var desired_ring := wrapf(anchor_ring + cos(angle) * orbit, 0.0, RING_LENGTH)
		var desired_lane := clampf(anchor_lane + sin(angle) * orbit * 0.72, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
		move = Vector2(signf(_ring_delta(unit.ring_pos, desired_ring)), clampf((desired_lane - unit.lane) * 2.4, -1.0, 1.0))
		if absf(delta_ring) < float(unit.stats.get("hold_range", 1.2)):
			move += Vector2(signf(delta_ring) * 0.35, clampf(delta_lane * 0.8, -0.5, 0.5))
	elif ai_kind == "figure8":
		move = Vector2(sin(phase), sin(phase * 2.0))
		if absf(delta_ring) > 1.4:
			move.x += signf(delta_ring) * 0.8
	elif ai_kind == "volley":
		move.y = clampf(delta_lane * 1.4, -0.8, 0.8)
		if absf(delta_ring) < float(unit.stats.get("hold_range", 0.9)):
			move.x = -signf(delta_ring) * 0.45
	elif ai_kind == "ranged_pack" or ai_kind == "siege_battery":
		var keep_range := float(unit.stats.get("source_keep_range", unit.stats.get("hold_range", 1.2)))
		var side := -1.0 if unit_index % 2 == 0 else 1.0
		if absf(delta_ring) < keep_range * 0.72:
			move = Vector2(-signf(delta_ring), clampf(-delta_lane * 1.2 + side * 0.34, -1.0, 1.0))
		elif absf(delta_ring) > keep_range * 1.18:
			move = Vector2(signf(delta_ring), clampf(delta_lane * 1.1 + side * 0.22, -1.0, 1.0))
		else:
			move = Vector2(side * 0.18, clampf(delta_lane * 1.3 + sin(phase + float(unit_index)) * 0.35, -1.0, 1.0))
	elif ai_kind == "execution_swarm":
		var side := -1.0 if unit_index % 2 == 0 else 1.0
		move = Vector2(signf(delta_ring), clampf(delta_lane * 1.75 + side * 0.45, -1.0, 1.0))
		if absf(delta_ring) < 0.48:
			move.x = side * 0.28
	elif ai_kind == "interceptor_screen":
		var own_hero = active_units[player_id]["hero"]
		if _is_live_unit(own_hero):
			var hero_to_target := _ring_delta(own_hero.ring_pos, target.ring_pos)
			var screen_offset := (float(unit_index) - float(group_size - 1) * 0.5) * 0.24
			var desired_ring := wrapf(own_hero.ring_pos + hero_to_target * 0.38, 0.0, RING_LENGTH)
			var desired_lane := clampf(lerpf(own_hero.lane, target.lane, 0.46) + screen_offset, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
			move = Vector2(signf(_ring_delta(unit.ring_pos, desired_ring)), clampf((desired_lane - unit.lane) * 2.4, -1.0, 1.0))
		else:
			move = Vector2(signf(delta_ring), clampf(delta_lane * 1.2, -1.0, 1.0))
	elif ai_kind == "vanguard_cover":
		var guard_anchor = _source_guard_anchor_for(unit, target, player_id)
		if _is_live_unit(guard_anchor):
			var anchor_to_target := _ring_delta(guard_anchor.ring_pos, target.ring_pos)
			var screen_offset := (float(unit_index) - float(group_size - 1) * 0.5) * 0.2
			var desired_ring := wrapf(guard_anchor.ring_pos + anchor_to_target * 0.48, 0.0, RING_LENGTH)
			var desired_lane := clampf(lerpf(guard_anchor.lane, target.lane, 0.5) + screen_offset, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
			move = Vector2(signf(_ring_delta(unit.ring_pos, desired_ring)), clampf((desired_lane - unit.lane) * 2.6, -1.0, 1.0))
			if absf(delta_ring) < float(unit.stats.get("hold_range", 0.74)):
				move += Vector2(signf(delta_ring) * 0.28, clampf(delta_lane * 0.9, -0.45, 0.45))
		else:
			move = Vector2(signf(delta_ring), clampf(delta_lane * 1.45, -1.0, 1.0))
	elif ai_kind == "guard_orbit":
		var guard_hero = active_units[player_id]["hero"]
		var anchor_ring: float = unit.ring_pos
		var anchor_lane: float = unit.lane
		if _is_live_unit(guard_hero):
			var orbit: float = float(unit.stats.get("orbit_radius", 0.42))
			var angle := phase + TAU * float(unit_index) / maxf(1.0, float(group_size))
			anchor_ring = wrapf(guard_hero.ring_pos + cos(angle) * orbit, 0.0, RING_LENGTH)
			anchor_lane = clampf(guard_hero.lane + sin(angle) * orbit * 0.8, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
		move = Vector2(signf(_ring_delta(unit.ring_pos, anchor_ring)), clampf((anchor_lane - unit.lane) * 2.4, -1.0, 1.0))
		if absf(delta_ring) < 0.72:
			move += Vector2(signf(delta_ring) * 0.45, clampf(delta_lane * 1.2, -0.5, 0.5))
	elif ai_kind == "pincer":
		var side := -1.0 if unit_index % 2 == 0 else 1.0
		var flank := float(unit.stats.get("flank_width", 0.66)) * side
		move = Vector2(signf(delta_ring), clampf((target.lane + flank - unit.lane) * 2.0, -1.0, 1.0))
		if absf(delta_ring) < 0.72:
			move.x = -side * 0.35
	elif ai_kind == "screen_wall":
		var screen_hero = active_units[player_id]["hero"]
		var anchor_ring: float = unit.ring_pos
		var anchor_lane: float = unit.lane
		if _is_live_unit(screen_hero):
			anchor_ring = wrapf(screen_hero.ring_pos + _ring_delta(screen_hero.ring_pos, target.ring_pos) * 0.42, 0.0, RING_LENGTH)
			var spread := (float(unit_index) - float(group_size - 1) * 0.5) * 0.28
			anchor_lane = clampf(lerpf(screen_hero.lane, target.lane, 0.5) + spread, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
		move = Vector2(signf(_ring_delta(unit.ring_pos, anchor_ring)), clampf((anchor_lane - unit.lane) * 2.3, -1.0, 1.0))
	elif ai_kind == "formation_xi":
		var formation_hero = active_units[player_id]["hero"]
		var rows := [-0.72, -0.42, -0.14, 0.14, 0.42, 0.72]
		var columns := [-0.82, -0.46, 0.0, 0.46, 0.82]
		var col := unit_index % columns.size()
		var row := int(floor(float(unit_index) / float(columns.size()))) % rows.size()
		var anchor_ring: float = target.ring_pos - signf(delta_ring) * float(unit.stats.get("hold_range", 1.2))
		var anchor_lane: float = target.lane
		if _is_live_unit(formation_hero):
			anchor_ring = lerpf(formation_hero.ring_pos, target.ring_pos, 0.55)
			anchor_lane = formation_hero.lane * 0.42 + target.lane * 0.58
		var desired_ring := wrapf(anchor_ring + columns[col] * float(unit.stats.get("flank_width", 0.86)), 0.0, RING_LENGTH)
		var desired_lane := clampf(anchor_lane + rows[row] * 0.54, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
		move = Vector2(signf(_ring_delta(unit.ring_pos, desired_ring)), clampf((desired_lane - unit.lane) * 2.15, -1.0, 1.0))
		if absf(delta_ring) < 0.44:
			move += Vector2(-signf(delta_ring) * 0.22, clampf(delta_lane * 0.52, -0.4, 0.4))
	elif ai_kind == "mine_dance":
		var orbit := float(unit.stats.get("orbit_radius", 0.62))
		var angle := phase + TAU * float(unit_index) / maxf(1.0, float(group_size))
		var desired_ring := wrapf(target.ring_pos + cos(angle) * orbit, 0.0, RING_LENGTH)
		var desired_lane := clampf(target.lane + sin(angle) * orbit, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
		move = Vector2(signf(_ring_delta(unit.ring_pos, desired_ring)), clampf((desired_lane - unit.lane) * 2.1, -1.0, 1.0))
	var source_rule := _source_rule_for_condition(unit, condition)
	if not source_rule.is_empty():
		move = _source_move_vector(unit, target, player_id, unit_index, group_size, phase, String(source_rule.get("move", "approach")))
	return move.limit_length(1.0)


func _puppet_condition(unit, target, player_id: int) -> String:
	if _unit_uses_heat(unit) and (unit.overheated or unit.heat >= maxf(1.0, float(unit.stats.get("heat_capacity", 100.0))) * 0.78):
		return "self_overheat"
	if not _is_live_unit(active_units[player_id]["hero"]):
		return "hero_absent"
	if _is_live_unit(target) and float(target.get_meta("projectile_signal", 0.0)) > 0.0:
		return "enemy_shooting"
	var delta_ring: float = absf(_ring_delta(unit.ring_pos, target.ring_pos))
	if delta_ring > float(unit.stats.get("hold_range", 0.82)) + 0.38:
		return "enemy_far"
	if delta_ring < 0.36 + float(target.stats.get("radius", 0.2)) * 0.4:
		return "enemy_close"
	return "default"


func _source_rule_for_condition(unit, condition: String) -> Dictionary:
	var rules: Dictionary = unit.stats.get("source_rules", {})
	if rules.has(condition):
		return rules[condition]
	return rules.get("default", {})


func _source_attack_index_for_step(unit, modules: Array, step: int) -> int:
	if modules.is_empty():
		return 0
	var preference := String(unit.stats.get("source_attack_preference", ""))
	var fallback := clampi(int(modules[step % modules.size()]), 0, ATTACK_GROUP_COUNT - 1)
	if preference == "":
		return fallback
	var ordered: Array = []
	for offset in range(modules.size()):
		ordered.append(clampi(int(modules[(step + offset) % modules.size()]), 0, ATTACK_GROUP_COUNT - 1))
	if preference in ["ranged_first", "finish_first"]:
		for attack_index in ordered:
			var group := _attack_group(unit, int(attack_index))
			if bool(group.get("projectile", false)) and not _part_disabled(unit, int(attack_index)):
				return int(attack_index)
	if preference == "melee_first":
		for attack_index in ordered:
			var group := _attack_group(unit, int(attack_index))
			if not bool(group.get("projectile", false)) and not _part_disabled(unit, int(attack_index)):
				return int(attack_index)
	if preference == "intercept_first":
		for attack_index in ordered:
			var group := _attack_group(unit, int(attack_index))
			if String(group.get("damage_type", "blunt")) == "blunt" or String(group.get("skill_state", "")) == "armor":
				return int(attack_index)
	for attack_index in ordered:
		if not _part_disabled(unit, int(attack_index)):
			return int(attack_index)
	return fallback


func _default_puppet_attack_modules(unit, unit_index: int) -> Array:
	var modules: Array = []
	var preferred := clampi(unit_index % ATTACK_GROUP_COUNT, 0, ATTACK_GROUP_COUNT - 1)
	if not _part_disabled(unit, preferred):
		modules.append(preferred)
	for attack_index in range(ATTACK_GROUP_COUNT):
		if attack_index == preferred:
			continue
		if not _part_disabled(unit, attack_index):
			modules.append(attack_index)
	return modules


func _puppet_attack_reaches(unit, group: Dictionary, action_kind: String, ai_kind: String, delta_ring: float, delta_lane: float) -> bool:
	var range_limit := _ai_group_attack_reach(unit, group, action_kind)
	var lane_limit := 0.38
	if bool(group.get("projectile", false)):
		lane_limit = maxf(lane_limit, BATTLE_HALF_HEIGHT * 2.0)
	if ai_kind in ["volley", "mine_dance"]:
		range_limit += 0.42
	if ai_kind == "drone_cloud":
		range_limit += 0.72
		lane_limit += 0.16
	if ai_kind == "screen_wall" and action_kind == "armor":
		lane_limit += 0.24
	return absf(delta_ring) <= range_limit and absf(delta_lane) <= lane_limit


func _source_move_vector(unit, target, player_id: int, unit_index: int, group_size: int, phase: float, move_kind: String) -> Vector2:
	var delta_ring: float = _ring_delta(unit.ring_pos, target.ring_pos)
	var delta_lane: float = target.lane - unit.lane
	match move_kind:
		"retreat":
			return Vector2(-signf(delta_ring), clampf(-delta_lane * 1.4, -1.0, 1.0))
		"kite":
			var keep_range := float(unit.stats.get("source_keep_range", unit.stats.get("hold_range", 1.1)))
			var side := -1.0 if unit_index % 2 == 0 else 1.0
			if absf(delta_ring) < keep_range:
				return Vector2(-signf(delta_ring), clampf(-delta_lane * 1.25 + side * 0.32, -1.0, 1.0))
			return Vector2(side * 0.18, clampf(delta_lane * 1.05 + sin(phase + float(unit_index)) * 0.42, -1.0, 1.0))
		"keep_range":
			var keep_range := float(unit.stats.get("source_keep_range", unit.stats.get("hold_range", 1.2)))
			if absf(delta_ring) < keep_range * 0.74:
				return Vector2(-signf(delta_ring), clampf(-delta_lane * 1.15, -1.0, 1.0))
			if absf(delta_ring) > keep_range * 1.2:
				return Vector2(signf(delta_ring), clampf(delta_lane * 1.2, -1.0, 1.0))
			return Vector2(0.0, clampf(delta_lane * 1.45 + sin(phase + float(unit_index)) * 0.32, -1.0, 1.0))
		"screen":
			var own_hero = active_units[player_id]["hero"]
			if _is_live_unit(own_hero):
				var hero_to_target := _ring_delta(own_hero.ring_pos, target.ring_pos)
				var spread := (float(unit_index) - float(group_size - 1) * 0.5) * 0.22
				var desired_ring := wrapf(own_hero.ring_pos + hero_to_target * 0.38, 0.0, RING_LENGTH)
				var desired_lane := clampf(lerpf(own_hero.lane, target.lane, 0.46) + spread, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
				return Vector2(signf(_ring_delta(unit.ring_pos, desired_ring)), clampf((desired_lane - unit.lane) * 2.3, -1.0, 1.0))
			return Vector2(signf(delta_ring), clampf(delta_lane * 1.2, -1.0, 1.0))
		"intercept":
			var guard_anchor = _source_guard_anchor_for(unit, target, player_id)
			if _is_live_unit(guard_anchor):
				var anchor_to_target := _ring_delta(guard_anchor.ring_pos, target.ring_pos)
				var spread := (float(unit_index) - float(group_size - 1) * 0.5) * 0.18
				var desired_ring := wrapf(guard_anchor.ring_pos + anchor_to_target * 0.56, 0.0, RING_LENGTH)
				var desired_lane := clampf(lerpf(guard_anchor.lane, target.lane, 0.52) + spread, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
				return Vector2(signf(_ring_delta(unit.ring_pos, desired_ring)), clampf((desired_lane - unit.lane) * 2.7, -1.0, 1.0))
			return Vector2(signf(delta_ring), clampf(delta_lane * 1.45, -1.0, 1.0))
		"cover_group":
			var guard_anchor = _source_guard_anchor_for(unit, target, player_id)
			if _is_live_unit(guard_anchor):
				var orbit := float(unit.stats.get("orbit_radius", 0.46))
				var angle := phase + TAU * float(unit_index) / maxf(1.0, float(group_size))
				var desired_ring := wrapf(guard_anchor.ring_pos + cos(angle) * orbit + _ring_delta(guard_anchor.ring_pos, target.ring_pos) * 0.22, 0.0, RING_LENGTH)
				var desired_lane := clampf(guard_anchor.lane + sin(angle) * orbit * 0.8 + (target.lane - guard_anchor.lane) * 0.22, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
				return Vector2(signf(_ring_delta(unit.ring_pos, desired_ring)), clampf((desired_lane - unit.lane) * 2.3, -1.0, 1.0))
			return Vector2(signf(delta_ring), clampf(delta_lane * 1.1, -1.0, 1.0))
		"cover_retreat":
			var guard_anchor = _source_guard_anchor_for(unit, target, player_id)
			if _is_live_unit(guard_anchor):
				var away_from_target := -signf(_ring_delta(guard_anchor.ring_pos, target.ring_pos))
				var desired_ring := wrapf(guard_anchor.ring_pos + away_from_target * 0.28, 0.0, RING_LENGTH)
				var desired_lane := clampf(guard_anchor.lane - signf(target.lane - guard_anchor.lane) * 0.22, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
				return Vector2(signf(_ring_delta(unit.ring_pos, desired_ring)), clampf((desired_lane - unit.lane) * 2.0, -1.0, 1.0))
			return Vector2(-signf(delta_ring), clampf(-delta_lane * 1.2, -1.0, 1.0))
		"hunt":
			var side := -1.0 if unit_index % 2 == 0 else 1.0
			return Vector2(signf(delta_ring), clampf(delta_lane * 1.7 + side * 0.38, -1.0, 1.0))
		"hold":
			return Vector2(0.0, clampf(delta_lane * 1.2, -0.7, 0.7))
		"orbit":
			var orbit := float(unit.stats.get("orbit_radius", 0.54))
			var angle := phase + TAU * float(unit_index) / maxf(1.0, float(group_size))
			var desired_ring := wrapf(target.ring_pos + cos(angle) * orbit, 0.0, RING_LENGTH)
			var desired_lane := clampf(target.lane + sin(angle) * orbit, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
			return Vector2(signf(_ring_delta(unit.ring_pos, desired_ring)), clampf((desired_lane - unit.lane) * 2.0, -1.0, 1.0))
		"flank":
			var side := -1.0 if unit_index % 2 == 0 else 1.0
			var lane_goal := clampf(target.lane + side * float(unit.stats.get("flank_width", 0.58)), -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT)
			return Vector2(signf(delta_ring), clampf((lane_goal - unit.lane) * 2.0, -1.0, 1.0))
	return Vector2(signf(delta_ring), clampf(delta_lane * 2.0, -1.0, 1.0))


func _try_puppet_action(unit, target, player_id: int, unit_index: int, delta: float, condition: String = "default") -> void:
	var delta_ring: float = _ring_delta(unit.ring_pos, target.ring_pos)
	var delta_lane: float = target.lane - unit.lane
	var ai_kind := String(unit.stats.get("ai", "line"))
	if String(unit.stats.get("role_switch", "")) != "" and (not _is_live_unit(active_units[player_id]["hero"]) or absf(delta_ring) <= float(unit.stats.get("switch_trigger_range", 0.62))):
		if _try_role_switch_module(unit):
			return
	if float(unit.get_meta("jammed_timer", 0.0)) > 0.0:
		unit.set_meta("fire_timer", 0.28)
		return
	var cadence: float = 0.0
	if ai_kind == "volley":
		cadence = 0.18 * float(unit_index)
	elif ai_kind == "pincer":
		cadence = 0.08 if unit_index % 2 == 0 else 0.0
	elif ai_kind == "mine_dance":
		cadence = 0.32
	var fire_timer := maxf(0.0, float(unit.get_meta("fire_timer", cadence)) - delta)
	unit.set_meta("fire_timer", fire_timer)
	if fire_timer > 0.0:
		return
	var source_rule := _source_rule_for_condition(unit, condition)
	var sequence: Array = source_rule.get("states", unit.stats.get("sequence", ["normal"]))
	var default_modules := _default_puppet_attack_modules(unit, unit_index)
	var modules: Array = source_rule.get("modules", default_modules)
	if sequence.is_empty():
		sequence = ["normal"]
	if modules.is_empty():
		modules = default_modules
	if modules.is_empty():
		unit.set_meta("fire_timer", 0.36 + cadence)
		return
	var step := int(unit.get_meta("sequence_step", 0))
	var action_kind := String(sequence[step % sequence.size()])
	var attack_index := _source_attack_index_for_step(unit, modules, step)
	var group := _attack_group(unit, attack_index)
	if _part_disabled(unit, attack_index):
		unit.set_meta("sequence_step", step + 1)
		unit.set_meta("fire_timer", 0.36 + cadence)
		return
	if not _puppet_attack_reaches(unit, group, action_kind, ai_kind, delta_ring, delta_lane):
		for candidate in modules:
			var candidate_index := clampi(int(candidate), 0, ATTACK_GROUP_COUNT - 1)
			if _part_disabled(unit, candidate_index):
				continue
			var candidate_group := _attack_group(unit, candidate_index)
			if _puppet_attack_reaches(unit, candidate_group, action_kind, ai_kind, delta_ring, delta_lane):
				attack_index = candidate_index
				group = candidate_group
				break
	if _puppet_attack_reaches(unit, group, action_kind, ai_kind, delta_ring, delta_lane):
		var event: Dictionary = _begin_unit_module_action(unit, action_kind, group, attack_index)
		if not event.is_empty():
			event["direction"] = Vector2(delta_ring, delta_lane * 1.2).normalized() if absf(delta_ring) + absf(delta_lane) > 0.01 else Vector2(float(unit.facing), 0.0)
			event["muscle_node"] = attack_index
			event["collision_group"] = group.duplicate(true)
			event["group_name"] = String(group.get("name", ATTACK_GROUP_FALLBACK[attack_index]))
			event["damage_type"] = String(group.get("damage_type", event.get("damage_type", "blunt")))
			event["material_class"] = String(group.get("melee_contact_class", group.get("material_class", "weapon")))
			var state_key := String(event.get("state", "normal"))
			var override_key := "%s_damage_override" % state_key
			var base_damage := float(event.get("damage", 1))
			if group.has(override_key):
				base_damage = float(group[override_key])
			event["damage"] = int(roundf(base_damage * float(group.get("damage_mult", 1.0))))
			event["range"] = float(event.get("range", 0.3)) * float(group.get("range_mult", 1.0))
			event["range"] = float(event["range"]) + _damage_type_range_bonus(unit.stats, String(event.get("damage_type", "blunt")))
			event["lane_range"] = float(event.get("lane_range", 0.2)) * float(group.get("lane_mult", 1.0))
			event["recoil"] = float(event.get("recoil", 0.06)) * float(group.get("recoil_mult", 1.0))
			if bool(group.get("projectile", unit.stats.get("projectile", false))):
				event["projectile"] = true
				event["material_class"] = "projectile"
				event["damage_type"] = String(group.get("projectile_damage_type", event.get("damage_type", "bullet")))
				event["projectile_style"] = String(group.get("projectile_style", _projectile_style_for_damage(String(event["damage_type"]))))
				event["projectile_behavior"] = _projectile_behavior_for_data(group)
				if String(event["projectile_behavior"]) == "bullet_hell":
					event["projectile_style"] = "bullet_hell"
					event["projectile_speed_mult"] = float(group.get("projectile_speed_mult", BULLET_HELL_DEFAULT_SPEED_MULT))
				event["travel_path"] = String(group.get("travel_path", "straight"))
				event["range"] = maxf(float(event["range"]), float(group.get("projectile_range", 2.25)))
				if String(event["projectile_behavior"]) == "true_bullet":
					event["projectile_style"] = "true_bullet"
					event["travel_path"] = "instant_line"
					event["range"] = maxf(float(event["range"]), _laser_visible_world_range(unit, event["direction"]))
				_copy_control_event_fields(event, group)
				if _map_line_occluded(unit, target, event):
					unit.set_meta("fire_timer", 0.22 + cadence)
					return
			if String(group.get("module_effect", "")) != "":
				_apply_module_event_fields(event, group)
			if ai_kind == "mine_dance":
				event["range"] = float(event.get("range", 0.4)) + 0.24
				event["lane_range"] = float(event.get("lane_range", 0.2)) + 0.18
			if unit.has_method("mark_part_action"):
				unit.mark_part_action(attack_index, event["direction"], String(event.get("state", action_kind)), float(unit.state_timer))
			unit.set_meta("sequence_step", step + 1)
			unit.set_meta("fire_timer", 0.42 + cadence)
			_resolve_attack(unit, event)


func _update_barriers(delta: float) -> void:
	for player_id in [1, 2]:
		var barrier = active_units[player_id]["barrier"]
		if _is_live_unit(barrier):
			_apply_barrier_logic(barrier, player_id, delta)


func _apply_barrier_logic(barrier, player_id: int, delta: float) -> void:
	var logic := String(barrier.stats.get("barrier_logic", "pulse"))
	var aura_range := float(barrier.stats.get("space_size", barrier.stats.get("aura_range", barrier.stats.get("active_range", 0.54))))
	if String(barrier.stats.get("role_switch", "")) != "":
		for target in _enemy_units(player_id):
			if _unit_in_barrier_aura(barrier, target, aura_range) and _try_role_switch_module(barrier):
				return
	if logic == "heat_well":
		for target in _enemy_units(player_id):
			if _unit_in_barrier_aura(barrier, target, aura_range):
				_add_unit_heat(target, float(barrier.stats.get("aura_heat", 12.0)) * delta)
				if randf() < delta * 2.2:
					_spawn_hit_effect(target, 1, "laser", false)
	elif logic == "caustic_field":
		for target in _enemy_units(player_id):
			if _unit_in_barrier_aura(barrier, target, aura_range):
				_add_unit_heat(target, float(barrier.stats.get("aura_heat", 7.0)) * delta)
				_apply_barrier_field_damage(barrier, target, player_id, String(barrier.stats.get("barrier_damage_type", "chemical")), 3, 0.55, delta)
	elif logic == "coolant_veil":
		for ally in _friendly_units(player_id):
			if _unit_in_barrier_aura(barrier, ally, aura_range):
				_cool_unit_heat(ally, float(barrier.stats.get("ally_cooling", 16.0)) * delta)
	elif logic == "drag_net":
		for target in _enemy_units(player_id):
			if _unit_in_barrier_aura(barrier, target, aura_range):
				target.velocity = target.velocity.move_toward(Vector2.ZERO, float(barrier.stats.get("slow_power", 0.35)) * 5.0 * delta)
				if randf() < delta * 1.6:
					_spawn_hit_effect(target, 0, "blunt", false)
	elif logic == "damage_amp":
		for ally in _friendly_units(player_id):
			if _unit_in_barrier_aura(barrier, ally, aura_range):
				ally.set_meta("field_damage_boost_type", String(barrier.stats.get("damage_boost_type", "tear")))
				ally.set_meta("field_damage_boost_mult", float(barrier.stats.get("damage_boost_mult", 1.2)))
				ally.set_meta("field_damage_boost_timer", 0.22)
	elif logic == "riposte_mirror":
		var timer := maxf(0.0, float(barrier.get_meta("pulse_timer", 0.0)) - delta)
		var enemy_inside := false
		for target in _enemy_units(player_id):
			if _unit_in_barrier_aura(barrier, target, aura_range):
				enemy_inside = true
				break
		if enemy_inside and timer <= 0.0:
			barrier.set_meta("pulse_timer", float(barrier.stats.get("pulse_interval", 1.05)))
			_resolve_attack(barrier, barrier.barrier_pulse())
		else:
			barrier.set_meta("pulse_timer", timer)
	elif logic == "galaxy_castle":
		for ally in _friendly_units(player_id):
			if _unit_in_barrier_aura(barrier, ally, aura_range):
				ally.set_meta("field_damage_boost_type", String(barrier.stats.get("damage_boost_type", "tear")))
				ally.set_meta("field_damage_boost_mult", float(barrier.stats.get("damage_boost_mult", 1.12)))
				ally.set_meta("field_damage_boost_timer", 0.22)
		for target in _enemy_units(player_id):
			if _unit_in_barrier_aura(barrier, target, aura_range):
				target.velocity = target.velocity.move_toward(Vector2.ZERO, float(barrier.stats.get("slow_power", 0.22)) * 4.0 * delta)
				_apply_barrier_field_damage(barrier, target, player_id, String(barrier.stats.get("barrier_damage_type", "chemical")), 2, 0.72, delta)
		var castle_timer := maxf(0.0, float(barrier.get_meta("pulse_timer", 0.0)) - delta)
		if castle_timer <= 0.0:
			barrier.set_meta("pulse_timer", float(barrier.stats.get("pulse_interval", 0.8)))
			_resolve_attack(barrier, barrier.barrier_pulse())
		else:
			barrier.set_meta("pulse_timer", castle_timer)
	elif logic == "gravity_vector":
		pass
	elif logic == "structure_only":
		pass
	else:
		_resolve_attack(barrier, barrier.barrier_pulse())
	_apply_barrier_utility_components(barrier, player_id, delta)


func _apply_barrier_utility_components(barrier, player_id: int, delta: float) -> void:
	if bool(barrier.stats.get("is_gravity_field", false)):
		_apply_gravity_field(barrier, player_id, delta)
	if bool(barrier.stats.get("is_coolant_field", false)):
		_apply_coolant_field(barrier, player_id, delta)
	if bool(barrier.stats.get("is_heat_field", false)):
		_apply_heat_field(barrier, player_id, delta)
	if bool(barrier.stats.get("is_repulsion_field", false)):
		_apply_repulsion_field(barrier, player_id, delta)
	if bool(barrier.stats.get("is_resource_siphon", false)):
		_apply_resource_siphon(barrier, player_id, delta)
	if bool(barrier.stats.get("is_hack_field", false)):
		_apply_hack_field(barrier, player_id, delta)
	if bool(barrier.stats.get("is_hatchery", false)):
		_apply_hatchery(barrier, player_id, delta)
	if bool(barrier.stats.get("is_cage_wall", false)):
		_apply_cage_wall(barrier, player_id, delta)


func _apply_cage_wall(barrier, player_id: int, delta: float) -> void:
	var radius := maxf(0.1, float(barrier.stats.get("cage_radius", barrier.stats.get("radius", 0.4))))
	var repel := float(barrier.stats.get("cage_repel", 0.36))
	var damage := int(barrier.stats.get("cage_damage", 0))
	var damage_type := String(barrier.stats.get("cage_damage_type", "blunt"))
	_update_field_aura_visual(barrier, "cage", radius, maxf(0.5, repel * 2.0), delta)
	for target in _field_targets_for(player_id, String(barrier.stats.get("cage_affects", "enemy"))):
		if target == barrier or not _is_live_unit(target) or not _unit_is_mech_physics_subject(target):
			continue
		var cage_delta := _mobius_delta_vec_between(barrier, target)
		var ring_delta := cage_delta.x
		var lane_delta := cage_delta.y
		var edge_metric := maxf(absf(ring_delta), absf(lane_delta) * 1.42)
		var target_radius := float(target.stats.get("radius", 0.2))
		var edge_distance := absf(edge_metric - radius)
		if edge_distance > target_radius + 0.08 or not _unit_in_barrier_aura(barrier, target, radius, "cage"):
			continue
		var push := Vector2(ring_delta, lane_delta * 1.2)
		if push.length() <= 0.01:
			push = Vector2(float(target.facing), 0.0)
		target.velocity += Vector2(push.normalized().x, push.normalized().y * 0.62) * repel
		var key := "cage_hit_%d" % int(barrier.get_instance_id())
		var timer := maxf(0.0, float(target.get_meta(key, 0.0)) - delta)
		if timer > 0.0:
			target.set_meta(key, timer)
			continue
		target.set_meta(key, maxf(0.12, float(barrier.stats.get("cage_hit_interval", 0.6))))
		if damage > 0:
			var event := {"damage_type": damage_type, "projectile": damage_type in PROJECTILE_DAMAGE_TYPES}
			var final_damage := _projectile_material_adjusted_damage(target, event, damage)
			var blocked := final_damage <= 0 or bool(event.get("contact_gate_blocked", false))
			_spawn_hit_effect(target, _counter_tier_for_hit(target, damage_type), damage_type, blocked, "beam" if damage_type == "laser" else "shield")
			if blocked:
				continue
			_apply_hitstop(damage_type, 1, final_damage)
			if target.take_hit(final_damage, "normal", player_id, damage_type, "field"):
				_handle_unit_killed(target, player_id)


func _apply_gravity_field(barrier, player_id: int, delta: float) -> void:
	var effects: Array = Array(barrier.stats.get("ether_effects", [])).duplicate(true)
	if effects.is_empty():
		effects.append({
			"kind": "gravity",
			"direction": String(barrier.stats.get("gravity_direction", "forward")),
			"force": float(barrier.stats.get("gravity_force", 0.32)),
			"radius": float(barrier.stats.get("gravity_radius", 0.7)),
		})
	for raw_effect in effects:
		if not (raw_effect is Dictionary):
			continue
		var effect: Dictionary = raw_effect
		if String(effect.get("kind", "gravity")) != "gravity":
			continue
		var radius := maxf(0.1, float(effect.get("radius", barrier.stats.get("gravity_radius", 0.7))))
		var force := float(effect.get("force", barrier.stats.get("gravity_force", 0.32)))
		var mode := String(effect.get("direction", barrier.stats.get("gravity_direction", "forward")))
		var aura_kind := "gravity"
		if mode != "":
			aura_kind = "gravity_%s" % mode
		_update_field_aura_visual(barrier, aura_kind, radius, force * 2.0, delta)
		for unit in all_units:
			if not _is_live_unit(unit) or unit == barrier or not _unit_is_mech_physics_subject(unit) or not _unit_in_barrier_aura(barrier, unit, radius, "gravity"):
				continue
			var dir := _gravity_direction_vector(mode, barrier, unit)
			if dir.length() > 0.01:
				unit.velocity += Vector2(dir.normalized().x, dir.normalized().y * 0.62) * force * delta


func _gravity_direction_vector(mode: String, barrier, unit) -> Vector2:
	match mode:
		"inward":
			return -_mobius_delta_vec_between(barrier, unit, 1.25)
		"outward":
			return _mobius_delta_vec_between(barrier, unit, 1.25)
		"right":
			return Vector2.RIGHT
		"left":
			return Vector2.LEFT
		"up":
			return Vector2.UP
		"down":
			return Vector2.DOWN
		"up_right":
			return Vector2(1.0, -1.0)
		"up_left":
			return Vector2(-1.0, -1.0)
		"down_right":
			return Vector2(1.0, 1.0)
		"down_left":
			return Vector2(-1.0, 1.0)
		"back":
			return Vector2(-float(barrier.facing), 0.0)
	return Vector2(float(barrier.facing), 0.0)


func _apply_coolant_field(barrier, player_id: int, delta: float) -> void:
	var targets := _friendly_units(player_id) if String(barrier.stats.get("coolant_affects", "ally")) == "ally" else all_units
	var radius := maxf(0.1, float(barrier.stats.get("coolant_radius", 0.68)))
	_update_field_aura_visual(barrier, "coolant", radius, float(barrier.stats.get("coolant_boost", 18.0)) / 18.0, delta)
	for unit in targets:
		if _is_live_unit(unit) and _unit_in_barrier_aura(barrier, unit, radius, "coolant"):
			_cool_unit_heat(unit, float(barrier.stats.get("coolant_boost", 18.0)) * delta, float(unit.stats.get("overheat_clear_ratio", 0.42)))


func _apply_heat_field(barrier, player_id: int, delta: float) -> void:
	var radius := maxf(0.1, float(barrier.stats.get("heat_field_radius", 0.62)))
	var heat_rate := float(barrier.stats.get("heat_field_rate", 18.0))
	_update_field_aura_visual(barrier, "heat", radius, heat_rate / 18.0, delta)
	for unit in _field_targets_for(player_id, String(barrier.stats.get("heat_field_affects", "all"))):
		if not _is_live_unit(unit) or unit == barrier or not _unit_is_mech_physics_subject(unit) or not _unit_in_barrier_aura(barrier, unit, radius, "heat"):
			continue
		var cooling_factor := clampf(1.18 - float(unit.stats.get("cooling", 0.0)) / 90.0, 0.42, 1.18)
		_add_unit_heat(unit, heat_rate * cooling_factor * delta)
		if randf() < delta * 1.2:
			_spawn_hit_effect(unit, 1, "laser", false, "field")


func _apply_repulsion_field(barrier, player_id: int, delta: float) -> void:
	var radius := maxf(0.1, float(barrier.stats.get("repulsion_radius", 0.68)))
	var force := float(barrier.stats.get("repulsion_force", 0.46))
	_update_field_aura_visual(barrier, "repulsion", radius, force * 2.0, delta)
	for unit in all_units:
		if not _is_live_unit(unit) or unit == barrier or not _unit_is_mech_physics_subject(unit) or not _unit_in_barrier_aura(barrier, unit, radius, "repulsion"):
			continue
		var dir := _mobius_delta_vec_between(barrier, unit, 1.25)
		if dir.length() <= 0.01:
			dir = Vector2(float(unit.facing), 0.0)
		var falloff := clampf(1.0 - dir.length() / maxf(0.1, radius * 1.4), 0.18, 1.0)
		unit.velocity += Vector2(dir.normalized().x, dir.normalized().y * 0.62) * force * falloff * delta


func _apply_resource_siphon(barrier, player_id: int, delta: float) -> void:
	var enemy_id := 2 if player_id == 1 else 1
	var radius := maxf(0.1, float(barrier.stats.get("siphon_radius", 0.72)))
	var rate := float(barrier.stats.get("siphon_rate", 60.0))
	_update_field_aura_visual(barrier, "siphon", radius, rate / 60.0, delta)
	for target in _enemy_units(player_id):
		if not _is_live_unit(target) or not _unit_is_mech_physics_subject(target) or not _unit_in_barrier_aura(barrier, target, radius, "siphon"):
			continue
		var amount := minf(float(runtime_resource[enemy_id]), rate * delta)
		if amount <= 0.0:
			continue
		runtime_resource[enemy_id] = float(runtime_resource[enemy_id]) - amount
		runtime_resource[player_id] = float(runtime_resource[player_id]) + amount
		if randf() < delta * 2.0:
			_spawn_hit_effect(target, 1, "laser", false, "field")


func _apply_hack_field(barrier, player_id: int, delta: float) -> void:
	var radius := maxf(0.1, float(barrier.stats.get("hack_radius", 0.68)))
	var required := maxf(0.5, float(barrier.stats.get("hack_seconds", 4.6)))
	var hack_power := maxf(0.1, float(barrier.stats.get("hack_power", 1.0)))
	_update_field_aura_visual(barrier, "hack", radius, required, delta)
	for target in _enemy_units(player_id):
		if not _is_live_unit(target) or not _unit_is_mech_physics_subject(target) or not _unit_in_barrier_aura(barrier, target, radius, "hack"):
			continue
		var key := "hack_time_p%d_%d" % [player_id, int(barrier.get_instance_id())]
		var total := float(target.get_meta(key, 0.0)) + delta
		target.set_meta(key, total)
		target.set_meta("hack_warning_timer", 0.45)
		if randf() < delta * 1.6:
			_spawn_hit_effect(target, 1, "laser", false, "field")
		var target_required := _security_adjusted_seconds(required, target, hack_power, 0.5)
		if total >= target_required:
			target.set_meta(key, 0.0)
			_defect_unit_to_owner(target, player_id, "HACK FIELD")


func _try_trigger_trap_fields(player_id: int, link_filter: String = "", input_vector: Vector2 = Vector2.ZERO, command_already_matched: bool = false) -> bool:
	for trap in _friendly_units(player_id):
		if not _is_live_unit(trap) or not bool(trap.stats.get("is_trap_field", false)):
			continue
		if float(trap.get_meta("jammed_timer", 0.0)) > 0.0:
			continue
		if float(trap.get_meta("trap_cooldown_timer", 0.0)) > 0.0:
			continue
		var trap_link := String(trap.stats.get("trap_link", ""))
		if link_filter != "" and link_filter != "all" and trap_link != link_filter:
			continue
		var targets := _trap_targets(trap, player_id)
		if targets.is_empty():
			continue
		var command := String(trap.stats.get("trap_command", "236"))
		if not command_already_matched and not _command_matches(player_id, command):
			continue
		_fire_trap_field(trap, player_id, targets, input_vector)
		return true
	return false


func _trap_targets(trap, player_id: int) -> Array:
	var targets: Array = []
	var radius := maxf(0.1, float(trap.stats.get("trap_radius", 0.7)))
	for unit in _field_targets_for(player_id, String(trap.stats.get("trap_affects", "enemy"))):
		if unit == trap or not _is_live_unit(unit) or not _unit_is_mech_physics_subject(unit):
			continue
		if _unit_in_barrier_aura(trap, unit, radius, "trap"):
			targets.append(unit)
	return targets


func _fire_trap_field(trap, player_id: int, targets: Array, input_vector: Vector2 = Vector2.ZERO) -> void:
	var effect := String(trap.stats.get("trap_effect", "acid_rain"))
	var radius := maxf(0.1, float(trap.stats.get("trap_radius", 0.7)))
	var power := float(trap.stats.get("trap_power", 0.45))
	var damage_type := String(trap.stats.get("trap_damage_type", trap.stats.get("damage_type", "chemical")))
	var damage := int(trap.stats.get("trap_damage", 0))
	var launch_direction := _trap_launch_direction(trap, player_id, input_vector)
	trap.set_meta("trap_cooldown_timer", maxf(0.4, float(trap.stats.get("trap_cooldown", 5.0))))
	_update_field_aura_visual(trap, "trap", radius, 2.0, 0.0)
	for target in targets:
		if not _is_live_unit(target):
			continue
		match effect:
			"acid_rain":
				_apply_trap_damage(trap, target, player_id, damage_type, damage, "spray")
				_add_unit_heat(target, 10.0)
			"heat_burst":
				_add_unit_heat(target, power)
				_apply_trap_damage(trap, target, player_id, damage_type, damage, "field")
			"laser_fan":
				_apply_trap_damage(trap, target, player_id, "laser", maxi(damage, 18), "beam")
			"gravity_burst":
				var dir := -_mobius_delta_vec_between(trap, target, 1.2)
				if dir.length() > 0.01:
					target.velocity += Vector2(dir.normalized().x, dir.normalized().y * 0.62) * power
				_apply_trap_damage(trap, target, player_id, damage_type, damage, "field")
			"repulse_burst":
				var away := _mobius_delta_vec_between(trap, target, 1.2)
				if away.length() > 0.01:
					target.velocity += Vector2(away.normalized().x, away.normalized().y * 0.62) * power
				_apply_trap_damage(trap, target, player_id, damage_type, damage, "field")
			"web_snare":
				target.set_meta("slow_timer", maxf(float(target.get_meta("slow_timer", 0.0)), float(trap.stats.get("trap_slow_duration", 2.2))))
				target.set_meta("slow_mult", clampf(1.0 - power, 0.25, 0.82))
				_spawn_hit_effect(target, 1, "blunt", false, "web")
			"spring_launch":
				target.velocity += Vector2(launch_direction.x, launch_direction.y * 0.62) * power
				var launch_offset := Vector2(launch_direction.x * 0.06, launch_direction.y * 0.05) * power
				_apply_unit_displacement(target, launch_offset, launch_offset.length())
				_apply_trap_damage(trap, target, player_id, damage_type, damage, "field")
			_:
				_apply_trap_damage(trap, target, player_id, damage_type, damage, "field")
	_show_battle_message("%s TRAP %s" % [trap.unit_name, effect.to_upper()], 0.8)
	_play_sfx_wave("alarm", 260.0, 0.12, -11.0)


func _trap_launch_direction(trap, player_id: int, input_vector: Vector2) -> Vector2:
	if input_vector.length() > 0.18:
		return input_vector.normalized()
	var text := _command_text(player_id)
	for i in range(text.length() - 1, -1, -1):
		match text.substr(i, 1):
			"6":
				return Vector2.RIGHT
			"4":
				return Vector2.LEFT
			"8":
				return Vector2.UP
			"2":
				return Vector2.DOWN
	return Vector2.RIGHT if int(trap.facing) >= 0 else Vector2.LEFT


func _apply_trap_damage(trap, target, player_id: int, damage_type: String, damage: int, projectile_style: String) -> void:
	if damage <= 0 or not _is_live_unit(target):
		if projectile_style != "":
			_spawn_hit_effect(target, 1, damage_type, false, projectile_style)
		return
	var event: Dictionary = {"damage_type": damage_type, "projectile": projectile_style in ["beam", "spray", "bullet"]}
	var final_damage: int = maxi(1, int(roundf(float(damage) * _vulnerability_multiplier(target, event))))
	final_damage = _projectile_material_adjusted_damage(target, event, final_damage)
	var blocked := final_damage <= 0 or bool(event.get("contact_gate_blocked", false))
	_spawn_hit_effect(target, _counter_tier_for_hit(target, damage_type), damage_type, blocked, projectile_style)
	if blocked:
		return
	_apply_hitstop(damage_type, 1, final_damage)
	var killed: bool = target.take_hit(final_damage, "active", player_id, damage_type, "field")
	if killed:
		_handle_unit_killed(target, player_id)


func _field_targets_for(player_id: int, affects: String) -> Array:
	match affects:
		"ally":
			return _friendly_units(player_id)
		"enemy":
			return _enemy_units(player_id)
	return all_units


func _update_field_aura_visual(barrier, field_kind: String, radius: float, strength: float, delta: float) -> void:
	if effects_root == null or not is_instance_valid(barrier):
		return
	if _barrier_has_map_tiles(barrier):
		var field_tag := _barrier_field_tag_from_kind(field_kind)
		var has_tagged_tiles := _barrier_has_tile_effect_tag(barrier, field_tag)
		var tile_index := 0
		for raw_tile in Array(barrier.stats.get("barrier_map_tiles", [])):
			if not (raw_tile is Dictionary):
				continue
			var tile: Dictionary = raw_tile
			if not _barrier_tile_matches_field(tile, field_tag, has_tagged_tiles):
				continue
			var tile_pos := _barrier_tile_world_position(barrier, tile, true)
			var tile_radius := maxf(radius, float(tile.get("field_radius", 0.0)))
			_update_field_aura_visual_at(barrier, "%s_%d" % [field_kind, tile_index], field_kind, tile_radius, strength, tile_pos, delta)
			tile_index += 1
		return
	_update_field_aura_visual_at(barrier, field_kind, field_kind, radius, strength, Vector2(barrier.ring_pos, barrier.lane), delta)


func _update_field_aura_visual_at(barrier, aura_key_suffix: String, field_kind: String, radius: float, strength: float, world_position: Vector2, delta: float) -> void:
	var key := "field_aura_%s" % field_kind
	if aura_key_suffix != field_kind:
		key = "field_aura_%s" % aura_key_suffix
	var aura = null
	if barrier.has_meta(key):
		aura = barrier.get_meta(key)
	if aura == null or not is_instance_valid(aura):
		aura = FieldAuraEffect.new()
		aura.setup(int(barrier.owner_id), field_kind, radius, strength)
		effects_root.add_child(aura)
		barrier.set_meta(key, aura)
	else:
		aura.setup(int(barrier.owner_id), field_kind, radius, strength)
	var screen := _screen_from_ring(world_position.x, world_position.y)
	aura.update_screen(screen["position"], bool(screen["visible"]) and _is_live_unit(barrier), delta)


func _apply_hatchery(barrier, player_id: int, delta: float) -> void:
	var limit := int(barrier.stats.get("hatch_limit", 0))
	if limit <= 0:
		return
	var group: Array = active_units[player_id]["puppet"]
	var hatchlings := 0
	for unit in group:
		if _is_live_unit(unit) and String(unit.get_meta("hatched_from", "")) == str(barrier.get_instance_id()):
			hatchlings += 1
	if hatchlings >= limit:
		return
	var timer := maxf(0.0, float(barrier.get_meta("hatch_timer", float(barrier.stats.get("hatch_interval", 6.0)))) - delta)
	if timer > 0.0:
		barrier.set_meta("hatch_timer", timer)
		return
	barrier.set_meta("hatch_timer", float(barrier.stats.get("hatch_interval", 6.0)))
	var stats := _hatchling_stats(barrier, player_id)
	var unit = _create_unit(player_id, "puppet", stats, "P%d HATCHLING %d" % [player_id, hatchlings + 1], wrapf(barrier.ring_pos + 0.16 * float(barrier.facing), 0.0, RING_LENGTH), clampf(barrier.lane + sin(float(hatchlings)) * 0.18, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT))
	unit.set_meta("hatched_from", str(barrier.get_instance_id()))
	group.append(unit)
	active_units[player_id]["puppet"] = group
	_show_battle_message("P%d hatchery spawned %s" % [player_id, String(stats.get("name", "HATCHLING"))], 0.75)


