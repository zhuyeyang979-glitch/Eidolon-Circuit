		if name.contains("NANO") or name.contains("MICRO") or mass <= 2.5 or momentum <= 70.0:
			return 0
		if name.contains("COLOSSUS") or name.contains("TITAN") or name.contains("SIEGE") or mass >= 34.0 or momentum >= 360.0:
