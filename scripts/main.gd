	var part := _selected_component(role_key, slot_key, part_index)
	return _catalog_display_part(slot_key, part)


func _show_editor_drag_ghost(slot_key: String, part_index: int, mouse_position: Vector2) -> void:
	if editor_drag_ghost_view == null or slot_key == "" or part_index < 0:
		return
	var part := _catalog_drag_display_part(slot_key, part_index)
	editor_drag_ghost_view.set_card(slot_key, part, false, ui_language, part_index, _catalog_card_title(slot_key, part, part_index, false), "", "")
	editor_drag_ghost_view.visible = true
	editor_drag_ghost_view.mouse_filter = Control.MOUSE_FILTER_IGNORE
	editor_drag_ghost_view.modulate = Color(1.0, 1.0, 1.0, 0.55)
	editor_drag_ghost_view.z_index = 250
	_update_editor_drag_ghost_position(mouse_position)


func _update_editor_drag_ghost_position(mouse_position: Vector2) -> void:
	if editor_drag_ghost_view == null or not editor_drag_ghost_view.visible:
		return
	editor_drag_ghost_view.position = mouse_position - editor_drag_ghost_view.size * 0.5
	editor_drag_ghost_view.queue_redraw()


func _hide_editor_drag_ghost() -> void:
	if editor_drag_ghost_view != null:
		editor_drag_ghost_view.visible = false


func _clear_editor_catalog_manual_drag() -> void:
	editor_drag_catalog_active = false
	editor_drag_catalog_started = false
	editor_drag_catalog_slot = ""
	editor_drag_catalog_index = -1
	editor_drag_catalog_start = Vector2.ZERO
	editor_drag_catalog_last = Vector2.ZERO
	_hide_editor_drag_ghost()
	_refresh_editor_visual_views()


func _handle_global_ui_right_click(mouse_position: Vector2) -> bool:
	if game_state != STATE_SCOUT:
		return false
	var button = _top_visible_button_at(mouse_position)
	var index := scout_player_buttons.find(button)
	if index < 0:
		return false
	var now := Time.get_ticks_msec()
	if now - ui_mouse_click_latch_msec < 120:
		return true
	ui_mouse_click_latch_msec = now
	var player_id := clampi(int(scout_sortie_player_id), 1, 2)
	var order := _all_roster_order(player_id)
	if index < 0 or index >= order.size():
		return false
	scout_hint_label.text = _set_sortie_starter_entry(player_id, order[index])
	_update_scout_ui()
	_play_sfx_wave("clack", 520.0, 0.035, -22.0)
	return true


func _top_visible_button_at(mouse_position: Vector2):
	var layers := [page_options_layer, format_select_layer, hud_layer, settings_layer, scout_layer, saved_units_layer, editor_layer, menu_layer]
	for layer in layers:
		if layer != null and layer.visible:
			var found = _find_button_at_recursive(layer, mouse_position)
			if found != null:
				return found
	return null


func _find_button_at_recursive(node: Node, mouse_position: Vector2):
	var children := node.get_children()
	for i in range(children.size() - 1, -1, -1):
		var found = _find_button_at_recursive(children[i], mouse_position)
		if found != null:
			return found
	if node is Button:
		var button := node as Button
		if button.is_visible_in_tree() and not button.disabled and button.get_global_rect().has_point(mouse_position):
			return button
	return null


func _trigger_button_mouse_fallback(button: Button) -> bool:
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("button.fallback_trigger")
	var now := Time.get_ticks_msec()
	if now - ui_mouse_click_latch_msec < 120:
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("button.fallback_trigger")
		return true
	ui_mouse_click_latch_msec = now
	button.emit_signal("pressed")
	_play_sfx_wave("clack", 620.0, 0.035, -22.0)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("button.fallback_trigger")
	return true


func _handle_main_menu_mouse_input(event: InputEvent) -> bool:
	if game_state != STATE_MENU or menu_layer == null or not menu_layer.visible:
		return false
	if event is InputEventMouseMotion:
		var hover_index := _menu_button_index_at_position((event as InputEventMouseMotion).position)
		if hover_index >= 0 and hover_index != menu_index:
			_hover_menu_item(hover_index)
		return false
	if event is InputEventMouseButton:
		var mouse_event := event as InputEventMouseButton
		if mouse_event.button_index != MOUSE_BUTTON_LEFT or not mouse_event.pressed:
			return false
		var click_index := _menu_button_index_at_position(mouse_event.position)
		if click_index < 0:
			return false
		_hover_menu_item(click_index)
		_activate_menu_item(click_index)
		return true
	return false


func _menu_button_index_at_position(mouse_position: Vector2) -> int:
	for i in range(menu_buttons.size()):
		var button: Button = menu_buttons[i]
		if button != null and button.visible and not button.disabled and button.get_global_rect().has_point(mouse_position):
			return i
	return -1


func _handle_menu_button_gui_input(event: InputEvent, index: int) -> void:
	if game_state != STATE_MENU:
		return
	if event is InputEventMouseMotion:
		_hover_menu_item(index)
	elif event is InputEventMouseButton:
		var mouse_event := event as InputEventMouseButton
		if mouse_event.button_index == MOUSE_BUTTON_LEFT and mouse_event.pressed:
			var now := Time.get_ticks_msec()
			if now - ui_mouse_click_latch_msec < 120:
				_mark_input_as_handled()
				return
			ui_mouse_click_latch_msec = now
			_hover_menu_item(index)
			_activate_menu_item(index)
			_mark_input_as_handled()


func _hover_menu_item(index: int) -> void:
	_apply_menu_selection_intent(_menu_select_index_intent(index))
	_update_menu_ui()


func _activate_menu_item(index: int) -> void:
	var action := _menu_main_action(index)
	match String(action.get("action", "")):
		"training_config":
			_show_training_config(true)
		"saved_units":
			_show_saved_units_library()
		"unit_edit":
			_show_editor()
		"show_ai_seat_panel":
			menu_index = maxi(0, _menu_index_for_action("show_ai_seat_panel"))
			_update_menu_ui()
		"pvp":
			_start_battle(MODE_PVP)
		"settings":
			_show_settings()
		_:
			get_tree().quit()


func _menu_move_selection_intent(delta: int) -> Dictionary:
	if menu_mode_owner != null:
		return menu_mode_owner.move_selection(delta, menu_index, MENU_ITEMS.size())
	return {
		"handled": MENU_ITEMS.size() > 0,
		"selected_index": _wrapped_index(menu_index + delta, MENU_ITEMS.size()),
		"used_controller": false,
	}


func _menu_select_index_intent(index: int) -> Dictionary:
	if menu_mode_owner != null:
		return menu_mode_owner.select_index(index, MENU_ITEMS.size())
	return {
		"handled": MENU_ITEMS.size() > 0,
		"selected_index": clampi(index, 0, MENU_ITEMS.size() - 1),
		"used_controller": false,
	}


func _menu_input_action_intent(action_name: String) -> Dictionary:
	if menu_mode_owner != null:
		return menu_mode_owner.input_action_intent(action_name, menu_index, MENU_ITEMS.size())
	match action_name:
		"menu_up":
			var up_intent := _menu_move_selection_intent(-1)
			up_intent["kind"] = "selection"
			up_intent["input_action"] = action_name
			return up_intent
		"menu_down":
			var down_intent := _menu_move_selection_intent(1)
			down_intent["kind"] = "selection"
			down_intent["input_action"] = action_name
			return down_intent
		"menu_confirm":
			return {
				"handled": MENU_ITEMS.size() > 0,
				"kind": "activate",
				"input_action": action_name,
				"index": menu_index,
			}
	return {"handled": false, "kind": "", "input_action": action_name}


func _apply_menu_input_action(action_name: String) -> void:
	var intent := _menu_input_action_intent(action_name)
	if not bool(intent.get("handled", false)):
		return
	match String(intent.get("kind", "")):
		"selection":
			_apply_menu_selection_intent(intent)
			_update_menu_ui()
		"activate":
			_activate_menu_item(int(intent.get("index", menu_index)))


func _apply_menu_selection_intent(intent: Dictionary) -> void:
	if not bool(intent.get("handled", false)):
		return
	menu_index = int(intent.get("selected_index", menu_index))


func _menu_main_action(index: int) -> Dictionary:
	if menu_mode_owner != null:
		return menu_mode_owner.main_menu_action(index)
	if menu_controller != null:
		return menu_controller.main_menu_action(index)
	return {"action": "", "index": index}


func _handle_scout_input(delta: float) -> void:
	if star_soul_bp_active:
		if Input.is_action_just_pressed("menu_back"):
			_cancel_star_soul_bp()
		return
	if Input.is_action_just_pressed("menu_back"):
		_show_menu()
		return
	if Input.is_action_just_pressed("menu_confirm"):
		_try_begin_battle_from_scout()
		return
	if Input.is_action_just_pressed("p1_up"):
		_select_scout_relative(-1)
	elif Input.is_action_just_pressed("p1_down"):
		_select_scout_relative(1)
	_update_scout_ui()


func _try_begin_battle_from_scout() -> void:
	var training_begin_intent := _training_begin_from_scout_intent()
	if bool(training_begin_intent.get("handled", false)):
		match String(training_begin_intent.get("action", "")):
			"require_training_seat":
				scout_timer = maxf(scout_timer, 8.0)
				if scout_hint_label != null:
					scout_hint_label.text = "请先点击 P1、P2 或 P3 选择训练入场席位。" if _ui_is_zh() else "Choose P1, P2, or P3 before entering training."
				if bool(training_begin_intent.get("play_alarm", true)):
					_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
				_update_scout_ui()
				return
			"configure_and_begin_training":
				if not _configure_training_sides_for_seat():
					scout_timer = maxf(scout_timer, 8.0)
					if scout_hint_label != null:
						scout_hint_label.text = "训练入场失败：%s" % _localized_system_text(training_import_error_note) if _ui_is_zh() else "Training entry failed: %s" % training_import_error_note
					_update_scout_ui()
					return
				_begin_battle(String(training_begin_intent.get("pending_mode", pending_battle_mode)), true)
				return
	var blocking := _formal_battle_start_blocking_summary(pending_battle_mode)
	if not blocking.is_empty():
		_block_formal_battle_start(blocking)
		return
	if pending_battle_mode == MODE_PVP:
		_show_star_soul_bp(pending_battle_mode)
		return
	_begin_battle(pending_battle_mode)


func _show_star_soul_bp(mode: String) -> void:
	if mode != MODE_PVP:
		_begin_battle(mode)
		return
	if star_soul_bp_screen_service == null:
		star_soul_bp_screen_service = StarSoulBPScreenService.new()
	if star_soul_bp_view == null:
		_build_star_soul_bp_ui()
	star_soul_bp_pending_mode = mode
	star_soul_bp_model = star_soul_bp_screen_service.initial_model(1, 10)
	star_soul_battle_draft_payload = {}
	star_soul_bp_active = true
	_set_visible_layer(star_soul_bp_view)
	star_soul_bp_view.set_model(star_soul_bp_model, "zh" if _ui_is_zh() else "en")


func _on_star_soul_bp_selected(player: int, star_soul_id: String) -> void:
	if not star_soul_bp_active or star_soul_bp_screen_service == null:
		return
	var intent: Dictionary = star_soul_bp_screen_service.pick_intent(star_soul_bp_model, player, star_soul_id)
	if not bool(intent.get("accepted", false)):
		return
	star_soul_bp_model = Dictionary(intent.get("model", {})).duplicate(true)
	star_soul_bp_view.set_model(star_soul_bp_model, "zh" if _ui_is_zh() else "en")


func _on_star_soul_bp_confirmed(player: int) -> void:
	if not star_soul_bp_active or star_soul_bp_screen_service == null:
		return
	var intent: Dictionary = star_soul_bp_screen_service.confirm_intent(star_soul_bp_model, player)
	if not bool(intent.get("accepted", false)):
		return
	star_soul_bp_model = Dictionary(intent.get("model", {})).duplicate(true)
	star_soul_bp_view.set_model(star_soul_bp_model, "zh" if _ui_is_zh() else "en")
	if bool(star_soul_bp_model.get("complete", false)):
		_complete_star_soul_bp()


func _complete_star_soul_bp() -> void:
	var draft_payload: Dictionary = Dictionary(star_soul_bp_model.get("draft_payload", {})).duplicate(true)
	if not bool(draft_payload.get("valid", false)):
		return
	star_soul_battle_draft_payload = draft_payload
	star_soul_bp_active = false
	if star_soul_bp_view != null:
		star_soul_bp_view.close()
	var mode := star_soul_bp_pending_mode if star_soul_bp_pending_mode != "" else MODE_PVP
	star_soul_bp_pending_mode = ""
	var blocking := _formal_battle_start_blocking_summary(mode)
	if not blocking.is_empty():
		_block_formal_battle_start(blocking)
		return
	_begin_battle(mode, true, "star_soul_bp_complete")


func _cancel_star_soul_bp() -> void:
	star_soul_bp_active = false
	star_soul_bp_pending_mode = ""
	star_soul_bp_model = {}
	star_soul_battle_draft_payload = {}
	if star_soul_bp_view != null:
		star_soul_bp_view.close()
	_set_visible_layer(scout_layer)
	_update_scout_ui()


func _handle_editor_input() -> void:
	if Input.is_action_just_pressed("menu_back"):
		_show_menu()
		return
	if Input.is_action_just_pressed("copy_team"):
		var source_player := _editor_player()
		var target_player := 2 if source_player == 1 else 1
		blueprints[target_player] = blueprints[source_player].duplicate(true)
		active_roster_indices[target_player] = active_roster_indices[source_player].duplicate(true)
		initial_role[target_player] = initial_role[source_player]
		sortie_loadouts[target_player] = []
		initial_sortie_slot[target_player] = 0
		summon_pair_bindings[target_player] = summon_pair_bindings[source_player].duplicate(true)
		ai_team_manual_lock[target_player] = true
		editor_summary_label.text = "已将 P%d 队伍编辑配置复制到 P%d/电脑配置。" % [source_player, target_player] if _ui_is_zh() else "Copied P%d TeamEdit roster to P%d/computer loadout." % [source_player, target_player]
		return
	for attack_key in range(1, ATTACK_GROUP_COUNT + 1):
		if Input.is_action_just_pressed("p1_attack_%d" % attack_key):
			if _tryout_editor_bound_module(attack_key):
				return
	if Input.is_action_just_pressed("editor_next_unit"):
		_select_adjacent_editor_unit_page(1)
		return
	if Input.is_action_just_pressed("editor_add_unit"):
		_add_roster_unit()
		return
	if Input.is_action_just_pressed("editor_delete_unit"):
		_delete_roster_unit()
		return
	if Input.is_action_just_pressed("editor_set_initial"):
		editor_summary_label.text = "TeamEdit 只编辑%s队伍；首发请在战斗前的出战选择界面决定。" % _match_format_name() if _ui_is_zh() else "TeamEdit only builds the %s roster; choose starter in the pre-battle sortie screen." % _match_format_name()
		return
	if Input.is_action_just_pressed("editor_next_role"):
		editor_role_index = _wrapped_index(editor_role_index + 1, ROLE_ORDER.size())
		editor_roster_page = 0
		_reset_editor_unit_page_transient_state(false)
		_apply_editor_role_catalog_defaults(ROLE_ORDER[editor_role_index])
		_update_editor_ui()
	if Input.is_action_just_pressed("p1_up"):
		editor_slot_index = _wrapped_index(editor_slot_index - 1, BUILD_SLOTS.size())
		_apply_editor_slot_catalog_defaults(ROLE_ORDER[editor_role_index], _editor_current_blueprint(), String(BUILD_SLOTS[editor_slot_index]))
		editor_catalog_page = 0
		_update_editor_ui()
	elif Input.is_action_just_pressed("p1_down"):
		editor_slot_index = _wrapped_index(editor_slot_index + 1, BUILD_SLOTS.size())
		_apply_editor_slot_catalog_defaults(ROLE_ORDER[editor_role_index], _editor_current_blueprint(), String(BUILD_SLOTS[editor_slot_index]))
		editor_catalog_page = 0
		_update_editor_ui()
	if Input.is_action_just_pressed("p1_left"):
		_cycle_component(-1)
	elif Input.is_action_just_pressed("p1_right"):
		_cycle_component(1)


func _handle_settings_input() -> void:
	if settings_rebind_action != "":
		if Input.is_action_just_pressed("menu_back"):
			_cancel_battle_input_rebind()
		return
	if Input.is_action_just_pressed("menu_back"):
		if settings_category != "root":
			_show_settings_category("root")
		else:
			_show_menu()
		return
	if Input.is_action_just_pressed("menu_confirm"):
		_activate_settings_item(settings_index)
		return
	if Input.is_action_just_pressed("menu_up"):
		settings_index = _wrapped_index(settings_index - 1, max(1, settings_labels.size()))
		_update_settings_ui()
	elif Input.is_action_just_pressed("menu_down"):
		settings_index = _wrapped_index(settings_index + 1, max(1, settings_labels.size()))
		_update_settings_ui()
	elif Input.is_action_just_pressed("p1_left") or Input.is_action_just_pressed("p1_right"):
		_activate_settings_item(settings_index)


func _select_settings_item(index: int) -> void:
	settings_index = clampi(index, 0, max(0, settings_labels.size() - 1))
	_update_settings_ui()


func _activate_settings_item(index: int) -> void:
	settings_index = clampi(index, 0, max(0, settings_labels.size() - 1))
	if settings_index < 0 or settings_index >= settings_labels.size():
		return
	var button: Button = settings_labels[settings_index]
	if button.has_meta("video_action"):
		match String(button.get_meta("video_action", "")):
			"performance_profile":
				_cycle_performance_profile(1)
			"display_mode":
				_cycle_display_mode_setting(1)
			"window_size":
				_cycle_window_size_setting(1)
		return
	var spec_index := int(button.get_meta("spec_index", -1))
	if spec_index < 0 or spec_index >= battle_input_binding_specs.size():
		return
	var spec: Dictionary = battle_input_binding_specs[spec_index]
	if bool(spec.get("info", false)):
		return
	_begin_battle_input_rebind(String(spec.get("action", "")))
	_update_settings_ui()


func _battle_input_specs() -> Array:
	var specs: Array = []
	for prefix in ["p1", "p2"]:
		var player_label := "P1" if prefix == "p1" else "P2"
		specs.append({"info": true, "group_title_zh": "%s 英雄高频操作 / Hero" % player_label, "group_title_en": "%s HIGH-FREQUENCY HERO" % player_label})
		specs.append({"info": true, "group_title_zh": "%s 方向 / Direction" % player_label, "group_title_en": "%s DIRECTION" % player_label})
		specs.append({"action": "%s_up" % prefix, "group": "%s_direction" % prefix, "zh": "%s 上" % player_label, "en": "%s Up" % player_label})
		specs.append({"action": "%s_down" % prefix, "group": "%s_direction" % prefix, "zh": "%s 下" % player_label, "en": "%s Down" % player_label})
		specs.append({"action": "%s_left" % prefix, "group": "%s_direction" % prefix, "zh": "%s 左" % player_label, "en": "%s Left" % player_label})
		specs.append({"action": "%s_right" % prefix, "group": "%s_direction" % prefix, "zh": "%s 右" % player_label, "en": "%s Right" % player_label})
		specs.append({"info": true, "group_title_zh": "%s Boost：方向键双击，斜向按住组合后双击任一键" % player_label, "group_title_en": "%s BOOST: double-tap direction; diagonals use held combo" % player_label})
		specs.append({"info": true, "group_title_zh": "%s 转向 / Turn" % player_label, "group_title_en": "%s TURN" % player_label})
		specs.append({"action": "%s_face_left" % prefix, "group": "%s_turn" % prefix, "zh": "%s 左转" % player_label, "en": "%s Turn Left" % player_label})
		specs.append({"action": "%s_face_right" % prefix, "group": "%s_turn" % prefix, "zh": "%s 右转" % player_label, "en": "%s Turn Right" % player_label})
		specs.append({"action": "%s_cool" % prefix, "group": "%s_hero_system" % prefix, "zh": "%s 手动冷却" % player_label, "en": "%s Manual Cooling" % player_label})
		specs.append({"info": true, "group_title_zh": "%s 攻击 / Attack" % player_label, "group_title_en": "%s ATTACK" % player_label})
		for attack_index in range(1, ATTACK_GROUP_COUNT + 1):
			specs.append({
				"action": "%s_attack_%d" % [prefix, attack_index],
				"group": "%s_attack" % prefix,
				"zh": "%s 攻击%d" % [player_label, attack_index],
				"en": "%s Attack %d" % [player_label, attack_index],
			})
		specs.append({"info": true, "group_title_zh": "%s 战术低频：入口与双攻击键部署" % player_label, "group_title_en": "%s LOW-FREQUENCY TACTICS: portal and pair-summon" % player_label})
		specs.append({"action": "%s_portal" % prefix, "group": "%s_tactics" % prefix, "zh": "%s 切换入场点" % player_label, "en": "%s Tactical Portal" % player_label})
		specs.append({"info": true, "group_title_zh": "%s 出击槽部署由队伍预设的双攻击键触发；傀儡/屏障不开放运行时直接微操。" % player_label, "group_title_en": "%s sortie slots deploy through preset paired attack buttons; puppets/barriers have no runtime direct micro." % player_label})
	return specs


func _battle_input_action_group(action_name: String) -> String:
	for raw_spec in battle_input_binding_specs:
		if raw_spec is Dictionary and String(raw_spec.get("action", "")) == action_name:
			return String(raw_spec.get("group", action_name))
	return action_name


func _event_to_binding_dict(event: InputEvent) -> Dictionary:
	if event is InputEventKey:
		var key_event := event as InputEventKey
		if not key_event.pressed or key_event.echo:
			return {}
		var keycode := key_event.physical_keycode if key_event.physical_keycode != 0 else key_event.keycode
		if keycode == 0:
			return {}
		return {"type": "key", "physical_keycode": keycode}
	if event is InputEventJoypadButton:
		var button_event := event as InputEventJoypadButton
		if not button_event.pressed:
			return {}
		return {"type": "joy_button", "device": button_event.device, "button_index": button_event.button_index}
	if event is InputEventJoypadMotion:
		var motion_event := event as InputEventJoypadMotion
		if absf(motion_event.axis_value) < 0.55:
			return {}
		return {"type": "joy_axis", "device": motion_event.device, "axis": motion_event.axis, "axis_value": 1.0 if motion_event.axis_value > 0.0 else -1.0}
	return {}


func _binding_dict_to_event(binding: Dictionary):
	var kind := String(binding.get("type", ""))
	if kind == "key":
		var event := InputEventKey.new()
		event.physical_keycode = int(binding.get("physical_keycode", binding.get("keycode", 0)))
		return event
	if kind == "joy_button":
		var event := InputEventJoypadButton.new()
		event.device = int(binding.get("device", 0))
		event.button_index = int(binding.get("button_index", JOY_BUTTON_A))
		return event
	if kind == "joy_axis":
		var event := InputEventJoypadMotion.new()
		event.device = int(binding.get("device", 0))
		event.axis = int(binding.get("axis", JOY_AXIS_LEFT_X))
		event.axis_value = float(binding.get("axis_value", 1.0))
		return event
	return null


func _binding_dict_key(binding: Dictionary) -> String:
	var kind := String(binding.get("type", ""))
	if kind == "key":
		return "key:%d" % int(binding.get("physical_keycode", binding.get("keycode", 0)))
	if kind == "joy_button":
		return "joy_button:%d:%d" % [int(binding.get("device", 0)), int(binding.get("button_index", 0))]
	if kind == "joy_axis":
		var axis_sign := 1 if float(binding.get("axis_value", 1.0)) >= 0.0 else -1
		return "joy_axis:%d:%d:%d" % [int(binding.get("device", 0)), int(binding.get("axis", 0)), axis_sign]
	return ""


func _event_binding_label(binding: Dictionary) -> String:
	var kind := String(binding.get("type", ""))
	if kind == "key":
		return OS.get_keycode_string(int(binding.get("physical_keycode", binding.get("keycode", 0))))
	if kind == "joy_button":
		return "Pad%d Btn%d" % [int(binding.get("device", 0)) + 1, int(binding.get("button_index", 0))]
	if kind == "joy_axis":
		var sign_label := "+" if float(binding.get("axis_value", 1.0)) > 0.0 else "-"
		return "Pad%d Axis%d%s" % [int(binding.get("device", 0)) + 1, int(binding.get("axis", 0)), sign_label]
	return "-"


func _action_binding_label(action_name: String) -> String:
	if not InputMap.has_action(action_name):
		return "-"
	var labels: Array = []
	for event in InputMap.action_get_events(action_name):
		var binding := _event_to_binding_dict_for_existing(event)
		if not binding.is_empty():
			labels.append(_event_binding_label(binding))
		if labels.size() >= 3:
			break
	return " / ".join(labels) if not labels.is_empty() else "-"


func _event_to_binding_dict_for_existing(event: InputEvent) -> Dictionary:
	if event is InputEventKey:
		var key_event := event as InputEventKey
		var keycode := key_event.physical_keycode if key_event.physical_keycode != 0 else key_event.keycode
		return {"type": "key", "physical_keycode": keycode}
	if event is InputEventJoypadButton:
		var button_event := event as InputEventJoypadButton
		return {"type": "joy_button", "device": button_event.device, "button_index": button_event.button_index}
	if event is InputEventJoypadMotion:
		var motion_event := event as InputEventJoypadMotion
		return {"type": "joy_axis", "device": motion_event.device, "axis": motion_event.axis, "axis_value": 1.0 if motion_event.axis_value > 0.0 else -1.0}
	return {}


func _save_battle_input_bindings() -> void:
	var payload := {"schema_version": 1, "bindings": {}}
	for raw_spec in battle_input_binding_specs:
		if not (raw_spec is Dictionary):
			continue
		var action_name := String(Dictionary(raw_spec).get("action", ""))
		if action_name == "" or not InputMap.has_action(action_name):
			continue
		var bindings: Array = []
		for event in InputMap.action_get_events(action_name):
			var binding := _event_to_binding_dict_for_existing(event)
			if not binding.is_empty():
				bindings.append(binding)
		payload["bindings"][action_name] = bindings
	var file := FileAccess.open(BATTLE_INPUT_BINDINGS_PATH, FileAccess.WRITE)
	if file != null:
		file.store_string(JSON.stringify(payload, "\t"))


func _load_battle_input_bindings() -> void:
	if not FileAccess.file_exists(BATTLE_INPUT_BINDINGS_PATH):
		return
	var parsed = JSON.parse_string(FileAccess.get_file_as_string(BATTLE_INPUT_BINDINGS_PATH))
	if not (parsed is Dictionary):
		return
	var bindings: Dictionary = parsed.get("bindings", {})
	for action_name in bindings.keys():
		if not InputMap.has_action(String(action_name)):
			InputMap.add_action(String(action_name))
		for event in InputMap.action_get_events(String(action_name)):
			InputMap.action_erase_event(String(action_name), event)
		for binding in Array(bindings[action_name]):
			if not (binding is Dictionary):
				continue
			var event: InputEvent = _binding_dict_to_event(binding)
			if event != null:
				InputMap.action_add_event(String(action_name), event)


func _reset_battle_input_bindings_to_default() -> void:
	if FileAccess.file_exists(BATTLE_INPUT_BINDINGS_PATH):
		DirAccess.remove_absolute(BATTLE_INPUT_BINDINGS_PATH)
	_bind_player_inputs("p1", 0, true)
	_bind_player_inputs("p2", 1, false)
	battle_input_binding_specs = _battle_input_specs()
	settings_rebind_action = ""
	_update_settings_ui()


func _begin_battle_input_rebind(action_name: String) -> void:
	if action_name == "":
		return
	settings_rebind_action = action_name
	if settings_rebind_status_label != null:
		settings_rebind_status_label.text = "按下键盘键或手柄输入..." if _ui_is_zh() else "Press a key or controller input..."
		settings_rebind_status_label.modulate = Color(1.0, 0.86, 0.28, 1.0)
	_update_settings_ui()


func _cancel_battle_input_rebind() -> void:
	settings_rebind_action = ""
	if settings_rebind_status_label != null:
		settings_rebind_status_label.text = "已取消" if _ui_is_zh() else "Canceled"
		settings_rebind_status_label.modulate = Color(0.9, 0.94, 1.0, 0.86)
	_update_settings_ui()


func _remove_binding_conflicts(action_name: String, binding: Dictionary) -> void:
	var target_group := _battle_input_action_group(action_name)
	var binding_key := _binding_dict_key(binding)
	if binding_key == "":
		return
	for raw_spec in battle_input_binding_specs:
		if not (raw_spec is Dictionary):
			continue
		var spec: Dictionary = raw_spec
		var other_action := String(spec.get("action", ""))
		if other_action == "" or other_action == action_name:
			continue
		if String(spec.get("group", "")) != target_group:
			continue
		if not InputMap.has_action(other_action):
			continue
		for event in InputMap.action_get_events(other_action):
			var existing := _event_to_binding_dict_for_existing(event)
			if _binding_dict_key(existing) == binding_key:
				InputMap.action_erase_event(other_action, event)


func _handle_battle_input_rebind_event(event: InputEvent) -> bool:
	if settings_rebind_action == "":
		return false
	if event is InputEventMouseButton:
		return false
	if event is InputEventKey:
		var key_event := event as InputEventKey
		var keycode := key_event.physical_keycode if key_event.physical_keycode != 0 else key_event.keycode
		if key_event.pressed and not key_event.echo and keycode == KEY_ESCAPE:
			_cancel_battle_input_rebind()
			return true
		if key_event.pressed and not key_event.echo and (keycode == KEY_ENTER or keycode == KEY_KP_ENTER):
			if settings_rebind_status_label != null:
				settings_rebind_status_label.text = "Enter 保留给数值输入，不能绑定为战斗按键。" if _ui_is_zh() else "Enter is reserved for numeric input and cannot be bound to battle actions."
				settings_rebind_status_label.modulate = Color(1.0, 0.74, 0.42, 1.0)
			return true
	var binding := _event_to_binding_dict(event)
	if binding.is_empty():
		return false
	if not InputMap.has_action(settings_rebind_action):
		InputMap.add_action(settings_rebind_action)
	_remove_binding_conflicts(settings_rebind_action, binding)
	for existing_event in InputMap.action_get_events(settings_rebind_action):
		InputMap.action_erase_event(settings_rebind_action, existing_event)
	var input_event: InputEvent = _binding_dict_to_event(binding)
	if input_event != null:
		InputMap.action_add_event(settings_rebind_action, input_event)
	_save_battle_input_bindings()
	if settings_rebind_status_label != null:
		settings_rebind_status_label.text = ("已绑定：%s" % _event_binding_label(binding)) if _ui_is_zh() else ("Bound: %s" % _event_binding_label(binding))
		settings_rebind_status_label.modulate = Color(0.45, 1.0, 0.62, 1.0)
	settings_rebind_action = ""
	_update_settings_ui()
	return true


func _cycle_component(direction: int) -> void:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var slot_key: String = BUILD_SLOTS[editor_slot_index]
	var catalog: Array = _catalog_for(role_key, slot_key)
	var unit_bp: Dictionary = _editor_current_blueprint()
	var current_archetype := String(unit_bp.get("archetype", "crab"))
	for archetype_key in editor_archetype_buttons.keys():
		var frame_button: Button = editor_archetype_buttons[archetype_key]
		frame_button.modulate = Color(0.32, 0.95, 1.0, 1.0) if archetype_key == current_archetype and _role_uses_body_board(role_key) else Color(0.86, 0.9, 0.94, 1.0)
		frame_button.disabled = not _role_uses_body_board(role_key)
	if role_key == "barrier" and _barrier_uses_screen_board(unit_bp) and _is_topology_part_slot(slot_key):
		var next_index := _wrapped_index(int(unit_bp.get(slot_key, 0)) + direction, catalog.size())
		unit_bp[slot_key] = next_index
		_set_pending_canvas_part(unit_bp, slot_key, next_index)
		editor_board_hint_label.text = "已选择：%s。点击结界屏幕格放置/替换。" % _pending_canvas_part_name(role_key) if _ui_is_zh() else "Selected: %s. Click a barrier screen cell to place/replace." % _pending_canvas_part_name(role_key)
		_play_sfx_wave("clack", 640.0, 0.04, -18.0)
		ai_team_manual_lock[player_id] = true
		_mark_editor_board_interaction_dirty("shop.pending_barrier_part", false)
		return
	if _role_uses_body_board(role_key) and unit_bp.has("custom_topology") and _is_body_group_slot(slot_key):
		if _is_topology_part_slot(slot_key):
			var next_index := _wrapped_index(int(unit_bp.get(slot_key, 0)) + direction, catalog.size())
			_set_pending_canvas_part(unit_bp, slot_key, next_index)
			editor_board_hint_label.text = "已选择：%s。可直接拖卡片进画布，也可点击画布放置/替换。" % _pending_canvas_part_name(role_key)
			_play_sfx_wave("clack", 640.0, 0.04, -18.0)
			ai_team_manual_lock[player_id] = true
			_mark_editor_board_interaction_dirty("shop.pending_part", false)
			return
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		var nodes: Array = topology.get("nodes", [])
		if not nodes.is_empty():
			editor_topology_node_index = clampi(editor_topology_node_index, 0, nodes.size() - 1)
			var node: Dictionary = nodes[editor_topology_node_index]
			var next_node_index := _wrapped_index(int(node.get(slot_key, unit_bp.get(slot_key, 0))) + direction, catalog.size())
			node = _set_topology_node_slot(node, slot_key, next_node_index)
			nodes[editor_topology_node_index] = node
			topology["nodes"] = nodes
			unit_bp["custom_topology"] = topology
			editor_selected_topology_nodes = [editor_topology_node_index]
			_trigger_editor_snap("node", String(catalog[next_node_index].get("name", "")))
			ai_team_manual_lock[player_id] = true
			_update_editor_ui()
			return
	unit_bp[slot_key] = _wrapped_index(int(unit_bp.get(slot_key, 0)) + direction, catalog.size())
	ai_team_manual_lock[player_id] = true
	_update_editor_ui()


func _select_editor_body_part(part_key: String) -> void:
	editor_selected_body_part = part_key
	editor_snap_timer = 0.12
	editor_snap_part = part_key
	_update_editor_ui()


func _role_uses_body_board(role_key: String) -> bool:
	return role_key in ["hero", "puppet", "barrier"]


func _barrier_uses_screen_board(unit_bp: Dictionary) -> bool:
	var role_key := String(unit_bp.get("role", ""))
	if role_key != "" and role_key != "barrier":
		return false
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	return Array(topology.get("nodes", [])).is_empty() and Array(topology.get("edges", [])).is_empty()


func _is_body_group_slot(slot_key: String) -> bool:
	return BODY_GROUP_SLOTS.has(slot_key)


func _is_topology_part_slot(slot_key: String) -> bool:
	return TOPOLOGY_PART_SLOTS.has(slot_key)


func _topology_node_is_component(node: Dictionary) -> bool:
	return node.has("slot") and _is_topology_part_slot(String(node.get("slot", "")))


func _topology_uses_component_nodes(nodes: Array) -> bool:
	for node in nodes:
		if node is Dictionary and _topology_node_is_component(node):
			return true
	return false


func _topology_node_slot(node: Dictionary) -> String:
	return String(node.get("slot", ""))


func _topology_slot_family(slot_key: String) -> String:
	if slot_key == "joint":
		return "legacy_joint"
	if slot_key == "limb_muscle" or slot_key == "muscle":
		return "muscle"
	return "other"


func _topology_node_part_index(node: Dictionary, unit_bp: Dictionary) -> int:
	var slot_key := _topology_node_slot(node)
	if slot_key == "":
		return 0
	return int(node.get("part_index", node.get(slot_key, unit_bp.get(slot_key, 0))))


func _topology_node_part_name_candidates(node: Dictionary) -> Array:
	var result: Array = []
	for key in ["name", "component_name", "part_name"]:
		var value := String(node.get(key, "")).strip_edges()
		if value != "" and not result.has(value):
			result.append(value)
	return result


func _topology_node_part_identity_score(slot_key: String, node: Dictionary, part: Dictionary) -> int:
	if part.is_empty():
		return -100000
	var score := 0
	var node_material := String(node.get("material_class", "")).to_lower()
	var node_role := String(node.get("catalog_role", "")).to_lower()
	var node_category := String(node.get("part_category", "")).to_lower()
	var part_material := String(part.get("material_class", "")).to_lower()
	var part_role := _catalog_role_for_part(slot_key, part)
	var part_category := _catalog_part_category_for_part(slot_key, part)
	var node_torso_hint := bool(node.get("is_torso", false)) or node_material == "torso" or node_role in ["torso", "brain_torso"] or node_category == "torso"
	if node_torso_hint:
		score += 100 if _component_is_torso(part) else -100
	elif node.has("is_torso") and _component_is_torso(part):
		score -= 24
	if node_material != "":
		score += 24 if node_material == part_material else -8
	if node_role != "":
		score += 20 if node_role == part_role else -12
	if node_category != "":
		score += 16 if node_category == part_category else -8
	if node.has("terminal_weapon") and bool(node.get("terminal_weapon", false)) == bool(part.get("terminal_weapon", false)):
		score += 8
	if node.has("projectile") and bool(node.get("projectile", false)) == bool(part.get("projectile", false)):
		score += 8
	var node_shape := String(node.get("shape", "")).to_lower()
	if node_shape != "" and node_shape == String(part.get("shape", "")).to_lower():
		score += 6
	return score


func _topology_node_resolved_part_index(role_key: String, node: Dictionary, unit_bp: Dictionary) -> int:
	var slot_key := _topology_node_slot(node)
	if slot_key == "":
		return 0
	var best_index := -1
	var best_score := -1000000
	var name_priority := 0
	for saved_name in _topology_node_part_name_candidates(node):
		var resolved := _component_index_by_exact_name(role_key, slot_key, String(saved_name))
		if resolved < 0:
			name_priority += 1
			continue
		var part := _selected_component(role_key, slot_key, resolved)
		var score := _topology_node_part_identity_score(slot_key, node, part) + maxi(0, 8 - name_priority)
		if score > best_score:
			best_score = score
			best_index = resolved
		name_priority += 1
	if best_index >= 0 and best_score >= 0:
		return best_index
	return _topology_node_part_index(node, unit_bp)


func _topology_node_part(role_key: String, node: Dictionary, unit_bp: Dictionary) -> Dictionary:
	var slot_key := _topology_node_slot(node)
	if not _is_topology_part_slot(slot_key):
		return {}
	var part := _selected_component(role_key, slot_key, _topology_node_resolved_part_index(role_key, node, unit_bp))
	for override_key in [
		"embedded_joint_kind",
		"embedded_joint_angle",
		"embedded_joint_extension",
		"embedded_joint_output_momentum",
		"embedded_joint_momentum_capacity",
		"terminal_weapon_kind",
	]:
		if node.has(override_key):
			part[override_key] = node[override_key]
	return part


func _topology_node_is_torso(role_key: String, node: Dictionary, unit_bp: Dictionary) -> bool:
	if not _topology_node_is_component(node):
		return false
	var slot_key := _topology_node_slot(node)
	if slot_key != "muscle":
		return false
	return _component_is_torso(_topology_node_part(role_key, node, unit_bp))


func _topology_torso_nodes(unit_bp: Dictionary) -> Array:
	var result: Array = []
	var role_key: String = String(unit_bp.get("role", ROLE_ORDER[editor_role_index]))
	if not unit_bp.has("custom_topology"):
		return result
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	for i in range(nodes.size()):
		if nodes[i] is Dictionary and _topology_node_is_torso(role_key, nodes[i], unit_bp):
			result.append(i)
	return result


func _first_torso_node_index(unit_bp: Dictionary) -> int:
	var torsos := _topology_torso_nodes(unit_bp)
	return int(torsos[0]) if not torsos.is_empty() else -1


func _active_torso_node_index_for_payload_install(unit_bp: Dictionary) -> int:
	var torsos := _topology_torso_nodes(unit_bp)
	if torsos.is_empty():
		return -1
	if torsos.has(editor_open_torso_node_index):
		return editor_open_torso_node_index
	var role_key: String = String(unit_bp.get("role", ROLE_ORDER[editor_role_index]))
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if editor_topology_node_index >= 0 and editor_topology_node_index < nodes.size() and _topology_node_is_torso(role_key, nodes[editor_topology_node_index], unit_bp):
		return editor_topology_node_index
	return int(torsos[0])


func _torso_payload_belongs_to_node(payload: Dictionary, torso_node_index: int, unit_bp: Dictionary) -> bool:
	if torso_node_index < 0:
		return false
	if payload.has("torso_node"):
		return int(payload.get("torso_node", -1)) == torso_node_index
	return torso_node_index == _first_torso_node_index(unit_bp)


func _payload_torso_node_index(payload: Dictionary, unit_bp: Dictionary) -> int:
	if payload.has("torso_node"):
		return int(payload.get("torso_node", -1))
	return _first_torso_node_index(unit_bp)


func _topology_owner_torso_node_for_node(role_key: String, unit_bp: Dictionary, node_index: int) -> int:
	if not unit_bp.has("custom_topology"):
		return -1
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", []))
	var edges: Array = Array(topology.get("edges", []))
	if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
		return -1
	if _topology_node_is_torso(role_key, nodes[node_index], unit_bp):
		return node_index
	var current := node_index
	var guard := 0
	while current >= 0 and current < nodes.size() and guard < 32:
		guard += 1
		var parent_info := _topology_parent_edge_info(role_key, unit_bp, nodes, edges, current)
		if parent_info.is_empty():
			break
		var parent_index := int(parent_info.get("parent", -1))
		if parent_index < 0 or parent_index >= nodes.size():
			break
		if _topology_node_is_torso(role_key, nodes[parent_index], unit_bp):
			return parent_index
		current = parent_index
	var component := _topology_connected_component_indices(edges, nodes.size(), [node_index])
	for raw_index in component:
		var index := int(raw_index)
		if index >= 0 and index < nodes.size() and nodes[index] is Dictionary and _topology_node_is_torso(role_key, nodes[index], unit_bp):
			return index
	return _first_torso_node_index(unit_bp)


func _module_binding_torso_node_index(role_key: String, unit_bp: Dictionary, binding: Dictionary) -> int:
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", []))
	var explicit_torso := int(binding.get("target_torso_node", -1))
	if explicit_torso >= 0 and explicit_torso < nodes.size() and nodes[explicit_torso] is Dictionary and _topology_node_is_torso(role_key, nodes[explicit_torso], unit_bp):
		return explicit_torso
	for raw_node in Array(binding.get("target_nodes", [])):
		var owner := _topology_owner_torso_node_for_node(role_key, unit_bp, int(raw_node))
		if owner >= 0:
			return owner
	return -1


