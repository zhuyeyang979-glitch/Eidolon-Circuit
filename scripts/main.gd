func _scrub_legacy_power_stats(stats: Dictionary) -> Dictionary:
	var cleaned := stats.duplicate(true)
	if not cleaned.has("move_momentum") and cleaned.has("thruster_momentum"):
		cleaned["move_momentum"] = maxf(0.0, float(cleaned.get("thruster_momentum", 0.0)))
	for key in _legacy_power_field_keys():
		cleaned.erase(key)
	for key in [
		"engine_momentum_output",
		"engine_momentum_budget",
		"engine_joint_momentum_budget",
		"engine_thruster_momentum_budget",
		"engine_momentum_required",
		"engine_momentum_margin",
		"engine_momentum_ratio",
		"engine_momentum_note",
		"thruster_boost_brake_allocated_momentum",
		"boost_total_momentum",
		"thruster_duration",
		"engine_drive_chain_ratio",
		"engine_boost_chain_ratio",
		"thruster_effective_drive_demand",
		"thruster_effective_boost_peak_demand",
	]:
		cleaned.erase(key)
	return cleaned


func _compute_unit_stats(player_id: int, role_key: String, unit_index: int = -1, override_bp: Dictionary = {}) -> Dictionary:
	editor_compute_unit_stats_count += 1
	var resolved_index := int(active_roster_indices[player_id][role_key]) if unit_index < 0 else unit_index
	var unit_bp: Dictionary = override_bp.duplicate(true) if not override_bp.is_empty() else _blueprint_for(player_id, role_key, resolved_index)
	if bool(unit_bp.get("training_ball_dummy", false)):
		var radius := float(unit_bp.get("training_dummy_radius_m", _training_ball_dummy_radius()))
		var dummy_stats := _training_ball_dummy_stats(radius)
		dummy_stats["role"] = role_key
		dummy_stats["unit_index"] = resolved_index
		return dummy_stats
	var component_priced := _unit_uses_component_pricing(unit_bp)
	var parts: Array = []
	if not component_priced:
		for slot_key in BUILD_SLOTS:
			var selected_part: Dictionary = _selected_component(role_key, slot_key, int(unit_bp.get(slot_key, 0))).duplicate(true)
			selected_part["_slot_key"] = slot_key
			parts.append(selected_part)
		if role_key == "barrier":
			for ether_index in _barrier_extra_ether_indices(unit_bp):
				var ether_part: Dictionary = _selected_component(role_key, "special", int(ether_index)).duplicate(true)
				ether_part["_slot_key"] = "special"
				parts.append(ether_part)
	var manufacturer_counts := _manufacturer_counts_for_blueprint(role_key, unit_bp)
	var manufacturer_discount := _manufacturer_discount_from_counts(manufacturer_counts)

	var stats := _unit_stats_service().base_stats({
		"role_key": role_key,
		"unit_index": resolved_index,
		"unit_name": String(unit_bp.get("name", _role_name(role_key))),
		"manufacturer_counts": manufacturer_counts,
		"manufacturer_locked": _dominant_hardware_maker(manufacturer_counts),
		"primary_color": _team_primary_color(player_id),
		"accent_color": _team_accent_color(player_id),
		"constants": _unit_stats_base_constants(),
	})

	if _unit_blueprint_is_blank_canvas(role_key, unit_bp):
		return _blank_canvas_stats(stats, player_id, role_key, resolved_index)

	for part in parts:
		var part_kind := String(part.get("kind", ""))
		var slot_kind := String(part.get("_slot_key", ""))
		if slot_kind == "cooling":
			part = _cooling_with_v3_defaults(part)
		var part_is_torso := _component_is_torso(part)
		var puppet_only_inactive := role_key != "puppet" and bool(part.get("puppet_only_module", false))
		var pure_software_component := part_kind in ["soul", "code", "ether"]
		var internal_slot_component := pure_software_component or slot_kind in ["engine", "cooling"]
		var external_payload_component := bool(part.get("torso_slot_payload", false)) or slot_kind == "booster"
		var no_collision_volume := internal_slot_component or external_payload_component
		if part_kind == "soul":
			stats["has_soul"] = true
		if part_kind == "ether":
			_merge_ether_stats(stats, part)
		stats["cost"] = int(stats["cost"]) + int(part.get("cost", 0))
		if not internal_slot_component and not external_payload_component:
			stats["health"] = int(stats["health"]) + int(part.get("hp", 0))
		if not pure_software_component:
			stats["mass"] = float(stats["mass"]) + float(part.get("mass", 0.0))
			if not no_collision_volume:
				stats["structural_mass"] = float(stats.get("structural_mass", 0.0)) + float(part.get("mass", 0.0))
		if slot_kind == "engine":
			_merge_engine_stats(stats, part)
		elif float(part.get("power", 0.0)) != 0.0:
			stats["aux_power"] = float(stats.get("aux_power", 0.0)) + float(part.get("power", 0.0))
		var part_power_load := 0.0
		stats["energy"] = float(stats["energy"]) + part_power_load
		stats["power_load"] = float(stats.get("power_load", 0.0)) + part_power_load
		if not no_collision_volume:
			stats["length"] = float(stats["length"]) + float(part.get("length", 0.0))
		if pure_software_component:
			stats["deploy_wait"] = maxf(float(stats.get("deploy_wait", DEPLOY_WAIT_SECONDS)), float(part.get("deploy_wait", _special_deploy_wait(part, role_key))))
		var part_cooling := _cooling_rate_for_part(part) if slot_kind == "cooling" else float(part.get("cooling", 0.0))
		stats["cooling"] = float(stats["cooling"]) + part_cooling
		if slot_kind == "cooling" or part_cooling > 0.0:
			var part_dissipation := _cooling_dissipation_for_part(part) if slot_kind == "cooling" else part_cooling
			stats["heat_dissipation"] = float(stats.get("heat_dissipation", 0.0)) + part_dissipation
			stats["cooling_heat_capacity"] = float(stats.get("cooling_heat_capacity", 0.0)) + _cooling_heat_capacity_for_part(part)
			_merge_cooling_profile_stats(stats, part)
		stats["heat_capacity"] = float(stats["heat_capacity"]) + float(part.get("heat_capacity", 0.0))
		if not pure_software_component:
			stats["hardware_heat_capacity"] = float(stats.get("hardware_heat_capacity", 0.0)) + float(part.get("heat_capacity", 0.0))
		if not no_collision_volume:
			stats["radius"] = float(stats["radius"]) + float(part.get("radius", 0.0))
		stats["speed_mult"] = float(stats["speed_mult"]) * float(part.get("speed_mult", 1.0))
		if part.has("cornering"):
			stats["cornering"] = maxf(float(stats.get("cornering", 1.0)), float(part["cornering"]))
		if part.has("speed_lane_affinity"):
			stats["speed_lane_affinity"] = float(stats.get("speed_lane_affinity", 0.0)) + float(part["speed_lane_affinity"])
		if not part_is_torso:
			stats["normal_damage"] = int(stats["normal_damage"]) + int(part.get("normal_damage", 0))
			stats["armor_damage"] = int(stats["armor_damage"]) + int(part.get("armor_damage", 0))
			stats["active_damage"] = int(stats["active_damage"]) + int(part.get("active_damage", 0))
			stats["normal_range"] = float(stats["normal_range"]) + float(part.get("range", 0.0))
			stats["armor_range"] = float(stats["armor_range"]) + float(part.get("range", 0.0)) * 0.55
			stats["active_range"] = float(stats["active_range"]) + float(part.get("range", 0.0)) + float(part.get("active_range", 0.0))
		stats["armor_duration"] = float(stats["armor_duration"]) + float(part.get("armor_duration", 0.0))
		stats["active_duration"] = float(stats["active_duration"]) + float(part.get("active_duration", 0.0))
		stats["group_count"] = int(stats["group_count"]) + int(part.get("group_bonus", 0))
		if slot_kind in ["joint", "limb_muscle", "muscle"] and not no_collision_volume:
			var part_stiffness := _part_stiffness(part, slot_kind)
			stats["stiffness"] = float(stats.get("stiffness", 0.0)) + part_stiffness
			if slot_kind == "joint":
				var part_momentum_capacity := _part_momentum_capacity(part, slot_kind)
				stats["momentum_capacity"] = float(stats.get("momentum_capacity", 0.0)) + part_momentum_capacity
				stats["load_capacity"] = float(stats.get("load_capacity", 0.0)) + part_momentum_capacity
				stats["max_joint_output_momentum"] = maxf(float(stats.get("max_joint_output_momentum", 0.0)), _joint_fixed_output_momentum(part))
		if _part_counts_as_terminal_weapon(part, slot_kind):
			stats["terminal_weapon_mass"] = maxf(float(stats.get("terminal_weapon_mass", 0.0)), float(part.get("terminal_weapon_mass", part.get("mass", 0.0))))
			stats["requires_dual_mount"] = bool(stats.get("requires_dual_mount", false)) or bool(part.get("requires_dual_mount", false))
			stats["dual_mount_points"] = maxi(int(stats.get("dual_mount_points", 1)), int(part.get("dual_mount_points", 1)))
		if part.has("dual_mount_module"):
			stats["dual_mount_module"] = bool(stats["dual_mount_module"]) or bool(part["dual_mount_module"])
		if part.has("dual_mount_load_mult"):
			stats["dual_mount_load_mult"] = maxf(float(stats.get("dual_mount_load_mult", 1.0)), float(part["dual_mount_load_mult"]))
		if part.has("recoil_brace_mult"):
			stats["recoil_brace_mult"] = minf(float(stats.get("recoil_brace_mult", 1.0)), float(part["recoil_brace_mult"]))
		if part.has("allows_vertical_overlap"):
			stats["allows_vertical_overlap"] = bool(stats["allows_vertical_overlap"]) or bool(part["allows_vertical_overlap"])
		if part.has("vertical_overlap_ports"):
			stats["vertical_overlap_ports"] = max(int(stats.get("vertical_overlap_ports", 0)), int(part["vertical_overlap_ports"]))
		_unit_stats_service().copy_part_combat_stats(stats, part, {
			"part_is_torso": part_is_torso,
		})
		_unit_stats_service().copy_part_payload_stats(stats, part, _unit_stats_part_payload_context(part, part_is_torso))
		if part.has("resist"):
			var part_resist: Dictionary = part["resist"]
			for damage_type in MELEE_DAMAGE_TYPES:
				stats["resistances"][damage_type] = float(stats["resistances"][damage_type]) * float(part_resist.get(damage_type, 1.0))
		if part.has("counter_tiers"):
			_merge_counter_tiers(stats, part["counter_tiers"])
		if part.has("recoil"):
			stats["recoil"] = maxf(float(stats["recoil"]), float(part["recoil"]))
		if part.has("cancel_profile"):
			stats["cancel_profile"] = String(part["cancel_profile"])
		if part.has("cancel_power"):
			stats["cancel_power"] = maxf(float(stats["cancel_power"]), float(part["cancel_power"]))
		if part.has("aim_mode") and not puppet_only_inactive:
			stats["health"] = int(stats["health"]) - int(part.get("hp", 0))
			stats["mass"] = float(stats["mass"]) - float(part.get("mass", 0.0))
			stats["structural_mass"] = maxf(0.0, float(stats.get("structural_mass", 0.0)) - float(part.get("mass", 0.0)))
			stats["length"] = float(stats["length"]) - float(part.get("length", 0.0))
			stats["aim_mode"] = String(part["aim_mode"])
		if part.has("motion") and not puppet_only_inactive:
			stats["motion"] = String(part["motion"])
		if part.has("aim_swing"):
			stats["aim_swing"] = float(part["aim_swing"])
		if part.has("auto_swing"):
			stats["auto_swing"] = float(part["auto_swing"])
		if part.has("thruster_momentum") or part.has("boost_momentum") or part.has("allocated_momentum") or slot_kind == "booster":
			_merge_thruster_drive_stats(stats, part)
		if part.has("back_hit_heat_bonus"):
			stats["back_hit_heat_bonus"] = float(stats.get("back_hit_heat_bonus", 0.0)) + float(part["back_hit_heat_bonus"])
		if part.has("back_hit_heat_mult"):
			stats["back_hit_heat_mult"] = maxf(float(stats.get("back_hit_heat_mult", 1.0)), float(part["back_hit_heat_mult"]))
		if part.has("recoil_cancel"):
			stats["recoil_cancel"] = maxf(float(stats["recoil_cancel"]), float(part["recoil_cancel"]))
		if part.has("shape") and not no_collision_volume:
			stats["shape"] = String(part["shape"])
		if bool(part.get("is_torso", false)) or String(part.get("material_class", "")).to_lower() == "torso":
			_merge_attitude_control_stats(stats, part, 1.0)
			_merge_torso_stiffness_segment_stats(stats, part, slot_kind, 1.0)
			stats["torso_visual_shape"] = String(part.get("shape", stats.get("torso_visual_shape", "core")))
			stats["torso_visual_material"] = String(part.get("torso_material", part.get("material_visual", stats.get("torso_visual_material", "metal"))))
		if part.has("command"):
			stats["command"] = String(part["command"])
		if part.has("skill_state"):
			stats["skill_state"] = String(part["skill_state"])
		if part.has("sequence"):
			stats["sequence"] = part["sequence"]
		if part.has("group_count"):
			stats["group_count"] = int(part["group_count"])
		if part.has("ai"):
			stats["ai"] = String(part["ai"])
		if part.has("source_rules") and not puppet_only_inactive:
			stats["source_rules"] = part["source_rules"]
		if part.has("module_sequence_limit"):
			stats["module_sequence_limit"] = int(part["module_sequence_limit"])
		if part.has("condition_slots"):
			stats["condition_slots"] = int(part["condition_slots"])
		if part.has("space_size") and part_kind != "ether":
			stats["aura_range"] = float(part["space_size"])
			stats["active_range"] = maxf(float(stats["active_range"]), float(part["space_size"]) * 0.78)
		_unit_stats_service().copy_part_logic_stats(stats, part, {
			"puppet_only_inactive": puppet_only_inactive,
			"part_is_torso": part_is_torso,
			"part_kind": part_kind,
		})

	_apply_custom_topology_stats(stats, role_key, unit_bp)
	_apply_barrier_tile_stats(stats, role_key, unit_bp)
	_apply_torso_slot_payload_stats(stats, role_key, unit_bp)
	if bool(stats.get("has_soul", false)):
		var torso_anchor_count := Array(stats.get("torso_stiffness_segments", [])).size()
		stats["soul_anchor_torso_unit_index"] = maxi(0, int(floorf(float(maxi(1, torso_anchor_count) - 1) * 0.5)))
	if role_key == "puppet":
		stats["source_rules"] = _source_rules_for_blueprint(unit_bp, stats)

	_apply_load_balance(stats)
	_apply_engine_momentum_budget_with_runtime_modifiers(stats, role_key, false, false)
	_unit_stats_service().apply_base_motion_envelope(stats)
	if role_key == "hero":
		if not parts.is_empty() and String(Dictionary(parts[0]).get("kind", "")) == "soul":
			_unit_stats_service().apply_soul_heat_capacity_stats(stats, parts[0])
			_apply_soul_bonus(stats, unit_bp, parts[0])
		elif not bool(stats.get("has_soul", false)):
			stats["soul_heat_note"] = "NO SOUL: heat capacity comes from installed cooling."
	else:
		stats["heat_capacity"] = 0.0
	stats["data_security"] = clampf(float(stats.get("data_security", 1.0)), 0.25, 3.6)
	_apply_manufacturer_synergy(stats, manufacturer_counts)
	if unit_bp.has("custom_topology") and _topology_is_canonical_component_graph(Dictionary(unit_bp.get("custom_topology", {}))):
		var runtime_bp: Dictionary = unit_bp.duplicate(true)
		_apply_entry_pose_to_blueprint(runtime_bp)
		_apply_module_recovery_entry_pose_defaults(role_key, runtime_bp, true)
		stats["teamedit_runtime_topology"] = true
		stats["runtime_topology_segments"] = _runtime_topology_segments_for_blueprint(role_key, runtime_bp)
		stats["runtime_visual_scale"] = _battle_world_to_screen_scale()
		stats["runtime_topology_nodes"] = Array(Dictionary(runtime_bp.get("custom_topology", {})).get("nodes", [])).duplicate(true)
		stats["runtime_topology_edges"] = Array(Dictionary(runtime_bp.get("custom_topology", {})).get("edges", [])).duplicate(true)
		stats["runtime_module_bindings"] = _runtime_module_bindings_for_blueprint(role_key, runtime_bp)
	elif unit_bp.has("custom_topology"):
		stats["teamedit_runtime_topology"] = false
		stats["runtime_topology_segments"] = []
		stats["runtime_topology_nodes"] = []
		stats["runtime_topology_edges"] = []
		stats["runtime_module_bindings"] = []
		stats["legacy_topology_note"] = "OLD TOPOLOGY REJECTED: rebuild this unit in TeamEdit."
	else:
		stats["teamedit_runtime_topology"] = false
		stats["runtime_topology_segments"] = []
		stats["runtime_topology_nodes"] = []
		stats["runtime_topology_edges"] = []
		stats["runtime_module_bindings"] = []
		stats["legacy_topology_note"] = "OLD TOPOLOGY REJECTED: rebuild this unit in TeamEdit."
	if role_key == "puppet":
		_apply_source_code_runtime_assignment_stats(stats, player_id, role_key, resolved_index, unit_bp, int(unit_bp.get("puppet_group_slot", -1)))
	_ensure_projectile_ammo_capacity(stats)
	_unit_stats_service().apply_role_deploy_profile(stats, role_key)

	_apply_engine_momentum_budget_with_runtime_modifiers(stats, role_key, true, true)
	_apply_thermal_budget(stats, role_key)
	_apply_electronic_armor_coverage(stats)
	_apply_thruster_momentum_stats(stats, role_key)
	_apply_turn_stats(stats, role_key)
	_apply_recoil_stabilization(stats)
	_apply_momentum_stiffness(stats)
	_apply_joint_momentum_capacity(stats, role_key, unit_bp)
	_apply_joint_slot_motion_limits(stats, role_key, unit_bp)
	_apply_stiffness_segment_summary(stats)
	_unit_stats_service().apply_manufacturer_discount(stats, manufacturer_discount)

	return _scrub_legacy_power_stats(stats)


