		_bind_joy_button("menu_back", JOY_BUTTON_B, device)
		_bind_joy_button("battle_pause", JOY_BUTTON_B, device)
	_clear_keyboard_events("menu_confirm")
	_clear_keyboard_events("menu_back")

	_bind_player_inputs("p1", 0, true)
	_bind_player_inputs("p2", 1, false)


func _bind_player_inputs(prefix: String, device: int, include_keyboard: bool) -> void:
	for base_action in ["left", "right", "up", "down", "face_left", "face_right", "cool", "portal"]:
		_clear_input_action("%s_%s" % [prefix, base_action])
	for attack_key_index in range(1, ATTACK_GROUP_COUNT + 1):
		_clear_input_action("%s_attack_%d" % [prefix, attack_key_index])
	if include_keyboard:
		_bind_key("%s_left" % prefix, KEY_A)
		_bind_key("%s_right" % prefix, KEY_D)
		_bind_key("%s_up" % prefix, KEY_W)
		_bind_key("%s_down" % prefix, KEY_S)
		_bind_key("%s_face_left" % prefix, KEY_Q)
		_bind_key("%s_face_right" % prefix, KEY_E)
		_bind_key("%s_cool" % prefix, KEY_G)
		_bind_key("%s_portal" % prefix, KEY_TAB)
		for attack_key_index in range(1, ATTACK_GROUP_COUNT + 1):
			var action_name := "%s_attack_%d" % [prefix, attack_key_index]
			_clear_keyboard_events(action_name)
			_bind_key(action_name, _attack_keycode_for_index(attack_key_index))

	_bind_joy_button("%s_left" % prefix, JOY_BUTTON_DPAD_LEFT, device)
	_bind_joy_button("%s_right" % prefix, JOY_BUTTON_DPAD_RIGHT, device)
	_bind_joy_button("%s_up" % prefix, JOY_BUTTON_DPAD_UP, device)
	_bind_joy_button("%s_down" % prefix, JOY_BUTTON_DPAD_DOWN, device)
	_bind_joy_axis("%s_left" % prefix, JOY_AXIS_LEFT_X, -1.0, device)
	_bind_joy_axis("%s_right" % prefix, JOY_AXIS_LEFT_X, 1.0, device)
	_bind_joy_axis("%s_up" % prefix, JOY_AXIS_LEFT_Y, -1.0, device)
	_bind_joy_axis("%s_down" % prefix, JOY_AXIS_LEFT_Y, 1.0, device)
	_bind_joy_axis("%s_face_left" % prefix, JOY_AXIS_RIGHT_X, -1.0, device)
	_bind_joy_axis("%s_face_right" % prefix, JOY_AXIS_RIGHT_X, 1.0, device)
	_bind_joy_button("%s_attack_1" % prefix, JOY_BUTTON_A, device)
	_bind_joy_button("%s_attack_2" % prefix, JOY_BUTTON_X, device)
	_bind_joy_button("%s_attack_3" % prefix, JOY_BUTTON_Y, device)
	_bind_joy_button("%s_attack_4" % prefix, JOY_BUTTON_B, device)
	_bind_joy_button("%s_attack_5" % prefix, JOY_BUTTON_LEFT_SHOULDER, device)
	_bind_joy_button("%s_attack_6" % prefix, JOY_BUTTON_RIGHT_SHOULDER, device)
	_bind_joy_button("%s_cool" % prefix, JOY_BUTTON_GUIDE, device)
	_bind_joy_button("%s_portal" % prefix, JOY_BUTTON_BACK, device)
	for removed_action in ["%s_active" % prefix, "%s_armor" % prefix]:
		_clear_input_action(removed_action)


func _attack_keycode_for_index(key_index: int) -> int:
	match clampi(key_index, 1, ATTACK_GROUP_COUNT):
		1:
			return KEY_U
		2:
			return KEY_I
		3:
			return KEY_O
		4:
			return KEY_J
		5:
			return KEY_K
		6:
			return KEY_L
	return KEY_U


func _clear_input_action(action_name: String) -> void:
	if InputMap.has_action(action_name):
		InputMap.erase_action(action_name)


func _clear_keyboard_events(action_name: String) -> void:
	if not InputMap.has_action(action_name):
		return
	for existing_event in InputMap.action_get_events(action_name):
		if existing_event is InputEventKey:
			InputMap.action_erase_event(action_name, existing_event)


func _bind_key(action_name: String, keycode: int) -> void:
	if not InputMap.has_action(action_name):
		InputMap.add_action(action_name)
	var event := InputEventKey.new()
	event.physical_keycode = keycode
	for existing_event in InputMap.action_get_events(action_name):
		if existing_event is InputEventKey and existing_event.physical_keycode == keycode:
			return
	InputMap.action_add_event(action_name, event)


func _bind_joy_button(action_name: String, button_index: int, device: int) -> void:
	if not InputMap.has_action(action_name):
		InputMap.add_action(action_name)
	var event := InputEventJoypadButton.new()
	event.device = device
	event.button_index = button_index
	InputMap.action_add_event(action_name, event)


func _bind_joy_axis(action_name: String, axis_index: int, axis_value: float, device: int) -> void:
	if not InputMap.has_action(action_name):
		InputMap.add_action(action_name)
	var event := InputEventJoypadMotion.new()
	event.device = device
	event.axis = axis_index
	event.axis_value = axis_value
	InputMap.action_add_event(action_name, event)


func _enable_mouse_for_buttons(node: Node) -> void:
	if node is PartDragGhostView:
		var ghost := node as PartDragGhostView
		ghost.focus_mode = Control.FOCUS_NONE
		ghost.mouse_filter = Control.MOUSE_FILTER_IGNORE
		return
	if node is Button:
		var button := node as Button
		button.focus_mode = Control.FOCUS_NONE
		button.mouse_filter = Control.MOUSE_FILTER_STOP
	for child in node.get_children():
		_enable_mouse_for_buttons(child)


func _add_rect(rect_name: String, rect_position: Vector2, rect_size: Vector2, color: Color, parent: Node) -> Polygon2D:
	var rect := Polygon2D.new()
	rect.name = rect_name
	rect.position = rect_position
	rect.polygon = PackedVector2Array([Vector2.ZERO, Vector2(rect_size.x, 0.0), rect_size, Vector2(0.0, rect_size.y)])
	rect.color = color
	parent.add_child(rect)
	return rect


func _add_ui_rect(parent: Control, rect_name: String, rect_position: Vector2, rect_size: Vector2, color: Color) -> ColorRect:
	var rect := ColorRect.new()
	rect.name = rect_name
	rect.position = rect_position
	rect.size = rect_size
	rect.color = color
	rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(rect)
	return rect


func _add_layout_ui_rect(parent: Control, rect_name: String, token_rect: Rect2, color: Color) -> ColorRect:
	var screen_rect := UILayoutTokens.to_screen_rect(token_rect, _ui_viewport_size())
	return _add_ui_rect(parent, rect_name, screen_rect.position, screen_rect.size, color)


func _add_token_ui_rect(parent: Control, rect_name: String, token_id: String, color: Color) -> ColorRect:
	return _add_layout_ui_rect(parent, rect_name, UILayoutTokens.screen_region(token_id), color)


func _offset_rect(rect: Rect2, offset: Vector2) -> Rect2:
	return Rect2(rect.position + offset, rect.size)


func _ui_viewport_size() -> Vector2:
	var viewport := get_viewport()
	if viewport == null:
		return UILayoutTokens.DESIGN_SIZE
	var rect := viewport.get_visible_rect()
	if rect.size.x <= 0.0 or rect.size.y <= 0.0:
		return UILayoutTokens.DESIGN_SIZE
	return rect.size


func _apply_layout_rect(control: Control, token_rect: Rect2) -> void:
	var screen_rect := UILayoutTokens.to_screen_rect(token_rect, _ui_viewport_size())
	control.position = screen_rect.position
	control.size = screen_rect.size


func _apply_token_rect(control: Control, token_id: String) -> void:
	_apply_layout_rect(control, UILayoutTokens.screen_region(token_id))


func _make_layout_label(parent: Control, label_name: String, text: String, token_rect: Rect2, font_size: int, color: Color, alignment: HorizontalAlignment) -> Label:
	var screen_rect := UILayoutTokens.to_screen_rect(token_rect, _ui_viewport_size())
	return _make_label(parent, label_name, text, screen_rect.position, screen_rect.size, font_size, color, alignment)


func _make_token_label(parent: Control, label_name: String, text: String, token_id: String, font_size: int, color: Color, alignment: HorizontalAlignment) -> Label:
	return _make_layout_label(parent, label_name, text, UILayoutTokens.screen_region(token_id), font_size, color, alignment)


func _set_scroll_label_text(label: Label, text: String) -> void:
	if label == null:
		return
	label.text = text
	_refresh_scroll_label_size(label)


func _refresh_scroll_label_size(label: Label) -> void:
	if label == null:
		return
	var parent := label.get_parent()
	if not (parent is ScrollContainer):
		return
	var scroll := parent as ScrollContainer
	var inset := 10.0
	var available_w := maxf(8.0, scroll.size.x - inset)
	var font_size := float(label.get_theme_font_size("font_size"))
	var char_width := maxf(5.6, font_size * 0.56)
	var line_height := font_size + 5.0
	var visual_lines := 0
	for raw_line in label.text.split("\n"):
		var line := String(raw_line)
		var estimated_w := float(line.length()) * char_width
		var wraps := 1
		if label.autowrap_mode != TextServer.AUTOWRAP_OFF:
			wraps = maxi(1, int(ceilf(estimated_w / available_w)))
		visual_lines += wraps
	var content_h := maxf(scroll.size.y, float(maxi(1, visual_lines)) * line_height + 6.0)
	label.position = Vector2.ZERO
	label.size = Vector2(available_w, content_h)
	label.custom_minimum_size = label.size


func _make_label(parent: Control, label_name: String, text: String, label_position: Vector2, label_size: Vector2, font_size: int, color: Color, alignment: HorizontalAlignment) -> Label:
	var label := Label.new()
	label.name = label_name
	label.text = text
	label.position = label_position
	label.size = label_size
	label.horizontal_alignment = alignment
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.add_theme_font_size_override("font_size", font_size)
	label.add_theme_color_override("font_color", color)
	label.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.76))
	label.add_theme_constant_override("outline_size", 4)
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	parent.add_child(label)
	return label
