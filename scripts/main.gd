func _fit_ai_roster_to_rules(player_id: int) -> void:
	sortie_loadouts[player_id] = _default_sortie_loadout(player_id)
	_trim_ai_roster_to_caps(player_id)
	_fill_ai_roster_to_cap(player_id)
	_trim_ai_roster_to_caps(player_id)


func _trim_ai_roster_to_caps(player_id: int) -> void:
	var attempts := 0
	while attempts < 48:
		attempts += 1
		var summary := _team_summary(player_id)
		var units := int(summary.get("units", 0))
		if units <= _current_roster_cap():
			return
		var remove_entry := _ai_removable_roster_entry(player_id)
		if remove_entry.is_empty():
			return
		var role_key := String(remove_entry.get("role", ""))
		var unit_index := int(remove_entry.get("index", -1))
		if ROLE_ORDER.has(role_key) and unit_index >= 0 and unit_index < Array(blueprints[player_id].get(role_key, [])).size():
			var roster: Array = blueprints[player_id][role_key]
			roster.remove_at(unit_index)
			blueprints[player_id][role_key] = roster
			ai_roster_stats_cache.clear()
			_update_sortie_after_delete(player_id, role_key, unit_index)


func _ai_removable_roster_entry(player_id: int) -> Dictionary:
	var best: Dictionary = {}
	var best_score := -999999.0
	for entry in _all_roster_order(player_id):
		if not (entry is Dictionary):
			continue
		var role_key := String(entry.get("role", ""))
		var unit_index := int(entry.get("index", 0))
		var roster: Array = blueprints[player_id].get(role_key, [])
		if roster.size() <= 1:
			continue
		if role_key == "hero" and unit_index == 0:
			continue
		var stats := _ai_cached_unit_stats(player_id, role_key, unit_index)
		var score := float(stats.get("cost", 0)) + float(stats.get("length", 0.0)) * 120.0
		if score > best_score:
			best_score = score
			best = Dictionary(entry).duplicate(true)
	return best


func _fill_ai_roster_to_cap(player_id: int) -> void:
	var side_tag := "Blue" if player_id == 1 else "Red"
	var fillers := [
		{"role": "puppet", "unit": _ai_reserve_unit_for_role(player_id, "puppet", 0)},
		{"role": "barrier", "unit": _ai_reserve_unit_for_role(player_id, "barrier", 1)},
		{"role": "hero", "unit": _ai_reserve_unit_for_role(player_id, "hero", 2)},
	]
	var cursor := 0
	while _roster_unit_total(player_id) < _current_roster_cap() and cursor < 18:
		var spec: Dictionary = fillers[cursor % fillers.size()]
		var role_key := String(spec.get("role", "puppet"))
		var candidate: Dictionary = Dictionary(spec.get("unit", {})).duplicate(true)
		candidate["name"] = "%s %d" % [String(candidate.get("name", "Computer Reserve")), cursor + 1]
		var roster: Array = blueprints[player_id].get(role_key, [])
		roster.append(candidate)
		blueprints[player_id][role_key] = roster
		ai_roster_stats_cache.clear()
		sortie_loadouts[player_id] = _default_sortie_loadout(player_id)
		cursor += 1


