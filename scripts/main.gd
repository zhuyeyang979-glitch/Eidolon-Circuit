	var subtitle := ("双击打开躯干详情 / 接口 %d / 插件 %d/%d / 软件 %d/%d" if _ui_is_zh() else "Double-click for torso detail / ports %d / internal %d/%d / software %d/%d") % [
		int(part.get("joint_ports", part.get("connection_ends", 0))),
		plugin_entries.size(),
		_torso_plugin_capacity_for_part(part),
		software_entries.size(),
		_torso_software_capacity_for_part(part),
	]
	var lines := [
		("已安装机内插件：%s" if _ui_is_zh() else "Internal plugins: %s") % _payload_names_for_hover(plugin_entries),
		("已安装软件：%s" if _ui_is_zh() else "Software: %s") % _payload_names_for_hover(software_entries),
		("关节点位会在躯干外缘显示；已占用点位为绿色。" if _ui_is_zh() else "Joint ports are drawn on the torso edge; occupied ports are green."),
	]
	var stats := _hover_card_stat_entries("muscle", part)
	if editor_hover_popup_view != null:
		editor_hover_popup_view.set_part("muscle", part, title, subtitle, lines, ui_language, stats)


func _payload_names_for_hover(entries: Array) -> String:
	if entries.is_empty():
		return "无" if _ui_is_zh() else "none"
	var names: Array = []
	for entry in entries:
		if entry is Dictionary:
			names.append(_trim_text(String(Dictionary(entry).get("name", "")), 10))
	return ", ".join(names)


func _open_editor_torso_detail(node_index: int) -> void:
	editor_open_torso_node_index = node_index
	editor_selected_torso_slot_kind = ""
	editor_selected_torso_slot_index = -1
	if editor_board_hint_label != null:
		editor_board_hint_label.text = "已打开躯干详情页：拖入引擎/散热器/推进器/弹药/护盾，或拖入英魂/源代码/以太/行动模块。" if _ui_is_zh() else "Opened torso detail: drag in engines/cooling/boosters/ammo/shields or soul/source/ether/action modules."
	_refresh_torso_detail_view()


func _nearest_custom_node_index(role_key: String, unit_bp: Dictionary, nodes: Array, local_pos: Vector2) -> int:
	var best := -1
	var best_distance := 99999.0
	var best_radius := 0.0
	for i in range(nodes.size()):
		var node: Dictionary = nodes[i]
		var point := _topology_position_to_board_local(_topology_node_position(node))
		var d := local_pos.distance_to(point)
		if d < best_distance:
			best_distance = d
			best = i
			best_radius = _topology_node_pick_radius(role_key, unit_bp, node)
	return best if best >= 0 and best_distance <= best_radius else -1


func _topology_node_pick_radius(role_key: String, unit_bp: Dictionary, node: Dictionary) -> float:
	if _topology_node_is_component(node):
		var part := _topology_node_part(role_key, node, unit_bp)
		var length := maxf(0.0, float(part.get("length", 0.0)))
		var radius := maxf(0.0, float(part.get("radius", 0.0)))
		var pick_radius := clampf(15.0 + maxf(length * 22.0, radius * 84.0), 18.0, 38.0)
		var zoom := clampf(editor_board_zoom, EDITOR_BOARD_ZOOM_MIN, EDITOR_BOARD_ZOOM_MAX)
		if _topology_node_slot(node) == "joint":
			return clampf(pick_radius * 0.62 * zoom, 5.0, 72.0)
		return clampf(pick_radius * zoom, 7.0, 114.0)
	return clampf(24.0 * clampf(editor_board_zoom, EDITOR_BOARD_ZOOM_MIN, EDITOR_BOARD_ZOOM_MAX), 7.0, 72.0)


func _board_position_to_topology(local_position: Vector2) -> Vector2:
	var board_position := _board_position_to_local(local_position)
	var board_size := _topology_board_size()
	return _clamp_topology_position((board_position - board_size * 0.5 - editor_board_view_offset) / _topology_board_uniform_scale() + Vector2(0.5, 0.5))


func _topology_position_to_board(pos: Vector2) -> Vector2:
	var local_position := _topology_position_to_board_local(pos)
	if assembly_board_view != null:
		return assembly_board_view.get_global_rect().position + local_position
	return local_position


func _topology_position_to_board_local(pos: Vector2) -> Vector2:
	var clamped := _clamp_topology_position(pos)
	var board_size := _topology_board_size()
	return board_size * 0.5 + editor_board_view_offset + (clamped - Vector2(0.5, 0.5)) * _topology_board_uniform_scale()


func _board_position_to_local(position: Vector2) -> Vector2:
	if assembly_board_view == null:
		return position
	var local_rect := Rect2(Vector2.ZERO, assembly_board_view.size)
	if local_rect.has_point(position):
		return position
	var global_rect := assembly_board_view.get_global_rect()
	if global_rect.has_point(position):
		return position - global_rect.position
	return position


func _topology_board_uniform_scale() -> float:
	return _topology_board_base_scale() * clampf(editor_board_zoom, EDITOR_BOARD_ZOOM_MIN, EDITOR_BOARD_ZOOM_MAX)


func _topology_board_base_scale() -> float:
	var board_size := _topology_board_size()
	return maxf(1.0, minf(board_size.x - TOPOLOGY_BOARD_MARGIN * 2.0, board_size.y - TOPOLOGY_BOARD_MARGIN * 2.0))


func _topology_board_size() -> Vector2:
	if assembly_board_view != null and assembly_board_view.size.x > TOPOLOGY_BOARD_MARGIN * 2.0 and assembly_board_view.size.y > TOPOLOGY_BOARD_MARGIN * 2.0:
		return assembly_board_view.size
	return TOPOLOGY_BOARD_REFERENCE_SIZE


func _clamp_topology_position(pos: Vector2) -> Vector2:
	return Vector2(clampf(pos.x, 0.0, 1.0), clampf(pos.y, 0.0, 1.0))


func _topology_clamped_delta_for_positions(positions: Array, requested_delta: Vector2) -> Vector2:
	var delta := requested_delta
	for raw_pos in positions:
		if not (raw_pos is Vector2):
			continue
		var pos: Vector2 = raw_pos
		if requested_delta.x < 0.0:
			delta.x = maxf(delta.x, -pos.x)
		elif requested_delta.x > 0.0:
			delta.x = minf(delta.x, 1.0 - pos.x)
		if requested_delta.y < 0.0:
			delta.y = maxf(delta.y, -pos.y)
		elif requested_delta.y > 0.0:
			delta.y = minf(delta.y, 1.0 - pos.y)
	return delta


func _topology_node_position(node: Dictionary) -> Vector2:
	var pos = node.get("pos", Vector2(0.5, 0.5))
	return pos if pos is Vector2 else Vector2(0.5, 0.5)


func _topology_node_physical_length_units(role_key: String, node: Dictionary, unit_bp: Dictionary) -> float:
	if _topology_node_is_component(node):
		var part := _topology_node_part(role_key, node, unit_bp)
		return maxf(0.04, _effective_part_length_for_geometry(part, _topology_node_slot(node)))
	var joint_part := _selected_component(role_key, "joint", int(node.get("joint", unit_bp.get("joint", 0))))
	var limb_part := _selected_component(role_key, "limb_muscle", int(node.get("limb_muscle", unit_bp.get("limb_muscle", 0))))
	var terminal_part := _selected_component(role_key, "muscle", int(node.get("muscle", unit_bp.get("muscle", 0))))
	return maxf(0.04, float(joint_part.get("length", 0.0)) + float(limb_part.get("length", 0.0)) + float(terminal_part.get("length", 0.0)))


func _topology_joint_radius_units(part: Dictionary) -> float:
	if bool(part.get("software_joint", false)) or bool(part.get("joint_is_software", false)):
		return 0.0
	return maxf(0.006, maxf(float(part.get("radius", 0.0)), float(part.get("length", 0.0)) * 0.5))


func _topology_node_edge_extent_units(role_key: String, node: Dictionary, unit_bp: Dictionary) -> float:
	if not _topology_node_is_component(node):
		return _topology_node_physical_length_units(role_key, node, unit_bp) * 0.5
	var slot_key := _topology_node_slot(node)
	var part := _topology_node_part(role_key, node, unit_bp)
	if slot_key == "joint":
		return _topology_joint_radius_units(part)
	if slot_key == "limb_muscle":
		return maxf(0.0175, _topology_node_visual_edge_extent_units(role_key, node, unit_bp, "distal"))
	if slot_key == "muscle":
		if bool(part.get("is_torso", false)):
			return maxf(0.04, _topology_node_visual_edge_extent_units(role_key, node, unit_bp, "distal"))
		return maxf(0.02, _topology_node_visual_edge_extent_units(role_key, node, unit_bp, "distal"))
	return _topology_node_physical_length_units(role_key, node, unit_bp) * 0.5


func _topology_edge_fixed_distance_units(role_key: String, node_a: Dictionary, node_b: Dictionary, unit_bp: Dictionary) -> float:
	if _topology_node_is_torso(role_key, node_a, unit_bp):
		var socket_a := _topology_socket_for_connection(role_key, unit_bp, [node_a, node_b], [], 0, 1)
		var port_pos_a: Vector2 = socket_a.get("pos", _topology_node_position(node_a))
		return port_pos_a.distance_to(_topology_node_position(node_a)) * TOPOLOGY_BOARD_PHYSICAL_UNITS + _topology_node_edge_extent_units(role_key, node_b, unit_bp)
	if _topology_node_is_torso(role_key, node_b, unit_bp):
		var socket_b := _topology_socket_for_connection(role_key, unit_bp, [node_a, node_b], [], 1, 0)
		var port_pos_b: Vector2 = socket_b.get("pos", _topology_node_position(node_b))
		return port_pos_b.distance_to(_topology_node_position(node_b)) * TOPOLOGY_BOARD_PHYSICAL_UNITS + _topology_node_edge_extent_units(role_key, node_a, unit_bp)
	return maxf(0.0, _topology_node_edge_extent_units(role_key, node_a, unit_bp) + _topology_node_edge_extent_units(role_key, node_b, unit_bp))


func _topology_edge_distance_units(node_a: Dictionary, node_b: Dictionary) -> float:
	return _topology_node_position(node_a).distance_to(_topology_node_position(node_b)) * TOPOLOGY_BOARD_PHYSICAL_UNITS


func _topology_edge_key(a: int, b: int) -> String:
	return "%d:%d" % [mini(a, b), maxi(a, b)]


func _connected_topology_neighbors(edges: Array, node_index: int, node_count: int) -> Array:
	var neighbors: Array = []
	for edge in edges:
		var a := _topology_edge_node_a(edge)
		var b := _topology_edge_node_b(edge)
		if a < 0 or b < 0 or a >= node_count or b >= node_count:
			continue
		if a == node_index:
			neighbors.append(b)
		elif b == node_index:
			neighbors.append(a)
	return neighbors


func _topology_connected_component_indices(edges: Array, node_count: int, seeds: Array) -> Array:
	var visited := {}
	var queue: Array = []
	for raw_seed in seeds:
		var seed := int(raw_seed)
		if seed < 0 or seed >= node_count or visited.has(seed):
			continue
		visited[seed] = true
		queue.append(seed)
	while not queue.is_empty():
		var current := int(queue.pop_front())
		for raw_neighbor in _connected_topology_neighbors(edges, current, node_count):
			var neighbor := int(raw_neighbor)
			if neighbor < 0 or neighbor >= node_count or visited.has(neighbor):
				continue
			visited[neighbor] = true
			queue.append(neighbor)
	var result: Array = []
	for i in range(node_count):
		if visited.has(i):
			result.append(i)
	return result


func _topology_circle_intersections(center_a: Vector2, radius_a: float, center_b: Vector2, radius_b: float) -> Array:
	var points: Array = []
	var delta := center_b - center_a
	var distance := delta.length()
	var tolerance := TOPOLOGY_EDGE_TOLERANCE / TOPOLOGY_BOARD_PHYSICAL_UNITS
	if distance < 0.0001:
		return points
	if distance > radius_a + radius_b + tolerance:
		return points
	if distance < absf(radius_a - radius_b) - tolerance:
		return points
	var along := (radius_a * radius_a - radius_b * radius_b + distance * distance) / (2.0 * distance)
	var height_sq := radius_a * radius_a - along * along
	if height_sq < -tolerance:
		return points
	var height := sqrt(maxf(0.0, height_sq))
	var direction := delta / distance
	var base := center_a + direction * along
	var perpendicular := Vector2(-direction.y, direction.x)
	points.append(base + perpendicular * height)
	if height > 0.0001:
		points.append(base - perpendicular * height)
	return points


func _topology_position_satisfies_constraints(position: Vector2, constraints: Array) -> bool:
	var tolerance := TOPOLOGY_EDGE_TOLERANCE / TOPOLOGY_BOARD_PHYSICAL_UNITS
	for constraint in constraints:
		if not (constraint is Dictionary):
			continue
		var anchor: Vector2 = constraint.get("anchor", Vector2.ZERO)
		var radius := float(constraint.get("radius", 0.0))
		if absf(position.distance_to(anchor) - radius) > tolerance:
			return false
	return true


func _topology_best_rigid_candidate(candidates: Array, desired_pos: Vector2, constraints: Array, fallback_pos: Vector2) -> Vector2:
	var best := fallback_pos
	var best_distance := 999999.0
	for candidate in candidates:
		if not (candidate is Vector2):
			continue
		var clamped := _clamp_topology_position(candidate)
		if not _topology_position_satisfies_constraints(clamped, constraints):
			continue
		var distance := clamped.distance_to(desired_pos)
		if distance < best_distance:
			best_distance = distance
			best = clamped
	if best_distance < 999999.0:
		return best
	if _topology_position_satisfies_constraints(fallback_pos, constraints):
		return fallback_pos
	return _clamp_topology_position(fallback_pos)


func _topology_node_axis_for_socket_alignment(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int, socket_id: String, anchor_pos: Vector2, desired_pos: Vector2) -> Vector2:
	var node: Dictionary = nodes[node_index]
	var current_pos := _topology_node_position(node)
	var axis := _topology_endpoint_axis_for_node(node_index, nodes, edges)
	var direction := _clamp_topology_position(desired_pos) - anchor_pos
	if direction.length() < 0.0001:
		direction = current_pos - anchor_pos
	if direction.length() < 0.0001:
		direction = axis
	if direction.length() < 0.0001:
		direction = Vector2.RIGHT
	var id := _topology_canonical_socket_id(socket_id)
	if _topology_node_uses_endpoint_sides(role_key, node, unit_bp):
		var side := _topology_socket_side_value(id)
		if side < 0:
			axis = direction.normalized()
		elif side > 0:
			axis = -direction.normalized()
	if axis.length() < 0.0001:
		axis = Vector2.RIGHT
	return axis.normalized()


func _topology_position_for_socket_alignment(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int, socket_id: String, target_pos: Vector2, desired_pos: Vector2) -> Dictionary:
	if node_index < 0 or node_index >= nodes.size():
		return {"pos": _clamp_topology_position(desired_pos)}
	var node: Dictionary = nodes[node_index]
	var id := _topology_canonical_socket_id(socket_id)
	if _topology_node_is_torso(role_key, node, unit_bp):
		# Torso is the stable root of the direct-muscle graph. Socket snapping may
		# move child muscles to a torso port, but must never drag the torso itself.
		return {"pos": _topology_node_position(node)}
	if _topology_node_slot(node) == "joint":
		return {"pos": _clamp_topology_position(target_pos)}
	if _topology_node_uses_endpoint_sides(role_key, node, unit_bp):
		var axis := _topology_node_axis_for_socket_alignment(role_key, unit_bp, nodes, edges, node_index, id, target_pos, desired_pos)
		var side := _topology_socket_side_value(id)
		var extent := _topology_node_visual_edge_extent_units(role_key, node, unit_bp, id) / TOPOLOGY_BOARD_PHYSICAL_UNITS
		return {
			"pos": _clamp_topology_position(target_pos - axis * extent * float(side)),
			"axis": axis,
		}
	var current_socket := _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, node_index, id)
	return {"pos": _clamp_topology_position(_topology_node_position(node) + (target_pos - current_socket))}


func _topology_apply_socket_alignment(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int, socket_id: String, target_pos: Vector2, desired_pos: Vector2) -> Dictionary:
	var node: Dictionary = nodes[node_index]
	var aligned := _topology_position_for_socket_alignment(role_key, unit_bp, nodes, edges, node_index, socket_id, target_pos, desired_pos)
	node["pos"] = aligned.get("pos", _topology_node_position(node))
	if aligned.has("axis"):
		node["axis"] = aligned["axis"]
	return node


func _snap_position_to_fixed_connection(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int, desired_pos: Vector2) -> Vector2:
	if node_index < 0 or node_index >= nodes.size():
		return _clamp_topology_position(desired_pos)
	var neighbors := _connected_topology_neighbors(edges, node_index, nodes.size())
	if neighbors.is_empty():
		return _clamp_topology_position(desired_pos)
	var current_pos := _clamp_topology_position(_topology_node_position(nodes[node_index]))
	if _topology_node_is_torso(role_key, nodes[node_index], unit_bp):
		return current_pos
	if neighbors.size() == 1:
		var neighbor_index := int(neighbors[0])
		var edge = _topology_find_edge_between(edges, node_index, neighbor_index)
		var own_socket := _topology_edge_socket_for_node(edge, node_index)
		var neighbor_socket := _topology_edge_socket_for_node(edge, neighbor_index)
		if own_socket != "" and neighbor_socket != "":
			var target_pos := _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, neighbor_index, neighbor_socket, node_index)
			var aligned := _topology_position_for_socket_alignment(role_key, unit_bp, nodes, edges, node_index, own_socket, target_pos, desired_pos)
			if aligned.has("axis"):
				var node: Dictionary = nodes[node_index]
				node["axis"] = aligned["axis"]
				nodes[node_index] = node
			return aligned.get("pos", current_pos)
		return current_pos
	# New embedded-joint topology is endpoint-exact. A node that is already
	# constrained by two sockets cannot be solved by old center-distance
	# circles without making muscles appear to rotate around their centers.
	# Move the whole selected structure or unlink first.
	return current_pos


func _snap_all_topology_edges(role_key: String, unit_bp: Dictionary) -> void:
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	edges = _topology_canonical_socket_edges(role_key, unit_bp, nodes, edges)
	topology["edges"] = edges
	if nodes.is_empty() or edges.is_empty():
		topology["nodes"] = nodes
		topology["edge_snap_version"] = TOPOLOGY_SNAP_VERSION
		unit_bp["custom_topology"] = topology
		return
	var adjacency := {}
	var endpoint_conflicts := _topology_endpoint_conflicts(role_key, unit_bp, nodes, edges)
	for edge in edges:
		var a := _topology_edge_node_a(edge)
		var b := _topology_edge_node_b(edge)
		if a < 0 or b < 0 or a >= nodes.size() or b >= nodes.size():
			continue
		if not adjacency.has(a):
			adjacency[a] = []
		if not adjacency.has(b):
			adjacency[b] = []
		adjacency[a].append({"neighbor": b, "edge": edge})
		adjacency[b].append({"neighbor": a, "edge": edge})
	var root_index := 0
	for i in range(nodes.size()):
		if nodes[i] is Dictionary and _topology_node_is_torso(role_key, nodes[i], unit_bp):
			root_index = i
			break
	var visited := {root_index: true}
	var queue: Array = [root_index]
	while not queue.is_empty():
		var parent_index := int(queue.pop_front())
		if not adjacency.has(parent_index):
			continue
		var parent_node: Dictionary = nodes[parent_index]
		for neighbor_raw in Array(adjacency[parent_index]):
			if not (neighbor_raw is Dictionary):
				continue
			var neighbor_info: Dictionary = neighbor_raw
			var child_index := int(neighbor_info.get("neighbor", -1))
			if visited.has(child_index):
				continue
			var child_node: Dictionary = nodes[child_index]
			var edge = neighbor_info.get("edge")
			if bool(endpoint_conflicts.get(_topology_edge_key(parent_index, child_index), false)):
				visited[child_index] = true
				queue.append(child_index)
				continue
			var parent_socket := _topology_edge_socket_for_node(edge, parent_index)
			var child_socket := _topology_edge_socket_for_node(edge, child_index)
			if parent_socket != "" and child_socket != "":
				var target_pos := _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, parent_index, parent_socket, child_index)
				child_node = _topology_apply_socket_alignment(role_key, unit_bp, nodes, edges, child_index, child_socket, target_pos, _topology_node_position(child_node))
			else:
				visited[child_index] = true
				queue.append(child_index)
				continue
			nodes[child_index] = child_node
			visited[child_index] = true
			queue.append(child_index)
	topology["nodes"] = nodes
	topology["edge_snap_version"] = TOPOLOGY_SNAP_VERSION
	unit_bp["custom_topology"] = topology
	_topology_update_local_pose_fields(role_key, unit_bp)


func _move_custom_node_to(unit_bp: Dictionary, node_index: int, local_position: Vector2) -> void:
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if node_index < 0 or node_index >= nodes.size():
		return
	var node: Dictionary = nodes[node_index]
	var desired_pos := _board_position_to_topology(local_position)
	var role_key: String = ROLE_ORDER[editor_role_index]
	node["pos"] = _snap_position_to_fixed_connection(role_key, unit_bp, nodes, topology.get("edges", []), node_index, desired_pos)
	nodes[node_index] = node
	topology["nodes"] = nodes
	unit_bp["custom_topology"] = topology
	_topology_update_local_pose_fields(role_key, unit_bp)
	editor_topology_node_index = node_index
	editor_selected_body_part = BODY_PART_ORDER[node_index % BODY_PART_ORDER.size()]
	editor_snap_timer = 0.08
	editor_snap_part = "node"
	if editor_board_hint_label != null:
		editor_board_hint_label.text = "刚性拖拽节点 %d：已连接部件会保持固定贴合距离。" % (node_index + 1) if _ui_is_zh() else "Rigid snap node %d: linked parts stay at one exact contact distance." % (node_index + 1)
	ai_team_manual_lock[_editor_player()] = true
	_refresh_editor_visual_views_fast_drag([node_index])
	_queue_board_socket_candidate_update(node_index, "drag.move")


func _clear_cached_board_socket_candidate() -> void:
	editor_cached_socket_candidate = {}
	editor_cached_socket_candidate_node = -1
	editor_cached_socket_candidate_pos = Vector2.INF
	editor_cached_socket_candidate_msec = -1000000


func _queue_board_socket_candidate_update(node_index: int, reason: String = "drag") -> void:
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	if not _role_uses_body_board(role_key) or not unit_bp.has("custom_topology"):
		_clear_cached_board_socket_candidate()
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	if node_index < 0 or node_index >= nodes.size() or _topology_node_edge_count(edges, node_index) > 0:
		_clear_cached_board_socket_candidate()
		return
	var node_pos := _topology_node_position(nodes[node_index])
	var now := Time.get_ticks_msec()
	if editor_cached_socket_candidate_node == node_index \
			and editor_cached_socket_candidate_pos.distance_to(node_pos) < 0.04 \
			and now - editor_cached_socket_candidate_msec < 90:
		return
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("magnetic_link.prepare")
	editor_cached_socket_candidate = _topology_socket_candidate(role_key, unit_bp, nodes, edges, node_index, true)
	editor_cached_socket_candidate_node = node_index
	editor_cached_socket_candidate_pos = node_pos
	editor_cached_socket_candidate_msec = now
	editor_socket_candidate_update_count += 1
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("magnetic_link.prepare")


func _consume_cached_board_socket_candidate(node_index: int) -> Dictionary:
	editor_socket_candidate_consume_count += 1
	if editor_cached_socket_candidate_node != node_index:
		return {}
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	if not _role_uses_body_board(role_key) or not unit_bp.has("custom_topology"):
		return {}
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if node_index < 0 or node_index >= nodes.size():
		return {}
	var node_pos := _topology_node_position(nodes[node_index])
	if editor_cached_socket_candidate_pos.distance_to(node_pos) > 0.08:
		return {}
	editor_socket_candidate_cache_hit_count += 1
	return editor_cached_socket_candidate.duplicate(true)


func _start_whole_topology_drag(unit_bp: Dictionary, local_position: Vector2) -> void:
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if nodes.is_empty():
		return
	_record_editor_undo_state("平移整机/结界" if _ui_is_zh() else "move whole topology")
	editor_dragging_whole_unit = true
	editor_dragging_node_index = -1
	editor_drag_whole_start = local_position
	editor_drag_whole_original_positions = []
	for node in nodes:
		if node is Dictionary:
			editor_drag_whole_original_positions.append(_topology_node_position(node))
		else:
			editor_drag_whole_original_positions.append(Vector2(0.5, 0.5))
	editor_board_hint_label.text = "正在拖动整个单位：所有节点一起移动，连接距离和拓扑关系保持不变。" if _ui_is_zh() else "Dragging whole unit: every node moves together; topology distances stay unchanged."
	ai_team_manual_lock[_editor_player()] = true


func _move_custom_topology_by_delta(unit_bp: Dictionary, local_delta: Vector2) -> void:
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if nodes.is_empty() or editor_drag_whole_original_positions.size() != nodes.size():
		return
	var requested_delta := local_delta / _topology_board_uniform_scale()
	var topology_delta := _topology_clamped_delta_for_positions(editor_drag_whole_original_positions, requested_delta)
	for i in range(nodes.size()):
		var node: Dictionary = nodes[i]
		var original: Vector2 = editor_drag_whole_original_positions[i]
		node["pos"] = original + topology_delta
		nodes[i] = node
	topology["nodes"] = nodes
	unit_bp["custom_topology"] = topology
	_topology_update_local_pose_fields(ROLE_ORDER[editor_role_index], unit_bp)
	ai_team_manual_lock[_editor_player()] = true
	_refresh_editor_visual_views_fast_drag()


func _finish_rigid_topology_drag(unit_bp: Dictionary, success_message: String, repaired_message: String, skip_gap_scan: bool = false, changed_nodes: Array = []) -> void:
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("finish_drag")
	if not unit_bp.has("custom_topology"):
		if editor_board_hint_label != null:
			editor_board_hint_label.text = success_message
		_mark_editor_board_model_dirty("drag.finish_no_topology")
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("finish_drag")
		return
	if skip_gap_scan:
		if editor_board_hint_label != null:
			editor_board_hint_label.text = success_message
		_refresh_editor_visual_views_fast_drag(changed_nodes)
		_schedule_editor_stats_idle_refresh("drag.finish_light")
		mark_editor_dirty(EDITOR_DIRTY_ACTION_BUTTONS, "drag.finish_light")
		flush_editor_dirty(600)
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("finish_drag")
		return
	var role_key: String = ROLE_ORDER[editor_role_index]
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	var gap := _topology_max_socket_gap(role_key, unit_bp, nodes, edges)
	if gap > 0.00001:
		_snap_all_topology_edges(role_key, unit_bp)
		if editor_board_hint_label != null:
			editor_board_hint_label.text = repaired_message
	else:
		if editor_board_hint_label != null:
			editor_board_hint_label.text = success_message
	_mark_editor_board_model_dirty("drag.finish")
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("finish_drag")


func _start_topology_selection_box(unit_bp: Dictionary, local_position: Vector2) -> void:
	if not unit_bp.has("custom_topology"):
		return
	editor_selecting_topology_box = true
	editor_dragging_node_index = -1
	editor_dragging_selected_nodes = false
	editor_dragging_whole_unit = false
	editor_selection_box_start = local_position
	editor_selection_box_current = local_position
	if editor_board_hint_label != null:
		editor_board_hint_label.text = "框选画布：松开鼠标后选中范围内构件；随后拖动任一选中构件即可整体移动。" if _ui_is_zh() else "Box-select canvas: release to select parts; then drag any selected part to move the group."
	_mark_editor_board_overlay_dirty("selection_box.start")


func _finish_topology_selection_box(unit_bp: Dictionary, local_position: Vector2) -> void:
	editor_selecting_topology_box = false
	editor_selection_box_current = local_position
	if not unit_bp.has("custom_topology"):
		editor_selected_topology_nodes = []
		_mark_editor_board_overlay_dirty("selection_box.finish_no_topology")
		return
	var rect := _selection_rect_from_points(editor_selection_box_start, editor_selection_box_current)
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var role_key: String = ROLE_ORDER[editor_role_index]
	var selected: Array = []
	for i in range(nodes.size()):
		var node: Dictionary = nodes[i]
		var node_pos := _topology_position_to_board_local(_topology_node_position(node))
		if rect.has_point(node_pos):
			selected.append(i)
	editor_selected_topology_nodes = selected
	if not editor_pending_module_binding.is_empty():
		_complete_pending_module_binding_with_selection(unit_bp, selected)
		return
	if not selected.is_empty():
		editor_topology_node_index = int(selected[0])
		editor_selected_body_part = BODY_PART_ORDER[editor_topology_node_index % BODY_PART_ORDER.size()]
		if editor_board_tool == "pose":
			var root_index := _pose_root_for_selection(role_key, unit_bp, nodes, topology.get("edges", []), selected)
			if root_index >= 0 and _pose_selection_is_single_downstream_chain(role_key, unit_bp, nodes, topology.get("edges", []), root_index, selected):
				editor_pose_root_node = root_index
				editor_pose_downstream_nodes = _topology_downstream_node_indices(role_key, unit_bp, nodes, topology.get("edges", []), root_index)
				editor_selected_topology_nodes = editor_pose_downstream_nodes.duplicate()
				editor_topology_node_index = root_index
				editor_board_hint_label.text = "已框选一条肢体子链：拖动构件 %d 只旋转它及下游链。" % (root_index + 1) if _ui_is_zh() else "Selected one limb subchain: drag part %d to rotate only it and its downstream chain." % (root_index + 1)
			else:
				editor_pose_root_node = -1
				editor_pose_downstream_nodes = []
				editor_board_hint_label.text = "框选内容不是同一条下游肢体链；请只框选一条肢体。" if _ui_is_zh() else "Selection is not one downstream limb chain; box-select only one limb."
				_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		else:
			if _topology_selection_contains_torso(role_key, unit_bp, nodes, selected):
				var expanded := _topology_connected_component_indices(topology.get("edges", []), nodes.size(), selected)
				if not expanded.is_empty():
					editor_selected_topology_nodes = expanded
					editor_topology_node_index = int(expanded[0])
				editor_board_hint_label.text = "框选包含躯干：拖动时整台机体按刚体平移。" if _ui_is_zh() else "Selection includes a torso: dragging moves the whole mech as a rigid body."
			elif _topology_selection_has_connected_node(topology.get("edges", []), selected):
				editor_board_hint_label.text = "框选的是已连接肢体链：请切到姿态模式进行旋转/伸缩测试。" if _ui_is_zh() else "Selected a connected limb chain: switch to POSE to rotate or extend it."
			else:
				editor_board_hint_label.text = "已框选 %d 个未连接构件：拖动可一起平移。" % editor_selected_topology_nodes.size() if _ui_is_zh() else "Selected %d loose parts: dragging moves them together." % editor_selected_topology_nodes.size()
	else:
		editor_board_hint_label.text = "框选为空：请从零件库拖入构件，或框住已有节点。" if _ui_is_zh() else "Empty selection: drag parts from the library or box existing nodes."
	_mark_editor_board_model_dirty("selection_box.finish")


func _selection_rect_from_points(a: Vector2, b: Vector2) -> Rect2:
	var pos := Vector2(minf(a.x, b.x), minf(a.y, b.y))
	var rect_size := Vector2(maxf(4.0, absf(a.x - b.x)), maxf(4.0, absf(a.y - b.y)))
	return Rect2(pos, rect_size)


func _topology_selection_contains_torso(role_key: String, unit_bp: Dictionary, nodes: Array, node_indices: Array) -> bool:
	for raw_index in node_indices:
		var index := int(raw_index)
		if index >= 0 and index < nodes.size() and nodes[index] is Dictionary and _topology_node_is_torso(role_key, nodes[index], unit_bp):
			return true
	return false


func _topology_selection_has_connected_node(edges: Array, node_indices: Array) -> bool:
	for raw_index in node_indices:
		var index := int(raw_index)
		if _topology_node_edge_count(edges, index) > 0:
			return true
	return false


func _start_topology_group_drag(unit_bp: Dictionary, local_position: Vector2, node_indices: Array, expand_connected_island: bool = false) -> void:
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if nodes.is_empty():
		return
	var unique := {}
	var sanitized: Array = []
	var edges: Array = topology.get("edges", [])
	var expanded_indices := _topology_connected_component_indices(edges, nodes.size(), node_indices) if expand_connected_island else node_indices.duplicate()
	if expanded_indices.is_empty():
		expanded_indices = node_indices.duplicate()
	for raw_index in expanded_indices:
		var index := int(raw_index)
		if index < 0 or index >= nodes.size() or unique.has(index):
			continue
		unique[index] = true
		sanitized.append(index)
	if sanitized.is_empty():
		return
	_record_editor_undo_state("拖动框选构件" if _ui_is_zh() else "move selected topology")
	editor_selected_topology_nodes = sanitized
	editor_dragging_selected_nodes = true
	editor_dragging_whole_unit = false
	editor_dragging_node_index = int(sanitized[0])
	editor_group_drag_start = local_position
	editor_group_drag_original_positions = []
	for raw_index in sanitized:
		var index := int(raw_index)
		editor_group_drag_original_positions.append({"index": index, "pos": _topology_node_position(nodes[index])})
	editor_board_hint_label.text = "正在拖动 %d 个连接岛构件：像螺栓固定一样整体平移。" % sanitized.size() if expand_connected_island and _ui_is_zh() else ("Dragging %d connected-island parts as one bolted rigid body." % sanitized.size() if expand_connected_island else ("正在拖动 %d 个未连接构件。" % sanitized.size() if _ui_is_zh() else "Dragging %d loose part(s)." % sanitized.size()))
	ai_team_manual_lock[_editor_player()] = true


func _move_selected_topology_nodes_by_delta(unit_bp: Dictionary, local_delta: Vector2) -> void:
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if nodes.is_empty() or editor_group_drag_original_positions.is_empty():
		return
	var original_positions: Array = []
	for raw_item in editor_group_drag_original_positions:
		if raw_item is Dictionary:
			original_positions.append(Dictionary(raw_item).get("pos", Vector2.ZERO))
	var requested_delta := local_delta / _topology_board_uniform_scale()
	var topology_delta := _topology_clamped_delta_for_positions(original_positions, requested_delta)
	for raw_item in editor_group_drag_original_positions:
		if not (raw_item is Dictionary):
			continue
		var item: Dictionary = raw_item
		var index := int(item.get("index", -1))
		if index < 0 or index >= nodes.size():
			continue
		var node: Dictionary = nodes[index]
		var original: Vector2 = item.get("pos", _topology_node_position(node))
		node["pos"] = original + topology_delta
		nodes[index] = node
	topology["nodes"] = nodes
	unit_bp["custom_topology"] = topology
	_topology_update_local_pose_fields(ROLE_ORDER[editor_role_index], unit_bp)
	ai_team_manual_lock[_editor_player()] = true
	var changed: Array = []
	for raw_item in editor_group_drag_original_positions:
		if raw_item is Dictionary:
			changed.append(int(Dictionary(raw_item).get("index", -1)))
	_refresh_editor_visual_views_fast_drag(changed)


func _topology_downstream_node_indices(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, root_index: int) -> Array:
	var raw_nodes := TopologyGeometry.downstream_nodes_from_edges(edges, root_index, nodes.size())
	if not raw_nodes.has(root_index):
		raw_nodes.push_front(root_index)
	var filtered: Array = []
	for raw_index in raw_nodes:
		var index := int(raw_index)
		if index < 0 or index >= nodes.size() or not (nodes[index] is Dictionary):
			continue
		var node: Dictionary = nodes[index]
		if not _topology_node_is_component(node) or _topology_node_is_torso(role_key, node, unit_bp):
			continue
		if not filtered.has(index):
			filtered.append(index)
	return filtered


func _topology_parent_edge_info(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int) -> Dictionary:
	if node_index < 0 or node_index >= nodes.size():
		return {}
	for edge in edges:
		if not _topology_edge_has_node(edge, node_index):
			continue
		var own_socket := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, node_index))
		if own_socket != "root_joint":
			continue
		var parent_index := _topology_edge_other_node(edge, node_index)
		if parent_index < 0 or parent_index >= nodes.size():
			continue
		var parent_socket := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, parent_index))
		if _topology_node_is_torso(role_key, nodes[parent_index], unit_bp) and parent_socket.begins_with("torso_port:"):
			return {"parent": parent_index, "parent_socket": parent_socket, "edge": edge}
		if parent_socket == "distal":
			return {"parent": parent_index, "parent_socket": parent_socket, "edge": edge}
	return {}


func _topology_child_edges_for_parent(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, parent_index: int) -> Array:
	var result: Array = []
	if parent_index < 0 or parent_index >= nodes.size():
		return result
	for edge in edges:
		if not _topology_edge_has_node(edge, parent_index):
			continue
		var parent_socket := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, parent_index))
		var child_index := _topology_edge_other_node(edge, parent_index)
		if child_index < 0 or child_index >= nodes.size():
			continue
		var child_socket := _topology_canonical_socket_id(_topology_edge_socket_for_node(edge, child_index))
		var parent_is_torso := _topology_node_is_torso(role_key, nodes[parent_index], unit_bp)
		var legal_parent_socket := (parent_is_torso and parent_socket.begins_with("torso_port:")) or (not parent_is_torso and parent_socket == "distal")
		if legal_parent_socket and child_socket == "root_joint":
			result.append({"child": child_index, "parent_socket": parent_socket, "edge": edge})
	return result


func _topology_world_axis_from_torso_slot(role_key: String, unit_bp: Dictionary, nodes: Array, torso_index: int, port_socket: String) -> Vector2:
	if torso_index < 0 or torso_index >= nodes.size():
		return Vector2.RIGHT
	var torso_node: Dictionary = nodes[torso_index]
	var part := _topology_node_part(role_key, torso_node, unit_bp)
	var profiles := _torso_joint_slot_profiles_for_part(part)
	var port_index := 0
	if port_socket.begins_with("torso_port:"):
		port_index = clampi(int(port_socket.get_slice(":", 1)), 0, maxi(0, profiles.size() - 1))
	var local_angle := 0.0
	if port_index >= 0 and port_index < profiles.size() and profiles[port_index] is Dictionary:
		local_angle = float(Dictionary(profiles[port_index]).get("center_angle", 0.0))
	var forward := _topology_node_axis(torso_node)
	if forward.length() < 0.001:
		forward = Vector2.RIGHT
	return forward.normalized().rotated(local_angle)


func _topology_parent_axis_for_node(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int) -> Vector2:
	var parent_info := _topology_parent_edge_info(role_key, unit_bp, nodes, edges, node_index)
	if parent_info.is_empty():
		return Vector2.RIGHT
	var parent_index := int(parent_info.get("parent", -1))
	var parent_socket := String(parent_info.get("parent_socket", ""))
	if parent_index < 0 or parent_index >= nodes.size():
		return Vector2.RIGHT
	if _topology_node_is_torso(role_key, nodes[parent_index], unit_bp):
		return _topology_world_axis_from_torso_slot(role_key, unit_bp, nodes, parent_index, parent_socket).normalized()
	return _topology_endpoint_axis_for_node(parent_index, nodes, edges).normalized()


func _topology_mount_parent_axis_for_node(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int) -> Vector2:
	var axis := _topology_parent_axis_for_node(role_key, unit_bp, nodes, edges, node_index)
	if axis.length() < 0.0001:
		axis = _topology_endpoint_axis_for_node(node_index, nodes, edges)
	if axis.length() < 0.0001:
		axis = Vector2.RIGHT
	return axis.normalized()


func _topology_update_local_pose_fields(role_key: String, unit_bp: Dictionary) -> void:
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	for i in range(nodes.size()):
		if not (nodes[i] is Dictionary):
			continue
		var node: Dictionary = nodes[i]
		if not _topology_node_is_component(node) or _topology_node_is_torso(role_key, node, unit_bp):
			nodes[i] = node
			continue
		var parent_info := _topology_parent_edge_info(role_key, unit_bp, nodes, edges, i)
		if parent_info.is_empty():
			nodes[i] = node
			continue
		var parent_axis := _topology_parent_axis_for_node(role_key, unit_bp, nodes, edges, i)
		var own_axis := _topology_endpoint_axis_for_node(i, nodes, edges)
		if parent_axis.length() < 0.001:
			parent_axis = Vector2.RIGHT
		if own_axis.length() < 0.001:
			own_axis = parent_axis
		node["parent_node"] = int(parent_info.get("parent", -1))
		node["parent_socket"] = String(parent_info.get("parent_socket", ""))
		node["root_socket"] = "root_joint"
		node["local_angle"] = wrapf(own_axis.angle() - parent_axis.angle(), -PI, PI)
		if not node.has("local_extension"):
			node["local_extension"] = 0.0
		nodes[i] = node
	topology["nodes"] = nodes
	unit_bp["custom_topology"] = topology


func _topology_apply_local_fk(role_key: String, unit_bp: Dictionary, root_filter: int = -1) -> void:
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	if nodes.is_empty():
		return
	var allowed := {}
	if root_filter >= 0:
		for raw_index in _topology_downstream_node_indices(role_key, unit_bp, nodes, edges, root_filter):
			allowed[int(raw_index)] = true
	var queue: Array = []
	for i in range(nodes.size()):
		if nodes[i] is Dictionary and _topology_node_is_torso(role_key, nodes[i], unit_bp):
			queue.append(i)
	var guard := 0
	while not queue.is_empty() and guard < nodes.size() * 12:
		guard += 1
		var parent_index := int(queue.pop_front())
		if parent_index < 0 or parent_index >= nodes.size():
			continue
		for raw_child in _topology_child_edges_for_parent(role_key, unit_bp, nodes, edges, parent_index):
			if not (raw_child is Dictionary):
				continue
			var child_info: Dictionary = raw_child
			var child_index := int(child_info.get("child", -1))
			if child_index < 0 or child_index >= nodes.size():
				continue
			var parent_socket := String(child_info.get("parent_socket", ""))
			if root_filter >= 0 and not allowed.has(child_index):
				queue.append(child_index)
				continue
			var root_pos := _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, parent_index, parent_socket, child_index)
			var parent_axis := Vector2.RIGHT
			if _topology_node_is_torso(role_key, nodes[parent_index], unit_bp):
				parent_axis = _topology_world_axis_from_torso_slot(role_key, unit_bp, nodes, parent_index, parent_socket)
			else:
				parent_axis = _topology_endpoint_axis_for_node(parent_index, nodes, edges)
			if parent_axis.length() < 0.001:
				parent_axis = Vector2.RIGHT
			var child_node: Dictionary = nodes[child_index]
			var local_angle := float(child_node.get("local_angle", 0.0))
			var child_axis := parent_axis.normalized().rotated(local_angle).normalized()
			var extent := _topology_node_edge_extent_units(role_key, child_node, unit_bp) / TOPOLOGY_BOARD_PHYSICAL_UNITS
			var extension := maxf(0.0, float(child_node.get("local_extension", 0.0))) / TOPOLOGY_BOARD_PHYSICAL_UNITS
			child_node["axis"] = child_axis
			child_node["pos"] = _clamp_topology_position(root_pos + child_axis * (extent + extension * 0.5))
			child_node["parent_node"] = parent_index
			child_node["parent_socket"] = parent_socket
			child_node["root_socket"] = "root_joint"
			nodes[child_index] = child_node
			queue.append(child_index)
	topology["nodes"] = nodes
	unit_bp["custom_topology"] = topology


func _topology_distance_from_nearest_torso(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, target_index: int) -> int:
	if target_index < 0 or target_index >= nodes.size():
		return 999999
	var queue: Array = []
	var visited := {}
	for i in range(nodes.size()):
		if nodes[i] is Dictionary and _topology_node_is_torso(role_key, nodes[i], unit_bp):
			queue.append({"index": i, "distance": 0})
			visited[i] = true
	while not queue.is_empty():
		var item: Dictionary = queue.pop_front()
		var current := int(item.get("index", -1))
		var distance := int(item.get("distance", 0))
		if current == target_index:
			return distance
		for neighbor_raw in _connected_topology_neighbors(edges, current, nodes.size()):
			var neighbor := int(neighbor_raw)
			if neighbor < 0 or neighbor >= nodes.size() or visited.has(neighbor):
				continue
			visited[neighbor] = true
			queue.append({"index": neighbor, "distance": distance + 1})
	return 999999


func _pose_root_for_selection(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, selection: Array) -> int:
	var best := -1
	var best_distance := 999999
	for raw_index in selection:
		var index := int(raw_index)
		if index < 0 or index >= nodes.size() or not (nodes[index] is Dictionary):
			continue
		var node: Dictionary = nodes[index]
		if not _topology_node_is_component(node) or _topology_node_is_torso(role_key, node, unit_bp):
			continue
		var slot_key := _topology_node_slot(node)
		if not (slot_key == "limb_muscle" or slot_key == "muscle"):
			continue
		var distance := _topology_distance_from_nearest_torso(role_key, unit_bp, nodes, edges, index)
		if distance < best_distance:
			best_distance = distance
			best = index
	return best


func _pose_root_for_click(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, clicked_index: int) -> int:
	if clicked_index < 0 or clicked_index >= nodes.size() or not (nodes[clicked_index] is Dictionary):
		return -1
	var clicked_node: Dictionary = nodes[clicked_index]
	if _topology_node_is_torso(role_key, clicked_node, unit_bp):
		return -1
	return clicked_index


func _topology_parent_index_for_node(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int) -> int:
	var parent_info := _topology_parent_edge_info(role_key, unit_bp, nodes, edges, node_index)
	return int(parent_info.get("parent", -1)) if not parent_info.is_empty() else -1


func _topology_node_parent_is_torso(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, node_index: int) -> bool:
	var parent_index := _topology_parent_index_for_node(role_key, unit_bp, nodes, edges, node_index)
	return parent_index >= 0 and parent_index < nodes.size() and _topology_node_is_torso(role_key, nodes[parent_index], unit_bp)


func _pose_selection_is_single_downstream_chain(role_key: String, unit_bp: Dictionary, nodes: Array, edges: Array, root_index: int, selection: Array) -> bool:
	if root_index < 0:
		return false
	var downstream := _topology_downstream_node_indices(role_key, unit_bp, nodes, edges, root_index)
	if downstream.is_empty():
		return false
	for raw_index in selection:
		var index := int(raw_index)
		if index < 0 or index >= nodes.size():
			continue
		if _topology_node_is_torso(role_key, nodes[index], unit_bp):
			continue
		if not downstream.has(index):
			return false
	return true


func _topology_pose_node_snapshot(nodes: Array, index: int) -> Dictionary:
	var item := {"index": index}
	if index < 0 or index >= nodes.size() or not (nodes[index] is Dictionary):
		return item
	var node: Dictionary = nodes[index]
	for key in ["pos", "axis", "rotation", "local_angle", "local_extension", "parent_node", "parent_socket", "root_socket"]:
		if node.has(key):
			item[key] = node[key]
	return item


func _topology_update_local_pose_fields_for_nodes(role_key: String, unit_bp: Dictionary, target_nodes: Array) -> void:
	if target_nodes.is_empty() or not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	for raw_index in target_nodes:
		var index := int(raw_index)
		if index < 0 or index >= nodes.size() or not (nodes[index] is Dictionary):
			continue
		var node: Dictionary = nodes[index]
		var parent_index := _topology_parent_index_for_node(role_key, unit_bp, nodes, edges, index)
		if parent_index >= 0 and parent_index < nodes.size():
			var parent_pos := _topology_node_position(nodes[parent_index])
			var node_pos := _topology_node_position(node)
			node["local_angle"] = (node_pos - parent_pos).angle()
			node["parent_node"] = parent_index
		elif not node.has("local_angle"):
			node["local_angle"] = _topology_endpoint_axis_for_node(index, nodes, edges).angle()
		nodes[index] = node
	topology["nodes"] = nodes
	unit_bp["custom_topology"] = topology


func _start_editor_pose_drag(unit_bp: Dictionary, root_index: int, local_position: Vector2, selected_hint: Array = []) -> bool:
	if not unit_bp.has("custom_topology"):
		return false
	var role_key: String = ROLE_ORDER[editor_role_index]
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	if root_index < 0 or root_index >= nodes.size():
		return false
	var downstream := _topology_downstream_node_indices(role_key, unit_bp, nodes, edges, root_index)
	if downstream.is_empty():
		if editor_board_hint_label != null:
			editor_board_hint_label.text = "姿态编辑需要点击带根部关节的肢体或末端武器。" if _ui_is_zh() else "Pose editing needs a limb or terminal weapon with a root joint."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return false
	if not downstream.has(root_index):
		downstream.push_front(root_index)
	if not selected_hint.is_empty() and not _pose_selection_is_single_downstream_chain(role_key, unit_bp, nodes, edges, root_index, selected_hint):
		if editor_board_hint_label != null:
			editor_board_hint_label.text = "框选内容不在同一条下游肢体链中，不能作为一个姿态整体旋转。" if _ui_is_zh() else "The selection is not one downstream limb chain, so it cannot rotate as one pose subtree."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return false
	var pivot := _topology_socket_position_by_id(role_key, unit_bp, nodes, edges, root_index, "root_joint")
	var mouse_topology := _board_position_to_topology(local_position)
	var start_vec := mouse_topology - pivot
	if start_vec.length() < 0.0001:
		start_vec = _topology_endpoint_axis_for_node(root_index, nodes, edges)
	if start_vec.length() < 0.0001:
		start_vec = Vector2.RIGHT
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("pose.start.local_pose")
	var needs_local_pose := false
	for raw_index in downstream:
		var pose_index := int(raw_index)
		if pose_index >= 0 and pose_index < nodes.size() and nodes[pose_index] is Dictionary and not Dictionary(nodes[pose_index]).has("local_angle"):
			needs_local_pose = true
			break
	if needs_local_pose:
		_topology_update_local_pose_fields_for_nodes(role_key, unit_bp, downstream)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("pose.start.local_pose")
	topology = unit_bp.get("custom_topology", {})
	nodes = topology.get("nodes", [])
	edges = topology.get("edges", [])
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("pose.start.undo")
	var pose_restore_nodes: Array = []
	for raw_index in downstream:
		pose_restore_nodes.append(_topology_pose_node_snapshot(nodes, int(raw_index)))
	_push_editor_undo_command({
		"command_type": "restore_pose",
		"label": "编辑入场姿态" if _ui_is_zh() else "edit entry pose",
		"nodes": pose_restore_nodes,
		"previous_entry_pose": Dictionary(unit_bp.get("entry_pose", {})).duplicate(true),
		"previous_topology_node_index": editor_topology_node_index,
		"previous_selected_topology_nodes": editor_selected_topology_nodes.duplicate(),
	})
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("pose.start.undo")
	editor_pose_dragging = true
	editor_pose_root_node = root_index
	editor_pose_downstream_nodes = downstream
	editor_pose_original_entry_pose = Dictionary(unit_bp.get("entry_pose", {})).duplicate(true)
	editor_pose_pivot = pivot
	editor_pose_drag_start_angle = start_vec.angle()
	editor_pose_pending_local_position = local_position
	editor_pose_pending_update = false
	editor_pose_last_applied_angle = INF
	editor_pose_drag_original_positions = []
	for raw_index in downstream:
		var pose_index := int(raw_index)
		if pose_index < 0 or pose_index >= nodes.size() or not (nodes[pose_index] is Dictionary):
			continue
		var pose_node: Dictionary = nodes[pose_index]
		editor_pose_drag_original_positions.append({
			"index": pose_index,
			"local_angle": float(pose_node.get("local_angle", 0.0)),
			"pos": _topology_node_position(pose_node),
			"axis": _topology_endpoint_axis_for_node(pose_index, nodes, edges),
			"is_root": pose_index == root_index,
		})
	editor_topology_node_index = root_index
	editor_selected_topology_nodes = downstream.duplicate()
	editor_dragging_node_index = -1
	editor_dragging_selected_nodes = false
	editor_dragging_whole_unit = false
	editor_selecting_topology_box = false
	if editor_board_hint_label != null:
		editor_board_hint_label.text = "正在姿态编辑：当前构件带动 %d 个下游构件随动，上游近端保持静止。" % downstream.size() if _ui_is_zh() else "Pose edit: this part drives %d downstream part(s); upstream ancestors stay fixed." % downstream.size()
	ai_team_manual_lock[_editor_player()] = true
	_refresh_editor_visual_views_fast_drag(editor_pose_downstream_nodes, false, true)
	return true


func _update_editor_pose_drag(unit_bp: Dictionary, local_position: Vector2) -> void:
	if not editor_pose_dragging:
		return
	editor_pose_pending_local_position = local_position
	editor_pose_pending_update = true
	editor_pose_drag_coalesced_count += 1


func _apply_editor_pose_drag_pending(unit_bp: Dictionary) -> void:
	if not editor_pose_dragging or not unit_bp.has("custom_topology"):
		return
	if not editor_pose_pending_update:
		return
	editor_pose_pending_update = false
	editor_pose_drag_apply_count += 1
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if editor_pose_drag_original_positions.is_empty() or nodes.is_empty():
		return
	var mouse_topology := _board_position_to_topology(editor_pose_pending_local_position)
	var current_vec := mouse_topology - editor_pose_pivot
	if current_vec.length() < 0.0001:
		return
	var delta_angle := current_vec.angle() - editor_pose_drag_start_angle
	if editor_pose_last_applied_angle != INF and absf(delta_angle - editor_pose_last_applied_angle) < deg_to_rad(0.25):
		return
	editor_pose_last_applied_angle = delta_angle
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("pose.drag.fk")
	for raw_item in editor_pose_drag_original_positions:
		if not (raw_item is Dictionary):
			continue
		var item: Dictionary = raw_item
		var index := int(item.get("index", -1))
		if index < 0 or index >= nodes.size() or not (nodes[index] is Dictionary):
			continue
		var node: Dictionary = nodes[index]
		var original_pos: Vector2 = item.get("pos", _topology_node_position(node))
		var original_axis: Vector2 = item.get("axis", _topology_endpoint_axis_for_node(index, nodes, []))
		node["pos"] = _clamp_topology_position(editor_pose_pivot + (original_pos - editor_pose_pivot).rotated(delta_angle))
		if original_axis.length() > 0.001:
			node["axis"] = original_axis.normalized().rotated(delta_angle).normalized()
		if bool(item.get("is_root", false)):
			node["local_angle"] = wrapf(float(item.get("local_angle", 0.0)) + delta_angle, -PI, PI)
		nodes[index] = node
	topology["nodes"] = nodes
	unit_bp["custom_topology"] = topology
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("pose.drag.fk")
	ai_team_manual_lock[_editor_player()] = true
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("pose.drag.visual_diff")
	_refresh_editor_visual_views_fast_drag(editor_pose_downstream_nodes, false, true)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("pose.drag.visual_diff")


func _finish_editor_pose_drag(unit_bp: Dictionary) -> void:
	if not editor_pose_dragging:
		return
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("pose_commit")
	_apply_editor_pose_drag_pending(unit_bp)
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("pose.commit.entry_pose")
	_store_entry_pose_for_nodes(unit_bp, editor_pose_downstream_nodes)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("pose.commit.entry_pose")
	editor_pose_dragging = false
	editor_pose_pending_update = false
	editor_pose_drag_original_positions = []
	editor_pose_original_entry_pose = {}
	if editor_board_hint_label != null:
		editor_board_hint_label.text = "入场姿态已更新：保存单位后，训练和战斗入场都会使用该姿态。" if _ui_is_zh() else "Entry pose updated: save the unit to use this pose in training and battle entry."
	_refresh_editor_visual_views_fast_drag(editor_pose_downstream_nodes, false, true)
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("pose.commit.idle_dirty")
	_schedule_editor_stats_idle_refresh("pose.commit")
	mark_editor_dirty(EDITOR_DIRTY_ACTION_BUTTONS, "pose.commit")
	flush_editor_dirty(600)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("pose.commit.idle_dirty")
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("pose_commit")


func _store_entry_pose_from_topology(unit_bp: Dictionary) -> void:
	unit_bp["entry_pose"] = _entry_pose_from_topology(unit_bp)


func _topology_edge_exists(edges: Array, a: int, b: int) -> bool:
	for edge in edges:
		var edge_a := _topology_edge_node_a(edge)
		var edge_b := _topology_edge_node_b(edge)
		if (edge_a == a and edge_b == b) or (edge_a == b and edge_b == a):
			return true
	return false


func _topology_canonical_socket_edges(role_key: String, unit_bp: Dictionary, nodes: Array, old_edges: Array) -> Array:
	var new_edges: Array = []
	for raw_edge in old_edges:
		var a := _topology_edge_node_a(raw_edge)
		var b := _topology_edge_node_b(raw_edge)
		if a < 0 or b < 0 or a >= nodes.size() or b >= nodes.size() or a == b:
			continue
		if raw_edge is Dictionary and _topology_edge_socket_for_node(raw_edge, a) != "" and _topology_edge_socket_for_node(raw_edge, b) != "":
			var raw_a_socket := _topology_canonical_socket_id(_topology_edge_socket_for_node(raw_edge, a))
			var raw_b_socket := _topology_canonical_socket_id(_topology_edge_socket_for_node(raw_edge, b))
			new_edges.append(_topology_make_socket_edge(a, raw_a_socket, b, raw_b_socket))
			continue
		# Legacy array-only edges are preserved as invalid data. They must be
		# rebuilt by the player instead of being guessed into a free socket pair.
		new_edges.append(raw_edge)
	return new_edges


func _topology_node_edge_count(edges: Array, node_index: int) -> int:
	var count := 0
	for edge in edges:
		if _topology_edge_has_node(edge, node_index):
			count += 1
	return count


func _distance_to_segment(point: Vector2, a: Vector2, b: Vector2) -> float:
	var ab := b - a
	var length_sq := ab.length_squared()
	if length_sq <= 0.0001:
		return point.distance_to(a)
	var t := clampf((point - a).dot(ab) / length_sq, 0.0, 1.0)
	return point.distance_to(a + ab * t)


func _nearest_topology_edge_hit(unit_bp: Dictionary, local_position: Vector2, max_distance: float = 18.0) -> Dictionary:
	if not unit_bp.has("custom_topology"):
		return {}
	var role_key: String = ROLE_ORDER[editor_role_index]
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	var best := {}
	var best_distance := max_distance
	for edge_index in range(edges.size()):
		var raw_edge = edges[edge_index]
		var a := _topology_edge_node_a(raw_edge)
		var b := _topology_edge_node_b(raw_edge)
		if a < 0 or b < 0 or a >= nodes.size() or b >= nodes.size():
			continue
		var points := _topology_edge_socket_board_points(role_key, unit_bp, nodes, edges, a, b)
		var pa: Vector2 = points.get("a", _topology_position_to_board_local(_topology_node_position(nodes[a])))
		var pb: Vector2 = points.get("b", _topology_position_to_board_local(_topology_node_position(nodes[b])))
		var distance := _distance_to_segment(local_position, pa, pb)
		if distance < best_distance:
			best_distance = distance
			best = {
				"edge_index": edge_index,
				"a": a,
				"b": b,
				"distance": distance,
			}
	return best


func _nearest_connected_neighbor_on_edge(unit_bp: Dictionary, joint_index: int, local_position: Vector2, max_distance: float = 22.0) -> int:
	if not unit_bp.has("custom_topology"):
		return -1
	var role_key: String = ROLE_ORDER[editor_role_index]
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var edges: Array = topology.get("edges", [])
	if joint_index < 0 or joint_index >= nodes.size():
		return -1
	var best_neighbor := -1
	var best_distance := max_distance
	for raw_edge in edges:
		var a := _topology_edge_node_a(raw_edge)
		var b := _topology_edge_node_b(raw_edge)
		if a != joint_index and b != joint_index:
			continue
		var points := _topology_edge_socket_board_points(role_key, unit_bp, nodes, edges, a, b)
		var pa: Vector2 = points.get("a", _topology_position_to_board_local(_topology_node_position(nodes[a])))
		var pb: Vector2 = points.get("b", _topology_position_to_board_local(_topology_node_position(nodes[b])))
		var distance := _distance_to_segment(local_position, pa, pb)
		if distance < best_distance:
			best_distance = distance
			best_neighbor = b if a == joint_index else a
	return best_neighbor


func _unlink_topology_edge_at_index(unit_bp: Dictionary, edge_index: int) -> bool:
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("unlink_node")
	if not unit_bp.has("custom_topology"):
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("unlink_node")
		return false
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	var old_edges: Array = Array(topology.get("edges", [])).duplicate(true)
	if edge_index < 0 or edge_index >= old_edges.size():
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("unlink_node")
		return false
	var raw_edge = old_edges[edge_index]
	var a := _topology_edge_node_a(raw_edge)
	var b := _topology_edge_node_b(raw_edge)
	_record_editor_undo_state("解绑连接边" if _ui_is_zh() else "unlink edge")
	old_edges.remove_at(edge_index)
	topology["edges"] = old_edges
	unit_bp["custom_topology"] = topology
	var focus := -1
	if a >= 0 and a < nodes.size() and _topology_node_slot(nodes[a]) == "joint":
		focus = a
	elif b >= 0 and b < nodes.size() and _topology_node_slot(nodes[b]) == "joint":
		focus = b
	elif a >= 0 and a < nodes.size():
		focus = a
	editor_topology_node_index = focus
	editor_selected_topology_nodes = [focus] if focus >= 0 else []
	editor_dragging_node_index = -1
	editor_dragging_selected_nodes = false
	editor_dragging_whole_unit = false
	editor_selecting_topology_box = false
	editor_snap_timer = 0.18
	editor_snap_part = "link"
	if editor_board_hint_label != null:
		editor_board_hint_label.text = "已解绑一条接口连接。" if _ui_is_zh() else "Unlinked one socket edge."
	_play_sfx_wave("clack", 420.0, 0.045, -17.5)
	ai_team_manual_lock[_editor_player()] = true
	_clear_cached_board_socket_candidate()
	_refresh_editor_visual_views_fast_drag([a, b, focus])
	_schedule_editor_stats_idle_refresh("board.unlink_edge")
	mark_editor_dirty(EDITOR_DIRTY_ACTION_BUTTONS, "board.unlink_edge")
	flush_editor_dirty(600)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("unlink_node")
	return true


func _unlink_joint_edges(unit_bp: Dictionary, joint_index: int, preferred_neighbor: int = -1) -> bool:
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("unlink_node")
	if not unit_bp.has("custom_topology"):
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("unlink_node")
		return false
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if joint_index < 0 or joint_index >= nodes.size():
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("unlink_node")
		return false
	var old_edges: Array = Array(topology.get("edges", [])).duplicate(true)
	var remove_indices: Array = []
	for edge_index in range(old_edges.size()):
		var raw_edge = old_edges[edge_index]
		var a := _topology_edge_node_a(raw_edge)
		var b := _topology_edge_node_b(raw_edge)
		if a != joint_index and b != joint_index:
			continue
		var neighbor := b if a == joint_index else a
		if preferred_neighbor >= 0 and neighbor != preferred_neighbor:
			continue
		remove_indices.append(edge_index)
	if remove_indices.is_empty():
		if editor_board_hint_label != null:
			editor_board_hint_label.text = "这个构件当前没有可解绑的连接。" if _ui_is_zh() else "This component has no link to unlink."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("unlink_node")
		return false
	_record_editor_undo_state("解绑接口" if _ui_is_zh() else "unlink socket")
	var changed_nodes: Array = [joint_index]
	for raw_remove_index in remove_indices:
		var edge_for_change = old_edges[int(raw_remove_index)]
		var edge_a := _topology_edge_node_a(edge_for_change)
		var edge_b := _topology_edge_node_b(edge_for_change)
		if edge_a == joint_index and not changed_nodes.has(edge_b):
			changed_nodes.append(edge_b)
		elif edge_b == joint_index and not changed_nodes.has(edge_a):
			changed_nodes.append(edge_a)
	var removed_count := 0
	for i in range(remove_indices.size() - 1, -1, -1):
		old_edges.remove_at(int(remove_indices[i]))
		removed_count += 1
	topology["edges"] = old_edges
	unit_bp["custom_topology"] = topology
	editor_topology_node_index = joint_index
	editor_selected_topology_nodes = [joint_index]
	editor_dragging_node_index = -1
	editor_dragging_selected_nodes = false
	editor_dragging_whole_unit = false
	editor_selecting_topology_box = false
	editor_snap_timer = 0.18
	editor_snap_part = "link"
	if editor_board_hint_label != null:
		editor_board_hint_label.text = "已解绑构件的 %d 条接口连接。" % removed_count if _ui_is_zh() else "Unlinked %d component socket connection(s)." % removed_count
	_play_sfx_wave("clack", 420.0, 0.045, -17.5)
	ai_team_manual_lock[_editor_player()] = true
	_clear_cached_board_socket_candidate()
	_refresh_editor_visual_views_fast_drag(changed_nodes)
	_schedule_editor_stats_idle_refresh("board.unlink_joint")
	mark_editor_dirty(EDITOR_DIRTY_ACTION_BUTTONS, "board.unlink_joint")
	flush_editor_dirty(600)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("unlink_node")
	return true


func _try_magnetic_link_for_node(unit_bp: Dictionary, node_index: int, show_material_warning: bool = true) -> bool:
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("magnetic_link")
	if not unit_bp.has("custom_topology"):
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("magnetic_link")
		return false
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	if node_index < 0 or node_index >= nodes.size():
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("magnetic_link")
		return false
	var edges: Array = topology.get("edges", [])
	if _topology_node_edge_count(edges, node_index) > 0:
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("magnetic_link")
		return false
	var role_key: String = ROLE_ORDER[editor_role_index]
	var candidate := _consume_cached_board_socket_candidate(node_index)
	if candidate.is_empty():
		candidate = _topology_socket_candidate(role_key, unit_bp, nodes, edges, node_index, true)
	if candidate.is_empty():
		if show_material_warning:
			var material_block := _topology_material_blocked_candidate(role_key, unit_bp, nodes, edges, node_index)
			if not material_block.is_empty():
				_show_editor_material_link_warning([node_index, int(material_block.get("target", -1))], String(material_block.get("reason", "")))
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("magnetic_link")
		return false
	var best_index := int(candidate.get("target", -1))
	if best_index < 0:
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("magnetic_link")
		return false
	var own_socket_info: Dictionary = candidate.get("socket_a", {})
	var target_socket_info: Dictionary = candidate.get("socket_b", {})
	var own_socket := String(own_socket_info.get("id", ""))
	var target_socket := String(target_socket_info.get("id", ""))
	if target_socket == "" or own_socket == "":
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("magnetic_link")
		return false
	var append_error := _topology_socket_edge_error_for_sockets(role_key, unit_bp, nodes, edges, node_index, own_socket, best_index, target_socket)
	if append_error != "":
		if editor_board_hint_label != null:
			editor_board_hint_label.text = "警报：该关节槽已占用，请右键解绑后再连接。" if _ui_is_zh() else "ALARM: socket occupied; right-click unlink before reconnecting."
		_play_sfx_wave("alarm", 170.0, 0.12, -13.0)
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("magnetic_link")
		return false
	_record_editor_undo_state("连接节点" if _ui_is_zh() else "link nodes")
	var connect_result := _topology_try_connect_sockets(role_key, unit_bp, nodes, edges, node_index, own_socket, best_index, target_socket)
	if not bool(connect_result.get("ok", false)):
		if editor_board_hint_label != null:
			editor_board_hint_label.text = "警报：该关节槽已占用，请右键解绑后再连接。" if _ui_is_zh() else "ALARM: socket occupied; right-click unlink before reconnecting."
		_play_sfx_wave("alarm", 170.0, 0.12, -13.0)
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("magnetic_link")
		return false
	topology["edges"] = edges
	var snapped_node: Dictionary = nodes[node_index]
	var target_pos: Vector2 = target_socket_info.get("pos", _topology_node_position(nodes[best_index]))
	snapped_node = _topology_apply_socket_alignment(role_key, unit_bp, nodes, edges, node_index, own_socket, target_pos, _topology_node_position(snapped_node))
	nodes[node_index] = snapped_node
	topology["nodes"] = nodes
	topology["edges"] = edges
	unit_bp["custom_topology"] = topology
	editor_topology_node_index = node_index
	editor_snap_timer = 0.22
	editor_snap_part = "link"
	if editor_board_hint_label != null:
		editor_board_hint_label.text = "咔哒：节点 %d 的接口已一对一连接节点 %d。" % [node_index + 1, best_index + 1] if _ui_is_zh() else "Click: node %d socket linked one-to-one with node %d." % [node_index + 1, best_index + 1]
	_play_sfx_wave("clack", 720.0, 0.055, -17.0)
	ai_team_manual_lock[_editor_player()] = true
	_clear_cached_board_socket_candidate()
	_refresh_editor_visual_views_fast_drag([node_index, best_index])
	_schedule_editor_stats_idle_refresh("board.magnetic_link")
	mark_editor_dirty(EDITOR_DIRTY_ACTION_BUTTONS, "board.magnetic_link")
	flush_editor_dirty(600)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("magnetic_link")
	return true


func _handle_barrier_board_click(mouse_event: InputEventMouseButton, unit_bp: Dictionary) -> void:
	var player_id := _editor_player()
	var cell_index := _barrier_board_cell_index(mouse_event.position)
	if cell_index < 0:
		return
	editor_selected_barrier_cell = cell_index
	_record_editor_undo_state("编辑结界格" if _ui_is_zh() else "edit barrier cell")
	unit_bp["blank_canvas"] = false
	var tiles: Array = Array(unit_bp.get("barrier_tiles", []))
	if mouse_event.button_index == MOUSE_BUTTON_RIGHT:
		for i in range(tiles.size() - 1, -1, -1):
			var tile: Dictionary = tiles[i]
			if int(tile.get("index", -1)) == cell_index:
				tiles.remove_at(i)
				break
		unit_bp["barrier_tiles"] = tiles
		editor_selected_barrier_cell = -1
		_trigger_editor_snap("barrier", "removed tile %d" % cell_index)
		_mark_editor_board_model_dirty("barrier.remove_tile")
		return
	var stats := _compute_unit_stats(player_id, "barrier", int(editor_unit_indices["barrier"]))
	var slot_cap := maxi(1, int(stats.get("material_slots", 4)))
	for tile in tiles:
		if tile is Dictionary and int(tile.get("index", -1)) == cell_index:
			tile["muscle"] = int(unit_bp.get("muscle", 0))
			unit_bp["barrier_tiles"] = tiles
			_trigger_editor_snap("barrier", "replaced tile %d" % cell_index)
			_mark_editor_board_model_dirty("barrier.replace_tile")
			return
	if tiles.size() >= slot_cap:
		editor_board_hint_label.text = "警报：以太可固定材料已满 %d/%d。" % [tiles.size(), slot_cap] if _ui_is_zh() else "ALARM: ether material slots full %d/%d." % [tiles.size(), slot_cap]
		return
	tiles.append({"index": cell_index, "muscle": int(unit_bp.get("muscle", 0))})
	unit_bp["barrier_tiles"] = tiles
	_trigger_editor_snap("barrier", "barrier tile %d" % cell_index)
	_mark_editor_board_model_dirty("barrier.add_tile")


func _barrier_board_cell_index(local_pos: Vector2) -> int:
	var rect := _barrier_editor_rect_for_size(assembly_board_view.size if assembly_board_view != null else Vector2(656.0, 482.0))
	if not rect.has_point(local_pos):
		return -1
	var cell_size := Vector2(rect.size.x / float(BARRIER_MAP_COLUMNS), rect.size.y / float(BARRIER_MAP_ROWS))
	var rel := local_pos - rect.position
	var x := int(floor(rel.x / maxf(1.0, cell_size.x)))
	var y := int(floor(rel.y / maxf(1.0, cell_size.y)))
	if x < 0 or x >= BARRIER_MAP_COLUMNS or y < 0 or y >= BARRIER_MAP_ROWS:
		return -1
	return y * BARRIER_MAP_COLUMNS + x


func _barrier_editor_rect_for_size(board_size: Vector2) -> Rect2:
	var margin := Vector2(8.0, 44.0)
	var available := Vector2(maxf(64.0, board_size.x - margin.x * 2.0), maxf(64.0, board_size.y - margin.y * 2.0))
	var aspect := float(BARRIER_MAP_COLUMNS) / maxf(1.0, float(BARRIER_MAP_ROWS))
	var rect_size := available
	if rect_size.x / maxf(1.0, rect_size.y) > aspect:
		rect_size.x = rect_size.y * aspect
	else:
		rect_size.y = rect_size.x / aspect
	return Rect2((board_size - rect_size) * 0.5, rect_size)


func _cycle_body_part_component(slot_key: String, direction: int) -> void:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	if not _role_uses_body_board(role_key):
		editor_summary_label.text = "部件画布适用于英雄、傀儡和结界自由拓扑。" if _ui_is_zh() else "The assembly board is available for hero, puppet, and barrier free topology."
		return
	var unit_bp: Dictionary = _editor_current_blueprint()
	if _is_body_group_slot(slot_key):
		_ensure_custom_topology(unit_bp)
		if _is_topology_part_slot(slot_key):
			var catalog_for_pending: Array = _catalog_for(role_key, slot_key)
			var next_pending_index := _wrapped_index(int(unit_bp.get(slot_key, 0)) + direction, catalog_for_pending.size())
			_set_pending_canvas_part(unit_bp, slot_key, next_pending_index)
			editor_board_hint_label.text = "已选择：%s。可直接拖卡片进画布，也可点击画布放置/替换。" % _pending_canvas_part_name(role_key)
			_play_sfx_wave("clack", 640.0, 0.04, -18.0)
			ai_team_manual_lock[player_id] = true
			_update_editor_ui()
			return
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		var nodes: Array = topology.get("nodes", [])
		if nodes.is_empty():
			return
		editor_topology_node_index = clampi(editor_topology_node_index, 0, nodes.size() - 1)
		var node: Dictionary = nodes[editor_topology_node_index]
		var catalog_for_node: Array = _catalog_for(role_key, slot_key)
		var next_node_index := _wrapped_index(int(node.get(slot_key, unit_bp.get(slot_key, 0))) + direction, catalog_for_node.size())
		node = _set_topology_node_slot(node, slot_key, next_node_index)
		nodes[editor_topology_node_index] = node
		topology["nodes"] = nodes
		unit_bp["custom_topology"] = topology
		unit_bp["blank_canvas"] = false
		_trigger_editor_snap("node", String(catalog_for_node[next_node_index].get("name", "")))
		ai_team_manual_lock[player_id] = true
		_mark_editor_board_interaction_dirty("shop.replace_node_part")
		return
	var catalog: Array = _catalog_for(role_key, slot_key)
	unit_bp[slot_key] = _wrapped_index(int(unit_bp.get(slot_key, 0)) + direction, catalog.size())
	unit_bp["blank_canvas"] = false
	_trigger_editor_snap(slot_key, String(catalog[int(unit_bp[slot_key])].get("name", "")))
	ai_team_manual_lock[player_id] = true
	_mark_editor_board_interaction_dirty("shop.install_part")


func _prepare_blueprint_for_role_conversion(unit_bp: Dictionary, role_key: String) -> Dictionary:
	var converted := unit_bp.duplicate(true)
	converted["role"] = role_key
	converted["archetype"] = String(converted.get("archetype", "custom"))
	if not converted.has("custom_topology"):
		converted["custom_topology"] = _blank_free_canvas_topology()
	if not converted.has("slot_payloads"):
		converted["slot_payloads"] = []
	if role_key == "barrier":
		if not converted.has("barrier_tiles"):
			converted["barrier_tiles"] = []
	else:
		converted.erase("barrier_tiles")
	return converted


func _change_current_unit_role(role_key: String) -> void:
	if not ROLE_ORDER.has(role_key):
		return
	var player_id := _editor_player()
	var old_role: String = ROLE_ORDER[clampi(editor_role_index, 0, ROLE_ORDER.size() - 1)]
	if _editor_is_blank_work_canvas():
		var working_source := editor_working_blueprint.duplicate(true) if not editor_working_blueprint.is_empty() else _make_editor_blank_blueprint(role_key)
		editor_role_index = ROLE_ORDER.find(role_key)
		editor_working_role_key = role_key
		editor_working_blueprint = _prepare_blueprint_for_role_conversion(working_source, role_key)
		editor_summary_label.text = "当前空白画布身份已设为：%s。" % _role_name(role_key) if _ui_is_zh() else "Current blank canvas role set to: %s." % _role_name(role_key)
		_update_editor_ui()
		return
	if old_role == role_key:
		editor_summary_label.text = "当前单位身份已经是：%s。" % _role_name(role_key) if _ui_is_zh() else "Current unit already has role: %s." % _role_name(role_key)
		_update_editor_ui()
		return
	if not blueprints.has(player_id):
		blueprints[player_id] = _blank_player_roster()
	var old_roster: Array = Array(blueprints[player_id].get(old_role, []))
	var old_index := clampi(int(editor_unit_indices.get(old_role, 0)), 0, maxi(0, old_roster.size() - 1))
	if old_roster.is_empty():
		editor_role_index = ROLE_ORDER.find(role_key)
		_reset_editor_working_canvas(role_key)
		_update_editor_ui()
		return
	var moved := _prepare_blueprint_for_role_conversion(Dictionary(old_roster[old_index]), role_key)
	old_roster.remove_at(old_index)
	blueprints[player_id][old_role] = old_roster
	_update_sortie_after_delete(player_id, old_role, old_index)
	if not blueprints[player_id].has(role_key):
		blueprints[player_id][role_key] = []
	var new_roster: Array = Array(blueprints[player_id].get(role_key, []))
	var new_index := new_roster.size()
	new_roster.append(moved)
	blueprints[player_id][role_key] = new_roster
	editor_role_index = ROLE_ORDER.find(role_key)
	editor_unit_indices[old_role] = clampi(old_index, 0, maxi(0, old_roster.size() - 1))
	editor_unit_indices[role_key] = new_index
	active_roster_indices[player_id][old_role] = int(editor_unit_indices[old_role])
	active_roster_indices[player_id][role_key] = new_index
	initial_role[player_id] = role_key if String(initial_role.get(player_id, "")) == old_role else String(initial_role.get(player_id, role_key))
	sortie_loadouts[player_id] = []
	initial_sortie_slot[player_id] = 0
	editor_canvas_mode = "roster_unit"
	ai_team_manual_lock[player_id] = true
	editor_summary_label.text = "单位身份已从 %s 改为 %s；赛前出战选择已清空以避免引用旧槽位。" % [_role_name(old_role), _role_name(role_key)] if _ui_is_zh() else "Unit role changed from %s to %s; sortie selection was cleared to avoid stale slots." % [_role_name(old_role), _role_name(role_key)]
	_update_editor_ui()


func _select_editor_role(role_key: String) -> void:
	_change_current_unit_role(role_key)


