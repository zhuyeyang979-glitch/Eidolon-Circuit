func _save_editor_working_canvas_to_roster() -> void:
	if not _editor_is_blank_work_canvas():
		editor_summary_label.text = "当前已经在编辑队伍槽位，无需另存。" if _ui_is_zh() else "Already editing a roster slot."
		return
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	if _roster_unit_total(player_id) >= _current_roster_cap():
		editor_summary_label.text = "队伍已满（%s）：先删除一个单位再保存当前画布。" % _match_format_name() if _ui_is_zh() else "Roster full (%s): delete a unit before saving this canvas." % _match_format_name()
		return
	var roster: Array = blueprints[player_id][role_key]
	var target_index := roster.size()
	var saved := _editor_current_blueprint().duplicate(true)
	saved["role"] = role_key
	if String(saved.get("name", "")).begins_with("空白") or String(saved.get("name", "")).begins_with("Blank"):
		saved["name"] = "P%d %s %d" % [player_id, _role_name(role_key), target_index + 1]
	roster.append(saved)
	blueprints[player_id][role_key] = roster
	editor_canvas_mode = "roster_unit"
	active_roster_indices[player_id][role_key] = target_index
	editor_unit_indices[role_key] = target_index
	editor_summary_label.text = "已将空白工作画布保存到当前队伍槽位 %s #%d。" % [_role_name(role_key), target_index + 1] if _ui_is_zh() else "Saved blank work canvas into current roster slot %s #%d." % [_role_name(role_key), target_index + 1]
	_update_editor_ui()


func _append_editor_current_unit_to_team() -> void:
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var source_bp := _unit_blueprint_for_library(role_key, _editor_current_blueprint())
	var legal_note := _training_blueprint_illegal_note(player_id, role_key, source_bp)
	if legal_note != "":
		editor_summary_label.text = "当前画布还不能加入队伍：%s" % _localized_system_text(legal_note) if _ui_is_zh() else "Current canvas cannot join the roster yet: %s" % legal_note
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return
	if _roster_unit_total(player_id) >= _current_roster_cap():
		editor_summary_label.text = "队伍槽已满：请切到队伍编成删除或清空槽位后再加入。" if _ui_is_zh() else "Team slots are full: remove or clear a slot in Team Compose before adding."
		_play_sfx_wave("alarm", 170.0, 0.08, -16.0)
		return
	var roster: Array = Array(blueprints[player_id].get(role_key, [])).duplicate(true)
	var saved := source_bp
	saved["blank_canvas"] = false
	roster.append(saved)
	blueprints[player_id][role_key] = roster
	var target_index := roster.size() - 1
	active_roster_indices[player_id][role_key] = target_index
	editor_unit_indices[role_key] = target_index
	ai_team_manual_lock[player_id] = true
	editor_summary_label.text = "已把当前单位加入 P%d %s 队伍槽：%s #%d。当前画布仍是可继续编辑的临时副本。" % [player_id, _match_format_name(), _role_name(role_key), target_index + 1] if _ui_is_zh() else "Added current unit to P%d %s roster: %s #%d. The canvas remains an editable temporary copy." % [player_id, _match_format_name(), _role_name(role_key), target_index + 1]
