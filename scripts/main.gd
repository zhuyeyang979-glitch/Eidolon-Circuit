	return unit_bp.duplicate(true)


func _entry_pose_from_topology(unit_bp: Dictionary) -> Dictionary:
	var pose := {}
	if not unit_bp.has("custom_topology"):
		return pose
	var role_key := String(unit_bp.get("role", ROLE_ORDER[editor_role_index]))
	_topology_update_local_pose_fields(role_key, unit_bp)
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", []))
	for i in range(nodes.size()):
		if not (nodes[i] is Dictionary):
			continue
		var node: Dictionary = nodes[i]
		if not _topology_node_is_component(node):
			continue
		pose[str(i)] = {
			"axis": _topology_node_axis(node),
			"rotation": _topology_node_axis(node).angle(),
			"extension": float(node.get("entry_extension", node.get("extension", 0.0))),
			"local_angle": float(node.get("local_angle", 0.0)),
			"local_extension": float(node.get("local_extension", 0.0)),
			"parent_node": int(node.get("parent_node", -1)),
			"parent_socket": String(node.get("parent_socket", "")),
			"root_socket": String(node.get("root_socket", "")),
		}
	return pose


func _entry_pose_for_topology_nodes(unit_bp: Dictionary, target_nodes: Array) -> Dictionary:
	var pose := {}
	if not unit_bp.has("custom_topology"):
		return pose
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", []))
	for raw_index in target_nodes:
		var i := int(raw_index)
		if i < 0 or i >= nodes.size() or not (nodes[i] is Dictionary):
			continue
		var node: Dictionary = nodes[i]
		if not _topology_node_is_component(node):
			continue
		pose[str(i)] = {
			"axis": _topology_node_axis(node),
			"rotation": _topology_node_axis(node).angle(),
			"extension": float(node.get("entry_extension", node.get("extension", 0.0))),
			"local_angle": float(node.get("local_angle", 0.0)),
			"local_extension": float(node.get("local_extension", 0.0)),
			"parent_node": int(node.get("parent_node", -1)),
			"parent_socket": String(node.get("parent_socket", "")),
			"root_socket": String(node.get("root_socket", "")),
		}
	return pose


func _store_entry_pose_for_nodes(unit_bp: Dictionary, target_nodes: Array) -> void:
	var pose: Dictionary = Dictionary(unit_bp.get("entry_pose", {})).duplicate(true)
	var partial := _entry_pose_for_topology_nodes(unit_bp, target_nodes)
	for key in partial.keys():
		pose[key] = partial[key]
	unit_bp["entry_pose"] = pose


func _apply_entry_pose_to_blueprint(unit_bp: Dictionary) -> void:
	if not unit_bp.has("custom_topology"):
		return
	var pose: Dictionary = Dictionary(unit_bp.get("entry_pose", {}))
	if pose.is_empty():
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", [])).duplicate(true)
	for key in pose.keys():
		var node_index := int(String(key))
		if node_index < 0 or node_index >= nodes.size() or not (nodes[node_index] is Dictionary):
			continue
		var info: Dictionary = Dictionary(pose[key])
		var node: Dictionary = Dictionary(nodes[node_index]).duplicate(true)
		var axis := Vector2.RIGHT
		if info.get("axis", null) is Vector2:
			axis = info.get("axis")
		elif info.has("rotation"):
			axis = Vector2.RIGHT.rotated(float(info.get("rotation", 0.0)))
		if axis.length() > 0.0001:
			node["axis"] = axis.normalized()
			node["rotation"] = axis.angle()
		if info.has("extension"):
			node["entry_extension"] = float(info.get("extension", 0.0))
		if info.has("local_angle"):
			node["local_angle"] = float(info.get("local_angle", 0.0))
		if info.has("local_extension"):
			node["local_extension"] = float(info.get("local_extension", 0.0))
		if info.has("parent_node"):
			node["parent_node"] = int(info.get("parent_node", -1))
		if info.has("parent_socket"):
			node["parent_socket"] = String(info.get("parent_socket", ""))
		if info.has("root_socket"):
			node["root_socket"] = String(info.get("root_socket", ""))
		nodes[node_index] = node
	topology["nodes"] = nodes
	unit_bp["custom_topology"] = topology
	_topology_apply_local_fk(String(unit_bp.get("role", ROLE_ORDER[editor_role_index])), unit_bp)


func _ordered_module_bindings_by_software_slot(unit_bp: Dictionary) -> Array:
	var remaining: Array = Array(unit_bp.get("module_bindings", [])).duplicate(true)
	var ordered: Array = []
	while not remaining.is_empty():
		var best_index := 0
		var best_slot := 999999
		for i in range(remaining.size()):
			if not (remaining[i] is Dictionary):
				continue
			var slot := int(Dictionary(remaining[i]).get("software_slot_index", 999999))
			if slot < best_slot:
				best_slot = slot
				best_index = i
		ordered.append(remaining[best_index])
		remaining.remove_at(best_index)
	return ordered


func _apply_module_recovery_entry_pose_defaults(role_key: String, unit_bp: Dictionary, normalize_gun_terminals: bool = false) -> void:
	if not unit_bp.has("custom_topology"):
		return
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = Array(topology.get("nodes", [])).duplicate(true)
	var edges: Array = Array(topology.get("edges", [])).duplicate(true)
	if nodes.is_empty():
		return
	var assigned := {}
	var changed := false
	for raw_binding in _ordered_module_bindings_by_software_slot(unit_bp):
		if not (raw_binding is Dictionary):
			continue
		var binding: Dictionary = raw_binding
		var module_index := int(binding.get("module_index", -1))
		if module_index < 0:
			continue
		var module_part := _selected_component(role_key, "module", module_index)
		var module_profile := String(module_part.get("module_action_profile", "")).to_lower()
		var target_nodes: Array = Array(binding.get("target_nodes", []))
		var root_index := int(binding.get("root_index", -1))
		var side_mount_node := _module_binding_side_mount_node_index(role_key, unit_bp, nodes, root_index, target_nodes)
		if side_mount_node >= 0 and side_mount_node < nodes.size() and not assigned.has(side_mount_node) and nodes[side_mount_node] is Dictionary:
			var side := _normalize_side_mount_action_side(binding.get("side_mount_action_side", _module_binding_default_side_mount_action_side(role_key, unit_bp, nodes, root_index, target_nodes)))
			var side_node: Dictionary = Dictionary(nodes[side_mount_node]).duplicate(true)
			side_node["local_angle"] = _side_mount_action_angle_offset(side)
			side_node["local_extension"] = float(side_node.get("local_extension", 0.0))
			side_node["entry_pose_source"] = "side_mount_action_%s" % side
			side_node["side_mount_action_side"] = side
			side_node["side_mount_action_angle_offset"] = _side_mount_action_angle_offset(side)
			nodes[side_mount_node] = side_node
			assigned[side_mount_node] = true
			changed = true
			continue
		if module_profile != "two_link_forward_snap":
			if not normalize_gun_terminals:
				continue
			var target_kind := String(module_part.get("module_target_kind", "")).to_lower()
			if target_kind != "gun_terminal" and not ActionProfileRegistry.PROJECTILE_PROFILES.has(module_profile):
				continue
			if target_nodes.is_empty():
				continue
			var gun_index := int(target_nodes[target_nodes.size() - 1])
			if gun_index < 0 or gun_index >= nodes.size() or assigned.has(gun_index):
				continue
			if not (nodes[gun_index] is Dictionary):
				continue
			var temp_bp_gun := unit_bp.duplicate(true)
			var temp_topology_gun: Dictionary = topology.duplicate(true)
			temp_topology_gun["nodes"] = nodes
			temp_topology_gun["edges"] = edges
			temp_bp_gun["custom_topology"] = temp_topology_gun
			var parent_axis_gun := _topology_parent_axis_for_node(role_key, temp_bp_gun, nodes, edges, gun_index)
			if parent_axis_gun.length() < 0.001:
				parent_axis_gun = Vector2.RIGHT
			var gun_node: Dictionary = Dictionary(nodes[gun_index]).duplicate(true)
			gun_node["local_angle"] = wrapf(Vector2.RIGHT.angle() - parent_axis_gun.angle(), -PI, PI)
			gun_node["local_extension"] = float(gun_node.get("local_extension", 0.0))
			gun_node["entry_pose_source"] = "gun_activation_forward"
			nodes[gun_index] = gun_node
			assigned[gun_index] = true
			changed = true
			continue
		if target_nodes.size() != 2:
			continue
		var first_index := int(target_nodes[0])
		var second_index := int(target_nodes[1])
		if first_index < 0 or first_index >= nodes.size() or second_index < 0 or second_index >= nodes.size():
			continue
		if assigned.has(first_index) or assigned.has(second_index):
			continue
		if not (nodes[first_index] is Dictionary) or not (nodes[second_index] is Dictionary):
			continue
		var temp_bp := unit_bp.duplicate(true)
		var temp_topology: Dictionary = topology.duplicate(true)
		temp_topology["nodes"] = nodes
		temp_topology["edges"] = edges
		temp_bp["custom_topology"] = temp_topology
		var parent_axis := _topology_parent_axis_for_node(role_key, temp_bp, nodes, edges, first_index)
		if parent_axis.length() < 0.001:
			parent_axis = Vector2.RIGHT
		var first_node: Dictionary = Dictionary(nodes[first_index]).duplicate(true)
		var second_node: Dictionary = Dictionary(nodes[second_index]).duplicate(true)
		first_node["local_angle"] = wrapf(Vector2.LEFT.angle() - parent_axis.angle(), -PI, PI)
		first_node["local_extension"] = float(first_node.get("local_extension", 0.0))
		second_node["local_angle"] = wrapf(Vector2.RIGHT.angle() - Vector2.LEFT.angle(), -PI, PI)
		second_node["local_extension"] = float(second_node.get("local_extension", 0.0))
		first_node["entry_pose_source"] = "two_link_forward_snap_recovery"
		second_node["entry_pose_source"] = "two_link_forward_snap_recovery"
		nodes[first_index] = first_node
		nodes[second_index] = second_node
		assigned[first_index] = true
		assigned[second_index] = true
		changed = true
	if not changed:
		return
	topology["nodes"] = nodes
	topology["edges"] = edges
	unit_bp["custom_topology"] = topology
	_topology_apply_local_fk(role_key, unit_bp)


func _unit_blueprint_for_library(role_key: String, unit_bp: Dictionary) -> Dictionary:
	var saved := _canonical_saved_unit_blueprint_for_library(unit_bp)
	saved["role"] = role_key
	saved["schema_version"] = SAVED_UNIT_SCHEMA_VERSION
	saved["save_kind"] = SAVE_KIND_SINGLE_UNIT
	if role_key == "barrier" and saved.has("barrier_tiles"):
		saved["barrier_tiles"] = _barrier_tiles_with_screen_pos_for_save(Array(saved.get("barrier_tiles", [])))
	else:
		saved.erase("puppet_group_blueprints")
	if not saved.has("unit_id") or String(saved.get("unit_id", "")) == "":
		saved["unit_id"] = "%s_%d" % [role_key, int(Time.get_unix_time_from_system() * 1000.0)]
	if not saved.has("unit_name") or String(saved.get("unit_name", "")) == "":
		var fallback_name := String(saved.get("name", ""))
		if fallback_name.strip_edges() == "" or fallback_name.begins_with("空白") or fallback_name.begins_with("Blank"):
			fallback_name = "%s %d" % [_role_name(role_key), int(Time.get_unix_time_from_system())]
		saved["unit_name"] = fallback_name
	saved["name"] = String(saved.get("unit_name", saved.get("name", _role_name(role_key))))
	_stamp_saved_blueprint_part_names(role_key, saved)
	_apply_module_recovery_entry_pose_defaults(role_key, saved)
	saved["entry_pose"] = _entry_pose_from_topology(saved)
	saved["team_color"] = {
		"primary": _team_primary_color(_editor_player()),
		"accent": _team_accent_color(_editor_player()),
	}
	return saved


func _stamp_saved_blueprint_part_names(role_key: String, unit_bp: Dictionary) -> void:
	var topology: Dictionary = Dictionary(unit_bp.get("custom_topology", {}))
	var nodes: Array = Array(topology.get("nodes", []))
	var changed := false
	for i in range(nodes.size()):
		if not (nodes[i] is Dictionary):
			continue
		var node: Dictionary = Dictionary(nodes[i]).duplicate(true)
		var slot_key := _topology_node_slot(node)
		if not _is_topology_part_slot(slot_key):
			continue
		var resolved_index := _topology_node_resolved_part_index(role_key, node, unit_bp)
		var part := _selected_component(role_key, slot_key, resolved_index)
		if not part.is_empty():
			var part_name := String(part.get("name", ""))
			var old_name := String(node.get("name", "")).strip_edges()
			node["part_index"] = resolved_index
			node["part_name"] = part_name
			node["component_name"] = part_name
			if old_name == "" or _component_index_by_exact_name(role_key, slot_key, old_name) >= 0:
				node["name"] = part_name
			node["material_class"] = String(part.get("material_class", node.get("material_class", "")))
			node["catalog_role"] = _catalog_role_for_part(slot_key, part)
			node["part_category"] = _catalog_part_category_for_part(slot_key, part)
			if slot_key == "muscle":
				node["is_torso"] = _component_is_torso(part)
			if node.has("modules") or node.has("module"):
				var normalized_modules := _module_indices_for_topology_node(node, unit_bp)
				if normalized_modules.is_empty():
					node.erase("modules")
					node.erase("module")
				else:
					node["modules"] = normalized_modules
					node["module"] = int(normalized_modules[0])
			nodes[i] = node
			changed = true
	if changed:
		topology["nodes"] = nodes
		unit_bp["custom_topology"] = topology
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	var payload_changed := false
	for i in range(payloads.size()):
		if not (payloads[i] is Dictionary):
			continue
		var payload: Dictionary = Dictionary(payloads[i]).duplicate(true)
		var part := _payload_part_for_payload(role_key, payload)
		if not part.is_empty():
			payload["part_name"] = String(part.get("name", ""))
			payloads[i] = payload
			payload_changed = true
	if payload_changed:
		unit_bp["slot_payloads"] = payloads


