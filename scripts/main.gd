func _catalog_card_data_lines(slot_key: String, part: Dictionary) -> Array:
	var cost := int(part.get("cost", 0))
	var mass := float(part.get("mass", 0.0))
	var energy := 0.0
	var hp := int(part.get("hp", 0))
	var length := float(part.get("length", 0.0))
	var size_tier := _part_size_tier_label(part, slot_key)
	var volume := _volume_rank_label(_part_slot_volume_rank(part, slot_key))
	var gradient_line := _part_gradient_card_line(slot_key, part)
	if _ui_is_zh():
		match slot_key:
			"engine":
				return ["价%d %s 动%.0f" % [cost, _engine_family_label(String(part.get("engine_family", "balanced"))), _engine_momentum_output_for_part(part)], "%s 热%.1f 质%.0f" % [gradient_line, _engine_idle_heat_for_part(part, _engine_momentum_output_for_part(part)), mass]]
			"cooling":
				return ["价%d 散%.1f 池%.0f" % [cost, _cooling_rate_for_part(part), _cooling_heat_capacity_for_part(part)], "%s 质%.0f" % [gradient_line, mass]]
			"booster":
				var thruster := _thruster_with_drive_defaults(part)
				return ["价%d %s 需%.0f" % [cost, _thruster_family_label(String(thruster.get("thruster_family", ""))), _thruster_drive_demand_for_part(thruster)], "%s 移%.0f/B+%.0f" % [gradient_line, _booster_normal_momentum_for_part(thruster), _booster_boost_momentum_for_part(thruster)]]
			"special":
				return ["价%d 无动力消耗" % cost, "%s %s" % [gradient_line, _zh_part_name(String(part.get("kind", "特殊")).to_upper())]]
			"module":
				var model := _module_action_card_model(part)
				return ["价%d %s %s" % [cost, String(model.get("input_short", "X")), String(model.get("weapon_short", ""))], "%s %s" % [gradient_line, String(model.get("joint_short", ""))]]
			"joint":
				return ["价%d 软件式 质%.0f" % [cost, mass], "%s 输出%.0f" % [gradient_line, _joint_fixed_output_momentum(part)]]
			"limb_muscle":
				return ["价%d %s 质%.0f" % [cost, _limb_visual_family_label(part), mass], "%s 长%.2f 刚%.0f" % [gradient_line, length, _part_stiffness(part, slot_key)]]
			"muscle":
				if _part_is_ammo_payload(part):
					var caps: Dictionary = part.get("ammo_capacity", {})
					var total_ammo := _ammo_capacity_total(caps)
					return ["价%d 尺%s 质%.0f" % [cost, String(part.get("ammo_size_tier", _volume_rank_label(_part_slot_volume_rank(part, "muscle")))), mass], "%s 弹数%d" % [gradient_line, total_ammo]]
				if _component_is_torso(part):
					return ["价%d 尺%s 质%.0f" % [cost, size_tier, mass], "%s 接口%d 插槽%d" % [gradient_line, int(part.get("joint_ports", part.get("connection_ends", 0))), _torso_plugin_capacity_for_part(part)]]
				if _terminal_weapon_kind_for_part(part, "muscle") == "ranged":
					return ["价%d 远程 尺%s 质%.0f" % [cost, size_tier, mass], "%s 射%.2f 频%.1f" % [gradient_line, float(part.get("projectile_range", part.get("range", 0.0))), float(part.get("fire_rate", 0.0))]]
				var damage := _damage_name(String(part.get("damage_type", "blunt")))
				return ["价%d 近战 尺%s 质%.0f" % [cost, size_tier, mass], "%s 长%.2f 刚%.0f" % [gradient_line, length, _part_stiffness(part, slot_key)]]
		return ["价%d 尺%s 质%.0f" % [cost, size_tier, mass], "%s 体积%s" % [gradient_line, volume]]
	match slot_key:
		"engine":
			return ["C%d %s PWR%.0f" % [cost, _engine_family_label(String(part.get("engine_family", "balanced"))).to_upper(), _engine_momentum_output_for_part(part)], "%s H%.1f M%.0f" % [gradient_line, _engine_idle_heat_for_part(part, _engine_momentum_output_for_part(part)), mass]]
		"cooling":
			return ["C%d COOL %.1f POOL%.0f" % [cost, _cooling_rate_for_part(part), _cooling_heat_capacity_for_part(part)], "%s M%.0f" % [gradient_line, mass]]
		"booster":
			var thruster_en := _thruster_with_drive_defaults(part)
			return ["C%d %s REQ%.0f" % [cost, _thruster_family_label(String(thruster_en.get("thruster_family", ""))).to_upper(), _thruster_drive_demand_for_part(thruster_en)], "%s MV%.0f/B+%.0f" % [gradient_line, _booster_normal_momentum_for_part(thruster_en), _booster_boost_momentum_for_part(thruster_en)]]
		"special":
			return ["C%d NO POWER" % cost, "%s %s" % [gradient_line, String(part.get("kind", "SPECIAL")).to_upper()]]
		"module":
			var model_en := _module_action_card_model(part)
			return ["C%d %s %s" % [cost, String(model_en.get("input_short", "X")).to_upper(), String(model_en.get("weapon_short", "")).to_upper()], "%s %s" % [gradient_line, String(model_en.get("joint_short", "")).to_upper()]]
		"joint":
			return ["C%d SOFTWARE M%.0f" % [cost, mass], "%s OUT%.0f" % [gradient_line, _joint_fixed_output_momentum(part)]]
		"limb_muscle":
			return ["C%d %s M%.0f" % [cost, _limb_visual_family_label(part).to_upper(), mass], "%s L%.2f ST%.0f" % [gradient_line, length, _part_stiffness(part, slot_key)]]
		"muscle":
			if _part_is_ammo_payload(part):
				var caps: Dictionary = part.get("ammo_capacity", {})
				var total_ammo := _ammo_capacity_total(caps)
				return ["C%d %s M%.0f" % [cost, String(part.get("ammo_size_tier", _volume_rank_label(_part_slot_volume_rank(part, "muscle")))), mass], "%s AMMO %d" % [gradient_line, total_ammo]]
			if _component_is_torso(part):
				return ["C%d %s M%.0f" % [cost, size_tier, mass], "%s P%d INT%d" % [gradient_line, int(part.get("joint_ports", part.get("connection_ends", 0))), _torso_plugin_capacity_for_part(part)]]
			var terminal_label := _terminal_weapon_short_category(part, _ui_is_zh())
			if _terminal_weapon_kind_for_part(part, "muscle") == "ranged":
				return ["C%d %s %s M%.0f" % [cost, terminal_label, size_tier, mass], "%s R%.2f F%.1f" % [gradient_line, float(part.get("projectile_range", part.get("range", 0.0))), float(part.get("fire_rate", 0.0))]]
			return ["C%d %s %s M%.0f" % [cost, terminal_label, size_tier, mass], "%s L%.2f ST%.0f" % [gradient_line, length, _part_stiffness(part, slot_key)]]
	return ["C%d %s M%.0f" % [cost, size_tier, mass], "%s VOL %s" % [gradient_line, volume]]


func _current_editor_catalog_sort_keys() -> Array:
	var role_key: String = ROLE_ORDER[editor_role_index]
	var slot_key: String = BUILD_SLOTS[editor_slot_index]
	return _editor_available_sort_keys(role_key, slot_key)


func _editor_catalog_cache_source_signature(role_key: String, slot_key: String) -> String:
	var pieces: Array = []
	for entry_slot in _editor_catalog_slots_for_active_filter(slot_key):
		var catalog := _catalog_for(role_key, String(entry_slot))
		pieces.append("%s:%d" % [String(entry_slot), catalog.size()])
	return ",".join(pieces)


func _editor_catalog_raw_cache_key(role_key: String, slot_key: String) -> String:
	return "%s|%s|%s|%s|%s|%s|%s" % [role_key, slot_key, editor_part_group_mode, editor_part_filter_mode, editor_weapon_filter_group, editor_weapon_filter_subtype, _editor_catalog_cache_source_signature(role_key, slot_key)]


func _editor_catalog_entries_cache_key(role_key: String, slot_key: String) -> String:
	return "%s|%s|%s|%s|%s|%s|%s|%s|%s" % [role_key, slot_key, editor_part_group_mode, editor_part_filter_mode, editor_weapon_filter_group, editor_weapon_filter_subtype, editor_catalog_sort_key, str(editor_catalog_sort_ascending), _editor_catalog_cache_source_signature(role_key, slot_key)]


func _invalidate_editor_catalog_cache() -> void:
	editor_catalog_raw_cache.clear()
	editor_catalog_entries_cache.clear()
	editor_catalog_sort_keys_cache.clear()
	editor_catalog_card_model_cache.clear()
	editor_catalog_page_model_cache.clear()
	editor_load_entry_stats_cache.clear()


func _editor_catalog_raw_entries(role_key: String, slot_key: String) -> Array:
	var cache_key := _editor_catalog_raw_cache_key(role_key, slot_key)
	if editor_catalog_raw_cache.has(cache_key):
		editor_catalog_cache_hit_count += 1
		return editor_catalog_raw_cache[cache_key]
	editor_catalog_cache_miss_count += 1
	var entries: Array = []
	for entry_slot in _editor_catalog_slots_for_active_filter(slot_key):
		var catalog: Array = _catalog_for(role_key, String(entry_slot))
		for i in range(catalog.size()):
			var part := _selected_component(role_key, String(entry_slot), i)
			if _editor_catalog_part_passes_filter(String(entry_slot), part):
				entries.append({
					"slot": String(entry_slot),
					"index": i,
					"part": part,
					"display_part": _catalog_display_part(String(entry_slot), part),
				})
	editor_catalog_raw_cache[cache_key] = entries
	return entries


func _editor_catalog_entries(role_key: String, slot_key: String) -> Array:
	var cache_key := _editor_catalog_entries_cache_key(role_key, slot_key)
	if editor_catalog_entries_cache.has(cache_key):
		editor_catalog_cache_hit_count += 1
		return editor_catalog_entries_cache[cache_key]
	var entries := _editor_catalog_raw_entries(role_key, slot_key)
	var available_sort_keys := _editor_available_sort_keys_from_entries(entries)
	if not available_sort_keys.has(editor_catalog_sort_key):
		editor_catalog_sort_key = String(available_sort_keys[0])
		cache_key = _editor_catalog_entries_cache_key(role_key, slot_key)
		if editor_catalog_entries_cache.has(cache_key):
			editor_catalog_cache_hit_count += 1
			return editor_catalog_entries_cache[cache_key]
	_sort_editor_catalog_entries(entries, slot_key)
	editor_catalog_cache_miss_count += 1
	editor_catalog_entries_cache[cache_key] = entries
	return entries


func _editor_available_sort_keys(role_key: String, slot_key: String) -> Array:
	var cache_key := "sort|%s" % _editor_catalog_raw_cache_key(role_key, slot_key)
	if editor_catalog_sort_keys_cache.has(cache_key):
		editor_catalog_cache_hit_count += 1
		return Array(editor_catalog_sort_keys_cache[cache_key]).duplicate()
	var keys := _editor_available_sort_keys_from_entries(_editor_catalog_raw_entries(role_key, slot_key))
	editor_catalog_cache_miss_count += 1
	editor_catalog_sort_keys_cache[cache_key] = keys.duplicate()
	return keys


func _editor_available_sort_keys_from_entries(entries: Array) -> Array:
	var available: Array = []
	for raw_key in EDITOR_SORT_KEY_ORDER:
		var key := String(raw_key)
		var has_key := false
		for raw_entry in entries:
			if not (raw_entry is Dictionary):
				continue
			var entry: Dictionary = raw_entry
			var part: Dictionary = entry.get("display_part", entry.get("part", {}))
			if _editor_part_has_sort_property(String(entry.get("slot", "")), part, key):
				has_key = true
				break
		if has_key:
			available.append(key)
	if available.is_empty():
		available.append("cost")
	return available


func _editor_part_has_sort_property(slot_key: String, part: Dictionary, sort_key: String) -> bool:
	if part.is_empty():
		return false
	match sort_key:
		"cost":
			return part.has("cost")
		"hp":
			return _component_has_combat_volume(part, slot_key) and float(part.get("hp", 0.0)) > 0.0
		"mass":
			return float(part.get("mass", 0.0)) > 0.0
		"length":
			return float(part.get("length", 0.0)) > 0.0
		"stiffness":
			return slot_key in ["muscle", "limb_muscle", "barrier"] and _part_stiffness(part, slot_key) > 0.0
		"engine_momentum":
			return slot_key == "engine" and _engine_momentum_output_for_part(part) > 0.0
		"allocated_momentum":
			if slot_key == "booster":
				return _thruster_drive_demand_for_part(part) > 0.0
			return _part_has_positive_numeric(part, ["allocated_momentum", "allocated_limb_momentum", "boost_momentum", "cooling_rate", "gravity_force", "repulsion_force", "pull_power", "trap_power"])
		"damage":
			if slot_key == "module" or _part_is_nonphysical_equipment_or_software(slot_key, part):
				return false
			if slot_key == "muscle" and _component_is_torso(part):
				return false
			return _part_has_positive_numeric(part, ["normal_damage", "armor_damage", "active_damage", "projectile_damage", "damage", "explosion_damage", "trap_damage", "barrage_damage", "homing_damage", "cage_damage"])
		"range":
			if slot_key == "muscle" and _component_is_torso(part):
				return false
			return _part_has_positive_numeric(part, ["projectile_range", "range", "normal_range", "aura_range", "trap_radius", "gravity_radius", "coolant_radius", "heat_field_radius", "repulsion_radius", "hack_radius", "shield_radius", "barrage_range", "homing_radius", "cage_radius", "blind_radius"])
	return false


func _part_has_positive_numeric(part: Dictionary, property_names: Array) -> bool:
	for property_name in property_names:
		if float(part.get(String(property_name), 0.0)) > 0.0:
			return true
	return false


func _editor_catalog_slots_for_active_filter(slot_key: String) -> Array:
	for option in _part_filter_options_for_group(editor_part_group_mode):
		if option is Dictionary and String(Dictionary(option).get("key", "")) == editor_part_filter_mode:
			var option_slots := _slot_keys_from_filter_option(Dictionary(option))
			if not option_slots.is_empty():
				return option_slots
	return [slot_key]


func _editor_catalog_part_passes_filter(slot_key: String, part: Dictionary) -> bool:
	if _part_is_catalog_frozen(slot_key, part):
		return false
	var filter_key := editor_part_filter_mode
	var catalog_role := _catalog_role_for_part(slot_key, part)
	var part_category := _catalog_part_category_for_part(slot_key, part)
	if filter_key in ["all", ""]:
		return true
	if filter_key in ["booster", "engine", "cooling"]:
		return slot_key == filter_key
	if filter_key in ["module", "module_all", "module_melee", "module_ranged", "module_other"]:
		if slot_key != "module":
			return false
		if filter_key in ["module", "module_all"]:
			return true
		var category := _module_category_for_part(part)
		if filter_key == "module_melee":
			return category == "melee"
		if filter_key == "module_ranged":
			return category == "ranged"
		if filter_key == "module_other":
			return category == "other"
		return true
	if slot_key == "special":
		var special_kind := String(part.get("kind", "")).to_lower()
		match filter_key:
			"soul":
				return special_kind == "soul"
			"code":
				return special_kind == "code"
			"ether":
				return special_kind == "ether"
		return true
	if slot_key == "limb_muscle":
		var limb_barrier := catalog_role == "barrier_tile" or bool(part.get("barrier_tile_component", false)) or bool(part.get("barrier_panel", false)) or String(part.get("barrier_logic", "")) != ""
		if filter_key == "barrier_muscle":
			return limb_barrier
		return filter_key in ["ordinary", "connector_limb"] and not limb_barrier
	if slot_key == "joint":
		var shape := String(part.get("shape", "")).to_lower()
		var part_name := String(part.get("name", "")).to_lower()
		var fixed := bool(part.get("fixed_corner_joint", false)) or bool(part.get("static_joint", false)) or shape.contains("corner") or shape.contains("fixed")
		var telescopic := shape.contains("linear") or shape.contains("telescopic") or float(part.get("max_extension_m", 0.0)) > 0.0
		var ball := not fixed and not telescopic
		var barrier_joint := bool(part.get("barrier_tile_component", false)) or bool(part.get("maze_wall_joint", false)) or bool(part.get("cheap_wall_joint", false)) or part_name.contains("maze") or part_name.contains("bulkhead") or part_name.contains("wall") or shape.contains("corner")
		match filter_key:
			"movable":
				return not fixed
			"fixed":
				return fixed
			"ball":
				return ball
			"telescopic":
				return telescopic
			"corner":
				return fixed or shape.contains("corner")
			"barrier_joint":
				return barrier_joint
		return true
	if slot_key == "muscle":
		var material_class := String(part.get("material_class", "")).to_lower()
		var damage_type := String(part.get("damage_type", "")).to_lower()
		var ammo_payload := catalog_role == "ammo_payload" or bool(part.get("ammo_slot_payload", false)) or material_class == "ammo_payload"
		var shield_payload := catalog_role == "shield_payload" or bool(part.get("electronic_armor", false)) or bool(part.get("shield_payload", false)) or material_class == "shield_payload"
		var software_muscle_payload := bool(part.get("torso_slot_payload", false)) or ammo_payload or shield_payload
		if filter_key == "ammo":
			return ammo_payload
		if filter_key == "shield_payload":
			return shield_payload
		if filter_key == "software_muscle":
			return software_muscle_payload
		var projectile := catalog_role == "gun" or bool(part.get("projectile", false)) or material_class in ["gun", "missile_launcher", "web_gun"]
		var torso := catalog_role in ["torso", "brain_torso"] or bool(part.get("is_torso", false)) or material_class == "torso"
		var brain_torso := catalog_role == "brain_torso" or (torso and _component_is_brain_torso(part))
		var barrier := catalog_role == "barrier_tile" or bool(part.get("barrier_tile_component", false)) or bool(part.get("barrier_panel", false)) or String(part.get("barrier_logic", "")) != "" or bool(part.get("is_support_node", false)) or bool(part.get("is_gravity_field", false)) or bool(part.get("is_trap_field", false))
		var terminal_weapon := catalog_role in ["gun", "melee_weapon"] or bool(part.get("terminal_weapon", false)) or material_class in ["weapon", "gun", "missile_launcher", "web_gun", "racket"]
		var two_ended_connector := catalog_role == "connector" or (int(part.get("connection_ends", 1)) >= 2 and not projectile and not terminal_weapon)
		var terminal_candidate := catalog_role in ["gun", "melee_weapon"] or (not torso and not barrier and not software_muscle_payload and (terminal_weapon or projectile or int(part.get("connection_ends", 1)) <= 1))
		var terminal_kind := _terminal_weapon_kind_for_part(part, "muscle") if terminal_candidate else ""
		var terminal_melee := terminal_candidate and terminal_kind == "melee" and damage_type in ["blunt", "pierce", "tear", "explosive"]
		match filter_key:
			"terminal", "weapon_all":
				return terminal_candidate
			"terminal_ranged", "weapon_gun":
				return terminal_candidate and terminal_kind == "ranged"
			"terminal_melee", "weapon_melee":
				return terminal_melee
			"weapon_blade":
				return terminal_melee and _component_is_blade_weapon(part)
			"weapon_blunt":
				return terminal_melee and _component_is_blunt_weapon(part)
			"weapon_pierce":
				return terminal_melee and _component_is_pierce_weapon(part)
			"weapon_scythe":
				return terminal_melee and _blade_weapon_family_for_part(part) == "scythe"
			"weapon_katana":
				return terminal_melee and _blade_weapon_family_for_part(part) == "katana"
			"weapon_greatsword":
				return terminal_melee and _blade_weapon_family_for_part(part) == "greatsword"
			"weapon_gauntlet":
				return terminal_melee and _blunt_weapon_family_for_part(part) == "gauntlet"
			"weapon_shield":
				return terminal_melee and _blunt_weapon_family_for_part(part) == "shield"
			"weapon_hammer":
				return terminal_melee and _blunt_weapon_family_for_part(part) == "hammer"
			"weapon_lance":
				return terminal_melee and _pierce_weapon_family_for_part(part) == "lance"
			"weapon_rapier":
				return terminal_melee and _pierce_weapon_family_for_part(part) == "rapier"
			"weapon_drill":
				return terminal_melee and _pierce_weapon_family_for_part(part) == "drill"
			"gun_sniper", "gun_rifle", "gun_laser_gun", "gun_sprayer", "gun_grenade_launcher", "gun_missile_launcher", "gun_web":
				return terminal_candidate and terminal_kind == "ranged" and _gun_family_matches_filter(part, filter_key)
			"connector_torso":
				return torso and not brain_torso
			"connector_brain":
				return brain_torso
			"connector_limb":
				return false
			"ordinary":
				return torso or barrier or two_ended_connector or part_category == "connector"
			"barrier_muscle":
				return barrier
		return true
	return true


func _editor_catalog_page_selection_key(unit_bp: Dictionary, role_key: String, page_entries: Array) -> String:
	var slots := {}
	for raw_entry in page_entries:
		if raw_entry is Dictionary:
			var entry: Dictionary = raw_entry
			slots[String(entry.get("slot", ""))] = true
	var pieces: Array = []
	for raw_slot in slots.keys():
		var entry_slot := String(raw_slot)
		pieces.append("%s:%d" % [entry_slot, _editor_selected_part_index_for_slot(unit_bp, role_key, entry_slot)])
	pieces.sort()
	pieces.append("pending:%s:%d:%d" % [
		editor_pending_place_slot,
		editor_pending_place_index,
		1 if _has_pending_canvas_part() else 0,
	])
	return ",".join(pieces)


func _editor_catalog_page_models(role_key: String, slot_key: String, unit_bp: Dictionary, entries: Array, page: int, page_size: int) -> Array:
	var start_index := page * page_size
	var end_index := mini(entries.size(), start_index + page_size)
	if start_index < 0 or start_index >= entries.size() or page_size <= 0:
		return []
	var page_entries := entries.slice(start_index, end_index)
	var cache_key := "%s|page:%d|size:%d|lang:%s|sel:%s" % [
		_editor_catalog_entries_cache_key(role_key, slot_key),
		page,
		page_size,
		ui_language,
		_editor_catalog_page_selection_key(unit_bp, role_key, page_entries),
	]
	if editor_catalog_page_model_cache.has(cache_key):
		return editor_catalog_page_model_cache[cache_key]
	var selected_by_slot := {}
	for raw_entry in page_entries:
		if raw_entry is Dictionary:
			var entry: Dictionary = raw_entry
			var entry_slot := String(entry.get("slot", slot_key))
			if not selected_by_slot.has(entry_slot):
				selected_by_slot[entry_slot] = _editor_selected_part_index_for_slot(unit_bp, role_key, entry_slot)
	var models: Array = []
	for raw_entry in page_entries:
		if not (raw_entry is Dictionary):
			continue
		var entry: Dictionary = raw_entry
		var entry_slot := String(entry.get("slot", slot_key))
		var part_index := int(entry.get("index", 0))
		var part: Dictionary = entry.get("display_part", {})
		if part.is_empty():
			part = _catalog_display_part(entry_slot, entry.get("part", _selected_component(role_key, entry_slot, part_index)))
		var selected_card := part_index == int(selected_by_slot.get(entry_slot, -1))
		var card_model := _catalog_card_cached_model(entry_slot, part, part_index)
		var marker := "已装 " if _ui_is_zh() and selected_card else ("IN " if selected_card else "")
		if entry_slot in ["joint", "limb_muscle", "muscle"]:
			marker = "待选 " if _ui_is_zh() and selected_card and _has_pending_canvas_part() else marker
		var title := "%s%s" % [marker, String(card_model.get("title_base", ""))]
		var line_a := String(card_model.get("line_a", ""))
		var line_b := String(card_model.get("line_b", ""))
		var card_signature := "%s|%d|%s|%s|%s|%s|%s|%s" % [
			entry_slot,
			part_index,
			String(part.get("stable_key", part.get("name", ""))),
			str(selected_card),
			ui_language,
			title,
			line_a,
			line_b,
		]
		models.append({
			"slot": entry_slot,
			"part_index": part_index,
			"part": part,
			"selected": selected_card,
			"title": title,
			"line_a": line_a,
			"line_b": line_b,
			"signature": card_signature,
		})
	editor_catalog_page_model_cache[cache_key] = models
	return models


func _sort_editor_catalog_entries(entries: Array, slot_key: String) -> void:
	for i in range(entries.size()):
		var best := i
		for j in range(i + 1, entries.size()):
			var entry_best: Dictionary = entries[best]
			var entry_next: Dictionary = entries[j]
			var best_slot := String(entry_best.get("slot", slot_key))
			var next_slot := String(entry_next.get("slot", slot_key))
			var value_best := _editor_part_sort_value(best_slot, entry_best.get("display_part", entry_best.get("part", {})))
			var value_next := _editor_part_sort_value(next_slot, entry_next.get("display_part", entry_next.get("part", {})))
			var should_swap := value_next < value_best if editor_catalog_sort_ascending else value_next > value_best
			if is_equal_approx(value_next, value_best):
				should_swap = int(entry_next.get("index", 0)) < int(entry_best.get("index", 0))
			if should_swap:
				best = j
		if best != i:
			var temp = entries[i]
			entries[i] = entries[best]
			entries[best] = temp


func _editor_part_sort_value(slot_key: String, part: Dictionary) -> float:
	match editor_catalog_sort_key:
		"cost":
			return float(part.get("cost", 0.0))
		"hp":
			return float(part.get("hp", 0.0)) if _component_has_combat_volume(part, slot_key) else 0.0
		"mass":
			return float(part.get("mass", 0.0))
		"length":
			return float(part.get("length", 0.0))
		"stiffness":
			return _part_stiffness(part, slot_key)
		"engine_momentum":
			return _engine_momentum_output_for_part(part) if slot_key == "engine" else 0.0
		"allocated_momentum":
			if slot_key == "booster":
				return _thruster_drive_demand_for_part(part)
			if slot_key in ["limb_muscle", "muscle"] and not _component_is_torso(part):
				return _default_limb_allocated_momentum_for_part(part, slot_key)
			if slot_key == "cooling":
				return _cooling_rate_for_part(part)
			return float(part.get("allocated_momentum", 0.0))
		"damage":
			if slot_key == "module" or _part_is_nonphysical_equipment_or_software(slot_key, part):
				return 0.0
			if slot_key == "muscle" and _component_is_torso(part):
				return 0.0
			return maxf(float(part.get("normal_damage", 0.0)), maxf(float(part.get("armor_damage", 0.0)), float(part.get("active_damage", 0.0))))
		"range":
			if slot_key == "muscle" and _component_is_torso(part):
				return 0.0
			return maxf(float(part.get("projectile_range", part.get("range", 0.0))), maxf(float(part.get("normal_range", 0.0)), float(part.get("length", 0.0))))
	return float(part.get("cost", 0.0))


func _update_editor_catalog_buttons(role_key: String, unit_bp: Dictionary) -> void:
	var update_started := Time.get_ticks_usec()
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("teamedit.catalog")
	if editor_panel_mode != "parts":
		var hidden_revision := "hidden|%s" % editor_panel_mode
		if editor_catalog_buttons_revision_key == hidden_revision:
			editor_catalog_revision_skip_count += 1
			if hot_path_profiler != null:
				hot_path_profiler.count("teamedit.catalog.skip")
				hot_path_profiler.scope_end("teamedit.catalog")
			return
		editor_catalog_buttons_revision_key = hidden_revision
		editor_catalog_card_signature_cache.clear()
		for i in range(editor_catalog_buttons.size()):
			var hidden_button: Button = editor_catalog_buttons[i]
			_set_canvas_item_visible_if_changed(hidden_button, false)
			_set_button_disabled_if_changed(hidden_button, true)
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("teamedit.catalog")
		return
	var slot_key: String = BUILD_SLOTS[editor_slot_index]
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("teamedit.catalog.entries")
	var entries := _editor_catalog_entries(role_key, slot_key)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("teamedit.catalog.entries")
	var page_size: int = max(1, editor_catalog_buttons.size())
	var max_page: int = maxi(0, int(ceilf(float(entries.size()) / float(page_size))) - 1)
	editor_catalog_page = clampi(editor_catalog_page, 0, max_page)
	var page_start := editor_catalog_page * page_size
	var page_end := mini(entries.size(), page_start + page_size)
	var page_selection_key := _editor_catalog_page_selection_key(unit_bp, role_key, entries.slice(page_start, page_end))
	var revision_key := "%s|%s|%s|%s|%s|%s|%d|%d|%d|%d" % [
		role_key,
		slot_key,
		editor_part_group_mode,
		editor_part_filter_mode,
		editor_weapon_filter_group + ":" + editor_weapon_filter_subtype,
		editor_catalog_sort_key,
		1 if editor_catalog_sort_ascending else 0,
		editor_catalog_page,
		entries.size(),
		page_selection_key.hash(),
	]
	if revision_key == editor_catalog_buttons_revision_key:
		editor_catalog_revision_skip_count += 1
		if hot_path_profiler != null:
			hot_path_profiler.count("teamedit.catalog.skip")
			hot_path_profiler.scope_end("teamedit.catalog")
		return
	editor_catalog_buttons_revision_key = revision_key
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("teamedit.catalog.page_label")
	if editor_catalog_page_label != null:
		_set_control_position_if_changed(editor_catalog_page_label, Vector2(1110.0, 330.0))
		_set_control_size_if_changed(editor_catalog_page_label, Vector2(96.0, 20.0))
		_set_control_text_if_changed(editor_catalog_page_label, ("页 %d/%d  %d" if _ui_is_zh() else "P %d/%d %d") % [editor_catalog_page + 1, max_page + 1, entries.size()])
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("teamedit.catalog.page_label")
		hot_path_profiler.scope_begin("teamedit.catalog.cards")
	CatalogCardRetainedItem.defer_texture_requests = Time.get_ticks_msec() < editor_preview_pause_until_msec
	if hot_path_profiler != null:
		hot_path_profiler.scope_begin("teamedit.catalog.page_models")
	var page_models := _editor_catalog_page_models(role_key, slot_key, unit_bp, entries, editor_catalog_page, page_size)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("teamedit.catalog.page_models")
	for i in range(editor_catalog_buttons.size()):
		var button: Button = editor_catalog_buttons[i]
		var visible_item: bool = i < page_models.size()
		if hot_path_profiler != null:
			hot_path_profiler.scope_begin("teamedit.catalog.card_state")
		_set_canvas_item_visible_if_changed(button, visible_item)
		_set_button_disabled_if_changed(button, not visible_item)
		if hot_path_profiler != null:
			hot_path_profiler.scope_end("teamedit.catalog.card_state")
		if not visible_item:
			_set_control_text_if_changed(button, "")
			var hidden_sig := "hidden|%d" % i
			if button is PartCatalogCardButton and String(editor_catalog_card_signature_cache.get(i, "")) != hidden_sig:
				if hot_path_profiler != null:
					hot_path_profiler.scope_begin("teamedit.catalog.card_set")
				(button as PartCatalogCardButton).set_card_with_signature(hidden_sig, slot_key, {}, false, ui_language, -1, "", "", "")
				if hot_path_profiler != null:
					hot_path_profiler.scope_end("teamedit.catalog.card_set")
				editor_catalog_card_signature_cache[i] = hidden_sig
			continue
		var page_model: Dictionary = page_models[i]
		var entry_slot := String(page_model.get("slot", slot_key))
		var part_index := int(page_model.get("part_index", 0))
		var part: Dictionary = page_model.get("part", {})
		var selected_card := bool(page_model.get("selected", false))
		var title := String(page_model.get("title", ""))
		var line_a := String(page_model.get("line_a", ""))
		var line_b := String(page_model.get("line_b", ""))
		var card_signature := String(page_model.get("signature", ""))
		if String(editor_catalog_card_signature_cache.get(i, "")) == card_signature:
			continue
		if button is PartCatalogCardButton:
			if hot_path_profiler != null:
				hot_path_profiler.scope_begin("teamedit.catalog.card_set")
			(button as PartCatalogCardButton).set_card_with_signature(card_signature, entry_slot, part, selected_card, ui_language, part_index, title, line_a, line_b)
			if hot_path_profiler != null:
				hot_path_profiler.scope_end("teamedit.catalog.card_set")
			editor_catalog_card_update_count += 1
		else:
			var fallback_marker := ">> " if selected_card else ""
			if hot_path_profiler != null:
				hot_path_profiler.scope_begin("teamedit.catalog.card_set")
			_set_control_text_if_changed(button, "%s%d %s" % [fallback_marker, part_index + 1, _short_part_name(String(part.get("name", "")))])
			if hot_path_profiler != null:
				hot_path_profiler.scope_end("teamedit.catalog.card_set")
			editor_catalog_card_update_count += 1
		editor_catalog_card_signature_cache[i] = card_signature
	CatalogCardRetainedItem.defer_texture_requests = false
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("teamedit.catalog.cards")
		hot_path_profiler.scope_begin("teamedit.catalog.nav_buttons")
	if editor_action_buttons.has("prev_catalog"):
		_set_button_disabled_if_changed(editor_action_buttons["prev_catalog"], editor_catalog_page <= 0)
	if editor_action_buttons.has("next_catalog"):
		_set_button_disabled_if_changed(editor_action_buttons["next_catalog"], editor_catalog_page >= max_page)
	if hot_path_profiler != null:
		hot_path_profiler.scope_end("teamedit.catalog.nav_buttons")
	editor_catalog_update_usec = Time.get_ticks_usec() - update_started
	if hot_path_profiler != null:
		hot_path_profiler.record_value("teamedit.catalog_usec", editor_catalog_update_usec)
		hot_path_profiler.count("teamedit.catalog.cards", editor_catalog_card_update_count)
		hot_path_profiler.scope_end("teamedit.catalog")


func _editor_selected_part_index_for_slot(unit_bp: Dictionary, role_key: String, slot_key: String) -> int:
	var selected_index := int(unit_bp.get(slot_key, 0))
	if _role_uses_body_board(role_key) and unit_bp.has("custom_topology") and _is_body_group_slot(slot_key):
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		var nodes: Array = topology.get("nodes", [])
		if not nodes.is_empty():
			editor_topology_node_index = clampi(editor_topology_node_index, 0, nodes.size() - 1)
			var node: Dictionary = nodes[editor_topology_node_index]
			if _topology_node_is_component(node):
				if _topology_node_slot(node) == slot_key:
					selected_index = _topology_node_part_index(node, unit_bp)
				elif _has_pending_canvas_part() and editor_pending_place_slot == slot_key:
					selected_index = editor_pending_place_index
			else:
				selected_index = int(node.get(slot_key, selected_index))
		elif _has_pending_canvas_part() and editor_pending_place_slot == slot_key:
			selected_index = editor_pending_place_index
	return selected_index


func _hover_catalog_component(component_index: int) -> void:
	if editor_panel_mode != "parts":
		return
	var role_key: String = ROLE_ORDER[editor_role_index]
	var slot_key: String = BUILD_SLOTS[editor_slot_index]
	var entries := _editor_catalog_entries(role_key, slot_key)
	var actual_entry_index: int = editor_catalog_page * maxi(1, editor_catalog_buttons.size()) + component_index
	if actual_entry_index < 0 or actual_entry_index >= entries.size():
		_clear_editor_hover_card()
		return
	var entry: Dictionary = entries[actual_entry_index]
	var part_index := int(entry.get("index", 0))
	var entry_slot := String(entry.get("slot", slot_key))
	var part: Dictionary = entry.get("display_part", {})
	if part.is_empty():
		part = _catalog_display_part(entry_slot, entry.get("part", _selected_component(role_key, entry_slot, part_index)))
	_show_editor_part_hover(entry_slot, part_index, part)


func _hover_shop_component(slot_key: String) -> void:
	if editor_panel_mode != "shop":
		return
	var player_id := _editor_player()
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	var part_index := int(unit_bp.get(slot_key, 0))
	if _role_uses_body_board(role_key) and unit_bp.has("custom_topology"):
		var topology: Dictionary = unit_bp.get("custom_topology", {})
		var nodes: Array = topology.get("nodes", [])
		if not nodes.is_empty():
			editor_topology_node_index = clampi(editor_topology_node_index, 0, nodes.size() - 1)
			var node: Dictionary = nodes[editor_topology_node_index]
			part_index = int(node.get(slot_key, part_index))
			if _topology_node_is_component(node) and _topology_node_slot(node) == slot_key:
				part_index = _topology_node_part_index(node, unit_bp)
	var part := _selected_component(role_key, slot_key, part_index)
	_show_editor_part_hover(slot_key, part_index, part)


func _clear_editor_hover_card(force: bool = false) -> void:
	if editor_hover_pinned and not force:
		return
	if editor_hover_slot_key == "" and editor_hover_part_index < 0 and (editor_hover_popup_view == null or not editor_hover_popup_view.visible):
		return
	editor_hover_slot_key = ""
	editor_hover_part_index = -1
	editor_hover_pinned = false
	if editor_hover_popup_view != null:
		editor_hover_popup_view.z_index = 260
		editor_hover_popup_view.clear_card()
	if editor_stats_rail_view != null and editor_layer != null and editor_layer.visible:
		var role_key: String = ROLE_ORDER[editor_role_index]
		var stats := _editor_current_stats()
		_refresh_editor_stats_rail(stats)


func _editor_hover_detail_token(slot_key: String, part_index: int, context: Dictionary = {}) -> String:
	var source := String(context.get("source", "hover"))
	var node_index := int(context.get("node_index", -1))
	var entry_id := String(context.get("entry_id", ""))
	return "%s:%d:%s:%d:%s" % [slot_key, part_index, source, node_index, entry_id]


func _hover_detail_suppressed(token: String) -> bool:
	if token == "" or token != editor_hover_suppress_token:
		return false
	return Time.get_ticks_msec() < editor_hover_suppress_until_msec


func _close_editor_hover_detail(suppress_token: String = "") -> void:
	if suppress_token == "" and editor_hover_popup_view != null:
		suppress_token = String(editor_hover_popup_view.suppress_token)
	editor_hover_suppress_token = suppress_token
	editor_hover_suppress_until_msec = Time.get_ticks_msec() + 650
	_clear_editor_hover_card(true)


func _editor_binding_ui_active() -> bool:
	return game_state == STATE_EDITOR and editor_torso_detail_view != null and editor_torso_detail_view.visible and editor_torso_detail_view.binding_mode


func _show_editor_part_hover(slot_key: String, part_index: int, part: Dictionary, pinned: bool = false, context: Dictionary = {}) -> void:
	if _editor_binding_ui_active():
		_clear_editor_hover_card(true)
		return
	var hover_token := _editor_hover_detail_token(slot_key, part_index, context)
	if not pinned and editor_hover_pinned:
		return
	if _hover_detail_suppressed(hover_token):
		return
	if editor_hover_slot_key == slot_key and editor_hover_part_index == part_index and editor_hover_popup_view != null and editor_hover_popup_view.visible and String(editor_hover_popup_view.suppress_token) == hover_token and editor_hover_pinned == pinned:
		if pinned and not editor_hover_pinned:
			editor_hover_pinned = true
			editor_hover_popup_view.set_part(slot_key, part, editor_hover_popup_view.title, editor_hover_popup_view.subtitle, editor_hover_popup_view.detail_lines, ui_language, editor_hover_popup_view.stat_entries, true, hover_token)
		return
	editor_hover_preview_refresh_count += 1
	editor_hover_slot_key = slot_key
	editor_hover_part_index = part_index
	editor_hover_pinned = pinned
	var current_stats := _editor_current_stats()
	var title := "%02d %s" % [part_index + 1, _zh_part_name(String(part.get("name", ""))) if _ui_is_zh() else String(part.get("name", ""))]
	var subtitle := _hover_card_subtitle(slot_key, part)
	var lines := _hover_card_player_detail_lines(slot_key, part, context)
	var stat_entries := _hover_card_stat_entries(slot_key, part)
	if editor_hover_popup_view != null:
		editor_hover_popup_view.size = Vector2(506.0, 560.0) if pinned or slot_key == "module" else Vector2(466.0, 500.0)
		editor_hover_popup_view.z_index = 340 if pinned else 260
		editor_hover_popup_view.set_part(slot_key, part, title, subtitle, lines, ui_language, stat_entries, pinned, hover_token)
		if pinned:
			editor_hover_popup_view.position = _editor_hover_pinned_position(editor_hover_popup_view.size, context)
		editor_hover_popup_view.move_to_front()
	if editor_drag_ghost_view != null and editor_drag_ghost_view.visible:
		editor_drag_ghost_view.move_to_front()
	_refresh_editor_stats_rail(current_stats, {}, {}, {}, title)


func _editor_hover_pinned_position(popup_size: Vector2, context: Dictionary = {}) -> Vector2:
	var preferred = context.get("position", Vector2.INF)
	var viewport_size := Vector2(1280.0, 720.0)
	if get_viewport() != null:
		viewport_size = get_viewport().get_visible_rect().size
	var pos := Vector2(viewport_size.x - popup_size.x - 24.0, 96.0)
	if preferred is Vector2 and preferred != Vector2.INF:
		pos = preferred
	pos.x = clampf(pos.x, 12.0, maxf(12.0, viewport_size.x - popup_size.x - 12.0))
	pos.y = clampf(pos.y, 56.0, maxf(56.0, viewport_size.y - popup_size.y - 12.0))
	return pos


func _hover_torso_detail_payload(slot_kind: String, slot_index: int, payload_index: int) -> void:
	var role_key: String = ROLE_ORDER[editor_role_index]
	var unit_bp: Dictionary = _editor_current_blueprint()
	var payloads: Array = Array(unit_bp.get("slot_payloads", []))
	if payload_index < 0 or payload_index >= payloads.size() or not (payloads[payload_index] is Dictionary):
		_clear_editor_hover_card()
		return
	var payload: Dictionary = payloads[payload_index]
	var payload_kind := String(payload.get("kind", ""))
	var slot_key := _payload_slot_key_for_kind(payload_kind)
	var part := _payload_part_for_payload(role_key, payload)
	if part.is_empty():
		_clear_editor_hover_card()
		return
	var part_index := int(payload.get(slot_key, payload.get("index", 0)))
	if payload_kind == "special":
		part_index = int(payload.get("special", part_index))
	elif payload_kind == "module":
		part_index = int(payload.get("module", part_index))
	elif payload_kind in ["engine", "booster", "cooling"]:
		part_index = int(payload.get(payload_kind, part_index))
	elif payload_kind in ["ammo", "electronic_armor", "escape_pod", "spare_weapon"]:
		part_index = int(payload.get("muscle", part_index))
	_show_editor_part_hover(slot_key, part_index, part)
	if editor_hover_popup_view != null:
		if editor_torso_detail_view != null:
			editor_hover_popup_view.size = Vector2(466.0, 500.0)
			editor_hover_popup_view.position = Vector2(editor_torso_detail_view.position.x, maxf(82.0, editor_torso_detail_view.position.y - editor_hover_popup_view.size.y - 10.0))
		editor_hover_popup_view.move_to_front()


func _preview_blueprint_with_part(role_key: String, unit_bp: Dictionary, slot_key: String, part_index: int, part: Dictionary) -> Dictionary:
	var preview := unit_bp.duplicate(true)
	if _part_installs_as_torso_payload(slot_key, part):
		var payload_kind := _torso_payload_kind_for_part(part, slot_key)
		var payload := _make_torso_payload_for_part(payload_kind, slot_key, part_index, part)
		var payloads: Array = Array(preview.get("slot_payloads", [])).duplicate(true)
		payloads.append(payload)
		preview["slot_payloads"] = payloads
		return preview
	if _role_uses_body_board(role_key) and _is_body_group_slot(slot_key):
		if not preview.has("custom_topology"):
			preview["custom_topology"] = {"nodes": [], "edges": []}
			preview.erase("groups")
		var topology: Dictionary = Dictionary(preview.get("custom_topology", {})).duplicate(true)
		var nodes: Array = Array(topology.get("nodes", [])).duplicate(true)
		if _is_topology_part_slot(slot_key):
			if nodes.is_empty():
				nodes.append(_topology_component_node(0, _topology_component_label(slot_key, part, 0), Vector2(0.5, 0.5), slot_key, part_index))
			else:
				var node_index := clampi(editor_topology_node_index, 0, nodes.size() - 1)
				var node: Dictionary = Dictionary(nodes[node_index]).duplicate(true)
				if _topology_node_is_component(node):
					node["slot"] = slot_key
					node["part_index"] = part_index
					node[slot_key] = part_index
					node["label"] = _topology_component_label(slot_key, part, int(node.get("id", node_index)))
					if slot_key != "joint":
						node.erase("module")
						node.erase("modules")
						node.erase("attack_key")
					nodes[node_index] = node
				else:
					node[slot_key] = part_index
					nodes[node_index] = node
		elif slot_key == "module":
			if nodes.is_empty():
				preview[slot_key] = part_index
			else:
				var module_node_index := clampi(editor_topology_node_index, 0, nodes.size() - 1)
				var module_node: Dictionary = Dictionary(nodes[module_node_index]).duplicate(true)
				var modules: Array = Array(module_node.get("modules", [])).duplicate(true)
				if modules.is_empty():
					modules.append(part_index)
				else:
					modules[0] = part_index
				module_node["modules"] = modules
				module_node["module"] = part_index
				nodes[module_node_index] = module_node
		topology["nodes"] = nodes
		preview["custom_topology"] = topology
		return preview
	preview[slot_key] = part_index
	return preview


func _compute_preview_context_for_blueprint(player_id: int, role_key: String, unit_index: int, preview_bp: Dictionary) -> Dictionary:
	var roster: Array = blueprints[player_id][role_key]
	var resolved_index := clampi(unit_index, 0, roster.size() - 1)
	var original: Dictionary = roster[resolved_index]
	roster[resolved_index] = preview_bp
	var preview_stats := _compute_unit_stats(player_id, role_key, resolved_index)
	var preview_summary := _team_summary(player_id)
	roster[resolved_index] = original
	return {"stats": preview_stats, "summary": preview_summary, "bp": preview_bp}


func _hover_card_subtitle(slot_key: String, part: Dictionary) -> String:
	var maker := _zh_part_name(String(part.get("maker", ""))) if _ui_is_zh() else String(part.get("maker", ""))
	var material := _zh_part_name(String(part.get("material_class", "构件")).to_upper()) if _ui_is_zh() else String(part.get("material_class", "part")).to_upper()
	var size_label := _volume_rank_label(_part_slot_volume_rank(part, slot_key))
	var slot_label := _slot_name(slot_key)
	if slot_key == "muscle" and _component_is_torso(part):
		slot_label = "躯干肌肉" if _ui_is_zh() else "TORSO MUSCLE"
	if maker == "":
		maker = "未知厂商" if _ui_is_zh() else "UNKNOWN MAKER"
	if _part_is_catalog_frozen(slot_key, part):
		var lifecycle: Dictionary = _catalog_lifecycle_for_part(slot_key, part)
		var frozen_label := "冻结" if _ui_is_zh() else "FROZEN"
		var tag := String(lifecycle.get("future_dev_tag", "future"))
		return "%s / %s / %s" % [frozen_label, tag, slot_label]
	return "%s / %s / %s" % [maker, slot_label, size_label if slot_key in ["engine", "cooling", "booster"] or bool(part.get("torso_slot_payload", false)) else material]


func _module_action_card_model(part: Dictionary) -> Dictionary:
	var zh := _ui_is_zh()
	var profile := String(part.get("module_action_profile", ""))
	if profile == "":
		profile = String(part.get("gun_activation", part.get("motion", "")))
	var command_profile := String(part.get("command_window_profile", ""))
	var target_kind := String(part.get("module_target_kind", part.get("target_kind", "")))
	var category := _module_category_for_part(part)
	var joint_label := _module_joint_fit_label(target_kind, zh)
	var weapon_label := _module_weapon_fit_label(part, profile, command_profile, target_kind, zh)
	var joint_icon := _module_joint_fit_icon(target_kind)
	var weapon_icon := _module_weapon_fit_icon(part, profile, command_profile, target_kind)
	var input_rows := _module_input_rows_for_part(part, profile, command_profile, zh)
	var model := {
		"profile": profile,
		"command_profile": command_profile,
		"target_kind": target_kind,
		"category": category,
		"category_label": _module_category_label(category, zh),
		"category_path": _module_category_path(category, zh),
		"category_short": _module_category_short_path(category, zh),
		"target_label": _module_target_kind_label(target_kind, zh),
		"joint_label": joint_label,
		"joint_short": _module_short_fit_label(joint_label),
		"joint_icon": joint_icon,
		"weapon_label": weapon_label,
		"weapon_short": _module_short_fit_label(weapon_label),
		"weapon_icon": weapon_icon,
		"input_rows": input_rows,
		"input_short": _module_input_mode_label(part, profile, command_profile, zh),
		"damage_source": _module_damage_source_label(profile, target_kind, zh),
		"source_icon": "projectile" if _gun_activation_profiles().has(profile) else "contact",
		"variant_key": String(part.get("module_variant_key", "")),
		"variant_label": String(part.get("module_variant_label", "")) if zh else String(part.get("module_variant_label_en", part.get("module_variant_label", ""))),
		"variant_summary": String(part.get("module_variant_summary", "")) if zh else String(part.get("module_variant_summary_en", part.get("module_variant_summary", ""))),
		"data_line": _module_action_data_line(part, profile, command_profile, zh),
		"icon_tags": [joint_icon, weapon_icon, "input", "projectile" if _gun_activation_profiles().has(profile) else "contact"],
	}
	return model


func _module_category_for_part(part: Dictionary) -> String:
	var explicit := String(part.get("module_category", "")).to_lower()
	if explicit in ["melee", "ranged", "other"]:
		return explicit
	var profile := String(part.get("module_action_profile", ""))
	if profile == "":
		profile = String(part.get("gun_activation", part.get("motion", "")))
	profile = profile.to_lower()
	var command_profile := String(part.get("command_window_profile", "")).to_lower()
	var target_kind := String(part.get("module_target_kind", part.get("target_kind", ""))).to_lower()
	var motion := String(part.get("motion", "")).to_lower()
	var effect := String(part.get("module_effect", "")).to_lower()
	var key := "%s %s %s %s %s %s %s" % [
		profile,
		command_profile,
		target_kind,
		motion,
		effect,
		String(part.get("travel_path", "")).to_lower(),
		String(part.get("projectile_behavior", "")).to_lower(),
	]
	if _gun_activation_profiles().has(profile) \
			or target_kind.find("gun") >= 0 \
			or bool(part.get("requires_connected_gun", false)) \
			or bool(part.get("projectile", false)) \
			or key.find("projectile") >= 0 \
			or key.find("bullet") >= 0 \
			or key.find("missile") >= 0 \
			or key.find("laser") >= 0 \
			or key.find("web") >= 0 \
			or key.find("salvo") >= 0 \
			or key.find("beam") >= 0:
		return "ranged"
	if effect in ["capture", "eject", "takeover", "control", "repair", "heal", "buff", "debuff"] \
			or key.find("capture") >= 0 \
			or key.find("eject") >= 0 \
			or key.find("takeover") >= 0 \
			or key.find("hijack") >= 0 \
			or key.find("grapple") >= 0 \
			or key.find("support") >= 0 \
			or bool(part.get("non_damage", false)):
		return "other"
	if target_kind == "" and profile == "":
		return "other"
	return "melee"


func _module_category_label(category: String, zh: bool) -> String:
	match category:
		"ranged":
			return "远程" if zh else "Ranged"
		"other":
			return "其他" if zh else "Other"
		_:
			return "近战" if zh else "Melee"


func _module_category_path(category: String, zh: bool) -> String:
	return ("行动模块 > %s" if zh else "Action Module > %s") % _module_category_label(category, zh)


func _module_category_short_path(category: String, zh: bool) -> String:
	return ("模块>%s" if zh else "MOD>%s") % _module_category_label(category, zh).to_upper()


func _module_short_fit_label(label: String) -> String:
	var text := label.strip_edges()
	if text.find("/") >= 0:
		text = text.split("/", false)[0]
	if text.length() > 5 and _ui_is_zh():
		return text.substr(0, 5)
	if text.length() > 8:
		return text.substr(0, 8)
	return text


