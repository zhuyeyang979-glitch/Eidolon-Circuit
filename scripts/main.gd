func _add_parallax_node(node: Node2D, base_position: Vector2, parallax: float) -> void:
	node.position = base_position
	add_child(node)
	parallax_nodes.append({"node": node, "base": base_position, "base_scale": node.scale, "base_rotation": node.rotation, "parallax": parallax})


func _add_parallax_starfield(layer_name: String, count: int, parallax: float, tint: Color, scale_mult: float, z: int) -> void:
	var layer := Node2D.new()
	layer.name = layer_name
	layer.z_index = z
	for i in range(count):
		var x := -540.0 + float((i * 137 + 41) % 2360)
		var y := -240.0 + float((i * 89 + 73) % 1260)
		var size := (0.8 + float((i * 23) % 9) * 0.16) * scale_mult
		var star := Polygon2D.new()
		star.name = "Star%d" % i
		star.position = Vector2(x, y)
		star.polygon = _space_diamond(Vector2.ZERO, size)
		var star_color := tint.lerp(Color.WHITE, 0.18 + float(i % 5) * 0.05)
		star_color.a = 0.16 + float(i % 7) * 0.032
		star.color = star_color
		layer.add_child(star)
		if i % 13 == 0:
			var flare_h := Line2D.new()
			flare_h.width = maxf(0.7, size * 0.5)
			flare_h.default_color = Color(star.color.r, star.color.g, star.color.b, 0.1)
			flare_h.points = PackedVector2Array([Vector2(-size * 4.0, 0.0), Vector2(size * 4.0, 0.0)])
			star.add_child(flare_h)
			var flare_v := Line2D.new()
			flare_v.width = maxf(0.7, size * 0.42)
			flare_v.default_color = Color(star.color.r, star.color.g, star.color.b, 0.08)
			flare_v.points = PackedVector2Array([Vector2(0.0, -size * 3.0), Vector2(0.0, size * 3.0)])
			star.add_child(flare_v)
	_add_parallax_node(layer, Vector2.ZERO, parallax)


func _add_parallax_nebula(layer_name: String, base_position: Vector2, size: Vector2, colors: Array, parallax: float, z: int) -> void:
	var layer := Node2D.new()
	layer.name = layer_name
	layer.z_index = z
	for i in range(18):
		var blob := Polygon2D.new()
		blob.name = "NebulaBloom%d" % i
		var angle := TAU * float((i * 7) % 18) / 18.0
		var distance := 0.18 + float((i * 11) % 9) * 0.075
		var color: Color = colors[i % colors.size()]
		blob.position = Vector2(cos(angle) * size.x * distance, sin(angle * 1.3) * size.y * distance)
		blob.rotation = angle * 0.23
		blob.polygon = _space_ellipse(Vector2.ZERO, size.x * (0.16 + float(i % 4) * 0.035), size.y * (0.18 + float((i + 2) % 4) * 0.04), 30)
		blob.color = color
		layer.add_child(blob)
	var vein := Line2D.new()
	vein.name = "IonVein"
	vein.width = 2.0
	vein.default_color = Color(0.72, 0.96, 1.0, 0.16)
	var vein_points := PackedVector2Array()
	for i in range(22):
		var t := float(i) / 21.0
		vein_points.append(Vector2(lerpf(-size.x * 0.52, size.x * 0.52, t), sin(t * TAU * 1.5) * size.y * 0.24))
	vein.points = vein_points
	layer.add_child(vein)
	_add_parallax_node(layer, base_position, parallax)


func _add_parallax_planet(layer_name: String, base_position: Vector2, radius: float, body_color: Color, rim_color: Color, parallax: float, ringed: bool, z: int) -> void:
	var planet := Node2D.new()
