func _saved_unit_files() -> Array:
	var files: Array = []
	for record in _saved_unit_file_records():
		if record is Dictionary:
			files.append(String(Dictionary(record).get("path", "")))
	return files


func _saved_unit_file_records() -> Array:
	_ensure_saved_units_dir()
	_purge_legacy_saved_units()
	saved_unit_cache_disk_scan_count += 1
	var dir := DirAccess.open(SAVED_UNITS_DIR)
	var paths: Array = []
	if dir == null:
		return []
	dir.list_dir_begin()
	while true:
		var file_name := dir.get_next()
		if file_name == "":
			break
		if dir.current_is_dir():
			continue
		if file_name.to_lower().ends_with(".json"):
			paths.append("%s/%s" % [SAVED_UNITS_DIR, file_name])
	dir.list_dir_end()
	paths.sort()
	var records: Array = []
	for raw_path in paths:
		var path := String(raw_path)
		var size := 0
		var file := FileAccess.open(path, FileAccess.READ)
		if file != null:
			size = int(file.get_length())
			file.close()
		records.append({
			"path": path,
			"mtime": int(FileAccess.get_modified_time(path)) if FileAccess.file_exists(path) else 0,
			"size": size,
		})
	return records


func _saved_unit_signature_from_records(records: Array) -> String:
	return _saved_unit_library_service().signature_from_records(records)


func _invalidate_saved_unit_library_cache() -> void:
