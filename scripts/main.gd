	_snap_all_topology_edges("hero", starter)
	return starter


func _ai_puppet_unit(unit_name: String, profile: String, muscle_index: int, module_index: int, special_index: int = 0) -> Dictionary:
	var topology := _default_free_canvas_topology("puppet")
	for i in range(Array(topology.get("nodes", [])).size()):
		var nodes: Array = topology["nodes"]
		var node: Dictionary = nodes[i]
		if i > 0:
			if _topology_node_is_component(node):
				if _topology_node_slot(node) == "muscle":
					node["part_index"] = muscle_index
				node["module"] = module_index
				node["modules"] = [module_index]
			else:
				node["muscle"] = muscle_index
				node["module"] = module_index
				node["modules"] = [module_index]
		nodes[i] = node
		topology["nodes"] = nodes
	return {"name": unit_name, "archetype": "custom", "special": special_index, "joint": 8, "limb_muscle": 0, "muscle": muscle_index, "booster": 0, "engine": 0, "cooling": 0, "module": module_index, "ai_profile": profile, "custom_topology": topology}


func _ai_micro_puppet_unit(unit_name: String, profile: String = "guard_orbit") -> Dictionary:
	var gun_index := _component_index_by_name("puppet", "muscle", "LIGHT RIFLE MUSCLE", 89)
	var fallback_torso_index := _component_index_by_name("puppet", "muscle", "FLOATING BIT CORE", 95)
	var torso_index := _default_topology_socket_legal_torso_index("puppet", _default_topology_required_torso_rank("puppet", 0, gun_index), ["HUMANOVA DUEL CORE", "SYNTAX MIDFIELD CORE", "FLOATING BIT CORE"], fallback_torso_index)
	var module_index := _component_index_by_name("puppet", "module", "GUNNER WRIST: QE MANUAL SWEEP", 5)
	var unit_bp := {"name": unit_name, "archetype": "custom", "special": 0, "limb_muscle": 0, "muscle": torso_index, "booster": 4, "engine": 3, "cooling": 5, "module": module_index, "ai_profile": profile, "custom_topology": _default_free_canvas_topology("puppet")}
	var topology: Dictionary = unit_bp.get("custom_topology", {})
	var nodes: Array = topology.get("nodes", [])
	for i in range(nodes.size()):
		if not (nodes[i] is Dictionary):
			continue
		var node: Dictionary = nodes[i]
		var slot := _topology_node_slot(node)
		if slot == "muscle":
			var part := _topology_node_part("puppet", node, unit_bp)
			if bool(part.get("is_torso", false)):
				node["part_index"] = torso_index
			else:
				node["part_index"] = gun_index
		elif slot == "limb_muscle":
			node["module"] = module_index
			node["modules"] = [module_index]
			node["attack_key"] = maxi(1, int(node.get("attack_key", 1)))
		nodes[i] = node
	topology["nodes"] = nodes
	unit_bp["custom_topology"] = topology
	_snap_all_topology_edges("puppet", unit_bp)
	return unit_bp


func _ai_archetype_unit(unit_name: String, role_key: String, archetype_key: String, special_index: int, joint_index: int, muscle_index: int, booster_index: int, engine_index: int, module_index: int) -> Dictionary:
