func _part_damage_key(attack_index: int, part_kind: String) -> String:
	return "%d:%s" % [attack_index, part_kind]


func _target_torso_stiffness_segment(target, torso_index: int) -> Dictionary:
	if target == null or not is_instance_valid(target):
		return {}
	var units: Array = target.stats.get("torso_stiffness_segments", [])
	if units.is_empty():
		return {}
	var index := clampi(torso_index, 0, units.size() - 1)
	if units[index] is Dictionary:
		return units[index]
	return {}


func _target_torso_unit_max_hp(target, torso_index: int) -> float:
	var unit := _target_torso_stiffness_segment(target, torso_index)
	if unit.is_empty():
		if target != null and is_instance_valid(target):
			return maxf(CONTACT_UNIT_HP_MIN, float(target.stats.get("torso_stiffness_segment_hp", target.max_health * 0.32)))
		return 0.0
	return maxf(CONTACT_UNIT_HP_MIN, float(unit.get("unit_hp", 0.0)))


func _unit_has_fracture_brood_module(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	if String(unit.stats.get("module_effect", "")) == "torso_fracture_brood":
		return true
	for raw_binding in Array(unit.stats.get("runtime_module_bindings", [])):
		if raw_binding is Dictionary and String(Dictionary(raw_binding).get("module_effect", "")) == "torso_fracture_brood":
			return true
	return false


func _fracture_brood_ai_kind(unit) -> String:
	if unit == null or not is_instance_valid(unit):
		return "guard_orbit"
	var ai_kind := String(unit.stats.get("fracture_ai", ""))
	if ai_kind != "":
		return ai_kind
	for raw_binding in Array(unit.stats.get("runtime_module_bindings", [])):
		if raw_binding is Dictionary:
			var binding: Dictionary = raw_binding
			if String(binding.get("module_effect", "")) == "torso_fracture_brood":
				return String(binding.get("fracture_ai", "guard_orbit"))
	return "guard_orbit"


func _soul_anchor_torso_index(unit) -> int:
	if unit == null or not is_instance_valid(unit):
		return -1
	var units: Array = Array(unit.stats.get("torso_stiffness_segments", []))
	if units.is_empty():
		return 0 if bool(unit.stats.get("has_soul", false)) else -1
	var raw_anchor := int(unit.stats.get("soul_anchor_torso_unit_index", -1))
	if unit.has_meta("soul_anchor_torso_unit_index"):
		raw_anchor = int(unit.get_meta("soul_anchor_torso_unit_index"))
	if raw_anchor < 0:
		raw_anchor = int(floorf(float(units.size() - 1) * 0.5))
	return clampi(raw_anchor, 0, units.size() - 1)


func _torso_unit_world_position(unit, torso_index: int) -> Vector2:
	if unit == null or not is_instance_valid(unit):
		return Vector2.ZERO
	var entries: Array = Array(unit.stats.get("torso_stiffness_segments", []))
	var body_origin := Vector2(unit.ring_pos, unit.lane)
	var axis := Vector2(cos(float(unit.facing_angle)), sin(float(unit.facing_angle)))
	if axis.length_squared() <= 0.0001:
		axis = Vector2(float(unit.facing), 0.0)
	var side := Vector2(-axis.y, axis.x)
	var body_length := clampf(float(unit.stats.get("length", 1.0)), 0.12, 4.5)
	if torso_index >= 0 and torso_index < entries.size() and entries[torso_index] is Dictionary:
		var entry: Dictionary = entries[torso_index]
		var local_offset = entry.get("local_offset", Vector2.ZERO)
		if not (local_offset is Vector2):
			local_offset = Vector2.ZERO
		var center := body_origin + axis * float(local_offset.x) + side * float(local_offset.y)
		if entries.size() > 1 and not bool(entry.get("has_topology_offset", false)):
			var t := 0.5 if entries.size() <= 1 else float(torso_index) / float(entries.size() - 1)
			center += axis * (t - 0.5) * body_length * 0.52
		return Vector2(wrapf(center.x, 0.0, RING_LENGTH), clampf(center.y, -BATTLE_HALF_HEIGHT, BATTLE_HALF_HEIGHT))
	return body_origin


func _torso_fragment_stats(parent, torso_index: int, torso_unit: Dictionary) -> Dictionary:
	var count := maxi(1, Array(parent.stats.get("torso_stiffness_segments", [])).size())
	var unit_hp := maxf(CONTACT_UNIT_HP_MIN, float(torso_unit.get("unit_hp", parent.stats.get("torso_stiffness_segment_hp", parent.max_health * 0.22))))
	var fragment_length := clampf(float(torso_unit.get("length", parent.stats.get("length", 0.55) / float(count))), 0.08, 1.65)
	var fragment_radius := clampf(float(torso_unit.get("radius", parent.stats.get("radius", 0.16))), 0.035, 0.95)
	var fragment_mass := maxf(1.0, float(parent.stats.get("mass", 6.0)) / float(count))
	var stats: Dictionary = parent.stats.duplicate(true)
	stats["role"] = "puppet"
	stats["name"] = "%s BROOD %d" % [String(torso_unit.get("name", "TORSO")), torso_index + 1]
	stats["health"] = int(ceilf(unit_hp))
	stats["mass"] = fragment_mass
	stats["structural_mass"] = fragment_mass
	stats["length"] = fragment_length
	stats["radius"] = fragment_radius
	stats["speed"] = clampf(float(parent.stats.get("speed", 0.85)) * 1.05, 0.24, 2.2)
	stats["acceleration"] = clampf(float(parent.stats.get("acceleration", 2.5)) * 1.08, 0.6, 6.0)
	stats["drag"] = clampf(float(parent.stats.get("drag", 3.0)) + 0.4, 1.0, 7.2)
	stats["heat_capacity"] = 0.0
	stats["ai"] = _fracture_brood_ai_kind(parent)
	stats["group_count"] = 1
	stats["sequence"] = ["normal"]
	stats["projectile"] = false
	stats["module_effect"] = ""
	stats["role_switch"] = ""
	stats["deploy_cost"] = 0
	stats["bounty_reward"] = 0
	stats["insured_refund"] = 0
	stats["owner_destroy_penalty"] = 0
	stats["temporary_fracture_puppet"] = true
	stats["puppet_exception_group"] = true
	stats["fracture_parent_id"] = str(parent.get_instance_id())
	stats["fracture_origin_role"] = String(parent.role)
	stats["fracture_torso_index"] = torso_index
	stats["torso_visual_shape"] = String(parent.stats.get("torso_visual_shape", parent.stats.get("shape", "fragment")))
	stats["torso_visual_material"] = String(parent.stats.get("torso_visual_material", "metal"))
	stats["torso_stiffness_segment_count"] = 1
	stats["torso_stiffness_segment_hp"] = unit_hp
	stats["torso_break_threshold"] = float(torso_unit.get("threshold", parent.stats.get("torso_break_threshold", 0.0)))
	stats["torso_stiffness_segments"] = [{
		"name": String(torso_unit.get("name", "FRACTURE TORSO")),
		"length": fragment_length,
		"radius": fragment_radius,
		"unit_hp": unit_hp,
		"threshold": stats["torso_break_threshold"],
		"local_offset": Vector2.ZERO,
		"has_topology_offset": true,
	}]
	return stats


func _next_puppet_slot(player_id: int) -> int:
	var next_slot := 0
	for unit in active_units[player_id]["puppet"]:
		if _is_live_unit(unit):
			next_slot = maxi(next_slot, int(unit.get_meta("puppet_group_slot", -1)) + 1)
	return next_slot


func _spawn_torso_fragment_puppet(parent, torso_index: int) -> bool:
	if parent == null or not is_instance_valid(parent):
		return false
	if torso_index < 0:
		return false
	var spawned: Dictionary = {}
	if parent.has_meta("fracture_spawned_torso_units") and parent.get_meta("fracture_spawned_torso_units") is Dictionary:
		spawned = parent.get_meta("fracture_spawned_torso_units")
	var key := str(torso_index)
	if bool(spawned.get(key, false)):
		return false
	var torso_unit := _target_torso_stiffness_segment(parent, torso_index)
	if torso_unit.is_empty():
		return false
	var owner := int(parent.owner_id)
	var pos := _torso_unit_world_position(parent, torso_index)
	var stats := _torso_fragment_stats(parent, torso_index, torso_unit)
	var unit = _create_unit(owner, "puppet", stats, "P%d FRACTURE BROOD %d" % [owner, torso_index + 1], pos.x, pos.y)
	unit.set_meta("temporary_fracture_puppet", true)
	unit.set_meta("puppet_exception_group", true)
	unit.set_meta("fracture_parent_id", str(parent.get_instance_id()))
	unit.set_meta("fracture_torso_index", torso_index)
	var slot := _next_puppet_slot(owner)
	unit.set_meta("puppet_group_slot", slot)
	unit.set_meta("puppet_group_size", maxi(slot + 1, _puppet_group_size(owner)))
	unit.velocity = parent.velocity * 0.68 + Vector2(randf_range(-0.28, 0.28), randf_range(-0.22, 0.22))
	var group: Array = active_units[owner]["puppet"]
	group.append(unit)
	active_units[owner]["puppet"] = group
	spawned[key] = true
	parent.set_meta("fracture_spawned_torso_units", spawned)
	_spawn_hit_effect(unit, 1, "tear", false, "slash")
	return true


func _handle_torso_fracture_brood(target, torso_index: int, broken: Dictionary, torso_hp: Dictionary, max_part_hp: float) -> void:
	if target == null or not is_instance_valid(target):
		return
	var torso_units: Array = Array(target.stats.get("torso_stiffness_segments", []))
	var anchor := _soul_anchor_torso_index(target)
	var intent := _battle_runtime_facade().torso_fracture_brood_intent({
		"torso_count": torso_units.size(),
		"has_fracture_brood_module": _unit_has_fracture_brood_module(target),
		"torso_index": torso_index,
		"broken": broken,
		"torso_hp": torso_hp,
		"anchor": anchor,
		"max_part_hp": max_part_hp,
		"contact_unit_hp_min": CONTACT_UNIT_HP_MIN,
		"role": String(target.role),
		"has_soul": bool(target.stats.get("has_soul", false)),
	})
	if String(intent.get("action", "none")) == "none":
		return
	var next_broken: Dictionary = Dictionary(intent.get("broken", broken))
	var next_torso_hp: Dictionary = Dictionary(intent.get("torso_hp", torso_hp))
	if bool(intent.get("soul_anchor_protected", false)):
		target.set_meta("torso_unit_hp", next_torso_hp)
		target.set_meta("broken_torso_units", next_broken)
		target.set_meta("soul_anchor_torso_unit_index", int(intent.get("soul_anchor", anchor)))
	var spawned_count := 0
	for raw_index in Array(intent.get("spawn_indices", [])):
		if _spawn_torso_fragment_puppet(target, int(raw_index)):
			spawned_count += 1
	if spawned_count > 0:
		target.set_meta("broken_torso_units", next_broken)
		if bool(intent.get("soul_anchor_protected", false)):
			target.set_meta("torso_unit_hp", next_torso_hp)
		target.set_meta("part_fail_flash", 0.75)
		_show_battle_message("%s torso fracture: temporary puppet brood online" % target.unit_name, 1.05)


func _target_part_max_hp(target, attack_index: int, part_kind: String) -> float:
	if target == null or not is_instance_valid(target):
		return 0.0
	return maxf(6.0, float(target.max_health) * 0.12)


func _target_limb_max_hp(target, attack_index: int) -> float:
	if target == null or not is_instance_valid(target):
		return 0.0
	return maxf(10.0, float(target.max_health) * 0.18)


func _unit_damage_after_part_absorption(event: Dictionary, damage: int) -> int:
	return damage


func _stiffness_segment_group_for_hit(target, event: Dictionary) -> Dictionary:
	return {}


func _stiffness_segment_name_for_hit(target, event: Dictionary) -> String:
	var part_kind := String(event.get("target_part_kind", "core"))
	if part_kind == "torso":
		var torso_unit := _target_torso_stiffness_segment(target, int(event.get("target_torso_unit_index", -1)))
		if not torso_unit.is_empty():
			return String(torso_unit.get("name", "TORSO"))
		return "TORSO"
	if part_kind in ["core", "body", "barrier_tile"]:
		return "TORSO"
	var group := _stiffness_segment_group_for_hit(target, event)
	if group.is_empty():
		return "TORSO"
	if part_kind == "terminal":
		return "%s TERMINAL" % String(group.get("name", "LIMB"))
	return "%s LIMB" % String(group.get("name", "LIMB"))


func _target_projectile_material_resistance(target, event: Dictionary, damage_type: String) -> float:
	if target == null or not is_instance_valid(target):
		return 1.0
	var part_kind := String(event.get("target_part_kind", "core"))
	var group := _stiffness_segment_group_for_hit(target, event)
	var resistance_source: Dictionary = {}
	if not group.is_empty():
		match part_kind:
			"joint":
				resistance_source = group.get("joint_resist", {})
			"limb_muscle", "melee_sweep", "projectile_trace":
				resistance_source = group.get("limb_resist", {})
			"terminal":
				resistance_source = group.get("terminal_resist", {})
	if resistance_source.is_empty():
		if part_kind == "torso":
			var torso_unit := _target_torso_stiffness_segment(target, int(event.get("target_torso_unit_index", -1)))
			if not torso_unit.is_empty():
				resistance_source = torso_unit.get("resist", {})
		if resistance_source.is_empty():
			resistance_source = target.stats.get("torso_resist", target.stats.get("resistances", {}))
	return clampf(float(resistance_source.get(damage_type, 1.0)), PROJECTILE_PART_RESIST_MIN, PROJECTILE_PART_RESIST_MAX)


func _target_break_value_for_event(target, event: Dictionary) -> float:
	if target == null or not is_instance_valid(target):
		return 0.0
	var part_kind := String(event.get("target_part_kind", "core"))
	if part_kind == "torso":
		var torso_unit := _target_torso_stiffness_segment(target, int(event.get("target_torso_unit_index", -1)))
		if not torso_unit.is_empty():
			return clampf(float(torso_unit.get("threshold", target.stats.get("torso_break_threshold", CONTACT_UNIT_THRESHOLD_MIN))), CONTACT_UNIT_THRESHOLD_MIN, CONTACT_UNIT_THRESHOLD_MAX)
	var group := _stiffness_segment_group_for_hit(target, event)
	if not group.is_empty():
		if part_kind == "terminal":
			return clampf(float(group.get("terminal_damage_threshold", group.get("limb_break_threshold", CONTACT_UNIT_THRESHOLD_MIN))), 0.0, CONTACT_UNIT_THRESHOLD_MAX)
		if part_kind in ["joint", "limb", "limb_muscle", "melee_sweep", "projectile_trace"]:
			return clampf(float(group.get("limb_break_threshold", CONTACT_UNIT_THRESHOLD_MIN)), CONTACT_UNIT_THRESHOLD_MIN, CONTACT_UNIT_THRESHOLD_MAX)
	return clampf(float(target.stats.get("torso_break_threshold", target.stats.get("melee_stability_threshold", CONTACT_UNIT_THRESHOLD_MIN))), CONTACT_UNIT_THRESHOLD_MIN, CONTACT_UNIT_THRESHOLD_MAX)


func _break_value_adjustment_for_event(event: Dictionary) -> float:
	if bool(event.get("projectile", false)):
		return 1.0
	return float(_battle_hit_resolution_service().melee_type_adjustments(String(event.get("damage_type", "blunt"))).get("break_value_adjustment", 1.0))


func _knock_adjustment_for_event(event: Dictionary) -> float:
	if bool(event.get("projectile", false)):
		return 1.0
	return float(_battle_hit_resolution_service().melee_type_adjustments(String(event.get("damage_type", "blunt"))).get("knock_adjustment", 1.0))


func _damage_coefficient_for_gate(raw_damage: float, momentum: float) -> float:
	if momentum <= 0.001:
		return 0.0
	return maxf(0.0, raw_damage / momentum)


func _projectile_material_adjusted_damage(target, event: Dictionary, damage: int) -> int:
	# Temporary projectile-only material hook. Entity collision and melee never
	# use this path; they go through _apply_runtime_contact_damage().
	event["contact_gate_blocked"] = false
	if damage <= 0 or target == null or not is_instance_valid(target):
		return damage
	var damage_type := String(event.get("damage_type", "blunt"))
	var adjusted_damage := float(damage)
	var projectile_hit := bool(event.get("projectile", false)) or damage_type in PROJECTILE_DAMAGE_TYPES
	if projectile_hit:
		var resist_mult := _target_projectile_material_resistance(target, event, damage_type)
		event["projectile_material_resist"] = resist_mult
		adjusted_damage *= resist_mult
	event["damage_after_material_resist"] = adjusted_damage
	event["contact_gate_model"] = "projectile_material_only"
	return max(1, int(roundf(adjusted_damage)))


func _part_disabled(unit, attack_index: int) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	if unit.has_meta("severed_limbs") and unit.get_meta("severed_limbs") is Dictionary:
		var severed: Dictionary = unit.get_meta("severed_limbs")
		if bool(severed.get(str(clampi(attack_index, 0, ATTACK_GROUP_COUNT - 1)), false)):
			unit.set_meta("last_module_gate_reason", "limb severed")
			return true
	return _hardware_fault_action_blocked(unit, attack_index)


func _module_fail_feedback(unit, attack_index: int, reason: String = "limb severed") -> void:
	if unit == null or not is_instance_valid(unit):
		return
	if reason.strip_edges() == "":
		reason = "limb severed"
	_play_module_fail_sfx()
	_spawn_hit_effect(unit, 1, "laser", false, "web_snap")
	_show_battle_message("%s action %d cannot solve: %s" % [unit.unit_name, attack_index + 1, reason], 0.65)


func _play_module_fail_sfx() -> void:
	_play_sfx_wave("alarm", 172.0, 0.16, -9.0)


func _apply_local_hitstop(attacker, target, duration: float) -> void:
	if duration <= 0.0:
		return
	for unit in [attacker, target]:
		if unit != null and is_instance_valid(unit):
			unit.set_meta("local_hitstop_timer", maxf(float(unit.get_meta("local_hitstop_timer", 0.0)), duration))


func _unit_local_hitstop_delta(unit, delta: float) -> float:
	if unit == null or not is_instance_valid(unit):
		return delta
	var remaining := maxf(0.0, float(unit.get_meta("local_hitstop_timer", 0.0)))
	if remaining <= 0.0:
		return delta
	unit.set_meta("local_hitstop_timer", maxf(0.0, remaining - delta))
	unit.velocity *= 0.18
	return 0.0


func _apply_hitstop(damage_type: String, counter_tier: int, damage: int) -> void:
	var type_bonus := 0.0
	match damage_type:
		"blunt":
			type_bonus = 0.035
		"tear":
			type_bonus = 0.02
		"pierce":
			type_bonus = 0.012
		"chemical":
			type_bonus = 0.006
		"laser":
			type_bonus = 0.004
		"bullet":
			type_bonus = 0.008
	var stop := clampf(0.018 + float(counter_tier) * 0.012 + float(damage) / 520.0 + type_bonus, 0.018, 0.13)
	hitstop_timer = maxf(hitstop_timer, stop)


func _apply_projectile_reflection(attacker, event: Dictionary) -> void:
	if not event.has("direction"):
		return
	var damage_type := String(event.get("damage_type", "bullet"))
	var owner := int(attacker.owner_id)
	var reflectors: Array = []
	var candidates: Array = []
	for reflector in _friendly_units(owner):
		var reflector_live := _is_live_unit(reflector)
		var candidate_intent := _battle_projectile_lifecycle_service().projectile_reflector_candidate_intent({
			"is_self": reflector == attacker,
			"reflector_live": reflector_live,
			"reflect_projectiles": bool(reflector.stats.get("reflect_projectiles", false)) if reflector_live else false,
			"reflect_types": reflector.stats.get("reflect_types", []) if reflector_live else [],
			"damage_type": damage_type,
		})
		if not bool(candidate_intent.get("include", false)):
			continue
		var delta_vec := _mobius_delta_vec_between(attacker, reflector, 1.25)
		reflectors.append(reflector)
		candidates.append({
			"delta_vec": delta_vec,
			"distance": delta_vec.length(),
			"radius": float(reflector.stats.get("radius", 0.2)),
			"lane_delta": float(reflector.lane - attacker.lane),
			"reflect_bonus_range": float(reflector.stats.get("reflect_bonus_range", 0.35)),
			"reflect_power": float(reflector.stats.get("reflect_power", 0.25)),
		})
	var intent := _battle_projectile_lifecycle_service().projectile_reflection_intent({
		"direction": event.get("direction", Vector2.ZERO),
		"candidates": candidates,
		"range": float(event.get("range", 1.0)),
		"lane_range": float(event.get("lane_range", 0.2)),
		"attacker_facing": float(attacker.facing),
		"reflections": int(event.get("reflections", 0)),
	})
	if String(intent.get("action", "")) != "reflect":
		return
	var candidate_index := int(intent.get("candidate_index", -1))
	if candidate_index < 0 or candidate_index >= reflectors.size():
		return
	var best = reflectors[candidate_index]
	var reflected: Vector2 = intent.get("direction", Vector2.ZERO)
	if bool(intent.get("needs_fallback", false)) or reflected.length() <= 0.01:
		reflected = Vector2(float(attacker.facing), randf_range(-0.45, 0.45)).normalized()
	event["direction"] = reflected
	var existing_momentum := _event_momentum_magnitude(event, float(event.get("momentum", 0.0)))
	if existing_momentum > 0.0:
		_set_event_momentum_vector(event, reflected * existing_momentum, existing_momentum)
	var event_patch: Dictionary = Dictionary(intent.get("event_patch", {}))
	for key in event_patch.keys():
		event[key] = event_patch[key]
	_update_field_aura_visual(best, "repulsion", maxf(0.24, float(best.stats.get("radius", 0.16)) * 2.4), 1.5, 0.0)
	_spawn_hit_effect(best, 1, damage_type, false, String(event.get("projectile_style", "beam")))
	_show_battle_message("%s RICOCHET %s" % [best.unit_name, damage_type.to_upper()], 0.45)


func _target_projectile_shield_reflects(target, event: Dictionary) -> bool:
	var target_live := _is_live_unit(target)
	var shield_timer := float(target.get_meta("projectile_shield_timer", 0.0)) if target_live else 0.0
	var reflect_types: Array = target.get_meta("projectile_shield_types", target.stats.get("reflect_types", [])) if target_live else []
	return _battle_projectile_lifecycle_service().target_projectile_shield_reflects({
		"target_live": target_live,
		"shield_timer": shield_timer,
		"damage_type": String(event.get("damage_type", "bullet")),
		"reflect_types": reflect_types,
	})


func _reflect_projectile_from_target_shield(target, attacker, event: Dictionary) -> void:
	if not _is_live_unit(target):
		return
	var damage_type := String(event.get("damage_type", "bullet"))
	var power := maxf(0.1, float(target.get_meta("projectile_shield_power", target.stats.get("reflect_power", 0.55))))
	var event_copy := event.duplicate(true)
	var fallback_dir := Vector2(float(target.facing), randf_range(-0.38, 0.38)).normalized()
	var attacker_delta := Vector2.ZERO
	if attacker != null and is_instance_valid(attacker):
		attacker_delta = _mobius_delta_vec_between(target, attacker, 1.25)
	var intent := _battle_projectile_lifecycle_service().target_shield_reflection_intent({
		"target_live": true,
		"event": event,
		"power": power,
		"owner_id": int(target.owner_id),
		"source_name": "%s shield" % target.unit_name,
		"bonus_range": float(target.get_meta("projectile_shield_bonus_range", target.stats.get("reflect_bonus_range", 0.4))),
		"fallback_direction": fallback_dir,
		"attacker_delta": attacker_delta,
	})
	if String(intent.get("action", "")) != "reflect":
		return
	var event_patch: Dictionary = Dictionary(intent.get("event_patch", {}))
	for key in event_patch.keys():
		event_copy[key] = event_patch[key]
	var reflected_dir: Vector2 = intent.get("direction", event_copy.get("direction", fallback_dir))
	event_copy["direction"] = reflected_dir
	var reflected_momentum := _projectile_momentum_for_event(event_copy)
	if reflected_momentum > 0.0:
		_set_event_momentum_vector(event_copy, reflected_dir * reflected_momentum, reflected_momentum)
	_spawn_hit_effect(target, 2, damage_type, false, String(event.get("projectile_style", "shield")))
	_update_field_aura_visual(target, "repulsion", maxf(0.28, float(target.stats.get("radius", 0.2)) * 2.4), 2.0, 0.0)
	_show_battle_message("%s AEGIS REFLECT %s" % [target.unit_name, damage_type.to_upper()], 0.55)
	for reflected_target in _enemy_units(int(target.owner_id)):
		var reflected_target_live := _is_live_unit(reflected_target)
		var base_target_intent := _battle_projectile_lifecycle_service().target_shield_reflected_target_intent({
			"is_attacker": reflected_target == attacker,
			"is_source_target": reflected_target == target,
			"reflected_target_live": reflected_target_live,
		})
		if not bool(base_target_intent.get("include", false)):
			continue
		var reflected_delta := _mobius_delta_vec_between(target, reflected_target, 1.25)
		var target_radius := float(reflected_target.stats.get("radius", 0.2))
		var reflected_target_intent := _battle_projectile_lifecycle_service().target_shield_reflected_target_intent({
			"is_attacker": false,
			"is_source_target": false,
			"reflected_target_live": reflected_target_live,
			"range": float(event_copy["range"]),
			"lane_range": float(event_copy["lane_range"]),
			"target_radius": target_radius,
			"reflected_delta": reflected_delta,
			"reflected_direction": reflected_dir,
		})
		if not bool(reflected_target_intent.get("include", false)):
			continue
		var final_damage := maxi(1, int(roundf(float(event_copy["damage"]) * _vulnerability_multiplier(reflected_target, event_copy))))
		final_damage = _projectile_material_adjusted_damage(reflected_target, event_copy, final_damage)
		var block_intent := _battle_projectile_lifecycle_service().projectile_hit_block_intent({
			"final_damage": final_damage,
			"contact_gate_blocked": bool(event_copy.get("contact_gate_blocked", false)),
		})
		var blocked := bool(block_intent.get("blocked", false))
		_spawn_hit_effect(reflected_target, _counter_tier_for_hit(reflected_target, damage_type), damage_type, blocked, String(event_copy.get("projectile_style", "shield")))
		if blocked:
			break
		_apply_hitstop(damage_type, 1, final_damage)
		if reflected_target.take_hit(final_damage, "armor", int(target.owner_id), damage_type, "projectile"):
			_handle_unit_killed(reflected_target, int(target.owner_id))
		break


func _apply_explosion_damage(attacker, primary_target, event: Dictionary) -> Array:
	var killed_units: Array = []
	if attacker == null or not is_instance_valid(attacker):
		return killed_units
	var owner := int(attacker.owner_id)
	var explosion_request := _battle_projectile_lifecycle_service().explosion_request_intent({
		"event": event,
	})
	if not bool(explosion_request.get("applies", false)):
		return killed_units
	var radius := float(explosion_request.get("radius", 0.08))
	var damage := int(explosion_request.get("damage", 0))
	var damage_type := String(explosion_request.get("damage_type", "blunt"))
	var explosion_style := String(explosion_request.get("explosion_style", event.get("explosion_style", "explosive")))
	var attacker_explosion_position := Vector2(attacker.ring_pos, attacker.lane)
	var primary_target_valid := primary_target != null and is_instance_valid(primary_target)
	var primary_explosion_position := attacker_explosion_position
	if primary_target_valid:
		primary_explosion_position = Vector2(primary_target.ring_pos, primary_target.lane)
	var explosion_center := _battle_projectile_lifecycle_service().explosion_center_position({
		"attacker_position": attacker_explosion_position,
		"primary_target_valid": primary_target_valid,
		"primary_target_position": primary_explosion_position,
	})
	var center_position: Vector2 = explosion_center.get("position", attacker_explosion_position)
	var center_ring: float = center_position.x
	var center_lane: float = center_position.y
	var initial_effect_anchor := _battle_projectile_lifecycle_service().explosion_initial_effect_anchor_intent({
		"primary_target_valid": primary_target_valid,
	})
	var initial_effect_target = primary_target if String(initial_effect_anchor.get("source", "attacker")) == "primary_target" else attacker
	_spawn_hit_effect(initial_effect_target, 2, damage_type, false, String(event.get("explosion_style", "blast")))
	for target in _enemy_units(owner):
		var target_candidate_intent := _battle_projectile_lifecycle_service().explosion_target_candidate_intent({
			"target_live": _is_live_unit(target),
			"is_primary_target": target == primary_target,
		})
		if not bool(target_candidate_intent.get("include", false)):
			continue
		var blast_delta := _mobius_delta_points(center_ring, center_lane, target.ring_pos, target.lane)
		var target_radius := float(target.stats.get("radius", 0.2))
		var intent := _battle_projectile_lifecycle_service().explosion_damage_intent({
			"radius": radius,
			"target_radius": target_radius,
			"blast_delta": blast_delta,
			"fallback_direction": _event_direction_vector(attacker, target, event, Vector2.RIGHT),
			"projectile_momentum": _projectile_momentum_for_event(event),
			"damage_type": damage_type,
			"explosion_style": explosion_style,
			"target_position": Vector2(target.ring_pos, target.lane),
		})
		if not bool(intent.get("applies", false)):
			continue
		var event_copy := event.duplicate(true)
		var event_patch: Dictionary = Dictionary(intent.get("event_patch", {}))
		for key in event_patch.keys():
			event_copy[key] = event_patch[key]
		var falloff := float(intent.get("falloff", 1.0))
		var blast_direction: Vector2 = intent.get("blast_direction", Vector2.RIGHT)
		var blast_momentum := float(intent.get("blast_momentum", 0.0))
		_set_event_momentum_vector(event_copy, blast_direction * blast_momentum, blast_momentum)
		var final_damage := maxi(1, int(roundf(float(damage) * falloff * _vulnerability_multiplier(target, event_copy))))
		final_damage = _projectile_material_adjusted_damage(target, event_copy, final_damage)
		var block_intent := _battle_projectile_lifecycle_service().projectile_hit_block_intent({
			"final_damage": final_damage,
			"contact_gate_blocked": bool(event_copy.get("contact_gate_blocked", false)),
		})
		var blocked := bool(block_intent.get("blocked", false))
		if not blocked:
			final_damage = _apply_combo_hit_scaling(attacker, target, event_copy, final_damage)
			if final_damage < 0:
				continue
		_spawn_hit_effect(target, _counter_tier_for_hit(target, damage_type), damage_type, blocked, String(event.get("explosion_style", "blast")))
		var stagger_event := event.duplicate(true)
		var stagger_patch: Dictionary = Dictionary(intent.get("stagger_patch", {}))
		for key in stagger_patch.keys():
			stagger_event[key] = stagger_patch[key]
		_set_event_momentum_vector(stagger_event, blast_direction * blast_momentum, blast_momentum)
		stagger_event["target_part_index"] = int(event_copy.get("target_part_index", -1))
		_apply_projectile_momentum_stagger(attacker, target, stagger_event, falloff)
		if blocked:
			continue
		_apply_hitstop(damage_type, 1, final_damage)
		if target.take_hit(final_damage, String(event.get("state", "normal")), owner, damage_type, "field"):
			killed_units.append(target)
	return killed_units


func _apply_takeover_status(attacker, target, event: Dictionary) -> void:
	if not bool(event.get("takeover_on_hit", false)):
		return
	if not _unit_is_mech_physics_subject(target) or int(attacker.owner_id) == int(target.owner_id):
		return
	var owner := int(attacker.owner_id)
	var base_required := maxf(0.75, float(event.get("takeover_seconds", attacker.stats.get("takeover_seconds", 4.0))))
	var takeover_power := maxf(0.12, float(event.get("takeover_power", attacker.stats.get("takeover_power", 1.0))))
	var required := _security_adjusted_seconds(base_required, target, takeover_power, 0.75)
	var dps := maxf(0.0, float(event.get("takeover_damage_rate", attacker.stats.get("takeover_damage_rate", 4.0))))
	var intent := _battle_hit_resolution_service().status_tick_intent({
		"kind": "apply_takeover",
		"owner": owner,
		"required": required,
		"dps": dps,
		"damage_type": String(event.get("takeover_damage_type", attacker.stats.get("takeover_damage_type", "laser"))),
		"current_timer": float(target.get_meta("takeover_timer", 0.0)),
	})
	target.set_meta("takeover_owner", int(intent.get("owner", owner)))
	target.set_meta("takeover_required", float(intent.get("required", required)))
	target.set_meta("takeover_dps", float(intent.get("dps", dps)))
	target.set_meta("takeover_damage_type", String(intent.get("damage_type", "laser")))
	target.set_meta("takeover_timer", float(intent.get("timer", 0.12)))
	target.set_meta("takeover_warning_timer", float(intent.get("warning_timer", 0.55)))
	_show_battle_message("NTR LINK %.1fs / SEC %.2f: %s" % [required, _data_security_value(target), target.unit_name], 0.55)


func _chemical_dot_applies(event: Dictionary) -> bool:
	if not _is_chemical_projectile_event(event):
		return false
	return float(event.get("chemical_dot_mult", CHEMICAL_DOT_DEFAULT_MULT)) > 0.0 and float(event.get("chemical_dot_duration", CHEMICAL_DOT_DEFAULT_DURATION)) > 0.0


func _apply_chemical_dot_status(attacker, target, event: Dictionary, total_damage: int) -> void:
	if not _is_live_unit(target) or total_damage <= 0:
		return
	var intent := _battle_hit_resolution_service().status_tick_intent({
		"kind": "apply_chemical_dot",
		"duration": float(event.get("chemical_dot_duration", CHEMICAL_DOT_DEFAULT_DURATION)),
		"total_damage": total_damage,
		"no_stack": bool(event.get("chemical_dot_no_stack", false)),
		"current_dps": float(target.get_meta("chemical_dot_dps", 0.0)),
		"current_timer": float(target.get_meta("chemical_dot_timer", 0.0)),
		"bank": float(target.get_meta("chemical_dot_bank", 0.0)),
	})
	var duration := float(intent.get("duration", clampf(float(event.get("chemical_dot_duration", CHEMICAL_DOT_DEFAULT_DURATION)), 0.6, 6.0)))
	target.set_meta("chemical_dot_owner", int(attacker.owner_id))
	target.set_meta("chemical_dot_timer", float(intent.get("timer", maxf(float(target.get_meta("chemical_dot_timer", 0.0)), duration))))
	target.set_meta("chemical_dot_dps", float(intent.get("dps", 0.0)))
	target.set_meta("chemical_dot_bank", float(intent.get("bank", 0.0)))
	target.set_meta("chemical_dot_fx_timer", float(intent.get("fx_timer", 0.05)))
	_show_battle_message("%s CORRODING %.1fs" % [target.unit_name, duration], 0.45)


func _update_chemical_dot_status(unit, delta: float) -> void:
	if not unit.has_meta("chemical_dot_timer"):
		return
	var intent := _battle_hit_resolution_service().status_tick_intent({
		"kind": "chemical_dot",
		"timer": float(unit.get_meta("chemical_dot_timer", 0.0)),
		"dps": float(unit.get_meta("chemical_dot_dps", 0.0)),
		"bank": float(unit.get_meta("chemical_dot_bank", 0.0)),
		"fx_timer": float(unit.get_meta("chemical_dot_fx_timer", 0.0)),
		"delta": delta,
	})
	unit.set_meta("chemical_dot_timer", float(intent.get("timer", 0.0)))
	if not bool(intent.get("active", false)):
		unit.set_meta("chemical_dot_dps", 0.0)
		unit.set_meta("chemical_dot_bank", 0.0)
		return
	var owner := int(unit.get_meta("chemical_dot_owner", int(unit.owner_id)))
	var dps := float(intent.get("dps", 0.0))
	unit.set_meta("chemical_dot_dps", dps)
	if dps <= 0.0:
		return
	var damage := int(intent.get("damage", 0))
	unit.set_meta("chemical_dot_bank", float(intent.get("bank", 0.0)))
	if damage <= 0:
		return
	if bool(intent.get("spawn_fx", false)):
		_spawn_hit_effect(unit, 1, "chemical", false, "spray")
	unit.set_meta("chemical_dot_fx_timer", float(intent.get("fx_timer", 0.0)))
	if unit.take_hit(damage, "active", owner, "chemical", "projectile"):
		_handle_unit_killed(unit, owner)


func _update_takeover_status(unit, delta: float) -> void:
	if not unit.has_meta("takeover_owner"):
		return
	var owner := int(unit.get_meta("takeover_owner", int(unit.owner_id)))
	var intent := _battle_hit_resolution_service().status_tick_intent({
		"kind": "takeover",
		"owner": owner,
		"unit_owner": int(unit.owner_id),
		"required": float(unit.get_meta("takeover_required", 4.0)),
		"timer": float(unit.get_meta("takeover_timer", 0.0)),
		"warning_timer": float(unit.get_meta("takeover_warning_timer", 0.0)),
		"dps": float(unit.get_meta("takeover_dps", 0.0)),
		"bank": float(unit.get_meta("takeover_damage_bank", 0.0)),
		"damage_type": String(unit.get_meta("takeover_damage_type", "laser")),
		"delta": delta,
	})
	if not bool(intent.get("active", false)):
		unit.set_meta("takeover_timer", float(intent.get("timer", 0.0)))
		return
	unit.set_meta("takeover_timer", float(intent.get("timer", 0.0)))
	unit.set_meta("takeover_warning_timer", float(intent.get("warning_timer", 0.12)))
	unit.set_meta("takeover_damage_bank", float(intent.get("bank", 0.0)))
	var damage := int(intent.get("damage", 0))
	if damage > 0:
		var damage_type := String(intent.get("damage_type", unit.get_meta("takeover_damage_type", "laser")))
		var event := {"damage_type": damage_type, "projectile": damage_type in PROJECTILE_DAMAGE_TYPES}
		var final_damage := _projectile_material_adjusted_damage(unit, event, damage)
		var blocked := final_damage <= 0 or bool(event.get("contact_gate_blocked", false))
		_spawn_hit_effect(unit, 1, damage_type, blocked, "hack")
		if not blocked and unit.take_hit(final_damage, "active", owner, damage_type, "field"):
			_handle_unit_killed(unit, owner)
			return
	if bool(intent.get("complete", false)):
		_defect_unit_to_owner(unit, owner, "NEURAL TAKEOVER", false)


func _update_unit_status_meta(unit, delta: float) -> void:
	for key in ["morph_timer", "trap_cooldown_timer", "hack_warning_timer", "jam_warning_timer", "jammed_timer", "part_fail_flash", "slow_timer", "field_damage_boost_timer", "vuln_timer", "served_ball_timer", "active_cool_lock", "takeover_warning_timer", "lease_warn_timer", "annuity_tick", "projectile_shield_timer", "support_armor_timer", "speed_lane_timer", "shield_flash_timer", "rear_heat_flash_timer", "star_soul_buff_timer", "star_soul_debuff_timer", "star_soul_damage_debuff_timer", "star_soul_break_value_buff_timer", "terrain_mechanism_status_timer"]:
		if unit.has_meta(key):
			unit.set_meta(key, maxf(0.0, float(unit.get_meta(key, 0.0)) - delta))
	if float(unit.get_meta("support_armor_timer", 0.0)) <= 0.0 and float(unit.get_meta("support_armor_hp", 0.0)) > 0.0:
		unit.set_meta("support_armor_hp", 0.0)
	if unit.has_meta("disabled_parts"):
		var disabled: Dictionary = unit.get_meta("disabled_parts", {})
		for part_key in disabled.keys():
			var next_time := maxf(0.0, float(disabled[part_key]) - delta)
			if next_time <= 0.0:
				disabled.erase(part_key)
			else:
				disabled[part_key] = next_time
		unit.set_meta("disabled_parts", disabled)
	if float(unit.get_meta("slow_timer", 0.0)) > 0.0:
		unit.velocity *= clampf(float(unit.get_meta("slow_mult", 0.82)), 0.25, 1.0)
	if float(unit.get_meta("jammed_timer", 0.0)) > 0.0:
		unit.velocity = unit.velocity.move_toward(Vector2.ZERO, 2.4 * delta)
	_update_chemical_dot_status(unit, delta)
	_update_takeover_status(unit, delta)


func _defect_unit_to_owner(unit, new_owner: int, reason: String, full_restore: bool = true) -> bool:
	if unit == null or not is_instance_valid(unit) or not [1, 2].has(new_owner):
		return false
	var old_owner := int(unit.owner_id)
	if old_owner == new_owner and _is_live_unit(unit):
		return false
	_detach_unit_reference(unit)
	unit.owner_id = new_owner
	var role_key := String(unit.role)
	if role_key == "barrier":
		role_key = "puppet"
	if role_key == "hero" and _is_live_unit(active_units[new_owner]["hero"]):
		role_key = "puppet"
	unit.role = role_key
	unit.active = true
	unit.visible = true
	unit.health = unit.max_health if full_restore else maxi(1, int(roundf(float(unit.max_health) * 0.48)))
	unit.heat = 0.0
	unit.overheated = false
	unit.velocity = Vector2.ZERO
	unit.stats["primary_color"] = _team_primary_color(new_owner)
	unit.stats["accent_color"] = _team_accent_color(new_owner)
	unit.primary_color = unit.stats["primary_color"]
	unit.accent_color = unit.stats["accent_color"]
	for meta_key in ["takeover_owner", "takeover_timer", "takeover_required", "takeover_dps", "takeover_damage_bank", "chemical_dot_owner", "chemical_dot_timer", "chemical_dot_dps", "chemical_dot_bank", "chemical_dot_fx_timer", "jammed_timer", "hack_warning_timer", "disabled_parts", "vuln_timer"]:
		if unit.has_meta(meta_key):
			unit.remove_meta(meta_key)
	if not all_units.has(unit):
		all_units.append(unit)
	_assign_unit_role(unit, role_key)
	if unit.has_method("_apply_topology_visuals"):
		unit._apply_topology_visuals()
	if unit.has_method("_refresh_visuals"):
		unit._refresh_visuals()
	_spawn_hit_effect(unit, 2, "laser", false, "hack")
	_show_battle_message("%s: P%d -> P%d %s" % [reason, old_owner, new_owner, unit.unit_name], 1.0)
	return true


func _unit_role_is_mech(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	return String(unit.role) in ["hero", "puppet"] or _unit_is_star_soul(unit)


func _unit_is_star_soul(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	return String(unit.role) == "star_soul" or bool(unit.get_meta("star_soul", false)) or bool(unit.stats.get("star_soul", false))


func _unit_uses_heat(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	return String(unit.role) == "hero"


func _unit_is_mech_physics_subject(unit) -> bool:
	if unit == null or not is_instance_valid(unit):
		return false
	if bool(unit.get_meta("detached_barrier_piece", false)):
		return true
	if _barrier_has_map_tiles(unit):
		return true
	return _unit_role_is_mech(unit)


func _counter_tier_for_hit(target, damage_type: String) -> int:
	if target == null or not is_instance_valid(target):
		return 0
	if damage_type in PROJECTILE_DAMAGE_TYPES:
		return 0
	var counters: Dictionary = target.stats.get("counter_tiers", {})
	return clampi(int(counters.get(damage_type, 0)), 0, 3)


func _apply_module_hit_effect(attacker, target, event: Dictionary) -> void:
	var module_effect := String(event.get("module_effect", ""))
	var projectile_style := String(event.get("projectile_style", ""))
	var has_web := projectile_style == "web" or float(event.get("web_strength", 0.0)) > 0.0
	var has_blind := projectile_style == "blind" or float(event.get("blind_radius", 0.0)) > 0.0
	if module_effect == "" and not has_web and not has_blind:
		return
	var pull_direction := _event_direction_vector(attacker, target, event, Vector2(float(attacker.facing), 0.0))
	var attacker_mass := maxf(1.0, float(attacker.stats.get("mass", 1.0)))
	var target_mass := maxf(1.0, float(target.stats.get("mass", 1.0)))
	if module_effect in ["capture", "tether", "entangle"]:
		var pull_power := float(event.get("pull_power", 0.16))
		var attacker_pull := clampf(target_mass / (attacker_mass + target_mass), 0.15, 0.85)
		var target_pull := clampf(attacker_mass / (attacker_mass + target_mass), 0.15, 0.85)
		_apply_unit_displacement(attacker, pull_direction, pull_power * attacker_pull)
		_apply_unit_displacement(target, -pull_direction, pull_power * target_pull)
		target.velocity = target.velocity.move_toward(Vector2.ZERO, 2.5 * pull_power)
	elif module_effect == "chain_recall":
		_apply_unit_displacement(attacker, pull_direction, 0.06)
	elif module_effect == "barrier_break" and String(target.role) == "barrier":
		_add_unit_heat_event(target, 16.0, ["external"], "barrier_break_heat")
	elif module_effect in ["boomerang_recall", "group_throw"]:
		target.velocity += pull_direction * 0.27
		attacker.set_meta("receiver_flash", 0.32)
	elif module_effect == "guided_eject":
		target.velocity += pull_direction * 0.36
	if has_web:
		_apply_web_tether_effect(attacker, target, event, pull_direction, attacker_mass, target_mass)
	if has_blind:
		_spawn_blind_zone(int(attacker.owner_id), target.ring_pos, target.lane, float(event.get("blind_radius", 0.62)), float(event.get("blind_duration", 2.4)), float(event.get("blind_strength", 0.55)))


func _apply_web_tether_effect(attacker, target, event: Dictionary, pull_direction: Vector2, attacker_mass: float, target_mass: float) -> void:
	var strength := maxf(0.01, float(event.get("web_strength", attacker.stats.get("web_strength", 0.18))))
	var break_force := maxf(0.08, float(event.get("web_break_force", attacker.stats.get("web_break_force", 0.56))))
	var distance := absf(_ring_delta(attacker.ring_pos, target.ring_pos))
	var lane_distance := absf(attacker.lane - target.lane)
	var mass_stress := absf(attacker_mass - target_mass) / maxf(1.0, attacker_mass + target_mass)
	var tension := strength * (0.72 + distance * 0.55 + lane_distance * 0.36 + mass_stress * 0.42)
	if tension > break_force:
		_spawn_hit_effect(target, 1, "blunt", false, "web_snap")
		_show_battle_message("WEB LINE SNAP", 0.45)
		return
	var mode := String(event.get("web_pull_mode", attacker.stats.get("web_pull_mode", "target_to_self")))
	var pull_scale := strength * 0.72
	if not _unit_is_mech_physics_subject(target):
		_apply_unit_displacement(attacker, pull_direction, pull_scale)
		attacker.velocity += pull_direction * strength * 0.66
		_show_battle_message("WEB ANCHOR: barrier topology holds", 0.5)
	elif mode == "self_to_anchor" or (mode == "" and String(target.role) == "barrier"):
		_apply_unit_displacement(attacker, pull_direction, pull_scale)
		attacker.velocity += pull_direction * strength * 0.66
	elif mode == "mass_duel":
		var attacker_pull := clampf(target_mass / (attacker_mass + target_mass), 0.1, 0.9)
		var target_pull := clampf(attacker_mass / (attacker_mass + target_mass), 0.1, 0.9)
		_apply_unit_displacement(attacker, pull_direction, pull_scale * attacker_pull)
		_apply_unit_displacement(target, -pull_direction, pull_scale * target_pull)
	else:
		_apply_unit_displacement(target, -pull_direction, pull_scale)
		target.velocity = target.velocity.move_toward(Vector2.ZERO, 3.0 * strength)


func _web_targets_for(attacker, event: Dictionary) -> Array:
	if not _is_live_unit(attacker):
		return []
	var filter := String(event.get("web_target_filter", "all")).to_lower()
	var candidates := _field_targets_for(int(attacker.owner_id), filter)
	var result: Array = []
	for target in candidates:
		var intent := _battle_projectile_lifecycle_service().web_target_candidate_intent({
			"attacker_live": true,
			"target_live": _is_live_unit(target),
			"is_self": target == attacker,
		})
		if not bool(intent.get("include", false)):
			continue
		result.append(target)
	return result


func _first_web_tether_impact(attacker, event: Dictionary) -> Dictionary:
	if not _is_live_unit(attacker):
		return {}
	var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(attacker)
	direction = direction.normalized()
	var best: Dictionary = {}
	var best_distance := 999999.0
	var targets := _web_targets_for(attacker, event)
	if _unit_uses_direct_runtime_topology(attacker) and _event_is_explicit_gun_activation(event):
		var gpu_impact := _first_projectile_impact_gpu(attacker, event, targets, true, true)
		if not gpu_impact.is_empty():
			return gpu_impact
	else:
		var hit_candidates: Array = []
		var hit_payloads: Array = []
		for target_index in range(targets.size()):
			var target = targets[target_index]
			var hit := _attack_part_hit(attacker, target, event)
			var hit_position: Vector2 = hit.get("position", Vector2(target.ring_pos, target.lane)) if not hit.is_empty() else Vector2(target.ring_pos, target.lane)
			var intent := _battle_projectile_lifecycle_service().web_impact_candidate_intent({
				"has_hit": not hit.is_empty(),
				"candidate_index": hit_payloads.size(),
				"target_index": target_index,
				"position": hit_position,
				"projection": _projectile_projection_from(attacker, hit_position, direction) if not hit.is_empty() else 0.0,
			})
			if not bool(intent.get("include", false)):
				continue
			hit_payloads.append({
				"target": target,
				"hit": hit,
				"position": hit_position,
			})
			hit_candidates.append(intent)
		var selection := _battle_projectile_lifecycle_service().web_impact_selection(hit_candidates)
		var selected_index := int(selection.get("candidate_index", -1))
		if bool(selection.get("has_hit", false)) and selected_index >= 0 and selected_index < hit_payloads.size():
			var payload: Dictionary = hit_payloads[selected_index]
			best_distance = float(selection.get("distance", 999999.0))
			best = {
				"target": payload.get("target", null),
				"hit": payload.get("hit", {}),
				"position": payload.get("position", Vector2.ZERO),
				"distance": best_distance,
			}
	return best


func _web_boundary_anchor_for_event(attacker, event: Dictionary) -> Dictionary:
	var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	var intent := _battle_projectile_lifecycle_service().web_boundary_anchor_intent({
		"attacker_live": _is_live_unit(attacker),
		"anchor_enabled": bool(event.get("web_anchor_swing", true)),
		"direction": direction,
		"attacker_position": Vector2(attacker.ring_pos, attacker.lane) if _is_live_unit(attacker) else Vector2.ZERO,
		"range": float(event.get("range", event.get("projectile_range", STANDARD_WEB_TETHER_RANGE_M))),
		"ring_length": RING_LENGTH,
		"half_height": BATTLE_HALF_HEIGHT,
	})
	if String(intent.get("action", "")) != "anchor":
		return {}
	return {
		"position": intent.get("position", Vector2.ZERO),
		"distance": float(intent.get("distance", 0.0)),
		"boundary": String(intent.get("boundary", "")),
	}


func _web_trace_event(base_event: Dictionary, impact_position: Vector2) -> Dictionary:
	return _projectile_runtime_service().web_trace_event(base_event, impact_position)


func _start_web_tether(attacker, target, event: Dictionary, hit_position: Vector2) -> void:
	if not _is_live_unit(attacker) or not _is_live_unit(target):
		return
	active_web_tethers.append({
		"attacker": attacker,
		"target": target,
		"timer": maxf(0.1, float(event.get("web_duration", STANDARD_WEB_TETHER_DURATION))),
		"strength": maxf(0.01, float(event.get("web_strength", STANDARD_WEB_TETHER_STRENGTH))),
		"break_force": maxf(0.08, float(event.get("web_break_force", STANDARD_WEB_TETHER_BREAK_FORCE))),
		"mode": String(event.get("web_pull_mode", "mass_duel")),
	})
	_spawn_projectile_trace(attacker, _web_trace_event(event, hit_position))
	_spawn_hit_effect(target, 1, "blunt", false, "web_snap", hit_position)
	_show_battle_message("WEB TETHER" if not _ui_is_zh() else "蛛丝牵引", 0.45)


func _start_web_boundary_swing(attacker, event: Dictionary, anchor: Vector2) -> void:
	if not _is_live_unit(attacker):
		return
	active_web_swings.append({
		"attacker": attacker,
		"anchor": anchor,
		"timer": maxf(0.1, float(event.get("web_duration", STANDARD_WEB_TETHER_DURATION))),
		"strength": maxf(0.01, float(event.get("web_strength", STANDARD_WEB_TETHER_STRENGTH))),
		"break_force": maxf(0.08, float(event.get("web_break_force", STANDARD_WEB_TETHER_BREAK_FORCE))),
		"uses_melee_collision": bool(event.get("web_swing_uses_melee_collision", true)),
	})
	_spawn_projectile_trace(attacker, _web_trace_event(event, anchor))
	_show_battle_message("WEB SWING" if not _ui_is_zh() else "蛛丝摆荡", 0.45)


func _fire_runtime_web_tether(attacker, event: Dictionary) -> bool:
	if not _is_live_unit(attacker):
		return false
	event["projectile"] = true
	event["projectile_only"] = true
	event["projectile_behavior"] = "web_tether"
	event["projectile_style"] = "web"
	event["travel_path"] = "tether"
	event["projectile_damage_type"] = "blunt"
	event["damage_type"] = "blunt"
	event["non_damage"] = true
	if not bool(event.get("ammo_consumed", false)) and not _consume_ammo_for_event(attacker, event):
		return false
	event["ammo_consumed"] = true
	var hit := _first_web_tether_impact(attacker, event)
	var anchor := _web_boundary_anchor_for_event(attacker, event)
	var direction: Vector2 = event.get("direction", _unit_forward_vector(attacker))
	if direction.length() <= 0.01:
		direction = _unit_forward_vector(attacker)
	var target = hit.get("target", null) if not hit.is_empty() else null
	var fire_intent := _battle_projectile_lifecycle_service().web_fire_intent({
		"target_hit": not hit.is_empty() and _is_live_unit(target),
		"boundary_anchor": not anchor.is_empty(),
		"anchor_position": anchor.get("position", Vector2(attacker.ring_pos, attacker.lane)),
		"direction": direction,
		"fallback_direction": _unit_forward_vector(attacker),
		"attacker_position": Vector2(attacker.ring_pos, attacker.lane),
		"range": float(event.get("range", STANDARD_WEB_TETHER_RANGE_M)),
		"ring_length": RING_LENGTH,
		"half_height": BATTLE_HALF_HEIGHT,
	})
	match String(fire_intent.get("action", "")):
		"target_tether":
			_start_web_tether(attacker, target, event, hit.get("position", Vector2(target.ring_pos, target.lane)))
			return true
		"boundary_swing":
			_start_web_boundary_swing(attacker, event, fire_intent.get("anchor", anchor.get("position", Vector2(attacker.ring_pos, attacker.lane))))
			return true
		_:
			_spawn_projectile_trace(attacker, _web_trace_event(event, fire_intent.get("miss_position", Vector2(attacker.ring_pos, attacker.lane))))
			_show_battle_message("WEB MISS" if not _ui_is_zh() else "蛛丝落空", 0.35)
	return true


func _update_web_tethers(delta: float) -> void:
	for index in range(active_web_tethers.size() - 1, -1, -1):
		var tether: Dictionary = active_web_tethers[index]
		var attacker = tether.get("attacker", null)
		var target = tether.get("target", null)
		var attacker_live := _is_live_unit(attacker)
		var target_live := _is_live_unit(target)
		var delta_vec := Vector2(_ring_delta(attacker.ring_pos, target.ring_pos), target.lane - attacker.lane) if attacker_live and target_live else Vector2.ZERO
		var intent := _battle_projectile_lifecycle_service().web_tether_tick_intent({
			"attacker_live": attacker_live,
			"target_live": target_live,
			"timer": float(tether.get("timer", 0.0)),
			"delta": delta,
			"delta_vec": delta_vec,
			"strength": float(tether.get("strength", STANDARD_WEB_TETHER_STRENGTH)),
			"break_force": float(tether.get("break_force", STANDARD_WEB_TETHER_BREAK_FORCE)),
			"attacker_mass": maxf(1.0, float(attacker.stats.get("mass", 1.0))) if attacker_live else 1.0,
			"target_mass": maxf(1.0, float(target.stats.get("mass", 1.0))) if target_live else 1.0,
			"mode": String(tether.get("mode", "mass_duel")),
			"accel_mult": STANDARD_WEB_TETHER_ACCEL_MULT,
		})
		match String(intent.get("action", "")):
			"remove":
				active_web_tethers.remove_at(index)
				continue
			"snap":
				if target_live:
					_spawn_hit_effect(target, 1, "blunt", false, "web_snap", Vector2(target.ring_pos, target.lane))
				active_web_tethers.remove_at(index)
				continue
		if attacker_live:
			attacker.velocity += intent.get("attacker_velocity_delta", Vector2.ZERO)
		if target_live:
			target.velocity += intent.get("target_velocity_delta", Vector2.ZERO)
		tether["timer"] = float(intent.get("timer", tether.get("timer", 0.0)))
		active_web_tethers[index] = tether


func _update_web_swings(delta: float) -> void:
	for index in range(active_web_swings.size() - 1, -1, -1):
		var swing: Dictionary = active_web_swings[index]
		var attacker = swing.get("attacker", null)
		var attacker_live := _is_live_unit(attacker)
		var anchor: Vector2 = swing.get("anchor", Vector2(attacker.ring_pos, attacker.lane)) if attacker_live else Vector2.ZERO
		var to_anchor := Vector2(_ring_delta(attacker.ring_pos, anchor.x), anchor.y - attacker.lane) if attacker_live else Vector2.ZERO
		var intent := _battle_projectile_lifecycle_service().web_swing_tick_intent({
			"attacker_live": attacker_live,
			"timer": float(swing.get("timer", 0.0)),
			"delta": delta,
			"to_anchor": to_anchor,
			"strength": float(swing.get("strength", STANDARD_WEB_TETHER_STRENGTH)),
			"break_force": float(swing.get("break_force", STANDARD_WEB_TETHER_BREAK_FORCE)),
			"attacker_velocity": attacker.velocity if attacker_live else Vector2.ZERO,
			"forward": _unit_forward_vector(attacker) if attacker_live else Vector2.RIGHT,
			"accel_mult": STANDARD_WEB_SWING_ACCEL_MULT,
		})
		match String(intent.get("action", "")):
			"remove":
				active_web_swings.remove_at(index)
				continue
			"snap":
				if attacker_live:
					_spawn_hit_effect(attacker, 1, "blunt", false, "web_snap", Vector2(attacker.ring_pos, attacker.lane))
				active_web_swings.remove_at(index)
				continue
		if attacker_live:
			attacker.velocity += intent.get("attacker_velocity_delta", Vector2.ZERO)
		swing["timer"] = float(intent.get("timer", swing.get("timer", 0.0)))
		active_web_swings[index] = swing


func _spawn_projectile_trace(attacker, event: Dictionary) -> void:
	if effects_root == null or attacker == null or not is_instance_valid(attacker):
		return
	if not _consume_battle_vfx_budget("projectile_trace"):
		return
	var segment := _projected_projectile_screen_segment(attacker, event, 92.0)
	if segment.is_empty():
		return
	var payload := _projectile_runtime_service().trace_payload(event, segment, attacker.position, _projectile_runtime_constants())
	var trace := ProjectileTraceEffect.new()
	trace.setup(
		payload.get("start", attacker.position),
		payload.get("end", attacker.position),
		String(payload.get("damage_type", "bullet")),
		String(payload.get("projectile_style", _projectile_style_for_damage(String(event.get("damage_type", "bullet"))))),
		String(payload.get("travel_path", "straight")),
		combat_vfx_texture,
		float(payload.get("projectile_speed_mult", BULLET_HELL_DEFAULT_SPEED_MULT))
	)
	effects_root.add_child(trace)
	_play_projectile_launch_sfx(event)


func _spawn_hit_effect(target, counter_tier: int, damage_type: String, nullified: bool, projectile_style: String = "", hit_position_combat: Vector2 = Vector2(1.0e20, 1.0e20)) -> void:
	if effects_root == null or target == null or not is_instance_valid(target) or not target.visible:
		return
	if counter_tier <= 0 and not nullified and projectile_style == "":
		return
	if not bool(_runtime_quality_value("hit_vfx", true)):
		return
	if not _consume_battle_vfx_budget("hit_effect"):
		return
	var effect := HitEffect.new()
	if _is_valid_combat_position(hit_position_combat):
		var screen := _project_combat_coord_to_screen(hit_position_combat)
		effect.position = screen["position"]
		effect.visible = bool(screen["visible"])
	else:
		effect.position = target.position
	effect.setup(counter_tier, damage_type, nullified, projectile_style, combat_vfx_texture, _hit_effect_nullified_label(projectile_style))
	effects_root.add_child(effect)
	_play_hit_sfx(damage_type, projectile_style, nullified, counter_tier)


func _spawn_projectile_hit_vfx_on_target(hit_record: Dictionary) -> void:
	var target = hit_record.get("target", null)
	if target == null or not is_instance_valid(target):
		return
	var contact_point := _unit_combat_coord(target)
	if hit_record.get("contact_point", Vector2(1.0e20, 1.0e20)) is Vector2:
		contact_point = hit_record.get("contact_point", contact_point)
	elif hit_record.get("position", Vector2(1.0e20, 1.0e20)) is Vector2:
		contact_point = hit_record.get("position", contact_point)
	_spawn_hit_effect(
		target,
		int(hit_record.get("counter_tier", _counter_tier_for_hit(target, String(hit_record.get("damage_type", "bullet"))))),
		String(hit_record.get("damage_type", "bullet")),
		bool(hit_record.get("nullified", false)),
		String(hit_record.get("projectile_style", "")),
		contact_point
	)


func _hit_effect_nullified_label(projectile_style: String = "") -> String:
	var style := projectile_style.to_lower()
	if style == "threshold":
		return "未破阈值" if _ui_is_zh() else "THRESHOLD"
	if style == "shield":
		return "护盾吸收" if _ui_is_zh() else "SHIELD"
	if style == "" or style == "low_momentum":
		return "动量不足" if _ui_is_zh() else "LOW MOMENTUM"
	return "未生效" if _ui_is_zh() else "NO EFFECT"


func _spawn_combo_ripple(hit_position_combat: Vector2, owner_id: int = 0, strength: float = 1.0) -> void:
	if hud_layer == null or not is_inside_tree() or not _is_valid_combat_position(hit_position_combat):
		return
	var screen := _project_combat_coord_to_screen(hit_position_combat)
	var ripple := ComboRippleEffect.new()
	ripple.name = "ComboOpportunityRipple"
	ripple.position = Vector2.ZERO
	ripple.size = get_viewport_rect().size
	ripple.z_index = 120
	var tint := Color(0.28, 0.92, 1.0, 1.0)
	if owner_id == 1:
		tint = Color(0.32, 0.86, 1.0, 1.0)
