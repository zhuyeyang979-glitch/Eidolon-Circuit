func _update_editor_art(slot_key: String, part: Dictionary) -> void:
	if component_art_view != null:
		component_art_view.set_component(slot_key, part, clampf(editor_snap_timer / 0.28, 0.0, 1.0))
	var colors := {
		"special": Color(1.0, 0.86, 0.22, 1.0),
		"joint": Color(0.25, 0.88, 1.0, 1.0),
		"limb_muscle": Color(0.46, 0.78, 0.92, 1.0),
		"muscle": Color(0.9, 0.22, 0.44, 1.0),
		"booster": Color(1.0, 0.42, 0.16, 1.0),
		"engine": Color(0.55, 0.36, 1.0, 1.0),
		"cooling": Color(0.28, 1.0, 0.62, 1.0),
		"module": Color(0.96, 0.96, 0.92, 1.0),
	}
	var base_color: Color = colors[slot_key]
	var mass_scale: float = clampf(float(part.get("mass", 4.0)) / 14.0, 0.25, 1.0)
	for i in range(editor_art_rects.size()):
		var rect: ColorRect = editor_art_rects[i]
		rect.color = base_color.lerp(Color.WHITE, float(i) * 0.06)
		rect.size = Vector2(26.0 + mass_scale * 22.0, 38.0 + float((i % 3) * 22) + mass_scale * 42.0)
		rect.position = Vector2(778.0 + float(i) * 46.0, 252.0 - rect.size.y * 0.5 + sin(float(i)) * 18.0)


