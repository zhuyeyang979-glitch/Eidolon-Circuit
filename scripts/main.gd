func _stats_internal_plugin_capacity(stats: Dictionary) -> int:
	var explicit_cap := int(stats.get("torso_slots", 0))
	if explicit_cap > 0:
		return explicit_cap
	return maxi(0,
		int(stats.get("engine_slots", 0)) +
		int(stats.get("cooling_slots", 0)) +
		int(stats.get("booster_slots", 0)) +
		int(stats.get("spare_weapon_slots", 0))
	)


