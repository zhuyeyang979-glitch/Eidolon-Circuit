	if zh:
		return tag
	match tag:
		"锁定射击":
			return "Lock-on Shot"
		"持续压制":
			return "Sustained Pressure"
		"范围压制":
			return "Area Pressure"
		"牵引控制":
			return "Tether Control"
		"盾击防反":
			return "Guard Bash"
		"重击破阵":
			return "Heavy Break"
		"横扫控距":
			return "Sweep Control"
		"直线突击":
			return "Linear Thrust"
		"突进追击":
			return "Chase Advance"
		"散热重置":
			return "Cooling Reset"
		"战术支援":
			return "Tactical Support"
		"远程射击":
			return "Ranged Shot"
