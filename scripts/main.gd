func _maybe_spawn_passive_contact_feedback(target, key: String, delta: float, counter_tier: int, damage_type: String, nullified: bool, damage: int, hit_position_combat: Vector2 = Vector2(1.0e20, 1.0e20), feedback_style: String = "") -> void:
	var fx_key := "%s_fx" % key
	var timer := maxf(0.0, float(target.get_meta(fx_key, 0.0)) - delta)
	if timer > 0.0:
		target.set_meta(fx_key, timer)
		return
	target.set_meta(fx_key, 0.08 if damage < PASSIVE_CONTACT_HITSTOP_DAMAGE else 0.14)
	_spawn_hit_effect(target, counter_tier, damage_type, nullified, feedback_style, hit_position_combat)
	if damage >= PASSIVE_CONTACT_HITSTOP_DAMAGE:
		_apply_hitstop(damage_type, counter_tier, damage)


